//! CSS inlined into HTML for email: the rules of `<style>` blocks (and extra CSS you give) written into each element's `style` attribute, as Gmail and Outlook need. It never fetches anything: remote stylesheets are left out.
//! version: 1.0.0
//!
//! [dependencies]
//! css-inline = { version = "0.14", default-features = false }

use std::borrow::Cow;

const MAX_HTML: usize = 16 << 20;

fn size(html: &str, css: &str) -> Result<(), String> {
    if html.len() + css.len() > MAX_HTML {
        return Err("the HTML and CSS are at most 16 MB".into());
    }
    Ok(())
}

/// The HTML with its `<style>` rules inlined into `style` attributes (specificity and `!important` respected), the `<style>` blocks then removed.
/// `<link rel="stylesheet">` to other files are not fetched. Media queries cannot be inlined: use `css_inline_with` with `keep_style_tags` to keep them for clients that read them.
pub fn css_inline(html: &str) -> Result<String, String> {
    size(html, "")?;
    css_inline::CSSInliner::options().load_remote_stylesheets(false).build().inline(html).map_err(|e| e.to_string())
}

/// As `css_inline`, with `extra_css` applied as well (your email theme, kept apart from the templates; "" for none), and the `<style>` blocks kept when `keep_style_tags` (for `@media` rules in clients that support them).
pub fn css_inline_with(html: &str, extra_css: &str, keep_style_tags: bool) -> Result<String, String> {
    size(html, extra_css)?;
    let extra = if extra_css.trim().is_empty() { None } else { Some(Cow::Borrowed(extra_css)) };
    css_inline::CSSInliner::options()
        .load_remote_stylesheets(false)
        .keep_style_tags(keep_style_tags)
        .extra_css(extra)
        .build()
        .inline(html)
        .map_err(|e| e.to_string())
}

/// A fragment of HTML (no `<html>` or `<head>`, as a template part or a CMS block) with `css` inlined into it: gives the fragment back, styled.
pub fn css_inline_fragment(html: &str, css: &str) -> Result<String, String> {
    size(html, css)?;
    // Inlined as a whole page around the fragment, then the body's content taken back out
    // (the crate's own fragment mode kept only the first element of a fragment).
    let css = css.replace("</style", "<\\/style");
    let page = format!("<html><head><style>{}</style></head><body>{}</body></html>", css, html);
    let out = css_inline::CSSInliner::options().load_remote_stylesheets(false).build().inline(&page).map_err(|e| e.to_string())?;
    let start = out.find("<body").and_then(|i| out[i..].find('>').map(|j| i + j + 1)).ok_or("the fragment could not be read back")?;
    let end = out.rfind("</body>").unwrap_or(out.len());
    Ok(out[start..end.max(start)].to_string())
}
