// Reads a Cargo.toml-like file, and writes settings back.
//
//   quillo run toml.qwe      then open http://localhost:8080/package

use "toml.qwer"

route GET /package {
    let t = toml_parse(`[package]
name = "shop"
version = "1.4.0"
released = 2026-03-01

[dependencies]
serde = { version = "1", features = ["derive"] }
`)?
    { name: t.package.name, version: t.package.version, released: t.package.released, deps: keys(t.dependencies) }
}
route GET /settings = toml_stringify({ title: "Shop", owner: { name: "Ada", email: null }, ports: [8080, 8081] })?
