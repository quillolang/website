// A SAT solver at work: a small puzzle in named variables, DIMACS read and written, a pigeonhole
// that cannot be solved with the clauses to blame, every model of a formula, and a cardinality
// constraint that picks a team.
//
//   quillo run sat_solver.qwe
//   then open http://localhost:8080/solve, /named, /dimacs, /pigeons, /models, /team and /refused

use "sat_solver.qwer"

route GET /solve = {
    sat: sat_solve([[1, 2], [-1, 3], [-2, -3]], {})?,
    unit: sat_solve([[1], [-1, 2], [-2, 3]], {})?.model,
    unsat: sat_solve([[1], [-1]], {})?.sat,
    empty: sat_solve([[]], {})?.sat,
    nothing: sat_solve([], { variables: 2 })?.model,
    assumed: sat_solve([[1, 2]], { assumptions: [-1] })?.model,
    conflict: sat_solve([[1, 2], [-2]], { assumptions: [-1] })?.sat,
}

// Exactly one of three guests eats fish; Ann and Bob will not both have it.
route GET /named = {
    answer: sat_solve_named([["ann", "bob", "cid"], ["!ann", "!bob"], ["!ann", "!cid"], ["!bob", "!cid"], ["!ann"], ["!bob"]], {})?,
    none: sat_solve_named([["a"], ["-a"]], {})?.sat,
}

let cnf = "c quinn's example
p cnf 16 18
1 2 0 -2 -4 0 3 4 0 -4 -5 0 5 -6 0 6 -7 0 6 7 0 7 -16 0
8 -9 0 -8 -14 0 9 10 0 9 -10 0 -10 -11 0 10 12 0 11 12 0
13 14 0 14 -15 0 15 16 0
"

route GET /dimacs {
    let p = sat_parse_dimacs(cnf)?
    let s = sat_solve(p.clauses, { variables: p.variables })?
    {
        variables: p.variables,
        count: len(p.clauses),
        comments: p.comments,
        sat: s.sat,
        check: sat_check(p.clauses, s.model)?,
        wrong: sat_check([[1, 2], [-1]], [1, -2])?,
        written: sat_to_dimacs([[1, -2], [2]], 3, "made here")?,
    }
}

// n + 1 pigeons in n holes: a classic that takes a solver real work.
fn pigeons(n) {
    let v = (p, h) => p * n + h + 1
    let each = range(n + 1) | map((p) => range(n) | map((h) => v(p, h)))
    let apart = range(n) | map((h) =>
        range(n + 1) | map((p) => range(p + 1, n + 1) | map((q) => [-v(p, h), -v(q, h)])) | flatten) | flatten
    each + apart
}

route GET /pigeons = {
    five_in_four: sat_solve(pigeons(4), {})?,
    gave_up: sat_solve(pigeons(8), { max_conflicts: 10 })?.sat,
    core: sat_core([[1], [-1, 2], [3, 4], [-2], [5]])?,
}

route GET /models = {
    three: sat_all_models([[1, 2]], [], 10)?,
    limited: sat_all_models([], [1, 2, 3], 3)?,
    none: sat_all_models([[1], [-1]], [], 10)?,
}

// Two of five people, and any answer with Ann has Bob too.
route GET /team {
    let c = sat_cardinality("exactly", [1, 2, 3, 4, 5], 2, 6)?
    let clauses = c.clauses + [[-1, 2]]
    {
        helpers_from: c.next_var,
        teams: sat_all_models(clauses, [1, 2, 3, 4, 5], 100)?.count,
        at_most: sat_all_models(sat_cardinality("at_most", [1, 2, 3, 4, 5, 6, 7, 8], 3, 9)?.clauses, [1, 2, 3, 4, 5, 6, 7, 8], 1000)?.count,
        at_least: sat_all_models(sat_cardinality("at_least", [1, 2, 3, 4], 3, 5)?.clauses, [1, 2, 3, 4], 100)?.count,
        one: sat_cardinality("at_most", [1, 2, 3], 1, 4)?.clauses,
    }
}

route GET /refused = {
    zero: sat_solve([[0]], {}).error,
    bad_list: sat_solve([1], {}).error,
    header: sat_parse_dimacs("1 2 0\n").error,
    count: sat_parse_dimacs("p cnf 2 2\n1 0\n").error,
    past: sat_parse_dimacs("p cnf 1 1\n2 0\n").error,
    core: sat_core([[1]]).error,
    impossible: sat_cardinality("at_least", [1, 2], 3, 3).error,
    helpers: sat_cardinality("at_most", [1, 2, 3], 1, 2).error,
}
