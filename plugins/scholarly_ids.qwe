// A reading-list app for a lab: identifiers pasted in any form turned into links, an author's
// ORCID checked at sign-up, and the references of a paper pulled out of its text.
//
//   quillo run scholarly_ids.qwe      then open http://localhost:8080/ids and http://localhost:8080/references

use "scholarly_ids.qwer"

route GET /ids = {
    doi: doi_parse("see https://dx.doi.org/10.1038/NPHYS1170."),
    orcid: orcid_check("https://orcid.org/0000-0002-1825-0097", false),
    orcid_typo: orcid_check("0000-0002-1825-0098", false).error,
    isni: orcid_check("0000 0001 2281 955X", true).valid,
    issn: issn_check("ISSN 0378-5955"),
    arxiv: arxiv_parse("arXiv:1706.03762v7"),
    arxiv_old: arxiv_parse("hep-th/9711200").url,
    guesses: ["10.1145/3290605.3300857", "PMC6385936", "PMID: 31452104", "2049-3630", "astro-ph/0001001"] | map((x) => scholar_id(x).type),
}

let PAPER = "References\n[1] Vaswani et al. Attention is all you need. arXiv:1706.03762 (2017).\n[2] Devlin et al. BERT (doi:10.18653/v1/N19-1423).\n[3] Maldacena, hep-th/9711200.\n[4] Same as [1]: https://arxiv.org/abs/1706.03762\n[5] https://doi.org/10.1016/S0140-6736(20)30183-5."

route GET /references = scholar_find(PAPER)
