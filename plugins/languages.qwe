// A site in three languages that picks the visitor's from the browser, and a language select.
//
//   quillo run languages.qwe      then open http://localhost:8080/hello

use "languages.qwer"

let greetings = { en: "Hello", fr: "Bonjour", de: "Hallo" }

route GET /hello {
    let lang = language_negotiate(request.headers["accept-language"] ?? "", ["en", "fr", "de"])?
    { lang, text: greetings[lang], name: language(lang)?.native }
}

route GET /negotiate ? { header: str = "fr-CH, fr;q=0.9, en;q=0.8" } = { chosen: language_negotiate(header, ["en", "fr", "de"])? }

route GET /lookup = ["de", "deu", "ger", "pt-BR", "German", "Deutsch", "haw"] | map((q) => { q, found: language(q)? })

route GET /list = { count: len(language_list()), first: first(language_list()), valid: [language_valid("en"), language_valid("xx")] }
