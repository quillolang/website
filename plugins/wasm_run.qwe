// A shop's pricing rules as a WebAssembly module, run sandboxed on each request: the rules may be
// written by partners in any language that compiles to .wasm, and cannot hang or reach the server.
//
//   quillo run wasm_run.qwe      then open http://localhost:8080/quote?unit=1250&qty=12&kg=3.5

use "wasm_run.qwer"

let RULES = "wasm_run_sample.wat"

route GET /quote ? { unit: int, qty: int, kg: float = 1.0 } {
    let price = wasm_call(RULES, "price", [unit, qty], 100000)?
    let ship = wasm_call(RULES, "shipping", [kg], 100000)?
    { cents: price.results[0], shipping: ship.results[0], fuel: price.fuel_used + ship.fuel_used }
}

route GET /rules = wasm_exports(RULES)?.exports | filter((e) => e.kind == "func") | map((e) => `${e.name}(${join(e.params, ", ")}) -> ${join(e.results, ", ")}`)

route GET /bad = {
    forever: wasm_call(RULES, "forever", [], 1000000).error,
    divide_by_zero: wasm_call(RULES, "ratio", [1, 0], 1000).error,
    not_wasm: wasm_validate("(module (func (export \"f\") (result i32) (i64.const 1)))").ok,
}
