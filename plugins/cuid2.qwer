//! CUID2 ids: secure, collision-resistant ids that start with a letter and hide when and where they were made, for URLs, database keys and anything a visitor can see.
//! version: 1.0.0
//!
//! [dependencies]
//! cuid2 = "=0.1.6"

/// A new CUID2 of 24 characters: a lower-case letter, then letters and digits (`"tz4a98xxat96iws9zmbrgj3a"`).
pub fn cuid2_new() -> String {
    cuid2::create_id()
}

/// A new CUID2 of `length` characters, from 2 to 32: short ones for invite codes, long ones where billions are made.
pub fn cuid2_sized(length: i64) -> Result<String, String> {
    if !(2..=32).contains(&length) {
        return Err(format!("a CUID2 is 2 to 32 characters long, not {}", length));
    }
    Ok(cuid2::CuidConstructor::new().with_length(length as u16).create_id())
}

/// `count` new CUID2s of the default length (at most 10,000), all different: for seeding tables or handing out codes in bulk.
pub fn cuid2_many(count: i64) -> Result<Vec<String>, String> {
    if !(0..=10_000).contains(&count) {
        return Err(format!("from 0 to 10000 ids at a time, not {}", count));
    }
    Ok((0..count).map(|_| cuid2::create_id()).collect())
}

/// Whether `id` has a CUID2's shape: 2 to 32 characters, a lower-case letter first, then lower-case letters and digits. For checking ids in URLs before a database lookup.
pub fn cuid2_valid(id: &str) -> bool {
    cuid2::is_cuid2(id)
}
