// A site where users upload their logo as SVG: each file cleaned before it is stored and shown, with a report of what was taken out.
//
//   quillo run svg_clean.qwe      then open http://localhost:8080/report

use "svg_clean.qwer"

route GET /report = svg_clean_report(read_file("svg_clean_sample.svg"), {})?

route GET /clean.svg = respond(200, svg_clean(read_file("svg_clean_sample.svg"), { precision: 1 })?, { "content-type": "image/svg+xml" })

route GET /checks {
    {
        file: svg_clean_file("svg_clean_sample.svg", "data/svg_clean/logo.svg", {})?,
        rounded: svg_clean("<svg><path d=\"M0.999.5L10.123456-3.5e2\"/></svg>", { precision: 2 })?,
        not_svg: svg_clean("<html></html>", {}).error,
    }
}

// POST an SVG: get back the cleaned one, ready to store.
route POST /upload = respond(200, svg_clean(request.body, {})?, { "content-type": "image/svg+xml" })
