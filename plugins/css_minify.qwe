// A site's stylesheet built at start: minified for production and made to work in older
// Safari, with a check that reports mistakes by line.
//
//   quillo run css_minify.qwe      then open http://localhost:8080/app.css and http://localhost:8080/demo

use "css_minify.qwer"

let BROWSERS = "> 0.5%, last 2 versions, safari >= 13, not dead"
let BUILT = css_minify_file("css_minify_sample.css", "data/app.min.css", BROWSERS)?

route GET /app.css = file("data/app.min.css")

route GET /demo = {
    built: BUILT,
    minified: css_minify(".a { color: #ff0000; margin: 0px 0px 0px 0px }\n.b { color: #ff0000; margin: 0 }")?,
    old_safari: css_for_browsers(".card { user-select: none; backdrop-filter: blur(8px); & .title { color: rgb(46 125 50 / 50%) } }", "safari 12", false)?,
    check: css_check(".ok { color: red }\n.bad { color: red;; width: 10px }\n.broken { color: }\n@media screen and (min-width: { }"),
}
