//! SVG drawn to PNG at the size you ask, text included (a font is built in): link previews, email images, icons and charts for places that take no SVG.
//! version: 1.0.0
//!
//! [dependencies]
//! resvg = "0.45"
//! dejavu = "2.37"

use resvg::tiny_skia;
use resvg::usvg;
use serde_json::{json, Value};
use std::sync::{Arc, OnceLock};

const MAX_SIDE: u32 = 8000;
const MAX_SVG: usize = 32 * 1024 * 1024;

// The system's fonts, and DejaVu Sans built in for servers that have none: loaded once.
fn fonts() -> Arc<usvg::fontdb::Database> {
    static DB: OnceLock<Arc<usvg::fontdb::Database>> = OnceLock::new();
    DB.get_or_init(|| {
        let mut db = usvg::fontdb::Database::new();
        db.load_system_fonts();
        db.load_font_data(dejavu::sans::regular().to_vec());
        db.load_font_data(dejavu::sans::bold().to_vec());
        db.load_font_data(dejavu::sans::oblique().to_vec());
        db.load_font_data(dejavu::sans_mono::regular().to_vec());
        db.set_sans_serif_family("DejaVu Sans");
        db.set_monospace_family("DejaVu Sans Mono");
        Arc::new(db)
    })
    .clone()
}

fn tree(svg: &str) -> Result<usvg::Tree, String> {
    if svg.len() > MAX_SVG {
        return Err("the SVG is larger than 32 MB".into());
    }
    let mut opt = usvg::Options::default();
    opt.fontdb = fonts();
    opt.font_family = "DejaVu Sans".into();
    // Pictures inside the SVG come only from data: URLs, never from files or the network.
    opt.resources_dir = None;
    opt.image_href_resolver = usvg::ImageHrefResolver { resolve_data: usvg::ImageHrefResolver::default_data_resolver(), resolve_string: Box::new(|_, _| None) };
    usvg::Tree::from_str(svg, &opt).map_err(|e| format!("the SVG cannot be read: {}", e))
}

fn render(svg: &str, out: &str, width: i64) -> Result<Value, String> {
    let t = tree(svg)?;
    let size = t.size();
    let (sw, sh) = (size.width(), size.height());
    let w = if width > 0 { width as f32 } else { sw };
    let scale = w / sw;
    let (pw, ph) = (w.round() as u32, (sh * scale).round() as u32);
    if pw == 0 || ph == 0 || pw > MAX_SIDE || ph > MAX_SIDE {
        return Err(format!("{}×{} is outside 1 to {} pixels a side", pw, ph, MAX_SIDE));
    }
    let mut pixmap = tiny_skia::Pixmap::new(pw, ph).ok_or("cannot make the picture")?;
    resvg::render(&t, tiny_skia::Transform::from_scale(scale, scale), &mut pixmap.as_mut());
    if let Some(dir) = std::path::Path::new(out).parent().filter(|d| !d.as_os_str().is_empty()) {
        std::fs::create_dir_all(dir).map_err(|e| format!("{}: {}", dir.display(), e))?;
    }
    pixmap.save_png(out).map_err(|e| format!("{}: {}", out, e))?;
    Ok(json!({ "width": pw, "height": ph }))
}

/// Draws the SVG text `svg` into a PNG at `out` (folders made), `width` pixels wide with the height to keep its shape (0 for its own size); transparent where the SVG draws nothing.
/// `{ width, height }`. Up to 8,000 pixels a side; pictures inside it load only from data: URLs.
pub fn svg_to_png(svg: &str, out: &str, width: i64) -> Result<Value, String> {
    render(svg, out, width)
}

/// The same from an SVG file at `from`.
pub fn svg_file_to_png(from: &str, out: &str, width: i64) -> Result<Value, String> {
    let svg = std::fs::read_to_string(from).map_err(|e| format!("{}: {}", from, e))?;
    render(&svg, out, width)
}

/// The SVG's own size, `{ width, height }` in pixels, from its width and height or its viewBox.
pub fn svg_size(svg: &str) -> Result<Value, String> {
    let s = tree(svg)?.size();
    Ok(json!({ "width": s.width(), "height": s.height() }))
}
