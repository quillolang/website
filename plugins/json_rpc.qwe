// JSON-RPC 2.0, the protocol of Ethereum nodes, language servers, Odoo, Kodi, Bitcoin Core and many
// devices: calls, notifications and batches to a server over HTTP or a WebSocket (with the
// server's own notifications read as they come), and this program serving JSON-RPC itself.
//
//   JSONRPC_URL=https://rpc.example.com JSONRPC_WS=wss://rpc.example.com/ws quillo run json_rpc.qwe
//   then open http://localhost:8080/call, /batch, /ws and /spec; POST /rpc serves calls

use "json_rpc.qwer"

let URL = env("JSONRPC_URL", "http://127.0.0.1:8545/rpc")
let WS = env("JSONRPC_WS", "ws://127.0.0.1:8545/ws")

route GET /call = {
    by_position: jsonrpc_call(URL, "subtract", [42, 23], {})?,
    by_name: jsonrpc_call(URL, "subtract", { subtrahend: 23, minuend: 42 }, {})?,
    who: jsonrpc_call(URL, "whoami", null, { headers: { authorization: "Bearer demo-token" } })?,
    app_error: jsonrpc_call(URL, "divide", { a: 1, b: 0 }, {}).error,
    unknown: jsonrpc_call(URL, "foobar", null, {}).error,
    notified: jsonrpc_notify(URL, "update", [1, 2, 3, 4, 5], {})?,
}

// One request for five calls; the answers come back in the calls' order.
route GET /batch = jsonrpc_batch(URL, [
    { method: "sum", params: [1, 2, 4] },
    { method: "notify_hello", params: [7], notify: true },
    { method: "subtract", params: [42, 23] },
    { method: "foo.get", params: { name: "myself" } },
    { method: "get_data" },
], {})?

// Over a WebSocket kept open: calls, and a subscription whose updates the server sends by itself.
route GET /ws {
    let diff = jsonrpc_call(WS, "subtract", [10, 4], {})?
    let sub = jsonrpc_call(WS, "subscribe", ["prices"], {})?
    sleep(200)
    let ticks = jsonrpc_receive(WS, 10, 2000)? | map((m) => `${m.method} ${m.params.subscription} #${m.params.n}`)
    { diff, sub, ticks, batch: jsonrpc_batch(WS, [{ method: "sum", params: [1, 2] }, { method: "get_data" }], {})?, closed: jsonrpc_close(WS) }
}

// Serving JSON-RPC: the table says what each method takes ("any": no checking).
let METHODS = { subtract: ["minuend", "subtrahend"], sum: "any", update: "any", notify_hello: "any", get_data: [], greet: ["name", "greeting?"] }

fn run(c) = match c {
    { method: "subtract", args: { minuend: num as a, subtrahend: num as b } } => a - b
    { method: "subtract" } => jsonrpc_error(c.id, -32602, "Invalid params", "minuend and subtrahend are numbers")
    { method: "sum", params: list as xs } => reduce(xs, 0, (t, x) => t + x)
    { method: "get_data" } => ["hello", 5]
    { method: "greet", args: { name: str as name, greeting } } => `${greeting ?? "Hello"}, ${name}!`
    _ => null
}

fn serve(body) {
    let p = jsonrpc_parse(body, METHODS)
    jsonrpc_reply(p, for c in p.calls => run(c))?
}

route POST /rpc {
    let out = serve(request.body)
    out == null ? respond(204, "", {}) : respond(200, out, { "content-type": "application/json" })
}

// The specification's own examples, through the same code a POST /rpc runs.
fn show(body) {
    let t = serve(body)
    t == null ? "nothing sent" : json.parse(t)?
}

route GET /spec = {
    positional: show('{"jsonrpc": "2.0", "method": "subtract", "params": [42, 23], "id": 1}'),
    named: show('{"jsonrpc": "2.0", "method": "subtract", "params": {"subtrahend": 23, "minuend": 42}, "id": 3}'),
    notification: show('{"jsonrpc": "2.0", "method": "update", "params": [1,2,3,4,5]}'),
    missing: show('{"jsonrpc": "2.0", "method": "foobar", "id": "1"}'),
    bad_json: show('{"jsonrpc": "2.0", "method": "foobar, "params": "bar", "baz]'),
    bad_request: show('{"jsonrpc": "2.0", "method": 1, "params": "bar"}'),
    empty: show('[]'),
    numbers: show('[1,2,3]'),
    mixed: show('[{"jsonrpc": "2.0", "method": "sum", "params": [1,2,4], "id": "1"}, {"jsonrpc": "2.0", "method": "notify_hello", "params": [7]}, {"jsonrpc": "2.0", "method": "subtract", "params": [42,23], "id": "2"}, {"foo": "boo"}, {"jsonrpc": "2.0", "method": "foo.get", "params": {"name": "myself"}, "id": "5"}, {"jsonrpc": "2.0", "method": "get_data", "id": "9"}]'),
    all_notifications: show('[{"jsonrpc": "2.0", "method": "notify_sum", "params": [1,2,4]}, {"jsonrpc": "2.0", "method": "notify_hello", "params": [7]}]'),
    greet: show('{"jsonrpc": "2.0", "method": "greet", "params": ["Ada"], "id": 7}'),
    wrong_params: show('{"jsonrpc": "2.0", "method": "greet", "params": {"nme": "Ada"}, "id": 8}'),
}
