// A campsite's booking page: today's sunrise and sunset, the evening's golden hour for photos,
// and the far north, where in June the sun does not set.
//
//   quillo run sun_times.qwe      then open http://localhost:8080/sun?date=2026-06-21

use "sun_times.qwer"

route GET /sun ? { date: str = "2026-06-21", lat: float = 52.37, lon: float = 4.89, offset: int = 120 } {
    let s = sun_times(lat, lon, date, offset)?
    { sunrise: slice(s.sunrise, 11, 16), sunset: slice(s.sunset, 11, 16), golden_hour: slice(s.golden_hour ?? "", 11, 16), day: s.day_length }
}

route GET /north = { tromso_june: sun_times(69.65, 18.96, "2026-06-21", 120)?.polar, tromso_december: sun_times(69.65, 18.96, "2026-12-21", 60)?.day_minutes }

// 21 June 2026, 12:00 UTC in Amsterdam: the sun is high in the south.
route GET /now = sun_position(52.37, 4.89, 1782043200)?
