// A "remember my cart" cookie the visitor can keep but not change, a preference cookie they
// cannot read, and a cookie jar for a partner API that signs in with cookies.
//
//   COOKIE_SECRET=$(openssl rand -hex 32) quillo run cookies.qwe
//   then open http://localhost:8080/cart/add/42, http://localhost:8080/cart and http://localhost:8080/demo

use "cookies.qwer"

let SECRET = env("COOKIE_SECRET", "dev-only-cookie-secret-0123456789abcdef")

route GET /cart/add/:id(int) {
    let cart = cookie_verify("cart", cookie("cart") ?? "", SECRET) ?? ""
    let ids = cart == "" ? [] : split(cart, ",")
    set_cookie("cart", cookie_sign("cart", join([...ids, str(id)], ","), SECRET)?, { max_age: "30d" })
    redirect("/cart")
}

route GET /cart {
    let cart = cookie_verify("cart", cookie("cart") ?? "", SECRET)
    { items: is_err(cart) ? [] : split(cart, ",") }
}

route GET /demo {
    let signed = cookie_sign("cart", "42,7", SECRET)?
    let secret_pref = cookie_encrypt("pref", "vip=true", SECRET)?
    // The partner's answer to POST /login, then the jar sends its cookie to /api, not to /admin's.
    let jar = cookie_jar_add([], [
        "sid=abc123; Path=/; Secure; HttpOnly",
        "admin=1; Path=/admin; Secure",
        "old=x; Max-Age=0",
    ], "https://partner.example.com/login")?
    {
        header: cookie_build("__Host-cart", signed, { max_age: 2592000, same_site: "Lax" })?,
        chips: cookie_build("widget", "1", { same_site: "None", partitioned: true })?,
        parsed: cookie_parse("theme=dark%20blue; Expires=Sun, 01 Nov 2026 12:00:00 GMT; Path=/; SameSite=Strict")?,
        request: cookie_header_parse("sid=abc123; theme=dark%20blue"),
        verified: cookie_verify("cart", signed, SECRET)?,
        changed: cookie_verify("cart", replace(signed, "42,7", "42,7,99"), SECRET).error,
        moved: cookie_verify("other", signed, SECRET).error,
        decrypted: cookie_decrypt("pref", secret_pref, SECRET)?,
        unreadable: !contains(secret_pref, "vip"),
        to_api: cookie_jar_header(jar, "https://partner.example.com/api/orders")?,
        to_admin: cookie_jar_header(jar, "https://partner.example.com/admin/users")?,
        over_http: cookie_jar_header(jar, "http://partner.example.com/api"),
    }
}
