// Memcached as a shared cache: values with a lifetime, a lock made with add, a counter, a safe
// update with gets and cas, and keys spread over two servers by consistent hashing.
//
//   MEMCACHED_HOST=127.0.0.1:11211,127.0.0.1:11212 quillo run memcached.qwe
//   then open /cache, /once, /counter, /cas, /spread, /plan and /broken

use "memcached.qwer"

route GET /cache {
    memcached_set("greeting", "hello", 60)?
    memcached_set("user:1", { name: "Ada", roles: ["admin"] }, 60)?
    memcached_set("long", "kept 40 days", 3456000)?
    memcached_set("gone", "x", 60)?
    {
        text: memcached_get("greeting")?,
        map: memcached_get("user:1")?,
        long: memcached_get("long")?,
        none: memcached_get("no:such:key")?,
        many: memcached_get_many(["greeting", "user:1", "no:such:key"])?,
        deleted: memcached_delete("gone")?,
        deleted_again: memcached_delete("gone")?,
        touched: memcached_touch("greeting", 120)?,
        replaced_missing: memcached_replace("no:such:key", "x", 1)?,
    }
}

// Two requests racing for one job: only the first add succeeds.
route GET /once {
    memcached_delete("job:report")?
    { first: memcached_add("job:report", "worker-1", 30)?, second: memcached_add("job:report", "worker-2", 30)?, holder: memcached_get("job:report")? }
}

route GET /counter {
    memcached_set("hits", "10", 0)?
    {
        up: memcached_incr("hits", 5)?,
        down: memcached_decr("hits", 3)?,
        floor: memcached_decr("hits", 100)?,
        missing: memcached_incr("no:counter", 1)?,
        not_a_number: memcached_incr("greeting", 1).error,
    }
}

// Read, change, write back unless someone wrote meanwhile.
route GET /cas {
    memcached_set("stock", { left: 3 }, 0)?
    let seen = memcached_gets("stock")?
    let first = memcached_cas("stock", { left: seen.value.left - 1 }, 0, seen.cas)?
    let second = memcached_cas("stock", { left: 0 }, 0, seen.cas)?
    { first: first, second: second, now: memcached_get("stock")?, bad: memcached_cas("stock", 1, 0, "abc").error }
}

// Every key reads back, wherever it landed, and both servers hold some.
route GET /spread {
    let names = range(0, 40) | map((i) => "key:" + str(i))
    for k in names { memcached_set(k, k, 60)? }
    let got = memcached_get_many(names)?
    { read_back: len(names | filter((k) => got[k] == k)), servers: len(names | map((k) => memcached_server_for(k)) | unique), stats: len(keys(memcached_stats()?)) }
}

// Adding a third server moves about a third of the keys, all of them to the new one.
route GET /plan {
    let keys = range(0, 3000) | map((i) => "user:" + str(i))
    let p = memcached_reshard_plan("a:11211,b:11211", "a:11211,b:11211,c:11211", keys)?
    { moved_all_to_new: p.moved == p.to_new, about_a_third: p.moved > 700 && p.moved < 1400 }
}

route GET /broken = {
    space: memcached_set("has space", "x", 0).error,
    long: memcached_set(repeat("k", 251), "x", 0).error,
    negative: memcached_set("k", "x", -1).error,
}
