//! Two-factor sign-in with authenticator apps (TOTP, RFC 6238): secrets, codes, checks that give the time step taken so a code is used once, and the otpauth:// link.
//! version: 1.1.0
//!
//! [dependencies]
//! totp-rs = { version = "5", features = ["gen_secret", "otpauth"] }

use serde_json::{json, Value};
use totp_rs::{Algorithm, Secret, TOTP};

const STEP: u64 = 30;

fn totp(secret: &str, issuer: &str, account: &str) -> Result<TOTP, String> {
    let bytes = Secret::Encoded(secret.trim().replace(' ', "").to_uppercase()).to_bytes().map_err(|e| format!("{:?}", e))?;
    let issuer = if issuer.is_empty() { None } else { Some(issuer.to_string()) };
    TOTP::new(Algorithm::SHA1, 6, 1, 30, bytes, issuer, account.to_string()).map_err(|e| e.to_string())
}

/// A new secret, as base32 text: keep it with the user, and show it once (as a link or a QR code).
pub fn totp_secret() -> String {
    match Secret::generate_secret().to_encoded() {
        Secret::Encoded(s) => s,
        Secret::Raw(_) => unreachable!(),
    }
}

/// The 6-digit code for `secret` now, as an authenticator app shows it.
pub fn totp_code(secret: &str) -> Result<String, String> {
    totp(secret, "", "user")?.generate_current().map_err(|e| e.to_string())
}

/// Whether `code` is right for `secret` now, or 30 s either side. It does not know whether the code was used already, so one code
/// works again for up to 90 s: `totp_check` gives the time step to record. Count tries yourself: there are a million codes.
pub fn totp_verify(secret: &str, code: &str) -> Result<bool, String> {
    totp(secret, "", "user")?.check_current(code.trim()).map_err(|e| e.to_string())
}

/// Checks `code` as `totp_verify` does, and refuses one whose time step is `last_step` or before it: `{ ok, step, reused }`.
/// Keep `step` with the user once `ok` is true (in your table, set only when the stored step is lower), and pass it as
/// `last_step` next time, so a code is taken once, as RFC 6238 asks (-1 when none was taken yet). `reused` is true when the
/// code was right but its step was taken already.
pub fn totp_check(secret: &str, code: &str, last_step: i64) -> Result<Value, String> {
    // totp_verify answered only true or false, so a code seen over a shoulder or through a phishing
    // proxy signed in again within its 90 s (quillo FEEDBACK78.md, Q-1152; quillo-website branch auth-plugins).
    let t = totp(secret, "", "user")?;
    let code = code.trim();
    let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_err(|e| e.to_string())?.as_secs();
    let current = (now / STEP) as i64;
    let (mut taken, mut reused) = (None, false);
    // The newest step first, so of two that match (one in a million) the later is kept.
    for step in [current + 1, current, current - 1] {
        if step < 0 {
            continue;
        }
        let want = t.generate(step as u64 * STEP);
        let same = want.len() == code.len() && want.bytes().zip(code.bytes()).fold(0u8, |acc, (a, b)| acc | (a ^ b)) == 0;
        if same && taken.is_none() {
            if step > last_step {
                taken = Some(step);
            } else {
                reused = true;
            }
        }
    }
    Ok(match taken {
        Some(step) => json!({ "ok": true, "step": step, "reused": false }),
        None => json!({ "ok": false, "step": null, "reused": reused }),
    })
}

/// The `otpauth://` link an app adds the account from: put it in a QR code (the qr plugin) for the set-up page.
pub fn totp_url(secret: &str, issuer: &str, account: &str) -> Result<String, String> {
    Ok(totp(secret, issuer, account)?.get_url())
}
