//! The visitor's language from the browser's Accept-Language header: the header read with its q-weights, and the best of the languages your site has picked, matching `en-GB` to `en` and `pt` to `pt-BR` as people expect.
//! version: 1.0.0
//!
//! [dependencies]

use serde_json::{json, Value};

/// The header's languages with their weights, best first, ties in the order given; q=0 entries (refused) left out, malformed ones skipped.
fn parse(header: &str) -> Vec<(String, f64)> {
    let mut out: Vec<(String, f64, usize)> = Vec::new();
    for (i, part) in header.split(',').take(100).enumerate() {
        let mut bits = part.split(';');
        let tag = bits.next().unwrap_or("").trim();
        if tag.is_empty() || tag.len() > 35 || !tag.chars().all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_' || c == '*') {
            continue;
        }
        let mut q = 1.0;
        for b in bits {
            if let Some(v) = b.trim().strip_prefix("q=").or_else(|| b.trim().strip_prefix("Q=")) {
                q = v.trim().parse::<f64>().unwrap_or(-1.0);
            }
        }
        if (0.0..=1.0).contains(&q) && q > 0.0 {
            out.push((tag.replace('_', "-"), q, i));
        }
    }
    out.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal).then(a.2.cmp(&b.2)));
    out.into_iter().map(|(t, q, _)| (t, q)).collect()
}

/// How well a supported tag fits a wanted one: 3 the same, 2 the wanted is more precise (`en-GB` wanted, `en` there), 1 the supported is (`pt` wanted, `pt-BR` there), 0 not at all.
fn fit(wanted: &str, have: &str) -> u8 {
    let (w, h) = (wanted.to_ascii_lowercase(), have.to_ascii_lowercase());
    if w == h {
        3
    } else if w.starts_with(&format!("{}-", h)) {
        2
    } else if h.starts_with(&format!("{}-", w)) {
        1
    } else if w.split('-').next() == h.split('-').next() {
        // Same language, other region: en-GB wanted, en-US there.
        1
    } else {
        0
    }
}

/// The header's languages, best first: `[{ tag, q }]`. `"fr-CH, fr;q=0.9, en;q=0.8, *;q=0.5"` gives fr-CH 1, fr 0.9, en 0.8, * 0.5.
pub fn accept_language_parse(header: &str) -> Vec<Value> {
    parse(header).into_iter().map(|(t, q)| json!({ "tag": t, "q": q })).collect()
}

/// The best of `supported` (your site's languages, as you spell them) for the header, or `default` when none fits (or the header is empty).
/// Wanted languages are tried in order of weight; for each, an exact match beats a broader one (`en` for `en-GB`), which beats a narrower or sibling one (`pt-BR` for `pt`). `*` takes the first supported.
pub fn accept_language_pick(header: &str, supported: Vec<String>, default: &str) -> String {
    for (want, _) in parse(header) {
        if want == "*" {
            if let Some(s) = supported.first() {
                return s.clone();
            }
            continue;
        }
        let best = supported.iter().map(|s| (fit(&want, s), s)).filter(|(f, _)| *f > 0).max_by_key(|(f, _)| *f);
        if let Some((_, s)) = best {
            return s.clone();
        }
    }
    default.to_string()
}

/// Every supported language with how much the visitor wants it, best first: `[{ tag, q }]`, `q` 0 for those the header does not mention. For a language menu with the likely ones on top.
pub fn accept_language_rank(header: &str, supported: Vec<String>) -> Vec<Value> {
    let wanted = parse(header);
    let mut scored: Vec<(String, f64, u8, usize)> = supported
        .iter()
        .enumerate()
        .map(|(i, s)| {
            let (q, f) = wanted.iter().filter_map(|(w, q)| {
                let f = if w == "*" { 1 } else { fit(w, s) };
                if f > 0 { Some((*q, f)) } else { None }
            }).fold((0.0, 0u8), |best, x| if x.0 > best.0 || (x.0 == best.0 && x.1 > best.1) { x } else { best });
            (s.clone(), q, f, i)
        })
        .collect();
    scored.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal).then(b.2.cmp(&a.2)).then(a.3.cmp(&b.3)));
    scored.into_iter().map(|(t, q, _, _)| json!({ "tag": t, "q": q })).collect()
}
