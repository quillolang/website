// An invoicing API that hands out Biscuit tokens: the token says what its holder may do, a
// partner narrows its own to read-only before passing it to a reporting tool, and each request
// is authorized from the token alone.
//
//   BISCUIT_PRIVATE_KEY=... quillo run biscuit.qwe      then open http://localhost:8080/demo
//
// Without BISCUIT_PRIVATE_KEY a fixed demo key is used: make your own with biscuit_keypair().

use "biscuit.qwer"

let PRIVATE = env("BISCUIT_PRIVATE_KEY", "ed25519-private/7c4b1f0dc9a5e3f6b1d2c3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4")
let PUBLIC = biscuit_public_key(PRIVATE)?

let ISSUE = `
    user({user});
    tenant({tenant});
    right("invoices", "read");
    right("invoices", "write");
    check if time($t), $t < {expires};
`

let READ_ONLY = `check if operation("read");`

// The service's side: the request's facts, then the policy.
let AUTHORIZE = `
    resource("invoices");
    operation({op});
    tenant_requested({tenant});
    check if tenant($t), tenant_requested($t);
    allow if right("invoices", {op});
`

fn allowed(token, op, tenant) = biscuit_authorize(token, PUBLIC, AUTHORIZE, { op, tenant })

route GET /demo {
    let token = biscuit_issue(PRIVATE, ISSUE, { user: "u42", tenant: "acme", expires: "2099-01-01T00:00:00Z" })?
    let reporting = biscuit_attenuate(token, READ_ONLY, {})?
    let expired = biscuit_issue(PRIVATE, ISSUE, { user: "u42", tenant: "acme", expires: "2020-01-01T00:00:00Z" })?
    {
        write_full: allowed(token, "write", "acme")?,
        read_narrowed: allowed(reporting, "read", "acme")?,
        write_narrowed: allowed(reporting, "write", "acme").error,
        other_tenant: allowed(token, "read", "globex").error,
        expired: allowed(expired, "read", "acme").error,
        forged: biscuit_authorize(token, biscuit_keypair().public, AUTHORIZE, { op: "read", tenant: "acme" }).error,
    }
}

route GET /inspect {
    let token = biscuit_issue(PRIVATE, ISSUE, { user: "u42", tenant: "acme", expires: "2099-01-01T00:00:00Z" })?
    biscuit_inspect(biscuit_attenuate(token, READ_ONLY, {})?)?
}
