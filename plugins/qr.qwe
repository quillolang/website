// A QR code for a link, served as an image and shown in a page.
//
//   quillo run qr.qwe      then open http://localhost:8080/

use "qr.qwer"

route GET /qr.svg ? { text: str = "https://quillolang.org" } =
    respond(200, qr_svg(text, 256)?, { "content-type": "image/svg+xml", "cache-control": "max-age=86400" })

route GET / = <html><body>
    <h1>Scan to open the docs</h1>
    <div style="width: 200px">{raw(qr_svg_colors("https://quillolang.org/docs/", 200, "#1b1630", "#f7f3e8")?)}</div>
    <img src="/qr.svg?text=WIFI%3AT%3AWPA%3BS%3ACafe%3BP%3Asecret%3B%3B" width="160" alt="Join the café's Wi-Fi"/>
</body></html>
