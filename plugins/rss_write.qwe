// A blog's feeds, in RSS, Atom and JSON Feed, from its posts.
//
//   quillo run rss_write.qwe      then open http://localhost:8080/feed.xml

use "rss_write.qwer"

let SITE = "https://blog.example.com"

let posts = [
    { slug: "fast-pages", title: "Fast pages & small bundles", date: "2026-10-12T08:00:00Z", summary: "What we cut, and what it bought us.", body: "<p>We removed <b>40 KB</b> of JavaScript.</p>", tags: ["performance"] },
    { slug: "hello", title: "Hello, world", date: "2026-09-01", summary: "The first post.", body: "<p>It begins.</p>", tags: ["news"] },
]

fn items() = posts | map((p) => { title: p.title, link: `${SITE}/posts/${p.slug}`, description: p.summary,
    content_html: p.body, date: p.date, author: "ada@example.com (Ada)", categories: p.tags })

let channel = { title: "Example blog", link: SITE, description: "Notes on building the web", language: "en", subtitle: "Notes on building the web", author: "Ada" }

route GET /feed.xml = respond(200, rss_feed(merge(channel, { self_url: `${SITE}/feed.xml` }), items())?, { "content-type": "application/rss+xml; charset=utf-8" })
route GET /atom.xml = respond(200, atom_feed(merge(channel, { self_url: `${SITE}/atom.xml` }), items())?, { "content-type": "application/atom+xml; charset=utf-8" })
route GET /feed.json = respond(200, json.stringify(json_feed(merge(channel, { self_url: `${SITE}/feed.json` }), items())?), { "content-type": "application/feed+json" })
