// A status page: this server's own health route, its port, and a port nothing listens on.
//
//   quillo run uptime_check.qwe      then open http://localhost:8080/status

use "uptime_check.qwer"

route GET /health = { ok: true }
route GET /broken = respond(503, "down for maintenance")

route GET /status {
    let me = request.headers.host                       // this server, e.g. localhost:8080
    let port = int(split(me, ":")[1] ?? "80")
    let checks = uptime_check_all([`http://${me}/health`, `http://${me}/broken`, `127.0.0.1:${port}`, "127.0.0.1:9"], 2000)?
    {
        all_up: all(checks, (c) => c.up),
        checks: checks | map((c) => { target: replace(c.target, me, "self"), up: c.up, status: c.status ?? null, fast: c.ms < 1000 }),
    }
}

route GET /ping ? { host: str = "127.0.0.1", port: int = 9 } = uptime_tcp(host, port, 1000)
