// A shop's error reports from the browser, mapped back from the minified bundle to the
// TypeScript it came from. The bundle and its map are deployed as source_maps_sample.js(.map).
//
//   quillo run source_maps.qwe      then open http://localhost:8080/report

use "source_maps.qwer"

let STACK = `Error: negative total
    at r (https://shop.example/assets/source_maps_sample.js:1:96)
    at a (https://shop.example/assets/source_maps_sample.js:1:64)
    at HTMLButtonElement.<anonymous> (https://shop.example/assets/source_maps_sample.js:1:217)
    at https://cdn.example/vendor.js:2:1180`

// What the page's window.onerror sends: { stack }. Here, the trace above.
route POST /errors { json: { stack: str } } = sourcemap_stack(request.json.stack, ".")?

route GET /report = respond(200, sourcemap_stack(STACK, ".")?.text, { "content-type": "text/plain; charset=utf-8" })

route GET /frames = sourcemap_stack(STACK, ".")?.frames

route GET /where = {
    throw: sourcemap_lookup("source_maps_sample.js.map", 1, 96)?,
    context: sourcemap_context("source_maps_sample.js.map", 1, 96, 2)?,
    info: sourcemap_info("source_maps_sample.js.map")?,
}
