// Tells the language of each message.
//
//   quillo run lang.qwe      then open http://localhost:8080/detect?text=Bonjour+tout+le+monde

use "lang.qwer"

route GET /detect ? { text: str } = detect_language(text)
route GET /many = ["Where is my order?", "¿Dónde está mi pedido?", "Wo ist meine Bestellung?", "私の注文はどこですか"]
    | map((t) => { text: t, lang: detect_language(t)?.code })
