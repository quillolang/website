// A furniture workshop's week: how many chairs and tables to make for the most profit with the
// wood and hours there are; what fits in the delivery van; and who drives which route.
//
//   quillo run optimize.qwe      then open http://localhost:8080/plan

use "optimize.qwer"

route GET /plan ? { wood: float = 400.0, hours: float = 450.0 } {
    let r = optimize_lp({
        maximize: { chairs: 45, tables: 80 },
        constraints: [
            { name: "wood (kg)", terms: { chairs: 5, tables: 20 }, op: "<=", value: wood },
            { name: "hours", terms: { chairs: 10, tables: 15 }, op: "<=", value: hours },
        ],
        variables: { chairs: { integer: true }, tables: { integer: true } },
    })?
    { status: r.status, make: r.values, profit: r.objective, limits: r.constraints | filter((c) => c.binding) | map((c) => c.name) }
}

route GET /van = optimize_knapsack([
    { name: "sofa", value: 900, weight: 60 }, { name: "table", value: 500, weight: 35 },
    { name: "chairs", value: 300, weight: 20 }, { name: "lamp", value: 120, weight: 5 }, { name: "bookcase", value: 450, weight: 40 },
], 100.0)?

route GET /routes {
    let drivers = ["Ada", "Bas", "Cleo"]
    let routes = ["north", "centre", "south"]
    let minutes = [[40, 25, 60], [35, 30, 20], [50, 45, 40]]
    let a = optimize_assign(minutes)?
    { minutes: a.cost, plan: a.pairs | map((p) => `${drivers[p[0]]}: ${routes[p[1]]}`) }
}

route GET /impossible = optimize_lp({ minimize: { x: 1 }, constraints: [{ terms: { x: 1 }, op: ">=", value: 5 }, { terms: { x: 1 }, op: "<=", value: 3 }] })?.status
