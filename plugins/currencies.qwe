// Prices shown in the buyer's currency, and sent to a payment API in its smallest unit.
//
//   quillo run currencies.qwe      then open http://localhost:8080/price?amount=1234.5&currency=EUR

use "currencies.qwer"

route GET /price ? { amount: float, currency: str = "USD" } = {
    shown: currency_format(amount, currency)?,
    charge: { amount: currency_to_minor(amount, currency)?, currency: lower(currency) },
    info: currency_info(currency)?,
}

route GET /examples = {
    yen: currency_format(1234.5, "JPY")?,
    dinar: currency_to_minor(1.5, "KWD")?,
    back: currency_from_minor(1234, "EUR")?,
    swiss: currency_of_country("CH")?,
    count: len(currency_list()),
}
