// A CSV export, and an import that reads it back.
//
//   quillo run csv.qwe      then open http://localhost:8080/orders.csv

use "csv.qwer"

let orders = [
    { id: 1, customer: "Ada Lovelace", total: 120.5, note: "gift, wrap it" },
    { id: 2, customer: "Grace \"Amazing\" Hopper", total: 99, note: null },
]

route GET /orders.csv = respond(200, csv_write(orders, ["id", "customer", "total", "note"])?, {
    "content-type": "text/csv; charset=utf-8", "content-disposition": "attachment; filename=orders.csv" })

route GET /import {
    let rows = csv_parse(csv_write(orders, ["id", "customer", "total", "note"])?)?
    rows | map((r) => { id: int(r.id), customer: r.customer, total: float(r.total) })
}
