// A Cassandra cluster from a program: statements prepared and run with values of each CQL type, one
// row of every type read back, a table read a page at a time, a batch, and what the server's
// errors say.
//
//   CASSANDRA_HOST=127.0.0.1:9042 CASSANDRA_USER=cassandra CASSANDRA_PASSWORD=cassandra quillo run cassandra.qwe
//   then open http://localhost:8080/connect, /write, /types, /pages, /batch and /failures
//
// It wants a keyspace `shop`, with tables as the routes use them.

use "cassandra.qwer"

let opened = cassandra_connect("main", { keyspace: "shop", consistency: "LOCAL_QUORUM", page_size: 3 })

route GET /connect {
    let c = opened?
    { connected: c.connected, versions: c.supported.CQL_VERSION, keyspace: cassandra_query("main", "SELECT keyspace_name FROM system.local", null, {})?.columns[0].type, no_password: is_err(cassandra_connect("second", { keyspace: "bad name" })) }
}

route GET /write {
    opened?
    let insert = "INSERT INTO orders (id, customer, total, placed, tags) VALUES (?, ?, ?, ?, ?)"
    let id = "123e4567-e89b-12d3-a456-426614174000"
    cassandra_execute("main", insert, [id, "ada", 42.5, "2026-11-01T09:30:00.250Z", ["new", "gift"]], {})?
    cassandra_execute("main", insert, { id: "123e4567-e89b-12d3-a456-426614174001", customer: "bob", total: 7.0, placed: 1730000000000, tags: [] }, {})?
    let got = cassandra_execute("main", "SELECT id, customer, total, placed, tags FROM orders WHERE id = ?", [id], {})?
    { row: got.rows[0], columns: map(got.columns, (c) => c.type), again: len(cassandra_execute("main", "SELECT id, customer, total, placed, tags FROM orders WHERE id = ?", [id], {})?.rows) }
}

route GET /types {
    opened?
    let got = cassandra_query("main", "SELECT * FROM every_type", null, {})?
    { row: got.rows[0], types: map(got.columns, (c) => c.type), nulls: got.rows[1].a_text }
}

route GET /bind {
    opened?
    let cql = "INSERT INTO bound (k, big, small, tiny, dec, vi, ip, day, flag, blobby, scores, pair) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"
    cassandra_execute("main", cql, ["k1", 9007199254740993, 300, -5, "-123.450", "-170141183460469231731687303715884105728", "2001:db8::1", "2026-11-01", true, "0xcafe", { a: 1, b: 2 }, [7, "x"]], {})?
    cassandra_execute("main", "SELECT * FROM bound WHERE k = ?", ["k1"], {})?.rows[0]
}

route GET /pages {
    opened?
    let one = cassandra_execute("main", "SELECT n FROM events WHERE day = ?", ["2026-11-01"], { page_size: 4 })?
    let two = cassandra_execute("main", "SELECT n FROM events WHERE day = ?", ["2026-11-01"], { page_size: 4, paging_state: one.paging_state })?
    let all = cassandra_all("main", "SELECT n FROM events WHERE day = ?", ["2026-11-01"], { page_size: 4 })?
    let capped = cassandra_all("main", "SELECT n FROM events WHERE day = ?", ["2026-11-01"], { page_size: 4, max_rows: 6 })?
    { first: map(one.rows, (r) => r.n), more: one.has_more, second: map(two.rows, (r) => r.n), all: len(all.rows), pages: all.pages, capped: len(capped.rows) }
}

// The stand-in forgets its prepared statements after a batch, as a restarted node does: the read
// after it is answered Unprepared, and prepared again without the program seeing.
route GET /batch {
    opened?
    cassandra_execute("main", "SELECT balance FROM accounts WHERE name = ?", ["ada"], {})?
    let ok = cassandra_batch("main", [
        { cql: "INSERT INTO accounts (name, balance) VALUES (?, ?)", values: ["ada", 10] },
        { cql: "INSERT INTO accounts (name, balance) VALUES (?, ?)", values: ["bob", 20] },
    ], { consistency: "QUORUM" })?
    {
        ok: ok,
        rows: cassandra_execute("main", "SELECT balance FROM accounts WHERE name = ?", ["bob"], {})?.rows,
        warnings: cassandra_warnings("main")?,
        evicted: cassandra_execute("main", "SELECT balance FROM accounts WHERE name = ?", ["ada"], {})?.rows,
    }
}

route GET /failures {
    opened?
    {
        syntax: cassandra_query("main", "SELEKT nothing", null, {}).error,
        missing: cassandra_execute("main", "SELECT * FROM absent WHERE k = ?", ["x"], {}).error,
        few_values: cassandra_execute("main", "INSERT INTO accounts (name, balance) VALUES (?, ?)", ["only one"], {}).error,
        wrong_type: cassandra_execute("main", "INSERT INTO accounts (name, balance) VALUES (?, ?)", ["a", "not a number"], {}).error,
        level: cassandra_query("main", "SELECT 1", null, { consistency: "MOST" }).error,
        unavailable: cassandra_query("main", "SELECT unavailable", null, {}).error,
        timeout: cassandra_query("main", "SELECT timeout", null, {}).error,
        unknown_connection: cassandra_query("nobody", "SELECT 1", null, {}).error,
        batch_kind: cassandra_batch("main", [], { kind: "fast" }).error,
    }
}
