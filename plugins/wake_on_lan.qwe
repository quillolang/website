// Waking the office's machines from a web page: each by name, its magic packet sent to the
// subnet's broadcast address (or WOL_HOST), one with a SecureOn password; MAC addresses as
// people paste them; and a relay that wakes machines on another subnet when asked over UDP.
//
//   quillo run wake_on_lan.qwe      then open http://localhost:8080/wake/cad-workstation
//   WOL_HOST=192.168.1.255 quillo run wake_on_lan.qwe      to send to that subnet only

use "wake_on_lan.qwer"

let machines = {
    "cad-workstation": { mac: "00-1A-2B-3C-4D-5E" },
    "build-server": { mac: "a4bb.6d12.0f9e", password: "c0:ff:ee:00:00:01" },
    "nas": { mac: "3c:7c:3f:1:2:3" },
}
let TO = env("WOL_HOST", "255.255.255.255")
let PORT = int(env("WOL_PORT", "9"))

route GET /wake/:name {
    let m = machines[name] ?? reply 404 "no machine by that name"
    wol_send(m.mac, { to: TO, port: PORT, password: m.password ?? "", count: 3 })?
}

route GET /macs = {
    same: ["00:1a:2b:3c:4d:5e", "00-1A-2B-3C-4D-5E", "001a.2b3c.4d5e", "001A2B3C4D5E", "001a2b-3c4d5e"] | map((m) => wol_mac(m)?.mac),
    nas: wol_mac(machines.nas.mac)?,
    wrong: wol_mac("00:1a:2b:3c:4d").error,
}

route GET /broadcast = {
    office: wol_broadcast("192.168.1.20/24")?,
    warehouse: wol_broadcast("10.0.0.7 255.255.252.0")?,
    bad: wol_broadcast("10.0.0.7/255.0.255.0").error,
}

// The packet itself, and read back as a relay would.
route GET /packet {
    let hex = wol_packet("00:1a:2b:3c:4d:5e", "c0:ff:ee:00:00:01")?
    { bytes: len(hex) / 2, starts: slice(hex, 0, 24), password_part: slice(hex, -12) }
}

// A relay: a machine on this subnet takes "wake <mac>" requests or magic packets on a UDP
// port and wakes the machine here, where broadcasts reach it.
let relayed = []
udp.listen(int(env("WOL_RELAY_PORT", "9009")), (p) => {
    let asked = p.text != null && starts_with(p.text, "wake ") ? { mac: slice(p.text, 5), password: null } : wol_read(p.bytes)
    if !asked { return null }
    relayed = relayed + [wol_send(asked.mac, { to: TO, port: PORT, password: asked.password ?? "" })]
})

route GET /relay {
    udp.send("127.0.0.1", int(env("WOL_RELAY_PORT", "9009")), "wake 00:1a:2b:3c:4d:5e")
    sleep(300)
    { relayed: relayed | map((r) => r.mac ?? r.error) }
}
