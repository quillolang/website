// Scrypt hashes: new ones as PHC strings, users imported from Firebase Authentication, and
// keys that match Node's crypto.scrypt.
//
//   quillo run scrypt.qwe      then open http://localhost:8080/hash and http://localhost:8080/firebase

use "scrypt.qwer"

route GET /hash {
    let hash = scrypt_hash("correct horse battery staple", 15, 8, 1)?
    {
        starts: slice(hash, 0, 21),
        verified: scrypt_verify("correct horse battery staple", hash),
        wrong: scrypt_verify("Tr0ub4dor&3", hash),
        params: scrypt_params(hash)?,
        needs_rehash_for_owasp: scrypt_needs_rehash(hash, 17, 8, 1),
    }
}

// The project's hash parameters, as the Firebase console shows them, and a user from
// `firebase auth:export users.json` (the sample in Firebase's own scrypt repository).
let FIREBASE = {
    signer_key: "jxspr8Ki0RYycVU8zykbdLGjFQ3McFUH0uiiTvC8pVMXAn210wjLNmdZJzxUECKbm0QsEmYUSDzZvpjeJ9WmXA==",
    salt_separator: "Bw==",
    rounds: 8,
    mem_cost: 14,
}
let USER = { email: "user1@example.com", salt: "42xEC+ixf3L2lw==", passwordHash: "lSrfV15cpx95/sZS2W9c9Kp6i/LVgQNDNC/qzrCnh1SAyZvqmZqAjTdn3aoItz+VHjoZilo78198JAdRuid5lQ==" }

fn firebase_ok(password) = scrypt_firebase_verify(password, USER.passwordHash, USER.salt, FIREBASE.salt_separator, FIREBASE.signer_key, FIREBASE.rounds, FIREBASE.mem_cost)

route GET /firebase = {
    right_password: firebase_ok("user1password")?,
    wrong_password: firebase_ok("user2password")?,
}

// RFC 7914's second test vector, and the key Node makes with crypto.scryptSync("secret", "salt", 32).
route GET /derive = {
    rfc7914: scrypt_derive("password", "NaCl", 10, 8, 16, 64)?,
    node: scrypt_derive("secret", "salt", 14, 8, 1, 32)?,
}
