// Checking labels without a printer: a bin label's ZPL drawn as a picture, shown on a page,
// and read back field by field, as a test of what it says.
//
//   quillo run zpl_preview.qwe      then open http://localhost:8080/ and http://localhost:8080/label.png

use "zpl_preview.qwer"

let ZPL = read_file("zpl_preview_sample.zpl")?

route GET /label.png {
    zpl_preview_png(ZPL, "data/label.png", { dpi: 203 })?
    file("data/label.png")
}

route GET / = <html><body style="font-family: sans-serif; background: #eee">
    <h2>Bin label, 4 × 3 in at 203 dpi</h2>
    <img src={zpl_preview_data_url(ZPL, {})?} style="background: white; border: 1px solid #999; width: 600px" />
</body></html>

// What the label says: its text and barcodes as data, and what the preview could not draw.
route GET /check {
    let fields = zpl_fields(ZPL, {})?
    let info = zpl_preview_png(ZPL, "data/label.png", {})?
    {
        labels: zpl_label_count(ZPL),
        size: `${info.width} × ${info.height}`,
        unsupported: info.unsupported,
        barcodes: fields | filter((f) => f.type != "text" && f.type != "box") | map((f) => `${f.type}: ${f.data ?? f.name ?? ""}`),
        text: fields | filter((f) => f.type == "text") | map((f) => f.data),
    }
}
