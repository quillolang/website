// An accounts inbox where people drag Outlook emails into the browser: the .msg read, its attachments saved, and the message
// kept as a standard .eml.
//
//   quillo run outlook_msg.qwe      then open http://localhost:8080/message, /attachments and /eml

use "outlook_msg.qwer"

route GET /message {
    let m = outlook_msg_read("outlook_msg_sample.msg")?
    {
        subject: m.subject,
        from: m.from,
        to: m.to | map((r) => r.email),
        cc: m.cc | map((r) => r.email),
        date: m.date,
        text: m.text,
        has_html: m.html != null,
        rtf: m.rtf,
        files: m.attachments | map((a) => `${a.name} (${a.type}, ${a.size} bytes)`),
    }
}

route GET /attachments {
    let saved = outlook_msg_save_attachments("outlook_msg_sample.msg", "data/msg-files")?
    { saved: saved, statement: read_file(saved[0]) }
}

route GET /eml {
    let size = outlook_msg_to_eml("outlook_msg_sample.msg", "data/invoice-1042.eml")?
    let head = split(read_file("data/invoice-1042.eml"), "\r\n") | filter((l) => starts_with(l, "From:") || starts_with(l, "Subject:") || starts_with(l, "Date:"))
    { bytes: size, head: head }
}
