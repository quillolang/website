// Cap'n Proto without the compiler: a schema written as data, messages written and read, field
// layout as capnpc does it, a message spread over segments with far pointers, the packed encoding,
// and hostile messages refused.
//
//   quillo run capnp.qwe      then open http://localhost:8080/person and /hand
//
// Give fields in @ordinal order. A struct with a union needs its places: `capnp compile -ocapnp`
// prints them.

use "capnp.qwer"

let SCHEMA = {
    root: "Person",
    enums: { PhoneType: ["mobile", "home", "work"] },
    structs: {
        PhoneNumber: { fields: [{ name: "number", type: "text" }, { name: "type", type: "PhoneType" }] },
        Person: { fields: [
            { name: "id", type: "uint32" },
            { name: "name", type: "text" },
            { name: "email", type: "text" },
            { name: "phones", type: { list: "PhoneNumber" } },
            { name: "active", type: "bool" },
            { name: "score", type: "float64" },
            { name: "age", type: "int16", default: 18 },
            { name: "tags", type: { list: "text" } },
            { name: "matrix", type: { list: { list: "int32" } } },
            { name: "flags", type: { list: "bool" } },
            { name: "photo", type: "data" },
            { name: "boss", type: "Person" },
        ]},
    },
}
let ADA = {
    id: 123, name: "Alice", email: "alice@example.com",
    phones: [{ number: "555-1212", type: "mobile" }, { number: "555-3434", type: "work" }],
    active: true, score: 2.5, age: 36,
    tags: ["admin", "ops"], matrix: [[1, 2], [], [-3]], flags: [true, false, true, true, false, false, false, false, true],
    photo: "c0ffee", boss: { id: 1, name: "Grace" },
}

route GET /person {
    let bytes = capnp_encode(SCHEMA, ADA, {})?
    { same: capnp_decode(SCHEMA, bytes, {})? == capnp_decode(SCHEMA, capnp_encode(SCHEMA, capnp_decode(SCHEMA, bytes, {})?, {})?, {})?, back: capnp_decode(SCHEMA, bytes, {})?, shape: capnp_inspect(bytes)? }
}

// Worked out by hand from the encoding spec: struct Point { x :Int32; y :Int32; name :Text; }
// (x = 1, y = 2, name = "hello"): the segment table, root pointer, data, pointer, text.
let POINT = { root: "Point", structs: { Point: { fields: [{ name: "x", type: "int32" }, { name: "y", type: "int32" }, { name: "name", type: "text" }] } } }
let HAND = "00000000 04000000" + "0000000001000100" + "0100000002000000" + "0100000032000000" + "68656c6c6f000000"

route GET /hand = {
    wrote: capnp_encode(POINT, { x: 1, y: 2, name: "hello" }, {})?,
    read: capnp_decode(POINT, HAND, {})?,
    layout: capnp_layout(POINT, "Point")?,
}

// capnpc fills holes: a Bool leaves room that later small fields take.
route GET /layout {
    let s = { root: "T", structs: { T: { fields: [
        { name: "a", type: "bool" }, { name: "b", type: "uint16" }, { name: "c", type: "bool" }, { name: "d", type: "uint8" },
        { name: "e", type: "uint32" }, { name: "f", type: "uint64" }, { name: "g", type: "void" }, { name: "h", type: "text" },
    ] } } }
    capnp_layout(s, "T")?
}

// A message over segments of six words: pointers across them are far pointers.
route GET /far {
    let bytes = capnp_encode(SCHEMA, ADA, { segment_words: 6 })?
    let shape = capnp_inspect(bytes)?
    {
        many_segments: len(shape.segments) > 1,
        follows: capnp_decode(SCHEMA, bytes, {})?.boss.name,
        same_as_flat: capnp_decode(SCHEMA, bytes, {})? == capnp_decode(SCHEMA, capnp_encode(SCHEMA, ADA, {})?, {})?,
        refused: capnp_decode(SCHEMA, bytes, { far: "refuse" }).error,
    }
}

// A double-far pointer, by hand: root far to a pad in segment 1, the pad far to segment 2 and a tag.
route GET /double-far = capnp_decode(POINT, "02000000 01000000 02000000 03000000" + "0600000001000000" + "0200000002000000" + "0000000001000100" + "0100000002000000" + "0100000032000000" + "68656c6c6f000000", {})?

route GET /packed = {
    docs_one: capnp_pack("080000000300020019000000aa010000")?,
    docs_back: capnp_unpack("510803023119aa01")?,
    zeros: capnp_pack("00000000000000000000000000000000")?,
    zeros_back: capnp_unpack("0001")?,
    dense: capnp_pack("0102030405060708" + "0a0b0c0d0e0f1011" + "0100000000000000")?,
    dense_back: capnp_unpack("ff01020304050607" + "08010a0b0c0d0e0f1011" + "0101")?,
    message: capnp_decode(SCHEMA, capnp_encode(SCHEMA, { id: 7, name: "Packed" }, { packed: true })?, { packed: true })?.name,
    smaller: len(capnp_encode(SCHEMA, ADA, { packed: true })?) < len(capnp_encode(SCHEMA, ADA, {})?),
    bomb_refused: capnp_unpack(repeat("00ff", 140000)).error,
    cut: capnp_unpack("ff0102").error,
}

// Schemas change: an old reader skips what it does not know, a new one sees defaults.
route GET /evolution {
    let old = { root: "P", structs: { P: { fields: [{ name: "id", type: "uint32" }] } } }
    let new = { root: "P", structs: { P: { fields: [{ name: "id", type: "uint32" }, { name: "level", type: "int32", default: 5 }, { name: "ok", type: "bool", default: true }, { name: "note", type: "text", default: "none" }] } } }
    let a = capnp_encode(old, { id: 9 }, {})?
    let b = capnp_encode(new, { id: 9, level: 7, ok: false }, {})?
    { new_reads_old: capnp_decode(new, a, {})?, old_reads_new: capnp_decode(old, b, {})?, kept: capnp_decode(new, b, {})? }
}

// A union, with places from `capnp compile -ocapnp`.
route GET /union {
    let s = { root: "Shape", structs: { Shape: { data_words: 2, pointer_words: 1, tag_bits: 0, fields: [
        { name: "area", type: "float32", bits: [32, 64] },
        { name: "circle", type: "float64", bits: [64, 128], when: 0 },
        { name: "label", type: "text", ptr: 0, when: 1 },
    ] } } }
    let round = capnp_decode(s, capnp_encode(s, { area: 1.5, circle: 2.0 }, {})?, {})?
    let labelled = capnp_decode(s, capnp_encode(s, { area: 3.0, label: "tag" }, {})?, {})?
    { round: round, labelled: labelled, no_places: capnp_layout({ structs: { U: { fields: [{ name: "a", type: "bool", when: 0 }] } } }, "U").error }
}

route GET /hostile = {
    short: capnp_decode(POINT, "0000", {}).error,
    segment_lie: capnp_decode(POINT, "0000000064000000", {}).error,
    past_end: capnp_decode(POINT, "00000000 01000000 0000000a01000100", {}).error,
    list_as_struct: capnp_decode(POINT, "00000000 01000000 0100000012000000", {}).error,
    no_nul: capnp_decode(POINT, "00000000 04000000 0000000001000100 0000000000000000 0100000012000000 6869000000000000", {}).error,
    bad_segment: capnp_decode(POINT, "00000000 01000000 0200000005000000", {}).error,
    wrong_size: capnp_decode(POINT, "00000000 04000000 0000000001000100 0000000000000000 0100000013000000 6869000000000000", {}).error,
    expansion: capnp_decode({ root: "A", structs: { A: { fields: [{ name: "v", type: { list: "void" } }] } } }, "00000000 02000000 0000000000000100 01000000f8ffffff", { traversal_words: 100 }).error,
    cycle: capnp_decode({ root: "N", structs: { N: { fields: [{ name: "next", type: "N" }] } } }, "00000000 02000000 0000000000000100 fcffffff00000100", {}).error,
    too_many: capnp_decode(POINT, "ffff000000000000", {}).error,
    unknown_field: capnp_encode(POINT, { z: 1 }, {}).error,
    too_big: capnp_encode(POINT, { x: 5000000000 }, {}).error,
    no_type: capnp_encode({ root: "X", structs: { X: { fields: [{ name: "a", type: "Nope" }] } } }, {}, {}).error,
    no_root: capnp_encode({ structs: {} }, {}, {}).error,
}
