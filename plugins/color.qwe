// Checks a theme's colours, and picks the text colour for each tag.
//
//   quillo run color.qwe      then open http://localhost:8080/check?fg=%23f3b54a&bg=%230b0a12

use "color.qwer"

route GET /check ? { fg: str, bg: str } = contrast(fg, bg)?
route GET /tags = ["#f3b54a", "navy", "hsl(140 60% 45%)"] | map((c) => { colour: color_forms(c)?.hex, text: text_on(c)? })
route GET /mix = { halfway: mix("#000000", "#ffffff", 0.5)? }
