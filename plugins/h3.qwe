// Couriers near an order, by H3 cell: each courier's cell is kept (in the database in a real app),
// and an order looks in its cell's neighbourhood; plus a heat map of orders by district.
//
//   quillo run h3.qwe      then open http://localhost:8080/near?lat=52.3702&lon=4.8952

use "h3.qwer"

let couriers = [
    { name: "Ayla", lat: 52.3731, lon: 4.8922 }, { name: "Bram", lat: 52.3600, lon: 4.8850 },
    { name: "Cas", lat: 52.3080, lon: 4.7600 },
] | map((c) => merge(c, { cell: h3_cell(c.lat, c.lon, 9)? }))

route GET /near ? { lat: float, lon: float } {
    let here = h3_cell(lat, lon, 9)?
    let nearby = h3_disk(here, 3)?
    { cell: here, area_km2: round(h3_info(here)?.area_km2, 3), couriers: couriers | filter((c) => contains(nearby, c.cell)) | map((c) => { name: c.name, steps: h3_distance(here, c.cell)? }) }
}

route GET /heat {
    let orders = [[52.3702, 4.8952], [52.3712, 4.8960], [52.3600, 4.8850], [52.3080, 4.7600], [52.3705, 4.8949]]
    orders | map((o) => h3_parent(h3_cell(o[0], o[1], 9)?, 6)?) | group_by((c) => c) | values | map((cs) => len(cs)) | sort | reverse
}

route GET /shape = { corners: len(h3_boundary(h3_cell(52.3702, 4.8952, 9)?)?), bad: h3_cell(52.37, 4.89, 16).error }
