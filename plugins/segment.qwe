// Events to Segment from the server: each kind of message, a big batch cut to fit, and a webhook
// from another service mapped into messages, as a source function would do it.
//
//   SEGMENT_WRITE_KEY=... quillo run segment.qwe
//   then open /calls, /batch, /limits, /source and /failures
//
// SEGMENT_API_URL reaches the EU, or a test server.

use "segment.qwer"

route GET /calls = {
    track: len(segment_track("user-1", "Order Placed", { total: 12.5 }, {})?.messageId) > 0,
    anon: segment_track({ anonymousId: "a-1" }, "Viewed", {}, { message_id: "fixed-1", timestamp: "2026-11-01T10:00:00Z" })?,
    identify: segment_identify("user-1", { email: "ada@example.com", plan: "pro" }, {})? != null,
    group: segment_group("user-1", "acme", { name: "Acme" }, {})? != null,
    page: segment_page("user-1", "Pricing", { url: "https://example.com/pricing" }, {})? != null,
    screen: segment_screen("user-1", "Home", {}, {})? != null,
    alias: segment_alias("a-1", "user-1", {})? != null,
    no_one: segment_track("", "x", {}, {}).error,
    no_event: segment_track("user-1", "", {}, {}).error,
    no_group: segment_group("user-1", "", {}, {}).error,
    not_map: segment_track("user-1", "x", [1], {}).error,
}

route GET /batch {
    let big = repeat("x", 4000)
    let messages = map(range(0, 300), (i) => segment_build("track", `user-${i % 9}`, { event: "Viewed", properties: { n: i, note: big } }, {})?)
    { sent: segment_batch(messages)?, unmade: segment_batch([{ event: "x" }]).error }
}

route GET /limits = {
    too_big: contains(segment_track("user-1", "x", { blob: repeat("x", 33000) }, {}).error, "Segment takes at most 32768"),
    kind: segment_build("spin", "user-1", {}, {}).error,
    fresh: segment_message_id() != segment_message_id(),
}

// What a shop's webhook sends, mapped by a table instead of a source function's code.
let tables = [
    {
        when: { path: "kind", equals: "order.paid" },
        type: "track", event: "=Order Paid", userId: "customer.id", id: "delivery",
        timestamp: "at",
        properties: { order: "order.number", total: "order.total", first_sku: "order.items.0.sku", source: "=shop" },
    },
    {
        when: { path: "kind", equals: "order.paid" },
        type: "identify", userId: "customer.id", id: "delivery",
        traits: { email: "customer.email" },
    },
    {
        when: { path: "kind", equals: "customer.deleted" },
        type: "track", event: "=Customer Deleted", userId: "customer.id",
    },
]

route POST /shop/webhook {
    let sent = segment_batch(segment_source_messages(request.json, tables)?)?
    { sent: sent.sent }
}

route GET /source {
    let paid = { kind: "order.paid", delivery: "d-77", at: "2026-11-01T09:00:00Z", customer: { id: 42, email: "ada@example.com" }, order: { number: 1001, total: 25, items: [{ sku: "MUG" }] } }
    let m = segment_source_messages(paid, tables)?
    let again = segment_source_messages(paid, tables)?
    {
        types: map(m, (x) => x.type), user: m[0].userId, properties: m[0].properties, when: m[0].timestamp, traits: m[1].traits,
        once: m[0].messageId == again[0].messageId,
        none: segment_source_messages({ kind: "other" }, tables)?,
        sent: segment_batch(m)?.sent,
        no_user: segment_source_messages({ kind: "customer.deleted" }, tables).error,
        no_key: segment_source_messages({ kind: "order.paid", customer: { id: 1 } }, tables).error,
    }
}

route GET /failures = {
    waited: segment_track("user-1", "Busy", {}, {})? != null,
    refused: segment_track("user-1", "Refused", {}, {}).error,
}
