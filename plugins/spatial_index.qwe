// A café chain's store finder: the three nearest to a customer, all within 2 km, the stores in the
// map's view, and markers clustered for a zoomed-out map.
//
//   quillo run spatial_index.qwe      then open http://localhost:8080/near?lat=52.3731&lon=4.8926

use "spatial_index.qwer"

let STORES = [
    { id: "ams-centraal", name: "Centraal", lat: 52.3791, lon: 4.9003 },
    { id: "ams-jordaan", name: "Jordaan", lat: 52.3752, lon: 4.8820 },
    { id: "ams-pijp", name: "De Pijp", lat: 52.3533, lon: 4.8936 },
    { id: "ams-oost", name: "Oost", lat: 52.3600, lon: 4.9270 },
    { id: "ams-noord", name: "Noord", lat: 52.3906, lon: 4.9160 },
    { id: "ams-zuid", name: "Zuidas", lat: 52.3389, lon: 4.8723 },
    { id: "haarlem", name: "Haarlem", lat: 52.3812, lon: 4.6368 },
    { id: "utrecht", name: "Utrecht", lat: 52.0907, lon: 5.1214 },
    { id: "rotterdam", name: "Rotterdam", lat: 51.9244, lon: 4.4777 },
    { id: "london", name: "London Soho", lat: 51.5136, lon: -0.1365 },
]

fn load_stores() {
    if spatial_count("stores") == 0 { spatial_add("stores", STORES)? }
}

route GET /near ? { lat: float = 52.3731, lon: float = 4.8926 } {
    load_stores()
    {
        nearest: spatial_nearest("stores", lat, lon, 3, 0.0)? | map((s) => `${s.name} ${s.km} km`),
        walk: spatial_within_km("stores", lat, lon, 2.0)? | map((s) => s.name),
        farthest_in_100km: (spatial_within_km("stores", lat, lon, 100.0)? | map((s) => s.name))[-1],
    }
}

// The map shows Amsterdam: only its stores, then the whole country in a 2 by 2 grid of clusters.
route GET /map {
    load_stores()
    {
        in_view: spatial_in_box("stores", 52.33, 4.85, 52.40, 4.95, 100)? | map((s) => s.id),
        clusters: spatial_clusters("stores", 51.0, 3.0, 54.0, 7.0, 2, 2)? | map((c) => { count: c.count, at: [c.lat, c.lon], alone: c.item?.name }),
    }
}

// A store closes, another opens.
route GET /move {
    load_stores()
    spatial_remove("stores", ["ams-jordaan"])
    spatial_add("stores", [{ id: "ams-west", name: "West", lat: 52.3700, lon: 4.8600 }])?
    { stores: spatial_count("stores"), nearest_now: spatial_nearest("stores", 52.3731, 4.8926, 1, 0.0)?[0].name }
}
