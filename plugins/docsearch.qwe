// Search a site's own pages: docsearch_crawl reads the sitemap, fetches each page and
// indexes its sections; docsearch_query finds them as someone types.
//
//   quillo run docsearch.qwe      then open http://127.0.0.1:8080/find?q=refund
//
// A program does not know its own address until a request comes, so this one reads
// itself on the first search. A site would start the crawl as it starts, from where it
// listens: docsearch_crawl("site", "http://127.0.0.1:8080/sitemap.txt", null) runs in
// the background and asks for the sitemap again until the server answers.
// /checks runs what the plugin promises, edge cases too.

use "docsearch.qwer"

// ---- a small help site --------------------------------------------------------------

view Page(title: str, children, description: str = "") =
    <html lang="en">
        <head>
            <meta charset="utf-8"/>
            <title>{title} · Help</title>
            {description != "" && <meta name="description" content={description}/>}
        </head>
        <body>
            <nav><a href="/">Home</a> navonlyword</nav>
            <main>{children}</main>
            <footer>footeronlyword</footer>
        </body>
    </html>

route GET /help/refunds/ =
    <Page title="Refunds">
        <h1>Refunds</h1>
        <p>Ask for a <b>refund</b> within 30 days. <a href="/contact/">Contact us</a> with the order number.</p>
        <h2 id="cards">Refunds to cards</h2>
        <p>A refund to a card takes five to ten working days.</p>
        <h3>Fine print</h3>
        <p>finepr applies to every refund.</p>
        <div hidden>hiddenword</div>
        <div aria-hidden="true">ariahiddenword</div>
        <div class="ad">adword</div>
        <script>let scriptword = 1</script>
    </Page>

route GET /help/shipping/ =
    <Page title="Shipping" description="Free delivery to the Café de Flore.">
        <h1>Shipping</h1>
        <p>Orders placed before noon ship the next day. Shipping to 東京 is free too.</p>
    </Page>

route GET /docs/:name =
    name == "set_cookie" ? <Page title="set_cookie"><h1>set_cookie</h1><pre><code><span class="ln">set_cookie("theme", "dark", {"{"} secure: false {"}"})</span><span class="ln">delete_cookie("theme")</span></code></pre><p>Sets a cookie on the answer.</p></Page>
    : name == "db.query" ? <Page title="db.query"><h1>db.query</h1><p><code>db.query(sql)</code> gives every row of a query, as a list of maps.</p></Page>
    : reply 404 "No such page"

route GET /hilfe/:name =
    name == "größe" ? <Page title="Größe"><h1>Größe</h1><p>Die Schuhgröße steht auf dem Etikett.</p></Page> : reply 404 "No such page"

// No <main> and no h1: the text is the article's, the title the page's <title>.
route GET /plain/ =
    <html><head><title>Plain page</title></head><body><article><p>plainword in an article.</p></article></body></html>

route GET /markup/ =
    <Page title="Markup"><h1>Markup</h1><p>Write {"<script>alert(1)</script>"} in a note and it shows as text.</p></Page>

route GET /private/ =
    <html><head><title>Private</title><meta name="robots" content="noindex, nofollow"/></head><body><main><h1>Private</h1><p>privateword</p></main></body></html>

// The h1 straight before a section: the page is still found by its own title, and its
// path's words find it too.
route GET /help/returns-policy/ =
    <Page title="Policy"><h1>Policy</h1><h2 id="window">The window</h2><p>Fourteen days from arrival.</p></Page>

route GET /data.json = { dataword: true }

let SITE = "https://help.example.com"
let PATHS = ["/help/refunds/", "/help/shipping/", "/help/returns-policy/", "/docs/set_cookie/", "/docs/db.query/", "/hilfe/gr%C3%B6%C3%9Fe/", "/plain/", "/markup/", "/private/", "/data.json", "/gone/"]

// The public addresses, as a sitemap names them; pages are fetched from where it was read.
route GET /sitemap.txt = join(["# the help site"] + (PATHS | map((p) => `${SITE}${p}`)) + ["", `${SITE}/help/refunds/#cards`, `${SITE}/help/refunds/`], "\n")

route GET /sitemap.xml = respond(200, `<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>${SITE}/help/refunds/</loc></url>
  <url><loc><![CDATA[${SITE}/help/shipping/]]></loc></url>
  <url><loc>${SITE}/docs/set_cookie/?a=1&amp;b=2</loc></url>
</urlset>`, { "content-type": "application/xml" })

route GET /sitemap-index.xml = respond(200, `<?xml version="1.0" encoding="UTF-8"?>
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"><sitemap><loc>${SITE}/sitemap.xml</loc></sitemap></sitemapindex>`, { "content-type": "application/xml" })

// Pages that fail on purpose, in a sitemap of their own: one too big, one too slow.
route GET /big/ = {
    let words = reduce(range(21), "word ", (s, _) => s + s)        // 10,485,760 characters
    <html><body><main><h1>Big</h1><p>{words}</p></main></body></html>
}
route GET /slow/ = { sleep(1500); <html><body><main><h1>Slow</h1></main></body></html> }
route GET /sitemap-edge.txt = "/big/\n/slow/\n/help/refunds/"

// A server still starting, as a proxy in front says it: 503 twice, then the sitemap.
let starting = 0
route GET /sitemap-later.txt {
    starting = starting + 1
    starting <= 2 ? reply 503 "starting" : "/help/refunds/"
}

// ---- searching it --------------------------------------------------------------------

let OPTIONS = {
    wait: true,
    kinds: { "/help/": "Help", "/docs/": "Reference", "/": "Page" },
    skip: [".ad"],
    lines: [".ln"],
}

// The first search reads the site, from the address the request came to.
fn read_site(host: str) =
    docsearch_status("help").state == "none" ? docsearch_crawl("help", `http://${host}/sitemap.txt`, OPTIONS) : docsearch_status("help")

route GET /status = docsearch_status("help")

// The search as data: `kind` keeps one kind of page.
route GET /search ? { q: str = "", kind: str = "" } {
    read_site(request.headers["host"])
    docsearch_query("help", q, { limit: 5, kind: kind == "" ? null : kind })
}

// The search as a page: the words found are marked, and everything is escaped.
route GET /find ? { q: str = "" } {
    read_site(request.headers["host"])
    let found = docsearch_query("help", q, null)?
    <html><body>
        <form><input name="q" value={q}/></form>
        <p>{found.total} found</p>
        <ul>{for h in found.hits =>
            <li><a href={h.url}>{h.heading == "" ? h.title : `${h.title}: ${h.heading}`}</a>
                <p>{for s in h.snippet => s.hit ? <mark>{s.text}</mark> : s.text}</p></li>}</ul>
    </body></html>
}

// ---- what the plugin promises, checked: GET /checks gives { passed, failed, failures } --

fn urls(found) = is_err(found) ? [] : found.hits | map((h) => h.url)
fn top(found) = first(urls(found))
fn shown(found) = is_err(found) || len(found.hits) == 0 ? "" : join(found.hits[0].snippet | map((s) => s.text), "")
fn marked(found) = is_err(found) || len(found.hits) == 0 ? [] : found.hits[0].snippet | filter((s) => s.hit) | map((s) => s.text)
fn says(r, words: str) = is_err(r) && contains(r.error, words)
fn none(found) = !is_err(found) && found.total == 0

route GET /checks {
    let host = request.headers["host"]
    read_site(host)
    let q = (s, o) => docsearch_query("help", s, o)
    let crawl = (name: str, path: str, o) => docsearch_crawl(name, `http://${host}${path}`, merge({ wait: true }, o))
    let st = docsearch_status("help")
    let xml = crawl("xml", "/sitemap.xml", {})
    let index = crawl("index", "/sitemap-index.xml", {})
    let edge = crawl("edge", "/sitemap-edge.txt", { timeout_ms: 500 })
    let few = crawl("few", "/sitemap.txt", { max_pages: 2 })
    let some = crawl("some", "/sitemap.txt", { include: ["/help/"], exclude: ["/help/shipping/"] })
    let listed = crawl("listed", "/sitemap.txt", { as_listed: true, timeout_ms: 2000 })
    let refused = crawl("refused", "/no-sitemap.txt", {})
    let closed = docsearch_crawl("closed", "http://127.0.0.1:9/sitemap.txt", { wait: true, wait_ms: 0 })
    let later = crawl("later", "/sitemap-later.txt", { wait_ms: 5000 })
    let big = reduce(range(21), "x", (s, _) => s + s)        // 2,097,152 characters
    let checks = [
        // reading the site
        ["the crawl is ready", st.state == "ready"],
        ["8 pages read: the 404, noindex and JSON ones left out", st.pages == 8],
        ["each left out, by reason", st.skipped["status 404"] == 1 && st.skipped["noindex"] == 1 && st.skipped["not HTML"] == 1],
        ["a url given twice, or with #anchor, is read once", st.total == 11],
        ["no errors", len(st.errors) == 0],
        ["it took a time", st.ms > 0 && st.finished >= st.started],
        // what a page gives
        ["a section is found by its own words, at its #anchor", top(q("card", null)) == "/help/refunds/#cards"],
        ["its heading, whole, puts it first", top(q("Refunds to cards", null)) == "/help/refunds/#cards"],
        ["the title is the h1", first(q("card", null).hits).title == "Refunds"],
        ["no h1: the page's <title>", top(q("plainword", null)) == "/plain/" && first(q("plainword", null).hits).title == "Plain page"],
        ["no <main>: the article", top(q("plainword", null)) == "/plain/"],
        ["a heading without an id is text of its section", top(q("Fine print", null)) == "/help/refunds/#cards"],
        ["the nav is left out", none(q("navonlyword", null))],
        ["the footer is left out", none(q("footeronlyword", null))],
        ["scripts are left out", none(q("scriptword", null))],
        ["hidden is left out", none(q("hiddenword", null))],
        ["aria-hidden is left out", none(q("ariahiddenword", null))],
        ["skip: .ad is left out", none(q("adword", null))],
        ["noindex pages are left out", none(q("privateword", null))],
        ["JSON is left out", none(q("dataword", null))],
        ["the description is searched", top(q("delivery", null)) == "/help/shipping/"],
        ["a page whose h1 comes straight before a section: found by its title", top(q("Policy", null)) == "/help/returns-policy/"],
        ["a path's words find its page", top(q("returns", null)) == "/help/returns-policy/"],
        ["a Unicode path's words, decoded", top(q("größe", null)) == "/hilfe/gr%C3%B6%C3%9Fe/"],
        ["code is searched: secure is only in <pre>", top(q("secure", null)) == "/docs/set_cookie/"],
        ["lines: a code line ends at its element, as the page shows it", contains(shown(q("delete_cookie", null)), "false }) delete_cookie")],
        ["a Unicode path is read, and found percent-encoded", top(q("Schuhgröße", null)) == "/hilfe/gr%C3%B6%C3%9Fe/"],
        ["the kind is the longest prefix's", first(q("card", null).hits).kind == "Help" && first(q("plainword", null).hits).kind == "Page"],
        ["kind keeps one kind", urls(q("query", { kind: "Reference" })) == ["/docs/db.query/"]],
        // the words
        ["a stem finds the word: refunds finds refund", top(q("refunds", null)) == "/help/refunds/"],
        ["the word being typed finds the words it starts: deliv", top(q("deliv", null)) == "/help/shipping/"],
        ["a word typed in full (a space after it) is not a start", none(q("deliv ", null))],
        ["a typo: refnud finds refund", starts_with(top(q("refnud", null)) ?? "", "/help/refunds/")],
        ["two typos in a long word: shpiping finds shipping", top(q("shpiping", null)) == "/help/shipping/"],
        ["no typo forgiven in a short word: shp", none(q("shp ", null))],
        ["accents or none: cafe finds Café", top(q("cafe", null)) == "/help/shipping/"],
        ["capitals and accents in the query: CAFÉ", top(q("CAFÉ", null)) == "/help/shipping/"],
        ["Japanese, a character a word: 東京", top(q("東京", null)) == "/help/shipping/"],
        ["an identifier, whole: set_cookie", top(q("set_cookie", null)) == "/docs/set_cookie/"],
        ["an identifier by its part: cookie", contains(urls(q("cookie", null)), "/docs/set_cookie/")],
        ["a dotted name, whole: db.query", top(q("db.query", null)) == "/docs/db.query/"],
        ["numbers are words: 30 days", top(q("30 days", null)) == "/help/refunds/"],
        ["words side by side count more: next day", top(q("next day", null)) == "/help/shipping/"],
        ["every word found beats one: refund card", top(q("refund card", null)) == "/help/refunds/#cards"],
        // snippets
        ["the words found are marked, as written", contains(marked(q("refund within", null)), "refund") && contains(marked(q("refund within", null)), "within")],
        ["snippet pieces read as the text does", shown(q("refund within", null)) == "Ask for a refund within 30 days. Contact us with the order number."],
        ["a page's own title leads to the page, not a section", top(q("refunds", null)) == "/help/refunds/" && top(q("Shipping", null)) == "/help/shipping/"],
        ["markup is text in a snippet, for the page to escape", contains(shown(q("alert", null)), "<script>alert(1)</script>")],
        // options of a search
        ["two sections of one page by default", len(urls(q("refund", null))) == 2],
        ["per_page 1: one", len(urls(q("refund", { per_page: 1 }))) == 1],
        ["a kind no page has: nothing", none(q("query", { kind: "Blog" }))],
        ["limit 1", len(urls(q("refund", { limit: 1 }))) == 1],
        ["limit 0 is refused", says(q("refund", { limit: 0 }), "1 to 100")],
        ["limit 101 is refused", says(q("refund", { limit: 101 }), "1 to 100")],
        ["an option it does not know is refused", says(q("refund", { limt: 5 }), "no option `limt`")],
        ["options that are not a map are refused", says(q("refund", "5"), "a map")],
        ["an empty query: nothing, no error", none(q("", null))],
        ["punctuation only: nothing", none(q("!!! ...", null))],
        ["1,000 characters are taken", !is_err(q(join(range(1000) | map((_) => "a"), ""), null))],
        ["1,001 are refused", says(q(join(range(1001) | map((_) => "a"), ""), null), "at most 1000")],
        ["a 500-letter word: no trouble", !is_err(q(join(range(500) | map((_) => "z"), ""), null))],
        ["an index never made", says(docsearch_query("nope", "x", null), "docsearch_crawl or docsearch_build")],
        // sitemaps
        ["XML: CDATA and &amp; read", xml.state == "ready" && xml.pages == 3],
        ["a sitemap index: its sitemaps read", index.state == "ready" && index.pages == 3],
        ["max_pages: the rest counted", few.pages == 2 && few.skipped["over max_pages"] == 9],
        ["include and exclude", some.pages == 2 && some.skipped["not included"] == 9],
        ["too big and too slow: errors, the rest read", edge.pages == 1 && edge.skipped["error"] == 2 && len(edge.errors) == 2],
        ["as_listed fetches the public addresses: none here", listed.state == "ready" && listed.pages == 0 && len(listed.errors) > 0],
        ["a sitemap that is not there: failed, and why", refused.state == "failed" && contains(refused.message, "answered 404")],
        ["no server: failed once wait_ms is up", closed.state == "failed" && closed.message != ""],
        ["503 while the server starts: asked again", later.state == "ready" && later.pages == 1],
        ["a sitemap that is not http", says(docsearch_crawl("x", "file:///etc/passwd", null), "only http and https")],
        ["not a URL", says(docsearch_crawl("x", "nowhere", null), "not a URL")],
        ["an option it does not know", says(docsearch_crawl("x", "http://a/b", { pages: 3 }), "no option `pages`")],
        ["a selector that is not one", says(docsearch_crawl("x", "http://a/b", { skip: ["[["] }), "not a CSS selector")],
        ["concurrency 0 is refused", says(docsearch_crawl("x", "http://a/b", { concurrency: 0 }), "1 to 32")],
        ["a crawl already running: not started again", docsearch_crawl("bg", `http://${host}/sitemap-edge.txt`, { timeout_ms: 2000 }).started == true && docsearch_crawl("bg", `http://${host}/sitemap.txt`, null).started == false],
        // making an index from a program's own documents
        ["docsearch_build: a document needs a url", says(docsearch_build("t", [{ title: "x" }]), "needs a url")],
        ["a document needs a title", says(docsearch_build("t", [{ url: "/x" }]), "needs a title")],
        ["a document must be a map", says(docsearch_build("t", ["x"]), "must be a map")],
        ["a field it does not know is refused", says(docsearch_build("t", [{ url: "/x", title: "x", body: "y" }]), "no field `body`")],
        ["boost must be above 0", says(docsearch_build("t", [{ url: "/x", title: "x", boost: 0 }]), "above 0")],
        ["tags must be a list of text", says(docsearch_build("t", [{ url: "/x", title: "x", tags: "a" }]), "list of text")],
        ["text over 2,000,000 bytes is refused", says(docsearch_build("t", [{ url: "/x", title: "x", text: big }]), "over 2000000")],
        ["an index needs a name", says(docsearch_build("", []), "needs a name")],
        ["an empty index finds nothing", docsearch_build("empty", []).docs == 0 && none(docsearch_query("empty", "x", null))],
        ["a url given twice is counted", docsearch_build("t", [{ url: "/x", title: "a" }, { url: "/x", title: "b" }]).duplicates == 1],
        ["building again replaces the index", docsearch_build("t", [{ url: "/y", title: "y" }]).docs == 1 && docsearch_count("t") == 1],
        ["markdown is made plain", docsearch_build("md", [{ url: "/m", title: "m", text: "Ask for a **refund**. [Contact us](/c/)" }]).docs == 1 && shown(docsearch_query("md", "refund", null)) == "Ask for a refund. Contact us"],
        ["markdown: false keeps the marks", docsearch_build("m", [{ url: "/m", title: "m", text: "**bold**", markdown: false }]).docs == 1 && contains(shown(docsearch_query("m", "bold", null)), "**bold**")],
        ["boost puts a page first", docsearch_build("b", [{ url: "/a", title: "Same", text: "same words" }, { url: "/b", title: "Same", text: "same words", boost: 2 }]).docs == 2 && top(docsearch_query("b", "words", null)) == "/b"],
    ]
    let failures = checks | filter((c) => !c[1]) | map((c) => c[0])
    { passed: len(checks) - len(failures), failed: len(failures), failures }
}
