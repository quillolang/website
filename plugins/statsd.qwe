// A shop's metrics sent to StatsD with DogStatsD tags, events and service checks, buffered and
// flushed once a second; the same over TCP and to Graphite; and a small StatsD server of its own,
// taking packets with udp.listen and reading them with statsd_parse.
//
//   STATSD_URL=udp://127.0.0.1:8125 quillo run statsd.qwe      then open http://localhost:8080/order
//
// Needs something that takes StatsD: Telegraf's statsd input (datadog_extensions = true), the
// Datadog agent, or statsd itself. STATSD_TCP_URL and GRAPHITE_URL (graphite://host:2003) for
// /tcp; STATSD_LISTEN_PORT is the port this program listens on itself (9125).

use "statsd.qwer"

let opened = [
    statsd_connect("app", env("STATSD_URL", "udp://127.0.0.1:8125"), { flavor: "dogstatsd", prefix: "shop.", tags: { env: env("APP_ENV", "dev") } }),
    statsd_connect("tcp", env("STATSD_TCP_URL", "tcp://127.0.0.1:8125"), { prefix: "shop.", buffer: 0 }),
    statsd_connect("graphite", env("GRAPHITE_URL", "graphite://127.0.0.1:2003"), { prefix: "shop." }),
]

// What the buffer holds goes out once a second, packed into as few packets as fit.
every(1000, () => statsd_flush("app"))

route GET /order ? { total: float = 42.5, country: str = "FR", customer: str = "c-1001" } {
    let started = now()
    let lines = [
        statsd_count("app", "orders", 1, { tags: { country } })?,
        statsd_histogram("app", "order.total", total, { tags: { country } })?,
        statsd_set("app", "customers", customer, {})?,
        statsd_gauge("app", "carts.open", 7, {})?,
        statsd_gauge("app", "stock.sku42", -1, { delta: true })?,
        statsd_timing("app", "checkout.ms", now() - started, { rate: 1.0 })?,
    ]
    { lines, buffered: statsd_stats("app")?.buffered, sent: statsd_flush("app")? }
}

route GET /deploy {
    let event = statsd_event("app", "Deployed 1.4.2", "by ci\nall checks green", { alert_type: "success", aggregation_key: "deploys", tags: ["service:shop"] })?
    let check = statsd_service_check("app", "db.reachable", "ok", { message: "replica lag 20 ms" })?
    statsd_flush("app")?
    { event, check }
}

// Over TCP, one line per metric, and to Graphite (buffered: flushed here).
route GET /tcp {
    statsd_count("tcp", "emails.sent", 3, {})?
    statsd_timing("tcp", "email.ms", 118.5, {})?
    statsd_gauge("graphite", "queue.depth", 12, {})?
    statsd_count("graphite", "orders", 1, { tags: { country: "FR" } })?
    statsd_flush("graphite")?
    { tcp: statsd_stats("tcp")?, graphite: statsd_stats("graphite")?, line: graphite_line("shop.queue.depth", 12, 1761800000, {})? }
}

// Lines without sending them, in each flavor.
route GET /lines = {
    statsd: statsd_line("count", "page.views", 1, { rate: 0.25 })?,
    dogstatsd: statsd_line("timing", "db.query", 3.75, { flavor: "dogstatsd", tags: { table: "orders" } })?,
    graphite: graphite_line("shop.orders", 1, 1761800000, { country: "FR" })?,
    no_tags_in_plain: statsd_line("count", "x", 1, { tags: { a: "b" } }).error,
}

// A StatsD server of its own: what comes in on the port is read and kept (the last 200 metrics).
let received = []
udp.listen(int(env("STATSD_LISTEN_PORT", "9125")), (p) => {
    let all = received + statsd_parse(p.text ?? "")
    received = slice(all, -200, len(all))
})

route GET /loopback {
    statsd_connect("self", `udp://127.0.0.1:${env("STATSD_LISTEN_PORT", "9125")}`, { flavor: "dogstatsd" })?
    statsd_count("self", "signups", 2, { tags: { plan: "pro" } })?
    statsd_gauge("self", "temperature", 21.5, {})?
    statsd_service_check("self", "worker", 2, { message: "stuck" })?
    statsd_close("self")?
    sleep(300)
    { received: received | filter((m) => m.metric == "signups" || m.metric == "temperature" || m.type == "service_check") }
}
