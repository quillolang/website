// Passwords hashed with a stronger Argon2id than the default, and users moved to it as they sign in.
//
//   quillo run argon2.qwe      then open http://localhost:8080/hash and http://localhost:8080/rehash

use "argon2.qwer"

// 64 MiB, 3 passes, 1 lane: RFC 9106's second choice, for servers with memory to spare.
let MEMORY = 65536
let PASSES = 3
let LANES = 1

route GET /hash {
    let hash = argon2_hash("correct horse battery staple", MEMORY, PASSES, LANES)?
    {
        starts: slice(hash, 0, 30),
        verified: argon2_verify("correct horse battery staple", hash),
        wrong: argon2_verify("Tr0ub4dor&3", hash),
        params: argon2_params(hash)?,
    }
}

// A hash from Quillo's own crypto.hash_password still verifies, and is marked for a rehash
// with the stronger cost; one made with it is not.
route GET /rehash {
    let old = crypto.hash_password("hunter2")
    let fresh = argon2_hash("hunter2", MEMORY, PASSES, LANES)?
    {
        builtin: argon2_params(old)?,
        builtin_verified: argon2_verify("hunter2", old),
        builtin_needs_rehash: argon2_needs_rehash(old, MEMORY, PASSES, LANES),
        fresh_needs_rehash: argon2_needs_rehash(fresh, MEMORY, PASSES, LANES),
        bcrypt_needs_rehash: argon2_needs_rehash("$2b$12$R9h/cIPz0gi.URNNX3kh2OPST9/PgBkqquzi.Ss7KIUgO2t0jWMUW", MEMORY, PASSES, LANES),
    }
}

// How many passes make a hash take about 250 ms here, with 19 MiB.
route GET /tune = argon2_tune(250, 19456, 1)?
