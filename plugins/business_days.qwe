// Delivery estimates and invoice due dates in working days, holidays included.
//
//   quillo run business_days.qwe      then open http://localhost:8080/delivery?ordered=2026-12-23

use "business_days.qwer"

let HOLIDAYS = business_holidays("GB", 2026)? + business_holidays("GB", 2027)?

route GET /delivery ? { ordered: str, days: int = 3 } = {
    ordered,
    ships: business_day_next(ordered, HOLIDAYS)?,
    arrives: business_days_add(ordered, days, HOLIDAYS)?,
}

route GET /due ? { from: str = "2026-12-21", to: str = "2027-01-04" } = { working_days: business_days_between(from, to, HOLIDAYS)?, plain_weeks: business_days_between(from, to, [])? }

route GET /holidays ? { country: str = "US", year: int = 2026 } = business_holidays(country, year)?
