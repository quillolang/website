// Two-factor recovery codes: shown once, kept as hashes, each used one time.
//
//   quillo run mfa_codes.qwe      then open http://localhost:8080/setup

use "mfa_codes.qwer"

route GET /setup {
    let codes = mfa_codes(10)
    // Store only the hashes (db.exec("insert into recovery_codes ...") in a real app).
    write_file("data/recovery.json", json.stringify(codes | map((c) => mfa_hash(c))))
    { show_once: codes, count: len(codes) }
}

route GET /use {
    let codes = mfa_codes(10)
    let stored = codes | map((c) => mfa_hash(c))
    let typed = upper(replace(codes[3], "-", " "))          // as a user types it from paper
    let at = mfa_check(typed, stored)
    let left = [...slice(stored, 0, at), ...slice(stored, at + 1, len(stored))]
    { matched: at, second_time: mfa_check(typed, left), wrong: mfa_check("aaaaa-bbbbb", stored), left: len(left) }
}
