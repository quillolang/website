// Ion in both forms, from a data lake's point of view: a file read with every type kept, binary
// written and read back, bytes from the specification checked, and damaged input refused.
//
//   quillo run amazon_ion.qwe      then open http://localhost:8080/read, /types, /plain, /binary, /vectors, /text and /broken

use "amazon_ion.qwer"

let VALUES = amazon_ion_read_file("amazon_ion_sample.ion")?

fn field(s, name) { (s.value | filter((f) => f.name == name))[0].value }

route GET /read = {
    count: len(VALUES),
    notes: VALUES[0].annotations,
    names: VALUES[0].value | map((f) => f.name),
    rest: [VALUES[1], VALUES[2]],
}

route GET /types {
    let s = VALUES[0]
    {
        id: field(s, "id"), quoted: field(s, "quoted name").value, total: field(s, "total"), tax: field(s, "tax").value, small: field(s, "small").value,
        weight: field(s, "weight"), count: field(s, "count").value, bits: field(s, "bits").value, big: field(s, "big").value,
        times: ["placed", "shipped", "month", "year", "local"] | map((n) => [field(s, n).value, field(s, n).precision]),
        status: field(s, "status"), tags: field(s, "tags").value | map((t) => t.type),
        note: field(s, "note").value, raw: field(s, "raw"), text: field(s, "text"),
        nulls: [field(s, "nothing"), field(s, "no_int"), field(s, "no_struct")],
        floats: field(s, "infinite").value | map((f) => f.value),
        form: amazon_ion_write_text([field(s, "form")])?,
    }
}

route GET /plain = amazon_ion_plain(VALUES)?[0]

route GET /binary {
    let hex = amazon_ion_encode(VALUES)?
    let back = amazon_ion_decode(hex)?
    {
        marker: slice(hex, 0, 8), same_text: amazon_ion_write_text(back)? == amazon_ion_write_text(VALUES)?,
        placed: field(back[0], "placed").value, big: field(back[0], "big").value, notes: back[0].annotations,
        smaller: len(hex) / 2 < len(read_file("amazon_ion_sample.ion")),
        file_again: amazon_ion_encode(back)? == hex,
    }
}

// Bytes worked out by hand from the Ion 1.0 binary specification.
route GET /vectors = {
    int_1000: amazon_ion_encode(amazon_ion_parse("1000")?)?,
    negative: amazon_ion_encode(amazon_ion_parse("-1")?)?,
    decimal: amazon_ion_encode(amazon_ion_parse("1.5")?)?,
    list: amazon_ion_encode(amazon_ion_parse("[1,2]")?)?,
    string: amazon_ion_encode(amazon_ion_parse("\"hello\"")?)?,
    nulls: amazon_ion_encode(amazon_ion_parse("null null.int")?)?,
    time: amazon_ion_encode(amazon_ion_parse("2000-01-01T00:00:00Z")?)?,
    offset_time: amazon_ion_encode(amazon_ion_parse("2000-01-01T00:30:00+01:00")?)?,
    annotated: amazon_ion_encode(amazon_ion_parse("a::1")?)?,
    read: amazon_ion_decode("e00100eae78183d487b28161e4818a2101")?,
    sorted: amazon_ion_decode("e00100ead183842101")?,
    pad: amazon_ion_decode("e00100ea00000e802101")?,
    utc_shift: amazon_ion_decode("e00100ea68bc0fcf8c9f979e80")?[0].value,
    unknown_symbol: amazon_ion_decode("e00100ea70")?[0],
    fraction: amazon_ion_decode("e00100ea6a800fd08181808080c219")?[0].value,
}

route GET /text {
    let v = amazon_ion_from_plain({ name: "Ada", age: 36, score: 1.5, tags: ["a"], none: null, ok: true })?
    let notes = merge(v, { annotations: ["person", "needs quoting"] })
    let text = amazon_ion_write_text([notes, { type: "decimal", value: "-0.050" }, { type: "decimal", value: "1000d3" }, { type: "symbol", value: "$weird" }, { type: "clob", value: "AGE=" }])?
    { text: text, again: amazon_ion_write_text(amazon_ion_parse(text)?)? == text, duplicate: amazon_ion_plain(amazon_ion_parse("{a: 1, a: 2}")?), table: amazon_ion_parse("$ion_symbol_table::{symbols:[\"x\",\"y\"]}\n$11\n$10")? }
}

route GET /broken = {
    leading_zero: amazon_ion_parse("007").error,
    double_underscore: amazon_ion_parse("1__0").error,
    bad_time: amazon_ion_parse("2026-13-01").error,
    leap: amazon_ion_parse("2026-02-29").error,
    no_comma: amazon_ion_parse("[1 2]").error,
    no_close: amazon_ion_parse("[1,").error,
    no_colon: amazon_ion_parse("{a 1}").error,
    bad_null: amazon_ion_parse("null.widget").error,
    open_string: amazon_ion_parse("\"abc").error,
    bad_blob: amazon_ion_parse("{{ *** }}").error,
    no_marker: amazon_ion_decode("2101").error,
    version: amazon_ion_decode("e00200ea").error,
    past_end: amazon_ion_decode("e00100ea8561").error,
    huge: amazon_ion_decode("e00100ea8e7f7f7f7fff").error,
    negative_zero: amazon_ion_decode("e00100ea30").error,
    bad_float: amazon_ion_decode("e00100ea420000").error,
    bad_symbol: amazon_ion_decode("e00100ea7140").error,
    bad_utf8: amazon_ion_decode("e00100ea81ff").error,
    reserved: amazon_ion_decode("e00100eaf0").error,
    deep: amazon_ion_parse(repeat("[", 300)).error,
    deep_binary: amazon_ion_decode("e00100ea" + repeat("be81", 3)).error != null,
    shared: amazon_ion_parse("$ion_symbol_table::{imports:[{name:\"common\",version:1,max_id:5}]}\n1").error,
    bad_type: amazon_ion_encode([{ type: "uuid", value: "x" }]).error,
    not_tagged: amazon_ion_write_text([{ value: 1 }]).error != null,
}
