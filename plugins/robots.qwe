// A link checker's politeness, and the site's own robots.txt: what a crawler may fetch under a
// site's rules (here a sample file; a real crawler gets it with http.get(robots_url(page))).
//
//   quillo run robots.qwe      then open http://localhost:8080/may?path=/shop/cart

use "robots.qwer"

let RULES = `
User-agent: *
Disallow: /admin/
Disallow: /shop/cart
Disallow: /*.pdf$
Allow: /admin/public/

User-agent: QuilloBot
Disallow: /drafts/
Crawl-delay: 2

Sitemap: https://shop.example.com/sitemap.xml
`

route GET /may ? { path: str, agent: str = "SomeBot" } = { path, agent, allowed: robots_allowed(RULES, agent, path)? }

route GET /crawl = {
    checks: robots_check(RULES, "SomeBot", ["/shop/shoes", "/shop/cart", "/admin/settings", "/admin/public/logo.png", "/files/price-list.pdf", "/files/price-list.pdf?v=2"])? | map((c) => `${c.allowed ? "fetch" : "skip "} ${c.url}`),
    quillobot: robots_info(RULES, "QuilloBot")?,
    robots_of: robots_url("https://shop.example.com/shop/shoes?color=red")?,
}

route GET /robots.txt = respond(200, robots_write([{ agents: ["*"], allow: ["/"], disallow: ["/admin", "/cart"] }, { agents: ["GPTBot", "CCBot"], disallow: ["/"] }], ["https://shop.example.com/sitemap.xml"])?, { "content-type": "text/plain" })
