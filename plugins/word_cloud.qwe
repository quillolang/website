// The answers to a customer survey ("What do you like about us?") as a word cloud on the team's dashboard.
//
//   quillo run word_cloud.qwe      then open http://localhost:8080/cloud.svg

use "word_cloud.qwer"

let ANSWERS = "Fast delivery and friendly staff. The coffee is great, delivery was fast. Great coffee, great prices. Friendly staff, clean shop, great coffee! Delivery fast and the packaging was great. Fresh beans, fast delivery, fair prices. The staff are friendly and the coffee is fresh. Good coffee and fast service. Love the fresh beans and the friendly service."

route GET /cloud.svg = respond(200, word_cloud_svg(ANSWERS, { width: 500, height: 300, background: "#fdfaf5" })?, { "content-type": "image/svg+xml" })

route GET /words = word_cloud_words(ANSWERS, 6, true)?

// Tags with counts from the database, in the brand's colours.
route GET /tags.svg = respond(200, word_cloud_svg({ quillo: 40, rust: 25, web: 22, sqlite: 15, plugins: 12, routes: 9, views: 7, maps: 4, email: 3 }, { width: 400, height: 240, colors: ["#5b3fc4", "#e0533d"], vertical: 0.0 })?, { "content-type": "image/svg+xml" })
