//! HTML as readable plain text, for the text part of an email, a terminal or an SMS: headings, lists and tables laid out, links listed at the end.
//! version: 1.0.0
//!
//! [dependencies]
//! html2text = "0.17"

use html2text::render::TrivialDecorator;

const MAX: usize = 5_000_000;

fn check(html: &str) -> Result<(), String> {
    if html.len() > MAX { Err("HTML up to 5 MB".into()) } else { Ok(()) }
}

fn width(w: i64) -> usize {
    if w <= 0 { 10_000 } else { w.clamp(20, 10_000) as usize }
}

/// `html` as plain text wrapped at `width` characters (0: no wrapping): `# Headings`, `* lists`, tables in columns, **bold** and `[1]`-style link marks, with the links listed at the end, as the text part of an email has them.
pub fn html_to_text(html: &str, width: i64) -> Result<String, String> {
    check(html)?;
    html2text::config::plain().link_footnotes(true).string_from_read(html.as_bytes(), self::width(width)).map_err(|e| e.to_string())
}

/// `html` as plain text with no marks at all: no `#`, `*` or link list, only the words, laid out in lines, for search indexes and previews.
pub fn html_to_bare_text(html: &str, width: i64) -> Result<String, String> {
    check(html)?;
    html2text::config::with_decorator(TrivialDecorator::new()).string_from_read(html.as_bytes(), self::width(width)).map_err(|e| e.to_string())
}

/// The first `chars` characters of a page's text on one line, for a list of messages or a meta description; "…" at the end when cut.
pub fn html_preview(html: &str, chars: i64) -> Result<String, String> {
    let t = html_to_bare_text(html, 0)?;
    let one = t.split_whitespace().collect::<Vec<_>>().join(" ");
    let n = chars.clamp(1, 10_000) as usize;
    Ok(if one.chars().count() <= n { one } else { one.chars().take(n - 1).collect::<String>().trim_end().to_string() + "…" })
}
