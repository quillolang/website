// Poker: hands named and compared, a split pot, Omaha's rule that catches a beginner out, the
// chance each hand has, and a seeded deal.
//
//   quillo run poker.qwe
//   then open http://localhost:8080/hand?cards=As,Ks,Qs,Js,Ts, /ranks, /showdown, /omaha, /equity and /deal

use "poker.qwer"

route GET /hand ? { cards: str } {
    let r = poker_evaluate(split(cards, ","))
    if is_err(r) { reply 422 r.error }
    r
}

route GET /ranks = {
    royal: poker_evaluate(["As", "Ks", "Qs", "Js", "Ts"])?.name,
    steel_wheel: poker_evaluate(["5d", "4d", "3d", "2d", "Ad"])?.name,
    four: poker_evaluate(["9c", "9d", "9h", "9s", "Kd"])?.name,
    boat: poker_evaluate(["Kc", "Kd", "Kh", "3s", "3d"])?.name,
    flush: poker_evaluate(["Ah", "Jh", "9h", "4h", "2h"])?.name,
    wheel: poker_evaluate(["Ac", "2d", "3h", "4s", "5c"])?.name,
    trips: poker_evaluate(["7c", "7d", "7h", "2s", "Kd"])?.name,
    two_pair: poker_evaluate(["Jc", "Jd", "4h", "4s", "Ad"])?.name,
    pair: poker_evaluate(["10c", "10d", "4h", "8s", "Ad"])?.name,
    high: poker_evaluate(["Kc", "Jd", "4h", "8s", "2d"])?.name,
    seven: poker_evaluate(["Ah", "Kh", "Qh", "Jh", "2c", "3d", "Th"])?,
    symbols: poker_evaluate(["A♠", "K♠", "Q♠", "J♠", "♠9"])?.category,
}

route GET /showdown = {
    won: poker_showdown([["Ah", "Kd"], ["Qs", "Qc"]], ["2c", "7d", "9h", "Js", "3s"], {})?,
    split: poker_showdown([["Ah", "2d"], ["Ad", "3c"]], ["Ks", "Qs", "Js", "Ts", "5h"], {})?.winners,
    kicker: poker_showdown([["Ah", "Kd"], ["As", "Qc"]], ["Ad", "7d", "9h", "4s", "3c"], {})?.winners,
    five_card: poker_showdown([["Ah", "Ad", "Kc", "Kd", "2s"], ["Qh", "Qd", "Qc", "4d", "5s"]], [], {})?.winners,
}

// Four spades on the board, one in the hand: no flush in Omaha, a flush in hold'em.
route GET /omaha = {
    omaha: poker_omaha(["As", "Kd", "Qc", "2h"], ["Ks", "9s", "5s", "3s", "7d"])?.name,
    holdem: poker_evaluate(["As", "Kd", "Ks", "9s", "5s", "3s", "7d"])?.name,
    showdown: poker_showdown([["As", "Kd", "Qc", "2h"], ["Td", "9d", "7c", "6h"]], ["Ks", "9s", "5s", "3s", "8d"], { game: "omaha" })?.winners,
    too_few: poker_omaha(["As", "Kd"], ["Ks", "9s", "5s"]).error,
}

route GET /equity = {
    preflop: poker_equity([["As", "Ah"], ["Ks", "Kh"]], [], { seed: 42, iterations: 50000 })?,
    same_seed: poker_equity([["As", "Ah"], ["Ks", "Kh"]], [], { seed: 42, iterations: 500 })?.hands == poker_equity([["As", "Ah"], ["Ks", "Kh"]], [], { seed: 42, iterations: 500 })?.hands,
    flop: poker_equity([["Ah", "Kh"], ["Qs", "Qd"]], ["2h", "7h", "Qc"], {})?,
    river: poker_equity([["Ah", "2d"], ["Ad", "3c"]], ["Ks", "Qs", "Js", "Ts", "5h"], {})?,
    dead: poker_equity([["Ah", "Kh"], ["Qs", "Qd"]], ["2h", "7h", "Qc"], { dead: ["3h", "4h", "5h", "6h", "8h", "9h", "Th", "Jh", "Qh"] })?.hands,
    omaha: poker_equity([["As", "Ks", "Qd", "Jd"], ["2c", "2d", "7h", "8h"]], ["Ah", "3c", "9s"], { game: "omaha" })?.method,
}

route GET /deal {
    let d = poker_deal(3, "holdem", 7)?
    {
        deal: d,
        same: poker_deal(3, "holdem", 7)? == d,
        deck: len(unique(poker_deck(7))),
        class: [poker_hand_class(["Kd", "As"])?, poker_hand_class(["Qh", "Jh"])?, poker_hand_class(["9c", "9d"])?],
    }
}

route GET /refused = {
    card: poker_evaluate(["Zz", "Ks", "Qs", "Js", "Ts"]).error,
    twice: poker_evaluate(["As", "As", "Qs", "Js", "Ts"]).error,
    count: poker_evaluate(["As", "Ks"]).error,
    shared: poker_showdown([["Ah", "Kd"], ["Ah", "Qc"]], ["2c", "7d", "9h", "Js", "3s"], {}).error,
    game: poker_showdown([["Ah", "Kd"], ["Qh", "Qc"]], [], { game: "razz" }).error,
}
