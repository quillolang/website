//! Business rules as JsonLogic: rules kept as JSON (in a database, edited in an admin, shared with a JavaScript front end) and evaluated against data, for eligibility, pricing tiers, feature flags and form logic.
//! version: 1.0.0
//!
//! [dependencies]
//! jsonlogic-rs = "0.5"

use serde_json::{json, Value};

const MAX_RULE: usize = 256 * 1024;

/// JsonLogic's own truthiness, as in JavaScript: false, null, 0, "" and [] are false.
fn truthy(v: &Value) -> bool {
    match v {
        Value::Null => false,
        Value::Bool(b) => *b,
        Value::Number(n) => n.as_f64().map(|f| f != 0.0 && !f.is_nan()).unwrap_or(false),
        Value::String(s) => !s.is_empty(),
        Value::Array(a) => !a.is_empty(),
        Value::Object(_) => true,
    }
}

fn apply(rule: &Value, data: &Value) -> Result<Value, String> {
    if rule.to_string().len() > MAX_RULE {
        return Err("a rule is at most 256 KB of JSON".into());
    }
    jsonlogic_rs::apply(rule, data).map_err(|e| e.to_string())
}

/// The value of a rule for `data`: `{ "if": [{ ">": [{ "var": "cart.total" }, 100] }, "free", "paid"] }` with `{ cart: { total: 140 } }` is "free".
/// Operators: `var` (dots go into maps, `missing`), `== != < <= > >=`, `and or ! !!`, `if`, `+ - * / % min max`, `in`, `cat`, `substr`, `map filter reduce all some none merge`.
pub fn jsonlogic_apply(rule: serde_json::Value, data: serde_json::Value) -> Result<Value, String> {
    apply(&rule, &data)
}

/// Whether a rule holds for `data`, by JsonLogic's truthiness (false, null, 0, "" and [] are false).
pub fn jsonlogic_test(rule: serde_json::Value, data: serde_json::Value) -> Result<bool, String> {
    apply(&rule, &data).map(|v| truthy(&v))
}

/// The items a rule holds for, in order: a saved search, a segment of customers, offers a user qualifies for. At most 100,000 items.
pub fn jsonlogic_filter(rule: serde_json::Value, items: Vec<serde_json::Value>) -> Result<Vec<Value>, String> {
    if items.len() > 100_000 {
        return Err("at most 100,000 items at once".into());
    }
    let mut out = Vec::new();
    for it in items {
        if truthy(&apply(&rule, &it)?) {
            out.push(it);
        }
    }
    Ok(out)
}

/// A decision table: `rules` are `[{ when: <rule>, then: <value> }]`, tried in order; gives `{ then, index }` of the first whose `when` holds for `data`,
/// or `{ then: otherwise, index: -1 }` when none does. `then` may itself be a rule, evaluated with the same data.
pub fn jsonlogic_decide(rules: Vec<serde_json::Value>, data: serde_json::Value, otherwise: serde_json::Value) -> Result<Value, String> {
    for (i, r) in rules.iter().enumerate() {
        let when = r.get("when").ok_or(format!("rule {} has no `when`", i))?;
        if truthy(&apply(when, &data)?) {
            let then = r.get("then").cloned().unwrap_or(Value::Null);
            let v = if then.is_object() { apply(&then, &data)? } else { then };
            return Ok(json!({ "then": v, "index": i }));
        }
    }
    Ok(json!({ "then": otherwise, "index": -1 }))
}
