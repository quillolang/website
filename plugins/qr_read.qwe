// A ticket scanner: a photo of a QR code sent from a phone is read, and its link checked.
//
//   quillo run qr_read.qwe      then open http://localhost:8080/scan

use "qr_read.qwer"

route GET /scan = { text: qr_read("qr_read_sample.png")?, code: qr_read_any("qr_read_sample.png")? }

route GET /all = qr_read_all("qr_read_sample.png")? | map((c) => `${c.format}: ${c.text}`)

route POST /scan {
    let f = request.files.photo ?? reply 400 "Send a photo of the code"
    let path = save_upload(f, `data/scans/${uuid()}`)?
    let code = qr_read_any(path)
    delete_file(path)
    if is_err(code) || code == null { reply 422 "No code found: try again closer, with more light" }
    { text: code.text, format: code.format, ours: starts_with(code.text, "https://quillolang.org/") }
}
