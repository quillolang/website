//! Ed25519 signatures: make a key pair, sign text with the private key, and check it with the public one, for webhooks, exports and messages between servers.
//! version: 1.0.0
//!
//! [dependencies]
//! ed25519-dalek = "2"
//! rand = "0.8"
//! base64 = "0.22"

use base64::engine::general_purpose::STANDARD;
use base64::Engine;
use ed25519_dalek::{Signature, Signer, SigningKey, VerifyingKey};
use rand::RngCore;
use std::collections::HashMap;

fn bytes32(text: &str, what: &str) -> Result<[u8; 32], String> {
    let b = STANDARD.decode(text.trim()).map_err(|_| format!("the {} key is not base64", what))?;
    b.try_into().map_err(|_| format!("the {} key is 32 bytes (44 base64 characters)", what))
}

fn signing(private_key: &str) -> Result<SigningKey, String> {
    Ok(SigningKey::from_bytes(&bytes32(private_key, "private")?))
}

/// A new key pair: `{ private, public }`, each 32 bytes as base64. Keep `private` secret; hand `public` to whoever checks.
pub fn sig_keypair() -> HashMap<String, String> {
    let mut seed = [0u8; 32];
    rand::rngs::OsRng.fill_bytes(&mut seed);
    let key = SigningKey::from_bytes(&seed);
    HashMap::from([
        ("private".to_string(), STANDARD.encode(key.to_bytes())),
        ("public".to_string(), STANDARD.encode(key.verifying_key().to_bytes())),
    ])
}

/// The public key that goes with a private key, as base64.
pub fn sig_public_key(private_key: &str) -> Result<String, String> {
    Ok(STANDARD.encode(signing(private_key)?.verifying_key().to_bytes()))
}

/// The signature of `text` (its UTF-8 bytes) with `private_key`: 64 bytes as base64 (88 characters). The same text and key always give the same signature.
pub fn sig_sign(text: &str, private_key: &str) -> Result<String, String> {
    Ok(STANDARD.encode(signing(private_key)?.sign(text.as_bytes()).to_bytes()))
}

/// Whether `signature` is `text` signed by the owner of `public_key`. False for a changed text, another key or a malformed signature;
/// an error only for a public key that is not one.
pub fn sig_verify(text: &str, signature: &str, public_key: &str) -> Result<bool, String> {
    let key = VerifyingKey::from_bytes(&bytes32(public_key, "public")?).map_err(|_| "not an Ed25519 public key".to_string())?;
    let Ok(sig) = STANDARD.decode(signature.trim()) else { return Ok(false) };
    let Ok(sig) = Signature::from_slice(&sig) else { return Ok(false) };
    Ok(key.verify_strict(text.as_bytes(), &sig).is_ok())
}
