//! PASETO v4 tokens, the safer JWT: `v4.local` encrypted with a shared key and `v4.public` signed with Ed25519, with expiry required and checked, and the audience and issuer when asked for, for sessions and APIs.
//! version: 2.0.0
//! effects: time, random
//! From 1.x: tokens without `exp` (made with expires_in 0) are refused; check them with paseto_decrypt_check or paseto_verify_check and allow_non_expiring: true to keep taking them.
//!
//! [dependencies]
//! pasetors = "0.7"
//! base64 = "0.22"

use base64::engine::general_purpose::STANDARD;
use base64::Engine;
use pasetors::claims::{Claims, ClaimsValidationRules};
use pasetors::errors::{ClaimValidationError as C, Error};
use pasetors::keys::{AsymmetricKeyPair, AsymmetricPublicKey, AsymmetricSecretKey, Generate, SymmetricKey};
use pasetors::token::UntrustedToken;
use pasetors::version4::V4;
use pasetors::{local, public, Local, Public};
use serde_json::Value;
use std::collections::HashMap;

fn key_bytes(text: &str, len: usize, what: &str) -> Result<Vec<u8>, String> {
    let b = STANDARD.decode(text.trim()).map_err(|_| format!("the {} is not base64", what))?;
    if b.len() != len {
        return Err(format!("the {} is {} bytes, not {}", what, len, b.len()));
    }
    Ok(b)
}

fn claims(values: Value, expires_in: i64) -> Result<Claims, String> {
    let Value::Object(map) = values else { return Err("the claims are a map".into()) };
    let mut c = Claims::new().map_err(|e| e.to_string())?;
    if expires_in > 0 {
        c.set_expires_in(&std::time::Duration::from_secs(expires_in.min(10 * 365 * 86400) as u64)).map_err(|e| e.to_string())?;
    } else {
        c.non_expiring();
    }
    for (k, v) in map {
        let text = || v.as_str().map(str::to_string).ok_or_else(|| format!("`{}` is text", k));
        let r = match k.as_str() {
            "iss" => c.issuer(&text()?),
            "sub" => c.subject(&text()?),
            "aud" => c.audience(&text()?),
            "jti" => c.token_identifier(&text()?),
            "exp" => c.expiration(&text()?),
            "nbf" => c.not_before(&text()?),
            "iat" => c.issued_at(&text()?),
            _ => c.add_additional(&k, v.clone()),
        };
        r.map_err(|e| format!("claim `{}`: {}", k, e))?;
    }
    Ok(c)
}

/// The checks for `options`: `audience` and `issuer` (the token must have them, equal), and
/// `allow_non_expiring` (false). The checkers took tokens that never expire, and had no way to
/// ask for an audience or an issuer, so a token for another service signed with the same key
/// passed (quillo FEEDBACK78.md, Q-1164; quillo-website branch auth-plugins).
fn rules(options: &Value) -> Result<ClaimsValidationRules, String> {
    let mut r = ClaimsValidationRules::new();
    match options {
        Value::Null => {}
        Value::Object(o) => {
            for (k, v) in o {
                match (k.as_str(), v) {
                    ("audience", Value::String(a)) if !a.is_empty() => r.validate_audience_with(a),
                    ("issuer", Value::String(i)) if !i.is_empty() => r.validate_issuer_with(i),
                    ("allow_non_expiring", Value::Bool(true)) => r.allow_non_expiring(),
                    ("allow_non_expiring", Value::Bool(false)) => {}
                    ("audience" | "issuer", _) => return Err(format!("option `{}` is a text that is not empty", k)),
                    ("allow_non_expiring", _) => return Err("option `allow_non_expiring` is true or false".into()),
                    _ => return Err(format!("no option `{}` (audience, issuer, allow_non_expiring)", k)),
                }
            }
        }
        _ => return Err("the options are a map".into()),
    }
    Ok(r)
}

/// Why a token was refused, in words; a token that does not open says so without telling which part failed.
fn why(e: Error) -> String {
    match e {
        Error::ClaimValidation(c) => match c {
            C::NoExp => "the token has no exp, so it would never expire: refused unless allow_non_expiring is true".into(),
            C::Exp => "the token has expired".into(),
            C::Nbf => "the token is not valid yet (nbf)".into(),
            C::Iat => "the token says it was made in the future (iat)".into(),
            C::NoAud => "the token has no aud, and an audience was asked for".into(),
            C::Aud => "the token is for another audience".into(),
            C::NoIss => "the token has no iss, and an issuer was asked for".into(),
            C::Iss => "the token is from another issuer".into(),
            o => format!("the token's claims are not right: {:?}", o),
        },
        o => format!("{}: wrong key, or the token was changed", o),
    }
}

fn payload(c: Option<&Claims>) -> Result<Value, String> {
    let c = c.ok_or("the token has no claims")?;
    serde_json::from_str(&c.to_string().map_err(|e| e.to_string())?).map_err(|e| e.to_string())
}

/// A new key for v4.local tokens: 32 random bytes as base64. Everyone who has it can make and read tokens.
pub fn paseto_local_key() -> Result<String, String> {
    Ok(STANDARD.encode(SymmetricKey::<V4>::generate().map_err(|e| e.to_string())?.as_bytes()))
}

/// A `v4.local.` token holding `claims` encrypted with `key`: nobody without the key can read or change them. `iat` and `nbf`
/// are set to now; `exp` to now plus `expires_in` seconds (0: never expires, which the checkers refuse unless told
/// `allow_non_expiring`). `iss`, `sub`, `aud`, `jti` are text.
pub fn paseto_encrypt(claims_map: serde_json::Value, key: &str, expires_in: i64) -> Result<String, String> {
    let k = SymmetricKey::<V4>::from(&key_bytes(key, 32, "key")?).map_err(|e| e.to_string())?;
    local::encrypt(&k, &claims(claims_map, expires_in)?, None, None).map_err(|e| e.to_string())
}

/// The claims of a v4.local token made with `key`; an error for another key, a changed token, one that has expired, and one
/// with no `exp` (it would never expire). `paseto_decrypt_check` takes options.
/// From 1.x: tokens without `exp` are refused; use `paseto_decrypt_check(token, key, { allow_non_expiring: true })` to keep taking them.
pub fn paseto_decrypt(token: &str, key: &str) -> Result<Value, String> {
    paseto_decrypt_check(token, key, Value::Null)
}

/// `paseto_decrypt` with `options`: `audience` and `issuer` (the token's `aud` and `iss` must be there and equal them), and
/// `allow_non_expiring` (true takes a token with no `exp`; false by default).
pub fn paseto_decrypt_check(token: &str, key: &str, options: serde_json::Value) -> Result<Value, String> {
    let r = rules(&options)?;
    let k = SymmetricKey::<V4>::from(&key_bytes(key, 32, "key")?).map_err(|e| e.to_string())?;
    let t = UntrustedToken::<Local, V4>::try_from(token.trim()).map_err(|e| format!("not a v4.local token: {}", e))?;
    let trusted = local::decrypt(&k, &t, &r, None, None).map_err(why)?;
    payload(trusted.payload_claims())
}

/// A new Ed25519 key pair for v4.public tokens: `{ secret, public }`, base64 (64 and 32 bytes). Sign with `secret`; give
/// `public` to the services that check.
pub fn paseto_keypair() -> Result<HashMap<String, String>, String> {
    let kp = AsymmetricKeyPair::<V4>::generate().map_err(|e| e.to_string())?;
    Ok(HashMap::from([
        ("secret".to_string(), STANDARD.encode(kp.secret.as_bytes())),
        ("public".to_string(), STANDARD.encode(kp.public.as_bytes())),
    ]))
}

/// A `v4.public.` token: `claims` readable by anyone, signed with `secret`; `exp` as paseto_encrypt sets it.
pub fn paseto_sign(claims_map: serde_json::Value, secret: &str, expires_in: i64) -> Result<String, String> {
    let k = AsymmetricSecretKey::<V4>::from(&key_bytes(secret, 64, "secret key")?).map_err(|e| e.to_string())?;
    public::sign(&k, &claims(claims_map, expires_in)?, None, None).map_err(|e| e.to_string())
}

/// The claims of a v4.public token, checked with `public_key`; an error for a wrong signature, an expired token, and one with
/// no `exp`. `paseto_verify_check` takes options.
/// From 1.x: tokens without `exp` are refused; use `paseto_verify_check(token, public_key, { allow_non_expiring: true })` to keep taking them.
pub fn paseto_verify(token: &str, public_key: &str) -> Result<Value, String> {
    paseto_verify_check(token, public_key, Value::Null)
}

/// `paseto_verify` with `options`: `audience` and `issuer` (the token's `aud` and `iss` must be there and equal them), and
/// `allow_non_expiring` (true takes a token with no `exp`; false by default).
pub fn paseto_verify_check(token: &str, public_key: &str, options: serde_json::Value) -> Result<Value, String> {
    let r = rules(&options)?;
    let k = AsymmetricPublicKey::<V4>::from(&key_bytes(public_key, 32, "public key")?).map_err(|e| e.to_string())?;
    let t = UntrustedToken::<Public, V4>::try_from(token.trim()).map_err(|e| format!("not a v4.public token: {}", e))?;
    let trusted = public::verify(&k, &t, &r, None, None).map_err(why)?;
    payload(trusted.payload_claims())
}
