//! Slugs for addresses from any title, any script: "Crème brûlée à Paris" is "creme-brulee-a-paris", "東京" is "dong-jing".
//! version: 1.0.0
//!
//! [dependencies]
//! slug = "0.1"
//! deunicode = "1"

/// `text` as a slug: ASCII letters and digits, lower case, words joined by `-`.
pub fn slugify(text: &str) -> String {
    slug::slugify(text)
}

/// A slug not in `taken`: `slugify(text)`, else with `-2`, `-3`, ... after it.
pub fn unique_slug(text: &str, taken: Vec<String>) -> String {
    let base = slug::slugify(text);
    let base = if base.is_empty() { "item".to_string() } else { base };
    if !taken.contains(&base) {
        return base;
    }
    (2..).map(|n| format!("{}-{}", base, n)).find(|s| !taken.contains(s)).unwrap()
}

/// `text` in plain ASCII, accents and other scripts written in Latin letters, case and spaces kept.
pub fn transliterate(text: &str) -> String {
    deunicode::deunicode(text)
}
