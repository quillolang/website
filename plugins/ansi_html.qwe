// A CI page: a test run's colored output shown as the terminal showed it, with classes and a
// style sheet, or as plain text for an email.
//
//   quillo run ansi_html.qwe      then open http://localhost:8080/run

use "ansi_html.qwer"

let LOG = read_file("ansi_html_sample.log")

route GET /run = respond(200, `<!doctype html><title>Run 1042</title><style>body{margin:0;background:#1e1e1e}</style><pre style="color:#ccc;padding:16px;font:13px/1.45 monospace">${ansi_to_html(LOG)}</pre>`, { "content-type": "text/html; charset=utf-8" })

route GET /classes = {
    html: ansi_to_html_with(LOG, { classes: true, theme: "light", pre: true })?,
    css: ansi_css("light", "ansi-")?,
}

route GET /plain = respond(200, ansi_strip(LOG), { "content-type": "text/plain; charset=utf-8" })
