// A checkout form's card field checked before the payment provider is called: brand, check digit, expiry, and a masked number for the receipt.
//
//   quillo run cards.qwe      then open http://localhost:8080/check?number=4242%204242%204242%204242

use "cards.qwer"

route GET /check ? { number: str } = { card: card_check(number), shown: card_mask(number) ?? null, typed: card_format(number) ?? null }

route GET /test-cards = ["4242424242424242", "5555 5555 5555 4444", "3782 822463 10005", "6011111111111117", "4242424242424241"] | map((n) => { number: n, brand: card_check(n).brand, valid: card_valid(n), receipt: card_mask(n)? })

route GET /expiry = { old: card_expiry_ok(1, 20), future: card_expiry_ok(12, 2035), bad_month: card_expiry_ok(13, 2030) }
