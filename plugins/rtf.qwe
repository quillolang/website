// A letting agent's letters: a tenant's RTF letter read into the case file, and a new letter written in RTF for Word.
//
//   quillo run rtf.qwe      then open http://localhost:8080/letter, /info and /write

use "rtf.qwer"

route GET /letter = respond(200, rtf_file_text("rtf_sample.rtf")?, { "content-type": "text/plain; charset=utf-8" })

route GET /info = rtf_info("rtf_sample.rtf")?

route GET /write {
    let doc = rtf_build([
        { text: "Rent statement", heading: 1, align: "center" },
        ["Dear ", { text: "Ms Pereira", bold: true }, ", here is this year's rent, in €."],
        { table: [["Month", "Paid"], ["October", "€1,250"], ["November", "€1,250"]], widths: [6.0, 4.0], header: true },
        { text: "Thank you — Harbour Lettings", italic: true },
    ], { font: "Calibri", size: 11.0, title: "Rent statement", author: "Harbour Lettings" })?
    write_file("data/rent-statement.rtf", doc)
    { bytes: len(doc), back: rtf_to_text(doc)?, title: rtf_info("data/rent-statement.rtf")?.title }
}

route GET /download = respond(200, rtf_build(["Hello from Quillo", { text: "Bold and big", bold: true, size: 16.0 }], {})?, { "content-type": "application/rtf", "content-disposition": "attachment; filename=hello.rtf" })
