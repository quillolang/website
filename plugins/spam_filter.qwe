// Comments on a blog, held back when they look like spam; the "spam" and "not spam" buttons
// of the moderation page teach the filter.
//
//   quillo run spam_filter.qwe      then open http://localhost:8080/comment?text=Great%20post,%20thanks

use "spam_filter.qwer"

let MODEL = "data/spam-model.json"

// A first lesson, the first time the program runs.
if spam_stats(MODEL)?.ham == 0 {
    for t in ["Thanks for the clear write-up, the part on caching helped", "I tried this on my project and it worked, merci",
              "Could you explain how the router picks a route?", "Nice post. A typo in the second paragraph: 'teh'"] { spam_train(MODEL, t, false)? }
    for t in ["CHEAP PILLS ONLINE best price click https://pills.example now", "Earn $5000 a week from home, click here https://money.example",
              "Best casino bonus, free spins, click https://casino.example", "Buy followers cheap, best price, limited offer"] { spam_train(MODEL, t, true)? }
}

route GET /comment ? { text: str } {
    let v = spam_check(MODEL, text, 0.9)?
    { held: v.spam, score: v.score, because: v.words | map((w) => w.word) }
}

route GET /mark ? { text: str, spam: bool } = spam_train(MODEL, text, spam)?
