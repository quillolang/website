// An editor's sidebar: a draft's length, reading time and how easy it is to read.
//
//   quillo run text_stats.qwe      then open http://localhost:8080/draft

use "text_stats.qwer"

let easy = "The cat sat on the mat. It was a sunny day. The cat was happy."
let hard = "Notwithstanding the aforementioned considerations, the committee's deliberations necessitated comprehensive reevaluation of institutional responsibilities."

route GET /draft = { easy: text_stats(easy)?, hard: text_stats(hard)?, label: text_reading_time(easy) }

route POST /stats = text_stats(request.body)?

route GET /syllables ? { word: str } = { word, syllables: text_syllables(word) }
