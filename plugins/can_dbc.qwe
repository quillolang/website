// An electric vehicle's CAN bus: the battery's and the engine's messages, described in a DBC
// file, decoded from a candump log; a single frame read, and a frame built to send.
//
//   quillo run can_dbc.qwe      then open http://localhost:8080/log and http://localhost:8080/frame

use "can_dbc.qwer"

let DBC = "can_dbc_sample.dbc"

route GET /messages = dbc_read(DBC)?.messages | map((m) => { name: m.name, id: m.id_hex, signals: map(m.signals, (s) => `${s.name} (${s.byte_order}, ${s.unit})`) })

route GET /log = dbc_decode_log(DBC, read_file("can_dbc_sample.log")?, 10)?

route GET /frame = {
    battery: dbc_decode(DBC, 256, "0F 0C FB 1B A3 20 1F 00")?.signals,
    engine: dbc_decode(DBC, 217056256, "0300A7502D000000")?.signals.EngineSpeed,
    built: dbc_encode(DBC, "BMS_Status", { PackVoltage: 385.2, PackCurrent: -125.3, StateOfCharge: 81.5, State: "Discharging", MaxCellTemp: 31 })?,
    too_high: dbc_encode(DBC, "BMS_Status", { StateOfCharge: 120 }).error,
    comment: dbc_read(DBC)?.messages[1].signals[1].comment,
}
