// Gzip a file, and text both ways.
//
//   quillo run gzip.qwe      then open http://localhost:8080/pack

use "gzip.qwer"

route GET /pack {
    write_file("report.txt", repeat("Quillo packs this line well. ", 2000))
    let size = gzip_file("report.txt", "report.txt.gz", 9)?
    let packed = gzip_text("hello, hello, hello")?
    { file_bytes: size, text: packed, back: gunzip_text(packed)? }
}
