//! SQL made readable: queries pretty-printed with indents and line breaks, keywords upper-cased, placeholders filled in for logs, and squeezed back onto one line.
//! version: 1.0.0
//!
//! [dependencies]
//! sqlformat = "0.2"

use serde_json::Value;

const MAX_SQL: usize = 1 << 20;

fn opts(indent: i64, uppercase: bool) -> sqlformat::FormatOptions {
    sqlformat::FormatOptions {
        indent: if indent <= 0 { sqlformat::Indent::Tabs } else { sqlformat::Indent::Spaces(indent.min(8) as u8) },
        uppercase,
        lines_between_queries: 2,
    }
}

fn size(sql: &str) -> Result<(), String> {
    if sql.len() > MAX_SQL {
        return Err("SQL is at most 1 MB here".into());
    }
    Ok(())
}

/// The SQL pretty-printed: each clause on its own line, `indent` spaces per level (0 for tabs), keywords in capitals when `uppercase`. Several statements are kept apart by a blank line.
/// It only lays out the text, so it also works on SQL that a database would refuse.
pub fn sql_pretty(sql: &str, indent: i64, uppercase: bool) -> Result<String, String> {
    size(sql)?;
    Ok(sqlformat::format(sql, &sqlformat::QueryParams::None, opts(indent, uppercase)))
}

/// The SQL pretty-printed with its `?` (or `$1`, `:name` given as a map) placeholders filled in from `params`, for logs and debugging:
/// text is quoted with `'` doubled, numbers and booleans as they are, null as NULL. Never run the result: send the params to the database instead.
pub fn sql_pretty_with_params(sql: &str, params: serde_json::Value) -> Result<String, String> {
    size(sql)?;
    let lit = |v: &Value| match v {
        Value::Null => "NULL".to_string(),
        Value::String(s) => format!("'{}'", s.replace('\'', "''")),
        Value::Bool(b) => if *b { "TRUE".into() } else { "FALSE".into() },
        Value::Number(n) => n.to_string(),
        other => format!("'{}'", other.to_string().replace('\'', "''")),
    };
    let p = match &params {
        Value::Array(xs) => sqlformat::QueryParams::Indexed(xs.iter().map(lit).collect()),
        Value::Object(m) => sqlformat::QueryParams::Named(m.iter().map(|(k, v)| (k.clone(), lit(v))).collect()),
        Value::Null => sqlformat::QueryParams::None,
        _ => return Err("params are a list (for ? and $1) or a map (for :name)".into()),
    };
    Ok(sqlformat::format(sql, &p, opts(2, true)))
}

/// The SQL on one line: comments removed and runs of spaces and line breaks made one space, leaving quoted text ('...', "...", `...`) untouched. For logs and cache keys.
pub fn sql_one_line(sql: &str) -> Result<String, String> {
    size(sql)?;
    let cs: Vec<char> = sql.chars().collect();
    let mut out = String::new();
    let mut i = 0;
    let mut space = false;
    while i < cs.len() {
        let c = cs[i];
        if c == '\'' || c == '"' || c == '`' {
            if space && !out.is_empty() {
                out.push(' ');
            }
            space = false;
            out.push(c);
            i += 1;
            while i < cs.len() {
                out.push(cs[i]);
                if cs[i] == c {
                    if i + 1 < cs.len() && cs[i + 1] == c {
                        out.push(c);
                        i += 2;
                        continue;
                    }
                    break;
                }
                i += 1;
            }
            i += 1;
        } else if c == '-' && cs.get(i + 1) == Some(&'-') {
            while i < cs.len() && cs[i] != '\n' {
                i += 1;
            }
            space = true;
        } else if c == '/' && cs.get(i + 1) == Some(&'*') {
            i += 2;
            while i + 1 < cs.len() && !(cs[i] == '*' && cs[i + 1] == '/') {
                i += 1;
            }
            i += 2;
            space = true;
        } else if c.is_whitespace() {
            space = true;
            i += 1;
        } else {
            if space && !out.is_empty() && !matches!(c, ',' | ')' | ';') && !out.ends_with('(') {
                out.push(' ');
            }
            space = false;
            out.push(c);
            i += 1;
        }
    }
    Ok(out)
}
