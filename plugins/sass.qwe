// A storefront whose stylesheet is compiled from SCSS at start, with each tenant's brand color
// put in as a variable.
//
//   quillo run sass.qwe      then open http://localhost:8080/app.css and http://localhost:8080/tenant/berry.css

use "sass.qwer"

let APP = sass_compile_file("sass_sample.scss", "compressed", {}, [])?

route GET /app.css = respond(200, APP.css, { "content-type": "text/css" })

let TENANTS = { berry: "#ad1457", ocean: "#0277bd" }

// The theme's `$brand: ... !default` gives way to the tenant's color.
route GET /tenant/:name {
    let color = TENANTS[replace(name, ".css", "")] ?? reply 404 "no such tenant"
    let css = sass_compile('@use "sass_sample_theme" with ($brand: ' + color + ');\n.badge { background: sass_sample_theme.$brand; }', "expanded", {}, "scss", ["."])?
    respond(200, css, { "content-type": "text/css" })
}

route GET /demo = {
    indented: sass_compile("$pad: 4px\n.tag\n  padding: $pad * 2\n  &:hover\n    opacity: .8\n", "compressed", {}, "sass", [])?,
    variables: sass_compile(".hero { color: $ink; margin: $space * 2; }", "compressed", { ink: "#212121", space: "12px" }, "scss", [])?,
    warned: sass_check('@warn "the old grid is going away";\n.a { b: c }', "scss"),
    broken: sass_check(".a { color: $nope; }", "scss"),
}
