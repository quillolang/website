// Money split to the cent, the parts always adding up: partners' profit by their shares, a
// subscription in instalments, a dinner bill by who had what (tax and tip in proportion), a
// holiday's shared costs settled in few payments, and a plan changed mid-month. All in cents.
//
//   quillo run money_split.qwe      then open http://localhost:8080/split and http://localhost:8080/dinner

use "money_split.qwer"

route GET /split = {
    profit: money_split_ratios(100000, [50.0, 30.0, 20.0])?,
    thirds: money_split_ratios(100, [1.0, 1.0, 1.0])?,
    refund: money_split_even(-1000, 3)?,
    plan: money_split_installments(100000, 3, { start: "2026-01-31", every: "month", remainder: "last" })?,
    upgrade: money_split_prorate(3000, "2026-11-01", "2026-12-01", "2026-11-18", "2026-12-01")?,
}

route GET /dinner = money_split_bill([
    { name: "Pizza", price: 1450, shared_by: ["Ann", "Bo"] },
    { name: "Salad", price: 990, shared_by: ["Cy"] },
    { name: "Wine", price: 3200 },
    { name: "Tiramisu", price: 750, shared_by: ["Ann"] },
], ["Ann", "Bo", "Cy"], { tax_percent: 8.875, tip_percent: 18.0 })?

route GET /holiday = money_split_settle([
    { paid_by: "Ann", amount: 42000, between: ["Ann", "Bo", "Cy", "Dee"] },
    { paid_by: "Bo", amount: 9000 },
    { paid_by: "Cy", amount: 12000, between: ["Cy", "Dee"], weights: [1.0, 2.0] },
], ["Ann", "Bo", "Cy", "Dee"])?
