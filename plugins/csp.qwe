// A Content-Security-Policy for a shop: built from a map, a nonce per page for its inline
// script, and checks of the policy and of what it lets load.
//
//   quillo run csp.qwe      then open http://localhost:8080/ and http://localhost:8080/check

use "csp.qwer"

let POLICY = csp_build({
    "default-src": ["self"],
    "script-src": ["self", "strict-dynamic"],
    "style-src": "self https://fonts.googleapis.com",
    "font-src": "https://fonts.gstatic.com",
    "img-src": "self data: https://*.cdn.example.com",
    "object-src": ["none"],
    "base-uri": ["none"],
    "frame-ancestors": ["none"],
    "form-action": ["self"],
})

route GET / {
    let nonce = csp_nonce()
    respond(200, `<!doctype html><title>Shop</title><h1>Shop</h1><script nonce="${nonce}">document.title += " ✓"</script>`, {
        "content-type": "text/html; charset=utf-8",
        "content-security-policy": csp_with_nonce(POLICY, nonce),
    })
}

route GET /policy = { header: csp_with_nonce(POLICY, "R4nd0m"), parsed: csp_parse(POLICY) }

// An old policy graded, and the shop's own once a nonce is in.
route GET /check = {
    old: csp_check("script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; img-src *"),
    ours: csp_check(csp_with_nonce(POLICY, "R4nd0m")),
}

// What may load on https://shop.example.com/cart.
route GET /allows {
    let page = "https://shop.example.com/cart"
    {
        product_image: csp_allows(POLICY, "img-src", "https://img.cdn.example.com/p/42.webp", page)?,
        tracker_image: csp_allows(POLICY, "img-src", "https://tracker.example.net/pixel.gif", page)?,
        font: csp_allows(POLICY, "font-src", "https://fonts.gstatic.com/s/inter.woff2", page)?,
        frame_elsewhere: csp_allows(POLICY, "frame-src", "https://ads.example.org/", page)?,
        inline_hash: csp_hash("alert(1)", "sha256")?,
    }
}
