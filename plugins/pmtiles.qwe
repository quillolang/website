// PMTiles: one file of map tiles, read from disk or from any server that answers Range requests.
// The Hilbert ids, the header, a tile from the root, one from a leaf, one from a run of equal
// tiles, and an archive replaced part way through.
//
//   node standins/pmtiles_sample.mjs      makes the sample files
//   PMTILES_URL=http://127.0.0.1:9000 quillo run pmtiles.qwe     (a server holding sample.pmtiles)
//   then open http://localhost:8080/ids, /header, /tiles, /layouts, /remote and /refused

use "pmtiles.qwer"

let sample = "pmtiles_sample.pmtiles"
let remote = env("PMTILES_URL", "http://127.0.0.1:9000")

route GET /ids = {
    root: pmtiles_tile_id(0, 0, 0)?,
    first: [pmtiles_tile_id(1, 0, 0)?, pmtiles_tile_id(1, 0, 1)?, pmtiles_tile_id(1, 1, 1)?, pmtiles_tile_id(1, 1, 0)?],
    next_zoom: pmtiles_tile_id(2, 0, 0)?,
    published: pmtiles_tile_id(12, 3423, 1763)?,
    deep: pmtiles_tile_id(14, 8000, 5000)?,
    back: pmtiles_tile_zxy(19078479)?,
    deep_back: pmtiles_tile_zxy(pmtiles_tile_id(14, 8000, 5000)?)?,
}

route GET /header = {
    header: pmtiles_header(sample)?,
    metadata: pmtiles_metadata(sample)?,
    root: pmtiles_directory(sample, 10)?,
}

route GET /tiles/:z(int)/:x(int)/:name {
    let y = int(split(name, ".")[0])
    let to = "data/pmtiles-" + str(z) + "-" + str(x) + "-" + str(y) + ".png"
    let t = pmtiles_tile_to_file(sample, z, x, y, to)?
    if !t.found { reply 404 "no such tile" }
    file(to)
}

route GET /tiles = {
    in_root: pmtiles_tile(sample, 0, 0, 0)?,
    in_leaf: pmtiles_tile(sample, 2, 3, 1)?.bytes,
    run_start: pmtiles_tile(sample, 3, 0, 0)?.base64,
    run_end: pmtiles_tile(sample, 3, 1, 3)?.base64,
    past_run: pmtiles_tile(sample, 3, 7, 7)?.found,
    past_zoom: pmtiles_tile(sample, 9, 0, 0)?.found,
}

route GET /layouts = {
    plain: pmtiles_header("pmtiles_plain.pmtiles")?.tile_type,
    gzipped_tile: pmtiles_tile("pmtiles_plain.pmtiles", 2, 1, 1)?.compression,
    undone: pmtiles_tile_to_file("pmtiles_plain.pmtiles", 2, 1, 1, "data/pmtiles-plain.mvt")?.bytes,
    brotli: pmtiles_tile("pmtiles_brotli.pmtiles", 2, 1, 1)?.bytes,
    brotli_name: pmtiles_header("pmtiles_brotli.pmtiles")?.internal_compression,
    zstd: pmtiles_tile("pmtiles_zstd.pmtiles", 2, 1, 1)?.bytes,
    zstd_meta: pmtiles_metadata("pmtiles_zstd.pmtiles")?.name,
}

// The same archive over HTTP. /moved.pmtiles is replaced after the second range: the plugin sees
// the new ETag and starts over, rather than mix old directories with new tiles.
route GET /remote = {
    header: pmtiles_header(remote + "/sample.pmtiles")?.addressed_tiles,
    tile: pmtiles_tile(remote + "/sample.pmtiles", 2, 3, 1)?.bytes,
    again: pmtiles_tile(remote + "/sample.pmtiles", 2, 3, 1)?.bytes,
    moved: pmtiles_tile(remote + "/moved.pmtiles", 2, 3, 1)?.bytes,
    moved_again: pmtiles_tile(remote + "/moved.pmtiles", 2, 1, 1)?.bytes,
    no_ranges: pmtiles_header(remote + "/plain.pmtiles").error,
    missing: pmtiles_header(remote + "/none.pmtiles").error,
}

route GET /refused = {
    off_the_map: pmtiles_tile(sample, 1, 2, 0).error,
    no_file: pmtiles_header("nothing.pmtiles").error,
    not_archive: pmtiles_header("pmtiles.qwe").error,
    negative: pmtiles_tile_zxy(-1).error,
}
