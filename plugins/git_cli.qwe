// A dashboard for a working copy: what has changed, which branches lead or lag, who wrote which
// line, what a commit touched. It makes its own throwaway repository in a temporary folder, so
// there is nothing to set up, and no real repository is touched.
//
//   quillo run git_cli.qwe      then open http://localhost:8080/status, /branches and /blame
//
// GIT_CLI_REPO names the folder it makes. For your own repository, point the functions at it.

use "git_cli.qwer"

let REPO = env("GIT_CLI_REPO", "/tmp/quillo-git-cli-demo")
let ADA = { author: "Ada Lovelace <ada@example.com>" }
let GRACE = { author: "Grace Hopper <grace@example.com>" }

fn write_in(name, text) { git_cli_write(REPO, name, text) }

fn setup() {
    git_cli_discard(REPO)?
    git_cli_init(REPO, "main")?
    git_cli_run(REPO, ["config", "user.name", "Demo"], {})?
    git_cli_run(REPO, ["config", "user.email", "demo@example.com"], {})?
    write_in("poem.txt", "one\ntwo\nthree\n")
    write_in("logo.bin", "\u0000\u0001\u0002binary")
    write_in("old-name.txt", "this file will be moved\nit has lines\nthat stay the same\n")
    let first = git_cli_commit(REPO, "First commit\n\nWith a body line.", [], ADA)?
    write_in("poem.txt", "one\ntwo, changed\nthree\nfour\n")
    let second = git_cli_commit(REPO, "Change the poem", [], GRACE)?
    git_cli_tag(REPO, "v1.0", "First release", ADA)?
    git_cli_tag(REPO, "light", "", {})?
    git_cli_run(REPO, ["branch", "feature/x"], {})?
    git_cli_run(REPO, ["branch", "behind", first], {})?
    git_cli_run(REPO, ["branch", "--set-upstream-to=main", "behind"], {})?
    git_cli_run(REPO, ["mv", "old-name.txt", "new-name.txt"], {})?
    write_in("poem.txt", "one\ntwo, changed\nthree\nfour\nfive\n")
    write_in("notes with spaces.txt", "untracked\n")
    write_in("ümlaut.txt", "untracked too\n")
    { first: first, second: second }
}

let made = setup()

route GET /status {
    let s = git_cli_status(REPO, {})?
    { branch: s.branch, has_commit: len(s.commit) == 40, detached: s.detached, clean: s.clean, staged: s.staged, unstaged: s.unstaged, untracked: s.untracked, conflicts: s.conflicts, ahead: s.ahead, upstream: s.upstream }
}

route GET /branches {
    let all = git_cli_branches(REPO)?
    all | map((b) => [b.name, b.current, b.upstream, b.ahead, b.behind, b.subject])
}

route GET /tags {
    let t = git_cli_tags(REPO)?
    t | map((x) => [x.name, x.annotated, x.commit == made.second, x.tagger, x.subject])
}

route GET /diff = {
    worktree: git_cli_diff_stat(REPO, {})?,
    staged: git_cli_diff_stat(REPO, { staged: true })?,
    between: git_cli_diff_stat(REPO, { from: made.first, to: made.second })?,
    one_file: git_cli_diff_stat(REPO, { from: made.first, to: made.second, path: "logo.bin" })?.changed,
}

route GET /blame {
    let b = git_cli_blame(REPO, "poem.txt", { rev: "HEAD" })?
    { lines: b.lines | map((l) => [l.line, l.author, l.text]), authors: b.authors, some: git_cli_blame(REPO, "poem.txt", { rev: "HEAD", from: 2, to: 2 })?.lines[0].text, summary: b.lines[1].summary, email: b.lines[0].email }
}

route GET /show {
    let c = git_cli_show(REPO, made.first)?
    let d = git_cli_show(REPO, made.second)?
    { subject: c.subject, body: c.body, author: c.author, email: c.email, root: len(c.parents), files: c.files | map((f) => [f.path, f.added, f.binary]), second_parent: d.parents[0] == made.first, second: [d.subject, d.author, d.added, d.deleted] }
}

route GET /file = {
    then: git_cli_file(REPO, made.first, "poem.txt")?,
    gone: git_cli_file(REPO, made.first, "no-such-file.txt")?,
    via_tag: git_cli_file(REPO, "v1.0", "poem.txt")?,
}

// A throwaway commit on top, then a clean tree, a detached HEAD and a conflict.
route GET /states {
    let r = REPO + "-states"
    git_cli_discard(r)?
    git_cli_init(r, "trunk")?
    git_cli_run(r, ["config", "user.name", "Demo"], {})?
    git_cli_run(r, ["config", "user.email", "demo@example.com"], {})?
    let empty = git_cli_status(r, {})?
    git_cli_write(r, "a.txt", "base\n")?
    let base = git_cli_commit(r, "base", [], {})?
    let clean = git_cli_status(r, {})?
    git_cli_run(r, ["checkout", "-q", "-b", "side"], {})?
    git_cli_write(r, "a.txt", "side\n")?
    git_cli_commit(r, "side", [], {})?
    git_cli_run(r, ["checkout", "-q", "trunk"], {})?
    git_cli_write(r, "a.txt", "trunk\n")?
    git_cli_commit(r, "trunk", [], {})?
    let merge = git_cli_run(r, ["merge", "side"], {})?
    let conflict = git_cli_status(r, {})?
    git_cli_run(r, ["merge", "--abort"], {})?
    git_cli_run(r, ["checkout", "-q", base], {})?
    let detached = git_cli_status(r, {})?
    {
        empty: [empty.branch, empty.commit, empty.clean],
        clean: [clean.branch, clean.clean],
        merge_failed: !merge.ok,
        conflict: conflict.conflicts,
        detached: [detached.branch, detached.detached],
    }
}

route GET /errors = {
    not_a_repo: git_cli_status("/tmp", {}).error,
    no_folder: git_cli_status("/no/such/folder", {}).error,
    option_as_rev: git_cli_show(REPO, "--output=/tmp/x").error,
    bad_rev: git_cli_show(REPO, "no-such-rev").error != null,
    bad_file: git_cli_blame(REPO, "no-such-file.txt", {}).error != null,
    empty_message: git_cli_commit(REPO, "  ", [], {}).error,
    outside: git_cli_write(REPO, "../escape.txt", "x").error,
    keep_real: git_cli_discard("/usr").error,
    raw: git_cli_run(REPO, ["log", "-1", "--format=%s"], {})?,
    raw_fail: git_cli_run(REPO, ["no-such-command"], {})?.ok,
}
