//! Signed links to S3, Cloudflare R2, MinIO, Backblaze or DigitalOcean Spaces: browsers upload and download directly, the server never holds the bytes.
//!
//! [dependencies]
//! rusty-s3 = "0.5"
//! url = "2"

use rusty_s3::{Bucket, Credentials, S3Action, UrlStyle};
use std::time::Duration;

fn env(name: &str) -> Result<String, String> {
    std::env::var(name).map_err(|_| format!("{} is not set (S3_ENDPOINT, S3_REGION, S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY)", name))
}

fn bucket() -> Result<(Bucket, Credentials), String> {
    let endpoint = url::Url::parse(&env("S3_ENDPOINT")?).map_err(|e| e.to_string())?;
    let style = if std::env::var("S3_VIRTUAL_HOSTS").is_ok() { UrlStyle::VirtualHost } else { UrlStyle::Path };
    let b = Bucket::new(endpoint, style, env("S3_BUCKET")?, env("S3_REGION")?).map_err(|e| e.to_string())?;
    Ok((b, Credentials::new(env("S3_ACCESS_KEY")?, env("S3_SECRET_KEY")?)))
}

fn secs(s: i64) -> Duration {
    Duration::from_secs(s.clamp(1, 7 * 24 * 3600) as u64)
}

/// A link that downloads `key` for `seconds`: put it in an `<a>` or an `<img>`.
pub fn s3_download_url(key: &str, seconds: i64) -> Result<String, String> {
    let (b, c) = bucket()?;
    Ok(b.get_object(Some(&c), key).sign(secs(seconds)).to_string())
}

/// A link the browser PUTs a file to, as `key`, for `seconds`: `fetch(url, { method: "PUT", body: file })`.
pub fn s3_upload_url(key: &str, seconds: i64) -> Result<String, String> {
    let (b, c) = bucket()?;
    Ok(b.put_object(Some(&c), key).sign(secs(seconds)).to_string())
}

/// A link that deletes `key`, for `seconds`: call it from the server with `http.request`.
pub fn s3_delete_url(key: &str, seconds: i64) -> Result<String, String> {
    let (b, c) = bucket()?;
    Ok(b.delete_object(Some(&c), key).sign(secs(seconds)).to_string())
}
