// A person's notes in Org: the outline as data, a page of HTML, what is due this week from
// scheduled items and repeaters, and the tables pulled out.
//
//   quillo run org_mode.qwe      then open http://localhost:8080/outline, /item, /page, /todos, /agenda, /tables, /times and /broken

use "org_mode.qwer"

let TEXT = read_file("org_mode_sample.org")

fn brief(h) { { level: h.level, keyword: h.keyword, priority: h.priority, title: h.title, tags: h.tags, children: h.children | map(brief) } }

route GET /outline {
    let d = org_parse(TEXT)?
    { settings: d.settings, headlines: d.headlines | map(brief), todo: d.keywords }
}

route GET /item {
    let d = org_parse(TEXT)?
    let h = d.headlines[0].children[0]
    { title: h.title, inherited: h.all_tags, planning: h.planning, properties: h.properties, stamps: h.timestamps }
}

route GET /page = respond(200, org_to_html(TEXT, {})?, { "content-type": "text/plain" })

route GET /todos = org_todos(TEXT)? | map((t) => [t.keyword, t.priority, t.title, t.path])

route GET /agenda = org_agenda(TEXT, "2026-11-02", "2026-11-08")? | map((a) => `${a.date} ${a.time ?? "--:--"} ${a.kind} ${a.keyword ?? "-"} ${a.title}${a.warning ?? ""}`)

route GET /tables = org_tables(TEXT)?

route GET /times = {
    active: org_timestamp("<2026-11-01 Sun 09:30>")?,
    range: org_timestamp("<2026-11-01 Sun 09:30-11:00>")?,
    span: org_timestamp("[2026-11-01 Sun]--[2026-11-03 Tue]")?,
    repeat: org_timestamp("<2026-11-01 Sun +1w -2d>")?,
    wrong_day: org_timestamp("<2026-11-01 Mon>")?.day_ok,
    bad: org_timestamp("<2026-13-01>").error,
}

route GET /broken = {
    bad_range: org_agenda(TEXT, "2026-11-08", "2026-11-02").error,
    bad_date: org_agenda(TEXT, "soon", "2026-11-02").error,
    too_wide: org_agenda(TEXT, "2000-01-01", "2030-01-01").error,
    empty: org_parse("")?.headlines,
    unsafe: org_to_html("[[javascript:alert(1)][click]] <b>x</b>\n", {})?,
    html_block: org_to_html("#+BEGIN_EXPORT html\n<script>1</script>\n#+END_EXPORT\n", {})?,
    trusted: org_to_html("#+BEGIN_EXPORT html\n<i>1</i>\n#+END_EXPORT\n", { raw_html: true })?,
    open_block: org_parse("#+BEGIN_SRC\nnever closed\n")?.problems,
    open_drawer: org_parse("* A\n:PROPERTIES:\n:X: 1\n")?.problems,
}
