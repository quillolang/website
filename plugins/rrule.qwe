// A class schedule from a repeating rule: the sessions in a month, and the next one.
//
//   quillo run rrule.qwe      then open http://localhost:8080/november

use "rrule.qwer"

// Yoga on Mondays and Wednesdays at 18:30 in Amsterdam, 20 sessions, no class on 11 November.
let YOGA = rrule_text("2026-10-05T18:30:00", "Europe/Amsterdam", "FREQ=WEEKLY;BYDAY=MO,WE;COUNT=20")? + "\nEXDATE;TZID=Europe/Amsterdam:20261111T183000"

route GET /november = rrule_between(YOGA, "2026-11-01", "2026-11-30", 100)?

route GET /rules = {
    // Daylight saving ends on 25 October: the local time stays 18:30, the offset changes.
    around_dst: rrule_between(YOGA, "2026-10-19", "2026-10-29", 10)?,
    last_friday: rrule_first(rrule_text("2026-01-30T10:00:00", "UTC", "FREQ=MONTHLY;BYDAY=-1FR")?, 4)?,
    next: rrule_next(rrule_text("2026-01-01T09:00:00", "Europe/London", "FREQ=YEARLY;BYMONTH=12;BYMONTHDAY=25")?)?,
    bad: rrule_text("2026-01-01T09:00:00", "Mars/Olympus", "FREQ=DAILY").error,
}
