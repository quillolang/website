// GeoTIFF elevation files, in pure Rust: what a file is, its bounds, the height at a coordinate,
// a profile along a walk, and each storage the format allows.
//
//   node standins/geotiff_sample.mjs      makes the tiny sample files
//   quillo run geotiff.qwe
//   then open http://localhost:8080/info, /height?lon=11.2&lat=48.8, /profile, /formats and /refused

use "geotiff.qwer"

let dem = "geotiff_dem.tif"

route GET /info = {
    info: geotiff_info(dem)?,
    tags: geotiff_tags(dem)?,
    stats: geotiff_stats(dem, 1)?,
}

route GET /height ? { lon: float, lat: float } {
    let v = geotiff_value(dem, lon, lat, {})
    if is_err(v) { reply 422 v.error }
    v
}

route GET /heights = {
    first_cell: geotiff_value(dem, 10.1, 49.9, {})?,
    between: geotiff_value(dem, 10.5, 49.5, { method: "bilinear" })?.value,
    no_data: geotiff_value(dem, 12.9, 49.9, {})?,
    outside: geotiff_value(dem, 0.0, 0.0, {})?,
    pixel: geotiff_pixel(dem, 3, 4, 1)?,
    hole: geotiff_pixel(dem, 5, 0, 1)?,
}

route GET /profile {
    let p = geotiff_profile(dem, [[10.25, 49.75], [12.25, 49.75]], 5)?
    { values: p.points | map((x) => x.value), min: p.min, max: p.max, gain: p.gain, loss: p.loss }
}

// Each file stores its cells another way; every value must come out the same as it went in.
route GET /formats = {
    tiled: geotiff_info("geotiff_tiled.tif")?,
    tiled_value: geotiff_value("geotiff_tiled.tif", 500090.0, 4999940.0, {})?,
    tiled_stats: geotiff_stats("geotiff_tiled.tif", 1)?,
    lzw: geotiff_info("geotiff_lzw.tif")?,
    lzw_cells: [geotiff_pixel("geotiff_lzw.tif", 0, 0, 1)?, geotiff_pixel("geotiff_lzw.tif", 9, 3, 1)?],
    lzw_turned: geotiff_value("geotiff_lzw.tif", 1007.0, 2013.0, {})?,
    big: geotiff_info("geotiff_big.tif")?,
    big_bands: [geotiff_pixel("geotiff_big.tif", 3, 2, 1)?, geotiff_pixel("geotiff_big.tif", 3, 2, 2)?],
}

route GET /refused = {
    no_file: geotiff_info("nothing.tif").error,
    not_tiff: geotiff_info("geotiff.qwe").error,
    band: geotiff_value(dem, 10.5, 49.5, { band: 2 }).error,
    method: geotiff_value(dem, 10.5, 49.5, { method: "cubic" }).error,
    off: geotiff_pixel(dem, 99, 0, 1).error,
    line: geotiff_profile(dem, [[10, 49]], 5).error,
}
