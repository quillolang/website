// A lab interface: an admission message read, the patient's details picked out, and the ACK made.
//
//   quillo run hl7.qwe      then open http://localhost:8080/patient

use "hl7.qwer"

// A made-up ADT^A01 (admission) message; segments end with carriage returns.
let ADT = join([
    "MSH|^~\\&|LABSYS|QUILLO_HOSP|EHR|QUILLO_HOSP|20261102091500||ADT^A01^ADT_A01|MSG00042|P|2.5.1",
    "EVN|A01|20261102091500",
    "PID|1||PAT-1042^^^QUILLO^MR~NHS-943-476-5919^^^NHS^NH||Lovelace^Ada^King^^Countess||18151210|F|||12 St James's Square^^London^^SW1Y 4JH^GB||+44 20 7946 0958|||||||||||||||||N",
    "PV1|1|I|WARD7^12^B^QUILLO||||1234^Babbage^Charles|||MED||||1|||1234^Babbage^Charles|IN||||||||||||||||||||||||||20261102090000",
    "OBX|1|ST|NOTE^Note||Allergic to penicillin \\T\\ latex.\\.br\\Prefers mornings.||||||F",
], "\r")

route GET /patient = {
    message: hl7_get(ADT, "MSH-9")?,
    record_number: hl7_get(ADT, "PID-3.1")?,
    nhs_number: hl7_get(ADT, "PID-3[2].1")?,
    family: hl7_get(ADT, "PID-5.1")?,
    given: hl7_get(ADT, "PID-5.2")?,
    born: hl7_get(ADT, "PID-7")?,
    city: hl7_get(ADT, "PID-11.3")?,
    ward: hl7_get(ADT, "PV1-3.1")?,
    doctor: hl7_get(ADT, "PV1-7.3")?,
    note: hl7_get(ADT, "OBX-5")?,
}

route GET /message {
    let m = hl7_parse(ADT)?
    { type: m.type, event: m.event, control_id: m.control_id, version: m.version, sender: m.sender, segments: m.segments | map((s) => s.name), name_field: m.segments[2].fields[4] }
}

route GET /ack = respond(200, replace(hl7_ack(ADT, "AA", "Received")?, "\r", "\n"), { "content-type": "text/plain" })

route POST /hl7 {
    let m = hl7_parse(request.body)
    if is_err(m) { reply 400 m.error }
    respond(200, hl7_ack(request.body, "AA", "")?, { "content-type": "application/hl7-v2" })
}
