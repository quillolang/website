// A style sheet compressed with brotli for a CDN, and text both ways.
//
//   quillo run brotli.qwe      then open http://localhost:8080/pack

use "brotli.qwer"

route GET /pack {
    let rules = for i in range(400) => `.card-${i} { padding: ${i % 16}px; color: #333; border-radius: 4px; }`
    write_file("data/site.css", join(rules, "\n"))
    let size = brotli_file("data/site.css", "data/site.css.br", 11)?
    let packed = brotli_text("hello, hello, hello", 11)?
    {
        css_bytes: len(read_file("data/site.css")),
        br_bytes: size,
        unpacked_bytes: unbrotli_file("data/site.css.br", "data/site.copy.css")?,
        text: packed,
        back: unbrotli_text(packed)?,
    }
}
