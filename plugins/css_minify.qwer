//! CSS made small and ready for the browsers you support (lightningcss): minified with rules merged, vendor prefixes added and modern syntax (nesting, range media queries, new color functions) lowered for a browserslist query, and checked for errors with their line and column.
//! version: 1.0.0
//!
//! [dependencies]
//! lightningcss = { version = "1.0.0-alpha.72", default-features = false, features = ["browserslist"] }

use lightningcss::printer::PrinterOptions;
use lightningcss::stylesheet::{MinifyOptions, ParserOptions, StyleSheet};
use lightningcss::targets::{Browsers, Targets};
use serde_json::{json, Value};
use std::sync::{Arc, RwLock};

fn targets(query: &str) -> Result<Targets, String> {
    if query.trim().is_empty() {
        return Ok(Targets::default());
    }
    let browsers = Browsers::from_browserslist(query.split(',').map(str::trim)).map_err(|e| format!("browserslist `{}`: {}", query, e))?;
    Ok(Targets::from(browsers))
}

fn process(css: &str, query: &str, minify: bool, filename: &str) -> Result<String, String> {
    let t = targets(query)?;
    let opts = ParserOptions { filename: filename.to_string(), ..ParserOptions::default() };
    let mut sheet = StyleSheet::parse(css, opts).map_err(|e| e.to_string())?;
    sheet.minify(MinifyOptions { targets: t, ..MinifyOptions::default() }).map_err(|e| e.to_string())?;
    let out = sheet.to_css(PrinterOptions { minify, targets: t, ..PrinterOptions::default() }).map_err(|e| e.to_string())?;
    Ok(out.code)
}

/// `css` minified: spaces and comments gone, values shortened, rules merged. Gives an error value with the line and column
/// for CSS that does not parse.
pub fn css_minify(css: &str) -> Result<String, String> {
    process(css, "", true, "style.css")
}

/// `css` made to work in the browsers `browsers` names (a browserslist query: "defaults", "> 0.5%, last 2 versions, not dead",
/// "safari >= 13"): vendor prefixes added, nesting, range media queries, `rgb(r g b / a)` and other new syntax written the old
/// way where those browsers need it. `minify` false keeps it readable.
pub fn css_for_browsers(css: &str, browsers: &str, minify: bool) -> Result<String, String> {
    process(css, browsers, minify, "style.css")
}

/// Reads a stylesheet, makes it for `browsers` (empty: only minified) and writes it minified to `out_path`:
/// `{ bytes_in, bytes_out, saved_percent }`.
pub fn css_minify_file(in_path: &str, out_path: &str, browsers: &str) -> Result<Value, String> {
    let css = std::fs::read_to_string(in_path).map_err(|e| format!("{}: {}", in_path, e))?;
    let out = process(&css, browsers, true, in_path)?;
    if let Some(dir) = std::path::Path::new(out_path).parent() {
        std::fs::create_dir_all(dir).ok();
    }
    std::fs::write(out_path, &out).map_err(|e| format!("{}: {}", out_path, e))?;
    let saved = if css.is_empty() { 0.0 } else { (1.0 - out.len() as f64 / css.len() as f64) * 100.0 };
    Ok(json!({ "bytes_in": css.len(), "bytes_out": out.len(), "saved_percent": (saved * 10.0).round() / 10.0 }))
}

/// What is wrong in a stylesheet: `{ ok, errors: [{ message, line, column }] }`, lines from 1. Rules and declarations a browser
/// would drop are listed too, while the rest is still read.
pub fn css_check(css: &str) -> Value {
    let warnings = Arc::new(RwLock::new(Vec::new()));
    let opts = ParserOptions { filename: "style.css".into(), error_recovery: true, warnings: Some(warnings.clone()), ..ParserOptions::default() };
    let mut errors: Vec<Value> = vec![];
    match StyleSheet::parse(css, opts) {
        Ok(_) => {}
        Err(e) => errors.push(json!({ "message": e.kind.to_string(), "line": e.loc.as_ref().map(|l| l.line + 1), "column": e.loc.as_ref().map(|l| l.column) })),
    }
    if let Ok(w) = warnings.read() {
        for e in w.iter() {
            errors.push(json!({ "message": e.kind.to_string(), "line": e.loc.as_ref().map(|l| l.line + 1), "column": e.loc.as_ref().map(|l| l.column) }));
        }
    }
    json!({ "ok": errors.is_empty(), "errors": errors })
}
