// Order emails from templates a shop owner can edit, checked before they are saved.
//
//   quillo run templates.qwe      then open http://localhost:8080/email

use "templates.qwer"

let order = {
    customer: "Ada <Lovelace>",
    number: 1042,
    items: [{ name: "Notebook", qty: 2, price: 4.5 }, { name: "Fountain pen", qty: 1, price: 1225 }],
    total: 1234.5,
}

let html_email = "<h1>Thanks, {{ customer }}!</h1>
<p>Order #{{ number }}:</p>
<ul>{% for i in items %}<li>{{ i.qty }} × {{ i.name|upper }}: {{ (i.qty * i.price)|money('€') }}</li>{% endfor %}</ul>
<p>Total: <b>{{ total|money('€') }}</b></p>"

let text_email = "Hi {{ customer }}, your order #{{ number }} of {{ items|length }} items comes to {{ total|money }}."

route GET /email = respond(200, template_render(html_email, order)?, { "content-type": "text/html; charset=utf-8" })

route GET /text = { text: template_render_text(text_email, order)? }

// What a shop owner typed, checked before it is kept.
route POST /check = { problem: template_check(request.body) }

route GET /broken = { problem: template_check("Hello {{ name }\n{% for x in %}") }
