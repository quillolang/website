// A "webhook URL" setting that refuses addresses inside the server's network.
//
//   quillo run ssrf_guard.qwe      then open http://localhost:8080/samples

use "ssrf_guard.qwer"

route POST /settings/webhook { form: { url: str } } {
    let v = ssrf_check(url, [443])
    if !v.safe { reply 400 `That URL cannot be used: ${v.reason}.` }
    // Saved; each delivery then goes out with http.post(url, body, {}, { public_only: true }).
    { saved: url }
}

route GET /check ? { url: str } = ssrf_check(url, [])

route GET /samples = {
    metadata: ssrf_check("http://169.254.169.254/latest/meta-data/", []).reason,
    loopback_decimal: ssrf_check("http://2130706433/admin", []).reason,
    mapped_v6: ssrf_check("http://[::ffff:10.0.0.5]/", []).reason,
    localhost: ssrf_safe("http://localhost:8080/"),
    file: ssrf_check("file:///etc/passwd", []).reason,
    other_port: ssrf_check("https://93.184.215.14:22/", []).reason,
    public_ip: ssrf_safe("https://93.184.215.14/hooks"),
    kinds: [ssrf_ip_kind("192.168.1.9")?, ssrf_ip_kind("fd00::1")?, ssrf_ip_kind("1.1.1.1")?],
}
