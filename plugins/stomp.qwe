// Orders through a STOMP broker (ActiveMQ, Artemis, RabbitMQ with its STOMP plugin): sent with a
// receipt, taken by a worker four times a second and acked one by one; an audit trail written in
// transactions; a message refused (nacked) and sent again; and prices on a topic.
//
//   STOMP_URL=stomp://127.0.0.1:61613 STOMP_USER=admin STOMP_PASSWORD=admin quillo run stomp.qwe      then open http://localhost:8080/order?id=A-1
//
// Needs a STOMP broker. Artemis: artemis create shop --user admin --password admin, then
// artemis run; RabbitMQ: rabbitmq-plugins enable rabbitmq_stomp. stomp+ssl:// for TLS.

use "stomp.qwer"

let HEARTBEAT = int(env("STOMP_HEARTBEAT_MS", "10000")) ?? 10000
let opened = stomp_connect("app", env("STOMP_URL", "stomp://127.0.0.1:61613"), {
    login: env("STOMP_USER", "admin"),
    passcode: env("STOMP_PASSWORD", "admin"),
    heart_beat: [HEARTBEAT, HEARTBEAT],
})
let subscribed = [
    stomp_subscribe("app", "/queue/orders", { id: "orders", ack: "client-individual" }),
    stomp_subscribe("app", "/queue/audit", { id: "audit" }),
    stomp_subscribe("app", "/queue/flaky", { id: "flaky", ack: "client-individual" }),
    stomp_subscribe("app", "/topic/prices", { id: "prices" }),
]

let processed = []

// The worker: what has come in on /queue/orders is handled, then acked; a message that is not
// JSON is nacked (the broker sends it again or to its dead-letter queue).
fn work() {
    for m in stomp_receive("app", "orders", 100, 0)? {
        let order = json.parse(m.body)
        if is_err(order) {
            stomp_nack("app", m, "")?
        } else {
            processed = processed + [{ id: order.id, note: m.headers["x-note"] }]
            stomp_ack("app", m, "")?
        }
    }
    null
}

every(250, work)

route GET /order ? { id: str = "A-1" } {
    let r = stomp_send("app", "/queue/orders", json.stringify({ id, total: 42.5 }), {
        content_type: "application/json",
        receipt: true,
        headers: { persistent: "true", "x-note": "gift: wrap it\nthanks" },
    })?
    sleep(600)
    { receipt: r.receipt != null, processed }
}

// Two transactions: the first aborted (its send never happens), the second committed.
route GET /audit {
    stomp_begin("app", "tx-1")?
    stomp_send("app", "/queue/audit", "price changed by mistake", { transaction: "tx-1" })?
    stomp_abort("app", "tx-1")?
    stomp_begin("app", "tx-2")?
    stomp_send("app", "/queue/audit", "price changed: 19.90", { transaction: "tx-2" })?
    stomp_send("app", "/queue/audit", "stock changed: 4", { transaction: "tx-2" })?
    stomp_commit("app", "tx-2")?
    // What has come within 2 seconds: receive gives what is there once the first has come.
    let audit = stomp_receive("app", "audit", 10, 2000)?
    if len(audit) < 2 { audit = audit + stomp_receive("app", "audit", 10, 1000)? }
    { audit: audit | map((m) => m.body) }
}

// A message nacked once: RabbitMQ and ActiveMQ send it again (marked redelivered), and it is
// acked then; Artemis keeps it back (for its dead-letter queue after too many tries).
route GET /retry {
    stomp_send("app", "/queue/flaky", "charge card 4242", { receipt: true })?
    let first = stomp_receive("app", "flaky", 1, 2000)?[0] ?? reply 504 "the message did not come"
    stomp_nack("app", first, "")?
    let again = stomp_receive("app", "flaky", 1, 2000)?
    if len(again) == 0 { return { body: first.body, first_redelivered: first.redelivered, sent_again: false } }
    stomp_ack("app", again[0], "")?
    { body: again[0].body, first_redelivered: first.redelivered, again_redelivered: again[0].redelivered }
}

route GET /prices {
    stomp_send("app", "/topic/prices", "EUR/USD 1.0842", { receipt: true })?
    { prices: stomp_receive("app", "prices", 10, 2000)? | map((m) => m.body), stats: stomp_stats("app")? }
}
