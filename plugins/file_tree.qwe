// A file manager's page for an uploads folder: the tree, its size, and the biggest files.
//
//   quillo run file_tree.qwe      then open http://localhost:8080/files

use "file_tree.qwer"

fn seed() {
    write_file("data/library/reports/2026-q3.csv", "region,total\nNorth,18250\nSouth,16410\n")
    write_file("data/library/reports/2026-q2.csv", "region,total\nNorth,17000\n")
    write_file("data/library/photos/shop.txt", repeat("a picture would be here ", 400))
    write_file("data/library/.cache/x", "hidden")
    write_file("data/library/readme.md", "# Library\n")
}

route GET /files {
    seed()
    {
        tree: file_tree("data/library", 0, false)? | map((e) => { path: e.path, kind: e.kind, size: e.size }),
        size: file_tree_size("data/library")?,
        largest: file_tree_largest("data/library", 1)? | map((e) => e.path),
    }
}

route GET /top = file_tree("data/library", 1, false)? | map((e) => e.name)

route GET / {
    seed()
    <html><body><ul>
        {for e in file_tree("data/library", 0, false)? => <li style={`margin-left: ${e.depth}em`}>{e.name} {e.kind == "file" ? `(${e.size} bytes)` : ""}</li>}
    </ul></body></html>
}
