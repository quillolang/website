// Commands on a server over SSH: the exit status, stdout and stderr apart, input, a timeout, the same
// command on several hosts, a visitor's text quoted, and a host that fails its pin.
//
//   SSH_EXEC_HOST=web1.example.com SSH_EXEC_USER=deploy SSH_EXEC_KEY_FILE=~/.ssh/id_ed25519 \
//     SSH_EXEC_HOST_KEY=SHA256:... quillo run ssh_exec.qwe
//   then open /run, /streams, /stdin, /timeout, /quote?name=..., /many, /pin and /broken
//
// Find the fingerprint on the server: ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub
// SSH_EXEC_PASSWORD works in place of a key.

use "ssh_exec.qwer"

route GET /run {
    let r = ssh_exec_run("", "echo hello", null)?
    { stdout: r.stdout, exit: r.exit, ok: r.ok, again: ssh_exec_run("", "echo second", null)?.stdout }
}

route GET /streams {
    let r = ssh_exec_run("", "echo out; echo err >&2; echo more; exit 3", null)?
    {
        stdout: r.stdout,
        stderr: r.stderr,
        exit: r.exit,
        ok: r.ok,
        must: ssh_exec_output("", "echo fine", null)?,
        failed: ssh_exec_output("", "echo broken >&2; exit 2", null).error,
        missing: ssh_exec_run("", "no-such-command-here", null)?.exit,
        signal: ssh_exec_run("", "kill -KILL $$", null)?.signal,
        big: len(ssh_exec_run("", "head -c 2000000 /dev/zero | tr '\\0' x", null)?.stdout),
        cut: ssh_exec_run("", "head -c 500000 /dev/zero | tr '\\0' x", { max_output: 1000 })?,
    }
}

route GET /stdin = { upper: ssh_exec_output("", "tr a-z A-Z", { stdin: "shout this" })?, count: ssh_exec_output("", "wc -c | tr -d ' '", { stdin: "12345" })?, none: ssh_exec_output("", "cat", null)? }

route GET /timeout {
    let r = ssh_exec_run("", "echo started; sleep 20; echo never", { timeout_ms: 400 })?
    { timed_out: r.timed_out, stdout: r.stdout, exit: r.exit, quick: r.ms < 3000, failed: ssh_exec_output("", "sleep 20", { timeout_ms: 200 }).error, still_works: ssh_exec_run("", "echo after", null)?.stdout }
}

// The text stays one argument, whatever it holds.
route GET /quote ? { name: str } {
    let line = ssh_exec_command(["printf", "%s", name])
    { line: line, printed: ssh_exec_output("", line, null)? }
}

route GET /many {
    let r = ssh_exec_many([env("SSH_EXEC_HOST", ""), env("SSH_EXEC_HOST", ""), "127.0.0.1:1"], "echo up", { connect_timeout_ms: 2000 })?
    { first: r[0].result.stdout, second: r[1].result.ok, down: r[2].error }
}

// A server with another key is refused before anything is sent, and the error says what it offered.
route GET /pin {
    let other = env("SSH_EXEC_OTHER_HOST", "")
    { fingerprint: ssh_exec_fingerprint("")?, other: ssh_exec_fingerprint(other)?, refused: ssh_exec_run(other, "echo no", null).error }
}

route GET /broken = {
    no_host: ssh_exec_run("127.0.0.1:1", "echo", { connect_timeout_ms: 2000 }).error,
    bad_port: ssh_exec_run("host:port", "echo", null).error,
}
