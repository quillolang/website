// Routing with OSRM: a drive with its directions, a table for choosing the nearest shop, the road
// closest to a point, a delivery round and a GPS trace. Points are always [lat, lon]; the plugin
// writes OSRM's lon,lat for you.
//
//   OSRM_API_URL=http://127.0.0.1:5000 quillo run osrm.qwe
//   then open http://localhost:8080/route, /steps, /table, /nearest, /others, /polyline and /refused
//
// Without OSRM_API_URL it uses the public demo server, which is for testing only.

use "osrm.qwer"

let dam = [52.3731, 4.8932]
let centraal = [52.3791, 4.9003]
let museum = [52.36, 4.8852]

route GET /route {
    let r = osrm_route([dam, centraal], { overview: "full" })
    if is_err(r) { reply 502 r.error }
    { distance: first(r.routes).distance_m, line: first(r.routes).geometry, snapped: r.waypoints }
}

route GET /steps {
    let r = osrm_route([dam, centraal, museum], { steps: true, geometries: "polyline6", alternatives: true })?
    let best = first(r.routes)
    {
        routes: len(r.routes),
        legs: len(best.legs),
        directions: first(best.legs).steps | map((s) => s.instruction),
        last: last(last(best.legs).steps).instruction,
        fine_line: first(best.geometry),
        geojson: first(osrm_route([dam, centraal], { geometries: "geojson" })?.routes).geometry,
    }
}

route GET /table {
    let t = osrm_table([dam, centraal, museum], {})?
    {
        durations: t.durations,
        from_one: osrm_table([dam, centraal, museum], { sources: [0], destinations: [1, 2], annotations: "distance" })?,
        no_road: osrm_table([dam, [52.0, 170.0]], {})?.durations,
    }
}

route GET /nearest = osrm_nearest(dam, { number: 2 })?

route GET /others = {
    trip: osrm_trip([dam, centraal, museum], {})?.order,
    trip_distance: first(osrm_trip([dam, centraal, museum], {})?.trips).distance_m > 0,
    matched: osrm_match([dam, [52.375, 4.895], centraal], { timestamps: [1, 60, 120] })?,
}

// Google's own example, and polyline6 to the sixth decimal.
route GET /polyline {
    let line = [[38.5, -120.2], [40.7, -120.95], [43.252, -126.453]]
    {
        encoded: osrm_encode_polyline(line, 5)?,
        decoded: osrm_decode_polyline("_p~iF~ps|U_ulLnnqC_mqNvxq`@", 5)?,
        six: osrm_decode_polyline(osrm_encode_polyline([[52.373122, 4.893211]], 6)?, 6)?,
    }
}

route GET /refused = {
    one_point: osrm_route([dam], {}).error,
    swapped: osrm_route([[152.0, 4.8], dam], {}).error,
    no_route: osrm_route([dam, [52.0, 170.0]], {}).error,
    no_road: osrm_route([dam, [0, 0]], {}).error,
    profile: osrm_route([dam, centraal], { profile: "spaceship" }).error,
    option: osrm_route([dam, centraal], { colour: "red" }).error,
    broken: osrm_decode_polyline("_p~iF~ps|U_", 5).error,
    bad_char: osrm_decode_polyline("abc def", 5).error,
}
