// Upload checks that read what a file is, not what it is called.
//
//   quillo run file_type.qwe      then open http://localhost:8080/check

use "file_type.qwer"

// A real upload form: only pictures and PDFs, and only when the name tells the truth.
route GET /upload = <html><body>
    <form method="post" action="/upload" enctype="multipart/form-data">
        <input type="file" name="doc"/> <button>Send</button>
    </form>
</body></html>

route POST /upload {
    let f = request.files.doc ?? reply 400 "Choose a file"
    let path = save_upload(f, `data/uploads/${uuid()}`)?
    if !file_type_allowed(path, ["image/*", "pdf"])? { delete_file(path); reply 415 "Pictures and PDFs only" }
    if !file_type_matches_name(path, f.filename)? { delete_file(path); reply 415 "The file is not what its name says" }
    { saved: path, type: file_type(path)? }
}

// The sample picture, and a "photo" that is really a PDF.
route GET /check {
    write_file("data/holiday.jpg", "%PDF-1.7\n1 0 obj << >> endobj\n")
    {
        sample: file_type("file_type_sample.png")?,
        sample_is_image: file_type_allowed("file_type_sample.png", ["image"])?,
        fake: file_type("data/holiday.jpg")?,
        fake_is_image: file_type_allowed("data/holiday.jpg", ["image/*"])?,
        fake_name_fits: file_type_matches_name("data/holiday.jpg", "holiday.jpg")?,
    }
}
