// Tickets in Jira Cloud: an issue opened from plain text, a comment, a transition found by name,
// a JQL search past one page, with a visitor's text safely quoted into it.
//
//   JIRA_API_URL=https://your-team.atlassian.net JIRA_EMAIL=you@example.com JIRA_API_TOKEN=... quillo run jira.qwe
//   then open http://localhost:8080/issue, /search, /adf and /failures
//
// The project key here is OPS. Tokens come from id.atlassian.com, under API tokens.

use "jira.qwer"

route GET /issue {
    let made = jira_issue_create({
        project: "OPS",
        issuetype: "Bug",
        summary: "Checkout is slow",
        description: "Since Tuesday.\nSee https://example.com/graph.\n\n- First check\n- Second check",
        labels: ["web"],
    }, {})?
    jira_comment(made.key, "Looking into it.", {})?
    jira_comment(made.key, "Found it:\n\n```sql\nselect 1\n```", {})?
    let ada = jira_find_user("ada", {})?[0]
    jira_assign(made.key, ada.accountId, {})?
    jira_issue_update(made.key, { summary: "Checkout is slow on mobile" }, {})?
    let before = jira_row(jira_issue(made.key, {})?)
    let moved = jira_transition(made.key, "in progress", {})?
    let done = jira_transition(made.key, "Done", { comment: "Fixed in 2.4", fields: { resolution: { name: "Fixed" } } })?
    let after = jira_row(jira_issue(made.key, {})?)
    {
        key: made.key,
        summary: before.summary,
        status: before.status,
        assignee: before.assignee,
        description: before.description,
        moved: moved.name,
        finished: done.to,
        then: after.status,
        comments: map(jira_comments(made.key, {})?, (c) => c.text),
        moves: map(jira_transitions(made.key, {})?, (t) => t.name),
    }
}

route GET /search {
    let name = "O\"Brien"
    let jql = `project = OPS AND reporter = ${jira_quote(name)}`
    let all = jira_search("project = OPS ORDER BY created", { fields: ["summary", "status"] })?
    {
        jql: jql,
        total: len(all),
        first: jira_row(all[0]).summary,
        count: jira_count("project = OPS", {})?,
        capped: len(jira_search("project = OPS", { max_items: 130 })?),
        quoted: len(jira_search(jql, {})?),
    }
}

// No network: what Jira is sent for plain text.
route GET /adf = {
    doc: jira_adf("One\ntwo\n\n1. a\n2. b"),
    back: jira_text(jira_adf("One\ntwo\n\nThree")),
    empty: jira_adf(""),
    link: jira_adf("See https://example.com, please").content[0].content,
}

route GET /failures = {
    required: jira_issue_create({ project: "OPS", issuetype: "Bug", summary: "No type", priority: "bad" }, {}).error,
    two_lines: jira_issue_create({ project: "OPS", summary: "one\ntwo" }, {}).error,
    missing: jira_issue("OPS-99999", {}).error,
    bad_token: jira_issue("OPS-1", { token: "wrong" }).error,
    bad_jql: jira_search("project = ", {}).error,
    stuck: jira_transition("OPS-1", "Shipped", {}).error,
    waited: jira_issue("OPS-1", { fields: ["summary"] })?.key,
}
