// A config file in YAML, and a blog post's front matter.
//
//   quillo run yaml.qwe      then open http://localhost:8080/config

use "yaml.qwer"

let config_text = `server:
  port: 8080
  hosts: [quillolang.org, www.quillolang.org]
features:
  blog: true
  search: false
`

route GET /config = yaml_parse(config_text)?
route GET /post = front_matter(`---
title: Hello
tags: [news, release]
---
The post's text.`)?
route GET /back = yaml_stringify({ name: "Quillo", plugins: ["yaml", "csv"] })?
