// An order store on MongoDB: documents written with their ObjectIds, queries with sort and paging,
// updates, an aggregation for a report, a unique index, and a duplicate turned into a clear error.
//
//   MONGODB_URI=mongodb://localhost:27017 MONGODB_DATABASE=shop quillo run mongodb.qwe
//   then open /setup, /insert, /find, /types, /update, /report, /delete, /indexes and /broken

use "mongodb.qwer"

route GET /setup = {
    index: mongodb_create_index("customers", { email: 1 }, { unique: true })?,
    ttl: mongodb_create_index("sessions", { created: 1 }, { ttl_seconds: 3600, name: "expire" })?,
    pong: mongodb_command({ ping: 1 })?.ok,
    collections: mongodb_collections("")? | sort,
}

route GET /insert {
    let a = mongodb_insert("customers", { email: "ada@example.com", name: "Ada" })?
    let many = mongodb_insert_many("orders", [
        { sku: "mug", qty: 2, total: 19.5, shop: "north", tags: ["gift"] },
        { sku: "cup", qty: 1, total: 5.0, shop: "north", tags: [] },
        { sku: "mug", qty: 1, total: 9.75, shop: "south", tags: ["gift", "sale"] },
        { sku: "pot", qty: 3, total: 60.0, shop: "south", tags: [] },
        { sku: "lid", qty: 7, total: 14.0, shop: "south", tags: ["sale"] },
    ], true)?
    {
        id_is_oid: len(a["$oid"]) == 24,
        many: many,
        duplicate: mongodb_insert("customers", { email: "ada@example.com" }).error,
        some: mongodb_insert_many("customers", [{ email: "b@example.com" }, { email: "ada@example.com" }, { email: "c@example.com" }], false)?,
        stopped: mongodb_insert_many("customers", [{ email: "d@example.com" }, { email: "ada@example.com" }, { email: "e@example.com" }], true).error,
        after: mongodb_count("customers", null)?,
    }
}

// All five come back though the server sends them in batches of two.
route GET /find = {
    all: mongodb_find("orders", null, { sort: { total: -1 } })? | map((o) => o.sku),
    filtered: mongodb_find("orders", { qty: { "$gte": 2 }, shop: "south" }, { sort: { qty: 1 } })? | map((o) => o.sku),
    among: mongodb_find("orders", { sku: { "$in": ["cup", "lid"] } }, { sort: { sku: 1 } })? | map((o) => o.qty),
    tagged: mongodb_count("orders", { tags: "sale" })?,
    page: mongodb_find("orders", null, { sort: { total: 1 }, skip: 1, limit: 2, projection: { sku: 1, _id: 0 } })?,
    one: mongodb_find_one("orders", { sku: "pot" })?.total,
    none: mongodb_find_one("orders", { sku: "nothing" })?,
    shops: mongodb_distinct("orders", "shop", null)? | sort,
}

// An ObjectId and a date go in as Extended JSON, come out the same, and work in a filter.
route GET /types {
    let id = mongodb_object_id()
    mongodb_insert("events", { _id: id, at: { "$date": "2026-11-01T10:00:00Z" }, big: 9007199254740993, ratio: 0.25, nothing: null, nested: { deep: [1, { two: 2 }] } })?
    let e = mongodb_find_one("events", { _id: id })?
    { same_id: e._id == id, at: e.at, big: e.big, ratio: e.ratio, nothing: e.nothing, nested: e.nested, by_date: mongodb_count("events", { at: { "$gte": { "$date": "2026-01-01T00:00:00Z" } } })? }
}

route GET /update = {
    one: mongodb_update("orders", { sku: "mug" }, { "$inc": { qty: 1 } }, null)?,
    many: mongodb_update("orders", { shop: "south" }, { "$set": { region: "s" } }, { many: true })?,
    none: mongodb_update("orders", { sku: "nothing" }, { "$set": { a: 1 } }, null)?,
    upserted: len(mongodb_update("orders", { sku: "new" }, { "$set": { qty: 1, total: 1.0, shop: "east" } }, { upsert: true })?.upserted_id["$oid"]),
    replaced: mongodb_replace("customers", { email: "b@example.com" }, { email: "b@example.com", name: "Bea" }, false)?.modified,
    name: mongodb_find_one("customers", { email: "b@example.com" })?.name,
    not_operators: mongodb_update("orders", {}, { qty: 1 }, null).error,
}

route GET /report = mongodb_aggregate("orders", [
    { "$match": { shop: { "$in": ["north", "south"] } } },
    { "$group": { _id: "$shop", revenue: { "$sum": "$total" }, orders: { "$sum": 1 }, biggest: { "$max": "$qty" } } },
    { "$sort": { revenue: -1 } },
], 0)?

route GET /delete {
    let first = mongodb_delete("orders", { sku: "new" }, false)?
    { first: first, again: mongodb_delete("orders", { sku: "new" }, false)?, many: mongodb_delete("orders", { shop: "south" }, true)?, left: mongodb_count("orders", null)?, everything: mongodb_delete("orders", null, true).error }
}

route GET /indexes {
    let before = mongodb_indexes("customers")?
    mongodb_drop_index("customers", "email_1")?
    { before: before, after: mongodb_indexes("customers")? | map((i) => i.name), again: mongodb_drop_index("customers", "email_1").error }
}

route GET /broken = {
    bad_operator: mongodb_find("orders", { qty: { "$wobble": 1 } }, null).error,
    bad_stage: mongodb_aggregate("orders", [{ "$wobble": {} }], 0).error,
    not_map: mongodb_find_one("orders", "text").error,
}
