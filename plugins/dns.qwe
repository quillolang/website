// A domain checker for a hosting panel: what a customer's zone file says, the records it
// publishes, and lookups against live DNS.
//
//   quillo run dns.qwe      then open http://localhost:8080/zone and http://localhost:8080/offline
//   http://localhost:8080/lookup/example.com/MX goes to the network.

use "dns.qwer"

route GET /zone = dns_zone_parse(read_file("dns_sample.zone")?, "")? | map((r) => { name: r.name, type: r.type, value: r.value })

route GET /offline = {
    localhost: dns_resolve("localhost")?,
    mx: dns_parse_record("MX", "10 mx1.mailer.example.", "")?,
    srv: dns_parse_record("SRV", "10 60 5060 sip", "shop.example.com.")?,
    caa: dns_parse_record("CAA", "0 issue \"letsencrypt.org\"", "")?,
    txt: dns_parse_record("TXT", "\"v=spf1 include:_spf.mailer.example\" \" -all\"", "")?,
    bad: dns_parse_record("MX", "ten mail", "").error,
}

route GET /lookup/:name/:type = dns_lookup(name, type, "cloudflare", 3000)?

// Does the customer's domain point at us, and can it receive mail?
route GET /check/:domain = {
    points_here: dns_lookup(domain, "A", "", 3000)? | any((r) => r.address == "203.0.113.10"),
    mail: dns_lookup(domain, "MX", "", 3000)? | map((r) => r.exchange),
    spf: dns_lookup(domain, "TXT", "", 3000)? | map((r) => r.text) | filter((t) => starts_with(t, "v=spf1")),
}
