// "Sign in with GitHub" with PKCE and a state value, as OAuth 2.1 asks.
//
//   GITHUB_CLIENT_ID=... GITHUB_CLIENT_SECRET=... quillo run oauth_pkce.qwe      then open http://localhost:8080/login/github
//
// GitHub's access token is the visitor's secret, so it stays on the server: in a table of the
// program's own, keyed by the user, with only the user's id in the session. A Quillo session is
// signed, not encrypted, and anyone holding the cookie can read it. A program that never calls
// GitHub after the sign-in keeps no token at all. GITHUB_URL and GITHUB_API_URL point at a test's
// GitHub on this machine.

use "oauth_pkce.qwer"

let CLIENT_ID = env("GITHUB_CLIENT_ID") ?? "Iv1.quillo-example"
let CLIENT_SECRET = env("GITHUB_CLIENT_SECRET") ?? ""
let CALLBACK = "http://localhost:8080/auth/github"
let GITHUB = env("GITHUB_URL") ?? "https://github.com"
let GITHUB_API = env("GITHUB_API_URL") ?? "https://api.github.com"
let PUBLIC = GITHUB == "https://github.com"

// The database here is SQLite in memory: db.open a file or a server to keep the tokens.
db.exec("create table if not exists github_tokens (user_id integer primary key, login text not null, token text not null, scope text, saved_at integer not null)")

// Step 1: keep the verifier and state, send the visitor to GitHub.
route GET /login/github {
    let pkce = pkce_pair()
    let state = oauth_state()
    set_session({ verifier: pkce.verifier, state }, { max_age: "10m" })
    let link = oauth_authorize_url("github", CLIENT_ID, CALLBACK, [], state, pkce.challenge)?
    respond(200, { go_to: link }, {})
}

// Step 2: GitHub sends the visitor back with a code; the state must be ours. The token goes to the
// table, and the session gets the user's id alone.
route writes GET /auth/github ? { code: str, state: str } {
    let s = session()
    if s.state == null || !crypto.equal(s.state, state) { reply 400 "This sign-in was not started here." }
    let r = oauth_token_request("github", CLIENT_ID, CLIENT_SECRET, code, CALLBACK, s.verifier)?
    let answer = http.post(replace(r.url, "https://github.com", GITHUB), r.body, r.headers, { public_only: PUBLIC })?
    let token = (answer.json ?? {}).access_token ?? reply 401 "GitHub did not sign you in."
    let me = http.get(`${GITHUB_API}/user`, { authorization: `Bearer ${token}`, accept: "application/vnd.github+json" }, { public_only: PUBLIC })?
    if me.status != 200 { reply 401 "GitHub did not say who you are." }
    db.exec("insert into github_tokens (user_id, login, token, scope, saved_at) values (?, ?, ?, ?, ?) on conflict (user_id) do update set login = excluded.login, token = excluded.token, scope = excluded.scope, saved_at = excluded.saved_at", me.json.id, me.json.login, token, answer.json.scope, now())?
    set_session({ user: me.json.id })
    redirect("/")
}

// GitHub called later for the visitor: the token is read from the table, by the session's user.
route GET /repos {
    let id = session().user ?? reply 401 "Sign in first."
    let row = db.one("select token from github_tokens where user_id = ?", id)? ?? reply 401 "Sign in again."
    let r = http.get(`${GITHUB_API}/user/repos`, { authorization: `Bearer ${row.token}`, accept: "application/vnd.github+json" }, { public_only: PUBLIC })?
    map(r.json, (x) => x.full_name)
}

route GET /me = { user: session().user, holds: keys(session()) }

// Signing out drops the token too.
route POST /logout {
    let id = session().user
    if id != null { db.exec("delete from github_tokens where user_id = ?", id)? }
    end_session()
    redirect("/")
}

// What the challenge is: RFC 7636's own example.
route GET /rfc = { challenge: pkce_challenge("dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk")?, google: oauth_authorize_url("google", "1234.apps.googleusercontent.com", CALLBACK, ["openid", "email"], "xyz", "abc")? }

// The whole trip as a browser makes it, against GITHUB_URL: what the session holds afterwards, and
// where the token is.
fn first_cookie(answer) = split(answer.headers["set-cookie"] ?? "", ";")[0]

route writes GET /flow {
    let here = `http://${request.headers.host}`
    let go = { redirects: 0, public_only: false }
    let start = http.get(`${here}/login/github`, {}, go)?
    let asked = first_cookie(start)
    let consent = http.get(replace(start.json.go_to, "https://github.com", GITHUB), {}, go)?
    let back = http.get(replace(consent.headers.location, CALLBACK, `${here}/auth/github`), { cookie: asked }, go)?
    let cookie = first_cookie(back)
    let me = http.get(`${here}/me`, { cookie }, go)?.json
    let kept = db.one("select login, token from github_tokens where user_id = ?", me.user)?
    let repos = http.get(`${here}/repos`, { cookie }, go)?.json
    http.post(`${here}/logout`, null, { cookie }, go)?
    {
        user: me.user,
        session_holds: me.holds,
        token_in_table: kept != null && starts_with(kept.token, "gho_"),
        repos,
        after_logout: db.one("select count(*) as n from github_tokens where user_id = ?", me.user)?.n,
    }
}
