// "Sign in with GitHub" with PKCE and a state value, as OAuth 2.1 asks.
//
//   quillo run oauth_pkce.qwe      then open http://localhost:8080/login/github

use "oauth_pkce.qwer"

let CLIENT_ID = env("GITHUB_CLIENT_ID") ?? "Iv1.quillo-example"
let CLIENT_SECRET = env("GITHUB_CLIENT_SECRET") ?? ""
let CALLBACK = "http://localhost:8080/auth/github"

// Step 1: keep the verifier and state, send the visitor to GitHub.
route GET /login/github {
    let pkce = pkce_pair()
    let state = oauth_state()
    set_session({ verifier: pkce.verifier, state }, { max_age: "10m" })
    let link = oauth_authorize_url("github", CLIENT_ID, CALLBACK, [], state, pkce.challenge)?
    respond(200, { go_to: link }, {})
}

// Step 2: GitHub sends the visitor back with a code; the state must be ours.
route GET /auth/github ? { code: str, state: str } {
    let s = session()
    if s.state == null || !crypto.equal(s.state, state) { reply 400 "This sign-in was not started here." }
    let r = oauth_token_request("github", CLIENT_ID, CLIENT_SECRET, code, CALLBACK, s.verifier)?
    let answer = http.post(r.url, r.body, r.headers, { public_only: true })?
    set_session({ github_token: json.parse(answer.body)?.access_token })
    redirect("/")
}

// What the challenge is: RFC 7636's own example.
route GET /rfc = { challenge: pkce_challenge("dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk")?, google: oauth_authorize_url("google", "1234.apps.googleusercontent.com", CALLBACK, ["openid", "email"], "xyz", "abc")? }
