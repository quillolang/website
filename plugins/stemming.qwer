//! Words cut to their stems in 18 languages ("running", "runs" and "run" are all "run"), so a search or a tag cloud counts them as one.
//! version: 1.0.0
//!
//! [dependencies]
//! rust-stemmers = "1.2"

use rust_stemmers::{Algorithm, Stemmer};

fn algorithm(language: &str) -> Result<Algorithm, String> {
    Ok(match language.trim().to_lowercase().as_str() {
        "ar" | "arabic" => Algorithm::Arabic,
        "da" | "danish" => Algorithm::Danish,
        "nl" | "dutch" => Algorithm::Dutch,
        "en" | "english" | "" => Algorithm::English,
        "fi" | "finnish" => Algorithm::Finnish,
        "fr" | "french" => Algorithm::French,
        "de" | "german" => Algorithm::German,
        "el" | "greek" => Algorithm::Greek,
        "hu" | "hungarian" => Algorithm::Hungarian,
        "it" | "italian" => Algorithm::Italian,
        "no" | "nb" | "norwegian" => Algorithm::Norwegian,
        "pt" | "portuguese" => Algorithm::Portuguese,
        "ro" | "romanian" => Algorithm::Romanian,
        "ru" | "russian" => Algorithm::Russian,
        "es" | "spanish" => Algorithm::Spanish,
        "sv" | "swedish" => Algorithm::Swedish,
        "ta" | "tamil" => Algorithm::Tamil,
        "tr" | "turkish" => Algorithm::Turkish,
        other => return Err(format!("no stemmer for {:?}; see stem_languages()", other)),
    })
}

/// The stem of one word, in lower case, in `language` (a two-letter code such as "en", "fr", "de", or a name such as "spanish").
pub fn stem(word: &str, language: &str) -> Result<String, String> {
    Ok(Stemmer::create(algorithm(language)?).stem(&word.to_lowercase()).into_owned())
}

/// The stems of the words in `text`, in order: the text split at anything that is not a letter or digit, in lower case. Up to 1 MB of text.
pub fn stem_text(text: &str, language: &str) -> Result<Vec<String>, String> {
    if text.len() > 1_000_000 {
        return Err("text up to 1 MB".into());
    }
    let s = Stemmer::create(algorithm(language)?);
    Ok(text.split(|c: char| !c.is_alphanumeric()).filter(|w| !w.is_empty()).map(|w| s.stem(&w.to_lowercase()).into_owned()).collect())
}

/// Whether two words have the same stem: "connected" and "connection" do.
pub fn stem_same(a: &str, b: &str, language: &str) -> Result<bool, String> {
    let s = Stemmer::create(algorithm(language)?);
    Ok(s.stem(&a.to_lowercase()) == s.stem(&b.to_lowercase()))
}

/// The languages there are, as two-letter codes.
pub fn stem_languages() -> Vec<String> {
    "ar da nl en fi fr de el hu it no pt ro ru es sv ta tr".split(' ').map(String::from).collect()
}
