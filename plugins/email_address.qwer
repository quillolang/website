//! Email addresses checked against RFC 5322 and split into their parts, display names included.
//!
//! [dependencies]
//! email_address = "0.2"

use email_address::EmailAddress;
use serde_json::{json, Value};
use std::str::FromStr;

/// Whether `address` is a well-formed email address. (Whether it receives mail, only sending one tells.)
pub fn email_valid(address: &str) -> bool {
    EmailAddress::is_valid(address.trim())
}

/// `{ local, domain, display, address }` of an address, `Ada <ada@example.com>` too; the domain in lower case.
pub fn email_parts(address: &str) -> Result<Value, String> {
    let e = EmailAddress::from_str(address.trim()).map_err(|e| e.to_string())?;
    let domain = e.domain().to_lowercase();
    Ok(json!({ "local": e.local_part(), "domain": domain, "display": e.display_part(), "address": format!("{}@{}", e.local_part(), domain) }))
}
