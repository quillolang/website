//! URLs taken apart and put together by the WHATWG rules browsers use: parts and query as a map, relative links resolved, a normal form for comparing and caching, tracking parameters (utm_*, fbclid, gclid...) stripped, and query values set.
//! version: 1.0.0
//!
//! [dependencies]
//! url = "2"

use serde_json::{json, Map, Value};
use std::collections::BTreeMap;

const TRACKING: [&str; 24] = [
    "fbclid", "gclid", "gclsrc", "dclid", "gbraid", "wbraid", "msclkid", "mc_cid", "mc_eid", "_ga", "_gl", "igshid", "yclid", "twclid",
    "ttclid", "li_fat_id", "mkt_tok", "oly_anon_id", "oly_enc_id", "_hsenc", "_hsmi", "vero_id", "rb_clickid", "s_cid",
];

fn parse(u: &str) -> Result<url::Url, String> {
    if u.len() > 32 * 1024 {
        return Err("a URL is at most 32 KB here".into());
    }
    url::Url::parse(u.trim()).map_err(|e| format!("`{}` is not a URL: {}", u, e))
}

/// A URL's parts: `{ scheme, username, host, port, path, query, fragment, origin, href }`, `query` a map of its parameters (the last value of a repeated one), `port` null when it is the scheme's default.
pub fn url_parse(url: &str) -> Result<Value, String> {
    let u = parse(url)?;
    let q: Map<String, Value> = u.query_pairs().map(|(k, v)| (k.into_owned(), json!(v))).collect();
    Ok(json!({
        "scheme": u.scheme(), "username": u.username(), "host": u.host_str(), "port": u.port(), "path": u.path(),
        "query": q, "fragment": u.fragment(), "origin": u.origin().ascii_serialization(), "href": u.as_str(),
    }))
}

/// A link resolved against the page it is on: `url_join("https://a.com/blog/post", "../img/x.png")` is `https://a.com/img/x.png`. An absolute `relative` comes back as it is.
pub fn url_join(base: &str, relative: &str) -> Result<String, String> {
    parse(base)?.join(relative.trim()).map(|u| u.to_string()).map_err(|e| format!("cannot join `{}`: {}", relative, e))
}

fn is_tracking(k: &str) -> bool {
    let k = k.to_ascii_lowercase();
    k.starts_with("utm_") || TRACKING.contains(&k.as_str())
}

/// The URL without tracking parameters: every `utm_*`, and fbclid, gclid, msclkid, mc_eid, _ga, igshid and others ad networks add. The rest is left in its order.
pub fn url_strip_tracking(url: &str) -> Result<String, String> {
    let mut u = parse(url)?;
    let kept: Vec<(String, String)> = u.query_pairs().filter(|(k, _)| !is_tracking(k)).map(|(k, v)| (k.into_owned(), v.into_owned())).collect();
    if kept.is_empty() {
        u.set_query(None);
    } else {
        u.query_pairs_mut().clear().extend_pairs(kept);
    }
    Ok(u.to_string())
}

/// One form for URLs that mean the same page, for comparing, deduplicating and cache keys: scheme and host in lower case (as parsing does),
/// default port dropped, `.` and `..` resolved, tracking parameters dropped, the rest sorted by name, the fragment dropped, and a lone `/` path kept.
pub fn url_normalize(url: &str) -> Result<String, String> {
    let mut u = parse(url)?;
    u.set_fragment(None);
    let mut kept: Vec<(String, String)> = u.query_pairs().filter(|(k, _)| !is_tracking(k)).map(|(k, v)| (k.into_owned(), v.into_owned())).collect();
    kept.sort();
    if kept.is_empty() {
        u.set_query(None);
    } else {
        u.query_pairs_mut().clear().extend_pairs(kept);
    }
    if let Some(h) = u.host_str().map(|h| h.trim_end_matches('.').to_string()) {
        let _ = u.set_host(Some(&h));
    }
    Ok(u.to_string())
}

/// The URL with query parameters set from `params` (`{ page: 2, sort: "new" }`): existing ones replaced in place, new ones added, a null value removing one.
pub fn url_with_query(url: &str, params: std::collections::HashMap<String, serde_json::Value>) -> Result<String, String> {
    let mut u = parse(url)?;
    let set: BTreeMap<String, Option<String>> = params
        .into_iter()
        .map(|(k, v)| (k, match v {
            Value::Null => None,
            Value::String(s) => Some(s),
            other => Some(other.to_string()),
        }))
        .collect();
    let mut out: Vec<(String, String)> = Vec::new();
    let mut done = std::collections::HashSet::new();
    for (k, v) in u.query_pairs().map(|(k, v)| (k.into_owned(), v.into_owned())).collect::<Vec<_>>() {
        match set.get(&k) {
            Some(Some(nv)) if done.insert(k.clone()) => out.push((k, nv.clone())),
            Some(_) => {}
            None => out.push((k, v)),
        }
    }
    for (k, v) in &set {
        if let Some(v) = v {
            if !done.contains(k) {
                out.push((k.clone(), v.clone()));
            }
        }
    }
    if out.is_empty() {
        u.set_query(None);
    } else {
        u.query_pairs_mut().clear().extend_pairs(out);
    }
    Ok(u.to_string())
}
