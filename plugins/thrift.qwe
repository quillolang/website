// A Thrift service reached from a program with no generated code: arguments in a value form, a
// framed call in the binary and compact protocols, a declared exception and an unknown method,
// and values encoded by hand to see what is on the wire.
//
//   THRIFT_HOST=calc.internal:9090 quillo run thrift.qwe      then open http://localhost:8080/add

use "thrift.qwer"

let HOST = env("THRIFT_HOST", "127.0.0.1:9090")
let FAST = { timeout_ms: 1500 }

fn add(a, b) { [{ id: 1, type: "i32", value: a }, { id: 2, type: "i32", value: b }] }

route GET /add = {
    binary: thrift_call(HOST, "add", add(2, 40), FAST)?.value,
    compact: thrift_call(HOST, "add", add(-2, -40), { ...FAST, protocol: "compact" })?.value,
    kind: thrift_call(HOST, "add", add(1, 1), FAST)?.type,
}

route GET /ping = { void: thrift_call(HOST, "ping", [], FAST)?, sent: thrift_call(HOST, "note", [{ id: 1, type: "string", value: "fire and forget" }], { ...FAST, oneway: true })? }

let USER = [
    { id: 1, type: "i64", value: 9007199254740993 },
    { id: 2, type: "string", value: "Ada — first" },
    { id: 3, type: "bool", value: true },
    { id: 4, type: "bool", value: false },
    { id: 5, type: "double", value: 1.5 },
    { id: 6, type: "list", elem: "string", value: ["a", "b"] },
    { id: 7, type: "map", key: "string", val: "i32", value: [["x", 1], ["y", -1]] },
    { id: 8, type: "set", elem: "i16", value: [300, -300] },
    { id: 20, type: "struct", value: [{ id: 1, type: "byte", value: -7 }, { id: 2, type: "binary", value: "ff00" }] },
    { id: 21, type: "list", elem: { type: "list", elem: "i32" }, value: [[1, 2], []] },
    { id: 22, type: "list", elem: "bool", value: [true, false, true] },
    { id: 23, type: "list", elem: "i32", value: range(20) },
    { id: 24, type: "uuid", value: "00112233-4455-6677-8899-aabbccddeeff" },
]

// The server sends what it got straight back, re-encoded by its own code.
route GET /echo {
    let b = thrift_call(HOST, "echo", [{ id: 1, type: "struct", value: USER }], FAST)?
    let c = thrift_call(HOST, "echo", [{ id: 1, type: "struct", value: USER }], { ...FAST, protocol: "compact" })?
    { same: thrift_encode(b.value, "binary")? == thrift_encode(USER, "binary")?, same_compact: thrift_encode(c.value, "compact")? == thrift_encode(USER, "compact")?, named: thrift_fields(b.value, { "1": "id", "2": "name", "3": "active", "6": "tags", "20": "extra" })? }
}

route GET /errors = {
    declared: thrift_call(HOST, "divide", add(1, 0), FAST)?,
    declared_compact: thrift_call(HOST, "divide", add(1, 0), { ...FAST, protocol: "compact" })?.exception.id,
    unknown: thrift_call(HOST, "nope", [], FAST).error,
    unknown_compact: thrift_call(HOST, "nope", [], { ...FAST, protocol: "compact" }).error,
    server_bug: thrift_call(HOST, "crash", [], FAST).error,
    wrong_seq: thrift_call(HOST, "wrongseq", [], FAST).error,
    silent: thrift_call(HOST, "hang", [], { timeout_ms: 200 }).error,
    offline: thrift_call("127.0.0.1:1", "ping", [], { timeout_ms: 200 }).error,
}

route GET /wire = {
    binary: thrift_encode([{ id: 1, type: "string", value: "hi" }, { id: 2, type: "i32", value: 7 }], "binary")?,
    compact: thrift_encode([{ id: 1, type: "string", value: "hi" }, { id: 2, type: "i32", value: 7 }], "compact")?,
    far_field: thrift_encode([{ id: 100, type: "i16", value: 1 }], "compact")?,
    flags: thrift_encode([{ id: 1, type: "bool", value: true }, { id: 2, type: "bool", value: false }], "compact")?,
    unset: thrift_encode([{ id: 1, type: "i32", value: null }, { id: 2, type: "i32", value: 1 }], "binary")?,
    double_be: thrift_encode([{ id: 1, type: "double", value: 1.0 }], "binary")?,
    double_le: thrift_encode([{ id: 1, type: "double", value: 1.0 }], "compact")?,
    message: thrift_message({ name: "ping", type: "call", seq: 1 }, "binary")?,
    message_compact: thrift_message({ name: "ping", type: "call", seq: 1 }, "compact")?,
    read: thrift_read_message("80010001 00000004 70696e67 00000001 00")?,
    old_form: thrift_read_message("00000004 70696e67 01 00000005 00")?,
    decoded: thrift_decode("18026869 150e 00", "compact")?,
}

route GET /damaged = {
    cut: thrift_decode("0b000100000005", "binary").error,
    lying_list: thrift_decode("0f0001080fffffff", "binary").error,
    huge_string: thrift_decode("0b0001ffffffff", "binary").error,
    bad_type: thrift_decode("630001", "binary").error,
    too_big: thrift_encode([{ id: 1, type: "byte", value: 300 }], "binary").error,
    no_elem: thrift_encode([{ id: 1, type: "list", value: [] }], "binary").error,
    bad_kind: thrift_encode([{ id: 1, type: "float", value: 1 }], "binary").error,
    bad_protocol: thrift_encode([], "json").error,
    bad_version: thrift_read_message("80020001").error,
}
