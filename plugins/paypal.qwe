// A PayPal checkout from the shop's side: an order made for a request id, the buyer approving it,
// the capture, part of it refunded, and webhooks believed only once PayPal has checked them.
//
//   PAYPAL_CLIENT_ID=... PAYPAL_CLIENT_SECRET=... PAYPAL_WEBHOOK_ID=... quillo run paypal.qwe
//   then open http://localhost:8080/checkout, /amounts, /missing and /webhook-check
//
// Without PAYPAL_API_URL it uses the sandbox, api-m.sandbox.paypal.com; set it to
// https://api-m.paypal.com to go live. A real buyer approves on PayPal's page: /checkout goes to
// the approve link itself, which only the test stand-in takes as an approval. Point PayPal's
// webhook at POST /paypal/webhook.

use "paypal.qwer"

// One order, one id: a retry after a crash finds the first order and never makes a second.
fn checkout(id) {
    paypal_order_create({ amount: "59.90", currency: "EUR", reference_id: id, description: "Printer ribbon" }, { request_id: "order-" + id })
}

route GET /checkout {
    let id = str(random_int(100000, 999999))
    let order = checkout(id)?
    let again = checkout(id)?
    let early = paypal_order_capture(order.id, {}).error
    // Here the buyer would be sent to this link, and come back to your return_url.
    http.get(paypal_approve_link(order)?, {}, { public_only: false })?
    let done = paypal_order_capture(order.id, { request_id: "capture-" + id })?
    let twice = paypal_order_capture(order.id, { request_id: "capture-" + id })?
    let capture = paypal_capture_ids(done)[0]
    let part = paypal_refund(capture, paypal_amount("9.90", "EUR")?, "Part of your order was out of stock", { request_id: "refund-" + id })?
    {
        created: order.status,
        same_order: again.id == order.id,
        too_early: early,
        captured: done.status,
        same_capture: paypal_capture_ids(twice)[0] == capture,
        refund: part.status,
        refund_read: paypal_refund_get(part.id, {})?.amount,
        capture_state: paypal_capture_get(capture, {})?.status,
        too_much: paypal_refund(capture, paypal_amount("500", "EUR")?, "", {}).error,
    }
}

route GET /amounts = {
    euros: paypal_amount("19.9", "eur")?,
    yen: paypal_amount("1500", "JPY")?,
    too_fine: paypal_amount("10.5", "JPY").error,
}

route GET /missing = {
    order: paypal_order_get("NOSUCHORDER", {}).error,
    invalid: paypal_order_create({ intent: "CAPTURE", purchase_units: [] }, {}).error,
    wrong_key: paypal_token({ client_id: "wrong", client_secret: "wrong" }).error,
}

// What PayPal posts: answered 200 only when PayPal agrees it sent it.
route POST /paypal/webhook {
    let event = paypal_webhook_verify("", request.headers, request.body, {})
    if is_err(event) { reply 401 event.error }
    { type: event.event_type, id: event.id }
}

// PayPal's simulate call sends an event to the route above; a stand-in signs it and says how the
// delivery went. A body changed in between is refused.
route GET /webhook-check {
    let hook = "http://" + request.headers.host + "/paypal/webhook"
    let sim = paypal_request("POST", "/v1/notifications/simulate-event", { webhook_id: env("PAYPAL_WEBHOOK_ID", ""), url: hook, event_type: "PAYMENT.CAPTURE.COMPLETED" }, {})?
    let forged = { "paypal-auth-algo": "SHA256withRSA", "paypal-cert-url": "https://api.paypal.com/cert", "paypal-transmission-id": "1", "paypal-transmission-sig": "AAAA", "paypal-transmission-time": "2026-11-01T10:00:00Z" }
    {
        delivered: sim.delivery,
        forged: paypal_webhook_verify("", forged, "{\"id\":\"WH-1\"}", {}).error,
        no_header: paypal_webhook_verify("", {}, "{}", {}).error,
    }
}
