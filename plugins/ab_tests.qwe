// A checkout button test: visitors split into variants that stay theirs, the visitors needed
// before looking, and the results read four ways.
//
//   quillo run ab_tests.qwe      then open http://localhost:8080/variant?user=u-1042 and /results

use "ab_tests.qwer"

let VARIANTS = [{ name: "green", weight: 1 }, { name: "orange", weight: 1 }]

// Half the traffic is in the test; the other half sees today's button.
route GET /variant ? { user: str } = { user, variant: ab_assign("checkout-button", user, VARIANTS, 50.0)? ?? "control" }

route GET /split {
    let picks = for i in range(20000) => ab_assign("checkout-button", `u-${i}`, VARIANTS, 50.0)? ?? "out"
    { green: len(picks | filter((p) => p == "green")), orange: len(picks | filter((p) => p == "orange")), out: len(picks | filter((p) => p == "out")) }
}

route GET /plan = {
    per_variant: ab_sample_size(3.5, 10.0, 0.05, 0.8)?,
    for_a_bigger_change: ab_sample_size(3.5, 25.0, 0.05, 0.8)?,
}

let GREEN = { visitors: 24180, conversions: 846 }
let ORANGE = { visitors: 24320, conversions: 968 }

route GET /results = {
    conversion: ab_significance(GREEN, ORANGE, 0.05)?,
    chance: ab_bayes(GREEN, ORANGE)?,
    revenue: ab_means({ n: 846, mean: 41.20, sd: 18.5 }, { n: 968, mean: 39.90, sd: 19.1 }, 0.05)?,
    split_ok: ab_srm([24180, 24320], [1, 1])?,
    split_broken: ab_srm([24180, 22900], [1, 1])?,
}
