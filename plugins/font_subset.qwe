// A café's menu page with its own font, cut to the characters the menu uses: a .ttf for the PDF, a .woff for the site,
// and a data URL that puts the font in the page itself.
//
//   quillo run font_subset.qwe      then open http://localhost:8080/cut and http://localhost:8080/menu

use "font_subset.qwer"

let MENU = "Café Quillo — Menu: Crème brûlée 6.50, Éclair 3.20"

route GET /cut = {
    ttf: font_subset("font_subset_sample.ttf", MENU, "data/menu-font.ttf")?,
    woff: font_subset("font_subset_sample.ttf", MENU, "data/menu-font.woff")?,
    digits: font_subset("font_subset_sample.ttf", "0123456789", "data/digits.ttf")?.glyphs,
    coverage: font_subset_coverage("font_subset_sample.ttf", MENU)?,
}

route GET /menu {
    let url = font_subset_data_url("font_subset_sample.ttf", MENU)?
    respond(200, `<style>@font-face { font-family: Menu; src: url(${url}) format("woff") } h1 { font-family: Menu }</style><h1>${MENU}</h1>`, { "content-type": "text/html; charset=utf-8" })
}

route GET /font = file("data/menu-font.woff")
