// Column names from a spreadsheet as API keys, labels and constants.
//
//   quillo run case.qwe      then open http://localhost:8080/columns

use "case.qwer"

let columns = ["First Name", "lastName", "date-of-birth", "HTTPStatus code"]

route GET /columns = columns | map((c) => {
    column: c,
    key: case_snake(c),
    json: case_camel(c, false),
    type: case_camel(c, true),
    css: case_kebab(c),
    env: case_constant(c),
    label: case_title(c),
    sentence: case_sentence(c),
})

route GET /case ? { text: str } = { snake: case_snake(text), camel: case_camel(text, false), kebab: case_kebab(text), title: case_title(text), sentence: case_sentence(text) }
