//! Verify sign-in tokens from an identity provider (Auth0, Okta, Entra ID, Cognito, Keycloak) against its JWKS keys, picking the key by `kid`.
//! version: 1.0.0
//!
//! [dependencies]
//! jsonwebtoken = "9"

use jsonwebtoken::jwk::{AlgorithmParameters, JwkSet};
use jsonwebtoken::{decode, decode_header, encode, Algorithm, DecodingKey, EncodingKey, Header, Validation};
use serde_json::{json, Value};

fn now() -> i64 {
    std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_secs() as i64)
}

fn keys(jwks: &str) -> Result<JwkSet, String> {
    if jwks.len() > 1_000_000 {
        return Err("a JWKS document is at most 1 MB".into());
    }
    serde_json::from_str(jwks).map_err(|e| format!("not a JWKS document: {}", e))
}

/// The claims of `token`, checked against the keys of `jwks` (the text of the provider's `/.well-known/jwks.json`, fetched with
/// `http.get` and kept a while). The key is the one whose `kid` the token names (the only one when the token names none).
/// `audience` and `issuer` are checked when not empty; `exp` and `nbf` with 30 s of leeway. Only RS*, PS*, ES* and EdDSA are taken,
/// never HS*, so a token cannot pass by being signed with the public key as a secret.
pub fn jwks_verify(token: &str, jwks: &str, audience: &str, issuer: &str) -> Result<Value, String> {
    let set = keys(jwks)?;
    let header = decode_header(token).map_err(|e| format!("not a token: {}", e))?;
    let jwk = match &header.kid {
        Some(kid) => set.find(kid).ok_or_else(|| format!("no key with kid `{}` in the JWKS: fetch it again, the provider may have rotated its keys", kid))?,
        None if set.keys.len() == 1 => &set.keys[0],
        None => return Err("the token names no kid, and the JWKS has several keys".into()),
    };
    let fits = match (&jwk.algorithm, header.alg) {
        (AlgorithmParameters::RSA(_), Algorithm::RS256 | Algorithm::RS384 | Algorithm::RS512 | Algorithm::PS256 | Algorithm::PS384 | Algorithm::PS512) => true,
        (AlgorithmParameters::EllipticCurve(_), Algorithm::ES256 | Algorithm::ES384) => true,
        (AlgorithmParameters::OctetKeyPair(_), Algorithm::EdDSA) => true,
        _ => false,
    };
    if !fits {
        return Err(format!("the token's algorithm {:?} does not go with the key's type", header.alg));
    }
    let key = DecodingKey::from_jwk(jwk).map_err(|e| e.to_string())?;
    let mut v = Validation::new(header.alg);
    v.required_spec_claims.clear();
    v.leeway = 30;
    if !audience.is_empty() {
        v.set_audience(&[audience]);
    } else {
        v.validate_aud = false;
    }
    if !issuer.is_empty() {
        v.set_issuer(&[issuer]);
    }
    decode::<Value>(token, &key, &v).map(|d| d.claims).map_err(|e| e.to_string())
}

/// The keys of a JWKS document: `{ kid, kty, alg, use }` each, to see what a provider publishes.
pub fn jwks_keys(jwks: &str) -> Result<Vec<Value>, String> {
    let set = keys(jwks)?;
    Ok(set.keys.iter().map(|k| {
        let kty = match &k.algorithm {
            AlgorithmParameters::RSA(_) => "RSA",
            AlgorithmParameters::EllipticCurve(_) => "EC",
            AlgorithmParameters::OctetKeyPair(_) => "OKP",
            AlgorithmParameters::OctetKey(_) => "oct",
        };
        json!({
            "kid": k.common.key_id,
            "kty": kty,
            "alg": k.common.key_algorithm.map(|a| a.to_string()),
            "use": k.common.public_key_use.as_ref().map(|u| format!("{:?}", u).to_lowercase()),
        })
    }).collect())
}

/// A token for `claims` signed RS256 with an RSA private key (PEM) and `kid` in its header: for an identity service of your own
/// that publishes its JWKS, and for tests. `iat` is added, and `exp` when `expires_in` (seconds) is above 0.
pub fn jwks_sign(claims: serde_json::Value, private_key_pem: &str, kid: &str, expires_in: i64) -> Result<String, String> {
    let Value::Object(mut c) = claims else { return Err("the claims are a map".into()) };
    c.insert("iat".into(), now().into());
    if expires_in > 0 {
        c.insert("exp".into(), (now() + expires_in).into());
    }
    let mut h = Header::new(Algorithm::RS256);
    if !kid.is_empty() {
        h.kid = Some(kid.to_string());
    }
    let key = EncodingKey::from_rsa_pem(private_key_pem.as_bytes()).map_err(|e| e.to_string())?;
    encode(&h, &Value::Object(c), &key).map_err(|e| e.to_string())
}
