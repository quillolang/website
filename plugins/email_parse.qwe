// A support inbox: an incoming email turned into a ticket, with its attachments saved.
//
//   quillo run email_parse.qwe      then open http://localhost:8080/ticket
//
// Inbound-mail services (Postmark, SendGrid, Mailgun, SES) can post the raw email to POST /inbound.

use "email_parse.qwer"

fn ticket(raw: str) {
    let m = email_parse(raw)?
    let files = email_save_attachments(raw, `data/tickets/${crypto.sha256(m.message_id ?? raw)}`)?
    { from: m.from.email, name: m.from.name, subject: m.subject, at: m.date, replying_to: m.in_reply_to, body: m.text, files: files | map((f) => f.name) }
}

route GET /ticket = ticket(read_file("email_parse_sample.eml")?)

route POST /inbound = ticket(request.body)

route GET /parts {
    let m = email_parse_file("email_parse_sample.eml")?
    { to: m.to, cc: m.cc, attachments: m.attachments, html: m.html, content_type: m.headers["content-type"] }
}
