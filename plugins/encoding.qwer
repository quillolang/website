//! Base64, base64url, hex and percent-encoding, both ways: Quillo makes them, this reads them back; and hex to base64 byte for byte, for a base64 HMAC.
//! version: 1.1.0
//!
//! [dependencies]
//! base64 = "0.22"
//! hex = "0.4"
//! percent-encoding = "2"

use base64::engine::general_purpose::{STANDARD, STANDARD_NO_PAD, URL_SAFE_NO_PAD};
use base64::Engine;
use std::collections::HashMap;

fn utf8(bytes: Vec<u8>, keep: &str) -> Result<String, String> {
    String::from_utf8(bytes).map_err(|_| format!("the bytes are not UTF-8 text: for binary data, use {}", keep))
}

/// `text` as base64, with padding.
pub fn base64_encode(text: &str) -> String {
    STANDARD.encode(text)
}

/// Base64 back to text; padding is optional, and spaces and line breaks are ignored.
pub fn base64_decode(b64: &str) -> Result<String, String> {
    let clean: String = b64.chars().filter(|c| !c.is_whitespace()).collect();
    utf8(STANDARD_NO_PAD.decode(clean.trim_end_matches('=')).map_err(|e| e.to_string())?, "base64_to_hex or base64_to_file")
}

/// `text` as base64url without padding, as JWTs and URLs carry it.
pub fn base64url_encode(text: &str) -> String {
    URL_SAFE_NO_PAD.encode(text)
}

/// Base64url back to text, with or without padding.
pub fn base64url_decode(b64: &str) -> Result<String, String> {
    utf8(URL_SAFE_NO_PAD.decode(b64.trim().trim_end_matches('=')).map_err(|e| e.to_string())?, "base64url_to_hex")
}

/// A file's bytes as base64: an image for a `data:` URL, an attachment for an API.
pub fn file_to_base64(path: &str) -> Result<String, String> {
    Ok(STANDARD.encode(std::fs::read(path).map_err(|e| format!("{}: {}", path, e))?))
}

/// Base64 written to a file as the bytes it holds; how many bytes were written.
pub fn base64_to_file(b64: &str, path: &str) -> Result<i64, String> {
    let clean: String = b64.chars().filter(|c| !c.is_whitespace()).collect();
    let bytes = STANDARD_NO_PAD.decode(clean.trim_end_matches('=')).map_err(|e| e.to_string())?;
    std::fs::write(path, &bytes).map_err(|e| format!("{}: {}", path, e))?;
    Ok(bytes.len() as i64)
}

/// `text` as lower-case hex.
pub fn hex_encode(text: &str) -> String {
    hex::encode(text)
}

/// Hex back to text.
pub fn hex_decode(h: &str) -> Result<String, String> {
    utf8(hex::decode(h.trim()).map_err(|e| e.to_string())?, "hex_to_base64")
}

// Hex and base64 with no text in between, for bytes that are not UTF-8: an HMAC, a key, a
// hash (FEEDBACK65.md in the quillo repository, Q-943).

// The bytes hex spells, in either case. Spaces and line breaks are skipped, as hex dumps
// have them; anything else is an error naming the character and where it is.
fn hex_bytes(h: &str) -> Result<Vec<u8>, String> {
    if let Some((at, c)) = h.chars().enumerate().find(|&(_, c)| !c.is_ascii_hexdigit() && !c.is_whitespace()) {
        return Err(format!("not hex: {:?} at character {}", c, at + 1));
    }
    let digits: String = h.chars().filter(|c| !c.is_whitespace()).collect();
    if digits.len() % 2 == 1 {
        return Err(format!("not hex: an odd number of digits ({}), where each byte takes two", digits.len()));
    }
    hex::decode(digits).map_err(|e| e.to_string())
}

// The bytes base64 holds, or base64url when `url`. Spaces and line breaks are skipped. The
// padding may be left out, but `=` anywhere else, or more or fewer of them than it takes, is
// an error, as is a last character with bits past the last byte.
fn b64_bytes(b64: &str, url: bool) -> Result<Vec<u8>, String> {
    let (name, other) = if url { ("base64url", "base64: use base64_to_hex") } else { ("base64", "base64url: use base64url_to_hex") };
    let ours = |c: char| c.is_ascii_alphanumeric() || if url { c == '-' || c == '_' } else { c == '+' || c == '/' };
    if let Some((at, c)) = b64.chars().enumerate().find(|&(_, c)| !ours(c) && c != '=' && !c.is_whitespace()) {
        let hint = if "+/-_".contains(c) { format!(" (that is {})", other) } else { String::new() };
        return Err(format!("not {}: {:?} at character {}{}", name, c, at + 1, hint));
    }
    let clean: String = b64.chars().filter(|c| !c.is_whitespace()).collect();
    let data = clean.trim_end_matches('=');
    if data.contains('=') {
        let at = b64.chars().position(|c| c == '=').unwrap_or(0);
        return Err(format!("not {}: '=' at character {}, where only the end may have it", name, at + 1));
    }
    if data.len() % 4 == 1 {
        return Err(format!("not {}: {} character{} (padding aside), and a last group of one holds no whole byte", name, data.len(), if data.len() == 1 { "" } else { "s" }));
    }
    let (pads, need) = (clean.len() - data.len(), (4 - data.len() % 4) % 4);
    if pads != 0 && pads != need {
        let want = ["none", "one '=' or none", "two '=' or none"][need];
        return Err(format!("not {}: it ends in {} '=', where its padding is {}", name, pads, want));
    }
    let engine = if url { &URL_SAFE_NO_PAD } else { &STANDARD_NO_PAD };
    engine.decode(data).map_err(|e| match e {
        base64::DecodeError::InvalidLastSymbol(_, b) => format!("not {}: its last character, {:?}, has bits set past the last byte", name, b as char),
        e => format!("not {}: {}", name, e),
    })
}

/// Hex as base64 with padding, byte for byte: `hex_to_base64(crypto.hmac(secret, body))` is a Shopify or WooCommerce webhook's signature. Either case; spaces and line breaks are skipped.
pub fn hex_to_base64(hex: &str) -> Result<String, String> {
    Ok(STANDARD.encode(hex_bytes(hex)?))
}

/// Base64 as lower-case hex, byte for byte, as `crypto.hmac` writes it, for bytes that are not text. The padding may be left out; spaces and line breaks are skipped.
pub fn base64_to_hex(b64: &str) -> Result<String, String> {
    Ok(hex::encode(b64_bytes(b64, false)?))
}

/// Hex as base64url without padding, byte for byte, as a JWT carries its signature.
pub fn hex_to_base64url(hex: &str) -> Result<String, String> {
    Ok(URL_SAFE_NO_PAD.encode(hex_bytes(hex)?))
}

/// Base64url as lower-case hex, byte for byte, with or without its padding.
pub fn base64url_to_hex(b64: &str) -> Result<String, String> {
    Ok(hex::encode(b64_bytes(b64, true)?))
}

/// Percent-encoding undone: `caf%C3%A9` is `café`. A `+` stays a `+`.
pub fn url_decode(text: &str) -> Result<String, String> {
    percent_encoding::percent_decode_str(text).decode_utf8().map(|s| s.into_owned()).map_err(|e| e.to_string())
}

/// A query string or form body as a map: `a=1&b=x+y` is `{ a: "1", b: "x y" }`. A key given twice keeps the last.
pub fn form_decode(text: &str) -> Result<HashMap<String, String>, String> {
    let mut out = HashMap::new();
    for pair in text.trim_start_matches('?').split('&').filter(|p| !p.is_empty()) {
        let (k, v) = pair.split_once('=').unwrap_or((pair, ""));
        out.insert(url_decode(&k.replace('+', " "))?, url_decode(&v.replace('+', " "))?);
    }
    Ok(out)
}
