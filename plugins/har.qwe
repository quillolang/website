// A slow page looked at from a browser's HAR export: its pages, where the time went, what was
// heaviest, and the file with its secrets taken out before it goes on a ticket.
//
//   quillo run har.qwe      then open http://localhost:8080/pages, /entry, /slowest, /largest, /summary, /secrets, /redact and /broken

use "har.qwer"

let TEXT = read_file("har_sample.har")

route GET /pages {
    let h = har_read_file("har_sample.har")?
    { version: h.version, creator: h.creator, browser: h.browser, pages: h.pages }
}

route GET /entry {
    let h = har_read(TEXT)?
    { first: h.entries[0], unknown: h.entries[1].timings, not_modified: h.entries[2].cached, cancelled: [h.entries[4].status, h.entries[4].wire, h.entries[4].request_bytes], id: h.entries[1].request_id }
}

route GET /slowest = har_slowest(TEXT, 2)? | map((e) => [e.method, e.url, e.status, e.time, e.wait])
route GET /largest = har_largest(TEXT, 2)? | map((e) => [e.url, e.wire, e.content_size])
route GET /summary = har_summary(TEXT)?

route GET /secrets = har_secrets(TEXT, ["Accept"])?

route GET /redact {
    let clean = har_redact(TEXT, [])?
    let log = json.parse(clean).log
    let login = log.entries[3]
    {
        leaks: ["s3cr3t", "qk_live", "qk_test", "hunter2", "hunter3", "abc123", "t0k3n", "pw9"] | filter((s) => contains(clean, s)),
        url: log.entries[0].request.url,
        kept: log.entries[0].request.headers[2],
        body: login.request.postData.text,
        answer: login.response.content.text,
        redirect: login.response.redirectURL,
        form: log.entries[4].request.postData.text,
        same_shape: len(har_read(clean)?.entries),
    }
}

route GET /broken = {
    not_json: har_read("nope").error != null,
    no_log: har_read("{}").error,
    no_entries: har_read("{\"log\":{}}").error,
    no_file: har_read_file("nothing.har").error,
}
