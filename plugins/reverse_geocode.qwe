// Check-ins labelled with the town they were made in, from the phone's coordinates.
//
//   quillo run reverse_geocode.qwe      then open http://localhost:8080/where?lat=52.0907&lon=5.1214

use "reverse_geocode.qwer"

route GET /where ? { lat: float, lon: float } = reverse_geocode(lat, lon)?

route GET /checkins {
    let checkins = [{ user: "ada", at: [48.8584, 2.2945] }, { user: "bas", at: [35.6595, 139.7005] }, { user: "cleo", at: [-33.8568, 151.2153] }]
    let places = reverse_geocode_many(checkins | map((c) => c.at))?
    zip(checkins, places) | map((p) => `${p[0].user} in ${p[1].city}, ${p[1].country_code}`)
}

route GET /label = { city: reverse_geocode_label(52.0907, 5.1214, 10.0)?, sea: reverse_geocode_label(54.0, 3.0, 10.0)? }
