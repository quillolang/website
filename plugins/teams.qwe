// A release note in a Teams channel: an Adaptive Card with a heading, facts, columns and a button,
// and what Teams says when a webhook is gone or a card is wrong.
//
//   TEAMS_WEBHOOK_URL=https://...logic.azure.com/workflows/... quillo run teams.qwe
//   then open http://localhost:8080/post, /plain, /preview and /failures
//
// Make the webhook in Teams with the Workflows app's "Post to a channel when a webhook request is
// received". The URL is a secret: it stays in the environment.

use "teams.qwer"

fn release_card() {
    teams_card([
        teams_heading("Release 2.4.0 is live"),
        teams_container([teams_text("All checks passed.", { color: "good", weight: "bolder" })], "good")?,
        teams_facts({ Service: "checkout", Version: "2.4.0", Tests: 1284 })?,
        teams_columns([
            [teams_text("Before", { subtle: true }), teams_text("312 ms", {})],
            [teams_text("After", { subtle: true }), teams_text("204 ms", {})],
        ]),
        teams_image("https://example.com/chart.png", "Latency over the last hour")?,
    ], [teams_open_url("Open the release", "https://example.com/releases/2.4.0")])?
}

route GET /post = { sent: teams_post("", release_card())? }

route GET /plain = { sent: teams_post_text(env("TEAMS_CLASSIC_URL", ""), "Deploy finished")? }

// What goes over the wire.
route GET /preview = { message: teams_message(release_card())? }

route GET /failures = {
    gone: teams_post_text(env("TEAMS_GONE_URL", ""), "Hi").error,
    undelivered: teams_post_text(env("TEAMS_CLASSIC_URL", ""), "undeliverable").error,
    retried: teams_post_text("", "rate me")?.ok,
    bad_card: teams_card([{ type: "TextBlock", text: "" }], []).error,
    nested: teams_card([teams_container([{ type: "Image" }], "good")?], []).error,
    no_blocks: teams_card([], []).error,
    action: teams_card([teams_heading("x")], [{ type: "Action.Submit", title: "No" }]).error,
    too_big: teams_post_text("", repeat("long text ", 3000)).error,
    bad_image: teams_image("http://example.com/x.png", "x").error,
}
