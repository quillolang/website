// Default profile pictures: each user gets an identicon from their id until they upload a photo.
//
//   quillo run identicon.qwe      then open http://localhost:8080/

use "identicon.qwer"

let users = [{ id: "ada@example.com", name: "Ada" }, { id: "grace@example.com", name: "Grace" }, { id: "alan@example.com", name: "Alan" }]

route GET /avatars/:id = respond(200, identicon_svg(id, 96), { "content-type": "image/svg+xml", "cache-control": "max-age=31536000" })

route GET /avatars/:id/png {
    let path = identicon_png(id, `data/avatars/${crypto.sha256(id)}.png`, 128)?
    file(path)
}

route GET / = <html><body style="font-family: sans-serif">
    {for u in users => <div style={`display: flex; gap: 8px; align-items: center; color: ${identicon_color(u.id)}`}>
        <img src={`/avatars/${url_encode(u.id)}`} width="48" height="48" alt=""/> {u.name}
    </div>}
</body></html>

route GET /same = { same: identicon_svg("Ada@Example.com", 64) == identicon_svg("ada@example.com", 64), differ: identicon_svg("ada", 64) != identicon_svg("grace", 64), color: identicon_color("ada@example.com") }
