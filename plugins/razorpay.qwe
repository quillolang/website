// Taking payments with Razorpay: an order made in paise, the signature Checkout hands the page
// checked against your own order, a capture, a refund, and a webhook checked.
//
//   RAZORPAY_KEY_ID=rzp_test_... RAZORPAY_KEY_SECRET=... RAZORPAY_WEBHOOK_SECRET=... quillo run razorpay.qwe
//   then open /order, /verify, /capture, /refund, /lists, /amounts, /hook-check and /failures
//
// RAZORPAY_API_URL reaches a test server. The page opens Checkout with the order's id, and posts
// what its handler gets to POST /paid. Point the dashboard's webhook at POST /razorpay/webhook.

use "razorpay.qwer"

route GET /order {
    let o = razorpay_order_create(razorpay_amount("499.50", "INR")?, "INR", "receipt-1001", { customer: "Ada" })?
    let read = razorpay_order(o.id)?
    { state: o.status, paise: read.amount, due: read.amount_due, shown: razorpay_rupees(read.amount), note: read.notes.customer, tries: razorpay_order_payments(o.id)? }
}

// What Checkout's handler gets, signed by Razorpay: here the sample order the stand-in keeps.
route POST /paid {
    let f = request.json
    if f == null { reply 400 "send the fields Checkout gave you" }
    // The order id comes from your own records, not from the browser.
    let checked = razorpay_check_payment("order_seed", f)
    if is_err(checked) { reply 400 checked.error }
    { paid: checked }
}

route GET /verify {
    let sig = razorpay_payment_sign("order_seed", "pay_seed")?
    let fields = { razorpay_payment_id: "pay_seed", razorpay_signature: sig }
    {
        good: razorpay_check_payment("order_seed", fields)?,
        other_order: razorpay_check_payment("order_other", fields).error,
        tampered: razorpay_check_payment("order_seed", { razorpay_payment_id: "pay_other", razorpay_signature: sig }).error,
        missing: razorpay_check_payment("order_seed", {}).error,
        // Made outside this plugin, by node's crypto, with the stand-in's secret.
        outside: razorpay_check_payment("order_seed", { razorpay_payment_id: "pay_seed", razorpay_signature: env("RAZORPAY_SAMPLE_SIGNATURE", "") })?,
        subscription: razorpay_check_subscription("sub_1", { razorpay_payment_id: "pay_seed", razorpay_signature: env("RAZORPAY_SAMPLE_SUBSCRIPTION", "") })?,
    }
}

route GET /capture {
    let wrong = razorpay_capture("pay_seed", 100, "INR").error
    let done = razorpay_capture("pay_seed", 49950, "INR")?
    { wrong: wrong, state: done.status, captured: done.captured, method: razorpay_payment("pay_seed")?.method, order: razorpay_order("order_seed")?.status, twice: razorpay_capture("pay_seed", 49950, "INR").error }
}

route GET /refund {
    let part = razorpay_refund("pay_captured", 2000, { speed: "normal", notes: { why: "chipped" } })?
    let rest = razorpay_refund("pay_captured", 0, {})?
    {
        first: [part.amount, part.status],
        rest: rest.amount,
        read: razorpay_refund_get(part.id)?.payment_id,
        count: len(razorpay_refunds("pay_captured")?),
        state: razorpay_payment("pay_captured")?.refund_status,
        none_left: razorpay_refund("pay_captured", 100, {}).error,
    }
}

route GET /lists = {
    orders: len(razorpay_orders({}, 0)?) >= 230,
    capped: len(razorpay_orders({}, 130)?),
    receipt: map(razorpay_orders({ receipt: "old-7" }, 0)?, (o) => o.amount),
    payments: len(razorpay_payments({}, 0)?),
}

route GET /amounts = {
    paise: razorpay_amount("499.50", "INR")?,
    grouped: razorpay_amount("1,00,000", "INR")?,
    yen: razorpay_amount("100", "JPY")?,
    dinars: razorpay_amount("1.250", "KWD")?,
    shown: [razorpay_rupees(99), razorpay_rupees(100000), razorpay_rupees(12345678), razorpay_rupees(1234567890), razorpay_rupees(100000000000)],
    too_fine: razorpay_amount("1.005", "INR").error,
}

route POST /razorpay/webhook {
    let event = razorpay_webhook(request.body, request.headers["x-razorpay-signature"] ?? "", env("RAZORPAY_WEBHOOK_SECRET", ""))
    if is_err(event) { reply 400 event.error }
    { got: event.event }
}

// A signature made outside this plugin, by node's crypto.
route GET /hook-check {
    let body = "{\"event\":\"payment.captured\",\"payload\":{\"payment\":{\"entity\":{\"id\":\"pay_seed\",\"amount\":49950}}}}"
    let sig = "568253f827c48b13b7032d4bcbff1889b86dc4b77be730d05841f39a782080c3"
    {
        good: razorpay_webhook(body, sig, "whsec-test")?.event,
        amount: razorpay_webhook(body, sig, "whsec-test")?.payload.payment.entity.amount,
        tampered: razorpay_webhook(body + " ", sig, "whsec-test").error,
        other_secret: razorpay_webhook(body, sig, "other").error,
        unsigned: razorpay_webhook(body, "", "whsec-test").error,
    }
}

route GET /failures = {
    too_small: razorpay_order_create(50, "INR", "", {}).error,
    zero: razorpay_order_create(0, "INR", "", {}).error,
    receipt: razorpay_order_create(100, "INR", repeat("r", 41), {}).error,
    missing: razorpay_order("order_nosuch").error,
    waited: razorpay_order("order_busy")?.id,
}
