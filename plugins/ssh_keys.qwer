//! OpenSSH public keys read: their type, size, comment and SHA256 fingerprint as `ssh-keygen -l` shows it, and authorized_keys files, for "add your SSH key" pages.
//! version: 1.0.0
//!
//! [dependencies]
//! ssh-key = { version = "0.6", default-features = false, features = ["std", "ecdsa"] }
//! md-5 = "0.10"

use md5::{Digest, Md5};
use serde_json::{json, Value};
use ssh_key::public::KeyData;
use ssh_key::{HashAlg, PublicKey};

fn bits(k: &KeyData) -> i64 {
    match k {
        KeyData::Rsa(r) => (r.n.as_positive_bytes().map_or(0, |b| b.len()) * 8) as i64,
        KeyData::Ecdsa(e) => match e.curve().as_str() {
            "nistp384" => 384,
            "nistp521" => 521,
            _ => 256,
        },
        KeyData::Ed25519(_) | KeyData::SkEd25519(_) => 256,
        KeyData::SkEcdsaSha2NistP256(_) => 256,
        _ => 0,
    }
}

fn describe(key: &PublicKey, options: Option<String>) -> Value {
    let md5: Vec<String> = key.to_bytes().map(|b| Md5::digest(&b).iter().map(|x| format!("{:02x}", x)).collect()).unwrap_or_default();
    let alg = key.algorithm();
    let kind = match alg.as_str() {
        "ssh-ed25519" => "ED25519",
        "ssh-rsa" => "RSA",
        "ssh-dss" => "DSA",
        s if s.starts_with("ecdsa-") => "ECDSA",
        s if s.starts_with("sk-ssh-ed25519") => "ED25519-SK",
        s if s.starts_with("sk-ecdsa") => "ECDSA-SK",
        _ => "OTHER",
    };
    let b = bits(key.key_data());
    json!({
        "algorithm": alg.as_str(),
        "type": kind,
        "bits": b,
        "comment": key.comment(),
        "fingerprint": key.fingerprint(HashAlg::Sha256).to_string(),
        "md5": format!("MD5:{}", md5.join(":")),
        "options": options,
        "weak": kind == "DSA" || (kind == "RSA" && b < 2048),
    })
}

fn parse(line: &str) -> Result<PublicKey, String> {
    let line = line.trim();
    if line.len() > 16_384 {
        return Err("a public key line is at most 16 KB".into());
    }
    if line.contains("PRIVATE KEY") {
        return Err("this is a private key: paste the .pub file, never the private one".into());
    }
    PublicKey::from_openssh(line).map_err(|e| format!("not an OpenSSH public key (ssh-ed25519 AAAA... comment): {}", e))
}

/// One public key, as in `id_ed25519.pub`: `{ algorithm, type, bits, comment, fingerprint, md5, weak }`. `fingerprint` is
/// `SHA256:...` as `ssh-keygen -l` and GitHub show it; `weak` is true for DSA and for RSA under 2048 bits. A private key is refused.
pub fn ssh_key_info(line: &str) -> Result<Value, String> {
    Ok(describe(&parse(line)?, None))
}

/// The keys of an authorized_keys file (or several .pub lines): each as ssh_key_info gives it, with `options` (`from="..."`,
/// `command="..."`) or null. Blank lines and `#` comments are skipped; a line that is not a key is an error naming its number.
pub fn ssh_authorized_keys(text: &str) -> Result<Vec<Value>, String> {
    let mut out = vec![];
    for (i, line) in text.lines().enumerate().take(10_000) {
        let l = line.trim();
        if l.is_empty() || l.starts_with('#') {
            continue;
        }
        // A key line starts with its algorithm; anything before it is options.
        let words: Vec<&str> = l.split_whitespace().collect();
        let at = words.iter().position(|w| w.starts_with("ssh-") || w.starts_with("ecdsa-") || w.starts_with("sk-"));
        let (opts, key) = match at {
            Some(0) => (None, l.to_string()),
            Some(n) => (Some(words[..n].join(" ")), words[n..].join(" ")),
            None => return Err(format!("line {}: no key on it", i + 1)),
        };
        out.push(describe(&parse(&key).map_err(|e| format!("line {}: {}", i + 1, e))?, opts));
    }
    Ok(out)
}

/// Whether two lines hold the same key, whatever their comments: to refuse a key that is already on the account.
pub fn ssh_key_same(a: &str, b: &str) -> Result<bool, String> {
    Ok(parse(a)?.key_data() == parse(b)?.key_data())
}
