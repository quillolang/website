// A release from the commits since the last tag: the next version, the release notes, and
// a check of a commit message as a pre-commit hook would make it.
//
//   quillo run changelog.qwe      then open http://localhost:8080/release

use "changelog.qwer"

let COMMITS = [
    { id: "a1b2c3d4e5", message: "feat(cart): keep the cart for 30 days\n\nCarts were kept for a session only.\n\nCloses #412" },
    { id: "b2c3d4e5f6", message: "fix(checkout): round VAT per line, not per order" },
    { id: "c3d4e5f6a7", message: "feat(api)!: orders list paged by cursor\n\nBREAKING CHANGE: `page` is gone; pass `after` from the last answer." },
    { id: "d4e5f6a7b8", message: "perf: index orders by customer" },
    { id: "e5f6a7b8c9", message: "chore: bump dependencies" },
    { id: "f6a7b8c9d0", message: "Merge branch 'main' into cart" },
]

route GET /release {
    let next = changelog_next_version("v2.3.1", COMMITS)?
    respond(200, changelog_markdown(next.version, "2026-10-29", COMMITS, "https://github.com/acme/shop")?, { "content-type": "text/markdown; charset=utf-8" })
}

route GET /next = {
    after_2_3_1: changelog_next_version("v2.3.1", COMMITS)?,
    fixes_only: changelog_next_version("2.3.1", ["fix: a typo in the receipt", "docs: the README"])?,
    before_1_0: changelog_next_version("0.4.0", ["feat!: new config file"])?,
}

route GET /parse = changelog_parse(COMMITS[0].message)

route GET /groups {
    let g = changelog_group(COMMITS)?
    { breaking: g.breaking | map((c) => c.breaking_note), feat: g.feat | map((c) => c.description), other: g.other | map((c) => c.description) }
}

route GET /lint = {
    good: changelog_lint("fix(auth): refresh the token before it expires"),
    bad: changelog_lint("Fixed the login.\nIt was broken"),
    unknown: changelog_lint("feature: dark mode"),
}
