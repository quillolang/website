// A deployment script's work in Grafana: a folder and a dashboard saved into it, a deploy marked on
// the graphs, a query run through a data source with its frames read as rows, an alert rule made,
// and a service account given a short-lived token.
//
//   GRAFANA_API_URL=http://localhost:3000 GRAFANA_TOKEN=... quillo run grafana.qwe
//   then open http://localhost:8080/dashboards, /annotations, /query, /alerts and /accounts
//
// The token is a service account's, with the Admin role for the last route.

use "grafana.qwer"

route GET /dashboards {
    let folder = grafana_folder_create("Shop", { uid: "shop" })?
    let saved = grafana_dashboard_save({ uid: "orders", title: "Orders", tags: ["shop"], panels: [] }, { folder_uid: folder.uid, message: "first" })?
    let stale = grafana_dashboard_save({ uid: "orders", title: "Orders 2", version: 0 }, {})
    let forced = grafana_dashboard_save({ uid: "orders", title: "Orders 2", version: 0 }, { overwrite: true })?
    let read = grafana_dashboard_get("orders", {})?
    let found = grafana_search({ query: "orders", type: "dash-db" })?
    {
        folder: folder.title,
        status: saved.status,
        version: forced.version,
        title: read.dashboard.title,
        in: read.meta.folderUid,
        found: map(found, (d) => d.uid),
        conflict: stale.error,
        folders: len(grafana_folders({})?),
        gone: grafana_dashboard_delete("orders", {})?,
        missing: grafana_dashboard_get("orders", {}).error,
        all: len(grafana_search({ page_size: 2 })?),
    }
}

route GET /annotations {
    let id = grafana_annotation_add({ text: "deployed 1.4.2", tags: ["deploy"], time: 1730000000000, time_end: 1730000060000, dashboard_uid: "orders", panel_id: 2 }, {})?
    let found = grafana_annotations({ tags: ["deploy"], from: 1729999000000, to: 1730001000000 })?
    { text: found[0].text, region: found[0].timeEnd - found[0].time, removed: grafana_annotation_delete(id, {})?, left: len(grafana_annotations({ tags: ["deploy"] })?), no_text: grafana_annotation_add({ tags: [] }, {}).error }
}

route GET /query {
    let ds = filter(grafana_datasources({})?, (d) => d.type == "prometheus")[0]
    let got = grafana_ds_query(ds.uid, [{ expr: "up", instant: false }, { expr: "rate(http_requests_total[5m])" }], { from: "now-5m", to: "now", interval_ms: 15000 })?
    {
        frames: len(got.A),
        name: got.A[0].name,
        labels: got.A[0].labels,
        rows: got.A[0].rows,
        second: len(got.B[0].rows),
        bad: grafana_ds_query(ds.uid, { expr: "rate(" }, {}).error,
        unknown_ds: grafana_ds_query("no-such-ds", { expr: "up" }, {}).error,
    }
}

route GET /alerts {
    let data = [{ refId: "A", datasourceUid: "prom-1", relativeTimeRange: { from: 600, to: 0 }, model: { expr: "up == 0" } }]
    let rule = grafana_alert_rule_create({ title: "Instance down", ruleGroup: "availability", folderUID: "shop", condition: "A", data, labels: { team: "ops" } }, { editable: true })?
    let changed = grafana_alert_rule_update(rule.uid, { ...rule, title: "Instance is down", for: "1m" }, { editable: true })?
    {
        state: rule.noDataState,
        wait: rule.for,
        title: changed.title,
        listed: len(grafana_alert_rules({})?),
        one: grafana_alert_rule(rule.uid, {})?.ruleGroup,
        no_query: grafana_alert_rule_create({ title: "x", ruleGroup: "g", folderUID: "f", condition: "B", data }, {}).error,
        removed: grafana_alert_rule_delete(rule.uid, {})?,
    }
}

route GET /accounts {
    let account = grafana_service_account_create("ci-deploy", "Editor", {})?
    let token = grafana_token_create(account.id, "pipeline", { seconds_to_live: 3600 })?
    let tokens = grafana_tokens(account.id, {})?
    {
        role: account.role,
        key_shown: starts_with(token.key, "glsa_"),
        listed: len(tokens),
        hides_key: tokens[0].key == null,
        found: len(grafana_service_accounts({ query: "ci-" })?),
        revoked: grafana_token_delete(account.id, token.id, {})?,
        bad_role: grafana_service_account_create("x", "Root", {}).error,
        removed: grafana_service_account_delete(account.id, {})?,
        health: grafana_health({})?.database,
    }
}
