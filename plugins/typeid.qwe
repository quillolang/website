// Ids that say what they are: user_..., invoice_..., sorted by when they were made.
//
//   quillo run typeid.qwe      then open http://localhost:8080/ids

use "typeid.qwer"

route GET /ids {
    let user = typeid_new("user")?
    {
        user: user,
        read: typeid_parse(user)?,
        // The example from the TypeID spec.
        spec: typeid_from_uuid("prefix", "0110c853-1d09-52d8-d73e-1194e95b5f19")?,
        spec_back: typeid_parse("prefix_01h455vb4pex5vsknk084sn02q")?.uuid,
        nil: typeid_from_uuid("", "00000000-0000-0000-0000-000000000000")?,
        user_is_user: typeid_valid(user, "user"),
        user_is_invoice: typeid_valid(user, "invoice"),
        too_big: typeid_parse("user_8zzzzzzzzzzzzzzzzzzzzzzzzz").error,
    }
}

// /users/<typeid>: a TypeID of another type, or no TypeID at all, is refused.
route GET /users/:id {
    if !typeid_valid(id, "user") { reply 404 { error: "not a user id", id: id } }
    { user: id, made: typeid_parse(id)?.time }
}
