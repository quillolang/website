// First passwords for new staff accounts, and a recovery phrase, as passphrases.
//
//   quillo run passphrase.qwe      then open http://localhost:8080/new

use "passphrase.qwer"

route GET /new ? { words: int = 5 } = { password: passphrase(words, "-")?, bits: passphrase_bits(words, "long")? }

route GET /wifi = passphrase_with(4, " ", "memorable", true, true)?

route GET /strength = { five_long: passphrase_bits(5, "long")?, six_long: passphrase_bits(6, "long")?, eight_short: passphrase_bits(8, "short")? }
