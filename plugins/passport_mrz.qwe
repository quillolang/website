// Hotel check-in: the guest's passport or ID card scanned, its MRZ read from the OCR text, every
// check digit verified, and the guest's name and dates filled in.
//
//   quillo run passport_mrz.qwe      then open http://localhost:8080/checkin and http://localhost:8080/card

use "passport_mrz.qwer"

// What an OCR app read from the photo of ICAO's specimen passport, page noise included.
let OCR = "PASSPORT  PASS  PASAPORTE\nUtopia\nEriksson, Anna Maria\nP<UTOERIKSSON<<ANNA<MARIA<<<<<<<<<<<<<<<<<<<\nL898902C36UTO7408122F1204159ZE184226B<<<<<10\n"

route GET /checkin {
    let mrz = mrz_find(OCR) ?? reply 422 "no MRZ in the picture: take it again"
    let p = mrz_parse(mrz)
    if !p.valid { reply 422 p.errors }
    { guest: `${p.given_names} ${p.surname}`, document: p.document_number, nationality: p.nationality, birth_date: p.birth_date, expired: p.expired, checks: p.checks }
}

// ICAO's specimen ID card (TD1), and the same with one digit misread.
route GET /card = {
    card: mrz_parse("I<UTOD231458907<<<<<<<<<<<<<<<\n7408122F1204159UTO<<<<<<<<<<<6\nERIKSSON<<ANNA<MARIA<<<<<<<<<<"),
    misread: mrz_parse("I<UTOD231458907<<<<<<<<<<<<<<<\n7408122F1204169UTO<<<<<<<<<<<6\nERIKSSON<<ANNA<MARIA<<<<<<<<<<").errors,
}

// A test passport for the kiosk, read back as the scanner would.
route GET /make {
    let mrz = mrz_make({ issuing_state: "UTO", surname: "Ñúñez-García", given_names: "José Luis", document_number: "X4RT2219", birth_date: "1990-02-28", expiry_date: "2034-06-30", sex: "M" })?
    { mrz, read_back: mrz_parse(mrz).valid }
}
