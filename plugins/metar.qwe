// A flight planner's weather: METAR reports and a TAF decoded, wind in knots, pressure both ways,
// flight category worked out, and a report that a pilot would read as it stands left readable.
//
//   quillo run metar.qwe      then open http://localhost:8080/us, /europe, /fog, /calm, /words, /taf and /refused
//
// Live reports come from NOAA's aviationweather.gov as plain text; the same text goes in here.

use "metar.qwer"

let US = "METAR KJFK 121651Z 24015G25KT 210V270 10SM FEW045 SCT250 22/14 A2992 RMK AO2 PK WND 26032/1622 SLP132 P0003 T02220139 SNOW SHOVELING NEARBY $"
let EU = "SPECI EGLL 281120Z AUTO 18012KT 150V210 3000 1200NE R27L/1100D R09R/0900V1500U +TSRA BR FEW008 BKN015CB 12/11 Q0998 RERA WS R27L TEMPO FM1200 TL1300 1500 TSRA BECMG 24010KT 9999 NSW="
let FOG = "KSFO 130056Z 00000KT 1/4SM R28L/1000V1800FT/N FG VV002 M01/M02 A3001"
let MIXED = "KBOS 130056Z 07012KT 1 1/2SM -FZRA BKN009 OVC015 02/01 A2954"

route GET /us {
    let m = metar_decode(US)?
    {
        station: m.station, day: m.day, time: m.time, wind: m.wind, visibility: m.visibility, clouds: m.clouds, ceiling: m.ceiling_ft, temperature: m.temperature_c, dew: m.dewpoint_c,
        humidity: m.humidity, altimeter: m.altimeter, category: m.category, remarks: m.remarks, read_out: m.remarks_decoded, unread: m.unread,
    }
}

route GET /europe {
    let m = metar_decode(EU)?
    {
        type: m.type, auto: m.auto, wind: m.wind.variable_from, visibility: m.visibility, rvr: m.runway_visual_range, weather: m.weather, clouds: m.clouds,
        altimeter: m.altimeter, recent: m.recent_weather, shear: m.wind_shear, trends: m.trends, category: m.category,
    }
}

route GET /fog {
    let m = metar_decode(FOG)?
    let b = metar_decode(MIXED)?
    {
        calm: m.wind.calm, visibility: m.visibility, rvr: m.runway_visual_range, vv: m.vertical_visibility_ft, ceiling: m.ceiling_ft, temperature: m.temperature_c, category: m.category,
        fraction: b.visibility.miles, freezing: b.weather[0].text, boston: b.category,
    }
}

route GET /calm {
    let c = metar_decode("LFPG 121200Z 24008KT CAVOK 18/09 Q1021 NOSIG")?
    let k = metar_decode("UUEE 121200Z 03005MPS 9999 NSC M12/M15 Q1033")?
    let none = metar_decode("METAR KXYZ 121200Z NIL")?
    let odd = metar_decode("EGLL 121200Z 24008KT 9999 FEW020 15/10 Q1020 MYSTERY")?
    { cavok: [c.cavok, c.visibility.meters, c.category, c.trends], mps: [k.wind.speed, k.wind.speed_kt], sky: k.sky, no_report: none.nil, unread: odd.unread, altimeter: c.altimeter }
}

route GET /words = {
    us: metar_text(US)?,
    fog: metar_text(FOG)?,
    calm: metar_text("LFPG 121200Z 00000KT CAVOK 18/09 Q1021")?,
}

route GET /taf {
    let t = metar_taf("TAF AMD KJFK 121130Z 1212/1318 24012KT P6SM SCT030 FM121800 28015G25KT 5SM -SHRA BKN020 TEMPO 1220/1224 2SM TSRA BKN015CB PROB30 1300/1306 1/2SM FG OVC002 PROB40 TEMPO 1306/1308 3SM BR BECMG 1308/1310 VRB03KT TX25/1218Z TN12/1306Z")?
    {
        amended: t.amended, issued: t.issued, valid: t.valid, opening: t.forecast.wind.speed_kt, opening_category: t.forecast.category,
        groups: t.groups | map((g) => { type: g.type, probability: g.probability, from: g.from, to: g.to, category: g.category, weather: g.weather | map((w) => w.text) }),
        max: t.max, min: t.min, unread: t.unread,
    }
}

route GET /refused = {
    station: metar_decode("hello world").error,
    time: metar_decode("KJFK noon").error,
    not_taf: metar_taf("KJFK 121130Z").error,
    no_valid: metar_taf("TAF KJFK 121130Z tomorrow").error,
}
