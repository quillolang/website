// A voice-note player: the waveform drawn under the audio, and the numbers for a JavaScript player.
//
//   quillo run audio_wave.qwe      then open http://localhost:8080/

use "audio_wave.qwer"

let NOTE = "audio_wave_sample.wav"

route GET /note.wav = file(NOTE)
route GET /peaks = { info: audio_wave_info(NOTE)?, peaks: audio_wave_peaks(NOTE, 20)? }
route GET /wave.svg = respond(200, audio_wave_svg(NOTE, { width: 400, height: 60, bars: 80 })?, { "content-type": "image/svg+xml" })

route GET / = <html><body style="font-family: sans-serif">
    <h1>Voice note</h1>
    <div>{raw(audio_wave_svg(NOTE, { width: 400, height: 60, bars: 80, color: "#6250d6" })?)}</div>
    <audio controls src="/note.wav"></audio>
</body></html>
