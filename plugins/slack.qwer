//! Messages to Slack: through an incoming webhook or the Web API's chat.postMessage (and chat.update), with Block Kit built from a short list (headers, text, fields, images, buttons, context, dividers), mrkdwn escaped, and Slack's limits checked before it refuses.
//! version: 1.0.0
//!
//! [dependencies]
//! ureq = "2"
//! serde_json = { version = "1", features = ["preserve_order"] }

use serde_json::{json, Map, Value};

fn env(k: &str) -> Option<String> {
    std::env::var(k).ok().filter(|v| !v.trim().is_empty())
}

/// `text` with `&`, `<` and `>` escaped, as Slack's mrkdwn wants: user text cannot then ping @channel or make links.
pub fn slack_escape(text: &str) -> String {
    text.replace('&', "&amp;").replace('<', "&lt;").replace('>', "&gt;")
}

fn txt(s: &str, kind: &str) -> Value {
    json!({ "type": kind, "text": s })
}

fn cut(s: &str, n: usize) -> String {
    if s.chars().count() <= n { s.to_string() } else { format!("{}…", s.chars().take(n - 1).collect::<String>()) }
}

/// Block Kit blocks from a short list, each a map with one key saying what it is:
/// `{ header: "..." }`, `{ text: "*mrkdwn*" }` (with `image_url` for a thumbnail beside it), `{ fields: { Label: "value" } }`,
/// `{ image: url, alt }`, `{ buttons: [{ text, url, style, value, action_id }] }`, `{ context: "small print" }`, `{ divider: true }`.
/// Texts too long for Slack are cut with "…".
pub fn slack_blocks(items: Vec<serde_json::Value>) -> Result<Vec<Value>, String> {
    let mut out = vec![];
    for (i, it) in items.iter().enumerate() {
        let s = |k: &str| it[k].as_str();
        let b = if let Some(h) = s("header") {
            json!({ "type": "header", "text": txt(&cut(h, 150), "plain_text") })
        } else if let Some(t) = s("text") {
            let mut b = json!({ "type": "section", "text": txt(&cut(t, 3000), "mrkdwn") });
            if let Some(img) = s("image_url") {
                b["accessory"] = json!({ "type": "image", "image_url": img, "alt_text": s("alt").unwrap_or("image") });
            }
            b
        } else if let Some(f) = it["fields"].as_object() {
            if f.len() > 10 {
                return Err(format!("item {}: a section has at most 10 fields", i + 1));
            }
            let fields: Vec<Value> = f.iter().map(|(k, v)| txt(&cut(&format!("*{}*\n{}", k, v.as_str().map(str::to_string).unwrap_or_else(|| v.to_string())), 2000), "mrkdwn")).collect();
            json!({ "type": "section", "fields": fields })
        } else if let Some(u) = s("image") {
            json!({ "type": "image", "image_url": u, "alt_text": s("alt").unwrap_or("image") })
        } else if let Some(bs) = it["buttons"].as_array() {
            let els: Vec<Value> = bs.iter().take(25).enumerate().map(|(j, x)| {
                let mut e = json!({ "type": "button", "text": txt(&cut(x["text"].as_str().unwrap_or("Open"), 75), "plain_text"), "action_id": x["action_id"].as_str().map(str::to_string).unwrap_or_else(|| format!("button_{}", j + 1)) });
                if let Some(u) = x["url"].as_str() { e["url"] = json!(u); }
                if let Some(v) = x["value"].as_str() { e["value"] = json!(v); }
                if let Some(st) = x["style"].as_str().filter(|s| *s == "primary" || *s == "danger") { e["style"] = json!(st); }
                e
            }).collect();
            json!({ "type": "actions", "elements": els })
        } else if let Some(c) = s("context") {
            json!({ "type": "context", "elements": [txt(&cut(c, 3000), "mrkdwn")] })
        } else if it["divider"].as_bool() == Some(true) {
            json!({ "type": "divider" })
        } else {
            return Err(format!("item {}: header, text, fields, image, buttons, context or divider", i + 1));
        };
        out.push(b);
    }
    if out.len() > 50 {
        return Err("a message has at most 50 blocks".into());
    }
    Ok(out)
}

fn message(text: &str, blocks: Vec<Value>, extra: &Map<String, Value>) -> Value {
    let mut m = Map::new();
    m.insert("text".into(), json!(cut(text, 40000)));
    if !blocks.is_empty() {
        m.insert("blocks".into(), json!(blocks));
    }
    for (k, v) in extra {
        m.insert(k.clone(), v.clone());
    }
    Value::Object(m)
}

fn post(url: &str, token: Option<&str>, body: &Value) -> Result<(u16, String), String> {
    let mut r = ureq::post(url).timeout(std::time::Duration::from_secs(15)).set("Content-Type", "application/json; charset=utf-8");
    if let Some(t) = token {
        r = r.set("Authorization", &format!("Bearer {}", t));
    }
    match r.send_string(&body.to_string()) {
        Ok(res) => Ok((res.status(), res.into_string().unwrap_or_default())),
        Err(ureq::Error::Status(c, res)) => Ok((c, res.into_string().unwrap_or_default())),
        Err(e) => Err(e.to_string()),
    }
}

/// Posts to an incoming webhook (`https://hooks.slack.com/services/...`; empty: SLACK_WEBHOOK_URL): `text` is the notification's
/// text and the fallback, `blocks` as `slack_blocks` makes them (or `[]`). Gives `{ ok, status, error }`.
pub fn slack_webhook(webhook_url: &str, text: &str, blocks: Vec<serde_json::Value>) -> Result<Value, String> {
    let url = if webhook_url.is_empty() { env("SLACK_WEBHOOK_URL").ok_or("no webhook URL, and SLACK_WEBHOOK_URL is not set")? } else { webhook_url.to_string() };
    let (status, body) = post(&url, None, &message(text, blocks, &Map::new()))?;
    let ok = (200..300).contains(&status);
    Ok(json!({ "ok": ok, "status": status, "error": if ok { Value::Null } else { json!(body) } }))
}

/// Posts with the Web API's chat.postMessage as a bot (`token`: empty for SLACK_BOT_TOKEN, `xoxb-...`) to `channel` (an ID like
/// `C0123ABC`, or `#name`), `options` adding `thread_ts` (reply in a thread), `unfurl_links`, `username`, `icon_emoji`... SLACK_API_URL
/// changes the server. Gives `{ ok, ts, channel, error }`; keep `ts` to update the message or reply under it.
pub fn slack_post(token: &str, channel: &str, text: &str, blocks: Vec<serde_json::Value>, options: std::collections::HashMap<String, serde_json::Value>) -> Result<Value, String> {
    api("chat.postMessage", token, channel, text, blocks, options)
}

/// Changes a message posted before (`ts` from `slack_post`): an order's status as it moves, say.
pub fn slack_update(token: &str, channel: &str, ts: &str, text: &str, blocks: Vec<serde_json::Value>) -> Result<Value, String> {
    let mut o = std::collections::HashMap::new();
    o.insert("ts".to_string(), json!(ts));
    api("chat.update", token, channel, text, blocks, o)
}

fn api(method: &str, token: &str, channel: &str, text: &str, blocks: Vec<Value>, options: std::collections::HashMap<String, Value>) -> Result<Value, String> {
    let token = if token.is_empty() { env("SLACK_BOT_TOKEN").ok_or("no token, and SLACK_BOT_TOKEN is not set")? } else { token.to_string() };
    let base = env("SLACK_API_URL").unwrap_or_else(|| "https://slack.com/api".into());
    let mut extra: Map<String, Value> = options.into_iter().collect();
    extra.insert("channel".into(), json!(channel));
    let (status, body) = post(&format!("{}/{}", base.trim_end_matches('/'), method), Some(&token), &message(text, blocks, &extra))?;
    let v: Value = serde_json::from_str(&body).unwrap_or(Value::Null);
    // The Web API answers 200 with ok: false for its errors; a stand-in may answer only { ok: true }.
    let ok = (200..300).contains(&status) && v["ok"].as_bool().unwrap_or(false);
    Ok(json!({ "ok": ok, "status": status, "ts": v["ts"], "channel": v["channel"], "error": v["error"] }))
}
