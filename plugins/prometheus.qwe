// A shop's metrics for Prometheus: orders counted by payment method, a gauge of carts open,
// and a histogram of checkout times, scraped from /metrics.
//
//   quillo run prometheus.qwe      then open http://localhost:8080/checkout?method=card and http://localhost:8080/metrics

use "prometheus.qwer"

route GET /checkout ? { method: str = "card" } {
    // ... the order would be placed here ...
    metric_inc("shop_orders_total", { method }, 1.0)?
    metric_help("shop_orders_total", "Orders placed, by payment method.")?
    metric_set("shop_carts_open", {}, 17.0)?
    metric_observe("shop_checkout_seconds", {}, 0.042, [])?
    metric_observe("shop_checkout_seconds", {}, 0.3, [])?
    { placed: true, method }
}

route GET /metrics = respond(200, metrics_text(), { "content-type": "text/plain; version=0.0.4" })
