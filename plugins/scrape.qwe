// Link previews, and the headlines of a page.
//
//   quillo run scrape.qwe      then open http://localhost:8080/preview
//   (http.get(url)?.body gives a live page's HTML to the same functions)

use "scrape.qwer"

let page = `<html><head><title>Quillo</title>
<meta property="og:title" content="Quillo: the web, as a language">
<meta name="description" content="A small web programming language.">
<meta property="og:image" content="https://quillolang.org/banner.png"></head>
<body><h2 class="t">Routes</h2><h2 class="t">Components</h2><a href="/docs/">Docs</a><script>var x = 1</script></body></html>`

route GET /preview = page_preview(page)
route GET /headlines = { titles: select_text(page, "h2.t")?, links: select_attr(page, "a", "href")?, text: page_text(page) }
