//! Which server a key goes to, stable as servers come and go: jump consistent hashing for numbered shards, rendezvous hashing for named servers (with weights and replicas), so a cache or a shard moves as few keys as possible.
//! version: 1.0.0
//!
//! [dependencies]

/// FNV-1a over the bytes, then the splitmix64 finalizer: the same on every machine and version.
fn hash(s: &str) -> u64 {
    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
    for b in s.bytes() {
        h ^= b as u64;
        h = h.wrapping_mul(0x0000_0100_0000_01b3);
    }
    let mut z = h;
    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
    z ^ (z >> 31)
}

fn score(key: &str, server: &str) -> u64 {
    hash(&format!("{}\u{0}{}", server, key))
}

/// The shard of `key` among `shards` numbered 0 to shards-1, by jump consistent hashing (Lamping and Veach): going from 10 shards to 11 moves only a tenth of the keys, all to the new one. For shards that are only ever added or removed at the end.
pub fn hash_shard(key: &str, shards: i64) -> Result<i64, String> {
    if !(1..=1_000_000).contains(&shards) {
        return Err("shards from 1 to 1,000,000".into());
    }
    let mut k = hash(key);
    let (mut b, mut j): (i64, i64) = (-1, 0);
    while j < shards {
        b = j;
        k = k.wrapping_mul(2862933555777941757).wrapping_add(1);
        j = ((b + 1) as f64 * ((1u64 << 31) as f64 / ((k >> 33) + 1) as f64)) as i64;
    }
    Ok(b)
}

/// The server of `key` among `servers` (names, in any order), by rendezvous (highest random weight) hashing: removing a server moves only its keys, spread over the others; adding one takes a fair share. Null when the list is empty.
pub fn hash_server(key: &str, servers: Vec<String>) -> Option<String> {
    servers.into_iter().max_by_key(|s| score(key, s))
}

/// The `n` servers for `key`, best first, for keeping copies on several: the first is `hash_server`'s, and when it fails the second takes over with no other key moving.
pub fn hash_servers(key: &str, servers: Vec<String>, n: i64) -> Vec<String> {
    let mut v: Vec<(u64, String)> = servers.into_iter().map(|s| (score(key, &s), s)).collect();
    v.sort_by(|a, b| b.0.cmp(&a.0).then(a.1.cmp(&b.1)));
    v.dedup_by(|a, b| a.1 == b.1);
    v.into_iter().take(n.max(0) as usize).map(|(_, s)| s).collect()
}

/// The server of `key` by weight: `weights` maps server names to how much they take (a server of weight 2 gets about twice the keys of one of weight 1); weights of 0 or less take none. Null when none can.
pub fn hash_server_weighted(key: &str, weights: std::collections::HashMap<String, f64>) -> Option<String> {
    weights
        .into_iter()
        .filter(|(_, w)| *w > 0.0 && w.is_finite())
        .map(|(s, w)| {
            // Weighted rendezvous: -w / ln(u), u uniform in (0, 1).
            let u = ((score(key, &s) >> 11) as f64 + 0.5) / (1u64 << 53) as f64;
            (-w / u.ln(), s)
        })
        .max_by(|a, b| a.0.partial_cmp(&b.0).unwrap_or(std::cmp::Ordering::Equal).then(b.1.cmp(&a.1)))
        .map(|(_, s)| s)
}
