// What git would ignore, without git: one file's rules tried on paths, which rule decided, nested
// files, and a real folder walked. The rules are matched by a port of git's wildmatch.
//
//   GITIGNORE_ROOT=~/some/repo quillo run gitignore.qwe      then open http://localhost:8080/rules, /check, /tricky, /nested, /filter and /tree

use "gitignore.qwer"

let RULES = read_file("gitignore_sample.txt")

route GET /rules = gitignore_parse(RULES)

fn say(r) {
    `${r.path}: ${r.ignored ? "ignored" : "kept"}${r.line == null ? "" : ` by line ${r.line} (${r.rule})`}`
}

route GET /check = ["app.log", "keep.log", "src/app.log", "build/", "build", "src/build/x.o", "dist/a/b.js", "docs/a.pdf", "docs/x/a.pdf", "a/z/b.txt", "a/b.txt", "todo.txt", "sub/todo.txt", " space", "#hash", "!bang", "tmp/keep/me", "cache/keep/me", "x.pyc", "x.pyd", "x.py"] | map((p) => say(gitignore_check(RULES, p)?))

// The cases that catch people out, each as git has it.
route GET /tricky = {
    middle_star: gitignore_check("foo/*\n", "foo/a/b")?.ignored,
    middle_star_file: gitignore_check("foo*bar\n", "foo/bar")?.ignored,
    slash_star_only_level: gitignore_check("/a/*.c\n", "a/b/c.c")?.ignored,
    double_star_mid: gitignore_check("a**b/c\n", "axxb/c")?.ignored,
    double_star_no_cross: gitignore_check("a**b/c\n", "a/x/b/c")?.ignored,
    trailing_double: gitignore_check("abc/**\n", "abc/")?.ignored,
    crlf: gitignore_check("*.log\r\n", "a.log")?.ignored,
    tab_kept: gitignore_check("a\t\n", "a")?.ignored,
    escaped_space: gitignore_check("a\\ \n", "a ")?.ignored,
    class_range: gitignore_check("[a-c]x\n", "bx")?.ignored,
    class_name: gitignore_check("[[:digit:]]*\n", "7up")?.ignored,
    bad_class: gitignore_check("[[:nope:]]\n", "a")?.ignored,
    unclosed: gitignore_check("a[b\n", "a[b")?.ignored,
    leaves: gitignore_check("*\n", "../x").error,
}

route GET /nested {
    let files = {
        ".gitignore": "*.log\n/root-only\nvendor/\n",
        "src/.gitignore": "!keep.log\nsecret.txt\n/here\n",
        "src/deep/.gitignore": "*.txt\n!secret.txt\n",
    }
    gitignore_check_nested(files, ["a.log", "src/a.log", "src/keep.log", "src/deep/keep.log", "src/secret.txt", "src/deep/secret.txt", "src/deep/other.txt", "root-only", "src/root-only", "src/here", "src/deep/here", "vendor/x.c", "src/vendor/y.c"])? | map(say)
}

route GET /filter = gitignore_filter("node_modules/\n*.tmp\n!important.tmp\n", ["index.js", "a.tmp", "important.tmp", "node_modules/x/y.js", "lib/node_modules/z.js"])?

route GET /tree {
    let root = env("GITIGNORE_ROOT", ".")
    {
        walk: gitignore_walk(root, 200)?,
        one: gitignore_check_path(root, "logs/app.log")?,
        dir: gitignore_check_path(root, "logs")?,
        none: gitignore_walk("nothing-here", 0).error,
    }
}
