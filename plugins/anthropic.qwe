// Claude from a Quillo program: one question, a long answer streamed and collected, a weather
// tool answered and sent back, tokens counted, a cached system prompt, and a route that shows
// what a refused request and an unknown model look like.
//
//   ANTHROPIC_API_KEY=... quillo run anthropic.qwe
//   then open http://localhost:8080/ask, /stream, /tools, /count, /cached, /models and /failures
//
// ANTHROPIC_MODEL picks the model and ANTHROPIC_API_URL another address, a proxy or a test server.
// The plugin asks for Anthropic's server-side fallback on a refused request where the model has
// one; give the option `fallbacks: false` to leave it off.

use "anthropic.qwer"

let weather = anthropic_tool("get_weather", "Get the current weather for a city. Use it for any question about the weather.", {
    type: "object",
    properties: { city: { type: "string", description: "City name" } },
    required: ["city"],
})?

route GET /ask = {
    answer: anthropic_ask("Name a prime number.", "Answer in one word.", {})?,
}

// Retried by the plugin: the first answers are 429 and 529.
route GET /retries = {
    after_429: anthropic_ask("slow down please", "", { retries: 2 })?,
    after_529: anthropic_ask("busy right now", "", { retries: 2 })?,
    given_up: anthropic_ask("busy always", "", { retries: 1 }).error,
}

route GET /stream {
    let r = anthropic_stream({ system: "Be brief.", messages: "Stream a haiku" }, {})?
    { text: r.text, stop: r.stop_reason, output_tokens: r.usage.output_tokens }
}

// The whole loop: Claude asks for the tool, the program runs it, Claude reads the result.
fn run_tool(call) {
    if call.name != "get_weather" { return anthropic_tool_result(call.id, "no such tool", true) }
    anthropic_tool_result(call.id, { city: call.input.city, celsius: 18, sky: "clear" }, false)
}

route GET /tools {
    let tools = [weather]
    let messages = [{ role: "user", content: "What is the weather in Paris?" }]
    let first = anthropic_message({ messages: messages, tools: tools }, {})?
    let results = map(first.tool_uses, run_tool)
    let next = anthropic_continue(messages, first, results)?
    let second = anthropic_message({ messages: next, tools: tools }, {})?
    {
        asked: first.stop_reason,
        calls: map(first.tool_uses, (c) => c.input.city),
        answer: second.text,
        finished: second.stop_reason,
        missing: anthropic_continue(messages, first, []).error,
    }
}

route GET /tools-stream {
    let r = anthropic_stream({ messages: "What is the weather in Paris?", tools: [weather] }, {})?
    { stop: r.stop_reason, input: r.tool_uses[0].input }
}

route GET /count = {
    tokens: anthropic_count_tokens({ system: "Be brief.", messages: "How many tokens is this?" }, {})?,
}

// A long prompt that does not change: the second request reads it back from the cache.
let handbook = repeat("The handbook says: pack light. ", 400)

fn cached_call() {
    anthropic_message({
        system: anthropic_system(handbook, "1h")?,
        messages: anthropic_cache_last([{ role: "user", content: "What does the handbook say?" }], "")?,
    }, {})?
}

route GET /cached {
    let first = cached_call()
    let second = cached_call()
    { first: anthropic_cache_usage(first), second: anthropic_cache_usage(second) }
}

route GET /models {
    let all = anthropic_models({})?
    { count: len(all), first: all[0].id }
}

route GET /failures = {
    refused: anthropic_ask("refuse-me please", "", {}).error,
    unknown_model: anthropic_message("Hi", { model: "claude-none-1", fallbacks: false, retries: 0 }).error,
    sampling: anthropic_message({ messages: "Hi", temperature: 0.2 }, {}).error,
    forced_tool: anthropic_message({ messages: "Hi", tools: [weather], tool_choice: { type: "any" } }, {}).error,
    bad_key: anthropic_ask("Hi", "", { api_key: "wrong-key" }).error,
}
