//! IP addresses and ranges (CIDR): allowlists, office-only admin pages, private addresses, IPv4 and IPv6 alike.
//! version: 1.0.0
//!
//! [dependencies]
//! ipnet = "2"

use ipnet::IpNet;
use std::net::IpAddr;

fn ip(s: &str) -> Result<IpAddr, String> {
    s.trim().parse::<IpAddr>().map_err(|_| format!("`{}` is not an IP address", s))
}

/// Whether `address` is in any of `ranges` ("10.0.0.0/8", "2001:db8::/32", or a single address).
pub fn ip_in(address: &str, ranges: Vec<String>) -> Result<bool, String> {
    let a = ip(address)?;
    for r in &ranges {
        let r = r.trim();
        let hit = if r.contains('/') { r.parse::<IpNet>().map_err(|e| format!("`{}`: {}", r, e))?.contains(&a) } else { ip(r)? == a };
        if hit {
            return Ok(true);
        }
    }
    Ok(false)
}

/// Whether `address` is private, loopback or link-local: not one from the internet.
pub fn ip_private(address: &str) -> Result<bool, String> {
    Ok(match ip(address)? {
        IpAddr::V4(v) => v.is_private() || v.is_loopback() || v.is_link_local(),
        IpAddr::V6(v) => v.is_loopback() || (v.segments()[0] & 0xfe00) == 0xfc00 || (v.segments()[0] & 0xffc0) == 0xfe80
            || v.to_ipv4_mapped().is_some_and(|m| m.is_private() || m.is_loopback()),
    })
}

/// 4 or 6.
pub fn ip_version(address: &str) -> Result<i64, String> {
    Ok(if ip(address)?.is_ipv4() { 4 } else { 6 })
}
