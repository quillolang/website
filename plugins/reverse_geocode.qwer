//! The nearest town or city to a point, offline: about 150,000 places of 1,000 people or more (GeoNames), with their region and country code. For "posted from Utrecht, NL", a photo's place, or a form's default country.
//! version: 1.0.0
//!
//! [dependencies]
//! reverse_geocoder = "4"

use serde_json::{json, Value};
use std::sync::OnceLock;

/// The places, loaded once (the first call takes a moment; they stay in memory, about 40 MB).
fn geocoder() -> &'static reverse_geocoder::ReverseGeocoder {
    static G: OnceLock<reverse_geocoder::ReverseGeocoder> = OnceLock::new();
    G.get_or_init(reverse_geocoder::ReverseGeocoder::new)
}

fn km(lat1: f64, lon1: f64, lat2: f64, lon2: f64) -> f64 {
    let (p1, p2) = (lat1.to_radians(), lat2.to_radians());
    let (dp, dl) = ((lat2 - lat1).to_radians(), (lon2 - lon1).to_radians());
    let a = (dp / 2.0).sin().powi(2) + p1.cos() * p2.cos() * (dl / 2.0).sin().powi(2);
    2.0 * 6371.0088 * a.sqrt().asin()
}

fn near(lat: f64, lon: f64) -> Result<Value, String> {
    if !(-90.0..=90.0).contains(&lat) || !(-180.0..=180.0).contains(&lon) {
        return Err(format!("{}, {} is not a place", lat, lon));
    }
    let r = geocoder().search((lat, lon)).record;
    Ok(json!({
        "city": r.name, "region": r.admin1, "district": r.admin2, "country_code": r.cc,
        "lat": r.lat, "lon": r.lon, "km": (km(lat, lon, r.lat, r.lon) * 100.0).round() / 100.0,
    }))
}

/// The nearest place to a point: `{ city, region, district, country_code, lat, lon, km }`, `km` how far the point is from it. Far out at sea it is still the nearest one: check `km`.
pub fn reverse_geocode(lat: f64, lon: f64) -> Result<Value, String> {
    near(lat, lon)
}

/// The nearest place to each of many points `[[lat, lon], ...]`, in order (at most 100,000).
pub fn reverse_geocode_many(points: Vec<Vec<f64>>) -> Result<Vec<Value>, String> {
    if points.len() > 100_000 {
        return Err("at most 100,000 points at once".into());
    }
    points.iter().map(|p| if p.len() == 2 { near(p[0], p[1]) } else { Err("each point is [lat, lon]".into()) }).collect()
}

/// A short label for a point, "Utrecht, Utrecht, NL", or "near Utrecht, NL" when it is more than `near_km` away from the place.
pub fn reverse_geocode_label(lat: f64, lon: f64, near_km: f64) -> Result<String, String> {
    let p = near(lat, lon)?;
    let city = p["city"].as_str().unwrap_or("");
    let region = p["region"].as_str().unwrap_or("");
    let cc = p["country_code"].as_str().unwrap_or("");
    let base = if region.is_empty() || region == city { format!("{}, {}", city, cc) } else { format!("{}, {}, {}", city, region, cc) };
    Ok(if p["km"].as_f64().unwrap_or(0.0) > near_km { format!("near {}, {}", city, cc) } else { base })
}
