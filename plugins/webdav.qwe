// Files on a WebDAV server (Nextcloud, ownCloud, Box, SharePoint-style servers, Apache's mod_dav):
// a folder made and listed, files written, read, copied, moved and deleted, and a lock that keeps
// others from writing while this program does.
//
//   WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/ada/ WEBDAV_USER=ada WEBDAV_PASSWORD=app-password quillo run webdav.qwe
//   then open http://localhost:8080/files, /read, /move, /lock and /errors (in that order)
//
// The example works in a folder of its own, quillo-example/, which /files makes again each time.

use "webdav.qwer"

let ROOT = env("WEBDAV_URL", "http://127.0.0.1:8080/dav/")
let AUTH = { user: env("WEBDAV_USER", "ada"), password: env("WEBDAV_PASSWORD", "") }
let DIR = `${ROOT}quillo-example/`

route GET /files {
    webdav_delete(DIR, AUTH)?
    webdav_mkcol(DIR, AUTH)?
    webdav_mkcol(`${DIR}reports`, AUTH)?
    webdav_put(`${DIR}notes.txt`, "Order A-1042 shipped.\n", AUTH)?
    webdav_put(`${DIR}reports/2026-10.csv`, "day,orders\n2026-10-01,12\n2026-10-02,9\n", AUTH + { content_type: "text/csv" })?
    let up = webdav_upload(`${DIR}example.qwe`, "webdav.qwe", AUTH)?
    {
        uploaded: up.created,
        files: webdav_list(DIR, AUTH)? | map((f) => f.is_dir ? `${f.name}/` : `${f.name} ${f.size} bytes`),
        everything: webdav_list(DIR, AUTH + { depth: 1, include_self: true })? | map((f) => f.path),
    }
}

route GET /read {
    let s = webdav_stat(`${DIR}notes.txt`, AUTH)?
    let named = webdav_stat(`${DIR}notes.txt`, AUTH + { props: ["getetag", "getcontentlength", "{http://owncloud.org/ns}fileid"] })?
    {
        text: webdav_get(`${DIR}notes.txt`, AUTH)?,
        size: s.size, type: s.content_type, has_etag: s.etag != null, modified_is_utc: ends_with(s.modified ?? "", "Z"),
        named: named.props | keys, missing: named.missing,
        nothing: webdav_stat(`${DIR}nothing.txt`, AUTH)?,
    }
}

route GET /move = {
    copy: webdav_copy(`${DIR}notes.txt`, `${DIR}notes-copy.txt`, AUTH)?,
    rename: webdav_move(`${DIR}reports/2026-10.csv`, `${DIR}reports/october.csv`, AUTH)?.created,
    refused: webdav_move(`${DIR}notes-copy.txt`, `${DIR}notes.txt`, AUTH).error,
    replaced: webdav_move(`${DIR}notes-copy.txt`, `${DIR}notes.txt`, AUTH + { overwrite: true })?.replaced,
    reports: webdav_list(`${DIR}reports/`, AUTH)? | map((f) => f.name),
}

// A lock: writes without its token are refused until it is given back.
route GET /lock {
    let file = `${DIR}notes.txt`
    let lock = webdav_lock(file, AUTH + { owner: "quillo example", timeout: 120 })?
    let refused = webdav_put(file, "someone else", AUTH).error
    let with_token = webdav_put(file, "Order A-1042 delivered.\n", AUTH + { lock_token: lock.token })?
    let refreshed = webdav_lock(file, AUTH + { lock_token: lock.token, timeout: 300 })?
    webdav_unlock(file, lock.token, AUTH)?
    {
        scope: lock.scope, timeout: lock.timeout, owner: lock.owner, token_ok: starts_with(lock.token, "urn:uuid:") || starts_with(lock.token, "opaquelocktoken:"),
        refused, written: !with_token.created, refreshed: refreshed.timeout > 120,
        after_unlock: webdav_put(file, "Order A-1042 delivered and signed for.\n", AUTH)?.status,
        text: webdav_get(file, AUTH)?,
    }
}

route GET /errors = {
    wrong_password: webdav_list(DIR, { user: "ada", password: "nope" }).error,
    no_parent: webdav_mkcol(`${DIR}a/b/c`, AUTH).error,
    with_parents: webdav_mkcol(`${DIR}a/b/c`, AUTH + { parents: true })?,
    again: webdav_mkcol(`${DIR}a/b/c`, AUTH)?,
    deleted: webdav_delete(`${DIR}a`, AUTH)?,
    gone: webdav_delete(`${DIR}a`, AUTH)?,
}
