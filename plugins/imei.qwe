// A phone repair shop's intake: the IMEI from the label checked (a typo means the wrong
// customer's phone), the SIM's ICCID read, and an old CDMA phone's MEID converted.
//
//   quillo run imei.qwe      then open http://localhost:8080/intake

use "imei.qwer"

route GET /imei/:n = imei_parse(n)

route GET /intake = {
    phone: imei_parse("35-209900-176148-1"),
    typo: imei_parse("352099001761482").error,
    imeisv: imei_parse("3520990017614823"),
    made: imei_make("35209900", "176148")?,
    sim: iccid_parse("8963 0123 4567 8901 238"),
    subscriber: imsi_parse("515031234567890"),
    us_subscriber: imsi_parse("310260123456789"),
    cdma: meid_parse("A10000009296F2"),
}
