// A planning site: parcels from the national grid shown on a web map, GPS points put on the grid, distances in metres.
//
//   quillo run projections.qwe      then open http://localhost:8080/points

use "projections.qwer"

// Big Ben, in GPS degrees (longitude first).
let BIG_BEN = [-0.124625, 51.500729]

route GET /points {
    let zone = proj_utm_zone(BIG_BEN[1], BIG_BEN[0])?
    {
        web_mercator: proj_point(BIG_BEN[0], BIG_BEN[1], "EPSG:4326", "EPSG:3857")?,
        british_grid: proj_point(BIG_BEN[0], BIG_BEN[1], "EPSG:4326", "EPSG:27700")?,
        back: proj_point(530268.0, 179640.0, "EPSG:27700", "EPSG:4326")?,
        zone: zone,
        utm: proj_point(BIG_BEN[0], BIG_BEN[1], "EPSG:4326", zone)?,
        dutch: proj_points([[4.8897, 52.3731], [5.1214, 52.0907]], "EPSG:4326", "EPSG:28992")?,
        crs: proj_crs("EPSG:27700")?,
        unknown: proj_point(0.0, 0.0, "EPSG:1", "EPSG:4326").error,
    }
}

// A parcel drawn on the British grid, in GPS degrees for Leaflet.
route GET /parcel = proj_geojson({
    type: "Feature",
    properties: { parcel: "TQ 3079" },
    geometry: { type: "Polygon", coordinates: [[[530000.0, 179000.0], [531000.0, 179000.0], [531000.0, 180000.0], [530000.0, 180000.0], [530000.0, 179000.0]]] },
}, "EPSG:27700", "EPSG:4326")?
