//! Phone numbers checked and written one way: E.164 for storing, international and national forms for showing, from Google's libphonenumber data.
//! version: 1.0.0
//!
//! [dependencies]
//! phonenumber = "0.3"

use phonenumber::{country, Mode};
use serde_json::{json, Value};

fn parse(number: &str, region: &str) -> Result<phonenumber::PhoneNumber, String> {
    let id = if region.is_empty() { None } else { Some(region.to_uppercase().parse::<country::Id>().map_err(|_| format!("`{}` is not a region code (US, GB, PH...)", region))?) };
    phonenumber::parse(id, number).map_err(|e| e.to_string())
}

/// `{ e164, international, national, country_code, region, valid }` for a number, read as from `region` ("US", "GB", "PH") when it has no `+`.
pub fn phone_parse(number: &str, region: &str) -> Result<Value, String> {
    let n = parse(number, region)?;
    Ok(json!({
        "e164": n.format().mode(Mode::E164).to_string(),
        "international": n.format().mode(Mode::International).to_string(),
        "national": n.format().mode(Mode::National).to_string(),
        "country_code": n.code().value(),
        "region": n.country().id().map(|id| format!("{:?}", id)),
        "valid": phonenumber::is_valid(&n),
    }))
}

/// The number in E.164 (`+14155550123`), to store and to send texts to, or an error when it is not a valid number.
pub fn phone_e164(number: &str, region: &str) -> Result<String, String> {
    let n = parse(number, region)?;
    if !phonenumber::is_valid(&n) {
        return Err(format!("{} is not a valid phone number", number));
    }
    Ok(n.format().mode(Mode::E164).to_string())
}
