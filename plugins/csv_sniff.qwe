// An import page that works out how an uploaded CSV is written before reading it.
//
//   quillo run csv_sniff.qwe      then open http://localhost:8080/bank

use "csv_sniff.qwer"

// A Dutch bank export: semicolons, decimal commas, a header, quotes around cells holding a `;`.
route GET /bank = csv_sniff_file("csv_sniff_sample.csv")?

route GET /samples = {
    us: csv_sniff("id,name,total\n1,Ada,120.50\n2,Grace,99.00\n")?,
    tabs_no_header: csv_sniff("1042\tAda Lovelace\t120.50\n1043\tGrace Hopper\t99.00\n1044\tAlan Turing\t15.00\n")?,
    pipes: csv_sniff("sku|title|qty\nB7|Blue mug|2\nC2|Red mug|5\n")?.delimiter,
}

route POST /import {
    let s = csv_sniff(request.body)?
    if s.confidence < 0.8 { reply 400 "The rows do not split evenly: is this a CSV file?" }
    { delimiter: s.delimiter, columns: s.header ?? range(s.columns) | map((i) => `column ${i + 1}`), decimal_comma: s.decimal_comma }
}
