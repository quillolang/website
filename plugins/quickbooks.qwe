// Books kept in QuickBooks Online: a customer and an invoice, queries in Intuit's language with a
// name that needs quoting, sparse updates through SyncToken, a void, and webhooks checked.
//
//   QUICKBOOKS_CLIENT_ID=... QUICKBOOKS_CLIENT_SECRET=... QUICKBOOKS_REFRESH_TOKEN=... \
//   QUICKBOOKS_REALM_ID=... QUICKBOOKS_TOKEN_FILE=qbo-token QUICKBOOKS_VERIFIER=... quillo run quickbooks.qwe
//   then open /invoice, /queries, /sync, /void, /hook-check and /failures
//
// QUICKBOOKS_API_URL and QUICKBOOKS_TOKEN_URL reach a sandbox or a test server. Point a webhook at
// POST /quickbooks/webhook.

use "quickbooks.qwer"

route GET /invoice {
    let c = quickbooks_customer_create("Mugs & O'Brien Ltd", { PrimaryEmailAddr: { Address: "ada@example.com" } })?
    let inv = quickbooks_invoice_create(c.Id, [{ item: "1", qty: 3.0, unit_price: 12.5, description: "Mugs" }, { amount: 5.0, description: "Post" }], { DueDate: "2026-11-30" })?
    let read = quickbooks_get("Invoice", inv.Id)?
    {
        customer: read.CustomerRef.value == c.Id, total: read.TotalAmt, balance: read.Balance, lines: len(read.Line),
        twice: quickbooks_customer_create("Mugs & O'Brien Ltd", {}).error,
    }
}

route GET /queries {
    quickbooks_customer_create("Ada O'Brien", {})?
    let q = "select * from Customer where DisplayName = " + quickbooks_quote("Ada O'Brien")
    {
        quoted: quickbooks_quote("O'Brien\\Sons"),
        found: map(quickbooks_query(q)?.Customer, (c) => c.DisplayName),
        none: quickbooks_query("select * from Customer where DisplayName = 'Nobody'")?.Customer ?? [],
        all: len(quickbooks_query_all("Item", "", 0)?),
        capped: len(quickbooks_query_all("Item", "", 1100)?),
        unpaid: quickbooks_count("Item", "where Active = true")?,
        own_paging: quickbooks_query_all("Item", "MAXRESULTS 5", 0).error,
        bad: quickbooks_query("select nonsense").error,
    }
}

route GET /sync {
    let c = quickbooks_customer_create("Grace Hopper", {})?
    let one = quickbooks_update("Customer", c, { Notes: "first" })?
    let stale = quickbooks_update("Customer", c, { Notes: "lost" }).error
    let two = quickbooks_update_latest("Customer", c.Id, { Notes: "second" })?
    { first: [one.Notes, one.SyncToken], stale: stale, second: [two.Notes, two.SyncToken] }
}

route GET /void {
    let c = quickbooks_customer_create("Void Co", {})?
    let inv = quickbooks_invoice_create(c.Id, [{ amount: 10.0 }], {})?
    let voided = quickbooks_void(inv)?
    let other = quickbooks_invoice_create(c.Id, [{ amount: 7.0 }], {})?
    { total: voided.TotalAmt, deleted: quickbooks_delete("Invoice", other)?.status, gone: quickbooks_get("Invoice", other.Id).error }
}

route POST /quickbooks/webhook {
    let events = quickbooks_webhook(request.body, request.headers["intuit-signature"] ?? "", env("QUICKBOOKS_VERIFIER", ""))
    if is_err(events) { reply 401 events.error }
    { got: len(events) }
}

// Signatures made outside this plugin, by node's crypto, on both of Intuit's shapes.
route GET /hook-check {
    let old = "{\"eventNotifications\":[{\"realmId\":\"1185883450\",\"dataChangeEvent\":{\"entities\":[{\"name\":\"Customer\",\"id\":\"1\",\"operation\":\"Create\",\"lastUpdated\":\"2026-11-01T10:00:00Z\"},{\"name\":\"Invoice\",\"id\":\"9\",\"operation\":\"Void\",\"lastUpdated\":\"2026-11-01T10:01:00Z\"}]}}]}"
    let cloud = "[{\"specversion\":\"1.0\",\"id\":\"e1\",\"source\":\"intuit.x\",\"type\":\"qbo.invoice.updated.v1\",\"time\":\"2026-11-01T10:02:00Z\",\"intuitentityid\":\"9\",\"intuitaccountid\":\"1185883450\",\"data\":{}}]"
    {
        old: quickbooks_webhook(old, "dB9yFHxB1ylcl1t9oFPuchMf8xfY8Yr+f+uuxBaaLyI=", "verifier-test")?,
        cloud: quickbooks_webhook(cloud, "bmxMDseHs1w41Mm/2HA0QaE9I6Vq5aW0cQqHRkTdGfs=", "verifier-test")?,
        tampered: quickbooks_webhook(old + " ", "dB9yFHxB1ylcl1t9oFPuchMf8xfY8Yr+f+uuxBaaLyI=", "verifier-test").error,
        unsigned: quickbooks_webhook(old, "", "verifier-test").error,
        round: quickbooks_webhook(old, quickbooks_webhook_sign(old, "v2"), "v2")?[0].entity,
    }
}

route GET /failures = {
    empty: quickbooks_invoice_create("1", [], {}).error,
    no_token: quickbooks_update("Customer", { Id: "1" }, {}).error,
    missing: quickbooks_get("Invoice", "99999").error,
    entity: quickbooks_get("In voice", "1").error,
    waited: quickbooks_get("Item", "busy")?.Name,
    fault_in_200: quickbooks_get("Item", "fault").error,
    renewed: len(quickbooks_refresh_token()) > 0,
}
