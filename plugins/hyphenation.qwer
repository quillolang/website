//! Words hyphenated by the rules of 80 languages and spellings (TeX's patterns, built in): the syllables of a word, soft hyphens put in text and in HTML for narrow columns and e-mails, and text wrapped at a width with words broken where they may be.
//! version: 1.0.0
//!
//! [dependencies]
//! hyphenation = { version = "=0.8.4", features = ["embed_all"] }

use hyphenation::{Hyphenator, Language, Load, Standard};
use std::collections::HashMap;
use std::sync::{Arc, Mutex, OnceLock};

const SHY: char = '\u{AD}';

fn language(code: &str) -> Result<Language, String> {
    let c = code.trim().to_lowercase().replace('_', "-");
    let alias = match c.as_str() {
        "" | "en" => "en-us",
        "de" | "de-de" | "de-at" => "de-1996",
        "de-ch" => "de-ch-1901",
        "el" => "el-monoton",
        "nb" | "no" => "nb",
        "sr" => "sr-cyrl",
        "mn" => "mn-cyrl",
        "pt-br" | "pt-pt" => "pt",
        "es-mx" | "es-es" => "es",
        "fr-fr" | "fr-ca" => "fr",
        other => other,
    };
    Language::try_from_code(alias).ok_or_else(|| format!("`{}` is not a language with hyphenation patterns (en-us, en-gb, de, fr, es, nl...)", code))
}

fn dict(code: &str) -> Result<Arc<Standard>, String> {
    static CACHE: OnceLock<Mutex<HashMap<Language, Arc<Standard>>>> = OnceLock::new();
    let lang = language(code)?;
    let cache = CACHE.get_or_init(|| Mutex::new(HashMap::new()));
    let mut c = cache.lock().map_err(|_| "the dictionaries are unavailable".to_string())?;
    if let Some(d) = c.get(&lang) { return Ok(d.clone()) }
    let d = Arc::new(Standard::from_embedded(lang).map_err(|e| format!("{}: {}", lang, e))?);
    c.insert(lang, d.clone());
    Ok(d)
}

fn parts(d: &Standard, word: &str) -> Vec<String> {
    let w = d.hyphenate(word);
    let mut out = Vec::new();
    let mut last = 0;
    for &b in &w.breaks {
        if b > last && b < word.len() && word.is_char_boundary(b) { out.push(word[last..b].to_string()); last = b; }
    }
    out.push(word[last..].to_string());
    out
}

// Each run of letters in `text` given to `f`, the rest copied.
fn each_word(text: &str, mut f: impl FnMut(&str, &mut String)) -> String {
    let mut out = String::with_capacity(text.len() + text.len() / 8);
    let mut word = String::new();
    for c in text.chars() {
        if c.is_alphabetic() { word.push(c) } else {
            if !word.is_empty() { f(&word, &mut out); word.clear(); }
            out.push(c);
        }
    }
    if !word.is_empty() { f(&word, &mut out) }
    out
}

/// A word's syllables where it may be broken in `lang` (`"en-us"`, `"en-gb"`, `"de"`, `"fr"`, `"nl"`...): `["hy", "phen", "ation"]`. A word too short to break comes back whole.
pub fn hyphenate_word(word: &str, lang: &str) -> Result<Vec<String>, String> {
    let d = dict(lang)?;
    Ok(parts(&d, word.trim()))
}

/// `text` with soft hyphens (U+00AD) in its words of `min_length` letters or more: a browser or e-mail client breaks a word there at a line's end and shows a hyphen, and nowhere else.
pub fn hyphenate_text(text: &str, lang: &str, min_length: i64) -> Result<String, String> {
    let d = dict(lang)?;
    Ok(each_word(text, |w, out| {
        if (w.chars().count() as i64) < min_length { out.push_str(w) } else { out.push_str(&parts(&d, w).join(&SHY.to_string())) }
    }))
}

/// HTML with `&shy;` in the words of its text (tags, attributes, entities, and `<pre>`, `<code>`, `<script>` and `<style>` left alone), words of `min_length` letters or more: for narrow columns and e-mails, where CSS `hyphens: auto` is not supported.
pub fn hyphenate_html(html: &str, lang: &str, min_length: i64) -> Result<String, String> {
    let d = dict(lang)?;
    let mut out = String::with_capacity(html.len() + html.len() / 6);
    let mut rest = html;
    let mut skip_until: Option<String> = None;
    while !rest.is_empty() {
        if rest.starts_with('<') {
            let end = rest.find('>').map(|i| i + 1).unwrap_or(rest.len());
            let tag = &rest[..end];
            let name: String = tag.trim_start_matches('<').chars().take_while(|c| c.is_ascii_alphanumeric() || *c == '/').collect::<String>().to_lowercase();
            if let Some(stop) = &skip_until { if &name == stop { skip_until = None } }
            else if ["pre", "code", "script", "style", "textarea"].contains(&name.as_str()) { skip_until = Some(format!("/{}", name)) }
            out.push_str(tag);
            rest = &rest[end..];
            continue;
        }
        let end = rest.find('<').unwrap_or(rest.len());
        let text = &rest[..end];
        if skip_until.is_some() { out.push_str(text) } else {
            // Entities stay whole: split around them.
            let mut t = text;
            while !t.is_empty() {
                if let Some(a) = t.find('&') {
                    let b = t[a..].find(';').map(|i| a + i + 1).filter(|&b| b - a <= 12).unwrap_or(a + 1);
                    out.push_str(&each_word(&t[..a], |w, o| if (w.chars().count() as i64) < min_length { o.push_str(w) } else { o.push_str(&parts(&d, w).join("&shy;")) }));
                    out.push_str(&t[a..b]);
                    t = &t[b..];
                } else {
                    out.push_str(&each_word(t, |w, o| if (w.chars().count() as i64) < min_length { o.push_str(w) } else { o.push_str(&parts(&d, w).join("&shy;")) }));
                    t = "";
                }
            }
        }
        rest = &rest[end..];
    }
    Ok(out)
}

/// `text` wrapped to lines of at most `width` characters, a word that does not fit broken at a hyphenation point with a `-` (only when it does not fit whole): for receipts, labels and terminals. Paragraph breaks are kept.
pub fn hyphenate_wrap(text: &str, width: i64, lang: &str) -> Result<Vec<String>, String> {
    if width < 4 { return Err("a width of 4 characters at least".into()) }
    let d = dict(lang)?;
    let w = width as usize;
    let mut lines = Vec::new();
    for para in text.split('\n') {
        let mut line = String::new();
        for word in para.split_whitespace() {
            let len = |s: &str| s.chars().count();
            let room = if line.is_empty() { w } else { w.saturating_sub(len(&line) + 1) };
            if len(word) <= room {
                if !line.is_empty() { line.push(' ') }
                line.push_str(word);
                continue;
            }
            // Break the word: as many syllables as fit with a hyphen, the rest on following lines.
            let syl = parts(&d, word);
            let mut rest: Vec<String> = syl;
            loop {
                let room = if line.is_empty() { w } else { w.saturating_sub(len(&line) + 1) };
                let all: String = rest.concat();
                if len(&all) <= room { if !line.is_empty() { line.push(' ') } line.push_str(&all); break }
                let mut take = 0;
                let mut acc = String::new();
                while take < rest.len() - 1 && len(&acc) + len(&rest[take]) + 1 <= room { acc.push_str(&rest[take]); take += 1; }
                if take == 0 {
                    if line.is_empty() {
                        // A syllable longer than the line: cut it.
                        let first: String = all.chars().take(w - 1).collect();
                        lines.push(format!("{}-", first));
                        rest = vec![all.chars().skip(w - 1).collect()];
                    } else {
                        lines.push(std::mem::take(&mut line));
                    }
                    continue;
                }
                if !line.is_empty() { line.push(' ') }
                line.push_str(&acc);
                line.push('-');
                lines.push(std::mem::take(&mut line));
                rest = rest[take..].to_vec();
            }
        }
        lines.push(line);
    }
    Ok(lines)
}

/// The language codes there are patterns for: `["af", "be", "bg", ..., "en-gb", "en-us", ...]`.
pub fn hyphenate_languages() -> Vec<String> {
    let mut v: Vec<String> = Vec::new();
    for code in ["af", "sq", "hy", "as", "eu", "be", "bn", "bg", "ca", "zh-latn-pinyin", "cop", "hr", "cs", "da", "nl", "en-gb", "en-us", "eo", "et", "mul-ethi", "fi", "fi-x-school", "fr", "fur", "gl", "ka", "de-1901", "de-1996", "de-ch-1901", "grc", "el-monoton", "el-polyton", "gu", "hi", "hu", "is", "id", "ia", "ga", "it", "kn", "kmr", "la", "la-x-classic", "la-x-liturgic", "lv", "lt", "mk", "ml", "mr", "mn-cyrl", "nb", "nn", "oc", "or", "pi", "pa", "pms", "pl", "pt", "ro", "rm", "ru", "sa", "sr-cyrl", "sh-cyrl", "sh-latn", "cu", "sk", "sl", "es", "sv", "ta", "te", "th", "tr", "tk", "uk", "hsb", "cy"] {
        if Language::try_from_code(code).is_some() { v.push(code.to_string()) }
    }
    v.sort();
    v
}
