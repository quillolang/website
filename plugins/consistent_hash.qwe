// Users spread over cache servers, and what moves when a server is added or taken away.
//
//   quillo run consistent_hash.qwe      then open http://localhost:8080/moves

use "consistent_hash.qwer"

let users = range(0, 1000) | map((i) => `user-${i}`)

route GET /server ? { key: str } = { server: hash_server(key, ["cache-a", "cache-b", "cache-c"]), copies: hash_servers(key, ["cache-a", "cache-b", "cache-c"], 2), shard: hash_shard(key, 16)? }

route GET /moves {
    let three = users | map((u) => hash_server(u, ["a", "b", "c"]))
    let four = users | map((u) => hash_server(u, ["a", "b", "c", "d"]))
    let moved = zip(three, four) | filter((p) => p[0] != p[1])
    let shards10 = users | map((u) => hash_shard(u, 10)?)
    let shards11 = users | map((u) => hash_shard(u, 11)?)
    {
        moved_adding_d: len(moved),
        all_went_to_d: all(moved, (p) => p[1] == "d"),
        shard_moves_10_to_11: len(zip(shards10, shards11) | filter((p) => p[0] != p[1])),
        weighted_big: len(users | filter((u) => hash_server_weighted(u, { big: 3.0, small: 1.0 }) == "big")),
    }
}
