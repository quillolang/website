//! Public-key encryption between two users (NaCl/libsodium crypto_box: X25519, XSalsa20-Poly1305): only the recipient can read it, and they know who sent it; plus anonymous sealed boxes.
//! version: 1.0.0
//!
//! [dependencies]
//! crypto_box = { version = "0.9", features = ["seal"] }
//! base64 = "0.22"

use base64::engine::general_purpose::STANDARD;
use base64::Engine;
use crypto_box::aead::{Aead, AeadCore, OsRng};
use crypto_box::{PublicKey, SalsaBox, SecretKey};
use std::collections::HashMap;

/// Messages up to 16 MiB are boxed.
const MAX: usize = 16 * 1024 * 1024;

fn key(text: &str, what: &str) -> Result<[u8; 32], String> {
    let b = STANDARD.decode(text.trim()).map_err(|_| format!("the {} key is not base64", what))?;
    b.try_into().map_err(|_| format!("the {} key is 32 bytes (44 base64 characters)", what))
}

fn pair(their_public: &str, my_secret: &str) -> Result<SalsaBox, String> {
    Ok(SalsaBox::new(&PublicKey::from(key(their_public, "public")?), &SecretKey::from(key(my_secret, "secret")?)))
}

fn text(bytes: Vec<u8>) -> Result<String, String> {
    String::from_utf8(bytes).map_err(|_| "the opened bytes are not text".to_string())
}

/// A new key pair: `{ secret, public }`, 32 bytes each as base64. Each user keeps their `secret` (on their device, ideally)
/// and publishes `public`.
pub fn cryptobox_keypair() -> HashMap<String, String> {
    let sk = SecretKey::generate(&mut OsRng);
    HashMap::from([("secret".into(), STANDARD.encode(sk.to_bytes())), ("public".into(), STANDARD.encode(sk.public_key().as_bytes()))])
}

/// `message` encrypted from the owner of `my_secret` to the owner of `their_public`: base64 of the 24-byte nonce, then the box
/// (libsodium's `crypto_box_easy` with the nonce in front). Only the recipient can open it, and opening it proves the sender.
pub fn cryptobox_encrypt(message: &str, their_public: &str, my_secret: &str) -> Result<String, String> {
    if message.len() > MAX {
        return Err("messages up to 16 MiB".into());
    }
    let b = pair(their_public, my_secret)?;
    let nonce = SalsaBox::generate_nonce(&mut OsRng);
    let mut out = nonce.to_vec();
    out.extend(b.encrypt(&nonce, message.as_bytes()).map_err(|_| "encryption failed".to_string())?);
    Ok(STANDARD.encode(out))
}

/// The message in a box from the owner of `their_public`, opened with `my_secret`; an error when it was not sent by them, not
/// for us, or changed.
pub fn cryptobox_decrypt(boxed: &str, their_public: &str, my_secret: &str) -> Result<String, String> {
    let data = STANDARD.decode(boxed.trim()).map_err(|_| "not base64".to_string())?;
    if data.len() < 24 + 16 {
        return Err("too short to be a box".into());
    }
    let (nonce, body) = data.split_at(24);
    let b = pair(their_public, my_secret)?;
    text(b.decrypt(nonce.into(), body).map_err(|_| "cannot open: another sender or recipient, or the box was changed".to_string())?)
}

/// `message` sealed to `their_public` by nobody in particular (libsodium's `crypto_box_seal`): a contact form or a tip line
/// whose server cannot read what it stores. The recipient cannot tell who sent it.
pub fn cryptobox_seal(message: &str, their_public: &str) -> Result<String, String> {
    if message.len() > MAX {
        return Err("messages up to 16 MiB".into());
    }
    let pk = PublicKey::from(key(their_public, "public")?);
    Ok(STANDARD.encode(pk.seal(&mut OsRng, message.as_bytes()).map_err(|_| "sealing failed".to_string())?))
}

/// A sealed box opened with the recipient's `my_secret`.
pub fn cryptobox_unseal(sealed: &str, my_secret: &str) -> Result<String, String> {
    let data = STANDARD.decode(sealed.trim()).map_err(|_| "not base64".to_string())?;
    let sk = SecretKey::from(key(my_secret, "secret")?);
    text(sk.unseal(&data).map_err(|_| "cannot open: not sealed to this key, or changed".to_string())?)
}
