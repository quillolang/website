//! Read raw emails (.eml, or what an inbound-mail webhook posts): sender, recipients, subject, date, the text and HTML bodies and the attachments, for support inboxes and replies by email.
//! version: 1.0.0
//!
//! [dependencies]
//! mail-parser = "0.9"

use mail_parser::{Address, MessageParser, MimeHeaders};
use serde_json::{json, Map, Value};

/// Emails up to 50 MB are read.
const MAX: usize = 50 * 1024 * 1024;

fn people(a: Option<&Address>) -> Vec<Value> {
    a.map(|a| a.iter().map(|p| json!({ "name": p.name(), "email": p.address() })).collect()).unwrap_or_default()
}

fn safe_name(name: &str, i: usize) -> String {
    let n: String = name.chars().map(|c| if c.is_alphanumeric() || ".-_ ".contains(c) { c } else { '_' }).collect();
    let n = n.trim().trim_start_matches('.').to_string();
    if n.is_empty() { format!("attachment-{}", i + 1) } else { n.chars().take(120).collect() }
}

fn parse(raw: &[u8]) -> Result<mail_parser::Message<'_>, String> {
    if raw.len() > MAX {
        return Err("emails up to 50 MB".into());
    }
    MessageParser::default().parse(raw).ok_or_else(|| "not an email".to_string())
}

/// An email read from its raw text: `{ subject, from, to, cc, reply_to, date, message_id, in_reply_to, text, html,
/// attachments, headers }`. `from` is `{ name, email }` (null when missing), `to`, `cc` and `reply_to` lists of them; `date`
/// is RFC 3339; `text` is the plain body and `html` the HTML one, each made from the other when the email has only one;
/// `attachments` are `{ name, type, size }`; `headers` the raw headers by lower-case name (the last of a repeated one).
/// Encoded words (`=?UTF-8?Q?...?=`), quoted-printable and base64 are decoded.
pub fn email_parse(raw: &str) -> Result<Value, String> {
    let m = parse(raw.as_bytes())?;
    let mut headers = Map::new();
    for (k, v) in m.headers_raw() {
        headers.insert(k.to_lowercase(), Value::String(v.trim().to_string()));
    }
    let attachments: Vec<Value> = m.attachments().map(|a| json!({
        "name": a.attachment_name(),
        "type": a.content_type().map(|c| format!("{}/{}", c.c_type, c.c_subtype.as_deref().unwrap_or("octet-stream"))),
        "size": a.contents().len(),
    })).collect();
    Ok(json!({
        "subject": m.subject(),
        "from": people(m.from()).into_iter().next(),
        "to": people(m.to()),
        "cc": people(m.cc()),
        "reply_to": people(m.reply_to()),
        "date": m.date().map(|d| d.to_rfc3339()),
        "message_id": m.message_id(),
        "in_reply_to": m.in_reply_to().as_text(),
        "text": m.body_text(0).map(|t| t.into_owned()),
        "html": m.body_html(0).map(|t| t.into_owned()),
        "attachments": attachments,
        "headers": headers,
    }))
}

/// An .eml file read as email_parse reads text.
pub fn email_parse_file(path: &str) -> Result<Value, String> {
    let size = std::fs::metadata(path).map_err(|e| format!("{}: {}", path, e))?.len();
    if size as usize > MAX {
        return Err(format!("{}: emails up to 50 MB", path));
    }
    email_parse(&String::from_utf8_lossy(&std::fs::read(path).map_err(|e| format!("{}: {}", path, e))?))
}

/// Saves an email's attachments into `folder` (made when missing), each under its own name with anything but letters,
/// digits, `.`, `-`, `_` and spaces replaced, so no name can leave the folder; gives `{ name, path, size }` for each.
/// A name used twice gets `-2`, `-3` before its extension.
pub fn email_save_attachments(raw: &str, folder: &str) -> Result<Vec<Value>, String> {
    let m = parse(raw.as_bytes())?;
    std::fs::create_dir_all(folder).map_err(|e| format!("{}: {}", folder, e))?;
    let mut out = vec![];
    let mut used = std::collections::HashSet::new();
    for (i, a) in m.attachments().enumerate().take(1000) {
        let base = safe_name(a.attachment_name().unwrap_or(""), i);
        let mut name = base.clone();
        let mut n = 2;
        while !used.insert(name.clone()) {
            name = match base.rsplit_once('.') {
                Some((stem, ext)) => format!("{}-{}.{}", stem, n, ext),
                None => format!("{}-{}", base, n),
            };
            n += 1;
        }
        let path = std::path::Path::new(folder).join(&name);
        std::fs::write(&path, a.contents()).map_err(|e| format!("{}: {}", path.display(), e))?;
        out.push(json!({ "name": name, "path": path.to_string_lossy(), "size": a.contents().len() }));
    }
    Ok(out)
}
