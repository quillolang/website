//! Dates and times typed in English read as times: "next friday at 3pm", "tomorrow 9am", "in 2 weeks", "3 days ago", "April 1 2027", for reminders and due dates.
//! version: 1.0.0
//!
//! [dependencies]
//! interim = { version = "0.1", features = ["chrono"] }
//! chrono = { version = "0.4", default-features = false, features = ["std", "clock"] }

use chrono::{DateTime, FixedOffset, TimeZone, Utc};
use interim::{parse_date_string, Dialect, Interval};
use serde_json::{json, Value};

fn base(now_ms: i64, utc_offset_minutes: i64) -> Result<DateTime<FixedOffset>, String> {
    let tz = FixedOffset::east_opt((utc_offset_minutes.clamp(-1080, 1080) * 60) as i32).ok_or("bad offset")?;
    let t = Utc.timestamp_millis_opt(now_ms).single().ok_or("now_ms is out of range")?;
    Ok(t.with_timezone(&tz))
}

fn dialect(d: &str) -> Dialect {
    if d.eq_ignore_ascii_case("us") { Dialect::Us } else { Dialect::Uk }
}

fn parse(text: &str, now_ms: i64, utc_offset_minutes: i64, d: &str) -> Result<DateTime<FixedOffset>, String> {
    if text.len() > 200 {
        return Err("up to 200 characters".into());
    }
    let mut t = text.trim().to_lowercase();
    // "at 3pm" and "in 2 weeks" are how people write them; the parser wants "3pm" and "2 weeks".
    t = t.replace(" at ", " ");
    if let Some(rest) = t.strip_prefix("in ") {
        t = rest.to_string();
    }
    parse_date_string(&t, base(now_ms, utc_offset_minutes)?, dialect(d)).map_err(|e| format!("{:?}: {}", text, e))
}

/// The time `text` means, in milliseconds since 1970, counted from `now_ms` (`now()`) in the user's time zone, `utc_offset_minutes` from UTC (-300 for New York in winter, 60 for Paris). `dialect` is "us" or "uk": "04/01/27" is April 1 in the US and 4 January in the UK, and "next friday" is this coming Friday in the US and the one after in the UK. A time with no hour is midnight.
pub fn dates_parse(text: &str, now_ms: i64, utc_offset_minutes: i64, dialect: &str) -> Result<i64, String> {
    Ok(parse(text, now_ms, utc_offset_minutes, dialect)?.timestamp_millis())
}

/// As `dates_parse`, the time as ISO 8601 text with the user's offset: "2026-11-06T15:00:00+01:00".
pub fn dates_parse_iso(text: &str, now_ms: i64, utc_offset_minutes: i64, dialect: &str) -> Result<String, String> {
    Ok(parse(text, now_ms, utc_offset_minutes, dialect)?.to_rfc3339())
}

/// A length of time typed in English: "2 weeks", "15m ago", "3 months", as `{ seconds, days, months }`, one of them set and the others 0 (months and days are not a fixed number of seconds). "ago" makes it negative.
pub fn dates_duration(text: &str) -> Result<Value, String> {
    let i = interim::parse_duration(&text.trim().to_lowercase()).map_err(|e| format!("{:?}: {}", text, e))?;
    Ok(match i {
        Interval::Seconds(s) => json!({ "seconds": s, "days": 0, "months": 0 }),
        Interval::Days(d) => json!({ "seconds": 0, "days": d, "months": 0 }),
        Interval::Months(m) => json!({ "seconds": 0, "days": 0, "months": m }),
    })
}
