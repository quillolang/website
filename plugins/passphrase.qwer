//! Diceware passphrases from the EFF word lists (`crane-shrunk-gristle-unwind-pacific`): easy to type and remember, hard to guess, for first passwords, Wi-Fi keys and recovery phrases.
//! version: 1.0.0
//!
//! [dependencies]
//! diceware_wordlists = "1.2"
//! rand = "0.8"

use diceware_wordlists::Wordlist;
use rand::seq::SliceRandom;
use rand::Rng;
use serde_json::{json, Value};

fn list(name: &str) -> Result<&'static [&'static str], String> {
    match name {
        "" | "long" => Ok(Wordlist::EffLong.get_list()),
        "short" => Ok(Wordlist::EffShort1.get_list()),
        "memorable" => Ok(Wordlist::EffShort2.get_list()),
        other => Err(format!("unknown list `{}`: long (7,776 words), short (1,296 short words) or memorable (1,296 words with unique 3-letter starts)", other)),
    }
}

fn make(words: i64, separator: &str, list_name: &str, capitalize: bool, digit: bool) -> Result<Value, String> {
    let l = list(list_name)?;
    let n = words.clamp(3, 20) as usize;
    let mut rng = rand::rngs::OsRng;
    let mut picked: Vec<String> = (0..n).map(|_| l.choose(&mut rng).copied().unwrap_or("word").to_string()).collect();
    if capitalize {
        for w in picked.iter_mut() {
            let mut c = w.chars();
            *w = c.next().map(|f| f.to_uppercase().collect::<String>() + c.as_str()).unwrap_or_default();
        }
    }
    let mut bits = n as f64 * (l.len() as f64).log2();
    if digit {
        let at = rng.gen_range(0..n);
        picked[at].push_str(&rng.gen_range(0..10).to_string());
        bits += 10f64.log2() + (n as f64).log2();
    }
    let sep: String = separator.chars().take(3).collect();
    Ok(json!({ "passphrase": picked.join(&sep), "words": n, "bits": (bits * 10.0).round() / 10.0 }))
}

/// A passphrase of `words` words (3 to 20) from the EFF long list, joined by `separator` ("-", " ", "." ...; up to 3
/// characters). Each word adds 12.9 bits: 5 words, 64.6 bits; 6 words, 77.5. Picked with the system's secure random numbers.
pub fn passphrase(words: i64, separator: &str) -> Result<String, String> {
    Ok(make(words, separator, "long", false, false)?["passphrase"].as_str().unwrap_or_default().to_string())
}

/// A passphrase with choices: `list` "long", "short" or "memorable"; `capitalize` each word; `digit` adds one digit to one
/// word, for sites that ask for one. Gives `{ passphrase, words, bits }`, `bits` being its strength when the guesser knows
/// the list and the rules.
pub fn passphrase_with(words: i64, separator: &str, list_name: &str, capitalize: bool, digit: bool) -> Result<Value, String> {
    make(words, separator, list_name, capitalize, digit)
}

/// The strength in bits of `words` words from `list` ("long", "short" or "memorable").
pub fn passphrase_bits(words: i64, list_name: &str) -> Result<f64, String> {
    Ok(((words.max(0) as f64 * (list(list_name)?.len() as f64).log2()) * 10.0).round() / 10.0)
}
