// A food supplier's EDIFACT desk: a supermarket's ORDERS read, CONTRL sent back, and the INVOIC built and checked.
//
//   quillo run edifact.qwe      then open http://localhost:8080/order

use "edifact.qwer"

let EDI = read_file("edifact_sample.edi")

route GET /order {
    let o = edifact_documents(EDI)?[0]
    {
        type: o.type, version: o.version, number: o.number, date: o.date, deliver_by: o.dates["2"], currency: o.currency,
        deliver_to: (o.parties | filter((p) => p.role == "DP"))[0],
        lines: o.lines | map((l) => { gtin: l.item, sku: l.ids.SA, description: l.description, qty: l.qty, price: l.price, amount: l.amount }),
        total: o.totals["79"],
        problems: edifact_parse(EDI)?.problems,
    }
}

route GET /contrl.edi = respond(200, edifact_contrl(EDI, "CTL0007")?, { "content-type": "text/plain" })

// The invoice for the order, built from it and read back.
route GET /invoice {
    let o = edifact_documents(EDI)?[0]
    let lines = o.lines | map((l) => [
        ["LIN", l.line, null, [l.item, "EN"]],
        ["QTY", ["47", l.qty, "PCE"]],
        ["PRI", ["AAA", l.price]],
        ["MOA", ["203", l.amount]],
    ]) | flatten
    let segments = [
        ["BGM", "380", "INV-2026-0815", "9"],
        ["DTM", ["137", "20261030", "102"]],
        ["RFF", ["ON", o.number]],
        ["NAD", "SU", ["4012345000009", null, "9"], null, "Quillo Foods GmbH"],
        ["NAD", "BY", ["5412345000013", null, "9"], null, "Mercado Fresco S.A."],
        ["CUX", ["2", "EUR", "9"]],
    ] + lines + [["UNS", "S"], ["MOA", ["77", "1323.00"]], ["MOA", ["124", "277.83"]]]
    let text = edifact_build({ sender: "4012345000009", sender_qualifier: "14", recipient: "5412345000013", recipient_qualifier: "14", control: "INV0815", date: "20261030", time: "1015" }, [{ type: "INVOIC:D:96A:UN:EAN008", segments: segments }])?
    let back = edifact_parse(text)?
    { text: text, problems: back.problems, order: back.messages[0].refs.ON, to_pay: back.messages[0].totals["77"], lines: len(back.messages[0].lines) }
}
