// The morning's bank statement in BAI2: balances per account, transactions as rows for matching
// to invoices, what a type code means, and what a total that does not add up looks like.
//
//   quillo run bai2.qwe      then open http://localhost:8080/statement, /rows, /type/475 and /tampered
//
// bai2_sample.txt is synthetic, from no bank. Totals in a BAI2 file are checked on reading: an
// account's 49 against its balances and transactions, a group's 98 and the file's 99 against those.

use "bai2.qwer"

let TEXT = read_file("bai2_sample.txt")

route GET /statement {
    let f = bai2_read_file("bai2_sample.txt")?
    let g = f.groups[0]
    {
        sender: f.sender, as_of: g.as_of_date, control_total: f.control_total,
        accounts: g.accounts | map((a) => {
            account: a.account, currency: a.currency, opening: a.opening_ledger, closing: a.closing_ledger, available: a.closing_available,
            credits: a.credits, debits: a.debits, count: len(a.transactions),
        }),
    }
}

route GET /rows = bai2_transactions(TEXT)? | map((t) => { code: t.code, name: t.name, signed: t.signed, ref: t.customer_ref, text: t.text })

route GET /funds {
    let t = bai2_parse(TEXT)?.groups[0].accounts[0].transactions
    { value_dated: t[0].funds, distributed: t[1].funds, by_days: t[2].funds, line: t[0].line }
}

route GET /type/:code(int) = bai2_type(code)

// A dollar taken off a transaction, and a file cut short: the reader says where.
route GET /tampered {
    let bad = replace(TEXT, "16,475,100000,", "16,475,99900,")
    {
        first: bai2_parse(bad).error,
        all: bai2_check(bad).problems,
        cut: bai2_check(slice(TEXT, 0, 300)).problems,
        continued: bai2_check(TEXT).ok,
    }
}
