// A line of machines run by an Allen-Bradley PLC: the controller identified, tags read by name,
// a recipe's array read in fragments, several tags read in one packet, setpoints written, a
// connected session with Forward Open, and what the PLC says when a tag does not exist.
//
//   EIP_HOST=192.168.1.10 EIP_SLOT=0 quillo run ethernet_ip.qwe      then open http://localhost:8080/line
//
// Tags here: Motor_Speed (REAL), Line_Count (DINT), Running (BOOL), Batch (STRING),
// Recipe (DINT[300]), Program:Main.Valve[3] and so on. Micro800 controllers have no backplane:
// connect with { route: false }.

use "ethernet_ip.qwer"

let HOST = env("EIP_HOST", "127.0.0.1")
let SLOT = int(env("EIP_SLOT", "0"))
let session = null

fn plc() {
    if !session { session = eip_connect("plc", HOST, { slot: SLOT, timeout_ms: 1500 })? }
    session
}

route GET /who = eip_list_identity(HOST, { timeout_ms: 1500 })?

route GET /line {
    plc()
    {
        speed: eip_read("plc", "Motor_Speed", {})?,
        count: eip_read("plc", "Line_Count", {})?.value,
        running: eip_read("plc", "Running", {})?.value,
        batch: eip_read("plc", "Batch", {})?,
        valve: eip_read("plc", "Program:Main.Valve[3]", {})?.value,
        member: eip_read("plc", "Oven.Zones[1,2].Temp", {})?.value,
    }
}

route GET /recipe {
    plc()
    let some = eip_read("plc", "Recipe[10]", { count: 3 })?
    let all = eip_read("plc", "Recipe", { count: 300 })?
    { some: some.value, length: len(all.value), last: all.value[299], kind: all.type }
}

route GET /many {
    plc()
    eip_read_many("plc", ["Motor_Speed", "Line_Count", "No_Such_Tag", "Running"])?
}

route GET /write {
    plc()
    let wrote = eip_write("plc", "Motor_Speed", 1500.5, { type: "REAL" })?
    eip_write("plc", "Line_Count", 42, {})?
    eip_write("plc", "Running", true, {})?
    eip_write("plc", "Batch", "B-2026-11", {})?
    eip_write("plc", "Recipe[20]", [7, 8, 9], { type: "DINT" })?
    {
        wrote: wrote,
        speed: eip_read("plc", "Motor_Speed", {})?.value,
        count: eip_read("plc", "Line_Count", {})?.value,
        batch: eip_read("plc", "Batch", {})?.value,
        recipe: eip_read("plc", "Recipe[20]", { count: 3 })?.value,
    }
}

// The same reads over a connection: Forward Open, then SendUnitData, then Forward Close.
route GET /connected {
    let c = eip_connect("fast", HOST, { slot: SLOT, connected: true, timeout_ms: 1500 })?
    let speed = eip_read("fast", "Line_Count", {})?.value
    { connected: c.connected, has_id: c.connection != null, value: speed, closed: eip_close("fast")? }
}

route GET /refused {
    plc()
    {
        no_tag: eip_read("plc", "No_Such_Tag", {}).error,
        wrong_type: eip_write("plc", "Line_Count", 1.5, { type: "REAL" }).error,
        too_far: eip_read("plc", "Recipe[299]", { count: 5 }).error,
        big_value: eip_write("plc", "Line_Count", 5000000000, { type: "DINT" }).error,
        locked: eip_write("plc", "Safety_Stop", true, { type: "BOOL" }).error,
        bit: eip_read("plc", "Line_Count.3", {}).error,
        name: eip_read("plc", "Bad Name", {}).error,
        slot: eip_connect("wrong", HOST, { slot: 9, connected: true, timeout_ms: 500 }).error,
        offline: eip_connect("gone", "127.0.0.1:1", { timeout_ms: 300 }).error,
        not_open: eip_read("nobody", "X", {}).error,
    }
}

route GET /paths = {
    simple: eip_tag_path("Speed")?,
    odd: eip_tag_path("Pump")?,
    indexed: eip_tag_path("Recipe[3]")?,
    wide: eip_tag_path("Log[1000]")?,
    two: eip_tag_path("Grid[1,70000]")?,
    member: eip_tag_path("Motor.Amps")?,
}
