//! Offensive words found and masked in comments, usernames and chat, English, l33t tricks (sh1t, f.u.c.k) and spacing included.
//! version: 1.0.0
//!
//! [dependencies]
//! rustrict = { version = "0.7", default-features = false, features = ["censor"] }

use rustrict::{Censor, Type};
use serde_json::{json, Value};

const MAX: usize = 200_000;

fn level(t: Type, kind: Type) -> &'static str {
    if t.is(kind & Type::SEVERE) { "severe" } else if t.is(kind & Type::MODERATE) { "moderate" } else if t.is(kind & Type::MILD) { "mild" } else { "none" }
}

fn threshold(strictness: &str) -> Result<Type, String> {
    match strictness {
        "" | "moderate" => Ok(Type::INAPPROPRIATE & Type::MODERATE_OR_HIGHER),
        "mild" => Ok(Type::INAPPROPRIATE),
        "severe" => Ok(Type::INAPPROPRIATE & Type::SEVERE),
        o => Err(format!("strictness is \"mild\", \"moderate\" or \"severe\", not {:?}", o)),
    }
}

/// Whether `text` holds profane, offensive or sexual words: moderate ones or worse, so "damn" passes and slurs do not. Text up to 200 KB.
pub fn profanity_found(text: &str) -> Result<bool, String> {
    if text.len() > MAX {
        return Err("text up to 200 KB".into());
    }
    Ok(Censor::from_str(text).analyze().is(threshold("")?))
}

/// `text` with offending words masked by `*`, most keeping their first letter ("f***"). `strictness` is "mild" (mask even "damn"), "moderate" or "severe" (mask only the worst).
pub fn profanity_mask(text: &str, strictness: &str) -> Result<String, String> {
    if text.len() > MAX {
        return Err("text up to 200 KB".into());
    }
    Ok(Censor::from_str(text).with_censor_threshold(threshold(strictness)?).censor())
}

/// How bad `text` is, for moderation queues: `{ inappropriate, profane, offensive, sexual, mean, evasive, spam }`, each but the first "none", "mild", "moderate" or "severe". `evasive` means words disguised to get past filters.
pub fn profanity_analyze(text: &str) -> Result<Value, String> {
    if text.len() > MAX {
        return Err("text up to 200 KB".into());
    }
    let t = Censor::from_str(text).analyze();
    Ok(json!({
        "inappropriate": t.is(threshold("")?),
        "profane": level(t, Type::PROFANE),
        "offensive": level(t, Type::OFFENSIVE),
        "sexual": level(t, Type::SEXUAL),
        "mean": level(t, Type::MEAN),
        "evasive": level(t, Type::EVASIVE),
        "spam": level(t, Type::SPAM),
    }))
}
