// An international events site: each event's date in the calendars its guests keep, Japanese era dates for forms, and the Jewish holidays to plan around.
//
//   quillo run world_calendars.qwe      then open http://localhost:8080/dates

use "world_calendars.qwer"

let DAY = "2026-10-29"

route GET /dates {
    {
        hebrew: calendars_convert(DAY, "hebrew")?,
        persian: calendars_convert(DAY, "persian")?.text,
        ethiopian: calendars_convert(DAY, "ethiopian")?.text,
        coptic: calendars_convert(DAY, "coptic")?.text,
        indian: calendars_convert(DAY, "indian")?.text,
        thai: calendars_convert(DAY, "buddhist")?.text,
        japanese: calendars_convert(DAY, "japanese")?.text,
        taiwan: calendars_convert(DAY, "roc")?.text,
        nowruz_1405: calendars_to_gregorian("persian", 1405, "Farvardin", 1)?,
        heisei_start: calendars_to_gregorian("japanese:heisei", 1, "1", 8)?,
        enkutatash: calendars_to_gregorian("ethiopian", 2019, "Meskerem", 1)?,
        not_a_month: calendars_to_gregorian("hebrew", 5787, "Smarch", 1).error,
    }
}

route GET /jewish-holidays/:year(int) = calendars_jewish_holidays(year)?
