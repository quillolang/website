// A radiology file on its way to a research share: what it holds, its identifying data taken out,
// and its image as a PNG. dicom_sample.dcm and dicom_sample_implicit.dcm are synthetic: a 16 by
// 16 ramp and made-up people, written from the standard's rules by a script.
//
//   quillo run dicom.qwe      then open http://localhost:8080/summary, /tags, /strip, /image.png, /window and /refused

use "dicom.qwer"

let SAMPLE = "dicom_sample.dcm"
let IMPLICIT = "dicom_sample_implicit.dcm"
let CLEAN = ".quillo/dicom_stripped.dcm"

route GET /summary = dicom_summary(SAMPLE)?

route GET /tags = {
    name: dicom_tag(SAMPLE, "PatientName")?,
    by_number: dicom_tag(SAMPLE, "(0010,0020)")?,
    spacing: dicom_tag(SAMPLE, "PixelSpacing")?,
    image_type: dicom_tag(SAMPLE, "ImageType")?,
    nested: dicom_tag(SAMPLE, "ReferencedImageSequence")?,
    sequence: dicom_tag(SAMPLE, "RequestAttributesSequence")?,
    pixels: dicom_tag(SAMPLE, "PixelData")?,
    private_tag: dicom_tag(SAMPLE, "(0029,1001)")?,
    absent: dicom_tag(SAMPLE, "PatientWeight")?,
    implicit_reads_alike: dicom_tags(IMPLICIT)?.PatientName == dicom_tags(SAMPLE)?.PatientName,
    implicit: dicom_summary(IMPLICIT)?.transfer_syntax.name,
    header: slice(dicom_elements(SAMPLE)?, 0, 2),
}

route GET /strip {
    let done = dicom_strip_phi(SAMPLE, CLEAN, { salt: "project-7", patient_id: "RESEARCH-001", keep: ["StudyDate"] })?
    let t = dicom_tags(CLEAN)?
    let before = dicom_summary(SAMPLE)?
    let after = dicom_summary(CLEAN)?
    {
        done: done,
        name: t.PatientName.text, id: t.PatientID, kept_date: t.StudyDate, birth: t.PatientBirthDate,
        gone: [t.PatientAddress, t.InstitutionName, t.DeviceSerialNumber, t.PatientComments, t["(0029,1001)"]],
        nested: t.RequestAttributesSequence,
        identity_removed: t.PatientIdentityRemoved,
        new_uid: after.study.uid != before.study.uid,
        uid_prefix: slice(after.study.uid, 0, 5),
        same_again: dicom_strip_phi(SAMPLE, CLEAN + "2", { salt: "project-7" }).uids == done.uids,
        still_reads: after.image.rows,
        same_image: dicom_png(CLEAN, ".quillo/dicom_stripped.png", {})?.highest == dicom_png(SAMPLE, ".quillo/dicom_sample.png", {})?.highest,
    }
}

route GET /image.png {
    dicom_png(SAMPLE, ".quillo/dicom_view.png", {})?
    file(".quillo/dicom_view.png")
}

route GET /window = {
    file_window: dicom_png(SAMPLE, ".quillo/dicom_w.png", {})?,
    narrow: dicom_png(SAMPLE, ".quillo/dicom_w.png", { window_center: 1000.0, window_width: 400.0 })?.window_width,
    bad_frame: dicom_png(SAMPLE, ".quillo/dicom_w.png", { frame: 3 }).error,
    bad_width: dicom_png(SAMPLE, ".quillo/dicom_w.png", { window_width: 0.0 }).error,
}

route GET /refused = {
    missing: dicom_summary("no-such.dcm").error != null,
    not_dicom: dicom_summary("dicom.qwe").error,
    unknown_tag: dicom_tag(SAMPLE, "ShoeSize").error,
}
