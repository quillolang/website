// A nightly export of orders packed with bzip2, a look at its first lines without unpacking it, and text both ways.
//
//   quillo run bzip2.qwe      then open http://localhost:8080/pack

use "bzip2.qwer"

route GET /pack {
    let rows = for i in range(3000) => `${1000 + i},customer ${i % 50},${i % 90}.50,${["paid", "open", "refunded"][i % 3]}`
    write_file("data/orders.csv", "id,customer,total,status\n" + join(rows, "\n"))
    let size = bzip2_file("data/orders.csv", "data/orders.csv.bz2", 9)?
    let packed = bzip2_text("hello, hello, hello", 9)?
    {
        csv_bytes: len(read_file("data/orders.csv")),
        bz2_bytes: size,
        unpacked_bytes: bunzip2_file("data/orders.csv.bz2", "data/orders.copy.csv")?,
        first: bzip2_head("data/orders.csv.bz2", 3)?,
        back: bunzip2_text(packed)?,
    }
}
