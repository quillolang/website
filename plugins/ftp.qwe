// A supplier's FTP server, as many partners still run one: the morning's orders listed and read,
// an invoice uploaded, filed into a dated folder and checked, a local file sent as it is, and a
// wrong password. Over FTPS (AUTH TLS), with data connections in passive mode.
//
//   FTP_URL=ftpes://partner:secret@ftp.supplier.example/ quillo run ftp.qwe      then open http://localhost:8080/orders
//
// Needs an FTP server at FTP_URL: ftpes:// upgrades with AUTH TLS, ftps:// is TLS from the start,
// ftp:// is plain (allowed for this machine only, unless allow_plain_password). FTP_CA is a CA's
// PEM for a server with a private certificate.

use "ftp.qwer"

let URL = env("FTP_URL", "ftpes://partner:secret@127.0.0.1/")
let OPTS = { ca: env("FTP_CA", ""), timeout_ms: 5000 }

route GET /orders {
    let files = ftp_list(URL, "/outbox", OPTS)?
    let csv = ftp_get_text(URL, "/outbox/" + files[0].name, OPTS)?
    { files: map(files, (f) => { name: f.name, size: f.size, modified: f.modified }), lines: len(split(trim(csv), "\n")) - 1, first: split(csv, "\n")[1] }
}

route GET /invoice {
    let sent = ftp_put_text(URL, "/inbox/INV-2207.csv", "invoice,amount,currency\nINV-2207,1250.00,EUR\n", OPTS)?
    ftp_mkdir(URL, "/inbox/2026/10", { parents: true, ca: OPTS.ca })?
    ftp_rename(URL, "/inbox/INV-2207.csv", "/inbox/2026/10/INV-2207.csv", OPTS)?
    {
        sent,
        filed: map(ftp_list(URL, "/inbox/2026/10", OPTS)?, (f) => f.name),
        back: ftp_get_text(URL, "/inbox/2026/10/INV-2207.csv", OPTS)?,
        inbox: map(ftp_list(URL, "/inbox", OPTS)?, (f) => `${f.name} (${f.type})`),
    }
}

// A file from disk, sent as it is (this program's own source here).
route GET /upload {
    let sent = ftp_upload(URL, "/inbox/ftp.qwe", "ftp.qwe", OPTS)?
    let there = filter(ftp_list(URL, "/inbox", OPTS)?, (f) => f.name == "ftp.qwe")
    ftp_delete(URL, "/inbox/ftp.qwe", OPTS)?
    { sent, size_there: there[0].size, after_delete: len(filter(ftp_list(URL, "/inbox", OPTS)?, (f) => f.name == "ftp.qwe")) }
}

// The orders saved to a local file: FTP_SAVE_TO=orders.csv
route GET /save {
    let to = env("FTP_SAVE_TO", null) ?? reply 503 "set FTP_SAVE_TO to the local file to write"
    ftp_download(URL, "/outbox/orders-2026-10-30.csv", to, OPTS)?
}

route GET /session = ftp_info(URL, OPTS)?

route GET /wrong = { error: ftp_list(replace(URL, "s3cret", "guess"), "/", OPTS).error }
