// A web server's configuration looked at from a program: read with its includes, the sites it
// serves, which block a request lands in, the usual mistakes, and the file written back.
//
//   quillo run nginx_conf.qwe      then open http://localhost:8080/load, /servers, /match, /lint, /print, /flat and /broken

use "nginx_conf.qwer"

route GET /load {
    let c = nginx_conf_load("nginx_conf_sample.conf")?
    let http = c.tree | filter((n) => n.directive == "http")
    {
        files: c.files, problems: c.problems, top: c.tree | map((n) => n.directive ?? "#"),
        in_http: http[0].block | map((n) => n.directive),
        from: http[0].block[len(http[0].block) - 1].file,
    }
}

route GET /servers {
    let c = nginx_conf_load("nginx_conf_sample.conf")?
    let s = nginx_conf_servers(c.tree)?
    {
        names: s.servers | map((x) => [x.names, x.listen | map((l) => l.port), x.tls]),
        locations: s.servers[0].locations | map((l) => [l.kind, l.path, l.proxy_pass ?? l.alias ?? l.return]),
        upstream: s.upstreams[0],
    }
}

route GET /match {
    let tree = nginx_conf_load("nginx_conf_sample.conf")?.tree
    {
        exact: nginx_conf_match(tree, 8443, "shop.example", "/health")?,
        api: nginx_conf_match(tree, 8443, "SHOP.example", "/api/users/1")?,
        stop: nginx_conf_match(tree, 8443, "shop.example", "/images/a.gif")?,
        wild: nginx_conf_match(tree, 8080, "eu.shop.example", "/")?.server,
        fallback: nginx_conf_match(tree, 8080, "other.example", "/")?,
        no_port: nginx_conf_match(tree, 9999, "x", "/").error,
    }
}

route GET /lint = nginx_conf_lint(nginx_conf_load("nginx_conf_sample.conf")?.tree)? | map((x) => `${x.line} ${x.rule}: ${x.message}`)

let TEXT = join([
    "# site",
    "server{listen 80;server_name a.example;",
    "  location ~ \"^/x{3}$\" { return 200 'say \"hi\"'; }",
    "  rewrite ^/a\\.b$ /c last; # trailing note",
    "  set $v \"tab\\there\";",
    "  location / { root /var/${host}/x; }",
    "}",
    "",
], "\n")

route GET /print {
    let tree = nginx_conf_parse(TEXT)?
    let out = nginx_conf_print(tree)?
    {
        out: out,
        args: [tree[1].block[2].args, tree[1].block[3].args, tree[1].block[5].args],
        again: nginx_conf_print(nginx_conf_parse(out)?)? == out,
        lines: [tree[0].line, tree[1].line, tree[1].block[2].line],
    }
}

// The whole configuration in one file, includes in place, for a look or for `nginx -t`.
route GET /flat = respond(200, nginx_conf_print(nginx_conf_load("nginx_conf_sample.conf")?.tree)?, { "content-type": "text/plain" })

route GET /broken = {
    open: nginx_conf_parse("server {").error,
    close: nginx_conf_parse("a b;\n}\n").error,
    semi: nginx_conf_parse("listen 80").error,
    quote: nginx_conf_parse("a \"b;\n").error,
    after: nginx_conf_parse("a \"b\"c;").error,
    empty: nginx_conf_parse(";").error,
    no_file: nginx_conf_load("nothing.conf").error,
    bad_node: nginx_conf_print([{ args: ["x"] }]).error,
}
