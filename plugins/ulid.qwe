// Orders keyed by ULIDs: newest first is simply the ids in reverse.
//
//   quillo run ulid.qwe      then open http://localhost:8080/ids

use "ulid.qwer"

route GET /ids {
    let a = ulid()
    let old = ulid_at(1767225600000)        // 2026-01-01
    { new: a, made_ms: ulid_time(a)?, old, old_ms: ulid_time(old)?, sorted: sort([a, old]) == [old, a], valid: ulid_valid(a) }
}
