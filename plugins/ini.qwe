// Settings imported from an old app's .ini file, and written back with a change.
//
//   quillo run ini.qwe      then open http://localhost:8080/settings

use "ini.qwer"

route GET /settings {
    let s = ini_read_file("ini_sample.ini")?
    { app: s.app_name, debug: s.debug == "true", db: `postgres://${s.database.host}:${int(s.database.port)?}/${s.database.name}`, from: s.mail.from, uploads: s.paths.uploads }
}

route GET /updated.ini {
    let s = ini_read_file("ini_sample.ini")?
    respond(200, ini_write({ ...s, debug: true, database: { ...s.database, host: "db2.internal" } })?, { "content-type": "text/plain; charset=utf-8" })
}
