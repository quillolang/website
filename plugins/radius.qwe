// Signing in to a factory's Wi-Fi and its line terminals through RADIUS: a user checked
// with PAP and with CHAP (the session's timeout, address and vendor attributes read from
// the answer), a refused one, a one-time code asked for by a challenge, a session's
// accounting from start to stop, and a small RADIUS server of this program's own, written
// with udp.listen, for the terminals on the line.
//
// It needs a RADIUS server: RADIUS_SERVER and RADIUS_ACCT (host:port), RADIUS_SECRET.
//
//   RADIUS_SERVER=10.0.0.9 RADIUS_ACCT=10.0.0.9:1813 RADIUS_SECRET=... quillo run radius.qwe      then open http://localhost:8080/login

use "radius.qwer"

let SERVER = env("RADIUS_SERVER", "127.0.0.1")
let ACCT = env("RADIUS_ACCT", "127.0.0.1:1813")
let SECRET = env("RADIUS_SECRET", "testing123")
let AP = { nas_identifier: "ap-hall-2", attributes: { "NAS-Port-Type": "Wireless-802.11", "Called-Station-Id": "00-1A-2B-3C-4D-5E:Factory", "Calling-Station-Id": "3C-7C-3F-01-02-03" } }

route GET /login {
    let pap = radius_auth(SERVER, SECRET, "alice", "wonderland", AP)?
    let chap = radius_auth(SERVER, SECRET, "alice", "wonderland", AP + { method: "chap" })?
    {
        accepted: pap.accepted, message: pap.reply_message, chap_accepted: chap.accepted,
        session_timeout: pap.attributes["Session-Timeout"], address: pap.attributes["Framed-IP-Address"],
        service: pap.attributes["Service-Type"], rate_limit: pap.attributes["Mikrotik-Rate-Limit"], cisco: pap.attributes["Cisco-AVPair"],
    }
}

route GET /refused = {
    bob: radius_auth(SERVER, SECRET, "bob", "builder", AP)?,
    wrong_secret: radius_auth(SERVER, "not-the-secret", "alice", "wonderland", { timeout_ms: 300, retries: 0 }).error,
}

// A one-time code: the server answers a challenge, and the code goes back with its State.
route GET /challenge {
    let first = radius_auth(SERVER, SECRET, "carol", "carolpass", AP)?
    let second = radius_auth(SERVER, SECRET, "carol", "424242", AP + { state: first.state })?
    { asked: first.challenge, prompt: first.reply_message, then: second.code, message: second.reply_message }
}

// A session from start to stop, as an access point reports it.
route GET /accounting {
    let id = `hall2-${now()}`
    let base = { session_id: id, user: "alice", nas_identifier: "ap-hall-2" }
    {
        start: radius_accounting(ACCT, SECRET, "start", base + { attributes: { "Framed-IP-Address": "10.20.0.15" } })?.ok,
        interim: radius_accounting(ACCT, SECRET, "interim", base + { attributes: { "Acct-Session-Time": 600, "Acct-Input-Octets": 1048576 } })?.ok,
        stop: radius_accounting(ACCT, SECRET, "stop", base + { attributes: { "Acct-Session-Time": 1800, "Acct-Terminate-Cause": "User-Request" } })?.status,
        server_up: radius_status(SERVER, SECRET, {})?.ok,
    }
}

// This program's own RADIUS server for the line's terminals: operators by badge number.
let operators = { "op-1042": { pin: "7351", role: "operator" }, "op-2001": { pin: "1999", role: "maintenance" } }
let LOCAL_SECRET = "line-3-terminals"
let logins = []
udp.listen(int(env("RADIUS_LISTEN_PORT", "18120")), (p) => {
    let req = radius_parse(p.bytes, LOCAL_SECRET)
    if !req || req.code != "Access-Request" || req.message_authenticator != true { return null }
    let who = operators[req.user ?? ""]
    let ok = who != null && radius_password_ok(p.bytes, LOCAL_SECRET, who.pin) == true
    logins = logins + [{ user: req.user, ok: ok }]
    udp.reply(p, ok
        ? radius_reply(p.bytes, LOCAL_SECRET, "Access-Accept", { "Reply-Message": `Hello, ${who.role}`, "Filter-Id": who.role, "Session-Timeout": 28800 })
        : radius_reply(p.bytes, LOCAL_SECRET, "Access-Reject", { "Reply-Message": "Unknown badge or PIN" }))
})

route GET /own {
    let me = `127.0.0.1:${env("RADIUS_LISTEN_PORT", "18120")}`
    let a = radius_auth(me, LOCAL_SECRET, "op-1042", "7351", { method: "chap" })?
    let b = radius_auth(me, LOCAL_SECRET, "op-2001", "0000", {})?
    { first: [a.code, a.reply_message, a.attributes["Filter-Id"]], second: [b.code, b.reply_message], logins: logins }
}
