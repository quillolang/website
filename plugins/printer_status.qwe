// A dashboard of a warehouse's printers: each asked how it is in its own language (a Zebra
// label printer, an HP laser printer, a TSC printer), with one answer each; replies from a
// receipt printer and a Brother QL read as they come; and the SNMP question for toner levels.
//
//   PRINTER_HOST=192.168.1.60 quillo run printer_status.qwe      then open http://localhost:8080/status
//   quillo run printer_status.qwe      and http://localhost:8080/replies

use "printer_status.qwer"

route GET /status {
    let host = env("PRINTER_HOST", null) ?? reply 503 "set PRINTER_HOST to the printer's address (host or host:port)"
    {
        zebra: printer_status("zebra", host, 2000)?,
        laser: printer_status("pjl", host, 2000)?.state,
        tsc: printer_status("tspl", host, 2000)?.ready,
    }
}

// Answers as printers send them (in base64): a Zebra out of paper with its head open, a receipt
// printer at the end of its roll, a Brother QL with its cover open.
route GET /replies = {
    zebra: printer_status_read("zebra", "AjAzMCwxLDAsMTI0NSwwMDAsMCwwLDAsMDAwLDAsMCwwAw0KAjAwMCwwLDEsMSwwLDIsNCwwLDAwMDAwMDAwLDEsMDAwAw0KAjEyMzQsMAMNCg==")?,
    receipt: printer_status_read("escpos", "FhISfg==")?.state,
    brother: printer_status_read("brother", "gCBCNEEAAAAAED5KAAAAAAAAAAAAAAAAAAAAAAAAAAA=")?.problems,
    snmp_request: printer_snmp_request("public", "1.3.6.1.2.1.43.11.1.1.9", 1001)?,
}

// A real printer's toner: PRINTER_SNMP=192.168.1.70 quillo run printer_status.qwe
route GET /toner {
    let host = env("PRINTER_SNMP", null) ?? reply 503 "set PRINTER_SNMP to a printer's address"
    printer_snmp(host, "public", 2000)?
}
