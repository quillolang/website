// A cheque's amount in words, an invoice total in French, and chapter numbers in Roman numerals.
//
//   quillo run number_words.qwe      then open http://localhost:8080/cheque?amount=1112.50

use "number_words.qwer"

route GET /cheque ? { amount: str, currency: str = "USD" } = { amount, words: number_money_words(amount, currency, "en")? }

route GET /words = {
    plain: number_words(112, "en")?,
    french: number_words(1999, "fr")?,
    belgian: number_words(70, "fr_BE")?,
    euros: number_money_words(42.3, "EUR", "fr")?,
    place: number_ordinal_words(21, "en")?,
    year: number_year_words(2026, "en")?,
}

route GET /chapters = [1, 4, 9, 14, 2026] | map((n) => { n, roman: number_roman(n)?, back: number_from_roman(number_roman(n)?)? })
