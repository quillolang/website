// A team page with an initials avatar for everyone who has not uploaded a photo.
//
//   quillo run avatar_initials.qwe      then open http://localhost:8080/

use "avatar_initials.qwer"

let team = ["Ada Lovelace", "grace hopper", "Jean-Luc Picard", "alan.turing@example.com", "Edsger"]

route GET /avatar/:name = respond(200, avatar_svg(name, 64, null), { "content-type": "image/svg+xml", "cache-control": "max-age=86400" })

route GET / = <html><body style="font-family: sans-serif">
    {for n in team => <div style="display: flex; gap: 8px; align-items: center; margin: 4px">{raw(avatar_svg(n, 40, { shape: "rounded" }))} {n}</div>}
</body></html>

route GET /initials = team | map((n) => { name: n, initials: avatar_initials(n), color: avatar_color(n) })
