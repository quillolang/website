// Servers on Hetzner Cloud: one made and waited for through every action it starts, powered off,
// a volume made, attached and grown, a firewall with its rules applied, lists read past a page, and
// the rate-limit headers.
//
//   HETZNER_API_TOKEN=... quillo run hetzner.qwe      then open http://localhost:8080/servers, /volumes, /firewall and /failures
//
// These routes spend money on a real project. HETZNER_API_URL reaches a test server.

use "hetzner.qwer"

let WAIT = { wait: true, every_ms: 50 }

route GET /servers {
    let made = hetzner_server_create({ name: "web-1", server_type: "cx22", image: "ubuntu-24.04", location: "fsn1", labels: { env: "prod" } }, WAIT)?
    let off = hetzner_server_action(made.server.id, "poweroff", null, WAIT)?
    let all = hetzner_servers({ per_page: 2 })?
    let prod = hetzner_servers({ label_selector: "env=prod" })?
    {
        status: made.server.status,
        ip: made.server.public_net.ipv4.ip,
        password: made.root_password != null,
        waited: made.actions,
        off: off.status,
        total: len(all),
        prod: map(prod, (s) => s.name),
        rate: hetzner_rate().limit,
        removed: hetzner_server_delete(made.server.id, WAIT)?,
    }
}

route GET /volumes {
    let v = hetzner_volume_create({ name: "data", size: 20, location: "fsn1", format: "ext4", automount: false }, WAIT)?
    let attached = hetzner_volume_attach(v.id, 1, { ...WAIT, automount: true })?
    let grown = hetzner_volume_resize(v.id, 40, WAIT)?
    let busy = hetzner_volume_delete(v.id, {})
    hetzner_volume_detach(v.id, WAIT)?
    { attach: attached.command, resize: grown.status, busy: busy.error, size: filter(hetzner_volumes({})?, (x) => x.id == v.id)[0].size, deleted: hetzner_volume_delete(v.id, {})?, small: hetzner_volume_create({ name: "x", size: 5, location: "fsn1" }, {}).error }
}

route GET /firewall {
    let rules = [{ direction: "in", protocol: "tcp", port: "443", source_ips: ["0.0.0.0/0", "::/0"], description: "https" }]
    let fw = hetzner_firewall_create({ name: "web", rules }, WAIT)?
    let set = hetzner_firewall_set_rules(fw.id, [...rules, { direction: "in", protocol: "icmp", source_ips: ["0.0.0.0/0"] }], WAIT)?
    let applied = hetzner_firewall_apply(fw.id, [1, { type: "label_selector", label_selector: { selector: "env=prod" } }], WAIT)?
    {
        rules: len(hetzner_firewalls({ name: "web" })?[0].rules),
        set: set,
        applied: applied,
        no_port: hetzner_firewall_create({ name: "x", rules: [{ direction: "in", protocol: "tcp", source_ips: ["0.0.0.0/0"] }] }, {}).error,
        no_ips: hetzner_firewall_set_rules(fw.id, [{ direction: "out", protocol: "icmp" }], {}).error,
    }
}

route GET /failures = {
    missing: hetzner_server(987654, {}).error,
    invalid: hetzner_server_create({ name: "bad name!", server_type: "cx22", image: "x" }, {}).error,
    failed_action: hetzner_server_action(1, "rebuild", { image: "gone" }, WAIT).error,
    locked_then_fine: hetzner_server_action(2, "reboot", null, WAIT)?.status,
    limited_then_fine: len(hetzner_request("GET", "/datacenters", null, {})?.datacenters),
}
