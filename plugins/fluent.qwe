// A shop in English, French and Polish with Project Fluent's .ftl files: plural forms by each language's rules, a gender selector, attributes, and fallback to English for what a translation lacks.
//
//   quillo run fluent.qwe      then open http://localhost:8080/cart

use "fluent.qwer"

let FILES = "fluent_sample_{locale}.ftl"

fn tr(locale, id, args) = fluent_format_file(FILES, [locale, "en"], id, args)?.text

route GET /cart {
    {
        en: [tr("en", "cart-items", { count: 1 }), tr("en", "cart-items", { count: 3 })],
        fr: [tr("fr", "cart-items", { count: 0 }), tr("fr", "cart-items", { count: 2 })],
        // Polish has three forms: 1, 2-4 (and 22-24...), and 5 and up.
        pl: [tr("pl", "cart-items", { count: 1 }), tr("pl", "cart-items", { count: 3 }), tr("pl", "cart-items", { count: 5 }), tr("pl", "cart-items", { count: 22 })],
        welcome_fr: tr("fr", "welcome", { name: "Ana" }),
        photos: tr("en", "shared-photos", { user: "Ana", count: 3, gender: "female" }),
        placeholder: tr("fr", "login.placeholder", {}),
        // Polish has no login message yet: it comes from English.
        fallback: fluent_format_file(FILES, ["pl", "en"], "login.title", {})?,
        missing_pl: fluent_missing(read_file("fluent_sample_en.ftl"), read_file("fluent_sample_pl.ftl"))?,
        inline: fluent_format("hello = Hello, { $who }!", "en", "hello", { who: "world" })?,
        broken: fluent_check("hello = Hello, { $who\nbye = Bye"),
    }
}
