// A café's till: the receipt for an order, previewed on screen, saved for the USB printer, and
// sent to the network printer when PRINTER_HOST is set.
//
//   quillo run escpos.qwe      then open http://localhost:8080/preview
//   PRINTER_HOST=192.168.1.50 quillo run escpos.qwe      and http://localhost:8080/print

use "escpos.qwer"

let ORDER = { id: "A-1042", table: 4, lines: [{ item: "Flat white", qty: 2, price: 3.4 }, { item: "Croissant", qty: 1, price: 2.5 }, { item: "Crème brûlée", qty: 1, price: 6.0 }] }

fn euros(x) = `€${format_number(x, "en", 2)}`

fn receipt(order) {
    let total = sum(order.lines | map((l) => l.qty * l.price))
    [
        { text: "Café Quillo", align: "center", bold: true, size: 2 },
        { text: "1 Market Street", align: "center" },
        { divider: "=" },
        `Order ${order.id}, table ${order.table}`,
        { divider: "-" },
    ] + (order.lines | map((l) => { columns: [`${l.qty} × ${l.item}`, euros(l.qty * l.price)] })) + [
        { divider: "-" },
        { columns: ["TOTAL", euros(total)], bold: true },
        { qr: `https://cafe.example/receipt/${order.id}`, align: "center", feed: 1 },
        { text: "Thank you!", align: "center", feed: 3 },
    ]
}

let OPTIONS = { width: 42, cut: true, drawer: false }

route GET /preview = respond(200, escpos_preview(receipt(ORDER), OPTIONS)?, { "content-type": "text/plain; charset=utf-8" })

route GET /bytes {
    let b64 = escpos_receipt(receipt(ORDER), OPTIONS)?
    { base64_start: slice(b64, 0, 8), saved: escpos_write(receipt(ORDER), OPTIONS, "data/receipt-A-1042.bin")? }
}

route GET /print {
    let host = env("PRINTER_HOST", null) ?? reply 503 "set PRINTER_HOST to the printer's address"
    { sent: escpos_send(receipt(ORDER), merge(OPTIONS, { drawer: true }), host, 9100, 3000)? }
}
