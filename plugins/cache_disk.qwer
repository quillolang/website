//! A disk cache for slow answers (API calls, rendered pages, thumbnails as base64): text kept under a key with a lifetime, stored by content hash so equal values are kept once and checked on read.
//! version: 1.0.0
//!
//! [dependencies]
//! cacache = { version = "13.1", default-features = false, features = ["tokio-runtime"] }

use serde_json::{json, Value};

const MAX_VALUE: usize = 64 << 20;

fn now_ms() -> u128 {
    std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_millis()).unwrap_or(0)
}

/// The entry's metadata when it is there and its time is not up.
fn fresh(dir: &str, key: &str) -> Result<Option<cacache::Metadata>, String> {
    let Some(m) = cacache::metadata_sync(dir, key).map_err(|e| e.to_string())? else { return Ok(None) };
    let exp = m.metadata.get("expires").and_then(Value::as_u64).unwrap_or(0) as u128;
    if exp > 0 && exp <= now_ms() {
        return Ok(None);
    }
    Ok(Some(m))
}

/// Keeps `value` (text) under `key` in the cache folder `dir` (made if missing), for `ttl_seconds` (0: until removed). Gives the content's hash (`sha256-...`).
pub fn disk_cache_put(dir: &str, key: &str, value: &str, ttl_seconds: i64) -> Result<String, String> {
    if value.len() > MAX_VALUE {
        return Err("a cached value is at most 64 MB".into());
    }
    let expires = if ttl_seconds > 0 { now_ms() as u64 + ttl_seconds as u64 * 1000 } else { 0 };
    let mut w = cacache::WriteOpts::new().metadata(json!({ "expires": expires })).open_sync(dir, key).map_err(|e| e.to_string())?;
    std::io::Write::write_all(&mut w, value.as_bytes()).map_err(|e| e.to_string())?;
    w.commit().map(|i| i.to_string()).map_err(|e| e.to_string())
}

/// The text under `key`, or null when it is missing or expired. The content is checked against its hash: a damaged file is an error, not wrong data.
pub fn disk_cache_get(dir: &str, key: &str) -> Result<Option<String>, String> {
    if fresh(dir, key)?.is_none() {
        return Ok(None);
    }
    let bytes = cacache::read_sync(dir, key).map_err(|e| e.to_string())?;
    String::from_utf8(bytes).map(Some).map_err(|_| "the cached value is not text".to_string())
}

/// About an entry, without reading it: `{ key, hash, size, written, expires }` (times in Unix milliseconds, `expires` 0 for never), or null.
pub fn disk_cache_info(dir: &str, key: &str) -> Result<Value, String> {
    Ok(match fresh(dir, key)? {
        Some(m) => json!({ "key": m.key, "hash": m.integrity.to_string(), "size": m.size, "written": m.time as u64, "expires": m.metadata.get("expires").cloned().unwrap_or(json!(0)) }),
        None => Value::Null,
    })
}

/// Forgets `key` (its content stays until `disk_cache_clear`, as other keys may share it).
pub fn disk_cache_remove(dir: &str, key: &str) -> Result<(), String> {
    match cacache::remove_sync(dir, key) {
        Ok(()) => Ok(()),
        Err(e) => Err(e.to_string()),
    }
}

/// Empties the whole cache folder.
pub fn disk_cache_clear(dir: &str) -> Result<(), String> {
    cacache::clear_sync(dir).map_err(|e| e.to_string())
}

/// The keys in the cache that are not expired, at most `limit` (1 to 10,000).
pub fn disk_cache_keys(dir: &str, limit: i64) -> Result<Vec<String>, String> {
    if !std::path::Path::new(dir).exists() {
        return Ok(vec![]);
    }
    let t = now_ms();
    let mut out = Vec::new();
    for m in cacache::list_sync(dir) {
        let m = m.map_err(|e| e.to_string())?;
        let exp = m.metadata.get("expires").and_then(Value::as_u64).unwrap_or(0) as u128;
        if exp == 0 || exp > t {
            out.push(m.key);
        }
        if out.len() >= limit.clamp(1, 10_000) as usize {
            break;
        }
    }
    out.sort();
    Ok(out)
}
