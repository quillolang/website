// Orders on a Kafka topic: the topic made, orders produced with a key and headers and read back
// from their offset, the topic's offsets, and a consumer that remembers where it was.
//
// It needs a Kafka broker (or Redpanda) at KAFKA_BROKERS:
//
//   KAFKA_BROKERS=127.0.0.1:9092 quillo run kafka.qwe      then open /setup, /produce, /consume and /offsets
//
// KAFKA_OFFSETS_FILE=offsets.json keeps the consumer's committed offsets in a file, so a restart
// goes on where it was; without it they are kept in memory.

use "kafka.qwer"

fn kafka() = kafka_connect("main", env("KAFKA_BROKERS", "127.0.0.1:9092"), { timeout_ms: 5000, client_id: "shop" })

route GET /setup {
    kafka()?
    { created: kafka_create_topic("main", "orders", 3, 1)?, topics: kafka_topics("main")? }
}

// Three orders sent; the first read back from where Kafka put it (its key picked the partition).
route GET /produce {
    kafka()?
    let sent = kafka_produce("main", "orders", [
        { key: "customer-42", value: "order 1001: 2 x tea", headers: { source: "web", currency: "EUR" } },
        { key: "customer-7", value: { order: 1002, total: 12.5 }, headers: { source: "shop" } },
        { key: "customer-42", value: "order 1003: 1 x cake", headers: { source: "web" } },
    ], { compression: "gzip" })?
    let first = sent[0]
    let back = kafka_fetch("main", "orders", first.partition, first.offset, 1, {})?
    { sent, back: back.records[0], high_watermark: back.high_watermark }
}

// The consumer reads two, then the rest: it goes on from where it stopped, and commits.
route GET /consume {
    kafka()?
    kafka_consumer("main", "billing", "orders", { start: "earliest", file: env("KAFKA_OFFSETS_FILE", null) })?
    let one = kafka_consume("main", "billing", "orders", 2, 1000)?
    let two = kafka_consume("main", "billing", "orders", 100, 1000)?
    let three = kafka_consume("main", "billing", "orders", 100, 200)?
    {
        first: len(one.records),
        second: len(two.records),
        third: len(three.records),
        values: (one.records + two.records) | map((r) => r.value),
        committed: kafka_commit("main", "billing", "orders")?,
    }
}

route GET /offsets {
    kafka()?
    let parts = [0, 1, 2] | map((p) => kafka_offsets("main", "orders", p)?)
    { partitions: parts, records: parts | map((p) => p.latest - p.earliest) | reduce(0, (a, n) => a + n) }
}
