// Where visitors click on the order page, over its screenshot; and orders by weekday and hour.
//
//   quillo run heatmap.qwe      then open http://localhost:8080/clicks.png

use "heatmap.qwer"

// Clicks as a page would log them: most on the button, some on the menu, a few anywhere.
fn clicks() = flatten([
    for i in range(120) => [110 + (i * 7) % 80, 192 + (i * 3) % 26],
    for i in range(40) => [30 + (i * 5) % 30, 50 + (i * 11) % 100],
    for i in range(15) => [100 + (i * 37) % 240, 50 + (i * 23) % 90],
])

route GET /clicks.png {
    heatmap_png(clicks(), "data/heat/clicks.png", 0, 0, { background: "heatmap_sample.png", radius: 18 })?
    file("data/heat/clicks.png")
}

route GET /week.png {
    let orders = for day in range(7) => for hour in range(12) => (day + 1) * (hour < 4 ? hour : 12 - hour)
    heatmap_grid_png(orders, "data/heat/week.png", 24, null)?
    file("data/heat/week.png")
}

route GET /made = {
    clicks: heatmap_png(clicks(), "data/heat/clicks.png", 0, 0, { background: "heatmap_sample.png", radius: 18 })?,
    plain: heatmap_png([[50, 50], [52, 50, 3], { x: 150, y: 80 }], "data/heat/plain.png", 200, 120, null)?,
    grid: heatmap_grid_png([[1, 2, 3], [4, null, 6]], "data/heat/grid.png", 20, null)?,
}
