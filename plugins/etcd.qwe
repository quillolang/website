// Configuration and coordination in etcd through its JSON gateway: keys under a prefix, a lease that
// takes keys with it, a transaction, a compare-and-swap, and a lock by a key put if absent.
//
//   ETCD_API_URL=http://localhost:2379 quillo run etcd.qwe
//   then open /keys, /prefix, /pages, /lease, /txn, /cas, /delete and /broken
//
// ETCD_USERNAME and ETCD_PASSWORD sign in where auth is on.

use "etcd.qwer"

route GET /keys {
    let one = etcd_put("config/name", "shop", null)?
    let two = etcd_put("config/name", "market", { prev: true })?
    etcd_put("config/limits", { rate: 10, burst: 50 }, null)?
    let now = etcd_get("config/name", 0)?
    {
        value: now.value,
        version: now.version,
        previous: two.prev.value,
        old: etcd_get("config/name", one.revision)?.value,
        json: json.parse(etcd_get("config/limits", 0)?.value).rate,
        none: etcd_get("config/nothing", 0)?,
        unicode: etcd_put("config/grüße", "größe", null)?.prev,
        unicode_read: etcd_get("config/grüße", 0)?.value,
    }
}

route GET /prefix {
    for k in ["a/1", "a/2", "a/3", "a0", "b/1"] { etcd_put(k, "v-" + k, null)? }
    let p = etcd_prefix("a/", null)?
    { keys: p.kvs | map((k) => k.key), count: p.count, values: p.kvs[0].value, keys_only: etcd_prefix("a/", { keys_only: true })?.kvs[0], down: (etcd_prefix("a/", { descending: true })?.kvs | map((k) => k.key))[0], end: etcd_range_end("a/") }
}

// Three keys, two at a time.
route GET /pages {
    let one = etcd_prefix("a/", { limit: 2 })?
    let two = etcd_prefix("a/", { limit: 2, after: one.kvs[1].key })?
    for i in range(0, 1203) { etcd_put("bulk/" + str(1000 + i), "x", null)? }
    let all = etcd_prefix_all("bulk/", 5000)?
    { first: one.kvs | map((k) => k.key), more: one.more, count: one.count, second: two.kvs | map((k) => k.key), last_more: two.more, all: len(all.kvs), complete: all.complete, cut: etcd_prefix_all("bulk/", 10)?.complete }
}

route GET /lease {
    let l = etcd_lease_grant(60)?
    etcd_put("session/ada", "online", { lease: l.id })?
    let info = etcd_lease_info(l.id)?
    let renewed = etcd_lease_keepalive(l.id)?
    let held = etcd_get("session/ada", 0)?.lease == l.id
    etcd_lease_revoke(l.id)?
    { ttl: l.ttl, keys: info.keys, renewed: renewed, held: held, gone: etcd_get("session/ada", 0)?, after: etcd_lease_keepalive(l.id).error, ended: etcd_lease_info(l.id)?.ttl }
}

route GET /txn {
    etcd_put("stock", "1", null)?
    let bought = etcd_txn([{ key: "stock", value: "1" }], [{ put: { key: "stock", value: "0" } }, { put: { key: "order/1", value: "paid" } }, { get: "stock" }], [{ get: "stock" }])?
    let late = etcd_txn([{ key: "stock", value: "1" }], [{ put: { key: "order/2", value: "paid" } }], [{ get: "stock" }])?
    let by_version = etcd_txn([{ key: "stock", target: "version", op: ">", value: 0 }], [{ delete: "order/1" }], [])?
    { bought: bought.succeeded, seen: bought.results[2].value, late: late.succeeded, left: late.results[0].value, no_order: etcd_get("order/2", 0)?, deleted: by_version.results[0].deleted, bad: etcd_txn([{ key: "x", op: "~", value: 1 }], [], []).error }
}

route GET /cas {
    etcd_delete("leader")?
    etcd_put("flag", "on", null)?
    {
        swapped: etcd_compare_and_swap("flag", "on", "off")?,
        stale: etcd_compare_and_swap("flag", "on", "again")?,
        value: etcd_get("flag", 0)?.value,
        leader: etcd_put_if_absent("leader", "node-1", "")?,
        second: etcd_put_if_absent("leader", "node-2", "")?,
        holder: etcd_get("leader", 0)?.value,
    }
}

route GET /delete {
    let n = etcd_delete_prefix("a/")?
    { deleted: n, left: etcd_prefix("a", null)?.kvs | map((k) => k.key), one: etcd_delete("a0")?, again: etcd_delete("a0")? }
}

route GET /broken = {
    everything: etcd_delete_prefix("").error,
    no_lease: etcd_put("x", "y", { lease: "12345" }).error,
    bad_path: etcd_call("/v3/nothing", null).error,
}
