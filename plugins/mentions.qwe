// A community app's posts: who to notify, the tags to file it under, and the post shown with every mention, tag and link clickable.
//
//   quillo run mentions.qwe      then open http://localhost:8080/post

use "mentions.qwer"

let POST = "Thanks @ana and @Ben_K for the #QuilloConf talk! Slides at www.example.com/slides?id=7#top 🎉 Mail me at me@example.com, not @ana. Also @lea@mastodon.social, #東京 #2026 and $AAPL up 3% <3"

route GET /post {
    let found = mentions_extract(POST)
    {
        notify: mentions_names(POST),
        tags: mentions_hashtags(POST),
        cashtags: found.cashtags | map((c) => c.value),
        link: first(found.urls),
        first_mention: first(found.mentions),
    }
}

route GET /post.html = <html><body><p>{raw(mentions_html(POST, { mention: "/users/{name}", hashtag: "/search?tag={tag}" }))}</p></body></html>

route GET /fragment = { html: mentions_html("Hi @ana, see #news at https://example.com/a-very-long-path/that/goes/on/and/on <b>!</b>", { cashtag: "" }) }
