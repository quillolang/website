//! INI files read and written (`[section]` and `key = value`): php.ini, setup.cfg, .gitconfig, desktop files and the settings of older Windows software.
//! version: 1.0.0
//!
//! [dependencies]
//! rust-ini = "0.21"

use ini::{EscapePolicy, Ini, ParseOption, WriteOption};
use serde_json::{Map, Value};

/// Files up to 10 MB are read.
const MAX: usize = 10 * 1024 * 1024;

fn to_map(ini: &Ini) -> Value {
    let mut out = Map::new();
    for (sec, props) in ini.iter() {
        match sec {
            None => {
                for (k, v) in props.iter() {
                    out.insert(k.to_string(), Value::String(v.to_string()));
                }
            }
            Some(name) => {
                let entry = out.entry(name.to_string()).or_insert_with(|| Value::Object(Map::new()));
                if !entry.is_object() {
                    *entry = Value::Object(Map::new());
                }
                if let Value::Object(m) = entry {
                    for (k, v) in props.iter() {
                        m.insert(k.to_string(), Value::String(v.to_string()));
                    }
                }
            }
        }
    }
    Value::Object(out)
}

/// INI text as a map: each `[section]` a map of its keys, keys before the first section at the top. Values are text, with
/// quotes around them taken off (`name = "Ada"`); `;` and `#` start comments; a key given twice keeps the last. Sections named
/// `a.b` stay one key, `"a.b"`.
pub fn ini_parse(text: &str) -> Result<Value, String> {
    if text.len() > MAX {
        return Err("INI files up to 10 MB".into());
    }
    let ini = Ini::load_from_str_opt(text, ParseOption { enabled_quote: true, enabled_escape: false, ..ParseOption::default() }).map_err(|e| format!("not INI: {}", e))?;
    Ok(to_map(&ini))
}

/// An INI file read as ini_parse reads text.
pub fn ini_read_file(path: &str) -> Result<Value, String> {
    let size = std::fs::metadata(path).map_err(|e| format!("{}: {}", path, e))?.len();
    if size as usize > MAX {
        return Err(format!("{}: INI files up to 10 MB", path));
    }
    ini_parse(&std::fs::read_to_string(path).map_err(|e| format!("{}: {}", path, e))?)
}

fn text(v: &Value) -> String {
    match v {
        Value::String(s) => s.clone(),
        Value::Null => String::new(),
        other => other.to_string(),
    }
}

/// A map as INI text: values that are maps become `[sections]` (in the map's order of keys, sorted), the others keys at the top.
/// Numbers and booleans are written as text, null as nothing; a line break in a value is an error, since INI has none.
pub fn ini_write(value: serde_json::Value) -> Result<String, String> {
    let Value::Object(m) = value else { return Err("INI is written from a map".into()) };
    let mut ini = Ini::new();
    let check = |k: &str, v: &str| if v.contains('\n') || k.contains('\n') || k.contains('=') { Err(format!("`{}`: INI keys and values are one line, without `=` in a key", k)) } else { Ok(()) };
    for (k, v) in &m {
        if !v.is_object() {
            let t = text(v);
            check(k, &t)?;
            ini.with_general_section().set(k.as_str(), t);
        }
    }
    for (name, v) in &m {
        if let Value::Object(props) = v {
            for (k, x) in props {
                let t = text(x);
                check(k, &t)?;
                ini.with_section(Some(name.as_str())).set(k.as_str(), t);
            }
            if props.is_empty() {
                ini.with_section(Some(name.as_str()));
            }
        }
    }
    let mut out = Vec::new();
    ini.write_to_opt(&mut out, WriteOption { escape_policy: EscapePolicy::Nothing, kv_separator: " = ", ..WriteOption::default() }).map_err(|e| e.to_string())?;
    String::from_utf8(out).map_err(|e| e.to_string())
}
