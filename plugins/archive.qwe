// An export of several files as one download, and the zip read back.
//
//   quillo run archive.qwe      then open http://localhost:8080/export

use "archive.qwer"

route GET /export {
    write_file("export/orders.csv", "id,total\n1,120.50\n")
    write_file("export/customers.csv", "id,name\n7,Ada\n")
    zip_files("export.zip", ["orders.csv", "customers.csv"], "export")?
    { files: zip_list("export.zip")?, unpacked: unzip("export.zip", "unpacked")? }
}
route GET /export.zip = file("export.zip")
