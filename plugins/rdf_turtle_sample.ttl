# A small graph with most of Turtle in it.
@base <http://example.org/data/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
PREFIX ex: <http://example.org/vocab#>
prefix dc: <http://purl.org/dc/terms/>

<alice> a foaf:Person, ex:Author ;
    foaf:name "Alice"@en, "Alicia"@ES ;
    foaf:age 34 ;
    ex:height 1.68 ;
    ex:score 4.5e0 ;
    ex:active true ;
    foaf:knows <bob>, _:carol ;
    ex:joined "2026-01-02"^^xsd:date ;
    dc:title '''A "long"
title''' ;
    ex:tags ("rdf" 42 ex:thing) ;
    ex:address [ ex:city "Oslo" ; ex:zip "0150" ] ;
    ex:empty () ;
    foaf:mbox <mailto:alice@example.org> ;
    .

<../other#bob> foaf:name "Bob\t\u00e9\n" .
_:carol foaf:name 'Carol' ; ex:path ex:a.b\,c .
[ a ex:Note ] ex:about <alice> .
[] ex:about <> .
