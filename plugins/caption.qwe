// A photo club's site: captions with the photographer's name on each picture, a "SOLD" band, and a meme generator for the club's chat.
//
//   quillo run caption.qwe      then open http://localhost:8080/captioned.png

use "caption.qwer"

let PHOTO = "caption_sample.png"

route GET /captioned.png {
    caption_image(PHOTO, "data/caption/captioned.png", "Summer on the hills · photo by Zoë Ångström", { position: "bottom", size: 18.0, background: "#00000088", outline: "", font: "sans" })?
    file("data/caption/captioned.png")
}

route GET /meme.png {
    caption_meme(PHOTO, "data/caption/meme.jpg", "When the build passes", "on the first try")?
    file("data/caption/meme.jpg")
}

route GET /info {
    {
        long: caption_image(PHOTO, "data/caption/long.png", "A caption long enough that it has to be wrapped over several lines to fit the picture", { size: 28.0, position: "center" })?,
        sold: caption_image(PHOTO, "data/caption/sold.webp", "SOLD", { position: "top", color: "#ff3030", size: 40.0 })?.path,
        measure: caption_measure("Hello, world", 32.0, "sans")?,
        bad_font: caption_measure("x", 12.0, "comic").error,
    }
}
