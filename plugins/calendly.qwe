// Bookings from Calendly: who is signed in, the event types on offer, what is booked and who comes,
// a cancellation, a webhook subscription, and a booking arriving by webhook.
//
//   CALENDLY_TOKEN=... CALENDLY_SIGNING_KEY=... quillo run calendly.qwe
//   then open /me, /events, /invitees, /subscription, /hook-check and /failures
//
// CALENDLY_API_URL reaches a test server. Point the subscription at POST /calendly/webhook.

use "calendly.qwer"

route GET /me {
    let me = calendly_me()?
    { name: me.name, types: len(calendly_event_types({ active: true }, 0)?), capped: len(calendly_event_types({}, 130)?), first: calendly_event_types({}, 1)?[0].name }
}

route GET /events {
    let all = calendly_events({ status: "active", min_start_time: "2026-11-01T00:00:00Z" }, 0)?
    let one = calendly_event(all[0].uri)?
    let gone = calendly_cancel(all[1].uri, "Double booked")?
    {
        count: len(all), same: one.uri == all[0].uri, reason: gone.reason, by: gone.canceler_type,
        state: calendly_event(all[1].uri)?.status,
        twice: calendly_cancel(all[1].uri, "").error,
        bad_filter: calendly_events({ min_start_time: "soon" }, 0).error,
    }
}

route GET /invitees {
    let e = calendly_events({ status: "active" }, 1)?[0]
    { all: len(calendly_invitees(e.uri, {}, 0)?), named: map(calendly_invitees(e.uri, { email: "invitee7@example.com" }, 0)?, (i) => i.name), by_uuid: len(calendly_invitees(calendly_uuid(e.uri), {}, 5)?) }
}

route GET /subscription {
    let s = calendly_webhook_create("https://example.com/calendly/webhook", ["invitee.created", "invitee.canceled"], "user", "my-signing-key")?
    {
        state: s.state, listed: len(calendly_webhooks("user")?),
        deleted: calendly_webhook_delete(s.uri)?, left: len(calendly_webhooks("user")?),
        no_key: calendly_webhook_create("https://x.example", ["invitee.created"], "user", "").error,
        no_events: calendly_webhook_create("https://x.example", [], "user", "k").error,
        scope: calendly_webhook_create("https://x.example", ["invitee.created"], "team", "k").error,
        not_https: calendly_webhook_create("http://x.example", ["invitee.created"], "user", "k").error,
    }
}

route POST /calendly/webhook {
    let hook = calendly_webhook(request.body, request.headers["calendly-webhook-signature"] ?? "", env("CALENDLY_SIGNING_KEY", ""), 180)
    if is_err(hook) { reply 401 hook.error }
    { got: hook.event, who: hook.payload.email }
}

// A signature made outside this plugin, by node's crypto: an old time, so no tolerance for "good".
route GET /hook-check {
    let body = "{\"created_at\":\"2026-11-01T10:00:00.000000Z\",\"event\":\"invitee.created\",\"payload\":{\"email\":\"ada@example.com\",\"name\":\"Ada\"}}"
    let header = "t=1492774577,v1=dd14f24c071920721ae1a9d70b322717c15410ff3feb6ce74f827e473d5fe471"
    let fresh = calendly_webhook_sign(body, "wh-key", 0)
    {
        good: calendly_webhook(body, header, "wh-key", 0)?.payload.email,
        event: calendly_webhook(body, fresh, "wh-key", 180)?.event,
        replay: contains(calendly_webhook(body, header, "wh-key", 180).error, "more than the 180 s allowed: a replay?"),
        tampered: calendly_webhook(body + " ", header, "wh-key", 0).error,
        no_v1: calendly_webhook(body, "t=1", "wh-key", 0).error,
        unsigned: calendly_webhook(body, "", "wh-key", 0).error,
    }
}

route GET /uuids = {
    uri: calendly_uuid("https://api.calendly.com/scheduled_events/GBGBDCAADAEDCRZ2"),
    tail: calendly_uuid("https://api.calendly.com/users/AAAA/"),
    bare: calendly_uuid("ABC"),
}

route GET /failures = {
    missing: calendly_event("NOSUCH").error,
    waited: calendly_event("busy")?.name,
}
