// A recipe site's photos cut for every place they appear: square cards, a 16:9 banner and portrait stories, each on the interesting part and not just the middle.
//
//   quillo run smart_crop.qwe      then open http://localhost:8080/crops

use "smart_crop.qwer"

let PHOTO = "smart_crop_sample.png"

route GET /crops {
    {
        square: smart_crop_box(PHOTO, 200, 200, 1.0)?,
        closer: smart_crop_box(PHOTO, 200, 200, 0.5)?,
        shapes: smart_crop_boxes(PHOTO, [[1, 1], [16, 9], [4, 5]])?,
        made: smart_crop(PHOTO, "data/smart_crop/card.jpg", 160, 160, 1.0)?,
    }
}

route GET /card.jpg {
    smart_crop(PHOTO, "data/smart_crop/card.jpg", 160, 160, 1.0)?
    file("data/smart_crop/card.jpg")
}

route GET /face.png {
    smart_crop(PHOTO, "data/smart_crop/face.png", 120, 120, 0.4)?
    file("data/smart_crop/face.png")
}
