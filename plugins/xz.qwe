// A database dump compressed with xz for a backup, and text both ways.
//
//   quillo run xz.qwe      then open http://localhost:8080/pack

use "xz.qwer"

route GET /pack {
    let rows = for i in range(3000) => `insert into orders (id, customer, total) values (${i}, 'customer ${i % 50}', ${i % 90}.50);`
    write_file("data/dump.sql", join(rows, "\n"))
    let size = xz_file("data/dump.sql", "data/dump.sql.xz", 9)?
    let packed = xz_text("hello, hello, hello", 6)?
    {
        sql_bytes: len(read_file("data/dump.sql")),
        xz_bytes: size,
        unpacked_bytes: unxz_file("data/dump.sql.xz", "data/dump.copy.sql")?,
        back: unxz_text(packed)?,
    }
}
