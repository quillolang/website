//! BSON, MongoDB's binary format: documents to BSON as base64 and back (with ObjectIds and dates as Extended JSON), and ObjectIds made and read.
//! version: 1.0.0
//!
//! [dependencies]
//! bson = "2"
//! base64 = "0.22"

use base64::engine::general_purpose::STANDARD;
use base64::Engine;
use bson::oid::ObjectId;
use bson::{Bson, Document};
use serde_json::{json, Value};

/// BSON documents are at most 16 MiB, as in MongoDB.
const MAX: usize = 16 * 1024 * 1024;

fn document(value: Value) -> Result<Document, String> {
    match Bson::try_from(value).map_err(|e| format!("not a document: {}", e))? {
        Bson::Document(d) => Ok(d),
        _ => Err("a BSON document is a map".into()),
    }
}

/// `document` (a map) as BSON, in base64. Extended JSON in it is read: `{ "$oid": "..." }` is an ObjectId,
/// `{ "$date": "2026-11-02T09:00:00Z" }` a date, `{ "$numberDecimal": "12.50" }` a decimal.
pub fn bson_encode(document_map: serde_json::Value) -> Result<String, String> {
    let d = document(document_map)?;
    let mut out = Vec::new();
    d.to_writer(&mut out).map_err(|e| e.to_string())?;
    if out.len() > MAX {
        return Err("a BSON document is at most 16 MiB".into());
    }
    Ok(STANDARD.encode(out))
}

/// The document in base64 BSON, as relaxed Extended JSON: ObjectIds as `{ "$oid": ... }`, dates as `{ "$date": ... }`,
/// binary as `{ "$binary": ... }`; ints and floats as numbers.
pub fn bson_decode(base64_text: &str) -> Result<Value, String> {
    let bytes = STANDARD.decode(base64_text.trim()).map_err(|_| "not base64".to_string())?;
    if bytes.len() > MAX {
        return Err("a BSON document is at most 16 MiB".into());
    }
    let d = Document::from_reader(&mut bytes.as_slice()).map_err(|e| format!("not BSON: {}", e))?;
    Ok(Bson::Document(d).into_relaxed_extjson())
}

/// A new ObjectId, as its 24 hex characters: unique without asking a database, and sorted by the time it was made.
pub fn bson_object_id() -> String {
    ObjectId::new().to_hex()
}

/// What an ObjectId says: `{ valid, time, ms }`, `time` when it was made (UTC, to the second) and `ms` the same in
/// milliseconds since 1970. `valid` is false (and the rest null) for text that is not 24 hex characters.
pub fn bson_object_id_info(id: &str) -> Value {
    match ObjectId::parse_str(id.trim()) {
        Ok(oid) => {
            let t = oid.timestamp();
            json!({ "valid": true, "time": t.try_to_rfc3339_string().ok(), "ms": t.timestamp_millis() })
        }
        Err(_) => json!({ "valid": false, "time": null, "ms": null }),
    }
}
