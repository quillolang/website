// A CRM kept in Salesforce: both ways of signing in, SOQL past one batch, a record made, changed,
// upserted by an external id and deleted, composite calls, and collections.
//
//   SALESFORCE_LOGIN_URL=https://you.my.salesforce.com SALESFORCE_CLIENT_ID=... SALESFORCE_CLIENT_SECRET=... quillo run salesforce.qwe
//   then open /signin, /records, /query, /composite, /many and /failures
//
// For a JWT sign-in set SALESFORCE_USERNAME and SALESFORCE_PRIVATE_KEY_FILE instead of the secret,
// with SALESFORCE_LOGIN_URL=https://login.salesforce.com.

use "salesforce.qwer"

route GET /signin {
    let jwt = salesforce_sign_in("jwt")?
    let client = salesforce_sign_in("client_credentials")?
    { jwt: jwt.flow, client: client.flow, same_instance: jwt.instance_url == client.instance_url, bad: salesforce_sign_in("password").error }
}

route GET /records {
    let id = salesforce_create("Account", { Name: "Acme", Industry: "Mugs" })?
    salesforce_update("Account", id, { Industry: "Plates" })?
    let read = salesforce_get("Account", id, ["Name", "Industry"])?
    let first = salesforce_upsert("Account", "External_Id__c", "EXT-1", { Name: "Globex" })?
    let second = salesforce_upsert("Account", "External_Id__c", "EXT-1", { Name: "Globex Inc" })?
    {
        read: read, made: first.created, changed: second.created, same: first.id == second.id,
        attributes: contains(read, "attributes"),
        deleted: salesforce_delete("Account", id)?,
        gone: salesforce_get("Account", id, []).error,
        bad_name: salesforce_create("Acc; DROP", {}).error,
    }
}

route GET /query {
    salesforce_create("Contact", { LastName: "O'Brien" })?
    let q = "SELECT Id, LastName FROM Contact WHERE LastName = " + salesforce_quote("O'Brien")
    let all = salesforce_query("SELECT Id, Name FROM Lead", {})?
    {
        quoted: salesforce_quote("O'Brien \"x\"\n"),
        total: all.total, got: len(all.records), first: all.records[0].Name, plain: contains(all.records[0], "attributes"),
        capped: len(salesforce_query("SELECT Id FROM Lead", { max_items: 2100 })?.records),
        found: map(salesforce_query(q, {})?.records, (c) => c.LastName),
        with_deleted: salesforce_query("SELECT Id, Name FROM Lead", { all: true })?.total,
        bad: salesforce_query("SELECT Nothing FROM Nowhere", {}).error,
        usage: salesforce_api_usage(),
    }
}

route GET /composite {
    let good = salesforce_composite([
        { ref: "acct", method: "POST", object: "Account", body: { Name: "Initech" } },
        { ref: "ct", method: "POST", object: "Contact", body: { LastName: "Bolton", AccountId: "@{acct.id}" } },
    ], true)?
    let bad = salesforce_composite([
        { ref: "ok", method: "POST", object: "Account", body: { Name: "Rolled back" } },
        { ref: "no", method: "POST", object: "Account", body: { Industry: "No name" } },
    ], true)?
    {
        ok: good.ok, statuses: map(good.steps, (s) => s.status), linked: salesforce_get("Contact", good.steps[1].body.id, ["AccountId"])?.AccountId == good.steps[0].body.id,
        bad_ok: bad.ok, halted: bad.steps[0].error, why: bad.steps[1].error,
        kept: salesforce_query("SELECT Id, Name FROM Account WHERE Name = 'Rolled back'", {})?.total,
        too_many: salesforce_composite([], true).error,
    }
}

route GET /many {
    let rows = map(range(0, 450), (i) => { Name: `Bulk ${i}` })
    let r = salesforce_create_many("Account", rows + [{ Industry: "No name" }], false)?
    { made: len(r.ids), failed: r.failed }
}

route GET /failures = {
    missing: salesforce_get("Account", "001000000000000AAA", []).error,
    waited: len(salesforce_query("SELECT Id FROM Busy", {})?.records),
    revived: salesforce_create("Account", { Name: "After an expired session" })? != null,
}
