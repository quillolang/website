// A slow report kept in memory for 30 seconds, and a rate limit of 5 requests a minute per visitor.
//
//   quillo run memory_cache.qwe      then open http://localhost:8080/report

use "memory_cache.qwer"

fn slow_report() {
    sleep(200)
    { total: 4521, made_at: now() }
}

route GET /report {
    let kept = memcache_get("report")
    if kept != null { return { from: "cache", report: kept } }
    let fresh = slow_report()
    memcache_set("report", fresh, 30)?
    { from: "database", report: fresh }
}

route GET /limited {
    let n = memcache_incr(`rate:${request.ip}`, 1, 60)
    if n > 5 { reply 429 { error: "Slow down: 5 requests a minute." } }
    { ok: true, used: n }
}

route GET /demo {
    memcache_set("short", "gone soon", 1)?
    memcache_set("user:7", { name: "Ada", roles: ["admin"] }, 0)?
    let before = memcache_get("short")
    sleep(1100)
    { before, after: memcache_get("short"), user: memcache_get("user:7"), counter: [memcache_incr("c", 1, 0), memcache_incr("c", 2, 0)], stats: memcache_stats() }
}
