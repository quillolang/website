// An access policy in Rego, as Open Policy Agent runs it: decisions with input and data, the reasons
// behind them, the package's rules listed, and a policy with a mistake placed by its line.
//
//   quillo run rego.qwe      then open http://localhost:8080/decide, /reasons, /rules, /kept and /broken

use "rego.qwer"

let POLICY = `package shop.authz

import rego.v1

default allow := false

allow if {
    input.user in data.admins
}

allow if {
    input.method == "GET"
    startswith(input.path, "/public/")
}

deny contains msg if {
    input.user in data.blocked
    msg := sprintf("%s is blocked", [input.user])
}

deny contains "writes are off on Sundays" if {
    input.method != "GET"
    input.day == "sunday"
}

limit(tier) := 100 if tier == "free"
limit(tier) := 1000 if tier == "paid"

quota := limit(input.tier) if print("tier", input.tier)
`

let DATA = { admins: ["ada"], blocked: ["mallory"] }

route GET /decide = {
    admin: rego_allowed(POLICY, DATA, { user: "ada", method: "POST", path: "/orders" }, "data.shop.authz.allow")?,
    public: rego_allowed(POLICY, DATA, { user: "bob", method: "GET", path: "/public/a" }, "data.shop.authz.allow")?,
    refused: rego_allowed(POLICY, DATA, { user: "bob", method: "POST", path: "/orders" }, "data.shop.authz.allow")?,
    quota: rego_eval(POLICY, DATA, { tier: "paid" }, "data.shop.authz.quota")?,
    undefined: rego_eval(POLICY, DATA, { tier: "gold" }, "data.shop.authz.quota")?,
}

route GET /reasons = {
    deny: rego_eval(POLICY, DATA, { user: "mallory", method: "POST", day: "sunday" }, "data.shop.authz.deny")?.value,
    each: rego_query(POLICY, DATA, { user: "mallory", method: "POST", day: "sunday" }, "why := data.shop.authz.deny[_]")?.results | map((r) => r.bindings.why),
}

route GET /rules = rego_rules({ "authz.rego": POLICY })? | map((r) => { name: r.name, kind: r.kind, line: r.line, default: r.default, bodies: r.bodies })

// Compiled once at start; each request gets a decision from the kept policies.
let LOADED = rego_load("shop", POLICY, DATA)

route GET /kept = {
    packages: LOADED?,
    allow: rego_decide("shop", { user: "ada", method: "GET", path: "/x" }, "data.shop.authz.allow")?.value,
    none: rego_decide("nothing", {}, "data.x").error,
}

route GET /broken = {
    syntax: rego_check("package a\n\nallow if {\n    input.x ==\n}\n"),
    unsafe_var: rego_check("package a\nimport rego.v1\n\nallow if {\n    x == 1\n}\n"),
    refused: rego_eval("package a\n\nallow := = 1\n", null, {}, "data.a.allow").error,
    no_rule: rego_eval("package a\nx := 1\n", null, {}, "data.b.y").error,
    fine: rego_check(POLICY).ok,
}
