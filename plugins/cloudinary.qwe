// Images on Cloudinary from a server: signed uploads, delivery URLs with transformations, the
// signature a browser needs for a direct upload, and webhooks checked.
//
//   CLOUDINARY_CLOUD_NAME=demo CLOUDINARY_API_KEY=... CLOUDINARY_API_SECRET=... quillo run cloudinary.qwe
//   then open /upload, /urls, /browser, /assets, /webhook and /broken

use "cloudinary.qwer"

route GET /upload {
    let remote = cloudinary_upload("https://example.com/cat.jpg", { public_id: "cats/first", tags: ["cat", "pet"], overwrite: true })?
    let local = cloudinary_upload("cloudinary.qwe", { folder: "docs", resource_type: "raw" })?
    {
        id: remote.public_id,
        url: remote.secure_url,
        width: remote.width,
        checked: cloudinary_verify_upload(remote.public_id, str(remote.version), remote.signature)?,
        forged: cloudinary_verify_upload("cats/other", str(remote.version), remote.signature)?,
        local_bytes: local.bytes > 100,
        local_id: local.public_id,
    }
}

// The fields of Cloudinary's documented example: `file` and `api_key` are not signed, and the others
// are sorted. Its result is checked against the example's method with this server's secret.
route GET /signature = cloudinary_signature({ public_id: "sample_image", timestamp: 1315060510, eager: "w_400,h_300,c_pad|w_260,h_200,c_crop", file: "left out", api_key: "left out" })?

route GET /urls = {
    plain: cloudinary_url("cats/first", { format: "jpg" })?,
    sized: cloudinary_url("cats/first", { transformation: { width: 300, height: 200, crop: "fill", gravity: "auto", quality: "auto", fetch_format: "auto" }, version: 1312461204, format: "jpg" })?,
    chained: cloudinary_url("cats/first", { transformation: [{ width: 300, crop: "scale" }, { angle: 10 }, "e_sepia"] })?,
    signed: cloudinary_url("sample.jpg", { type: "authenticated", sign: true, transformation: { width: 300, height: 300, crop: "fill" } })?,
    spaces: cloudinary_url("my cat", { format: "png" })?,
}

// A page asks here, then posts the file straight to Cloudinary with these fields.
route GET /browser {
    let p = cloudinary_upload_params({ folder: "user-7", tags: "avatar" })?
    { url: p.url, key: p.api_key, fields: keys(p.fields), matches: p.signature == cloudinary_signature(p.fields)? }
}

route GET /assets {
    let first = cloudinary_assets("cats", 1, "")?
    let second = cloudinary_assets("cats", 1, first.next)?
    { first: first.assets | map((a) => a.public_id), second: second.assets | map((a) => a.public_id), end: second.next }
}

// The endpoint a Cloudinary notification URL points at.
route POST /cloudinary/webhook {
    let n = cloudinary_webhook(request.body, request.headers["x-cld-timestamp"] ?? "", request.headers["x-cld-signature"] ?? "", 7200)
    if is_err(n) { reply 401 n.error }
    { kind: n.notification_type }
}

route GET /webhook {
    let body = json.stringify({ notification_type: "upload", public_id: "cats/first" })
    let at = str(int(now() / 1000))
    let sig = cloudinary_webhook_sign(body, at)?
    {
        good: cloudinary_webhook(body, at, sig, 7200)?.notification_type,
        changed: cloudinary_webhook(body + " ", at, sig, 7200).error,
        late: cloudinary_webhook(body, "1000000000", cloudinary_webhook_sign(body, "1000000000")?, 7200).error,
    }
}

route GET /broken {
    let gone = cloudinary_destroy("cats/first", { invalidate: true })?
    {
        destroyed: gone,
        again: cloudinary_destroy("cats/first", null)?,
        bad_file: cloudinary_upload("https://example.com/not-an-image.txt", null).error,
        no_file: cloudinary_upload("/no/such/file.png", null).error,
        bad_step: cloudinary_url("x", { transformation: { wobble: 1 } }).error,
    }
}
