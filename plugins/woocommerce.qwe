// A WooCommerce shop run from outside it: orders and products read to the end, an order made and
// refunded, a big batch of products, a customer, and webhooks with their first unsigned ping.
//
//   WOOCOMMERCE_API_URL=https://shop.example/wp-json/wc/v3 WOOCOMMERCE_KEY=ck_... WOOCOMMERCE_SECRET=cs_... \
//   WOOCOMMERCE_WEBHOOK_SECRET=... quillo run woocommerce.qwe
//   then open /orders, /products, /batch, /customers, /signature, /hook-check and /failures
//
// Point a webhook at POST /woocommerce/webhook. Over plain HTTP the plugin signs by OAuth 1.0a.

use "woocommerce.qwer"

route GET /orders {
    let o = woocommerce_order_create({ payment_method: "bacs", billing: { first_name: "Ada", email: "ada@example.com" }, line_items: [{ product_id: 11, quantity: 2 }] })?
    let done = woocommerce_order_update(o.id, { status: "completed" })?
    woocommerce_order_note(o.id, "Packed with care", true)?
    let back = woocommerce_refund(o.id, "5.00", "Chipped", {})?
    {
        total: o.total, state: done.status, refund: back.amount, gateway: back.refunded_payment,
        read: woocommerce_order(o.id)?.status,
        count: len(woocommerce_orders({ status: "processing" }, 0)?),
        capped: len(woocommerce_orders({ status: "processing" }, 130)?),
        counted: woocommerce_count("/orders", { status: "processing" })?,
        too_much: woocommerce_refund(o.id, "999.00", "x", {}).error,
        not_money: woocommerce_refund(o.id, "ten", "x", {}).error,
    }
}

route GET /products {
    let p = woocommerce_product_create({ name: "Blue mug", sku: "MUG-B", type: "simple", regular_price: "12.50" })?
    {
        price: woocommerce_product(p.id)?.regular_price,
        by_sku: woocommerce_product_by_sku("MUG-B")?.name,
        none: woocommerce_product_by_sku("NOPE")?,
        changed: woocommerce_product_update(p.id, { regular_price: "13.00" })?.price,
        taken: woocommerce_product_create({ name: "Other", sku: "MUG-B", regular_price: "1.00" }).error,
        number: woocommerce_product_create({ name: "x", regular_price: 12.5 }).error,
    }
}

route GET /batch {
    let items = map(range(0, 230), (i) => { name: `Batch ${i}`, sku: `B-${i}`, regular_price: "1.00" })
    let r = woocommerce_products_batch({ create: items + [{ name: "Twin", sku: "B-0", regular_price: "1.00" }] })?
    let found = woocommerce_products({ search: "Batch" }, 0)?
    let gone = woocommerce_products_batch({ delete: map(found, (p) => p.id), update: [{ id: found[0].id, name: "x" }] })?
    { created: r.created, errors: r.errors, found: len(found), deleted: gone.deleted, updated: gone.updated }
}

route GET /customers {
    let c = woocommerce_customer_create({ email: "grace@example.com", first_name: "Grace" })?
    {
        name: woocommerce_customer(c.id)?.first_name,
        by_email: map(woocommerce_customers({ email: "grace@example.com" }, 0)?, (x) => x.id == c.id),
        all: len(woocommerce_customers({}, 0)?) >= 104,
        twice: woocommerce_customer_create({ email: "grace@example.com" }).error,
        no_email: woocommerce_customer_create({ first_name: "x" }).error,
    }
}

// The same signature made by node's crypto, on fixed values.
route GET /signature = {
    query: woocommerce_oauth_query("GET", "http://shop.example/wp-json/wc/v3/orders", { status: "any item", per_page: 2 }, 1730000000, "abc123")?,
}

route POST /woocommerce/webhook {
    let hook = woocommerce_webhook(request.headers, request.body, env("WOOCOMMERCE_WEBHOOK_SECRET", ""))
    if is_err(hook) { reply 401 hook.error }
    { ping: hook.ping, topic: hook.topic }
}

// A signature made outside this plugin, by node's crypto.
route GET /hook-check {
    let body = "{\"id\":1001,\"status\":\"processing\"}"
    let headers = { "x-wc-webhook-signature": "ir6bPLqkG6iAOytEjXMVuc4IJAZO/J/1ThMRf6A0LkA=", "x-wc-webhook-topic": "order.updated", "x-wc-webhook-resource": "order", "x-wc-webhook-event": "updated", "x-wc-webhook-id": "12", "x-wc-webhook-delivery-id": "d1", "x-wc-webhook-source": "https://shop.example/" }
    let good = woocommerce_webhook(headers, body, "wc-secret")?
    {
        topic: good.topic, id: good.payload.id, ping: good.ping,
        first: woocommerce_webhook({}, "webhook_id=12", "wc-secret")?,
        tampered: woocommerce_webhook(headers, body + " ", "wc-secret").error,
        other: woocommerce_webhook(headers, body, "other").error,
        unsigned: woocommerce_webhook({}, body, "wc-secret").error,
    }
}

route GET /failures = {
    missing: woocommerce_order(999999).error,
    product: woocommerce_product(999999).error,
    any_call: woocommerce_call("GET", "/nosuch", null).error,
    waited: woocommerce_call("get", "/busy", null)?.ok,
}
