// A warehouse office's laser printer (any HP LaserJet, or a printer that speaks PCL 5): an A4
// delivery note with the logo, boxes and shading, printed twice from tray 2 in duplex, and the
// day's picking list as a plain listing.
//
//   quillo run pcl.qwe      then open http://localhost:8080/note and http://localhost:8080/picking
//   PRINTER_HOST=192.168.1.70 quillo run pcl.qwe      and http://localhost:8080/print

use "pcl.qwer"

let NOTE = { no: "DN-55120", date: "29 October 2026", to: ["Brasserie Lumière", "8 Quai de Saône", "69002 Lyon"], lines: [["Espresso beans 1 kg", 12], ["Oat milk 1 l", 24], ["Paper cups 12 oz (1,000)", 2]] }

fn note_page(n) = [
    { image: "pcl_sample.png", x: 15, y: 12, width: 50, dpi: 300 },
    { text: "DELIVERY NOTE", x: 120, y: 22, size: 20, bold: true },
    { text: `${n.no}  ·  ${n.date}`, x: 120, y: 30, size: 10 },
    { box: true, x: 15, y: 40, width: 85, height: 28, thickness: 0.3 },
] + map(range(len(n.to)), (i) => { text: n.to[i], x: 19, y: 48 + i * 6, size: 11, bold: i == 0 }) + [
    { rect: true, x: 15, y: 80, width: 180, height: 8, fill: 15 },
    { text: "Item", x: 18, y: 85.5, size: 10, bold: true },
    { text: "Qty", x: 175, y: 85.5, size: 10, bold: true },
] + map(range(len(n.lines)), (i) => [
    { text: n.lines[i][0], x: 18, y: 96 + i * 7, size: 10 },
    { text: str(n.lines[i][1]), x: 175, y: 96 + i * 7, size: 10 },
    { line: true, x: 15, y: 98 + i * 7, width: 180, thickness: 0.1 },
]) | flatten

let OPTIONS = { paper: "a4", copies: 2, tray: 4, duplex: "long", pjl: true, name: "DN-55120" }

route GET /note = respond(200, pcl_pages([note_page(NOTE)], OPTIONS)?, { "content-type": "text/plain; charset=utf-8" })

route GET /picking = respond(200, pcl_listing("PICKING LIST 29/10/2026\n\nA-04-03  Espresso beans 1 kg     12\nB-11-01  Oat milk 1 l           24\nC-02-07  Paper cups 12 oz        2\n", { paper: "letter", size: 12 })?, { "content-type": "text/plain; charset=utf-8" })

route GET /print {
    let host = env("PRINTER_HOST", null) ?? reply 503 "set PRINTER_HOST to the printer's address (host or host:port)"
    { sent: pcl_send("pages", [note_page(NOTE)], OPTIONS, host, 5000)?, saved: pcl_write("listing", "Hello", {}, "data/hello.pcl")? }
}
