// Reminders typed as people say them: "next friday at 3pm", "tomorrow 9am", "in 2 weeks".
//
//   quillo run dates_english.qwe      then open http://localhost:8080/remind?when=tomorrow%209am

use "dates_english.qwer"

// Wednesday 28 October 2026, 10:00 in Paris (UTC+1): fixed, so the answers below do not move.
let NOW = 1793178000000
let PARIS = 60

route GET /remind ? { when: str } = { when, at: dates_parse_iso(when, NOW, PARIS, "uk")? }

route GET /examples = ["next friday at 3pm", "friday 3pm", "in 2 weeks", "3 days ago", "1 April 2027", "04/01/27"] | map((w) => { text: w, uk: dates_parse_iso(w, NOW, PARIS, "uk") ?? "?", us: dates_parse_iso(w, NOW, PARIS, "us") ?? "?" })

route GET /due ? { length: str = "2 weeks" } = dates_duration(length)?
