// A B2B checkout that checks the buyer's VAT number for typos before it goes on the invoice.
//
//   quillo run vat.qwe      then open http://localhost:8080/vat?number=DE%20136%20695%20976

use "vat.qwer"

route GET /vat ? { number: str } = vat_check(number)?

route GET /examples = ["DE136695976", "ATU13585627", "FR40303265045", "IE6388047V", "LU26375245", "NL004495445B01", "PL5260001246", "DE136695977", "FR41303265045"]
    | map((n) => { number: n, valid: vat_valid(n) })

route POST /invoice {
    let vat = request.json?.vat ?? ""
    if !vat_valid(vat) { reply 422 { error: "That VAT number does not look right: check it for typos." } }
    { ok: true, vat: vat_check(vat)?.number }
}
