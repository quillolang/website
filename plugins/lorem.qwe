// Seed data for a blog mock-up: posts with titles and paragraphs, the same on every run.
//
//   quillo run lorem.qwe      then open http://localhost:8080/posts

use "lorem.qwer"

route GET /posts = range(1, 4) | map((i) => { id: i, title: lorem_title(i), excerpt: lorem_sentences(1, i), body: lorem_paragraphs(2, i) })

route GET /words ? { n: int = 8 } = { text: lorem_words(n) }

route GET /page = <html>
    <body>
        <h1>{lorem_title(7)}</h1>
        {lorem_paragraphs(3, 7) | map((p) => <p>{p}</p>)}
    </body>
</html>
