// Secrets kept out of support tickets: each message is scanned before it is saved, and what is
// saved has the keys masked.
//
//   quillo run secrets_scan.qwe      then open http://localhost:8080/scan
//
// The fake tokens below are put together from pieces, so this file itself holds none.

use "secrets_scan.qwer"

let TICKET = join([
    "Hi, our deploy fails since this morning. Config:",
    "  AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE",
    "  DATABASE_URL=postgres://shop:" + "s3cr3t-Pa55" + "@db.internal:5432/shop",
    "  STRIPE_KEY=" + "sk_" + "live_" + "4eC39HqLyjWDarjtT1zdp7dc",
    "  api_secret = \"" + "q8Zr2Lw0" + "Vx9kTn4M" + "pC7s\"",
    "  slack: " + "xox" + "b-1234567890-" + "abcdefABCDEF1234",
    "The token in the header was " + "eyJhbGciOiJIUzI1NiJ9" + ".eyJzdWIiOiI0MiIsIm5hbWUiOiJBZGEifQ" + ".c2lnbmF0dXJlLW5vdC1yZWFs",
    "Thanks, Ada",
], "\n")

route GET /scan = {
    found: secrets_find(TICKET),
    any_real: secrets_any(TICKET),
    saved: secrets_redact(TICKET),
}

route GET /clean = {
    any: secrets_any("Order 1042 shipped, tracking 1Z999AA10123456784."),
    placeholder_only: secrets_any("AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE"),
    rules: len(secrets_rules()),
}

route POST /tickets { json: { text: str } } {
    if secrets_any(text) {
        reply 422 { error: "this message holds a key or a password: it was not saved", found: secrets_find(text) }
    }
    { saved: true }
}
