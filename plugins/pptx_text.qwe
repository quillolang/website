// A presentation's slides read for a search index and a page of its outline.
//
//   quillo run pptx_text.qwe      then open http://localhost:8080/slides

use "pptx_text.qwer"

let DECK = "pptx_text_sample.pptx"

route GET /slides = { info: pptx_info(DECK)?, slides: pptx_slides(DECK)? }

route GET /search ? { q: str = "coffee" } =
    pptx_slides(DECK)? | filter((s) => contains(lower(s.title + " " + s.text), lower(q))) | map((s) => { slide: s.number, title: s.title })

route GET /outline = <html><body>
    <h1>{pptx_info(DECK)?.title}</h1>
    <ol>{for s in pptx_slides(DECK)? => <li>{s.title}</li>}</ol>
</body></html>
