// A sign-in that allows 5 tries a minute per IP, and an API limited per key.
//
//   quillo run rate_limit.qwe      then open http://localhost:8080/burst

use "rate_limit.qwer"

fn limited(req) {
    let r = rate_limit(`api:${req.headers["x-api-key"] ?? req.ip}`, 100, 60)?
    if r.allowed { return req }
    respond(429, { error: "slow down", retry_after_ms: r.retry_after_ms }, { "retry-after": str(ceil(r.retry_after_ms / 1000)) })
}

routes /api | limited {
    route GET /orders = [{ id: 1, total: 120.5 }]
}

route POST /login { form: { email: str, password: str } } {
    let r = rate_limit(`login:${request.ip}`, 5, 60)?
    if !r.allowed { reply 429 `Too many tries: wait ${ceil(r.retry_after_ms / 1000)} s.` }
    { signed_in: false }
}

// Seven tries in a row from one visitor: five pass, two are told to wait.
route GET /burst {
    rate_limit_reset("demo")
    let tries = range(7) | map((i) => rate_limit("demo", 5, 60)?)
    { allowed: len(tries | filter((t) => t.allowed)), refused: len(tries | filter((t) => !t.allowed)), wait_ms: last(tries).retry_after_ms }
}
