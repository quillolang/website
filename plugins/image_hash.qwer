//! Perceptual hashes of pictures, and how far apart two are: to find near-duplicates (resized, recompressed, slightly edited) among uploads or a photo library.
//! version: 1.0.0
//!
//! [dependencies]
//! image_hasher = "3"
//! image = { version = "0.25", default-features = false, features = ["png", "jpeg", "webp", "gif"] }

use serde_json::{json, Value};

const SIMILAR: u32 = 10;

fn open(path: &str) -> Result<image::DynamicImage, String> {
    let mut r = image::ImageReader::open(path).map_err(|e| format!("{}: {}", path, e))?.with_guessed_format().map_err(|e| format!("{}: {}", path, e))?;
    let mut l = image::Limits::default();
    l.max_image_width = Some(12_000);
    l.max_image_height = Some(12_000);
    l.max_alloc = Some(512 * 1024 * 1024);
    r.limits(l);
    r.decode().map_err(|e| format!("{}: {}", path, e))
}

fn hash_bytes(path: &str) -> Result<Vec<u8>, String> {
    let img = open(path)?;
    let h = image_hasher::HasherConfig::new().hash_size(8, 8).hash_alg(image_hasher::HashAlg::Gradient).to_hasher();
    Ok(h.hash_image(&img).as_bytes().to_vec())
}

fn hex(b: &[u8]) -> String {
    b.iter().map(|x| format!("{:02x}", x)).collect()
}

fn unhex(s: &str) -> Result<Vec<u8>, String> {
    let s = s.trim();
    if s.len() % 2 != 0 || !s.chars().all(|c| c.is_ascii_hexdigit()) {
        return Err(format!("`{}` is not a hash from image_hash", s));
    }
    (0..s.len()).step_by(2).map(|i| u8::from_str_radix(&s[i..i + 2], 16).map_err(|e| e.to_string())).collect()
}

fn distance(a: &[u8], b: &[u8]) -> Result<u32, String> {
    if a.len() != b.len() {
        return Err("the hashes are of different sizes".into());
    }
    Ok(a.iter().zip(b).map(|(x, y)| (x ^ y).count_ones()).sum())
}

/// The picture's perceptual hash, as 16 hex characters (64 bits) to keep in a database: pictures that look alike have hashes that differ in few bits.
pub fn image_hash(path: &str) -> Result<String, String> {
    Ok(hex(&hash_bytes(path)?))
}

/// How many bits two hashes differ in: 0 for the same picture, up to about 10 for a resized or recompressed copy, 20 and more for different pictures.
pub fn image_hash_distance(a: &str, b: &str) -> Result<i64, String> {
    Ok(distance(&unhex(a)?, &unhex(b)?)? as i64)
}

/// Two pictures compared: `{ distance, similar }`, `similar` true when the distance is 10 or less.
pub fn image_hash_compare(a: &str, b: &str) -> Result<Value, String> {
    let d = distance(&hash_bytes(a)?, &hash_bytes(b)?)?;
    Ok(json!({ "distance": d, "similar": d <= SIMILAR }))
}

/// The `candidates` (each `{ id, hash }`, as kept from `image_hash`) within `max_distance` of `hash`, nearest first, as `{ id, distance }`: "have we seen this photo before?"
pub fn image_hash_nearest(hash: &str, candidates: Vec<serde_json::Value>, max_distance: i64) -> Result<Vec<Value>, String> {
    let h = unhex(hash)?;
    let mut out: Vec<(u32, Value)> = vec![];
    for c in &candidates {
        let Some(ch) = c.get("hash").and_then(Value::as_str) else { continue };
        let Ok(cb) = unhex(ch) else { continue };
        if let Ok(d) = distance(&h, &cb) {
            if d as i64 <= max_distance {
                out.push((d, json!({ "id": c.get("id").cloned().unwrap_or(Value::Null), "distance": d })));
            }
        }
    }
    out.sort_by_key(|(d, _)| *d);
    Ok(out.into_iter().map(|(_, v)| v).collect())
}
