// Files in Dropbox: small uploads, a big one by an upload session, folders listed by cursor, shared
// links, and a name with accents that must travel in a header.
//
//   DROPBOX_REFRESH_TOKEN=... DROPBOX_APP_KEY=... DROPBOX_APP_SECRET=... quillo run dropbox.qwe
//   then open /upload, /big, /list, /links, /files and /broken
//
// Or DROPBOX_ACCESS_TOKEN=... for a token from the app console.

use "dropbox.qwer"

route GET /upload {
    let one = dropbox_upload("/reports/año 2026 – résumé.txt", "first text", "add")?
    let two = dropbox_upload("/reports/note.txt", "version one", "add")?
    let three = dropbox_upload("/reports/note.txt", "version two", "update:" + two.rev)?
    {
        name: one.name,
        size: two.size,
        again: dropbox_upload("/reports/note.txt", "x", "add").error,
        stale: dropbox_upload("/reports/note.txt", "x", "update:" + two.rev).error,
        text: dropbox_download("/reports/note.txt")?.text,
        accents: dropbox_download("/reports/año 2026 – résumé.txt")?.metadata.name,
        rev_changed: three.rev != two.rev,
    }
}

// Bigger than a piece, so it goes through start, append and finish: this plugin's own source, in
// pieces of 8 KB (a real upload takes multiples of 4 MiB, the default).
route GET /big {
    let r = dropbox_upload_file("dropbox.qwer", "/backups/big.bin", "overwrite", 8)?
    { in_pieces: r.pieces > 1, same: dropbox_download("/backups/big.bin")?.text == read_file("dropbox.qwer")? }
}

route GET /list {
    let names = (d) => d.entries | map((e) => e.name) | sort
    let first = dropbox_list("/reports", { limit: 1 })?
    let next = dropbox_list_continue(first.cursor)?
    let all = dropbox_list_all("", true, 100)?
    let cut = dropbox_list_all("", true, 2)?
    { first: len(first.entries), more: first.more, next: len(next.entries), all: names(all), complete: all.complete, cut: cut.complete }
}

route GET /links {
    let made = dropbox_shared_link("/reports/note.txt", { requested_visibility: "public" })?
    let again = dropbox_shared_link("/reports/note.txt", null)?
    { url: made.url, new: made.new, same: again.url == made.url, second_new: again.new }
}

route GET /files {
    let folder = dropbox_create_folder("/archive")?
    let moved = dropbox_move("/reports/note.txt", "/archive/note.txt")?
    {
        folder: folder,
        folder_again: dropbox_create_folder("/archive")?,
        moved: moved.path_display,
        old: dropbox_metadata("/reports/note.txt")?,
        new: dropbox_metadata("/archive/note.txt")?.name,
        deleted: dropbox_delete("/archive/note.txt")?,
        deleted_again: dropbox_delete("/archive/note.txt")?,
    }
}

route GET /broken = {
    missing: dropbox_download("/nothing.txt").error,
    bad_path: dropbox_upload("no-slash.txt", "x", "add").error,
    bad_mode: dropbox_upload("/a.txt", "x", "replace").error,
    outside: dropbox_list("/does/not/exist", null).error,
}
