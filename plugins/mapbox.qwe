// Mapbox from the server: an address found, a route, travel times, a static map for an email, and
// tile URLs for a map library. The token stays in env.
//
//   MAPBOX_TOKEN=pk.... quillo run mapbox.qwe
//   then open http://localhost:8080/geocode?q=1600+Pennsylvania+Ave, /directions, /matrix, /static, /tiles and /refused

use "mapbox.qwer"

route GET /geocode ? { q: str } {
    let r = mapbox_geocode(q, { limit: 2, country: "us" })
    if is_err(r) { reply 502 r.error }
    r
}

route GET /more = {
    nothing: mapbox_geocode("nowhere", {})?,
    reverse: first(mapbox_reverse(38.8977, -77.0365, { limit: 1 })?).place,
    after_a_wait: first(mapbox_geocode("busy", {})?).type,
}

route GET /directions {
    let r = mapbox_directions([[38.8977, -77.0365], [38.9072, -77.0369]], { steps: true, annotations: "congestion" })?
    let best = first(r.routes)
    {
        distance: best.distance_m,
        line: best.geometry,
        said: first(best.legs).steps | map((s) => s.instruction),
        snapped: first(r.waypoints),
    }
}

route GET /matrix = {
    times: mapbox_matrix([[38.9, -77.0], [38.8, -77.1], [38.7, -77.2]], { profile: "walking" })?.durations,
    no_way: mapbox_matrix([[38.9, -77.0], [38.0, 170.0]], {})?.durations,
}

route GET /static = {
    plain: mapbox_static_url({ lat: 52.37, lon: 4.89, zoom: 12, width: 300, height: 200 })?,
    tilted: mapbox_static_url({ lat: 52.37, lon: 4.89, zoom: 14.5, bearing: 30, pitch: 45, retina: true, style: "mapbox/dark-v11" })?,
    pins: mapbox_static_url({ markers: [{ lat: 52.37, lon: 4.89, label: "a", color: "#ff0000" }, { lat: 52.38, lon: 4.9, size: "l", label: 7 }], padding: 40 })?,
    path: mapbox_static_url({ path: { points: [[38.5, -120.2], [40.7, -120.95], [43.252, -126.453]], width: 5, color: "f44", opacity: 0.5 } })?,
}

route GET /tiles = {
    amsterdam: mapbox_tile_at(52.37, 4.89, 12)?,
    world: mapbox_tile_at(0.0, 0.0, 0)?,
    raster: mapbox_tile_url("mapbox.satellite", 3, 1, 2, { format: "jpg90", retina: true })?,
    vector: mapbox_tile_url("mapbox.mapbox-streets-v8", 3, 1, 2, { format: "mvt" })?,
    style: mapbox_tile_url("mapbox/streets-v12", 3, 1, 2, {})?,
    template: mapbox_tile_url("mapbox.satellite", -1, -1, -1, {})?,
    polyline6: mapbox_decode_polyline(mapbox_encode_polyline([[38.8977, -77.0365]], 6)?, 6)?,
}

route GET /refused = {
    empty: mapbox_geocode(" ", {}).error,
    limit: mapbox_geocode("x", { limit: 50 }).error,
    option: mapbox_geocode("x", { colour: 1 }).error,
    off: mapbox_reverse(99.0, 0.0, {}).error,
    profile: mapbox_directions([[1, 2], [3, 4]], { profile: "boat" }).error,
    no_route: mapbox_directions([[38.9, -77.0], [38.0, 170.0]], {}).error,
    one: mapbox_directions([[1, 2]], {}).error,
    size: mapbox_static_url({ lat: 1, lon: 2, width: 3000 }).error,
    label: mapbox_static_url({ markers: [{ lat: 1, lon: 2, label: "hello" }] }).error,
    nothing: mapbox_static_url({}).error,
    long: mapbox_static_url({ path: { points: range(4000) | map((i) => [i / 100, i / 77]) } }).error,
    tile: mapbox_tile_url("mapbox.satellite", 1, 5, 0, {}).error,
    mercator: mapbox_tile_at(89.0, 0.0, 3).error,
}
