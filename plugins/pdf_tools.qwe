// A report's pages merged, picked, split and retitled.
//
//   quillo run pdf_tools.qwe      then open http://localhost:8080/info

use "pdf_tools.qwer"

let REPORT = "pdf_tools_sample.pdf"

route GET /info = pdf_info(REPORT)

// Two reports as one download.
route GET /merged.pdf {
    pdf_merge([REPORT, REPORT], "data/merged.pdf")?
    file("data/merged.pdf")
}

route GET /pieces {
    let merged = pdf_merge([REPORT, REPORT], "data/merged.pdf")?
    let summary = pdf_extract_pages(REPORT, [3, 1], "data/summary.pdf")?
    {
        merged_pages: merged,
        summary_pages: summary,
        split: pdf_split(REPORT, "data/pages")?,
        page_two: pdf_page_count("data/pages/page-2.pdf")?,
        no_such_page: is_err(pdf_extract_pages(REPORT, [9], "data/none.pdf")),
    }
}

route GET /retitle ? { title: str = "Rapport trimestriel · été" } =
    pdf_set_info(REPORT, "data/retitled.pdf", { title, author: "Quillo Café, Lyon" })
