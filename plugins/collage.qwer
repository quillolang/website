//! Several pictures put together into one: a grid of equal cells with gaps, or justified rows that keep each picture's shape, on the background you choose.
//! version: 1.0.0
//!
//! [dependencies]
//! image = { version = "0.25", default-features = false, features = ["png", "jpeg", "webp", "gif"] }

use image::{DynamicImage, ImageDecoder, Rgba, RgbaImage};
use serde_json::{json, Value};

const MAX_IMAGES: usize = 500;

fn reader(path: &str) -> Result<image::ImageReader<std::io::BufReader<std::fs::File>>, String> {
    let mut r = image::ImageReader::open(path).map_err(|e| format!("{}: {}", path, e))?.with_guessed_format().map_err(|e| format!("{}: {}", path, e))?;
    // A small file claiming to be enormous is refused before anything is allocated.
    let mut l = image::Limits::default();
    l.max_image_width = Some(12_000);
    l.max_image_height = Some(12_000);
    l.max_alloc = Some(512 * 1024 * 1024);
    r.limits(l);
    Ok(r)
}

// The picture turned upright by its EXIF orientation, as phones expect.
fn open(path: &str) -> Result<DynamicImage, String> {
    let mut dec = reader(path)?.into_decoder().map_err(|e| format!("{}: {}", path, e))?;
    let o = dec.orientation().unwrap_or(image::metadata::Orientation::NoTransforms);
    let mut img = DynamicImage::from_decoder(dec).map_err(|e| format!("{}: {}", path, e))?;
    img.apply_orientation(o);
    Ok(img)
}

// Saved in the format its extension names: .jpg (quality 88), .png, .webp (lossless) or .gif; folders are made.
fn save(img: &DynamicImage, path: &str) -> Result<(), String> {
    if let Some(dir) = std::path::Path::new(path).parent().filter(|d| !d.as_os_str().is_empty()) {
        std::fs::create_dir_all(dir).map_err(|e| format!("{}: {}", dir.display(), e))?;
    }
    let ext = path.rsplit_once('.').map(|(_, e)| e.to_lowercase()).unwrap_or_default();
    let err = |e: image::ImageError| format!("{}: {}", path, e);
    match ext.as_str() {
        "jpg" | "jpeg" => {
            let f = std::fs::File::create(path).map_err(|e| format!("{}: {}", path, e))?;
            image::codecs::jpeg::JpegEncoder::new_with_quality(std::io::BufWriter::new(f), 88).encode_image(&img.to_rgb8()).map_err(err)
        }
        "png" => img.save_with_format(path, image::ImageFormat::Png).map_err(err),
        "webp" => DynamicImage::ImageRgba8(img.to_rgba8()).save_with_format(path, image::ImageFormat::WebP).map_err(err),
        "gif" => DynamicImage::ImageRgba8(img.to_rgba8()).save_with_format(path, image::ImageFormat::Gif).map_err(err),
        _ => Err(format!("{}: save as .jpg, .png, .webp or .gif", path)),
    }
}
fn colour(o: &Value) -> Rgba<u8> {
    let h = o.get("background").and_then(Value::as_str).unwrap_or("#ffffff").trim_start_matches('#').to_string();
    match (h.len(), u32::from_str_radix(&h, 16)) {
        (6, Ok(v)) => Rgba([(v >> 16) as u8, (v >> 8) as u8, v as u8, 255]),
        (8, Ok(v)) => Rgba([(v >> 24) as u8, (v >> 16) as u8, (v >> 8) as u8, v as u8]),
        _ => Rgba([255, 255, 255, 255]),
    }
}

fn load_all(images: &[String]) -> Result<Vec<DynamicImage>, String> {
    if images.is_empty() || images.len() > MAX_IMAGES {
        return Err(format!("give 1 to {} pictures", MAX_IMAGES));
    }
    images.iter().map(|p| open(p)).collect()
}

/// A grid collage at `out`: `columns` cells to a row (1 to 50), the whole `width` pixels wide (100 to 8,000), cells `ratio` wide to 1 high (1 for squares, 1.5 for 3:2).
/// `options` (or null): `gap` between cells and around them in pixels (8), `background` "#rrggbb" (white, or "#rrggbbaa"), `fit` "cover" (fill each cell, cropping) or "contain" (show all).
/// `{ width, height, count }`.
pub fn collage_grid(images: Vec<String>, out: &str, columns: i64, width: i64, ratio: f64, options: serde_json::Value) -> Result<Value, String> {
    let imgs = load_all(&images)?;
    let cols = columns.clamp(1, 50) as u32;
    let gap = options.get("gap").and_then(Value::as_u64).unwrap_or(8).min(200) as u32;
    let w = width.clamp(100, 8000) as u32;
    let cw = (w.saturating_sub(gap * (cols + 1))) / cols;
    let ch = ((cw as f64 / ratio.clamp(0.1, 10.0)).round() as u32).max(1);
    if cw == 0 {
        return Err("the gaps take the whole width: make it wider or the gaps smaller".into());
    }
    let rows = (imgs.len() as u32).div_ceil(cols);
    let h = rows * ch + gap * (rows + 1);
    if h > 16_000 {
        return Err("the collage would be over 16,000 pixels high".into());
    }
    let cover = options.get("fit").and_then(Value::as_str) != Some("contain");
    let mut canvas = RgbaImage::from_pixel(w, h, colour(&options));
    for (i, img) in imgs.iter().enumerate() {
        let (c, r) = (i as u32 % cols, i as u32 / cols);
        let (x, y) = (gap + c * (cw + gap), gap + r * (ch + gap));
        let cell = if cover { img.resize_to_fill(cw, ch, image::imageops::FilterType::Lanczos3) } else { img.resize(cw, ch, image::imageops::FilterType::Lanczos3) };
        let (dx, dy) = ((cw - cell.width()) / 2, (ch - cell.height()) / 2);
        image::imageops::overlay(&mut canvas, &cell.to_rgba8(), (x + dx) as i64, (y + dy) as i64);
    }
    save(&DynamicImage::ImageRgba8(canvas), out)?;
    Ok(json!({ "width": w, "height": h, "count": imgs.len() }))
}

/// A collage of justified rows at `out`, as photo sites lay out albums: pictures keep their shape, each row is scaled to fill `width` exactly,
/// and rows are about `row_height` pixels high (the last row too, unless it would be stretched). `options`: `gap` and `background` as for `collage_grid`.
/// `{ width, height, count, rows }`.
pub fn collage_rows(images: Vec<String>, out: &str, width: i64, row_height: i64, options: serde_json::Value) -> Result<Value, String> {
    let imgs = load_all(&images)?;
    let gap = options.get("gap").and_then(Value::as_u64).unwrap_or(8).min(200) as f64;
    let w = width.clamp(100, 8000) as f64;
    let target = row_height.clamp(20, 4000) as f64;
    let inner = w - 2.0 * gap;
    // Fill each row with pictures at the target height until it is full, then scale it to fit.
    let mut rows: Vec<(Vec<usize>, f64)> = vec![];
    let mut cur: Vec<usize> = vec![];
    let mut sum = 0.0;
    for (i, img) in imgs.iter().enumerate() {
        let aspect = img.width() as f64 / img.height().max(1) as f64;
        cur.push(i);
        sum += aspect;
        let row_w = sum * target + gap * (cur.len() as f64 - 1.0);
        if row_w >= inner {
            let hgt = (inner - gap * (cur.len() as f64 - 1.0)) / sum;
            rows.push((std::mem::take(&mut cur), hgt));
            sum = 0.0;
        }
    }
    if !cur.is_empty() {
        let hgt = ((inner - gap * (cur.len() as f64 - 1.0)) / sum).min(target);
        rows.push((cur, hgt));
    }
    let h = rows.iter().map(|(_, rh)| rh.round()).sum::<f64>() + gap * (rows.len() as f64 + 1.0);
    if h > 16_000.0 {
        return Err("the collage would be over 16,000 pixels high".into());
    }
    let mut canvas = RgbaImage::from_pixel(w as u32, h as u32, colour(&options));
    let mut y = gap;
    for (idx, rh) in &rows {
        let rh = rh.round().max(1.0);
        let mut x = gap;
        for &i in idx {
            let img = &imgs[i];
            let iw = (img.width() as f64 * rh / img.height().max(1) as f64).round().max(1.0);
            let cell = img.resize_exact(iw as u32, rh as u32, image::imageops::FilterType::Lanczos3);
            image::imageops::overlay(&mut canvas, &cell.to_rgba8(), x as i64, y as i64);
            x += iw + gap;
        }
        y += rh + gap;
    }
    save(&DynamicImage::ImageRgba8(canvas), out)?;
    Ok(json!({ "width": w as i64, "height": h as i64, "count": imgs.len(), "rows": rows.len() }))
}
