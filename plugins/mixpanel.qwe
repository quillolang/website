// Product analytics in Mixpanel, from the server: events tracked, history imported, profiles kept,
// and reports read back.
//
//   MIXPANEL_TOKEN=... MIXPANEL_PROJECT_ID=... MIXPANEL_SERVICE_USER=... MIXPANEL_SERVICE_SECRET=... quillo run mixpanel.qwe
//   then open /track, /import, /people, /reports, /profiles, /ids and /failures
//
// MIXPANEL_API_URL and MIXPANEL_QUERY_URL pick a region or a test server.

use "mixpanel.qwer"

route GET /track = {
    one: mixpanel_track("Signed up", "user-1", { plan: "pro" }, {})?,
    many: mixpanel_track_many(map(range(0, 2500), (i) => { event: "Viewed", distinct_id: `user-${i % 5}`, properties: { n: i } }))?,
    old: mixpanel_track("Long ago", "user-1", {}, { time: 1600000000 }).error,
    no_name: mixpanel_track("", "user-1", {}, {}).error,
    bad_id: mixpanel_track("x", "user-1", {}, { insert_id: "not valid!" }).error,
}

route GET /import {
    let rows = map(range(0, 2100), (i) => { event: "Purchase", distinct_id: `user-${i}`, time: 1600000000 + i, properties: { total: i } })
    let bad = rows + [{ event: "Purchase", distinct_id: "user-x", time: 1, properties: {} }]
    let r = mixpanel_import(bad)?
    {
        imported: r.imported, failed: r.failed,
        no_time: mixpanel_import([{ event: "x", distinct_id: "u" }]).error,
        repeat: mixpanel_import(slice(rows, 0, 1))?.imported,
    }
}

route GET /people = {
    set: mixpanel_people("user-1", "set", { "$name": "Ada", plan: "pro" }, false)?,
    once: mixpanel_people("user-1", "set_once", { first_seen: "2026-11-01" }, true)?,
    add: mixpanel_people("user-1", "add", { logins: 1 }, false)?,
    unset: mixpanel_people("user-1", "unset", ["old_field"], false)?,
    delete: mixpanel_people("user-2", "delete", null, false)?,
    many: mixpanel_people_many(map(range(0, 2100), (i) => { distinct_id: `u${i}`, op: "set", value: { n: i } }))?,
    group: mixpanel_group_set("company_id", "acme", { name: "Acme", seats: 12 })?,
    bad_op: mixpanel_people("u", "merge", {}, false).error,
    bad_value: mixpanel_people("u", "set", [1], false).error,
    bad_unset: mixpanel_people("u", "unset", {}, false).error,
}

route GET /reports = {
    segmentation: mixpanel_segmentation("Signed up", "2026-10-01", "2026-10-02", { unit: "day" })?,
    funnel: mixpanel_funnel(7, "2026-10-01", "2026-10-02", {})?.meta.dates,
    retention: mixpanel_retention("2026-10-01", "2026-10-02", { born_event: "Signed up" })?["2026-10-01"].counts,
    insights: mixpanel_insights(12345)?.series,
    bad_date: mixpanel_segmentation("x", "October", "2026-10-02", {}).error,
    bad_query: mixpanel_funnel(999, "2026-10-01", "2026-10-02", {}).error,
}

route GET /profiles {
    let pro = mixpanel_profiles("properties[\"plan\"] == \"pro\"", 0)?
    { pro: len(pro), first: pro[0], all: len(mixpanel_profiles("", 0)?), capped: len(mixpanel_profiles("", 1200)?) }
}

route GET /ids = {
    id: mixpanel_insert_id(["order", 1001]),
    same: mixpanel_insert_id(["order", 1001]) == mixpanel_insert_id(["order", 1001]),
    other: mixpanel_insert_id(["order", 1002]) != mixpanel_insert_id(["order", 1001]),
}

route GET /failures = {
    waited: mixpanel_track("Busy", "user-1", {}, {})?,
    refused: mixpanel_track("Refused", "user-1", {}, {}).error,
    wrong_account: mixpanel_insights(403).error,
}
