// Settings and translations moved over from a Java (Spring) service.
//
//   quillo run java_properties.qwe      then open http://localhost:8080/settings

use "java_properties.qwer"

route GET /settings {
    let p = properties_read_file("java_properties_sample.properties")?
    { port: int(p["server.port"])?, database: p["spring.datasource.url"], user: p["spring.datasource.username"], welcome: p["app.welcome"], greeting: p["greeting.de"], uploads: p["path.uploads"] }
}

route GET /messages_de.properties = respond(200, properties_write({ "cart.title": "Warenkorb", "cart.empty": "Ihr Warenkorb ist leer.", "checkout.pay": "Jetzt bezahlen: 12,50 €" }, "German messages, made by Quillo"), { "content-type": "text/plain; charset=iso-8859-1" })

route GET /roundtrip {
    let p = properties_read_file("java_properties_sample.properties")?
    properties_parse(properties_write(p, ""))? == p
}
