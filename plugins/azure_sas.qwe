// Invoices downloaded straight from Azure Blob Storage, and uploads that skip the server.
//
//   AZURE_ACCOUNT=myshop AZURE_KEY=<key from Access keys> quillo run azure_sas.qwe      then open http://localhost:8080/invoice/1042
//   (the default key is Azurite's well-known development key)

use "azure_sas.qwer"

let ACCOUNT = env("AZURE_ACCOUNT", "devstoreaccount1")
let KEY = env("AZURE_KEY", "Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==")

route GET /invoice/:id(int) = redirect(azure_blob_url(ACCOUNT, KEY, "invoices", `2026/invoice-${id}.pdf`, "r", 300)?)

route GET /upload-link {
    let name = `uploads/${uuid()}.jpg`
    // The page PUTs the file to it with the header x-ms-blob-type: BlockBlob.
    { name, put: azure_blob_url(ACCOUNT, KEY, "photos", name, "cw", 600)? }
}

route GET /token {
    let t = azure_sas_token(ACCOUNT, KEY, "invoices", "2026/invoice-1042.pdf", "rw", 3600, "1772355600")?
    { token: t, same_again: t == azure_sas_token(ACCOUNT, KEY, "invoices", "2026/invoice-1042.pdf", "wr", 3600, "1772355600")?,
      wrong: azure_sas_token(ACCOUNT, KEY, "invoices", "", "rz", 60, "").error }
}
