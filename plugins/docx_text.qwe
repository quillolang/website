// A Word document read for an import: its text, its outline and its table.
//
//   quillo run docx_text.qwe      then open http://localhost:8080/read

use "docx_text.qwer"

let DOC = "docx_text_sample.docx"

route GET /read = { text: docx_text(DOC)?, properties: docx_properties(DOC)? }

route GET /outline = docx_paragraphs(DOC)? | filter((p) => p.heading != null) | map((p) => p.text)

// The table's rows as records, its header row left out.
route GET /hours {
    let rows = docx_tables(DOC)?[0]
    drop(rows, 1) | map((r) => { day: r[0], hours: r[1] })
}
