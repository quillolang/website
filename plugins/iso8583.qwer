fn enc_name(e: Enc) -> &'static str {
    match e {
        Enc::Ascii => "ascii",
        Enc::Bcd => "bcd",
        Enc::Bin => "binary",
        Enc::Hex => "hex",
    }
}

fn enc_of(s: &str, what: &str) -> Result<Enc, String> {
    match s.to_ascii_lowercase().as_str() {
        "ascii" | "a" => Ok(Enc::Ascii),
        "bcd" | "packed" => Ok(Enc::Bcd),
        "binary" | "bin" | "b" => Ok(Enc::Bin),
        "hex" => Ok(Enc::Hex),
        _ => Err(format!("{}: {} is not an encoding (ascii, bcd, binary or hex)", what, s)),
    }
}

/// A built-in spec: "ascii" (ASCII data and lengths, a binary bitmap: the most common), "ascii-hex" (the bitmap and binary fields as hex text too) or "bcd" (numbers, lengths and the MTI packed two digits a byte).
fn builtin(name: &str) -> Result<Spec, String> {
    let (mti, bitmap, num, len, bin) = match name {
        "ascii" | "1987" | "1987-ascii" | "" => (Enc::Ascii, Enc::Bin, Enc::Ascii, Enc::Ascii, Enc::Bin),
        "ascii-hex" | "1987-ascii-hex" => (Enc::Ascii, Enc::Hex, Enc::Ascii, Enc::Ascii, Enc::Hex),
        "bcd" | "1987-bcd" => (Enc::Bcd, Enc::Bin, Enc::Bcd, Enc::Bcd, Enc::Bin),
        _ => return Err(format!("no built-in spec {}: ascii, ascii-hex or bcd, or give the spec as data", name)),
    };
    let mut fields = vec![None; 129];
    for &(n, kind, max, prefix, label) in ISO1987 {
        let data = match kind {
            "b" => bin,
            "n" | "z" => num,
            _ => Enc::Ascii,
        };
        fields[n] = Some(Field { name: label.to_string(), kind: kind.to_string(), max, prefix, data, length: len, pad: if kind == "z" { "rightF".into() } else { "left".into() } });
    }
    Ok(Spec { mti, bitmap, fields })
}

fn spec_of(v: &Value) -> Result<Spec, String> {
    match v {
        Value::Null => builtin("ascii"),
        Value::String(s) => builtin(s),
        Value::Object(m) => {
            let mut spec = builtin(m.get("base").and_then(|b| b.as_str()).unwrap_or("ascii"))?;
            if let Some(s) = m.get("mti").and_then(|x| x.as_str()) {
                spec.mti = enc_of(s, "mti")?;
            }
            if let Some(s) = m.get("bitmap").and_then(|x| x.as_str()) {
                spec.bitmap = enc_of(s, "bitmap")?;
            }
            if let Some(Value::Object(fs)) = m.get("fields") {
                for (k, f) in fs {
                    let n: usize = k.parse().ok().filter(|n| (2..=128).contains(n)).ok_or(format!("spec field {}: fields are numbered 2 to 128", k))?;
                    if f.is_null() {
                        spec.fields[n] = None;
                        continue;
                    }
                    let old = spec.fields[n].clone();
                    let kind = o_str(f, "type").or(old.as_ref().map(|o| o.kind.clone())).ok_or(format!("spec field {}: give its type (n, an, ans, b, z, ns or xn)", n))?;
                    if !["n", "an", "ans", "as", "a", "b", "z", "ns", "xn"].contains(&kind.as_str()) {
                        return Err(format!("spec field {}: {} is not a type (n, a, an, ans, as, b, z, ns or xn)", n, kind));
                    }
                    let max = o_i64(f, "max", old.as_ref().map_or(-1, |o| o.max as i64));
                    if max < 1 {
                        return Err(format!("spec field {}: give its max length", n));
                    }
                    let prefix = o_i64(f, "prefix", old.as_ref().map_or(0, |o| o.prefix as i64));
                    if ![0, 1, 2, 3, 4].contains(&prefix) {
                        return Err(format!("spec field {}: prefix is the length's digits: 0 (fixed), 2 (LLVAR) or 3 (LLLVAR)", n));
                    }
                    let default_data = if kind == "b" { Enc::Bin } else { Enc::Ascii };
                    let data = match o_str(f, "data") {
                        Some(s) => enc_of(&s, &format!("spec field {} data", n))?,
                        None => old.as_ref().filter(|o| o.kind == kind).map_or(default_data, |o| o.data),
                    };
                    let length = match o_str(f, "length") {
                        Some(s) => enc_of(&s, &format!("spec field {} length", n))?,
                        None => old.as_ref().map_or(Enc::Ascii, |o| o.length),
                    };
                    spec.fields[n] = Some(Field {
                        name: o_str(f, "name").or(old.as_ref().map(|o| o.name.clone())).unwrap_or_else(|| format!("Field {}", n)),
                        kind,
                        max: max as usize,
                        prefix: prefix as usize,
                        data,
                        length,
                        pad: o_str(f, "pad").or(old.as_ref().map(|o| o.pad.clone())).unwrap_or_else(|| "left".into()),
                    });
                }
            }
            Ok(spec)
        }
        _ => Err("the spec is a name (ascii, ascii-hex, bcd) or a map: { base, mti, bitmap, fields: { \"2\": { type, max, prefix, data, length } } }".into()),
    }
}

fn spec_value(s: &Spec) -> Value {
    let mut fields = serde_json::Map::new();
    for (n, f) in s.fields.iter().enumerate() {
        if let Some(f) = f {
            fields.insert(n.to_string(), json!({ "name": f.name, "type": f.kind, "max": f.max, "prefix": f.prefix, "data": enc_name(f.data), "length": enc_name(f.length), "pad": f.pad }));
        }
    }
    json!({ "mti": enc_name(s.mti), "bitmap": enc_name(s.bitmap), "fields": fields })
}

// ---- Packing ----

fn hex(b: &[u8]) -> String {
    b.iter().map(|x| format!("{:02X}", x)).collect()
}

fn unhex(s: &str) -> Result<Vec<u8>, String> {
    let s: String = s.chars().filter(|c| !c.is_whitespace()).collect();
    if s.len() % 2 != 0 {
        return Err("hex text of an odd length".into());
    }
    (0..s.len()).step_by(2).map(|i| u8::from_str_radix(&s[i..i + 2], 16).map_err(|_| format!("{} is not hex", &s[i..i + 2]))).collect()
}

fn nibble(c: char) -> Result<u8, String> {
    match c {
        '0'..='9' => Ok(c as u8 - b'0'),
        '=' | 'D' | 'd' => Ok(0xD),
        'F' | 'f' => Ok(0xF),
        _ => Err(format!("{:?} cannot be packed in BCD", c)),
    }
}

fn bcd(digits: &str, pad: &str) -> Result<Vec<u8>, String> {
    let mut d: Vec<char> = digits.chars().collect();
    if d.len() % 2 == 1 {
        match pad {
            "right" => d.push('0'),
            "rightF" | "F" => d.push('F'),
            _ => d.insert(0, '0'),
        }
    }
    d.chunks(2).map(|p| Ok(nibble(p[0])? << 4 | nibble(p[1])?)).collect()
}

fn unbcd(b: &[u8], count: usize, pad: &str) -> String {
    let mut s: String = b.iter().flat_map(|x| [x >> 4, x & 15]).map(|n| match n {
        0..=9 => (b'0' + n) as char,
        0xD => '=',
        _ => 'F',
    }).collect();
    if s.len() > count {
        if pad == "left" {
            s.remove(0);
        } else {
            s.pop();
        }
    }
    s
}

fn len_bytes(n: usize, digits: usize, e: Enc) -> Result<Vec<u8>, String> {
    Ok(match e {
        Enc::Ascii | Enc::Hex => format!("{:0w$}", n, w = digits).into_bytes(),
        Enc::Bcd => bcd(&format!("{:0w$}", n, w = digits + digits % 2), "left")?,
        Enc::Bin => {
            let k = (digits + 1) / 2;
            (0..k).rev().map(|i| (n >> (8 * i)) as u8).collect()
        }
    })
}

fn len_size(digits: usize, e: Enc) -> usize {
    match e {
        Enc::Ascii | Enc::Hex => digits,
        Enc::Bcd | Enc::Bin => (digits + 1) / 2,
    }
}

fn text_value(v: &Value) -> Option<String> {
    match v {
        Value::String(s) => Some(s.clone()),
        Value::Number(n) => Some(n.to_string()),
        _ => None,
    }
}

fn pack_field(n: usize, f: &Field, v: &Value) -> Result<Vec<u8>, String> {
    let mut s = text_value(v).ok_or(format!("field {} ({}): give text or a number", n, f.name))?;
    let numeric = f.kind == "n";
    if numeric && !s.chars().all(|c| c.is_ascii_digit()) {
        return Err(format!("field {} ({}) takes digits only: {:?}", n, f.name, s));
    }
    if f.kind == "xn" && !(s.starts_with('C') || s.starts_with('D')) {
        return Err(format!("field {} ({}) starts with C (credit) or D (debit): {:?}", n, f.name, s));
    }
    let binary = f.kind == "b";
    let bytes_in = if binary { Some(unhex(&s).map_err(|e| format!("field {} ({}) is binary, written as hex: {}", n, f.name, e))?) } else { None };
    // The length that counts: bytes for binary data, characters (digits) for the rest.
    let mut count = bytes_in.as_ref().map_or(s.chars().count(), |b| b.len());
    if f.prefix == 0 && count < f.max {
        if binary {
            return Err(format!("field {} ({}) is {} bytes, not {}", n, f.name, f.max, count));
        }
        let fill = f.max - count;
        s = if numeric {
            format!("{}{}", "0".repeat(fill), s)
        } else if f.kind == "xn" {
            format!("{}{}{}", &s[..1], "0".repeat(fill), &s[1..])
        } else {
            format!("{}{}", s, " ".repeat(fill))
        };
        count = f.max;
    }
    if count > f.max {
        return Err(format!("field {} ({}) is at most {} {}, not {}", n, f.name, f.max, if binary { "bytes" } else { "characters" }, count));
    }
    let data = match (f.data, &bytes_in) {
        (Enc::Bin, Some(b)) => b.clone(),
        (Enc::Hex, Some(b)) => hex(b).into_bytes(),
        (Enc::Bcd, _) if numeric || f.kind == "z" => bcd(&s, &f.pad)?,
        (Enc::Bin | Enc::Bcd | Enc::Hex, None) => s.clone().into_bytes(),
        (Enc::Ascii, Some(_)) => s.to_ascii_uppercase().into_bytes(),
        (Enc::Ascii, None) => {
            if !s.is_ascii() {
                return Err(format!("field {} ({}) holds characters outside ASCII", n, f.name));
            }
            s.clone().into_bytes()
        }
        (Enc::Bcd, _) => s.clone().into_bytes(),
    };
    let mut out = vec![];
    if f.prefix > 0 {
        // A hex-written binary field counts the characters on the wire.
        let shown = if f.data == Enc::Hex && binary { count * 2 } else { count };
        out.extend(len_bytes(shown, f.prefix, f.length)?);
    }
    out.extend(data);
    Ok(out)
}

fn field_no(k: &str) -> Option<usize> {
    k.trim().parse::<usize>().ok().filter(|n| (1..=128).contains(n))
}

fn pack(msg: &Value, spec: &Spec) -> Result<Vec<u8>, String> {
    let m = msg.as_object().ok_or("the message is a map: { mti: \"0200\", \"2\": \"4761...\", \"3\": \"000000\", ... }")?;
    let mti = m.get("mti").and_then(text_value).ok_or("the message has no mti (\"0200\", \"0800\", ...)")?;
    if mti.len() != 4 || !mti.chars().all(|c| c.is_ascii_digit()) {
        return Err(format!("the MTI is four digits, not {:?}", mti));
    }
    let mut present = BTreeMap::new();
    for (k, v) in m {
        if k == "mti" || k == "bitmap" || v.is_null() {
            continue;
        }
        let n = field_no(k).ok_or(format!("{:?} is not a field number (2 to 128) or mti", k))?;
        if n == 1 {
            continue;
        }
        present.insert(n, v);
    }
    let secondary = present.keys().any(|&n| n > 64);
    let mut bits = [0u8; 16];
    if secondary {
        bits[0] |= 0x80;
    }
    for &n in present.keys() {
        bits[(n - 1) / 8] |= 0x80 >> ((n - 1) % 8);
    }
    let mut out = match spec.mti {
        Enc::Bcd | Enc::Bin => bcd(&mti, "left")?,
        _ => mti.into_bytes(),
    };
    let map = &bits[..if secondary { 16 } else { 8 }];
    match spec.bitmap {
        Enc::Hex | Enc::Ascii => out.extend(hex(map).into_bytes()),
        _ => out.extend_from_slice(map),
    }
    for (n, v) in present {
        let f = spec.fields[n].as_ref().ok_or(format!("field {} is not in the spec: add it under fields", n))?;
        out.extend(pack_field(n, f, v)?);
    }
    Ok(out)
}

fn unpack(b: &[u8], spec: &Spec) -> Result<Value, String> {
    let mut at = 0usize;
    let take = |at: &mut usize, n: usize, what: &str| -> Result<Vec<u8>, String> {
        if *at + n > b.len() {
            return Err(format!("the message ends inside {} (byte {} of {})", what, *at, b.len()));
        }
        let r = b[*at..*at + n].to_vec();
        *at += n;
        Ok(r)
    };
    let mti = match spec.mti {
        Enc::Bcd | Enc::Bin => unbcd(&take(&mut at, 2, "the MTI")?, 4, "left"),
        _ => String::from_utf8_lossy(&take(&mut at, 4, "the MTI")?).to_string(),
    };
    let read_map = |at: &mut usize| -> Result<Vec<u8>, String> {
        match spec.bitmap {
            Enc::Hex | Enc::Ascii => unhex(&String::from_utf8_lossy(&take(at, 16, "the bitmap")?)),
            _ => take(at, 8, "the bitmap"),
        }
    };
    let mut bits = read_map(&mut at)?;
    if bits[0] & 0x80 != 0 {
        bits.extend(read_map(&mut at)?);
    }
    let mut out = serde_json::Map::new();
    out.insert("mti".into(), json!(mti));
    out.insert("bitmap".into(), json!(hex(&bits)));
    for n in 2..=bits.len() * 8 {
        if bits[(n - 1) / 8] & (0x80 >> ((n - 1) % 8)) == 0 {
            continue;
        }
        let f = spec.fields.get(n).and_then(|f| f.as_ref()).ok_or(format!("field {} is in the bitmap, and the spec does not say how it is written: add it under fields", n))?;
        let what = format!("field {} ({})", n, f.name);
        let count = if f.prefix > 0 {
            let raw = take(&mut at, len_size(f.prefix, f.length), &what)?;
            match f.length {
                Enc::Bin => raw.iter().fold(0usize, |a, x| a << 8 | *x as usize),
                Enc::Bcd => unbcd(&raw, 99, "left").parse().map_err(|_| format!("{}: its length is not BCD", what))?,
                _ => String::from_utf8_lossy(&raw).parse().map_err(|_| format!("{}: its length {:?} is not a number", what, String::from_utf8_lossy(&raw)))?,
            }
        } else if f.kind == "b" && f.data == Enc::Hex {
            f.max * 2
        } else {
            f.max
        };
        let wire_max = if f.kind == "b" && f.data == Enc::Hex { f.max * 2 } else { f.max };
        if count > wire_max {
            return Err(format!("{} says {} long, more than its {}: is the spec right?", what, count, wire_max));
        }
        let value = match f.data {
            Enc::Bcd if f.kind == "n" || f.kind == "z" => unbcd(&take(&mut at, (count + 1) / 2, &what)?, count, &f.pad),
            Enc::Bin if f.kind == "b" => hex(&take(&mut at, count, &what)?),
            _ => {
                let raw = take(&mut at, count, &what)?;
                String::from_utf8_lossy(&raw).to_string()
            }
        };
        out.insert(n.to_string(), json!(value));
    }
    if at != b.len() {
        return Err(format!("{} bytes left after the last field: is the spec right?", b.len() - at));
    }
    Ok(Value::Object(out))
}

// ---- Meanings ----

fn mti_meaning(mti: &str) -> Value {
    let d: Vec<u32> = mti.chars().filter_map(|c| c.to_digit(10)).collect();
    if d.len() != 4 {
        return json!(null);
    }
    let version = match d[0] {
        0 => "ISO 8583:1987",
        1 => "ISO 8583:1993",
        2 => "ISO 8583:2003",
        8 => "national",
        9 => "private",
        _ => "reserved",
    };
    let class = ["reserved", "authorization", "financial", "file action", "reversal or chargeback", "reconciliation", "administrative", "fee collection", "network management", "reserved"][d[1] as usize];
    let function = ["request", "request response", "advice", "advice response", "notification", "notification acknowledgement", "instruction", "instruction acknowledgement", "reserved", "reserved"][d[2] as usize];
    let origin = ["acquirer", "acquirer repeat", "issuer", "issuer repeat", "other", "other repeat", "reserved", "reserved", "reserved", "reserved"][d[3] as usize];
    let reply = if d[2] % 2 == 0 && d[2] < 8 { Some(format!("{}{}{}{}", d[0], d[1], d[2] + 1, d[3])) } else { None };
    json!({ "version": version, "class": class, "function": function, "origin": origin, "reply": reply })
}

fn response_meaning(code: &str) -> &'static str {
    match code {
        "00" => "approved",
        "01" => "refer to card issuer",
        "02" => "refer to card issuer, special condition",
        "03" => "invalid merchant",
        "04" => "pick up card",
        "05" => "do not honour",
        "06" => "error",
        "07" => "pick up card, special condition",
        "08" => "honour with identification",
        "10" => "approved for partial amount",
        "11" => "approved (VIP)",
        "12" => "invalid transaction",
        "13" => "invalid amount",
        "14" => "invalid card number",
        "15" => "no such issuer",
        "19" => "re-enter transaction",
        "21" => "no action taken",
        "25" => "unable to locate record",
        "30" => "format error",
        "39" => "no credit account",
        "41" => "lost card, pick up",
        "43" => "stolen card, pick up",
        "51" => "insufficient funds",
        "52" => "no checking account",
        "53" => "no savings account",
        "54" => "expired card",
        "55" => "incorrect PIN",
        "57" => "transaction not permitted to cardholder",
        "58" => "transaction not permitted to terminal",
        "59" => "suspected fraud",
        "61" => "exceeds withdrawal amount limit",
        "62" => "restricted card",
        "63" => "security violation",
        "65" => "exceeds withdrawal frequency limit",
        "68" => "response received too late",
        "75" => "allowable number of PIN tries exceeded",
        "76" => "invalid account",
        "78" => "card not activated",
        "85" => "no reason to decline",
        "91" => "issuer or switch inoperative",
        "92" => "destination cannot be found for routing",
        "94" => "duplicate transmission",
        "96" => "system malfunction",
        _ => "unknown",
    }
}

fn masked(pan: &str) -> String {
    let n = pan.len();
    if n <= 10 {
        return "*".repeat(n);
    }
    format!("{}{}{}", &pan[..6], "*".repeat(n - 10), &pan[n - 4..])
}

fn explain(msg: &Value, spec: &Spec) -> Value {
    let mti = msg.get("mti").and_then(text_value).unwrap_or_default();
    let mut fields = vec![];
    let mut keys: Vec<(usize, &Value)> = msg.as_object().map(|m| m.iter().filter_map(|(k, v)| field_no(k).map(|n| (n, v))).collect()).unwrap_or_default();
    keys.sort_by_key(|k| k.0);
    for (n, v) in keys {
        let name = spec.fields.get(n).and_then(|f| f.as_ref()).map_or(format!("Field {}", n), |f| f.name.clone());
        let mut value = text_value(v).unwrap_or_default();
        // Card data is never shown whole.
        match n {
            2 | 34 => value = masked(&value),
            35 | 45 | 36 => value = format!("({} characters, hidden)", value.len()),
            52 => value = "(PIN block, hidden)".into(),
            _ => {}
        }
        let mut e = json!({ "field": n, "name": name, "value": value });
        if n == 39 {
            e["meaning"] = json!(response_meaning(&value));
        }
        if n == 4 {
            if let Ok(minor) = value.parse::<i64>() {
                e["amount"] = json!(format!("{}.{:02}", minor / 100, minor % 100));
            }
        }
        fields.push(e);
    }
    let code = msg.get("39").and_then(text_value);
    json!({
        "mti": mti,
        "meaning": mti_meaning(&mti),
        "approved": code.as_deref().map(|c| c == "00" || c == "10" || c == "11"),
        "response": code.as_deref().map(response_meaning),
        "fields": fields,
    })
}

// ---- Sending ----

static LINKS: Mutex<Option<HashMap<String, Stream>>> = Mutex::new(None);

fn frame_header(len: usize, kind: &str) -> Result<Vec<u8>, String> {
    match kind {
        "2" | "2b" | "binary" | "" => {
            if len > 0xffff {
                return Err("a message over 65535 bytes does not fit a 2-byte length".into());
            }
            Ok(vec![(len >> 8) as u8, len as u8])
        }
        "4" | "4a" | "ascii" => Ok(format!("{:04}", len).into_bytes()),
        "4b" => Ok((len as u32).to_be_bytes().to_vec()),
        "none" => Ok(vec![]),
        _ => Err(format!("header {}: 2 (two bytes, the default), 4b (four bytes), 4a (four ASCII digits) or none", kind)),
    }
}

fn read_frame(s: &mut Stream, kind: &str, t: Duration) -> Result<Vec<u8>, String> {
    let _ = s.tcp().set_read_timeout(Some(t));
    let mut exact = |n: usize| -> Result<Vec<u8>, String> {
        let mut b = vec![0u8; n];
        s.read_exact(&mut b).map_err(|e| match e.kind() {
            std::io::ErrorKind::WouldBlock | std::io::ErrorKind::TimedOut => "no answer in time (timeout_ms)".to_string(),
            std::io::ErrorKind::UnexpectedEof => "the host closed the connection".to_string(),
            _ => e.to_string(),
        })?;
        Ok(b)
    };
    let n = match kind {
        "4" | "4a" | "ascii" => String::from_utf8_lossy(&exact(4)?).trim().parse::<usize>().map_err(|_| "the length header is not four digits".to_string())?,
        "4b" => exact(4)?.iter().fold(0usize, |a, x| a << 8 | *x as usize),
        "none" => return Err("header none: the answer cannot be told apart from the next; use a length header".into()),
        _ => exact(2)?.iter().fold(0usize, |a, x| a << 8 | *x as usize),
    };
    exact(n)
}

/// Packs `message` by `spec` (a name: "ascii", the 1987 fields in ASCII with a binary bitmap; "ascii-hex"; "bcd"; or a spec as data, see `iso8583_spec`) and gives its bytes as hex.
pub fn iso8583_pack(message: serde_json::Value, spec: serde_json::Value) -> Result<String, String> {
    Ok(hex(&pack(&message, &spec_of(&spec)?)?))
}

/// Unpacks a message's bytes (as hex) by `spec`: `{ mti, bitmap, "2": ..., "3": ... }`, the fields as text (binary ones as hex).
pub fn iso8583_unpack(hex_bytes: &str, spec: serde_json::Value) -> Result<Value, String> {
    unpack(&unhex(hex_bytes)?, &spec_of(&spec)?)
}

/// A built-in spec as data ("ascii", "ascii-hex" or "bcd"), to change and pass back: `{ mti, bitmap, fields: { "2": { name, type, max, prefix, data, length, pad } } }`. A spec of your own can also be `{ base: "bcd", fields: { "48": { type: "ans", max: 50, prefix: 3 } } }`.
pub fn iso8583_spec(name: &str) -> Result<Value, String> {
    Ok(spec_value(&builtin(name)?))
}

/// What an MTI means: `{ version, class, function, origin, reply }` ("0200": a 1987 financial request from the acquirer, answered by 0210).
pub fn iso8583_mti(mti: &str) -> Value {
    mti_meaning(mti)
}

/// A message read for people and logs: the MTI's meaning, each field named, the response code's meaning, the amount, and card data masked.
pub fn iso8583_explain(message: serde_json::Value, spec: serde_json::Value) -> Result<Value, String> {
    Ok(explain(&message, &spec_of(&spec)?))
}

/// Sends `message` to `host` (host:port) and gives the answer unpacked, with `explain`. Each message goes with a 2-byte length first (options: `header` "2", "4b", "4a"; `prefix_hex`, bytes such as a TPDU sent after the length and taken off the answer). The answer is the first one with the same STAN (field 11) and the reply MTI; others are skipped. Options also `timeout_ms` (10000), `tls`, `ca`, `insecure`, `keep` (true: the connection stays open).
pub fn iso8583_send(host: &str, message: serde_json::Value, spec: serde_json::Value, opts: serde_json::Value) -> Result<Value, String> {
    let sp = spec_of(&spec)?;
    let body = pack(&message, &sp)?;
    let header = o_str(&opts, "header").unwrap_or_else(|| "2".into());
    let prefix = unhex(&o_str(&opts, "prefix_hex").unwrap_or_default())?;
    let mut framed = frame_header(body.len() + prefix.len(), &header)?;
    framed.extend(&prefix);
    framed.extend(&body);
    let t = timeout_of(&opts);
    let keep = o_bool(&opts, "keep", true);
    let tls = o_bool(&opts, "tls", false);
    let key = format!("{}|{}", host, tls);
    let open = || -> Result<Stream, String> {
        let (name, port) = split_host(host, 0)?;
        if port == 0 {
            return Err(format!("{}: give the port (host:port)", host));
        }
        let tcp = connect(&name, port, t)?;
        if tls { tls_wrap(tcp, &name, &opts) } else { Ok(Stream::Plain(tcp)) }
    };
    let kept = if keep { LINKS.lock().unwrap_or_else(|e| e.into_inner()).get_or_insert_with(HashMap::new).remove(&key) } else { None };
    let reused = kept.is_some();
    let mut s = match kept {
        Some(s) => s,
        None => open()?,
    };
    if s.write_all(&framed).and_then(|_| s.flush()).is_err() {
        if !reused {
            return Err(format!("cannot write to {}", host));
        }
        s = open()?;
        s.write_all(&framed).and_then(|_| s.flush()).map_err(|e| format!("cannot write to {}: {}", host, e))?;
    }
    let mti = message.get("mti").and_then(text_value).unwrap_or_default();
    let want_mti = mti_meaning(&mti)["reply"].as_str().map(|s| s.to_string());
    let stan = message.get("11").and_then(text_value);
    let until = Instant::now() + t;
    loop {
        let left = until.saturating_duration_since(Instant::now());
        if left.is_zero() {
            return Err(format!("{}: no answer to {} in time (timeout_ms)", host, mti));
        }
        let raw = match read_frame(&mut s, &header, left) {
            Ok(r) => r,
            Err(e) => return Err(format!("{}: {}", host, e)),
        };
        if raw.len() < prefix.len() {
            continue;
        }
        let got = unpack(&raw[prefix.len()..], &sp)?;
        let same_stan = match &stan {
            Some(x) => got.get("11").and_then(text_value).map_or(true, |y| y.trim_start_matches('0') == x.trim_start_matches('0')),
            None => true,
        };
        let same_mti = want_mti.as_ref().map_or(true, |w| got["mti"].as_str() == Some(w.as_str()));
        if same_stan && same_mti {
            if keep {
                LINKS.lock().unwrap_or_else(|e| e.into_inner()).get_or_insert_with(HashMap::new).insert(key, s);
            }
            let mut out = got.clone();
            out["explain"] = explain(&got, &sp);
            return Ok(out);
        }
    }
}

/// Closes the kept connection to `host`; whether there was one.
pub fn iso8583_close(host: &str) -> bool {
    let mut g = LINKS.lock().unwrap_or_else(|e| e.into_inner());
    let m = g.get_or_insert_with(HashMap::new);
    let before = m.len();
    m.retain(|k, _| !k.starts_with(&format!("{}|", host)));
    before != m.len()
}
