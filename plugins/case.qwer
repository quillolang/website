//! Text in every case programmers and writers use: snake_case, camelCase, kebab-case, Title Case, Sentence case.
//! version: 1.0.0
//!
//! [dependencies]
//! heck = "0.5"

use heck::{ToKebabCase, ToLowerCamelCase, ToShoutySnakeCase, ToSnakeCase, ToTitleCase, ToUpperCamelCase};

/// `text` in snake_case: "Hello World" and "helloWorld" are both "hello_world".
pub fn case_snake(text: &str) -> String {
    text.to_snake_case()
}

/// `text` in camelCase ("helloWorld"), or PascalCase ("HelloWorld") when `upper` is true.
pub fn case_camel(text: &str, upper: bool) -> String {
    if upper { text.to_upper_camel_case() } else { text.to_lower_camel_case() }
}

/// `text` in kebab-case, for addresses and CSS classes: "Hello World" is "hello-world".
pub fn case_kebab(text: &str) -> String {
    text.to_kebab_case()
}

/// `text` in SCREAMING_SNAKE_CASE, for environment variables and constants.
pub fn case_constant(text: &str) -> String {
    text.to_shouty_snake_case()
}

/// `text` in Title Case, each word with a capital: "user_first_name" is "User First Name".
pub fn case_title(text: &str) -> String {
    text.to_title_case()
}

/// `text` in Sentence case: the words split as for the others, the first with a capital, the rest lower case.
pub fn case_sentence(text: &str) -> String {
    let words = text.to_snake_case().replace('_', " ");
    let mut c = words.chars();
    match c.next() {
        Some(f) => f.to_uppercase().collect::<String>() + c.as_str(),
        None => String::new(),
    }
}
