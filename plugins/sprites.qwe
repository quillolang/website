// A shop's icons: the PNG ones packed into one sheet with CSS classes (one download instead of many), and the SVG ones gathered into one SVG of symbols.
//
//   quillo run sprites.qwe      then open http://localhost:8080/

use "sprites.qwer"

let PNGS = ["sprites_sample_heart.png", "sprites_sample_star.png", "sprites_sample_cart.png"]
let SHEET = sprites_pack(PNGS, "data/sprites/icons.png", { names: ["heart", "star", "cart"], prefix: "icon-", url: "/sprites/icons.png" })?
let SYMBOLS = sprites_svg(["sprites_sample_home.svg", "sprites_sample_user.svg"], "icon-", ["home", "user"])?

route GET /sprites/icons.png = file("data/sprites/icons.png")

route GET /sheet = { width: SHEET.width, height: SHEET.height, frames: SHEET.frames, retina: sprites_pack(PNGS, "data/sprites/icons@2x.png", { names: ["heart", "star", "cart"], scale: 2.0 })?.css }

route GET /icons.css = respond(200, SHEET.css, { "content-type": "text/css" })

route GET /symbols.svg = respond(200, SYMBOLS, { "content-type": "image/svg+xml" })

route GET / = <html>
    <head><link rel="stylesheet" href="/icons.css"/></head>
    <body>
        {raw(SYMBOLS)}
        <p><span class="icon-heart"></span> <span class="icon-star"></span> <span class="icon-cart"></span></p>
        <p><svg width="24" height="24"><use href="#icon-home"/></svg> <svg width="24" height="24"><use href="#icon-user"/></svg></p>
    </body>
</html>
