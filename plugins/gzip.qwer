//! Gzip files and text, and read them back: smaller backups, exports and API payloads.
//! version: 1.0.0
//!
//! [dependencies]
//! flate2 = "1"
//! base64 = "0.22"

use base64::engine::general_purpose::STANDARD;
use base64::Engine;
use flate2::read::GzDecoder;
use flate2::write::GzEncoder;
use flate2::Compression;
use std::io::{Read, Write};

fn compression(level: i64) -> Compression {
    Compression::new(level.clamp(1, 9) as u32)
}

/// Gzips the file at `from` into `to`, at `level` 1 (fastest) to 9 (smallest); the size written, in bytes.
pub fn gzip_file(from: &str, to: &str, level: i64) -> Result<i64, String> {
    let mut input = std::fs::File::open(from).map_err(|e| format!("{}: {}", from, e))?;
    let out = std::fs::File::create(to).map_err(|e| format!("{}: {}", to, e))?;
    let mut enc = GzEncoder::new(out, compression(level));
    std::io::copy(&mut input, &mut enc).map_err(|e| e.to_string())?;
    enc.finish().map_err(|e| e.to_string())?;
    Ok(std::fs::metadata(to).map_err(|e| e.to_string())?.len() as i64)
}

/// Unpacks the gzip file at `from` into `to`; the size written, in bytes.
pub fn gunzip_file(from: &str, to: &str) -> Result<i64, String> {
    let input = std::fs::File::open(from).map_err(|e| format!("{}: {}", from, e))?;
    let mut out = std::fs::File::create(to).map_err(|e| format!("{}: {}", to, e))?;
    let n = std::io::copy(&mut GzDecoder::new(input), &mut out).map_err(|e| e.to_string())?;
    Ok(n as i64)
}

/// `text` gzipped, as base64 (a value cannot hold bytes).
pub fn gzip_text(text: &str) -> Result<String, String> {
    let mut enc = GzEncoder::new(Vec::new(), Compression::best());
    enc.write_all(text.as_bytes()).map_err(|e| e.to_string())?;
    Ok(STANDARD.encode(enc.finish().map_err(|e| e.to_string())?))
}

/// Base64 of gzipped text, back to the text.
pub fn gunzip_text(b64: &str) -> Result<String, String> {
    let bytes = STANDARD.decode(b64.trim()).map_err(|e| e.to_string())?;
    let mut out = String::new();
    GzDecoder::new(&bytes[..]).read_to_string(&mut out).map_err(|e| e.to_string())?;
    Ok(out)
}
