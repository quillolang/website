// A disc rip's CUE sheet: its tracks and where they start, how long each is once the audio's length
// is known, the times worked out in CD frames, and a sheet written for a set of chapters.
//
//   quillo run cue_sheet.qwe      then open http://localhost:8080/read, /durations, /times, /write and /broken

use "cue_sheet.qwer"

let TEXT = read_file("cue_sheet_sample.cue")

route GET /read {
    let s = cue_read_file("cue_sheet_sample.cue")?
    {
        title: s.title, performer: s.performer, songwriter: s.songwriter, catalog: s.catalog, rem: s.rem, files: s.files,
        tracks: s.tracks | map((t) => [t.number, t.type, t.title, t.performer, t.file]),
        first: s.tracks[0], indexes: s.tracks[1].indexes, gaps: [s.tracks[1].pregap, s.tracks[2].postgap], track_rem: s.tracks[3].rem, problems: s.problems,
    }
}

route GET /durations = {
    both: cue_durations(TEXT, { "side a.wav": 600.0, "side b.flac": 120.5 })?,
    unknown: cue_durations(TEXT, null)?.total,
    last_open: cue_durations(TEXT, null)?.tracks[2].length,
    needs_map: cue_durations(TEXT, 600.0).error,
    too_short: cue_durations(TEXT, { "side a.wav": 100.0 }).error,
}

route GET /times = {
    time: cue_time("03:25:40")?,
    long: cue_time("120:00:01")?.frames,
    back: cue_time_from_seconds(205.533333)?,
    round: cue_time_from_seconds(0.02)?,
    bad: [cue_time("3:61:00").error, cue_time("03:25:75").error, cue_time("03:25").error, cue_time_from_seconds(-1.0).error],
}

route GET /write {
    let s = cue_parse(TEXT)?
    let text = cue_write(s)?
    let chapters = cue_write({
        title: "A \"long\" talk", performer: "Ada", file: "talk.mp3",
        tracks: [{ title: "Intro", start: "00:00:00" }, { title: "Main", start: 13500, performer: "Bob" }, { title: "Q&A", start: "59:59:74", flags: ["DCP"] }],
    })?
    let again = cue_parse(text)?
    {
        same: cue_write(again)? == text,
        tracks: again.tracks | map((t) => [t.title, t.file, len(t.indexes)]),
        quote: again.tracks[0].title,
        chapters: chapters,
        back: cue_parse(chapters)?.tracks | map((t) => t.indexes[0].time),
        no_tracks: cue_write({ title: "x" }).error,
        no_start: cue_write({ file: "a.wav", tracks: [{ title: "x" }] }).error,
        no_file: cue_write({ tracks: [{ start: 0 }] }).error,
        order: cue_write({ file: "a.wav", tracks: [{ number: 2, start: 0 }, { number: 1, start: 1 }] }).error,
        bad_flag: cue_write({ file: "a.wav", tracks: [{ start: 0, flags: ["LOUD"] }] }).error,
        bad_catalog: cue_write({ catalog: "1", file: "a.wav", tracks: [{ start: 0 }] }).error,
        break: cue_write({ title: "a\nFILE \"x\"", file: "a.wav", tracks: [{ start: 0 }] }).error,
    }
}

route GET /broken = {
    empty: cue_parse("").error,
    orphan: cue_parse("TRACK 01 AUDIO\n").error,
    index_outside: cue_parse("FILE \"a\" WAVE\nINDEX 01 00:00:00\n").error,
    bad_time: cue_parse("FILE \"a\" WAVE\nTRACK 01 AUDIO\nINDEX 01 00:00:99\n").error,
    bad_number: cue_parse("FILE \"a\" WAVE\nTRACK 100 AUDIO\n").error,
    not_number: cue_parse("FILE \"a\" WAVE\nTRACK x AUDIO\n").error,
    no_file: cue_read_file("nothing.cue").error != null,
    problems: cue_parse("CATALOG 123\nFILE \"a\" OGG\nTRACK 01 NOISE\nISRC x\nFLAGS LOUD\nINDEX 00 00:01:00\nTRACK 03 AUDIO\nINDEX 01 00:00:50\nINDEX 02 00:00:40\nTRACK 04 AUDIO\nINDEX 01 00:00:10\nWHATEVER x\n")?.problems,
    crlf: cue_parse("FILE a.wav WAVE\r\n  TRACK 1 AUDIO\r\n  INDEX 1 0:00:00\r\n")?.tracks[0].indexes,
}
