// Reading a Prometheus server from a program: a status page's numbers, a graph's samples flattened
// into rows, which scrape targets are down, what is firing, and a visitor's text put safely into
// a selector.
//
//   PROMETHEUS_API_URL=http://localhost:9090 quillo run prometheus_query.qwe
//   then open http://localhost:8080/now, /graph, /health, /job?name=api and /broken
//
// PROMETHEUS_TOKEN sends a bearer token; PROMETHEUS_USERNAME and PROMETHEUS_PASSWORD basic auth.

use "prometheus_query.qwer"

route GET /now = {
    requests: prom_query("sum by (job) (rate(http_requests_total[5m]))", null)?,
    up: prom_value("count(up)")?,
    many: prom_value("up").error,
}

route GET /graph = prom_range("rate(http_requests_total[5m])", "2026-11-01T10:00:00Z", "2026-11-01T10:02:00Z", "1m")?

route GET /health = {
    targets: prom_targets("active")?,
    firing: prom_alerts("firing")?,
    rules: prom_rules("alert")?,
    labels: prom_labels(null)?,
    jobs: prom_label_values("job", null)?,
}

// The visitor's text is a label value, quoted so that it cannot leave the string.
route GET /job ? { name: str } {
    let selector = prom_selector("up", { job: name })?
    { selector: selector, series: prom_series(selector, null, null)?, rows: prom_query(selector, null)?.rows }
}

route GET /selectors = {
    hostile: prom_selector("up", { job: "a\"} or vector(1) or up{x=\"" })?,
    any: prom_selector("http_requests_total", { code: ["500", "503"], path: { "!~": "/health.*" } })?,
    bad_label: prom_selector("up", { "not a label": "x" }).error,
}

route GET /broken = { error: prom_query("rate(http_requests_total[5m", null).error }
