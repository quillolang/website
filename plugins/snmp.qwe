// A network's switch and printer watched over SNMP: the switch's name and uptime, its
// interfaces as rows (64-bit counters from ifXTable), the printer's toner from the
// Printer-MIB, the same over SNMPv3 (SHA and AES), a location set and read back, and traps:
// this program listens for them on a UDP port, answers informs, and sends its own.
//
// It needs an agent: SNMP_HOST (host or host:port), and SNMP_MANAGER for where traps go.
// SNMP_TRAP_PORT is the port this program takes traps on (1162; 162 needs root).
//
//   SNMP_HOST=192.168.1.2 SNMP_MANAGER=192.168.1.5 quillo run snmp.qwe      then open http://localhost:8080/device

use "snmp.qwer"

let HOST = env("SNMP_HOST", "127.0.0.1")
let MANAGER = env("SNMP_MANAGER", "127.0.0.1:162")
let TRAP_PORT = int(env("SNMP_TRAP_PORT", "1162"))
let V3 = { user: "ops", auth: "SHA", auth_password: env("SNMP_AUTH", "opsauth123"), priv: "AES", priv_password: env("SNMP_PRIV", "opspriv123") }

// Traps and informs that come in: read, kept (the last 100), informs answered.
let traps = []
udp.listen(TRAP_PORT, (p) => {
    let t = snmp_parse(p.bytes, V3)
    if !t { return null }
    if t.type == "inform" { udp.reply(p, snmp_response_for(p.bytes, [])) }
    traps = slice(traps + [{ from: p.from.host, version: t.version, type: t.type, trap: t.trap_name, values: t.values | map((v) => { name: v.name, value: v.value }) }], -100)
})

route GET /device = snmp_values(HOST, ["sysName.0", "sysLocation.0", "sysDescr.0", "sysUpTime.0", "ifNumber.0"], {})?

route GET /interfaces {
    let names = snmp_table(HOST, "ifXTable", {})?
    snmp_table(HOST, "ifTable", {})? | map((row) => {
        let x = names | find((n) => n.index == row.index)
        { name: x.ifName, up: row.ifOperStatus == 1, mac: row.ifPhysAddress, mbps: x.ifHighSpeed, bytes_in: x.ifHCInOctets, alias: x.ifAlias }
    })
}

route GET /toner = snmp_table(HOST, "prtMarkerSuppliesTable", {})? | map((s) => {
    supply: s.prtMarkerSuppliesDescription,
    percent: s.prtMarkerSuppliesMaxCapacity > 0 ? s.prtMarkerSuppliesLevel * 100 / s.prtMarkerSuppliesMaxCapacity : null,
})

route GET /secure = {
    name: snmp_values(HOST, ["sysName.0"], V3)?,
    system_values: len(snmp_walk(HOST, "system", V3)?),
    wrong_password: snmp_get(HOST, ["sysName.0"], { user: "ops", auth: "SHA", auth_password: "not-the-password", priv: "AES", priv_password: "opspriv123" }).error,
}

route GET /set {
    snmp_set(HOST, [{ oid: "sysLocation.0", type: "string", value: "Hall 3, rack A" }], { community: "private" })?
    {
        location: snmp_values(HOST, ["sysLocation.0"], {})?["sysLocation.0"],
        read_only: snmp_set(HOST, [{ oid: "sysDescr.0", type: "string", value: "x" }], { community: "private" }).error,
        wrong_type: snmp_set(HOST, [{ oid: "sysName.0", type: "integer", value: 5 }], { community: "private" }).error,
        no_such: snmp_get(HOST, ["sysName.0", "sysLocation.7"], { version: "1" }).error,
    }
}

// Traps sent: to this program itself (v2c and v1), and to the manager: an inform it
// acknowledges, and a v3 trap signed and encrypted.
route GET /trap {
    let link = [{ oid: "ifIndex.2", type: "integer", value: 2 }, { oid: "ifDescr.2", value: "eth0" }]
    let sent = {
        self_v2c: snmp_trap("127.0.0.1", "linkDown", link, { port: TRAP_PORT }).sent,
        self_v1: snmp_trap("127.0.0.1", "1.3.6.1.4.1.99999", [], { port: TRAP_PORT, version: "1", generic: 6, specific: 17 }).sent,
        inform: snmp_trap(MANAGER, "linkUp", link, { inform: true })?.acknowledged,
        v3: snmp_trap(MANAGER, "1.3.6.1.4.1.99999.0.3", [{ oid: "sysLocation.0", value: "Hall 2" }], V3)?.sent,
    }
    sleep(300)
    { sent: sent, received: traps }
}

route GET /offline = {
    oid: snmp_oid("ifHCInOctets.2")?,
    name: snmp_name("1.3.6.1.2.1.43.11.1.1.9.1.1")?,
    unknown: snmp_oid("ifFrobnicate.1").error,
}
