// Deploys announced in the team's Discord channel, with an embed that is green when the deploy
// passed and red when it failed.
//
//   DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/... quillo run discord.qwe      then open http://localhost:8080/deployed

use "discord.qwer"

let WEBHOOK = env("DISCORD_WEBHOOK_URL", null) ?? `${env("SINK_URL", "")}/api/webhooks/1234/test-token`

fn deploy_embed(version, passed) = discord_embed({
    title: `Deployed ${version}`,
    url: `https://github.com/example/shop/releases/tag/${version}`,
    color: passed ? "#2e7d32" : "#c62828",
    fields: { Tests: passed ? "passed" : "failed", Region: "eu-west", Duration: "2m 41s" },
    footer: "shop deploys",
    timestamp: "2026-10-29T09:00:00Z",
})

route GET /deployed = discord_send(WEBHOOK, { content: "@everyone a new version is out", username: "Deploy bot", embeds: [deploy_embed("v2.4.0", true)?] })?

route GET /embeds = {
    passed: deploy_embed("v2.4.0", true)?,
    failed_color: deploy_embed("v2.4.1", false)?.color,
    too_long: discord_embed({ title: repeat("x", 300) }).error,
}
