// Contacts imported from a phone's export, and a "save contact" button for a staff page.
//
//   quillo run vcard.qwe      then open http://localhost:8080/contacts

use "vcard.qwer"

route GET /contacts = vcard_read_file("vcard_sample.vcf")? | map((c) => { name: c.name, org: c.org, email: len(c.emails) > 0 ? c.emails[0].value : null, phone: len(c.phones) > 0 ? c.phones[0].value : null, note: c.note })

route GET /ada = vcard_read_file("vcard_sample.vcf")?[0]

route GET /staff/ada.vcf = respond(200, vcard_write([{
    first: "Ada", last: "Lovelace", org: "Quillo Shop", title: "Head of Engineering",
    emails: [{ value: "ada@shop.example.com", types: ["work"] }], phones: ["+31 20 555 0101"],
    addresses: [{ street: "Keizersgracht 1", city: "Amsterdam", postal_code: "1015 CJ", country: "Netherlands", types: ["work"] }],
    note: "Ask me about Quillo; or anything, really.",
}])?, { "content-type": "text/vcard; charset=utf-8", "content-disposition": "attachment; filename=ada.vcf" })

route GET /roundtrip {
    let text = vcard_write(vcard_read_file("vcard_sample.vcf")?)?
    vcard_parse(text)? | map((c) => c.name)
}
