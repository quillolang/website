// Page views in ClickHouse over HTTP: a table made, rows inserted as JSONEachRow, reports with
// parameters and typed results, and the errors ClickHouse puts in its bodies.
//
//   CLICKHOUSE_API_URL=http://localhost:8123 CLICKHOUSE_USER=default CLICKHOUSE_PASSWORD=... quillo run clickhouse.qwe
//   then open /setup, /insert, /report?path=/pricing, /types, /broken and /midway

use "clickhouse.qwer"

route GET /setup = {
    alive: clickhouse_ping()?,
    made: clickhouse_exec("CREATE TABLE IF NOT EXISTS views (path String, user UInt64, ms Float64, price Decimal(10,2), tags Array(String)) ENGINE = MergeTree ORDER BY path", null)?,
}

route GET /insert = {
    ok: clickhouse_insert("views", [
        { path: "/pricing", user: 9007199254740993, ms: 12.5, price: "19.90", tags: ["a", "b"] },
        { path: "/pricing", user: 7, ms: 30.0, price: "5.00", tags: [] },
        { path: "/it's\ta\\trap", user: 8, ms: 1.0, price: "1.00", tags: ["x"] },
    ], { async: true, dedup_token: "batch-1" })?,
    bad: clickhouse_insert("views", [{ path: "/x", user: "not a number" }], null).error,
}

route GET /report ? { path: str } {
    let r = clickhouse_query("SELECT user, ms, price, tags FROM views WHERE path = {path:String} ORDER BY user", { path: path })?
    { columns: r.columns, rows: r.rows, first: clickhouse_one("SELECT count() AS views FROM views WHERE path = {path:String}", { path: path })? }
}

route GET /trap = clickhouse_one("SELECT user FROM views WHERE path = {path:String}", { path: "/it's\ta\\trap" })?

route GET /broken = {
    no_table: clickhouse_query("SELECT * FROM nowhere", null).error,
    no_param: clickhouse_query("SELECT user FROM views WHERE path = {path:String}", null).error,
    name: clickhouse_quote_name("db.odd`name")?,
}

// A query that fails after its first rows: the answer's status was already 200.
route GET /midway = { error: clickhouse_query("SELECT throwIf(user > 7) FROM views", null).error }
