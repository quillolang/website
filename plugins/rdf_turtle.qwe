// Linked data read and written: a Turtle file, what a page's JSON-LD says, the same graph as
// N-Triples, and questions asked of it by pattern.
//
//   quillo run rdf_turtle.qwe      then open http://localhost:8080/read, /terms, /match, /describe, /write, /jsonld, /ntriples and /broken

use "rdf_turtle.qwer"

let TEXT = read_file("rdf_turtle_sample.ttl")
let G = rdf_parse(TEXT, "turtle", "")?
let PRE = G.prefixes

fn nt(triples) { rdf_write(triples, "ntriples", {})? }

route GET /read = { count: G.count, prefixes: G.prefixes, base: G.base }

route GET /terms = {
    lang: rdf_match(G.triples, "<http://example.org/data/alice>", "foaf:name", null, PRE)? | map((t) => t.object),
    numbers: ["foaf:age", "ex:height", "ex:score", "ex:active", "ex:joined"] | map((p) => rdf_match(G.triples, null, p, null, PRE)?[0].object),
    long: rdf_match(G.triples, null, "dc:title", null, PRE)?[0].object.value,
    relative: rdf_match(G.triples, null, "foaf:name", "Bob\t\u{e9}\n", PRE)?[0].subject,
    local_escape: rdf_match(G.triples, null, "ex:path", null, PRE)?[0].object.value,
    empty_list: rdf_match(G.triples, null, "ex:empty", null, PRE)?[0].object.value,
    self: rdf_match(G.triples, "http://example.org/data/", null, null, PRE)?,
    about_base: len(rdf_match(G.triples, null, "ex:about", "http://example.org/data/", PRE)?),
}

route GET /match = {
    people: rdf_match(G.triples, null, "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "foaf:Person", PRE)? | map((t) => t.subject.value),
    of_alice: len(rdf_match(G.triples, "http://example.org/data/alice", null, null, PRE)?),
    by_literal: rdf_match(G.triples, null, null, "Oslo", PRE)? | map((t) => t.predicate.value),
    by_term: len(rdf_match(G.triples, null, null, { type: "literal", value: "Alice", language: "en" }, PRE)?),
    number: len(rdf_match(G.triples, null, null, 34, PRE)?),
    nothing: rdf_match(G.triples, "ex:nobody", null, null, PRE)?,
}

route GET /describe = rdf_describe(G.triples, "http://example.org/data/alice", PRE)?

let BOOK = [
    { subject: "http://example.org/b/1", predicate: "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", object: "http://schema.org/Book" },
    { subject: "http://example.org/b/1", predicate: "http://schema.org/name", object: { value: "Ett \"quoted\"\nnamn", language: "sv" } },
    { subject: "http://example.org/b/1", predicate: "http://schema.org/pages", object: 312 },
    { subject: "http://example.org/b/1", predicate: "http://schema.org/price", object: { value: "9.50", datatype: "http://www.w3.org/2001/XMLSchema#decimal" } },
    { subject: "http://example.org/b/1", predicate: "http://schema.org/inPrint", object: false },
    { subject: "http://example.org/b/1", predicate: "http://schema.org/author", object: "_:a" },
    { subject: "http://example.org/b/1", predicate: "http://schema.org/author", object: "_:b" },
    { subject: "_:a", predicate: "http://schema.org/name", object: { value: "Ada" } },
    { subject: "_:a", predicate: "http://example.org/odd#x/y", object: { value: "long", datatype: "http://example.org/dt" } },
]
let NS = { s: "http://schema.org/", rdf: "http://www.w3.org/1999/02/22-rdf-syntax-ns#" }

route GET /write {
    let ttl = rdf_write(BOOK, "turtle", NS)?
    let back = rdf_parse(ttl, "turtle", "")?
    let n3 = rdf_write(BOOK, "ntriples", {})?
    {
        ttl: ttl,
        same: nt(back.triples) == n3,
        count: back.count,
        bad_format: rdf_write(BOOK, "xml", {}).error,
        bad_subject: rdf_write([{ subject: { value: "x" }, predicate: "http://a/", object: "http://b/" }], "turtle", {}).error,
        bad_pred: rdf_write([{ subject: "http://a/", predicate: "_:p", object: "http://b/" }], "turtle", {}).error,
    }
}

let PAGE = read_file("rdf_turtle_sample.jsonld")

route GET /jsonld {
    let g = rdf_parse(PAGE, "jsonld", "https://shop.example/items/")?
    let text = rdf_write(BOOK, "jsonld", NS)?
    let back = rdf_parse(text, "jsonld", "")?
    {
        count: g.count, lines: split(trim(nt(g.triples)), "\n"),
        graph: json.parse(text)["@graph"][0],
        same: nt(back.triples) == rdf_write(BOOK, "ntriples", {})?,
        remote: rdf_parse("{\"@context\":\"https://schema.org\",\"name\":\"x\"}", "jsonld", "").error,
    }
}

route GET /ntriples {
    let text = "<http://a/s> <http://a/p> \"o\\u00E9\\n\"@en-GB . # comment\n_:b1 <http://a/p> <http://a/o> .\n\n<http://a/s> <http://a/p> \"1\"^^<http://www.w3.org/2001/XMLSchema#integer> .\n"
    let g = rdf_parse(text, "ntriples", "")?
    {
        count: g.count, first: g.triples[0].object, back: rdf_write(g.triples, "ntriples", {})?,
        relative: rdf_parse("<a> <http://a/p> <http://a/o> .", "ntriples", "").error,
        two: rdf_parse("<http://a/s> <http://a/p> <http://a/o> . <http://a/s> <http://a/p> <http://a/o> .", "ntriples", "").error,
    }
}

route GET /broken = {
    prefix: rdf_parse("a:b a:c a:d .", "turtle", "").error,
    relative: rdf_parse("<x> <y> <z> .", "turtle", "").error,
    resolved: rdf_parse("<x> <y> <../z> .", "turtle", "http://a/b/c/d")?.triples[0].object.value,
    open: rdf_parse("<http://a/> <http://b/> \"x", "turtle", "").error,
    dot: rdf_parse("@prefix : <http://a/> .\n:a :b :c", "turtle", "").error,
    literal_subject: rdf_parse("\"x\" <http://a/> <http://b/> .", "turtle", "").error,
    space_in_iri: rdf_parse("<http://a b/> <http://b/> <http://c/> .", "turtle", "").error,
    format: rdf_parse("", "rdfxml", "").error,
}
