// Types for a shop's webhook from a few saved bodies: TypeScript for the front end, a JSON
// Schema to check what comes in, and Rust structs for a plugin.
//
//   quillo run json_types.qwe      then open http://localhost:8080/typescript

use "json_types.qwer"

let text = (s) => respond(200, s, { "content-type": "text/plain; charset=utf-8" })

route GET /typescript = text(json_types_file("json_types_sample.jsonl", "OrderEvent", "typescript")?)
route GET /schema = text(json_types_file("json_types_sample.jsonl", "OrderEvent", "schema")?)
route GET /rust = text(json_types_file("json_types_sample.jsonl", "OrderEvent", "rust")?)

// Samples from the program itself.
route GET /inline = {
    ts: json_types_typescript([{ id: 1, tags: ["a"], price: 9.5 }, { id: 2, tags: [], price: 10, note: "gift" }], "Product"),
    schema: json_types_schema([{ id: 1, at: "2026-10-29", url: "https://shop.example/p/1" }, { id: 2, at: "2026-10-30", url: null }], "Row"),
}
