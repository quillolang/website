// A multi-tenant product search on Meilisearch: documents added and their tasks waited on, a search
// with filters and facets, and a tenant token that lets one shop's browser see only its products.
//
//   MEILISEARCH_API_URL=http://localhost:7700 MEILISEARCH_API_KEY=... MEILISEARCH_SEARCH_KEY=... quillo run meilisearch.qwe
//   then open /setup, /search?q=mug, /tenant, /task-failed and /broken

use "meilisearch.qwer"

route GET /setup = {
    made: meili_create_index("products", "id")?,
    again: meili_create_index("products", "id")?,
    settings: meili_settings("products", { filterableAttributes: ["shop", "color"], sortableAttributes: ["price"] }, 5000)?.status,
    added: meili_add_documents("products", [
        { id: 1, shop: 7, name: "Blue mug", color: "blue", price: 9 },
        { id: 2, shop: 7, name: "Red mug", color: "red", price: 12 },
        { id: 3, shop: 9, name: "Green mug", color: "green", price: 7 },
    ], "", 5000)?.status,
    updated: meili_update_documents("products", [{ id: 2, price: 11 }], 5000)?.status,
    doc: meili_document("products", "2")?,
    no_doc: meili_document("products", "99")?,
}

route GET /search ? { q: str } {
    let r = meili_search("products", q, { filter: "color != green", sort: ["price:asc"], facets: ["color"], limit: 5 })?
    { names: r.hits | map((h) => h.name), total: r.estimatedTotalHits, colors: r.facetDistribution.color }
}

// What the browser of shop 7 gets: a token, good for an hour, that only finds shop 7's products,
// and the same token with a changed signature.
route GET /tenant {
    let key = meili_keys()? | filter((k) => k.name == "search")
    let token = meili_tenant_token(key[0].uid, { products: { filter: "shop = 7" } }, int(now() / 1000) + 3600)?
    let r = meili_search_as(token, "products", "mug", null)?
    {
        found: r.hits | map((h) => h.name),
        forged: meili_search_as(token + "x", "products", "mug", null).error,
        not_a_uid: meili_tenant_token("my-key", { products: {} }, 0).error,
    }
}

// The request is accepted; the failure comes in the task, and is an error here.
route GET /task-failed = { error: meili_add_documents("products", [{ id: "not valid!", name: "x" }], "", 5000).error }

route GET /broken = {
    no_index: meili_search("nothing-here", "x", null).error,
    bad_uid: meili_search("no spaces please", "x", null).error,
    bad_filter: meili_search("products", "x", { filter: "name = mug" }).error,
}
