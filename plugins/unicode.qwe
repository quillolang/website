// Usernames compared as people read them, and a 10-character preview that never breaks an emoji.
//
//   quillo run unicode.qwe      then open http://localhost:8080/text

use "unicode.qwer"

let thumbs = "Great job 👍🏽🇫🇷!"
let decomposed = "Cafe\u{301}"

route GET /text = {
    code_points: len(thumbs),
    seen: unicode_length(thumbs)?,
    preview: unicode_truncate(thumbs, 11)?,
    plain: unicode_strip_accents("Crème Brûlée, Ångström, São Paulo")?,
    same_user: unicode_same("Ｃａｆé", "café")?,
    stored: len(unicode_normalize(decomposed, "nfc")?),
    width: unicode_width("日本語 ok")?,
    folded: unicode_normalize("ﬁle ①", "nfkc")?,
}
