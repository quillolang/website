// Sign-ups grouped by the company's domain, a "same site" check for redirects, and international names shown in their own letters.
//
//   quillo run domains.qwe      then open http://localhost:8080/domain?name=https://shop.example.co.uk/cart

use "domains.qwer"

route GET /domain ? { name: str } = domain_parse(name)?

route GET /signups {
    let emails = ["ana@mail.acme.co.uk", "bo@acme.co.uk", "cy@sales.acme.co.uk", "di@other.com"]
    group_by(emails, (e) => domain_registrable(split(e, "@")[1])? ?? "?") | keys
}

route GET /redirect ? { to: str } {
    if !domain_same_site(to, "https://www.example.com")? { reply 400 { error: "redirects stay on example.com" } }
    { ok: to }
}

route GET /idn = { ascii: domain_to_ascii("München.de")?, unicode: domain_to_unicode("xn--mnchen-3ya.de"), pages: domain_same_site("a.github.io", "b.github.io")? }
