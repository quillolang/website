<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file original="app/messages.html" datatype="html" source-language="en" target-language="fr">
    <header><tool tool-id="sample" tool-name="Sample"/></header>
    <body>
      <trans-unit id="hello" resname="greeting">
        <source>Hello, <g id="1">world</g>!</source>
        <target state="translated">Bonjour, <g id="1">monde</g> !</target>
        <note from="dev" priority="2">Shown on the home page.</note>
      </trans-unit>
      <trans-unit id="cart" approved="yes">
        <source>You have <x id="count" ctype="x-placeholder"/> items &amp; 2 offers</source>
        <target state="final">Vous avez <x id="count" ctype="x-placeholder"/> articles &amp; 2 offres</target>
      </trans-unit>
      <group id="buttons">
        <trans-unit id="save">
          <source>Save</source>
        </trans-unit>
        <trans-unit id="open">
          <source>Open <bpt id="1">&lt;b&gt;</bpt>now<ept id="1">&lt;/b&gt;</ept></source>
          <target state="needs-translation"/>
        </trans-unit>
        <trans-unit id="brand" translate="no">
          <source>Quillo</source>
        </trans-unit>
      </group>
      <trans-unit id="bad">
        <source>Pay <ph id="1">$1</ph> by 5 May </source>
        <target state="needs-review-translation">Payer <ph id="2">$2</ph> avant le 6 mai</target>
      </trans-unit>
    </body>
  </file>
