// Backups on Backblaze B2: files uploaded with their SHA-1 and read back, a file too big for one
// request sent in parts, a private link good for a minute, listings past one page, and an expired
// token renewed without the program noticing.
//
//   B2_APPLICATION_KEY_ID=... B2_APPLICATION_KEY=... B2_BUCKET_ID=... B2_BUCKET_NAME=... quillo run backblaze_b2.qwe
//   then open http://localhost:8080/files, /large, /private, /listing, /expired and /failures
//
// B2_API_URL reaches a test server.

use "backblaze_b2.qwer"

let BUCKET = env("B2_BUCKET_ID", "")
let NAME = env("B2_BUCKET_NAME", "")
let LARGE = ".quillo/b2-large-sample.bin"

route GET /files {
    let up = b2_upload(BUCKET, "notes/été 2026.txt", "hello B2", { content_type: "text/plain", info: { author: "ada" } })?
    let down = b2_download(NAME, "notes/été 2026.txt", {})?
    let range = b2_download(NAME, "notes/été 2026.txt", { range: "bytes=0-4" })?
    { sha1: up.sha1, text: down.text, checked: down.checked, type: down.content_type, author: down.info.author, partial: range.text, partial_checked: range.checked, retried: b2_upload(BUCKET, "busy.txt", "one more try", {})?.size }
}

route GET /large {
    write_file(LARGE, repeat("0123456789abcdef", 72000))?
    let done = b2_upload_file(BUCKET, "backups/big.bin", LARGE, { part_size: 500000, content_type: "application/octet-stream", info: { src: "db" } })?
    let back = b2_download(NAME, "backups/big.bin", {})?
    let stuck = http.get(env("B2_API_URL", "") + "/_stuck").json
    let small = b2_upload_file(BUCKET, "x", LARGE, { part_size: 100 }).error
    delete_file(LARGE)
    {
        parts: done.parts,
        size: done.size,
        whole: back.size,
        unfinished_checked: back.checked,
        stuck_before: stuck.count,
        unfinished: len(b2_unfinished(BUCKET)?),
        cancelled: b2_cancel(stuck.id)?,
        after: len(b2_unfinished(BUCKET)?),
        too_small: small,
    }
}

route GET /private {
    b2_upload(BUCKET, "private/report.txt", "for your eyes", {})?
    b2_upload(BUCKET, "other/secret.txt", "not for you", {})?
    let auth = b2_download_auth(BUCKET, "private/", 60)?
    {
        url: contains(b2_download_url(NAME, "private/report.txt", auth.token)?, "/file/photos/private/report.txt?Authorization="),
        read: b2_download(NAME, "private/report.txt", { token: auth.token })?.text,
        outside: b2_download(NAME, "other/secret.txt", { token: auth.token }).error,
        too_long: b2_download_auth(BUCKET, "x", 700000).error,
    }
}

route GET /listing {
    for i in range(0, 5) { b2_upload(BUCKET, `logs/2026/${i}.log`, `line ${i}`, {})? }
    let page = b2_list(BUCKET, { prefix: "logs/", max: 2 })?
    let all = b2_list_all(BUCKET, { prefix: "logs/", max: 2 })?
    let first = all[0]
    b2_hide(BUCKET, first.name)?
    let versions = b2_versions(BUCKET, { prefix: first.name })?
    let gone = b2_delete(all[1].name, all[1].file_id)?
    { page: len(page.files), next: page.next, all: len(all), after_hide: len(b2_list_all(BUCKET, { prefix: "logs/" })?), versions: map(versions, (v) => v.action), deleted: gone, folders: map(b2_list(BUCKET, { delimiter: "/" })?.files, (f) => f.name) }
}

// The stand-in expires the account's token: the next call gets it back by itself.
route GET /expired {
    http.get(env("B2_API_URL", "") + "/_expire")
    { still_works: len(b2_buckets()?) > 0, renewed: http.get(env("B2_API_URL", "") + "/_auths").json.count > 1 }
}

route GET /failures = {
    leading: b2_upload(BUCKET, "/bad", "x", {}).error,
    double: b2_upload(BUCKET, "a//b", "x", {}).error,
    missing: b2_download(NAME, "no/such/file", {}).error,
    wrong_bucket: b2_upload("no-such-bucket", "a.txt", "x", {}).error,
    corrupt: b2_download(NAME, "corrupt.txt", {}).error,
}
