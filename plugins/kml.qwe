// A walks site: routes drawn in Google My Maps or Google Earth come in as KML or KMZ and go out to a web map as GeoJSON; walkers take them back to their phones as KMZ.
//
//   quillo run kml.qwe      then open http://localhost:8080/walk

use "kml.qwer"

route GET /walk {
    let walk = kml_file_to_geojson("kml_sample.kml")?
    {
        name: walk.name,
        count: len(walk.features),
        names: walk.features | map((f) => f.properties.name),
        cafe: walk.features[1],
        kinds: walk.features | map((f) => f.geometry.type),
    }
}

// The walk as GeoJSON for Leaflet or MapLibre.
route GET /walk.geojson = kml_file_to_geojson("kml_sample.kml")?

// Our own stops written as KMZ, and read back to check.
route GET /export {
    let stops = {
        type: "FeatureCollection",
        features: [
            { type: "Feature", properties: { name: "Start", description: "By the station", level: "easy" }, geometry: { type: "Point", coordinates: [8.54, 47.378] } },
            { type: "Feature", properties: { name: "Loop" }, geometry: { type: "LineString", coordinates: [[8.54, 47.378], [8.55, 47.37], [8.54, 47.378]] } },
        ],
    }
    let path = kml_save(stops, "Our stops", "data/stops.kmz")?
    let back = kml_file_to_geojson(path)?
    { saved: path, read_back: back.features[0].properties, kml: kml_from_geojson(stops.features[0], "One stop")? }
}
