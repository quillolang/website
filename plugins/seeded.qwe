// Today's puzzle is the same for everyone, and a user stays in their test group.
//
//   quillo run seeded.qwe      then open http://localhost:8080/today

use "seeded.qwer"

let words = ["quill", "route", "state", "patch", "token", "frame", "query", "proxy"]

route GET /today {
    let day = date.format(date.today(), "yyyy-MM-dd")
    { day, word: first(seeded_pick(words, 1, day)), again: first(seeded_pick(words, 1, day)) }
}
route GET /fixed = { int: seeded_int("draw-2026", 1, 100)?, order: seeded_shuffle([1, 2, 3, 4, 5], "round-1"), group: bucket("user-42", 2) }
