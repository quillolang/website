// A docs page with highlighted code, in two ways: inline colours, and classes with a stylesheet.
//
//   quillo run highlight.qwe      then open http://localhost:8080/snippet

use "highlight.qwer"

let sample = "fn main() {\n    let total: i64 = [1, 2, 3].iter().sum();\n    println!(\"total = {}\", total);\n}\n"

route GET /snippet = <html>
    <body>
        <h1>Summing in Rust</h1>
        {raw(highlight_html(sample, "rust", "InspiredGitHub")?)}
    </body>
</html>

route GET /classes ? { lang: str = "sql" } {
    let html = highlight_classes("SELECT name, total FROM orders WHERE total > 100;\n", lang)?
    <html>
        <head><style>{raw(highlight_css("base16-ocean.dark")?)}</style></head>
        <body><pre class="code">{raw(html)}</pre></body>
    </html>
}

route GET /themes = { themes: highlight_themes(), languages: len(highlight_languages()) }
