//! Unicode text made comparable and measured: NFC/NFD/NFKC/NFKD forms, accents removed, characters counted as people see them (👍🏽 is one), and width in a terminal.
//! version: 1.0.0
//!
//! [dependencies]
//! unicode-normalization = "0.1"
//! unicode-segmentation = "1.12"
//! unicode-width = "0.2"

use unicode_normalization::char::is_combining_mark;
use unicode_normalization::UnicodeNormalization;
use unicode_segmentation::UnicodeSegmentation;
use unicode_width::UnicodeWidthStr;

const MAX: usize = 10_000_000;

fn check(text: &str) -> Result<(), String> {
    if text.len() > MAX { Err("text up to 10 MB".into()) } else { Ok(()) }
}

/// `text` in a normal form: "nfc" (composed: what to store and compare; "é" as one character), "nfd" (decomposed: "e" and an accent), "nfkc" or "nfkd" (also folding look-alikes: "ﬁ" is "fi", "①" is "1", full-width "Ａ" is "A", for usernames and search).
pub fn unicode_normalize(text: &str, form: &str) -> Result<String, String> {
    check(text)?;
    Ok(match form.to_lowercase().as_str() {
        "nfc" | "" => text.nfc().collect(),
        "nfd" => text.nfd().collect(),
        "nfkc" => text.nfkc().collect(),
        "nfkd" => text.nfkd().collect(),
        o => return Err(format!("form is \"nfc\", \"nfd\", \"nfkc\" or \"nfkd\", not {:?}", o)),
    })
}

/// `text` without accents and other marks: "Crème Brûlée" is "Creme Brulee", "Ångström" is "Angstrom". Letters that are not a base letter with marks ("ø", "ß", "æ") stay as they are.
pub fn unicode_strip_accents(text: &str) -> Result<String, String> {
    check(text)?;
    Ok(text.nfd().filter(|c| !is_combining_mark(*c)).nfc().collect())
}

/// How many characters `text` has as a person counts them (grapheme clusters): "👍🏽" and "🇫🇷" are 1, "é" is 1 however it is stored. Quillo's `len` counts code points, which differ for these.
pub fn unicode_length(text: &str) -> Result<i64, String> {
    check(text)?;
    Ok(text.graphemes(true).count() as i64)
}

/// The first `n` characters of `text` as a person counts them, never cutting an emoji or an accent in two: for previews and limits like "30 characters".
pub fn unicode_truncate(text: &str, n: i64) -> Result<String, String> {
    check(text)?;
    Ok(text.graphemes(true).take(n.max(0) as usize).collect())
}

/// How many columns `text` takes in a terminal or a monospace font: Chinese, Japanese and most emoji take 2, accents 0. For tables in plain-text emails and CLIs.
pub fn unicode_width(text: &str) -> Result<i64, String> {
    check(text)?;
    Ok(UnicodeWidthStr::width(text) as i64)
}

/// Whether two texts are the same once both are in NFKC form and lower case: "Ｃａｆé" and "café" are.
pub fn unicode_same(a: &str, b: &str) -> Result<bool, String> {
    check(a)?;
    check(b)?;
    Ok(a.nfkc().collect::<String>().to_lowercase() == b.nfkc().collect::<String>().to_lowercase())
}
