// A clinic's HL7 interface over MLLP: admissions sent to the hospital's interface engine and its
// ACKs read (an accepted one, and an error for a message it cannot use); results received from
// the lab on a port of our own, each acknowledged as it comes and drained by an `every` tick;
// and the framing and ACK making used without a network.
//
//   MLLP_HOST=engine.local:2575 MLLP_LISTEN_PORT=2576 quillo run mllp.qwe
//   then open http://localhost:8080/admit, /admit-bad and /results
//
// Needs an MLLP receiver at MLLP_HOST (an interface engine such as Mirth Connect, or a test
// listener). MLLP_TLS=1 and MLLP_CA (a PEM file or text) for MLLP over TLS.

use "mllp.qwer"

let HOST = env("MLLP_HOST", "127.0.0.1:2575")
let OPTS = { timeout_ms: 5000, tls: env("MLLP_TLS", "") == "1", ca: env("MLLP_CA", "") }

// Lab results come in on this port; each is answered AA once it is kept.
let listening = mllp_listen(int(env("MLLP_LISTEN_PORT", "2576")), { buffer: 500 })

let results = []
fn drain() {
    let got = mllp_receive(int(env("MLLP_LISTEN_PORT", "2576")), 100, 0) ?? []
    if len(got) > 0 { results = results + got }
}
every(200, drain)

fn admission(id, with_patient) {
    let lines = [
        `MSH|^~\\&|CLINIC|QUILLO|ENGINE|HOSPITAL|20261030101500||ADT^A01^ADT_A01|${id}|P|2.5.1`,
        "EVN|A01|20261030101500",
    ]
    let patient = with_patient ? ["PID|1||PAT-2207^^^QUILLO^MR||Hopper^Grace^Brewster||19061209|F"] : []
    join(lines + patient + ["PV1|1|O|CLINIC^3^A"], "\r")
}

route GET /admit {
    let ack = mllp_send(HOST, admission("ADM-1001", true), OPTS)?
    { sent: ack.sent_id, code: ack.code, accepted: ack.accepted, meaning: ack.meaning }
}

route GET /admit-bad {
    let ack = mllp_send(HOST, admission("ADM-1002", false), OPTS)?
    { sent: ack.sent_id, code: ack.code, accepted: ack.accepted, text: ack.text, errors: ack.errors }
}

// What the lab sent us, waited for a moment if nothing has come yet.
route GET /results {
    let more = mllp_receive(int(env("MLLP_LISTEN_PORT", "2576")), 100, 3000)?
    let all = results + more
    results = []
    { count: len(all), first: len(all) > 0 ? { type: all[0].type, control_id: all[0].control_id, sender: all[0].sender } : null, listener: mllp_listener(int(env("MLLP_LISTEN_PORT", "2576")))? }
}

// No network: a message framed and unframed, and the ACKs we would send for it.
route GET /offline {
    let msg = admission("ADM-7", true)
    let framed = mllp_frame(msg)
    let back = mllp_unframe(framed + "\u{0b}MSH|^~\\&|half")
    {
        framed_length: len(framed),
        whole: len(back.messages),
        rest: back.rest,
        ack: mllp_parse_ack(mllp_ack(msg, "AA", "")?)?,
        nack: mllp_parse_ack(mllp_ack(msg, "AE", "Unknown ward CLINIC^3")?)?.errors,
    }
}
