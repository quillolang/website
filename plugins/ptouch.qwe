// An office and a server room's Brother printers: address labels on a QL-820NWB (62 mm DK roll),
// cable flags on a PT-P750W (12 mm TZe tape), both made from text, and a logo label from a picture.
//
//   quillo run ptouch.qwe      then open http://localhost:8080/jobs and http://localhost:8080/address.png
//   PRINTER_HOST=192.168.1.68 quillo run ptouch.qwe      and http://localhost:8080/print

use "ptouch.qwer"

route GET /address.png {
    ptouch_text(["Ms Ada Byron", "12 St James's Square", "London SW1Y 4JH"], "data/address.png", { media: "62x29", align: "left" })?
    file("data/address.png")
}

route GET /jobs {
    let address = ptouch_text(["Ms Ada Byron", "12 St James's Square", "London SW1Y 4JH"], "data/address.png", { media: "62x29", align: "left" })?
    let cable = ptouch_text(["RACK 2 · U14 · eth0"], "data/cable.png", { media: "tze12" })?
    {
        address: address,
        address_job: ptouch_info("data/address.png", { media: "62x29" })?,
        cable: cable,
        cable_job: ptouch_info("data/cable.png", { media: "tze12" })?,
        logo_job: ptouch_info("ptouch_sample.png", { media: "62", dither: true })?,
        start: slice(ptouch_job("data/cable.png", { media: "tze12" })?, 532, 560),
        status: ptouch_parse_status("gCBCNEEAAAAAAD4KAAAAAAAAAAAAAAAAAAAAAAAAAAA=")?,
    }
}

route GET /media = ptouch_media()

route GET /print {
    let host = env("PRINTER_HOST", null) ?? reply 503 "set PRINTER_HOST to the printer's address (host or host:port)"
    ptouch_text(["Ms Ada Byron", "12 St James's Square", "London SW1Y 4JH"], "data/address.png", { media: "62x29", align: "left" })?
    { sent: ptouch_send("data/address.png", { media: "62x29" }, host, 5000)?, saved: ptouch_write("data/address.png", { media: "62x29" }, "data/address.bin")? }
}
