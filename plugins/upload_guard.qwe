// Profile photos and documents checked before they are kept: each upload is saved to a quarantine
// folder, checked, then moved or deleted. /samples checks the hostile files beside this example.
//
//   quillo run upload_guard.qwe      then open http://localhost:8080/ and http://localhost:8080/samples

use "upload_guard.qwer"

let IMAGES = { allowed: ["image/png", "image/jpeg", "image/webp"], max_bytes: 5_000_000 }
let DOCUMENTS = { allowed: ["application/pdf", "docx", "xlsx", "csv", "zip"], max_bytes: 20_000_000 }

route GET / = <form method="post" action="/upload" enctype="multipart/form-data">
    <input type="file" name="file"/>
    <button>Upload</button>
</form>

route POST /upload {
    let f = request.files.file ?? reply 400 "no file"
    let tmp = save_upload(f, `quarantine/${uuid()}`)?
    let report = upload_check(tmp, f.filename, IMAGES)?
    if !report.ok {
        delete_file(tmp)
        reply 422 report
    }
    delete_file(tmp)
    { kept: save_upload(f, `photos/${uuid()}.${report.extension}`)?, type: report.mime }
}

fn problems(path, name, options) {
    let r = upload_check(path, name, options)?
    { ok: r.ok, mime: r.mime, problems: r.problems | map((p) => p.code), archive: r.archive }
}

route GET /samples = {
    photo: problems("upload_guard_sample.png", "avatar.png", IMAGES),
    renamed: problems("upload_guard_sample.png", "avatar.jpg", IMAGES),
    double: problems("upload_guard_sample.png", "shell.php.png", IMAGES),
    svg: problems("upload_guard_sample.svg", "logo.svg", { allowed: ["image/*"], allow_svg: true }),
    polyglot: problems("upload_guard_sample_polyglot.jpg", "me.jpg", IMAGES),
    pdf: problems("upload_guard_sample.pdf", "invoice.pdf", DOCUMENTS),
    zip: problems("upload_guard_sample.zip", "export.zip", DOCUMENTS),
}

route GET /sniff = upload_sniff("upload_guard_sample_polyglot.jpg")?
