// Each blog post gets its own link-preview picture, made once and served to social sites.
//
//   quillo run og_image.qwe      then open http://localhost:8080/posts/1

use "og_image.qwer"

let posts = [
    { id: 1, title: "How we roast our beans: a long story about heat, time and patience", summary: "Notes from ten years of roasting in Lyon, with the mistakes left in." },
    { id: 2, title: "Spring menu", summary: "Three new dishes from 1 April." },
]

fn preview(p) = og_image(`data/og/post-${p.id}.png`, p.title, p.summary, { site: "quillo.cafe", logo: "og_image_sample.png" })

route GET /og/:id(int)/preview.png {
    let p = posts | find((x) => x.id == id) ?? reply 404 "No such post"
    preview(p)?
    file(`data/og/post-${id}.png`)
}

route GET /posts/:id(int) {
    let p = posts | find((x) => x.id == id) ?? reply 404 "No such post"
    <html>
        <head>
            <title>{p.title}</title>
            <meta property="og:title" content={p.title}/>
            <meta property="og:image" content={`https://quillo.cafe/og/${id}/preview.png`}/>
        </head>
        <body><h1>{p.title}</h1><img src={`/og/${id}/preview.png`} width="600" alt=""/></body>
    </html>
}

route GET /made = { image: preview(posts[0])?, svg_lines: len(re.find_all(og_image_svg(posts[0].title, "", null)?, "<text ")) }
