// Unicode braille: an English text in grade 1 and in Unified English Braille grade 2, and back,
// the dots of each cell, and the Braille ASCII an embosser takes.
//
//   quillo run braille.qwe
//   then open http://localhost:8080/encode?text=The+child+knows+the+way, /round, /dots and /refused

use "braille.qwer"

route GET /encode ? { text: str = "Hello world" } = {
    text: text,
    grade1: braille_encode(text, 1)?,
    grade2: braille_encode(text, 2)?,
}

route GET /samples = {
    wordsigns: braille_encode("the child can do it for you", 2)?,
    groups: braille_encode("mother found something together", 2)?,
    middle: braille_encode("bread rubber effect", 2)?,
    first: braille_encode("being content", 2)?,
    capitals: braille_encode("The NASA McGill", 2)?,
    numbers: braille_encode("Room 12b costs 3.50", 2)?,
    letter: braille_encode("plan b", 2)?,
    quote: braille_encode("\"Why?\" she said.", 2)?,
}

route GET /round {
    let text = "The father and the child were in the house, but it was not enough."
    let cells = braille_encode(text, 2)?
    {
        cells: cells,
        back: braille_decode(cells, 2)?.text,
        grade1: braille_decode(braille_encode("Room 42 is OK.", 1)?, 1)?.text,
        guess: braille_decode("⠎⠁⠸", 2)?,
    }
}

route GET /dots = {
    dots: braille_dots("⠓⠑"),
    cells: braille_from_dots(["125", "15", "0", "1234"])?,
    ascii: braille_to_ascii(braille_encode("Hello there", 2)?)?,
    from_ascii: braille_from_ascii(",HELLO")?,
}

route GET /refused = {
    grade: braille_encode("x", 3).error,
    character: braille_encode("€5", 1).error,
    cell: braille_decode("abc", 1).error,
    dots: braille_from_dots(["129"]).error,
}

route GET /signs = { shortforms: len(braille_signs().shortforms), wordsigns: len(braille_signs().wordsigns), first: first(braille_signs().shortforms) }
