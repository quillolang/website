// A fishing and night-sky calendar: tonight's moon, the month's phases, and when the moon is up.
//
//   quillo run moon_phase.qwe      then open http://localhost:8080/moon

use "moon_phase.qwer"

route GET /moon ? { at: str = "2026-08-28T04:00:00Z" } = moon_phase(at)?

// August 2026: the total solar eclipse of 12 August is at a new moon, the partial lunar eclipse of 28 August at a full one.
route GET /month = moon_phases("2026-08-01", "2026-08-31")?

// Moonrise and moonset in Amsterdam (UTC+2 in summer).
route GET /tonight ? { date: str = "2026-08-28" } = moon_times(52.37, 4.89, date, 120)?

route GET / {
    let m = moon_phase("now")?
    <html><body>
        <h1>{m.emoji} {m.phase}</h1>
        <p>{round(m.illumination * 100)}% lit, {m.age_days} days old. Next full moon: {m.next_full}.</p>
    </body></html>
}
