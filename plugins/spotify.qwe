// Music from Spotify: a search, tracks, a long playlist, and a visitor signed in by PKCE to make a
// playlist of their own.
//
//   SPOTIFY_CLIENT_ID=... SPOTIFY_CLIENT_SECRET=... quillo run spotify.qwe
//   then open /search, /tracks, /playlist, /ids, /pkce, /sign-in and /failures
//
// SPOTIFY_API_URL and SPOTIFY_ACCOUNTS_URL reach a test server. Add http://localhost:8080/callback to
// the app's redirect addresses for a real sign-in, and keep `verifier` in the visitor's session.

use "spotify.qwer"

route GET /search {
    let r = spotify_search("artist:\"Nina Simone\" year:1965", ["track", "artist"], { market: "NL" }, 120)?
    { tracks: r.track.total, got: len(r.track.items), first: r.track.items[0].name, artists: len(r.artist.items), empty: spotify_search(" ", ["track"], {}, 0).error }
}

route GET /tracks {
    let ids = map(range(0, 120), (i) => `4uLU6hMCjMI75M1A2tK${100 + i}`)
    let many = spotify_tracks(ids)?
    {
        got: len(many), name: spotify_track("https://open.spotify.com/track/4uLU6hMCjMI75M1A2tKU00?si=abc")?.name,
        by_uri: spotify_track("spotify:track:4uLU6hMCjMI75M1A2tKU00")?.id,
        missing: spotify_track("0000000000000000000000").error,
    }
}

route GET /playlist {
    let list = "37i9dQZF1DXcBWIGoYBM5M"
    let info = spotify_playlist(list, "")?
    let items = spotify_playlist_tracks(list, "", 0)?
    { name: info.name, total: info.tracks.total, got: len(items), first: items[0].track.name, capped: len(spotify_playlist_tracks(list, "", 150)?) }
}

route GET /ids = {
    link: spotify_id("https://open.spotify.com/track/4uLU6hMCjMI75M1A2tKU00?si=1")?,
    uri: spotify_id("spotify:album:4uLU6hMCjMI75M1A2tKU00")?,
    intl: spotify_id("https://open.spotify.com/intl-de/track/4uLU6hMCjMI75M1A2tKU00/")?,
    plain: spotify_id("4uLU6hMCjMI75M1A2tKU00")?,
    bad: spotify_id("https://example.com/x").error,
}

route GET /pkce {
    let pair = spotify_pkce()
    let url = spotify_authorize_url("http://localhost:8080/callback", ["playlist-modify-private", "user-read-email"], pair.state, pair.challenge)?
    {
        // The test vector of RFC 7636, appendix B.
        rfc: spotify_challenge("dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"),
        sound: spotify_challenge(pair.verifier) == pair.challenge,
        long_enough: len(pair.verifier) >= 43 && len(pair.verifier) <= 128,
        url_has: [contains(url, "code_challenge_method=S256"), contains(url, "scope=playlist-modify-private%20user-read-email"), contains(url, "redirect_uri=http%3A%2F%2Flocalhost%3A8080%2Fcallback")],
        two_differ: spotify_pkce().verifier != pair.verifier,
    }
}

// Where a sign-in starts: keep `pair` in the visitor's session, and send them to `url`.
route GET /sign-in {
    let pair = spotify_pkce()
    { pair: pair, url: spotify_authorize_url(`http://${request.headers.host}/callback`, ["playlist-modify-private"], pair.state, pair.challenge)? }
}

// What the redirect back leads to: the code for tokens, then a playlist made with the visitor's own.
route POST /signed-in {
    let f = request.json
    let t = spotify_exchange_code(f.code, f.redirect_uri, f.verifier)?
    let list = spotify_playlist_create("ada", "Quillo mix", { public: false, description: "Made here" }, t.access_token)?
    let tracks = map(range(0, 230), (i) => "spotify:track:4uLU6hMCjMI75M1A2tKU00")
    let snap = spotify_playlist_add(list.id, tracks, t.access_token)?
    {
        scope: t.scope, name: list.name, added: spotify_playlist(list.id, t.access_token)?.tracks.total, snapshot: len(snap) > 0,
        fresh: spotify_refresh(t.refresh_token)?.access_token != t.access_token,
        wrong: spotify_exchange_code(f.code, f.redirect_uri, repeat("x", 43)).error,
    }
}

route GET /failures = {
    app_token: spotify_playlist_create("ada", "x", {}, "").error,
    bad_token: spotify_playlist_tracks("37i9dQZF1DXcBWIGoYBM5M", "not-a-token", 0).error,
    short: spotify_exchange_code("c", "http://x", "short").error,
    waited: spotify_track("busybusybusybusybusy00")?.name,
    long_wait: spotify_track("longlonglonglonglong00").error,
}
