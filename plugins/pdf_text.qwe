// An invoice's text read from its PDF, page by page, and searched.
//
//   quillo run pdf_text.qwe      then open http://localhost:8080/invoice

use "pdf_text.qwer"

let INVOICE = "pdf_text_sample.pdf"

route GET /invoice {
    let pages = pdf_text_pages(INVOICE)?
    let total = re.find(pages[0], "Total\\s+([\\d.]+)")
    { pages: len(pages), first_page: pages[0], total: total?.groups[0] }
}

route GET /text = pdf_text(INVOICE)

route GET /search ? { q: str = "due" } = pdf_text_search(INVOICE, q, 20)
