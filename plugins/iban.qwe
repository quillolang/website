// A payout form's bank details.
//
//   quillo run iban.qwe      then open http://localhost:8080/check?iban=DE44+5001+0517+5407+3249+31

use "iban.qwer"

route GET /check ? { iban: str } = iban_parse(iban)
route GET /samples = { good: iban_valid("GB82 WEST 1234 5698 7654 32"), typo: iban_valid("GB82 WEST 1234 5698 7654 33"), bic: bic_valid("DEUTDEFF") }
