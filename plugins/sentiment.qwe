// Product reviews sorted by how unhappy they are, so support answers the worst first.
//
//   quillo run sentiment.qwe      then open http://localhost:8080/reviews

use "sentiment.qwer"

let reviews = [
    "Absolutely love it!!! Best purchase this year 😍",
    "It is not good. The strap broke after two days and nobody answered my emails.",
    "Arrived on Tuesday.",
    "The screen is great, but the battery is terrible.",
]

route GET /reviews = reviews | map((r) => { review: r, mood: sentiment_scores(r)? }) | sort_by((r) => r.mood.compound)

route GET /mood ? { text: str } = sentiment_scores(text)?

route GET /sentences = sentiment_sentences("The screen is great. But the battery is terrible!!! Shipping was fine.")?
