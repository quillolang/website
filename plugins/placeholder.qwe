// Placeholders for a page still waiting for its photos, served at any size.
//
//   quillo run placeholder.qwe      then open http://localhost:8080/

use "placeholder.qwer"

route GET /ph/:w(int)/:h(int) ? { text: str = "", bg: str = "#e2e8f0" } =
    respond(200, placeholder_svg(w, h, text == "" ? { background: bg } : { background: bg, text }), { "content-type": "image/svg+xml", "cache-control": "max-age=86400" })

route GET / = <html><body style="font-family: sans-serif">
    <h1>New menu, photos soon</h1>
    <img src="/ph/600/300" width="600" height="300" alt=""/>
    <img src={placeholder_data_url(200, 200, { text: "Soup", background: "#fde68a", color: "#92400e", border: true })} width="200" height="200" alt="Soup"/>
</body></html>
