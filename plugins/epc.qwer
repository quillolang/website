//! RFID tags' EPC numbers by GS1's Tag Data Standard: SGTIN-96 (a product's GTIN and serial), SSCC-96 (a pallet), SGLN-96 (a place), GRAI-96 (a returnable asset) and GIAI-96 (a fixed asset) encoded to the hex an RFID printer or reader writes, and decoded back, with pure identity and tag URIs and the GTIN, SSCC or GLN inside.
//! version: 1.0.0
//!
//! [dependencies]

use serde_json::{json, Value};

/// (header, scheme, [(company prefix bits, digits, reference bits, digits)] by partition, serial bits).
struct Scheme {
    header: u8,
    name: &'static str,
    parts: [(u32, usize, u32, usize); 7],
    serial_bits: u32,
}

const SCHEMES: &[Scheme] = &[
    Scheme { header: 0x30, name: "sgtin", parts: [(40, 12, 4, 1), (37, 11, 7, 2), (34, 10, 10, 3), (30, 9, 14, 4), (27, 8, 17, 5), (24, 7, 20, 6), (20, 6, 24, 7)], serial_bits: 38 },
    Scheme { header: 0x31, name: "sscc", parts: [(40, 12, 18, 5), (37, 11, 21, 6), (34, 10, 24, 7), (30, 9, 28, 8), (27, 8, 31, 9), (24, 7, 34, 10), (20, 6, 38, 11)], serial_bits: 0 },
    Scheme { header: 0x32, name: "sgln", parts: [(40, 12, 1, 0), (37, 11, 4, 1), (34, 10, 7, 2), (30, 9, 11, 3), (27, 8, 14, 4), (24, 7, 17, 5), (20, 6, 21, 6)], serial_bits: 41 },
    Scheme { header: 0x33, name: "grai", parts: [(40, 12, 4, 0), (37, 11, 7, 1), (34, 10, 10, 2), (30, 9, 14, 3), (27, 8, 17, 4), (24, 7, 20, 5), (20, 6, 24, 6)], serial_bits: 38 },
    Scheme { header: 0x34, name: "giai", parts: [(40, 12, 42, 13), (37, 11, 45, 14), (34, 10, 48, 15), (30, 9, 52, 16), (27, 8, 55, 17), (24, 7, 58, 18), (20, 6, 62, 19)], serial_bits: 0 },
];

fn check_digit(digits: &str) -> u32 {
    let s: u32 = digits.chars().rev().enumerate().map(|(i, c)| c.to_digit(10).unwrap_or(0) * if i % 2 == 0 { 3 } else { 1 }).sum();
    (10 - s % 10) % 10
}

/// Bits written most significant first into a 96-bit number.
struct W {
    v: u128,
    n: u32,
}

impl W {
    fn put(&mut self, x: u128, bits: u32) {
        self.v = (self.v << bits) | (x & ((1u128 << bits) - 1));
        self.n += bits;
    }
    fn hex(self) -> String {
        format!("{:024X}", self.v << (96 - self.n))
    }
}

fn get(v: u128, start: u32, len: u32) -> u128 {
    (v >> (96 - start - len)) & ((1u128 << len) - 1)
}

fn digits(s: &str) -> Result<String, String> {
    let d: String = s.chars().filter(|c| !c.is_whitespace() && *c != '-').collect();
    if d.is_empty() || !d.chars().all(|c| c.is_ascii_digit()) {
        return Err(format!("{:?}: digits only", s));
    }
    Ok(d)
}

fn partition(scheme: &Scheme, cp_len: i64) -> Result<(usize, (u32, usize, u32, usize)), String> {
    scheme.parts.iter().enumerate().find(|(_, p)| p.1 as i64 == cp_len).map(|(i, p)| (i, *p)).ok_or_else(|| "a GS1 company prefix is 6 to 12 digits".to_string())
}

fn filter_of(f: i64) -> Result<u128, String> {
    if !(0..=7).contains(&f) {
        return Err("the filter value is 0 to 7 (1 point of sale item, 2 case, 3 load, ...)".into());
    }
    Ok(f as u128)
}

/// An SGTIN-96 from a GTIN (8 to 14 digits, its check digit right), the length of its GS1 company prefix, and a serial (0 to 274,877,906,943). `filter`: 1 for a point-of-sale item, 2 a full case, 3 a load, 0 anything else. Gives 24 hex digits.
pub fn epc_sgtin(gtin: &str, company_prefix_length: i64, serial: i64, filter: i64) -> Result<String, String> {
    let g = format!("{:0>14}", digits(gtin)?);
    if g.len() != 14 || check_digit(&g[..13]).to_string() != g[13..] {
        return Err(format!("{:?} is not a GTIN with a right check digit", gtin));
    }
    if serial < 0 || serial >= 1 << 38 {
        return Err("an SGTIN-96 serial is 0 to 274877906943".into());
    }
    let s = &SCHEMES[0];
    let (p, (cb, cd, rb, _)) = partition(s, company_prefix_length)?;
    // The item reference is the indicator digit, then the GTIN's digits after the company prefix.
    let cp: u128 = g[1..1 + cd].parse().unwrap();
    let item: u128 = format!("{}{}", &g[..1], &g[1 + cd..13]).parse().unwrap();
    let mut w = W { v: 0, n: 0 };
    w.put(0x30, 8);
    w.put(filter_of(filter)?, 3);
    w.put(p as u128, 3);
    w.put(cp, cb);
    w.put(item, rb);
    w.put(serial as u128, 38);
    Ok(w.hex())
}

/// An SSCC-96 from an SSCC (18 digits, its check digit right) and its company prefix length. Gives 24 hex digits.
pub fn epc_sscc(sscc: &str, company_prefix_length: i64, filter: i64) -> Result<String, String> {
    let d = digits(sscc)?;
    if d.len() != 18 || check_digit(&d[..17]).to_string() != d[17..] {
        return Err(format!("{:?} is not an SSCC with a right check digit", sscc));
    }
    let s = &SCHEMES[1];
    let (p, (cb, cd, rb, _)) = partition(s, company_prefix_length)?;
    let cp: u128 = d[1..1 + cd].parse().unwrap();
    let serial: u128 = format!("{}{}", &d[..1], &d[1 + cd..17]).parse().unwrap();
    let mut w = W { v: 0, n: 0 };
    w.put(0x31, 8);
    w.put(filter_of(filter)?, 3);
    w.put(p as u128, 3);
    w.put(cp, cb);
    w.put(serial, rb);
    w.put(0, 24);
    Ok(w.hex())
}

/// An SGLN-96 from a GLN (13 digits), its company prefix length and an extension (0 for the place itself). Gives 24 hex digits.
pub fn epc_sgln(gln: &str, company_prefix_length: i64, extension: i64, filter: i64) -> Result<String, String> {
    let d = digits(gln)?;
    if d.len() != 13 || check_digit(&d[..12]).to_string() != d[12..] {
        return Err(format!("{:?} is not a GLN with a right check digit", gln));
    }
    if extension < 0 || extension >= 1 << 41 {
        return Err("an SGLN-96 extension is 0 to 2199023255551".into());
    }
    let s = &SCHEMES[2];
    let (p, (cb, cd, rb, _)) = partition(s, company_prefix_length)?;
    let mut w = W { v: 0, n: 0 };
    w.put(0x32, 8);
    w.put(filter_of(filter)?, 3);
    w.put(p as u128, 3);
    w.put(d[..cd].parse().unwrap(), cb);
    w.put(if cd < 12 { d[cd..12].parse().unwrap() } else { 0 }, rb);
    w.put(extension as u128, 41);
    Ok(w.hex())
}

/// A GRAI-96 (a returnable asset: a crate, a keg, a pallet) from its company prefix, asset type and serial. Gives 24 hex digits.
pub fn epc_grai(company_prefix: &str, asset_type: &str, serial: i64, filter: i64) -> Result<String, String> {
    let cp = digits(company_prefix)?;
    let s = &SCHEMES[3];
    let (p, (cb, _, rb, rd)) = partition(s, cp.len() as i64)?;
    let at = if rd == 0 { String::new() } else { digits(asset_type)? };
    if at.len() != rd {
        return Err(format!("with a {}-digit company prefix the asset type has {} digits", cp.len(), rd));
    }
    if serial < 0 || serial >= 1 << 38 {
        return Err("a GRAI-96 serial is 0 to 274877906943".into());
    }
    let mut w = W { v: 0, n: 0 };
    w.put(0x33, 8);
    w.put(filter_of(filter)?, 3);
    w.put(p as u128, 3);
    w.put(cp.parse().unwrap(), cb);
    w.put(if rd == 0 { 0 } else { at.parse().unwrap() }, rb);
    w.put(serial as u128, 38);
    Ok(w.hex())
}

/// A GIAI-96 (a fixed asset: a machine, a laptop) from its company prefix and a numeric asset reference. Gives 24 hex digits.
pub fn epc_giai(company_prefix: &str, asset_reference: &str, filter: i64) -> Result<String, String> {
    let cp = digits(company_prefix)?;
    let r = digits(asset_reference)?;
    let s = &SCHEMES[4];
    let (p, (cb, _, rb, _)) = partition(s, cp.len() as i64)?;
    let rv: u128 = r.parse().map_err(|_| "the asset reference is too long".to_string())?;
    if rv >= 1u128 << rb || r.starts_with('0') && r.len() > 1 {
        return Err(format!("with a {}-digit company prefix the asset reference fits {} bits and has no leading zero", cp.len(), rb));
    }
    let mut w = W { v: 0, n: 0 };
    w.put(0x34, 8);
    w.put(filter_of(filter)?, 3);
    w.put(p as u128, 3);
    w.put(cp.parse().unwrap(), cb);
    w.put(rv, rb);
    Ok(w.hex())
}

/// A 96-bit EPC (24 hex digits, as a reader reports it) decoded: `{ scheme, filter, company_prefix, reference, serial, gtin | sscc | gln, pure_uri, tag_uri }`.
pub fn epc_decode(hex: &str) -> Result<serde_json::Value, String> {
    let h: String = hex.chars().filter(|c| !c.is_whitespace()).collect();
    let h = h.trim_start_matches("0x").trim_start_matches("0X");
    if h.len() != 24 || !h.chars().all(|c| c.is_ascii_hexdigit()) {
        return Err("a 96-bit EPC is 24 hex digits".into());
    }
    let v = u128::from_str_radix(h, 16).unwrap();
    let header = get(v, 0, 8) as u8;
    let s = SCHEMES.iter().find(|s| s.header == header).ok_or_else(|| format!("header {:02X} is not SGTIN-96, SSCC-96, SGLN-96, GRAI-96 or GIAI-96", header))?;
    let filter = get(v, 8, 3) as u8;
    let p = get(v, 11, 3) as usize;
    if p > 6 {
        return Err("partition 7 does not exist: not a valid EPC".into());
    }
    let (cb, cd, rb, rd) = s.parts[p];
    let cp = format!("{:0w$}", get(v, 14, cb), w = cd);
    let rv = get(v, 14 + cb, rb);
    let reference = if rd == 0 { String::new() } else if s.name == "giai" { rv.to_string() } else { format!("{:0w$}", rv, w = rd) };
    if cp.len() != cd || reference.len() > rd.max(1) && s.name != "giai" {
        return Err("the company prefix or reference has more digits than its partition allows".into());
    }
    let serial = if s.serial_bits > 0 { Some(get(v, 14 + cb + rb, s.serial_bits)) } else { None };
    let mut out = json!({ "scheme": format!("{}-96", s.name), "filter": filter, "partition": p, "company_prefix": cp, "reference": reference, "serial": serial.map(|x| x.to_string()) });
    let (pure, tag) = match s.name {
        "sgtin" => {
            let g13 = format!("{}{}{}", &reference[..1], cp, &reference[1..]);
            out["gtin"] = json!(format!("{}{}", g13, check_digit(&g13)));
            (format!("urn:epc:id:sgtin:{}.{}.{}", cp, reference, serial.unwrap()), format!("urn:epc:tag:sgtin-96:{}.{}.{}.{}", filter, cp, reference, serial.unwrap()))
        }
        "sscc" => {
            let s17 = format!("{}{}{}", &reference[..1], cp, &reference[1..]);
            out["sscc"] = json!(format!("{}{}", s17, check_digit(&s17)));
            (format!("urn:epc:id:sscc:{}.{}", cp, reference), format!("urn:epc:tag:sscc-96:{}.{}.{}", filter, cp, reference))
        }
        "sgln" => {
            let g12 = format!("{}{}", cp, reference);
            out["gln"] = json!(format!("{}{}", g12, check_digit(&g12)));
            (format!("urn:epc:id:sgln:{}.{}.{}", cp, reference, serial.unwrap()), format!("urn:epc:tag:sgln-96:{}.{}.{}.{}", filter, cp, reference, serial.unwrap()))
        }
        "grai" => (format!("urn:epc:id:grai:{}.{}.{}", cp, reference, serial.unwrap()), format!("urn:epc:tag:grai-96:{}.{}.{}.{}", filter, cp, reference, serial.unwrap())),
        _ => (format!("urn:epc:id:giai:{}.{}", cp, reference), format!("urn:epc:tag:giai-96:{}.{}.{}", filter, cp, reference)),
    };
    out["pure_uri"] = json!(pure);
    out["tag_uri"] = json!(tag);
    Ok(out)
}

/// A tag URI (`urn:epc:tag:sgtin-96:3.0614141.812345.6789`, and the sscc, sgln, grai and giai forms) as its 24 hex digits.
pub fn epc_from_uri(uri: &str) -> Result<String, String> {
    let rest = uri.trim().strip_prefix("urn:epc:tag:").ok_or("a tag URI starts urn:epc:tag:")?;
    let (scheme, body) = rest.split_once(':').ok_or("no scheme")?;
    let p: Vec<&str> = body.split('.').collect();
    let f = |i: usize| -> Result<i64, String> { p.get(i).ok_or("a part is missing".to_string())?.parse::<i64>().map_err(|_| format!("{:?} is not a number", p[i])) };
    match scheme {
        "sgtin-96" if p.len() == 4 => {
            let (cp, item) = (p[1], p[2]);
            let g13 = format!("{}{}{}", &item[..1.min(item.len())], cp, item.get(1..).unwrap_or(""));
            epc_sgtin(&format!("{}{}", g13, check_digit(&g13)), cp.len() as i64, f(3)?, f(0)?)
        }
        "sscc-96" if p.len() == 3 => {
            let s17 = format!("{}{}{}", &p[2][..1.min(p[2].len())], p[1], p[2].get(1..).unwrap_or(""));
            epc_sscc(&format!("{}{}", s17, check_digit(&s17)), p[1].len() as i64, f(0)?)
        }
        "sgln-96" if p.len() == 4 => {
            let g12 = format!("{}{}", p[1], p[2]);
            epc_sgln(&format!("{}{}", g12, check_digit(&g12)), p[1].len() as i64, f(3)?, f(0)?)
        }
        "grai-96" if p.len() == 4 => epc_grai(p[1], p[2], f(3)?, f(0)?),
        "giai-96" if p.len() == 3 => epc_giai(p[1], p[2], f(0)?),
        _ => Err(format!("{:?}: sgtin-96, sscc-96, sgln-96, grai-96 or giai-96 with its parts", scheme)),
    }
}

/// Many reads decoded at once (a reader's inventory): each `{ hex, ... }` as `epc_decode` gives it, or `{ hex, error }`; repeats counted in `reads`.
pub fn epc_inventory(hexes: Vec<String>) -> Vec<serde_json::Value> {
    let mut seen: Vec<(String, Value)> = vec![];
    for h in hexes {
        let k = h.trim().to_uppercase();
        if let Some(e) = seen.iter_mut().find(|(x, _)| *x == k) {
            e.1["reads"] = json!(e.1["reads"].as_i64().unwrap_or(1) + 1);
            continue;
        }
        let mut v = epc_decode(&k).unwrap_or_else(|e| json!({ "error": e }));
        v["hex"] = json!(k);
        v["reads"] = json!(1);
        seen.push((k, v));
    }
    seen.into_iter().map(|(_, v)| v).collect()
}
