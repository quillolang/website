// The PROXY protocol, which load balancers (HAProxy, AWS NLB, Google Cloud, Azure, nginx) put in
// front of a connection to say who the client really was: headers read and built, a UDP listener
// behind a balancer that sends version 2 on each datagram, and a header sent through to a server.
//
//   quillo run proxy_protocol.qwe      then open http://localhost:8080/read, /build and /udp
//   BACKEND=127.0.0.1:8443 quillo run proxy_protocol.qwe      and /send (nginx with `listen 8443 proxy_protocol`)

use "proxy_protocol.qwer"

// A header as an AWS Network Load Balancer sends it: TCP over IPv4, the VPC endpoint it came
// through, and a CRC32C checksum.
let NLB = "DQoNCgANClFVSVQKIREALcsAcQcKAAHEw8sBu+oAFwF2cGNlLTA4ZDJiZjE1ZmFjM2Q3OTAzAwAEIaRA9w=="

route GET /read {
    let nlb = proxy_parse(NLB)?
    let v1 = proxy_parse_text("PROXY TCP6 2001:db8::1 2001:db8::2 51234 443\r\nGET / HTTP/1.1\r\n")?
    {
        client: `${nlb.source}:${nlb.source_port}`,
        endpoint: nlb.tlvs.aws_vpce_id,
        checksum_ok: nlb.tlvs.crc32c_valid,
        v1: { protocol: v1.protocol, client: v1.source, port: v1.source_port, then: v1.rest_text },
        bad_port: proxy_parse_text("PROXY TCP4 10.0.0.1 10.0.0.2 080 443").error,
        not_proxy: proxy_parse_text("GET / HTTP/1.1").error,
    }
}

// What a TLS-terminating balancer passes on: the client, the SNI it asked for, and its certificate.
route GET /build {
    let info = {
        protocol: "TCP4", source: "198.51.100.23", source_port: 50112, destination: "10.0.1.5", destination_port: 443,
        tlvs: {
            alpn: "h2", authority: "shop.example.com", unique_id: "req-7f3a",
            ssl: { client_cert_conn: true, verified: true, version: "TLSv1.3", cn: "device-0042", cipher: "TLS_AES_128_GCM_SHA256" },
            crc32c: true,
        },
    }
    let v2 = proxy_v2(info)?
    let back = proxy_parse(v2)?
    {
        v1: proxy_v1(info)?,
        v2,
        back: { authority: back.tlvs.authority, cn: back.tlvs.ssl.cn, verified: back.tlvs.ssl.verified, checksum_ok: back.tlvs.crc32c_valid },
        tampered: proxy_parse(replace(v2, "c2hvcC", "c2hvcB")).error,
    }
}

// UDP behind a balancer: each datagram starts with a version 2 header.
let UDP_PORT = int(env("PP_UDP_PORT") ?? "5514")
let datagrams = []
udp.listen(UDP_PORT, (p) => {
    let h = proxy_parse_bytes(p.bytes)
    datagrams = datagrams + [is_err(h) ? { error: h.error } : { client: `${h.source}:${h.source_port}`, protocol: h.protocol, payload: h.rest_text }]
}, { host: "127.0.0.1" })

route GET /udp {
    let info = { protocol: "UDP4", source: "203.0.113.9", source_port: 40000, destination: "127.0.0.1", destination_port: UDP_PORT }
    udp.send("127.0.0.1", UDP_PORT, proxy_packet(info, "temp=21.5")?)
    udp.send("127.0.0.1", UDP_PORT, "no header here")
    sleep(200)
    { datagrams }
}

// Through to a server that expects the header: nginx answers with the client it was told about.
route GET /send {
    let backend = env("BACKEND", null) ?? reply 503 "set BACKEND to host:port of a server that takes the PROXY protocol"
    let info = { version: 2, source: "198.51.100.23", source_port: 50112, destination: "10.0.1.5", destination_port: 80, tlvs: { authority: "shop.example.com" } }
    proxy_send(backend, info, "GET / HTTP/1.0\r\nHost: shop.example.com\r\n\r\n", 3000)?
}
