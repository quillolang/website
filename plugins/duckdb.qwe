// Sales totals straight from a CSV export, a summary of its columns, and the same file as Parquet.
//
//   quillo run duckdb.qwe      then open http://localhost:8080/by-region

use "duckdb.qwer"

let SALES = "duckdb_sample.csv"

route GET /by-region ? { min: float = 0.0 } = duckdb_query(
    `select region, count(*) as orders, round(sum(total), 2) as revenue
     from '${SALES}' where total >= ? group by region order by revenue desc`, [min])?

route GET /columns = duckdb_csv_summary(SALES)?

route GET /parquet {
    let n = duckdb_csv_to_parquet(SALES, "data/sales.parquet")?
    { rows: n, best: duckdb_query("select product, sum(quantity) as sold from read_parquet('data/sales.parquet') group by product order by sold desc limit 1", [])? }
}
