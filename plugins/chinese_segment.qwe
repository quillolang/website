// A search index for Chinese product titles, and a contact list sorted and searched by pinyin.
//
//   quillo run chinese_segment.qwe      then open http://localhost:8080/words

use "chinese_segment.qwer"

route GET /words ? { text: str = "我来到北京清华大学" } = { words: chinese_cut(text)?, index: chinese_search_terms(text)?, tags: chinese_tag(text)? }

let contacts = ["张伟", "王芳", "李娜", "刘洋"]

route GET /contacts = contacts
    | map((c) => { name: c, pinyin: chinese_pinyin(c, "tone")?, sort: chinese_pinyin(c, "plain")?, initials: chinese_initials(c)? })
    | sort_by((c) => c.sort)

route GET /pinyin ? { text: str } = { tone: chinese_pinyin(text, "tone")?, number: chinese_pinyin(text, "number")? }
