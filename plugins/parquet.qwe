// A nightly export of orders as Parquet for the analytics team, and a look inside it.
//
//   quillo run parquet.qwe      then open http://localhost:8080/export

use "parquet.qwer"

let ORDERS = [
    { id: 1, customer: "Ada Lovelace", total: 120.5, paid: true, placed: "2026-11-02T09:15:00Z", items: ["B7", "C2"] },
    { id: 2, customer: "Grace Hopper", total: 99, paid: false, placed: "2026-11-02T10:40:00Z", items: ["A1"] },
    { id: 3, customer: "Alan Turing", total: null, paid: true, placed: "2026-11-03T08:05:00Z", items: [] },
]

route GET /export {
    let n = parquet_write("data/orders.parquet", ORDERS, ["id", "customer", "total", "paid", "placed", "items"])?
    { written: n, info: parquet_info("data/orders.parquet")? }
}

route GET /import {
    parquet_write("data/orders.parquet", ORDERS, [])?
    parquet_read("data/orders.parquet", 0)?
}
