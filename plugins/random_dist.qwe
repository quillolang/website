// A bakery's Monte Carlo forecast: customers a day (Poisson), what each spends (log-normal),
// and the chance a day's takings beat €900; seeded, so the page shows the same run each time.
//
//   quillo run random_dist.qwe      then open http://localhost:8080/forecast

use "random_dist.qwer"

route GET /forecast ? { days: int = 2000, seed: int = 42 } {
    let customers = dist_poisson(120.0, days, seed)?
    let spend = dist_lognormal(1.9, 0.4, days, seed + 1)?
    let takings = zip(customers, spend) | map((d) => d[0] * d[1])
    let s = dist_summary(takings)?
    { typical_day: round(s.p50, 0), bad_day: round(s.p5, 0), good_day: round(s.p95, 0), chance_over_900: round(count(takings, (t) => t > 900) / days, 3) }
}

route GET /check = {
    normal: dist_summary(dist_normal(100.0, 15.0, 100000, 7)?)?,
    same_again: dist_normal(0.0, 1.0, 3, 5)? == dist_normal(0.0, 1.0, 3, 5)?,
    arrivals_mean: dist_summary(dist_exponential(0.5, 10000, 3)?)?.mean,
    defects: dist_binomial(200, 0.02, 5, 9)?,
    bad: dist_normal(0.0, -1.0, 3, 1).error,
}
