//! H3 hexagons (Uber's global grid): the cell of a point at a resolution, its neighbours within k rings, its outline for a map, and the distance between cells. For heat maps, delivery zones, and "near me" by cell id in SQL.
//! version: 1.0.0
//!
//! [dependencies]
//! h3o = "0.6"

use h3o::{CellIndex, LatLng, Resolution};
use serde_json::{json, Value};
use std::str::FromStr;

fn res(r: i64) -> Result<Resolution, String> {
    u8::try_from(r).ok().and_then(|r| Resolution::try_from(r).ok()).ok_or(format!("{} is not a resolution: 0 (continents) to 15 (about 1 m²)", r))
}

fn cell(id: &str) -> Result<CellIndex, String> {
    CellIndex::from_str(id.trim()).map_err(|_| format!("`{}` is not an H3 cell id", id))
}

fn point(lat: f64, lon: f64) -> Result<LatLng, String> {
    LatLng::new(lat, lon).map_err(|_| format!("{}, {} is not a place", lat, lon))
}

/// The id of the cell holding a point, as 15 hex digits (`8a1969053247fff`), at `resolution` 0 to 15: 7 is about 5 km², 9 about 0.1 km², 12 about 300 m².
pub fn h3_cell(lat: f64, lon: f64, resolution: i64) -> Result<String, String> {
    Ok(point(lat, lon)?.to_cell(res(resolution)?).to_string())
}

/// About a cell: `{ id, resolution, lat, lon, area_km2, pentagon, parent }`, the centre's coordinates, and its parent one resolution up (null at 0).
pub fn h3_info(id: &str) -> Result<Value, String> {
    let c = cell(id)?;
    let ll = LatLng::from(c);
    let parent = c.resolution().pred().and_then(|r| c.parent(r)).map(|p| p.to_string());
    Ok(json!({
        "id": c.to_string(), "resolution": u8::from(c.resolution()), "lat": ll.lat(), "lon": ll.lng(),
        "area_km2": c.area_km2(), "pentagon": c.is_pentagon(), "parent": parent,
    }))
}

/// The cell and every cell within `k` steps of it (k 0 to 50): 1 gives the 7 of a ring, 2 gives 19. For "within about this far" searches with `where cell in (...)`.
pub fn h3_disk(id: &str, k: i64) -> Result<Vec<String>, String> {
    let c = cell(id)?;
    let k = u32::try_from(k.clamp(0, 50)).unwrap_or(0);
    let cells: Vec<CellIndex> = c.grid_disk(k);
    Ok(cells.into_iter().map(|c| c.to_string()).collect())
}

/// The cell's outline, as `[[lat, lon], ...]` (6 corners, 5 for a pentagon, a few more where edges cross faces), for drawing on a map.
pub fn h3_boundary(id: &str) -> Result<Vec<Vec<f64>>, String> {
    Ok(cell(id)?.boundary().iter().map(|p| vec![p.lat(), p.lng()]).collect())
}

/// How many cell steps apart two cells of the same resolution are, or an error when they are too far apart to count (on another face of the grid).
pub fn h3_distance(a: &str, b: &str) -> Result<i64, String> {
    let (a, b) = (cell(a)?, cell(b)?);
    if a.resolution() != b.resolution() {
        return Err("the cells are of different resolutions".into());
    }
    a.grid_distance(b).map(i64::from).map_err(|e| e.to_string())
}

/// The cell holding `id` at a coarser `resolution` (for rolling up counts from street to district level).
pub fn h3_parent(id: &str, resolution: i64) -> Result<String, String> {
    let c = cell(id)?;
    c.parent(res(resolution)?).map(|p| p.to_string()).ok_or(format!("resolution {} is not coarser than the cell's", resolution))
}
