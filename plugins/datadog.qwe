// A service reporting to Datadog: metrics with tags, a deploy event, a service check, and a pile of
// logs split and gzipped within the intake's limits.
//
//   DD_API_KEY=... DD_SITE=datadoghq.eu quillo run datadog.qwe
//   then open http://localhost:8080/metrics, /event, /check, /logs and /failures
//
// DD_SITE is the site the account lives on. DATADOG_API_URL and DATADOG_LOGS_URL reach test servers.

use "datadog.qwer"

let TAGS = { env: "Prod EU", service: "checkout" }

route GET /metrics = {
    gauge: datadog_metric("shop.queue.depth", 12.0, { tags: TAGS, host: "web-1", unit: "item" })?.errors,
    count: datadog_metric("shop.orders", 3.0, { type: "count", interval: 60, tags: ["region:EU", "1bad tag!"] })?.errors,
    many: datadog_metrics([
        { name: "shop.latency", value: 0.21, tags: TAGS },
        { name: "shop.errors", value: 2, type: "rate", interval: 10 },
    ], {})?.errors,
    valid: datadog_validate({})?,
}

route GET /event {
    let e = datadog_event("Deployed checkout 2.4", "Version 2.4 is live.", { alert_type: "success", tags: TAGS, aggregation_key: "deploy-2.4", source_type_name: "quillo" })?
    { status: e.status, id: e.id }
}

route GET /check = {
    sent: datadog_check("checkout.can_connect", 2, "web-1", { message: "No answer on 443", tags: TAGS })?.status,
}

// 2,300 lines go in three batches, whatever size they are.
route GET /logs {
    let lines = map(range(0, 2300), (i) => { message: `Order ${i} paid`, order: i, level: "info" })
    let long = map(range(0, 6), (i) => repeat("x", 900000))
    {
        many: datadog_logs(lines, { service: "checkout", hostname: "web-1", source: "quillo", tags: TAGS })?,
        big: datadog_logs(long, { service: "checkout" })?,
        one: datadog_log("Started", { service: "checkout", source: "quillo" })?,
    }
}

route GET /tags = {
    from_map: datadog_tags({ env: "Prod EU", "Team Name": "Pay & Go" })?,
    from_list: datadog_tags(["region:EU", "123start", ":"])?,
}

route GET /failures = {
    bad_name: datadog_metric("1 bad name", 1.0, {}).error,
    bad_type: datadog_metric("a.b", 1.0, { type: "histogram" }).error,
    too_old: datadog_metric("a.b", 1.0, { timestamp: 1000 }).error,
    bad_key: datadog_metric("a.b", 1.0, { api_key: "wrong" }).error,
    not_valid: datadog_validate({ api_key: "wrong" })?,
    refused: datadog_metric("refused.metric", 1.0, {}).error,
    one_too_big: datadog_logs([repeat("x", 1000001)], {}).error,
    bad_status: datadog_check("c", 9, "h", {}).error,
    no_title: datadog_event(" ", "x", {}).error,
    retried: datadog_metric("flaky.metric", 1.0, {})?.errors,
}
