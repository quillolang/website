// An order service kept as events: each order a stream, written with the version last read (two
// clerks cannot overwrite each other), the order rebuilt from a snapshot and the events after it,
// a sales projection read from the whole log, and the hash chain catching an edited past line.
//
//   quillo run event_log.qwe      then open http://localhost:8080/demo

use "event_log.qwer"

// An order's state from its events.
fn apply(state, e) = match e.type {
    "OrderPlaced" => { customer: e.data.customer, items: [], total: 0, status: "open" },
    "ItemAdded" => merge(state, { items: state.items + [e.data.sku], total: state.total + e.data.price }),
    "OrderPaid" => merge(state, { status: "paid" }),
    _ => state,
}

fn fold(state, events) = reduce(events, state, (s, e) => apply(s, e))

route GET /demo {
    let log = `data/orders-${uuid()}.log`
    elog_append(log, "order-42", [{ type: "OrderPlaced", data: { customer: "Ada" } }], -1)?
    let v = elog_append(log, "order-42", [{ type: "ItemAdded", data: { sku: "TEA-01", price: 450 } }, { type: "ItemAdded", data: { sku: "MUG-02", price: 1200 } }], 1)?
    elog_append(log, "order-43", [{ type: "OrderPlaced", data: { customer: "Grace" } }, { type: "ItemAdded", data: { sku: "TEA-01", price: 450 } }], null)?
    // A second clerk who read version 1 tries to write: refused.
    let stale = elog_append(log, "order-42", [{ type: "OrderPaid", data: {} }], 1).error
    elog_append(log, "order-42", [{ type: "OrderPaid", data: { method: "card" } }], v.version)?
    let order = fold(null, elog_read_stream(log, "order-42", 1, 100)?)
    elog_snapshot(log, "order-42", 4, order)?
    let loaded = elog_load(log, "order-42")?
    let sold = elog_read_all(log, 0, 1000, ["ItemAdded"])?
    let before = elog_verify(log)?
    write_file(log, replace(read_file(log)?, "\"price\":1200", "\"price\":12"))
    let after = elog_verify(log)?
    delete_file(log)
    delete_file(`${log}.snapshots`)
    {
        version: v, stale: stale, order: order,
        loaded: { snapshot_version: loaded.snapshot.version, events_after: len(loaded.events), version: loaded.version },
        sales: sum(map(sold, (e) => e.data.price)),
        verified: before.ok, tampered: after,
    }
}
