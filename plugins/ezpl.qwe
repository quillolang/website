// A pharmacy wholesaler's shelf and tote labels on a Godex printer (G500, RT200): product,
// price, EAN-13, a Code 128 for the location and a QR code to the product's page.
//
//   quillo run ezpl.qwe      then open http://localhost:8080/label
//   PRINTER_HOST=192.168.1.67 quillo run ezpl.qwe      and http://localhost:8080/print

use "ezpl.qwer"

let OPTIONS = { dpi: 203, width: 60, height: 40, gap: 3, darkness: 12, speed: 4, copies: 2 }

fn shelf(p) = [
    { box: true, x: 1, y: 1, width: 58, height: 38, thickness: 0.3 },
    { text: p.name, x: 3, y: 3, size: 4 },
    { text: p.price, x: 3, y: 10, size: 8 },
    { barcode: "ean13", data: p.ean, x: 3, y: 22, height: 10, module: 2 },
    { barcode: "qr", data: `https://pharma.example/p/${p.ean}`, x: 44, y: 10, magnification: 3 },
    { line: true, x: 1, y: 20, width: 58, thickness: 0.3 },
]

let ITEM = { name: "Ibuprofen 400 mg x 20", price: "4.95", ean: "5901234123457" }

route GET /label = respond(200, ezpl_label(shelf(ITEM), OPTIONS)?, { "content-type": "text/plain" })

route GET /tote = ezpl_label([
    { text: "TOTE 0412", x: 2, y: 2, font: "H" },
    { barcode: "code128", data: "TOTE-0412", x: 2, y: 14, height: 12, wide: 4 },
], { width: 60, height: 30, media: "continuous" })

route GET /print {
    let host = env("PRINTER_HOST", null) ?? reply 503 "set PRINTER_HOST to the printer's address (host or host:port)"
    { sent: ezpl_send(shelf(ITEM), OPTIONS, host, 5000)?, saved: ezpl_write(shelf(ITEM), OPTIONS, "data/shelf.ezpl")? }
}
