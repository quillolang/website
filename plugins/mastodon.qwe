// Mastodon: a status counted as Mastodon counts it, a picture uploaded and waited for, a timeline
// read as text and paged by its Link header, and the instance's refusals.
//
//   MASTODON_API_URL=https://mastodon.social MASTODON_TOKEN=... quillo run mastodon.qwe
//   then open http://localhost:8080/me, /post, /length, /media, /timeline, /tag and /failures
//
// The token comes from the instance's Preferences > Development.

use "mastodon.qwer"

route GET /me {
    let me = mastodon_me({})?
    { acct: me.acct, followers: me.followers_count }
}

route GET /post {
    let once = mastodon_post("Release 2.4 is out", { visibility: "unlisted", idempotency_key: "release-2.4" })?
    let again = mastodon_post("Release 2.4 is out", { visibility: "unlisted", idempotency_key: "release-2.4" })?
    let read = mastodon_status(once.id, {})?
    let later = mastodon_post("Tomorrow's post", { scheduled_at: "2030-01-01T09:00:00Z" })?
    { id: once.id, same: once.id == again.id, text: read.text, scheduled: later.scheduled_at, removed: mastodon_delete(once.id, {})? }
}

// A link counts as 23 however long; a mention as its @user only.
route GET /length {
    let url = "https://example.com/a/very/long/path/that/goes/on/and/on/and/on/and/on/and/on"
    {
        link: mastodon_length(`See ${url}.`, 0).length,
        mention: mastodon_length("Hi @ada@mathstodon.xyz!", 0).length,
        over: mastodon_length(repeat("x", 501), 0).fits,
        fits_long_link: mastodon_post(repeat("y", 470) + " " + url, {})?.id != null,
    }
}

route GET /media {
    write_file("data/mastodon-demo.png", "not really a png")
    let quick = mastodon_media("data/mastodon-demo.png", "A chart", 5, {})?
    write_file("data/mastodon-slow.mp4", "not really a video")
    let slow = mastodon_media("data/mastodon-slow.mp4", "A clip", 10, {})?
    let post = mastodon_post("With pictures", { media_ids: [quick.id, slow.id] })?
    { quick: quick.description, slow_url: slow.url, attached: len(post.media), kind: mastodon_media("notes.txt", "", 0, {}).error }
}

route GET /timeline {
    let one = mastodon_timeline("home", { limit: 2 })?
    let two = mastodon_page(one.next, {})?
    {
        first: map(one.statuses, (s) => s.text),
        boosted: one.statuses[1].boosted_by,
        second: map(two.statuses, (s) => s.id),
        remaining: one.rate.remaining,
        all: len(mastodon_all("home", 100, { limit: 2 })?),
        capped: len(mastodon_all("home", 3, { limit: 2 })?),
    }
}

route GET /tag {
    let t = mastodon_timeline("tag/quillo lang", {})?
    { count: len(t.statuses) }
}

route GET /failures = {
    too_long: mastodon_post(repeat("x", 501), {}).error,
    empty: mastodon_post(" ", {}).error,
    bad_token: mastodon_me({ token: "wrong" }).error,
    unknown: mastodon_status("999", {}).error,
    invalid: mastodon_post("refused by the server", {}).error,
    retried: mastodon_post("rate me", {})?.text,
    no_timeline: mastodon_timeline("everything", {}).error,
    off_site: mastodon_page("https://evil.example/api/v1/timelines/home", {}).error,
}
