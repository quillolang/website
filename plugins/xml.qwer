//! XML read as values: feeds from partners, SOAP answers, sitemaps, invoices (UBL), SVG.
//!
//! [dependencies]
//! roxmltree = "0.20"

use serde_json::{json, Map, Value};

fn element(n: roxmltree::Node) -> Value {
    let attrs: Map<String, Value> = n.attributes().map(|a| (a.name().to_string(), Value::String(a.value().to_string()))).collect();
    let children: Vec<Value> = n.children().filter(|c| c.is_element()).map(element).collect();
    let text: String = n.children().filter(|c| c.is_text()).filter_map(|c| c.text()).collect::<String>();
    json!({ "tag": n.tag_name().name(), "attrs": attrs, "text": text.trim(), "children": children })
}

fn doc(text: &str) -> Result<roxmltree::Document<'_>, String> {
    roxmltree::Document::parse_with_options(text, roxmltree::ParsingOptions { allow_dtd: false, ..Default::default() }).map_err(|e| e.to_string())
}

/// XML text as nested maps: `{ tag, attrs, text, children }` for each element (namespaces dropped from names). DTDs are refused.
pub fn xml_parse(text: &str) -> Result<Value, String> {
    Ok(element(doc(text)?.root_element()))
}

/// The text of every element named `tag`, in document order: `xml_texts(feed, "title")`.
pub fn xml_texts(text: &str, tag: &str) -> Result<Vec<String>, String> {
    Ok(doc(text)?.descendants().filter(|n| n.is_element() && n.tag_name().name() == tag)
        .map(|n| n.descendants().filter(|c| c.is_text()).filter_map(|c| c.text()).collect::<String>().trim().to_string()).collect())
}

/// An attribute of every element named `tag` that has it: `xml_attrs(svg, "path", "d")`.
pub fn xml_attrs(text: &str, tag: &str, attr: &str) -> Result<Vec<String>, String> {
    Ok(doc(text)?.descendants().filter(|n| n.is_element() && n.tag_name().name() == tag)
        .filter_map(|n| n.attribute(attr).map(str::to_string)).collect())
}

/// Text made safe to put inside XML: `&`, `<`, `>`, `"` and `'` escaped.
pub fn xml_escape(text: &str) -> String {
    text.replace('&', "&amp;").replace('<', "&lt;").replace('>', "&gt;").replace('"', "&quot;").replace('\'', "&apos;")
}
