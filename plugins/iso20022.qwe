// A small company's bank files: the day's camt.053 statement matched to invoices, and Friday's supplier payments as a pain.001.
//
//   quillo run iso20022.qwe      then open http://localhost:8080/statement

use "iso20022.qwer"

route GET /statement {
    let s = camt_read_file("iso20022_sample.xml")?[0]
    { iban: s.iban, owner: s.owner, opening: s.opening.amount, closing: s.closing.amount, adds_up: s.adds_up, entries: len(s.entries), first: s.entries[0].transactions[0] }
}

// One row per payment, the batch split: what invoice matching reads.
route GET /rows = camt_transactions("iso20022_sample.xml")? | map((r) => { cents: r.cents, name: r.name, remittance: r.remittance, reference: r.reference })

let BATCH = {
    message_id: "PAY-2026-10-30",
    created: "2026-10-29T16:00:00",
    execution_date: "2026-10-30",
    debtor: { name: "Quillo Tools GmbH", iban: "DE89 3704 0044 0532 0130 00", bic: "COBADEFFXXX" },
    payments: [
        { amount: "250.00", name: "Papeterie Martin & Fils", iban: "FR1420041010050500013M02606", remittance: "Facture 2026-311", end_to_end_id: "PAY-0042" },
        { amount: 1199.9, name: "Bakkerij de Vries B.V.", iban: "NL91ABNA0417164300", bic: "ABNANL2A", reference: "RF18539007547034" },
    ],
}

route GET /pain.xml = respond(200, pain001_build(BATCH)?, { "content-type": "application/xml" })

// The file read back before upload, and what a wrong IBAN gives.
route GET /check {
    let p = pain001_parse(pain001_build(merge(BATCH, { version: "09" }))?)?
    {
        version: p.version, count: p.count, control_sum: p.control_sum, adds_up: p.adds_up, execution_date: p.execution_date,
        bad_iban: pain001_build(merge(BATCH, { payments: [{ amount: "5", name: "X", iban: "NL91ABNA0417164301" }] })).error,
    }
}
