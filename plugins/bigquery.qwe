// A sales report from BigQuery: a query with parameters waited on, typed rows read over several
// pages, a dry run to see the size first, and rows streamed in with each row's errors read.
//
//   GOOGLE_APPLICATION_CREDENTIALS=key.json BIGQUERY_PROJECT=my-project quillo run bigquery.qwe
//   then open /report?region=eu, /types, /undeclared, /slow, /estimate, /insert and /broken

use "bigquery.qwer"

route GET /report ? { region: str } {
    let r = bigquery_query("SELECT id, region, amount FROM sales WHERE region = @region AND amount > @least ORDER BY id", { region: region, least: 1 }, null)?
    { total: r.total_rows, rows: r.rows, read: len(r.rows), bytes: r.bytes }
}

route GET /first-two {
    let r = bigquery_query("SELECT id, region, amount FROM sales WHERE region = @region AND amount > @least ORDER BY id", { region: "eu", least: 0 }, { max_rows: 2 })?
    { ids: r.rows | map((x) => x.id), total: r.total_rows }
}

// Every type BigQuery has its own way of writing.
route GET /types = bigquery_query("SELECT * FROM all_types", null, null)?

// A parameter the query names but the call does not give is refused by BigQuery.
route GET /undeclared = { error: bigquery_query("SELECT n FROM slow_job WHERE d = @day", null, null).error }

// A job that takes a while: jobs.query says it is not finished, and this polls for it. The types
// of the parameters are a DATE named, a list, and a map, which goes as a STRUCT.
route GET /slow {
    let r = bigquery_query("SELECT n FROM slow_job WHERE d = @day AND tag IN UNNEST(@tags) AND who = @who", { day: { type: "DATE", value: "2026-11-01" }, tags: ["a", "b"], who: { name: "Ada", age: 36 } }, null)?
    { rows: r.rows, job: r.job_id, state: bigquery_job(r.job_id)?.state }
}

route GET /estimate = bigquery_dry_run("SELECT id FROM sales", null)?

// The second row has no number for `amount`, which stops the row after it too unless told otherwise.
route GET /insert = {
    strict: bigquery_insert("shop", "sales", [
        { _insert_id: "a1", id: 100, amount: 3 },
        { _insert_id: "a2", id: 101, amount: "lots" },
    ], null)?,
    tolerant: bigquery_insert("shop", "sales", [
        { _insert_id: "b1", id: 102, amount: 3 },
        { _insert_id: "b2", id: 103, amount: "lots" },
        { _insert_id: "b3", id: 104, amount: 4 },
    ], { skip_invalid: true })?,
    tables: bigquery_tables("shop")?,
}

route GET /broken = {
    syntax: bigquery_query("SELEC nothing", null, null).error,
    no_table: bigquery_query("SELECT * FROM nowhere", null, null).error,
    null_param: bigquery_query("SELECT 1", { a: null }, null).error,
    dry: bigquery_dry_run("SELEC", null).error,
    failed_job: bigquery_query("SELECT fail FROM failing_job", null, null).error,
}
