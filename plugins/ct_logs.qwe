// Is this certificate publicly logged, and is the log honest? SCTs read from a certificate and each
// checked against its log's key, the tree head verified, entries read, a leaf proved to be in the
// tree, and a later tree proved to extend the earlier one.
//
//   CT_LOG_URL=https://ct.googleapis.com/logs/us1/argon2026h1 quillo run ct_logs.qwe
//   then open http://localhost:8080/scts, /head, /entries, /audit, /consistency and /refused
//
// The routes below use a test log's certificates from CT_SAMPLES; log keys come from Chrome's list
// of logs (www.gstatic.com/ct/log_list/v3/log_list.json).

use "ct_logs.qwer"

let LOG = env("CT_LOG_URL", "")
let SAMPLES = env("CT_SAMPLES", "")
fn s() = http.get(`${SAMPLES}/_sample`).json

route GET /scts {
    let x = s()
    let list = ct_scts(x.cert)?
    let good = ct_verify_scts(x.cert, x.issuer, [{ key: x.log_key, name: "test log" }, { key: x.rsa_log_key, name: "rsa log" }])?
    {
        count: len(list),
        version: list[0].version,
        first_id: list[0].log_id == ct_log_id(x.log_key)?,
        time: list[0].time,
        hash: list[0].signature_hash,
        checked: good,
        one_known: ct_verify_scts(x.cert, x.issuer, [{ key: x.log_key, name: "test log" }])?,
        no_logs: ct_verify_scts(x.cert, x.issuer, [])?,
        tampered: ct_verify_scts(x.tampered, x.issuer, [{ key: x.log_key, name: "test log" }])?,
        wrong_issuer: ct_verify_scts(x.cert, x.other_issuer, [{ key: x.log_key, name: "test log" }])?.invalid,
        no_scts: ct_scts(x.issuer)?,
    }
}

route GET /head {
    let x = s()
    let h = ct_get_sth(LOG, x.log_key)?
    { size: h.tree_size, verified: h.verified, root: h.sha256_root_hash == x.root, unchecked: ct_get_sth(LOG, "")?.verified, wrong_key: ct_get_sth(LOG, x.rsa_log_key).error }
}

route GET /entries {
    let e = ct_get_entries(LOG, 2, 8)?
    { count: len(e), indexes: map(e, (x) => x.index), kinds: unique(map(e, (x) => x.entry_type)), first_pem: starts_with(e[0].certificate, "-----BEGIN CERTIFICATE-----"), tbs: e[2].tbs_size > 0, bad: ct_get_entries(LOG, 5, 2).error, past_end: ct_get_entries(LOG, 500, 510).error }
}

route GET /audit {
    let x = s()
    let e = ct_get_entries(LOG, 0, 12)?
    let results = map(e, (l) => ct_audit(LOG, l.leaf_hash, x.size, x.root)?)
    let one = results[5]
    {
        all_verified: len(filter(results, (r) => r.verified)),
        indexes: map(results, (r) => r.index),
        path: one.path_length,
        wrong_root: ct_audit(LOG, e[5].leaf_hash, x.size, x.old_root)?.verified,
        unknown: ct_audit(LOG, "qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqo=", x.size, x.root).error,
    }
}

route GET /consistency {
    let x = s()
    let roots = x.roots
    let checks = map(range(1, 13), (n) => ct_consistency(LOG, n, x.size, roots[n - 1], x.root)?)
    {
        all: len(filter(checks, (c) => c)),
        same: ct_consistency(LOG, x.size, x.size, x.root, x.root)?,
        rewritten: ct_consistency(LOG, 7, x.size, roots[2], x.root)?,
        wrong_new: ct_consistency(LOG, 7, x.size, roots[6], roots[0])?,
    }
}

route GET /refused = {
    index_past: ct_verify_audit("qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqo=", 5, 5, [], "qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqo=")?,
    short_hash: ct_verify_audit("aGk=", 0, 1, [], "aGk=").error,
    not_pem: ct_scts("nope").error,
    not_entry: ct_read_leaf("aGk=").error,
    first_after: ct_verify_consistency(9, 3, "qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqo=", "qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqo=", [])?,
}
