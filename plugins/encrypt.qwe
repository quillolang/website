// Secrets kept encrypted at rest: a customer's API token, and an uploaded file.
//
//   quillo run encrypt.qwe      then open http://localhost:8080/token

use "encrypt.qwer"

// In a real app: ENCRYPTION_KEY=$(a value from encrypt_key()), kept out of the code.
let KEY = env("ENCRYPTION_KEY") ?? encrypt_key()

route GET /token {
    let stored = encrypt_text("sk_live_51H8xQuillo", KEY)?
    {
        stored,
        back: decrypt_text(stored, KEY)?,
        wrong_key: is_err(decrypt_text(stored, encrypt_key())),
    }
}

route GET /file {
    write_file("data/contract.txt", "Signed by Ada Lovelace, 2026-11-02")
    let size = encrypt_file("data/contract.txt", "data/contract.txt.enc", KEY)?
    decrypt_file("data/contract.txt.enc", "data/contract.back.txt", KEY)?
    { encrypted_bytes: size, back: read_file("data/contract.back.txt")? }
}

route GET /key = { key: encrypt_key() }
