// A photo editor's actions on an upload from a phone, stored sideways with an EXIF orientation.
//
//   quillo run image_ops.qwe      then open http://localhost:8080/edits

use "image_ops.qwer"

let PHOTO = "image_ops_sample.jpg"

route GET /edits = {
    upright: image_auto_orient(PHOTO, "data/edits/upright.jpg")?,
    square: image_crop(PHOTO, "data/edits/square.jpg", 50, 0, 300, 300)?,
    turned: image_rotate(PHOTO, "data/edits/turned.png", 90)?,
    mirror: image_flip(PHOTO, "data/edits/mirror.webp", "horizontal")?,
    grey: image_grayscale(PHOTO, "data/edits/grey.jpg")?,
    blurred: image_blur(PHOTO, "data/edits/blurred.jpg", 6.0)?,
    outside: is_err(image_crop(PHOTO, "data/edits/none.jpg", 900, 900, 10, 10)),
}

route GET /edits/:name {
    let names = ["upright.jpg", "square.jpg", "turned.png", "mirror.webp", "grey.jpg", "blurred.jpg"]
    if !contains(names, name) { reply 404 "No such edit" }
    file(`data/edits/${name}`)
}
