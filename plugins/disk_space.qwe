// A health check that warns before the disk fills, and an upload that is refused when it would.
//
//   quillo run disk_space.qwe      then open http://localhost:8080/health

use "disk_space.qwer"

route GET /health {
    let d = disk_space(".")?
    {
        status: d.used_percent > 95 ? "disk almost full" : "ok",
        free: disk_space_format(d.available),
        total: disk_space_format(d.total),
        used_percent: d.used_percent,
    }
}

route POST /upload {
    let f = request.files.file ?? reply 400 "Choose a file"
    if !disk_space_enough("data", f.size, 5.0)? { reply 507 "The server is out of space" }
    { saved: save_upload(f, `data/uploads/${uuid()}`)? }
}

route GET /sizes = [0, 1023, 1536, 5_000_000, 3_221_225_472] | map(disk_space_format)
