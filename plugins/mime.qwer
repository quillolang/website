//! MIME types from file names and extensions, and the extensions of a MIME type: for downloads, uploads and Content-Type headers.
//! version: 1.0.0
//!
//! [dependencies]
//! mime_guess = { version = "2", default-features = false, features = ["rev-mappings"] }

fn guess(name: &str) -> mime_guess::MimeGuess {
    let name = name.trim();
    // A bare extension ("css", ".css") is taken as one.
    if !name.contains('.') || (name.starts_with('.') && name[1..].find('.').is_none()) {
        mime_guess::from_ext(name.trim_start_matches('.'))
    } else {
        mime_guess::from_path(name)
    }
}

/// The MIME type of a file name, a path or a bare extension ("report.pdf", "css"), in any case: "application/octet-stream" when it is unknown.
pub fn mime_of(name: &str) -> String {
    guess(name).first_or_octet_stream().essence_str().to_string()
}

/// Every MIME type a name may have, the usual one first: `[]` when it is unknown.
pub fn mime_all(name: &str) -> Vec<String> {
    guess(name).iter().map(|m| m.essence_str().to_string()).collect()
}

/// The extensions of a MIME type ("image/jpeg" gives jpe, jpeg, jpg), without dots: `[]` for an unknown type.
pub fn mime_extensions(mime: &str) -> Vec<String> {
    let m = mime.split(';').next().unwrap_or("").trim().to_lowercase();
    mime_guess::get_mime_extensions_str(&m).map(|e| e.iter().map(|s| s.to_string()).collect()).unwrap_or_default()
}

/// A Content-Type header for a file name: its MIME type, with "; charset=utf-8" added for text, JSON, JavaScript, XML and SVG.
pub fn mime_content_type(name: &str) -> String {
    let m = guess(name).first_or_octet_stream();
    let textual = m.type_() == "text" || matches!(m.subtype().as_str(), "json" | "javascript" | "xml" | "svg") || m.suffix().map(|s| s.as_str() == "json" || s.as_str() == "xml").unwrap_or(false);
    if textual { format!("{}; charset=utf-8", m.essence_str()) } else { m.essence_str().to_string() }
}
