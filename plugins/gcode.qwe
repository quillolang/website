// A print farm's queue: each uploaded G-code file read for its print time, filament, weight and
// cost, size and temperatures before it goes to a printer; a layer drawn to check it.
//
//   quillo run gcode.qwe      then open http://localhost:8080/stats and http://localhost:8080/layer/3

use "gcode.qwer"

let FILE = "gcode_sample.gcode"

route GET /stats = gcode_stats(FILE, { diameter: 1.75, density: 1.24, price_per_kg: 22.0, acceleration: 1500 })?

route GET /layers = gcode_layers(FILE, {})?

route GET /layer/:n(int) = respond(200, gcode_layer_svg(FILE, n, 400, true)?, { "content-type": "image/svg+xml" })
