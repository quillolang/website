// The Model Context Protocol from both ends. As a client: a server's tools and resources listed and
// used. As a server: POST /mcp answers the same requests, so an assistant can call this program.
//
//   MCP_URL=http://127.0.0.1:3001/mcp MCP_TOKEN=... quillo run mcp.qwe
//   then open http://localhost:8080/tools, /call, /resources, /prompts and /failures
//   and point an MCP client at http://localhost:8080/mcp
//
// MCP_URL is any server speaking streamable HTTP.

use "mcp.qwer"

fn sign_in() {
    mcp_connect(env("MCP_URL", ""), { token: env("MCP_TOKEN", ""), client_name: "quillo-example" })
}

route GET /tools {
    let s = sign_in()?
    let tools = mcp_tools(s)?
    mcp_close(s)?
    { server: s.server.name, version: s.protocol_version, names: map(tools, (t) => t.name) }
}

route GET /call {
    let s = sign_in()?
    let good = mcp_call(s, "add", { a: 2, b: 40 })?
    let streamed = mcp_call(s, "slow_add", { a: 1, b: 2 })?
    let failed = mcp_call(s, "divide", { a: 1, b: 0 })?
    mcp_close(s)?
    { text: good.text, structured: good.structured, streamed: streamed.text, failed: failed.text, is_error: failed.is_error }
}

route GET /resources {
    let s = sign_in()?
    let list = mcp_resources(s)?
    let doc = mcp_read(s, list[0].uri)?
    { uris: map(list, (r) => r.uri), text: doc.text, templates: map(mcp_resource_templates(s)?, (t) => t.uriTemplate) }
}

route GET /prompts {
    let s = sign_in()?
    { names: map(mcp_prompts(s)?, (p) => p.name), filled: mcp_prompt(s, "greet", { name: "Ada" })?.messages[0].content.text, alive: mcp_ping(s)? }
}

route GET /failures {
    let s = sign_in()?
    let gone = s
    mcp_close(gone)?
    {
        unknown_tool: mcp_call(sign_in()?, "no_such_tool", {}).error,
        missing_file: mcp_read(sign_in()?, "file:///none").error,
        closed: mcp_tools(gone).error,
        no_token: mcp_connect(env("MCP_URL", ""), {}).error,
        nobody: mcp_connect("http://127.0.0.1:9/mcp", {}).error != null,
    }
}

// This program as a server: one tool and one resource, for any MCP client.
let notes = { "note://welcome": "Welcome to the shop." }

route POST /mcp {
    if !mcp_origin_ok(request.headers.origin ?? "", ["http://localhost:8080"]) { reply 403 "this origin may not call this server" }
    let m = mcp_parse(request.body)
    if m.kind == "invalid" { reply 400 m.answer }
    if m.kind != "request" { reply 202 "" }
    let id = m.id
    if m.method == "initialize" {
        return mcp_initialize(id, m.params, { name: "shop", version: "1.0.0", tools: true, resources: true })
    }
    if m.method == "ping" { return mcp_result(id, {}) }
    if m.method == "tools/list" {
        return mcp_tools_result(id, [mcp_tool("price", "The price of a product by sku", { type: "object", properties: { sku: { type: "string" } }, required: ["sku"] })])
    }
    if m.method == "tools/call" {
        if m.params.name != "price" { return mcp_error(id, -32602, `Unknown tool: ${m.params.name}`) }
        let sku = m.params.arguments.sku
        if sku != "A1" { return mcp_call_result(id, `no product ${sku}`, true) }
        return mcp_call_result(id, { sku: sku, cents: 1999 }, false)
    }
    if m.method == "resources/list" {
        return mcp_resources_result(id, [{ uri: "note://welcome", name: "Welcome note", mimeType: "text/plain" }])
    }
    if m.method == "resources/read" {
        let text = notes[m.params.uri]
        if text == null { return mcp_error(id, -32002, "Resource not found") }
        return mcp_read_result(id, m.params.uri, "text/plain", text)
    }
    mcp_error(id, -32601, `Method not found: ${m.method}`)
}

route GET /session-id = { length: len(mcp_new_session()?) }
