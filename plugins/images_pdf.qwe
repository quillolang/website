// A site visit's photos as one PDF report, and pictures as a PDF of their own size.
//
//   quillo run images_pdf.qwe      then open http://localhost:8080/report.pdf

use "images_pdf.qwer"

route GET /report.pdf {
    images_pdf_captions([
        { path: "images_pdf_sample.jpg", caption: "The hills behind the café, 14 June" },
        { path: "images_pdf_sample.png", caption: "The order page, as customers see it" },
    ], "data/visit.pdf", "A4", 36.0)?
    file("data/visit.pdf")
}

route GET /pages = {
    report: images_pdf(["images_pdf_sample.jpg", "images_pdf_sample.png", "images_pdf_sample.jpg"], "data/photos.pdf", "Letter", 54.0)?,
    fitted: images_pdf(["images_pdf_sample.png"], "data/screen.pdf", "fit", 0.0)?,
}
