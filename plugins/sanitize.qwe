// A comment written in HTML, shown safely.
//
//   quillo run sanitize.qwe      then open http://localhost:8080/

use "sanitize.qwer"

let comment = `<p onclick="steal()">Nice post! <b>Bold</b> <a href="javascript:alert(1)">click</a>
<a href="https://quillolang.org">Quillo</a><script>alert("x")</script><img src=x onerror="steal()"></p>`

route GET / = <html><body>
    <h1>Comments</h1>
    <div>{raw(sanitize_html(comment))}</div>
    <div>{raw(sanitize_html_only(comment, ["b", "a"]))}</div>
    <p>{strip_tags(comment)}</p>
</body></html>
