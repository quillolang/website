// Sign-in tokens with PASETO: an encrypted session token, and a signed one other services check.
//
//   quillo run paseto.qwe      then open http://localhost:8080/session

use "paseto.qwer"

let LOCAL_KEY = env("PASETO_KEY") ?? paseto_local_key()?
let SIGNING = paseto_keypair()?

route GET /session {
    let token = paseto_encrypt({ sub: "user-7", role: "admin", cart: [12, 31] }, LOCAL_KEY, 3600)?
    let claims = paseto_decrypt(token, LOCAL_KEY)?
    { token, user: claims.sub, role: claims.role, cart: claims.cart, other_key: is_err(paseto_decrypt(token, paseto_local_key()?)) }
}

route GET /public {
    let token = paseto_sign({ sub: "service-billing", aud: "orders-api", scope: "orders:read" }, SIGNING.secret, 300)?
    let claims = paseto_verify(token, SIGNING.public)?
    { prefix: slice(token, 0, 10), service: claims.sub, scope: claims.scope, expires: claims.exp, forged: is_err(paseto_verify(token, paseto_keypair()?.public)) }
}

// What a checker refuses: a token that never expires (made with 0), unless told to take one, and a
// token for another audience or from another issuer, when they are asked for. One key shared by two
// services would otherwise let each one's tokens pass at the other.
route GET /checks {
    let forever = paseto_encrypt({ sub: "mallory", aud: "billing" }, LOCAL_KEY, 0)?
    let billing = paseto_encrypt({ sub: "mallory", aud: "billing", iss: "accounts" }, LOCAL_KEY, 300)?
    let orders = paseto_sign({ sub: "service-billing", aud: "orders-api", iss: "accounts" }, SIGNING.secret, 300)?
    let no_aud = paseto_sign({ sub: "service-billing", iss: "accounts" }, SIGNING.secret, 300)?
    {
        never_expires: paseto_decrypt(forever, LOCAL_KEY).error,
        allowed: paseto_decrypt_check(forever, LOCAL_KEY, { allow_non_expiring: true })?.sub,
        other_audience: paseto_decrypt_check(billing, LOCAL_KEY, { audience: "orders-api" }).error,
        other_issuer: paseto_decrypt_check(billing, LOCAL_KEY, { audience: "billing", issuer: "evil" }).error,
        right: paseto_verify_check(orders, SIGNING.public, { audience: "orders-api", issuer: "accounts" })?.sub,
        no_audience: paseto_verify_check(no_aud, SIGNING.public, { audience: "orders-api" }).error,
        signed_forever: paseto_verify(paseto_sign({ sub: "x" }, SIGNING.secret, 0)?, SIGNING.public).error,
        bad_option: paseto_verify_check(orders, SIGNING.public, { audiance: "orders-api" }).error,
    }
}
