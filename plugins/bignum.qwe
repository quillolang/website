// Exact numbers for a maths quiz site and a money ledger: huge integers, and fractions that never round.
//
//   quillo run bignum.qwe      then open http://localhost:8080/big

use "bignum.qwer"

route GET /big = {
    two_to_200: bignum_calc("2", "^", "200")?,
    times: bignum_calc("123456789012345678901234567890", "*", "987654321098765432109876543210")?,
    gcd: bignum_calc("1071", "gcd", "462")?,
    hundred_factorial_digits: bignum_factorial(100)?.digits,
    pow_mod: bignum_pow_mod("4", "13", "497")?,
}

// Splitting a bill three ways and adding the shares back up: exactly the bill again.
route GET /split ? { total: str = "100.00" } {
    let share = fraction_calc(total, "/", "3")?
    { share, share_cents: fraction_decimal(share, 2)?.decimal, back: fraction_calc(fraction_calc(share, "+", share)?, "+", share)? }
}

route GET /fractions = { sum: fraction_calc("1/3", "+", "1/6")?, tenth: fraction_calc("0.1", "+", "0.2")?, seventh: fraction_decimal("1/7", 20)?.decimal }
