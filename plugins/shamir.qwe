// The admin recovery password, split among five people so that any three can bring it back.
//
//   quillo run shamir.qwe      then open http://localhost:8080/split

use "shamir.qwer"

let SECRET = "root recovery: 7f3a-91bc-44de-a0c2"

route GET /split {
    let shares = shamir_split(SECRET, 5, 3)?
    let holders = ["Ada", "Grace", "Linus", "Margaret", "Alan"]
    {
        handed_out: zip(holders, shares) | map((p) => { holder: p[0], share: p[1] }),
        grace_linus_alan: shamir_combine([shares[1], shares[2], shares[4]])?,
        two_only: shamir_combine([shares[0], shares[3]]).error,
    }
}

route GET /mixed {
    let a = shamir_split(SECRET, 3, 2)?
    let b = shamir_split("root recovery: 0000-0000-0000-0000", 3, 2)?
    { mixed: shamir_combine([a[0], b[1]]).error, mixed_length: shamir_combine([a[0], shamir_split("short", 3, 2)?[1]]).error, right: shamir_combine([a[2], a[0]])? }
}
