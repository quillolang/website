//! LaTeX maths to MathML, through pulldown-latex: formulas and whole texts with $...$ turned into markup browsers draw on their own, and errors placed by line and column.
//! version: 1.0.0
//!
//! [dependencies]
//! serde_json = { version = "1", features = ["preserve_order"] }
//! pulldown-latex = "=0.8.0"

use pulldown_latex::config::{DisplayMode, MathStyle};
use pulldown_latex::event::{Content, Event};
use pulldown_latex::{push_mathml, Parser, ParserError, RenderConfig, Storage};
use serde_json::{json, Value};

const PAD: usize = 16;
/// Errors at the end of the formula, which the parser places at its start.
const AT_END: &[&str] = &["expected a token", "unbalanced group found, expected it to be closed"];

/// The parser's context shows 12 bytes either side of a fault, so padding the formula with spaces, which maths ignores, makes the fault's byte fall at a known place in that context.
fn locate(latex: &str) -> Option<usize> {
    let flat: String = latex.chars().map(|c| if c == '\n' || c == '\r' { ' ' } else { c }).collect();
    let padded = format!("{}{}{}", " ".repeat(PAD), flat, " ".repeat(PAD));
    let storage = Storage::new();
    let err = Parser::new(&padded, &storage).find_map(Result::err)?.to_string();
    let snippet: String = err.lines().skip_while(|l| !l.contains("context:")).nth(2)?.chars().skip(1).skip(1).collect();
    let snippet = snippet.trim_end_matches('\u{a0}');
    let at = padded.find(snippet).or_else(|| padded.find(snippet.trim()))?;
    let spot = (at + 12).saturating_sub(PAD).min(latex.len());
    // The parser stands just past what it could not read: step back over any space.
    Some(latex[..latex.floor_char_boundary(spot)].trim_end().len())
}

fn place(latex: &str, at: usize) -> (usize, usize) {
    let mut end = at.min(latex.len());
    while !latex.is_char_boundary(end) {
        end -= 1;
    }
    let before = &latex[..end];
    (before.matches('\n').count() + 1, before.rsplit('\n').next().unwrap_or("").chars().count() + 1)
}

fn problem(latex: &str) -> Option<Value> {
    let storage = Storage::new();
    let full = Parser::new(latex, &storage).find_map(Result::err)?.to_string();
    let message = full.lines().next().unwrap_or("").trim_start_matches("parsing error: ").to_string();
    let at = if AT_END.iter().any(|m| message.starts_with(m)) { Some(latex.trim_end().len()) } else { locate(latex) };
    let (line, column) = match at {
        Some(a) => { let p = place(latex, a); (json!(p.0), json!(p.1)) }
        None => (Value::Null, Value::Null),
    };
    let near = at.map(|a| {
        let start = latex.char_indices().map(|x| x.0).filter(|i| *i + 12 >= a).next().unwrap_or(0);
        latex[start..].chars().take(24).collect::<String>().replace('\n', " ")
    });
    Some(json!({ "message": message, "line": line, "column": column, "near": near }))
}

/// pulldown-latex writes an operator's character and a function's name as they are: `a<b` gives `<mo><</mo>`, which is no XML, and `\\operatorname{<img ...>}` would be markup. Names go through as text, which it escapes.
fn escaped<'a>(e: Result<Event<'a>, ParserError>) -> Result<Event<'a>, ParserError> {
    match e {
        Ok(Event::Content(Content::Function(s))) if s.contains(['<', '>', '&', '"']) => Ok(Event::Content(Content::Text(s))),
        o => o,
    }
}

fn clean_operators(x: String) -> String {
    let mut out = x;
    for (raw, safe) in [("&", "&amp;"), ("<", "&lt;"), (">", "&gt;")] {
        for (open, tail) in [(">", "</m"), (">", "\u{338}</m")] {
            let bad = format!("{}{}{}", open, raw, tail);
            if out.contains(&bad) {
                out = out.replace(&bad, &format!("{}{}{}", open, safe, tail));
            }
        }
    }
    out
}

fn say(p: &Value) -> String {
    match p["line"].as_u64() {
        Some(l) => format!("line {}, column {}: {}, near `{}`", l, p["column"], p["message"].as_str().unwrap_or(""), p["near"].as_str().unwrap_or("").trim()),
        None => p["message"].as_str().unwrap_or("").to_string(),
    }
}

fn style(name: &str) -> Result<MathStyle, String> {
    Ok(match name {
        "" | "tex" => MathStyle::TeX,
        "iso" => MathStyle::ISO,
        "french" => MathStyle::French,
        "upright" => MathStyle::Upright,
        o => return Err(format!("math style `{}` should be tex, iso, french or upright", o)),
    })
}

fn render(latex: &str, block: bool, xml: bool, annotate: bool, math_style: MathStyle) -> Result<String, String> {
    if let Some(p) = problem(latex) {
        return Err(say(&p));
    }
    let storage = Storage::new();
    let parser = Parser::new(latex, &storage);
    let mut out = String::new();
    // The annotation is written as given: escaped here, or `</annotation>` in a formula would end it.
    let source = latex.replace('&', "&amp;").replace('<', "&lt;").replace('>', "&gt;");
    let config = RenderConfig { display_mode: if block { DisplayMode::Block } else { DisplayMode::Inline }, annotation: if annotate { Some(&source) } else { None }, error_color: (178, 34, 34), xml, math_style };
    push_mathml(&mut out, parser.map(escaped), config).map_err(|e| e.to_string())?;
    Ok(clean_operators(out))
}

/// A formula as inline MathML: `latex_math_mathml("x^2")`. A mistake is an error saying its line, column and what is near it.
pub fn latex_math_mathml(latex: &str) -> Result<String, String> {
    render(latex, false, false, false, MathStyle::TeX)
}

/// A formula as a displayed block, with limits under sums and larger fractions.
pub fn latex_math_block(latex: &str) -> Result<String, String> {
    render(latex, true, false, false, MathStyle::TeX)
}

/// With choices: `{ block, xml, annotate, style }`. `xml` adds the namespace, for Word and other programs; `annotate` keeps the LaTeX inside the markup for copy and paste; `style` is tex, iso, french or upright.
pub fn latex_math_render(latex: &str, options: serde_json::Value) -> Result<String, String> {
    let b = |k: &str| options[k].as_bool().unwrap_or(false);
    render(latex, b("block"), b("xml"), b("annotate"), style(options["style"].as_str().unwrap_or(""))?)
}

/// Whether a formula is good, without rendering: `{ ok, message, line, column, near }`, for showing a mistake as someone types.
pub fn latex_math_check(latex: &str) -> Value {
    match problem(latex) {
        None => json!({ "ok": true, "message": null, "line": null, "column": null, "near": null }),
        Some(mut p) => { p["ok"] = json!(false); p }
    }
}


/// A text with `$...$` and `$$...$$` (also `\(...\)` and `\[...\]`) replaced by MathML; `\$` is a dollar sign and the rest is left as it is, so it suits HTML or Markdown on its way to HTML. A formula with a mistake is an error giving its place in the text; `$` left open too. Gives `{ html, formulas }`.
pub fn latex_math_text(text: &str) -> Result<Value, String> {
    let mut out = String::with_capacity(text.len());
    let mut rest = text;
    let mut pos = 0usize;
    let mut formulas = 0;
    loop {
        let open = [("\\$", "", false), ("$$", "$$", true), ("$", "$", false), ("\\(", "\\)", false), ("\\[", "\\]", true)];
        let found = open.iter().filter_map(|o| rest.find(o.0).map(|i| (i, *o))).min_by_key(|x| (x.0, std::cmp::Reverse(x.1 .0.len())));
        let Some((i, (start, end, block))) = found else {
            out.push_str(rest);
            break;
        };
        out.push_str(&rest[..i]);
        let body = &rest[i + start.len()..];
        pos += i + start.len();
        if start == "\\$" {
            out.push('$');
            rest = body;
            continue;
        }
        let mut search = 0;
        let close = loop {
            match body[search..].find(end) {
                None => {
                    let (l, c) = place(text, pos - start.len());
                    return Err(format!("line {}, column {}: `{}` is never closed", l, c, start));
                }
                Some(k) if k + search > 0 && body.as_bytes()[k + search - 1] == b'\\' => search += k + 1,
                Some(k) => break k + search,
            }
        };
        let formula = &body[..close];
        if let Some(p) = problem(formula) {
            let (l, c) = place(text, pos);
            let (fl, fc) = (p["line"].as_u64().unwrap_or(1) as usize, p["column"].as_u64().unwrap_or(1) as usize);
            let (line, column) = if fl == 1 { (l, c + fc - 1) } else { (l + fl - 1, fc) };
            return Err(format!("line {}, column {}: {}, near `{}`", line, column, p["message"].as_str().unwrap_or(""), p["near"].as_str().unwrap_or("").trim()));
        }
        let html = render(formula, block, false, false, MathStyle::TeX)?;
        out.push_str(&html);
        formulas += 1;
        rest = &body[close + end.len()..];
        pos += close + end.len();
    }
    Ok(json!({ "html": out, "formulas": formulas }))
}
