// A factory's case labels on a Honeywell or Datamax DPL printer (I-Class, M-Class, E-Class):
// 100 × 70 mm, with the part's name, a Code 128 for the part number, an EAN-13, a QR code
// with the batch, and a frame; DPL counts rows from the bottom, the plugin from the top.
//
//   quillo run dpl.qwe      then open http://localhost:8080/label
//   PRINTER_HOST=192.168.1.63 quillo run dpl.qwe      and http://localhost:8080/print

use "dpl.qwer"

let OPTIONS = { dpi: 203, height: 70, heat: 14, speed: 3, quantity: 2 }

fn case_label(c) = [
    { box: true, x: 2, y: 2, width: 96, height: 66, thickness: 0.5 },
    { text: c.part, x: 5, y: 5, size: 6 },
    { text: `Batch ${c.batch} / Qty ${c.qty}`, x: 5, y: 14, size: 3 },
    { line: true, x: 2, y: 20, width: 96, thickness: 0.4 },
    { barcode: "code128", data: c.pn, x: 5, y: 24, height: 12, module: 2 },
    { barcode: "ean13", data: c.ean, x: 5, y: 46, height: 14, module: 2 },
    { barcode: "qr", data: `PN:${c.pn};BATCH:${c.batch};QTY:${c.qty}`, x: 72, y: 24, magnification: 4, size: 20 },
]

let CASE = { part: "Bearing 6204-2RS", pn: "BRG-6204-2RS", batch: "B2610-17", qty: 50, ean: "4006381333931" }

route GET /label = respond(200, dpl_label(case_label(CASE), OPTIONS)?, { "content-type": "text/plain; charset=utf-8" })

route GET /saved = { bytes: dpl_write(case_label(CASE), OPTIONS, "data/case.dpl")?, start: slice(dpl_job(case_label(CASE), OPTIONS)?, 0, 8), too_low: dpl_label([{ text: "x", x: 0, y: 69 }], OPTIONS).error }

route GET /print {
    let host = env("PRINTER_HOST", null) ?? reply 503 "set PRINTER_HOST to the printer's address (host or host:port)"
    { sent: dpl_send(case_label(CASE), OPTIONS, host, 5000)? }
}
