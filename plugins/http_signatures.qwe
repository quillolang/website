// A fediverse actor's inbox that only takes signed activities, and an outbox that signs what it
// sends: here it sends to its own inbox. A real inbox fetches the sender's actor (its keyId)
// for the public key.
//
//   quillo run http_signatures.qwe      then open http://localhost:8080/send

use "http_signatures.qwer"

let KEYS = httpsig_keypair()?                     // keep the private key in a secret in a real app
let ACTOR = "https://example.com/users/ada"

route POST /inbox {
    let check = httpsig_verify("POST", request.path, request.headers, request.body, KEYS.public_key, 300)
    if !check.ok { reply 401 { error: check.error } }
    { accepted: request.json.type, from: check.key_id }
}

// Delivered to this server's own inbox, on the port the request came to.
fn deliver(port, body, tamper) {
    let inbox = `http://127.0.0.1:${port}/inbox`
    let headers = httpsig_sign("POST", inbox, { "content-type": "application/activity+json" }, body, `${ACTOR}#main-key`, KEYS.private_key)?
    let sent = tamper ? replace(body, "Hello", "Buy now") : body
    let r = http.post(inbox, sent, merge(headers, { "content-type": "application/activity+json" }), { public_only: false })?
    { status: r.status, answer: r.json }
}

route GET /send {
    let note = json.stringify({ "@context": "https://www.w3.org/ns/activitystreams", type: "Create", actor: ACTOR, object: { type: "Note", content: "Hello, fediverse" } })
    let port = int(split(request.headers.host, ":")[1] ?? "80")
    { signed: deliver(port, note, false)?, tampered: deliver(port, note, true)? }
}

route GET /headers {
    let h = httpsig_sign("POST", "https://mastodon.example/inbox", {}, "{}", `${ACTOR}#main-key`, KEYS.private_key)?
    { digest: h.digest, key_id: httpsig_key_id(h), covers: re.find(h.signature, "headers=\"([^\"]*)\"").groups[0] }
}
