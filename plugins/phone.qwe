// A sign-up form's phone field, stored one way whatever was typed.
//
//   quillo run phone.qwe      then open http://localhost:8080/phone?n=(415)+555-2671&region=US

use "phone.qwer"

route GET /phone ? { n: str, region: str = "US" } = phone_parse(n, region)?
route GET /store = { ph: phone_e164("0917 123 4567", "PH")?, uk: phone_e164("+44 20 7946 0958", "")?, bad: is_err(phone_e164("123", "US")) }
