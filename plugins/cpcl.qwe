// A delivery driver's mobile printer (Zebra ZQ520 on the van's Wi-Fi): a 4 × 3 inch parcel
// label with the stop's address and barcodes, and a proof-of-delivery receipt on continuous paper.
//
//   quillo run cpcl.qwe      then open http://localhost:8080/label and http://localhost:8080/receipt
//   PRINTER_HOST=192.168.1.66:6101 quillo run cpcl.qwe      and http://localhost:8080/print

use "cpcl.qwer"

let STOP = { n: 14, name: "J. Okafor", street: "22 Harbour Lane", town: "Cork T12 X8Y4", parcel: "PCL-2026-0099172", items: [["Boxes", "3"], ["Signed by", "J. Okafor"], ["Time", "14:52"]] }

fn label(s) = [
    { image: "cpcl_sample.png", x: 2, y: 2, width: 30 },
    { text: `STOP ${s.n}`, x: 70, y: 3, size: 6 },
    { inverse: true, x: 69, y: 2, width: 30, thickness: 7 },
    { text: s.name, x: 3, y: 16, size: 5 },
    { text: s.street, x: 3, y: 24, size: 3 },
    { text: s.town, x: 3, y: 29, size: 3 },
    { barcode: "code128", data: s.parcel, x: 3, y: 38, height: 14, module: 2 },
    { barcode: "qr", data: `https://van.example/pod/${s.parcel}`, x: 80, y: 40, magnification: 4 },
    { box: true, x: 1, y: 1, width: 99, height: 74, thickness: 0.4 },
]

let LABEL = { width: 101.6, height: 76.2, quantity: 1, media: "gap" }

route GET /label = respond(200, cpcl_label(label(STOP), LABEL)?, { "content-type": "text/plain" })

route GET /receipt = respond(200, cpcl_label([
    { text: "PROOF OF DELIVERY", x: 0, y: 2, size: 6, align: "center", width: 72 },
    { line: true, x: 0, y: 12, width: 72, thickness: 0.3 },
] + map(range(len(STOP.items)), (i) => { text: `${STOP.items[i][0]}: ${STOP.items[i][1]}`, x: 2, y: 15 + i * 5, size: 3 }) + [
    { barcode: "code128", data: STOP.parcel, x: 6, y: 34, height: 10, module: 1 },
], { width: 72, height: 55, media: "continuous", journal: true })?, { "content-type": "text/plain" })

route GET /print {
    let host = env("PRINTER_HOST", null) ?? reply 503 "set PRINTER_HOST to the printer's address (host:6101 for Zebra mobile printers)"
    { sent: cpcl_send(label(STOP), LABEL, host, 5000)?, saved: cpcl_write(label(STOP), LABEL, "data/stop-14.cpcl")? }
}
