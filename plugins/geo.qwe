// Shops near a visitor, nearest first.
//
//   quillo run geo.qwe      then open http://localhost:8080/near?lat=52.37&lon=4.89

use "geo.qwer"

let shops = [
    { name: "Centraal", lat: 52.3791, lon: 4.9003 },
    { name: "Zuid", lat: 52.3389, lon: 4.8723 },
    { name: "Utrecht", lat: 52.0907, lon: 5.1214 },
]

route GET /near ? { lat: float, lon: float } {
    let box = bounding_box(lat, lon, 10.0)
    shops
        | filter((s) => s.lat >= box.min_lat && s.lat <= box.max_lat && s.lon >= box.min_lon && s.lon <= box.max_lon)
        | map((s) => { name: s.name, km: round(distance_km(lat, lon, s.lat, s.lon), 2), cell: geohash_encode(s.lat, s.lon, 6)? })
        | sort_by((s) => s.km)
}
