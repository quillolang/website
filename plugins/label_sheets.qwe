// An office's labels on sheets for its laser printer: a mailing's addresses on Avery L7160
// (21 to an A4 sheet, starting at the 5th of a part-used sheet), asset tags with a barcode and a
// QR code on L7651, and the layout of a Letter 5160 sheet.
//
//   quillo run label_sheets.qwe      then open http://localhost:8080/addresses.pdf

use "label_sheets.qwer"

let PEOPLE = [
    ["Ms Ada Byron", "12 St James's Square", "London SW1Y 4JH"],
    ["Dr Grace Hopper", "1 Navy Yard", "Arlington VA 22202", "USA"],
    ["Søren Kierkegaard", "Nytorv 2", "1450 København K", "Danmark"],
    ["Zoë Ångström", "Drottninggatan 14", "111 51 Stockholm"],
]

route GET /addresses.pdf {
    label_sheet_pdf(PEOPLE, "L7160", "data/addresses.pdf", { start: 5, size: 11 })?
    file("data/addresses.pdf")
}

route GET /made = {
    addresses: label_sheet_pdf(PEOPLE, "L7160", "data/addresses.pdf", { start: 20, copies: 2 })?,
    assets: label_sheet_pdf(map(range(1, 4), (n) => { lines: [`Asset ${n}`, "IT dept"], barcode: `IT-00${n}`, qr: `https://it.example/asset/${n}` }), "L7651", "data/assets.pdf", { outline: true, padding: 1.5 })?,
    custom: label_sheet_pdf([["Box 1"], ["Box 2"]], { page: "a4", columns: 2, rows: 3, width: 100, height: 90, top: 10, left: 5 }, "data/boxes.pdf", { align: "center", size: 36 })?,
}

route GET /layout = {
    first_three: slice(label_sheet_layout("5160")?, 0, 3),
    l7160: label_sheet_templates() | filter((t) => t.name == "L7160"),
}
