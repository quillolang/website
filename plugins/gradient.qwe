// A colour scale for a sales map: a colour for each region from its value, and the legend under the map.
//
//   quillo run gradient.qwe      then open http://localhost:8080/

use "gradient.qwer"

let regions = [{ name: "North", sales: 18250 }, { name: "South", sales: 16410 }, { name: "East", sales: 5120 }, { name: "West", sales: 11000 }]

route GET /scale = {
    viridis: gradient_colors("viridis", 5)?,
    brand: gradient_colors(["#ffffff", "#2a78d6"], 3)?,
    middle: gradient_at("rd_bu", 0.5)?,
    css: gradient_css("blues", 90)?,
}

route GET / {
    let lo = min(regions | map((r) => r.sales))
    let hi = max(regions | map((r) => r.sales))
    <html><body style="font-family: sans-serif">
        {for r in regions => <div style="padding: 4px">
            <span style={`display: inline-block; width: 24px; height: 14px; background: ${gradient_at("viridis", float(r.sales - lo) / (hi - lo))?}`}></span>
            {r.name}: {r.sales}
        </div>}
        <div>{raw(gradient_svg("viridis", 300, 12)?)}</div>
        <small>{lo} to {hi}</small>
    </body></html>
}

route GET /names = gradient_names()
