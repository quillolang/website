//! Chemical formulas and equations: formulas parsed with groups, charges and hydrates, molar mass and percent composition, equations balanced exactly, limiting reagents, and the table of elements.
//! version: 1.0.0
//!
//! [dependencies]
//! serde_json = { version = "1", features = ["preserve_order"] }

use serde_json::{json, Value};
use std::collections::BTreeMap;

// Number, symbol, name, standard atomic weight (IUPAC abridged; brackets in the table for
// elements with no stable isotope are the mass number of the longest-lived one), group, period.
