// A certificate from an ACME server: account, order, proof by a file for one name and a TXT record
// for the other, a CSR made here and the chain downloaded; then what each kind of failure says.
//
//   ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory quillo run acme.qwe
//
// Against a real server, serve `body` at `path` on port 80 and publish the TXT record, then call
// acme_ready. Keep the account key: it is the account. Without ACME_DIRECTORY it is Let's Encrypt's
// staging. Here ACME_CHALLTEST_URL is a Pebble-style test server, standing for the web and the DNS:
// it takes what the real ones would have served, through its /add-http01 and /set-txt calls.

use "acme.qwer"

let DIR = env("ACME_DIRECTORY", "")
let TEST = env("ACME_CHALLTEST_URL", "")

fn put_proof(c, domain) {
    if c.type == "http-01" {
        http.post(TEST + "/add-http01", { host: domain, token: c.token, content: c.body }, {}, { public_only: false })?
    } else {
        http.post(TEST + "/set-txt", { host: c.name + ".", value: c.value }, {}, { public_only: false })?
    }
    null
}

fn challenge(authz, kind) = find(authz.challenges, (c) => c.type == kind)

// Proves one name by `kind`; `spoil` publishes a wrong value.
fn prove(key, kid, url, kind, spoil) {
    let a = acme_authorization(DIR, key, kid, url)?
    let c = challenge(a, kind)
    put_proof(spoil ? merge(c, { body: "wrong", value: "wrong" }) : c, a.domain)?
    acme_ready(DIR, key, kid, c.url)?
    acme_wait(DIR, key, kid, url, ["valid"], 15000)
}

route GET /certificate {
    let key = acme_new_key()?
    let account = acme_account(DIR, key, { contact: ["mailto:ops@shop.example"], terms_agreed: true })?
    let again = acme_account(DIR, key, { terms_agreed: true })?
    let existing = acme_account(DIR, key, { only_existing: true })?
    let order = acme_order(DIR, key, account.url, ["shop.example", "*.shop.example"])?
    prove(key, account.url, order.authorizations[0], "http-01", false)?
    prove(key, account.url, order.authorizations[1], "dns-01", false)?
    let ready = acme_wait(DIR, key, account.url, order.url, ["ready"], 15000)?
    let cert_key = acme_new_key()?
    acme_finalize(DIR, key, account.url, ready, cert_key)?
    let valid = acme_wait(DIR, key, account.url, order.url, ["valid"], 15000)?
    let cert = acme_certificate(DIR, key, account.url, valid)?
    let dates = acme_validity(cert.pem)?
    let revoked = acme_revoke(DIR, key, account.url, cert.pem, 4)
    {
        account: [account.created, account.status], same_account: again.url == account.url, again_created: again.created, existing: existing.url == account.url,
        order: [order.status, len(order.authorizations)],
        ready: ready.status, final: valid.status,
        chain: len(split(cert.pem, "-----BEGIN CERTIFICATE-----")) - 1, alternates: len(cert.alternates),
        dated: dates.not_after > dates.not_before,
        revoked: is_err(revoked) ? revoked.error : "revoked",
        twice: acme_revoke(DIR, key, account.url, cert.pem, 4).error,
    }
}

// What the plugin works out itself: RFC 8555 section 8 and RFC 7638's example shapes.
route GET /values {
    let key = acme_new_key()?
    let print = acme_thumbprint(key)?
    let http_01 = acme_http01(key, "evaGxfADs6pSRb2LAv9IZf17Dt3juxGJ-PCt92wr-oA")?
    let dns = acme_dns01(key, "*.example.org", "evaGxfADs6pSRb2LAv9IZf17Dt3juxGJ-PCt92wr-oA")?
    {
        path: http_01.path, body_ok: http_01.body == "evaGxfADs6pSRb2LAv9IZf17Dt3juxGJ-PCt92wr-oA." + print,
        name: dns.name, value_len: len(dns.value),
        bad_token: acme_http01(key, "../../etc/passwd").error,
        bad_domain: acme_csr(key, ["EXAMPLE.org"]).error,
        csr: len(acme_csr(key, ["a.example", "b.example"])?) > 100,
    }
}

// A CSR by itself, for `openssl req -inform der -noout -text`.
route GET /csr = { csr: acme_csr(acme_new_key()?, ["shop.example", "www.shop.example"])? }

route GET /refused {
    let key = acme_new_key()?
    let a = acme_account(DIR, key, { terms_agreed: true })?
    let order = acme_order(DIR, key, a.url, ["bad.example"])?
    let early = acme_finalize(DIR, key, a.url, order, acme_new_key()?).error
    let wrong = prove(key, a.url, order.authorizations[0], "http-01", true).error
    let good = acme_order(DIR, key, a.url, ["good.example"])?
    prove(key, a.url, good.authorizations[0], "dns-01", false)?
    {
        no_terms: acme_account(DIR, acme_new_key()?, {}).error,
        unknown: acme_account(DIR, acme_new_key()?, { only_existing: true }).error,
        stranger: acme_order(DIR, acme_new_key()?, a.url, ["x.example"]).error,
        early: early,
        wrong: wrong,
        order_after: acme_wait(DIR, key, a.url, order.url, ["ready"], 2000).error,
        bad_csr: acme_finalize_csr(DIR, key, a.url, acme_wait(DIR, key, a.url, good.url, ["ready"], 5000)?, acme_csr(acme_new_key()?, ["other.example"])?).error,
        bad_key: acme_account(DIR, "not a key", {}).error,
    }
}
