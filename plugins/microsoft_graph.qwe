// Microsoft 365 from a server, as an app with no one signed in: mail, a calendar, OneDrive, every
// page of a long list, and throttling waited out.
//
//   MSGRAPH_TENANT_ID=... MSGRAPH_CLIENT_ID=... MSGRAPH_CLIENT_SECRET=... quillo run microsoft_graph.qwe
//   then open /mail, /calendar, /drive, /users, /batch and /broken

use "microsoft_graph.qwer"

let who = "ada@contoso.example"

route GET /mail {
    let sent = msgraph_send_mail(who, { to: ["grace@contoso.example"], cc: "alan@contoso.example", subject: "Invoice", html: "<p>Attached.</p>" }, false)?
    let all = msgraph_messages(who, { folder: "inbox", max: 100 })?
    let some = msgraph_messages(who, { filter: "from/emailAddress/address eq " + msgraph_quote("o'neil@contoso.example"), max: 10 })?
    { sent: sent, count: len(all.items), first: all.items[0].subject, complete: all.complete, filtered: some.items | map((m) => m.subject), quote: msgraph_quote("o'neil") }
}

route GET /calendar {
    let made = msgraph_create_event(who, { subject: "Review", start: "2026-11-02T10:00:00", end: "2026-11-02T11:00:00", attendees: ["grace@contoso.example"], online: true })?
    let seen = msgraph_calendar(who, "2026-11-01T00:00:00Z", "2026-11-08T00:00:00Z", 50)?
    { made: made.subject, link: made.onlineMeeting.joinUrl != null, events: seen.items | map((e) => e.subject), zone: seen.items[0].start.timeZone }
}

route GET /drive {
    let small = msgraph_drive_upload(who, "/Reports/q3 notes.txt", "third quarter", "text/plain")?
    let big = msgraph_drive_upload_file(who, "microsoft_graph.qwer", "/Reports/source.txt", 8)?
    {
        name: small.name,
        size: small.size,
        pieces_many: big.pieces > 1,
        big_same: msgraph_drive_download(who, "/Reports/source.txt")? == read_file("microsoft_graph.qwer")?,
        text: msgraph_drive_download(who, "Reports/q3 notes.txt")?,
        list: msgraph_drive_list(who, "/Reports", 10)?.items | map((f) => f.name),
        item: msgraph_drive_item(who, "/Reports/q3 notes.txt")?.size,
        none: msgraph_drive_item(who, "/nothing.txt")?,
    }
}

// 230 users over several pages, one of them throttled with a 429: it takes a second, and it all comes.
route GET /users {
    let all = msgraph_list("/users?$top=100&$select=id,displayName", 1000)?
    let cut = msgraph_list("/users?$top=100", 150)?
    let rest = msgraph_list(cut.next, 1000)?
    { total: len(all.items), last: all.items[229].displayName, complete: all.complete, cut: len(cut.items), went_on: len(cut.next) > 0, rest: len(rest.items) }
}

route GET /batch {
    let r = msgraph_batch([{ url: "/users/ada@contoso.example" }, { url: "/users/nobody@contoso.example" }])?
    { statuses: r | map((x) => x.status), name: r[0].body.displayName, error: r[1].body.error.code }
}

route GET /broken = {
    no_user: msgraph_request("GET", "/users/nobody@contoso.example", null).error,
    no_to: msgraph_send_mail(who, { subject: "x", text: "y" }, false).error,
    bad_to: msgraph_send_mail(who, { to: "grace", text: "y" }, false).error,
    other_host: msgraph_request("GET", "https://evil.example/users", null).error,
    too_many: msgraph_batch([]).error,
}
