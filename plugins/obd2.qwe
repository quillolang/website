// A fleet tracker's back end: the dongle in each van posts the ELM327 answers it read, and the
// server turns them into a dashboard and a list of warnings.
//
//   quillo run obd2.qwe      then open http://localhost:8080/van

use "obd2.qwer"

// What one van's adapter answered (raw, as it comes over the serial line).
let READINGS = ["41 0D 3C", "SEARCHING...\r7E8 04 41 0C 1A F8\r\r>", "410578", "41 2F B3", "41 42 37 E2", "41 01 82 07 E5 00"]

route GET /van {
    let r = READINGS | map((a) => obd2_decode(a)?)
    { dashboard: r | filter((x) => x.unit != "") | map((x) => `${x.name}: ${x.value} ${x.unit}`), check_engine: r[5].value.mil_on, codes_stored: r[5].value.dtc_count }
}

route GET /codes = {
    stored: obd2_dtcs("43 01 33 00 00 00 00")?,
    can: obd2_dtcs("7E8 06 43 02 01 71 C1 23")?,
    supported: obd2_supported("41 00 BE 1F A8 13")?,
    ask_rpm: obd2_command(1, 12)?,
    no_data: obd2_decode("NO DATA").error,
}
