fn parse_hex(s: &str) -> Option<u32> {
    let h = s.trim().trim_start_matches('#');
    let full = match h.len() {
        3 | 4 => h.chars().take(3).flat_map(|c| [c, c]).collect::<String>(),
        6 | 8 => h[..6].to_string(),
        _ => return None,
    };
    u32::from_str_radix(&full, 16).ok()
}

// "#rgb", "#rrggbb", "rgb(r, g, b)" or a CSS name, as 0xRRGGBB.
fn parse(c: &str) -> Result<u32, String> {
    let t = c.trim().to_lowercase();
    if let Some(v) = NAMES.iter().find(|(n, _)| *n == t).map(|(_, v)| *v) {
        return Ok(v);
    }
    if let Some(inner) = t.strip_prefix("rgb(").or_else(|| t.strip_prefix("rgba(")).and_then(|r| r.strip_suffix(')')) {
        let parts: Vec<u32> = inner.split(|ch| ch == ',' || ch == ' ' || ch == '/').filter(|p| !p.is_empty()).take(3).filter_map(|p| p.trim().parse::<f64>().ok()).map(|x| x.round().clamp(0.0, 255.0) as u32).collect();
        if parts.len() == 3 {
            return Ok(parts[0] << 16 | parts[1] << 8 | parts[2]);
        }
    }
    if t.starts_with('#') || t.chars().all(|ch| ch.is_ascii_hexdigit()) {
        if let Some(v) = parse_hex(&t) {
            return Ok(v);
        }
    }
    Err(format!("`{}` is not a colour: give \"#rrggbb\", \"#rgb\", \"rgb(r, g, b)\" or a CSS name", c))
}

fn hex(v: u32) -> String {
    format!("#{:06x}", v)
}

// Oklab: distances there follow how different colours look.
fn oklab(v: u32) -> [f64; 3] {
    let lin = |c: u32| {
        let s = c as f64 / 255.0;
        if s <= 0.04045 { s / 12.92 } else { ((s + 0.055) / 1.055).powf(2.4) }
    };
    let (r, g, b) = (lin(v >> 16 & 255), lin(v >> 8 & 255), lin(v & 255));
    let l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b).cbrt();
    let m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b).cbrt();
    let s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b).cbrt();
    [0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s, 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s, 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s]
}

fn dist(a: u32, b: u32) -> f64 {
    let (x, y) = (oklab(a), oklab(b));
    ((x[0] - y[0]).powi(2) + (x[1] - y[1]).powi(2) + (x[2] - y[2]).powi(2)).sqrt()
}

fn ranked(v: u32) -> Vec<(&'static str, u32, f64)> {
    let mut all: Vec<(&str, u32, f64)> = NAMES.iter().map(|(n, h)| (*n, *h, dist(v, *h))).collect();
    // grey and gray name the same colours: keep the "gray" spellings once.
    all.retain(|(n, _, _)| !n.contains("grey"));
    all.sort_by(|a, b| a.2.partial_cmp(&b.2).unwrap_or(std::cmp::Ordering::Equal));
    all
}

/// The CSS colour name nearest to `color` ("#3b82f6", "#abc", "rgb(59, 130, 246)" or a name): `{ name, hex, distance, exact }`.
/// `distance` is how far apart they look (Oklab, 0 the same, under 0.02 hard to tell, over 0.1 clearly different); `exact` true when it is that colour.
pub fn color_name(color: &str) -> Result<Value, String> {
    let v = parse(color)?;
    let (n, h, d) = ranked(v)[0];
    Ok(json!({ "name": n, "hex": hex(h), "distance": (d * 10000.0).round() / 10000.0, "exact": h == v }))
}

/// The `count` nearest names (1 to 20), nearest first, each `{ name, hex, distance }`: to offer a choice, or a search by colour.
pub fn color_name_nearest(color: &str, count: i64) -> Result<Vec<Value>, String> {
    let v = parse(color)?;
    Ok(ranked(v).into_iter().take(count.clamp(1, 20) as usize).map(|(n, h, d)| json!({ "name": n, "hex": hex(h), "distance": (d * 10000.0).round() / 10000.0 })).collect())
}

/// A CSS colour name ("rebeccapurple", "Light Sea Green" with spaces and capitals too) as "#rrggbb"; an error for a name CSS does not have.
pub fn color_name_hex(name: &str) -> Result<String, String> {
    let n: String = name.trim().to_lowercase().chars().filter(|c| !c.is_whitespace() && *c != '-' && *c != '_').collect();
    NAMES.iter().find(|(k, _)| *k == n).map(|(_, v)| hex(*v)).ok_or_else(|| format!("`{}` is not a CSS colour name", name))
}

/// All 148 CSS colour names with their hex, as `{ name, hex }` in alphabetical order (gray and grey spellings both).
pub fn color_name_list() -> Vec<Value> {
    NAMES.iter().map(|(n, h)| json!({ "name": n, "hex": hex(*h) })).collect()
}
