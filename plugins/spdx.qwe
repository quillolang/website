// A licence check for a build: expressions read, ids looked up, an allowlist applied, and the
// licences of a Rust crate, an npm package and a lockfile's dependencies.
//
//   quillo run spdx.qwe      then open http://localhost:8080/parse, /ids, /allowed, /manifests, /audit and /broken

use "spdx.qwer"

let ALLOW = ["MIT", "Apache-2.0", "BSD-3-Clause", "ISC", "GPL-2.0-only WITH Classpath-exception-2.0"]

route GET /parse = {
    or: spdx_parse("MIT OR Apache-2.0", false),
    with: spdx_parse("(GPL-2.0-only WITH Classpath-exception-2.0) AND BSD-3-Clause", false).licenses | map((l) => [l.id, l.exception, l.copyleft]),
    later: spdx_parse("LGPL-2.1-or-later", false).licenses[0],
    old_style: spdx_parse("MIT/Apache-2.0", true).expression,
    strict: spdx_parse("MIT/Apache-2.0", false).error,
    custom: spdx_parse("LicenseRef-Acme-1.0", false).licenses,
}

route GET /ids = {
    mit: spdx_license("MIT"),
    gone: spdx_license("GPL-2.0").deprecated,
    typo: spdx_license("Apache 2"),
    none: spdx_license("Beerware-9").known,
    list: spdx_list_info().version != null,
}

route GET /allowed = {
    one_side: spdx_allowed("GPL-3.0-only OR MIT", ALLOW, false)?,
    both: spdx_allowed("MIT AND ISC", ALLOW, false)?.allowed,
    pick_one: spdx_allowed("MIT OR Apache-2.0", ALLOW, false)?.choose,
    refused: spdx_allowed("MIT AND GPL-3.0-only", ALLOW, false)?,
    exception: spdx_allowed("GPL-2.0-only WITH Classpath-exception-2.0", ALLOW, false)?.allowed,
    no_exception: spdx_allowed("GPL-2.0-only", ALLOW, false)?.allowed,
    later: spdx_allowed("Apache-2.0+", ["Apache-2.0"], true)?.allowed,
    bad_item: spdx_allowed("MIT", ["Nonsense-1"], false).error,
}

let CARGO = `[package]
name = "demo"
version = "1.2.3"
license = "MIT/Apache-2.0"
`

let WORKSPACE = `[workspace.package]
version = "2.0.0"
license = "Apache-2.0"

[package]
name = "member"
version.workspace = true
license.workspace = true
`

route GET /manifests = {
    cargo: spdx_manifest_text("cargo", CARGO)?,
    inherited: spdx_manifest_text("cargo", WORKSPACE)?.license,
    file_only: spdx_manifest_text("cargo", "[package]\nname = \"x\"\nlicense-file = \"LICENSE.txt\"\n")?.license_file,
    npm: spdx_manifest_text("npm", "{\"name\":\"left-pad\",\"version\":\"1.3.0\",\"license\":\"WTFPL\"}")?.check.licenses,
    npm_object: spdx_manifest_text("npm", "{\"name\":\"a\",\"license\":{\"type\":\"ISC\",\"url\":\"x\"}}")?.license,
    npm_list: spdx_manifest_text("npm", "{\"name\":\"a\",\"licenses\":[{\"type\":\"MIT\"},{\"type\":\"Apache-2.0\"}]}")?.check.expression,
    private: spdx_manifest_text("npm", "{\"name\":\"a\",\"license\":\"UNLICENSED\"}")?.check.error.message,
    see_file: spdx_manifest_text("npm", "{\"name\":\"a\",\"license\":\"SEE LICENSE IN EULA.txt\"}")?.license_file,
}

let LOCK = "{\"lockfileVersion\":3,\"packages\":{\"\":{\"name\":\"app\"},\"node_modules/a\":{\"version\":\"1.0.0\",\"license\":\"MIT\"},\"node_modules/@s/b\":{\"version\":\"2.0.0\",\"license\":\"GPL-3.0-only\"},\"node_modules/c\":{\"version\":\"3.0.0\"},\"node_modules/d\":{\"version\":\"4.0.0\",\"license\":\"(MIT OR GPL-3.0-only)\"},\"node_modules/e/node_modules/f\":{\"version\":\"5.0.0\",\"license\":\"AGPL-3.0-only\"}}}"

route GET /audit = {
    report: spdx_audit_npm(LOCK, ALLOW, [])?,
    waived: spdx_audit_npm(LOCK, ALLOW, ["@s/b", "c", "f"])?.refused,
}

route GET /broken = {
    unknown: spdx_parse("Beerware-9", false).error,
    dangling: spdx_parse("MIT OR", false).error,
    parens: spdx_parse("(MIT", false).error,
    refused: spdx_allowed("MIT OR", ALLOW, false).error,
    wrong_kind: spdx_manifest_text("pip", "").error,
    not_toml: spdx_manifest_text("cargo", "= nope").error != null,
    not_a_manifest: spdx_manifest("setup.py").error,
}
