// Meeting notes two people edit at once, each on their own copy (offline, or in a Yjs editor): the
// server joins their edits so neither is lost, and brings a copy up to date with only what it lacks.
//
//   quillo run crdt.qwe      then open http://localhost:8080/merge

use "crdt.qwer"

let SCHEMA = { notes: "text", meta: "map", todo: "array" }

fn copies() {
    let base = crdt_edit("", [{ text: "notes", insert: "Agenda: budget" }, { map: "meta", set: "title", value: "Weekly" }], 1)?.state
    // Ana and Ben both start from base, and neither sees the other's edits.
    let ana = crdt_edit(base, [{ text: "notes", insert: " and hiring" }, { array: "todo", push: "book a room" }], 2)?
    let ben = crdt_edit(base, [{ text: "notes", at: 0, insert: "Draft " }, { map: "meta", set: "owner", value: "Ben" }, { array: "todo", push: "send the minutes" }], 3)?
    { base: base, ana: ana, ben: ben }
}

route GET /merge {
    let c = copies()
    let merged = crdt_merge([c.base, c.ana.update, c.ben.update])?
    {
        ana_alone: crdt_read(c.ana.state, SCHEMA)?.notes,
        ben_alone: crdt_read(c.ben.state, SCHEMA)?.notes,
        merged: crdt_read(merged, SCHEMA)?,
        other_order_same: crdt_same(merged, crdt_merge([c.ben.state, c.ana.state, c.ben.update])?, SCHEMA)?,
    }
}

// Ana's copy says what it has; the server sends only Ben's edits, and her copy then matches.
route GET /sync {
    let c = copies()
    let server = crdt_merge([c.ana.state, c.ben.state])?
    let missing = crdt_diff(server, crdt_state_vector(c.ana.state)?)?
    let ana_now = crdt_merge([c.ana.state, missing])?
    {
        sent_bytes_less_than_whole: len(missing) < len(server),
        ana_up_to_date: crdt_same(ana_now, server, SCHEMA)?,
        notes: crdt_read(ana_now, SCHEMA)?.notes,
    }
}
