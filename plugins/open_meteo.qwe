// Weather for a town: today's forecast as rows, last week's history, a place found by name, air
// quality, and several places in one call. Open-Meteo needs no key for non-commercial use.
//
//   quillo run open_meteo.qwe
//   then open http://localhost:8080/forecast?lat=52.37&lon=4.89, /units, /history, /places and /refused
//
// With a commercial key, set OPEN_METEO_API_KEY; the `customer-` hosts are then used.

use "open_meteo.qwer"

route GET /forecast ? { lat: float, lon: float } {
    let f = meteo_forecast(lat, lon, {
        current: ["temperature_2m", "weather_code"],
        hourly: ["temperature_2m", "precipitation", "weather_code"],
        daily: ["temperature_2m_max", "temperature_2m_min", "weather_code", "sunrise", "sunset"],
        forecast_days: 3,
    })
    if is_err(f) { reply 502 f.error }
    { place: f.timezone, units: f.units, now: f.current, first_hour: first(f.hourly), hours: len(f.hourly), days: f.daily }
}

route GET /units {
    let f = meteo_forecast(40.71, -74.0, { hourly: ["temperature_2m", "wind_speed_10m", "precipitation"], forecast_days: 1, temperature_unit: "fahrenheit", wind_speed_unit: "mph", precipitation_unit: "inch", timezone: "America/New_York" })?
    { units: f.units, row: first(f.hourly), offset: f.utc_offset_seconds, zone: f.timezone }
}

route GET /history {
    let h = meteo_history(52.37, 4.89, "2026-10-01", "2026-10-03", { hourly: ["temperature_2m", "precipitation"], daily: ["precipitation_sum"], timezone: "Europe/Amsterdam" })?
    {
        hours: len(h.hourly),
        days: h.daily,
        summary: meteo_daily_summary(h.hourly, "temperature_2m")?,
        gap: h.hourly[1].precipitation,
    }
}

// The stand-in's first answer to this is a 429, which is waited out.
route GET /busy = { rows: len(meteo_forecast(1.0, 2.0, { hourly: "surface_pressure", forecast_days: 1 })?.hourly) }

route GET /places = {
    found: meteo_geocode("Amsterdam", { count: 5 })?,
    in_usa: first(meteo_geocode("Amsterdam", { country_code: "us" })?).admin1,
    nothing: meteo_geocode("Nowhereville", {})?,
    many: meteo_forecast_many([[52.37, 4.89], [48.85, 2.35]], { hourly: ["temperature_2m"], forecast_days: 1 })? | map((f) => [f.latitude, len(f.hourly)]),
    air: first(meteo_air_quality(52.37, 4.89, { hourly: ["pm10", "pm2_5"], forecast_days: 1 })?.hourly),
    code: [meteo_weather_code(0), meteo_weather_code(95), meteo_weather_code(42)],
}

route GET /refused = {
    latitude: meteo_forecast(95.0, 0.0, {}).error,
    server: meteo_forecast(50.0, 0.0, { hourly: ["moon_cheese"] }).error,
    option: meteo_forecast(50.0, 0.0, { colour: "blue" }).error,
    date: meteo_history(50.0, 0.0, "yesterday", "today", {}).error,
    order: meteo_history(50.0, 0.0, "2026-02-01", "2026-01-01", {}).error,
    too_old: meteo_history(50.0, 0.0, "1900-01-01", "1900-01-02", { hourly: ["temperature_2m"] }).error,
    days: meteo_forecast(50.0, 0.0, { forecast_days: 40 }).error,
    short: meteo_geocode("A", {}).error,
    no_field: meteo_daily_summary([{ time: "2026-01-01T00:00" }], "rain").error,
}
