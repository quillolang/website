// Heat and water meters on an M-Bus line, read through a TCP gateway: the bus scanned, a meter's
// records with their units, a readout too long for one telegram, a meter chosen by its serial
// number, and a garbled frame named. The first route reads the frame printed in EN 1434-3.
//
//   MBUS_GATEWAY=192.168.1.40:10001 quillo run mbus.qwe      then open http://localhost:8080/meter

use "mbus.qwer"

let GATEWAY = env("MBUS_GATEWAY", "127.0.0.1:10001")
let FAST = { timeout_ms: 400, retries: 1 }

route GET /standard {
    let m = mbus_parse("68 1F 1F 68 08 02 72 78 56 34 12 24 40 01 07 55 00 00 00 03 13 15 31 00 DA 02 3B 13 01 8B 60 04 37 18 02 18 16")?
    { id: m.id, maker: m.manufacturer, medium: m.medium, records: m.records }
}

route GET /frames = {
    request: mbus_short_frame(91, 5)?,
    ping: mbus_short_frame(64, 5)?,
    built: mbus_long_frame(83, 5, 81, "017a0a")?,
    ack: mbus_parse("e5")?,
    bad_sum: mbus_parse("681F1F680802727856341224400107550000000313153100DA023B13018B6004371802FF16").error,
    bad_stop: mbus_parse("681F1F680802727856341224400107550000000313153100DA023B13018B60043718021815").error,
    bad_lengths: mbus_parse("681F20680802").error,
    not_a_frame: mbus_parse("deadbeef").error,
}

// All the record kinds a heat meter sends, without a frame round them.
route GET /records = mbus_records("0C0678563412" + "0B2D503412" + "025AE100" + "426CE93C" + "046D2C0FE93C" + "0DFD0C03434241" + "01FD1740" + "0F")?

route GET /scan = { meters: mbus_scan(GATEWAY, 1, 8, { timeout_ms: 150 })?, dead: mbus_ping(GATEWAY, 9, FAST)? }

route GET /meter {
    let m = mbus_read(GATEWAY, 5, FAST)?
    { id: m.id, maker: m.manufacturer, medium: m.medium, status: m.status.application, telegrams: m.telegrams, readings: m.records | map((r) => [r.name, r.value, r.unit, r.storage]) }
}

// A logger's readout, spread over three telegrams.
route GET /history {
    let m = mbus_read(GATEWAY, 6, FAST)?
    { telegrams: m.telegrams, count: len(m.records), last: m.records[len(m.records) - 1].value }
}

route GET /select {
    let wrong = mbus_select(GATEWAY, "99999999", FAST)?
    let right = mbus_select(GATEWAY, "1234FFFF", { ...FAST, manufacturer: "PAD" })?
    { wrong: wrong, right: right, id: mbus_read(GATEWAY, 253, FAST)?.id }
}

route GET /silent = {
    nobody: mbus_read(GATEWAY, 44, FAST).error,
    broken: mbus_read(GATEWAY, 7, FAST).error,
    address: mbus_read(GATEWAY, 300, FAST).error,
    moved: mbus_set_address(GATEWAY, 5, 11, FAST)?,
    back: mbus_set_address(GATEWAY, 11, 5, FAST)?,
    off: mbus_read("127.0.0.1:1", 1, { timeout_ms: 300 }).error,
}
