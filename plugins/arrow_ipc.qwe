// Rows in, Arrow out and back: a file for a data tool to read, a stream for a socket, typed columns
// with nulls and nesting, and a program's own schema or an inferred one.
//
//   ARROW_OUT=/tmp/sales.arrow quillo run arrow_ipc.qwe      then open http://localhost:8080/file, /stream, /types, /infer, /column, /magic and /broken

use "arrow_ipc.qwer"

let OUT = env("ARROW_OUT", "/tmp/arrow-demo.arrow")

let ROWS = [
    { id: 1, name: "lamp", price: "19.90", when: "2026-11-01", at: "2026-11-01T09:30:00", tags: ["a", "b"], box: { w: 10, h: 2.5 }, ok: true, raw: "aGk=", kind: "red" },
    { id: 2, name: null, price: "5.00", when: null, at: null, tags: [], box: null, ok: false, raw: null, kind: "blue" },
    { id: 3, name: "désk ☕", price: null, when: "2024-02-29", at: "1970-01-01T00:00:01", tags: null, box: { w: 3 }, ok: null, raw: "AP8=", kind: "red" },
]

let SCHEMA = [
    { name: "id", type: "int32", nullable: false }, { name: "name", type: "utf8" }, { name: "price", type: "decimal128(10,2)" },
    { name: "when", type: "date32" }, { name: "at", type: "timestamp[ms]" }, { name: "tags", type: "list<utf8>" },
    { name: "box", type: "struct<w:int16,h:float32>" }, { name: "ok", type: "bool" }, { name: "raw", type: "binary" },
    { name: "kind", type: "dictionary<int32,utf8>" },
]

route GET /file {
    let w = arrow_ipc_write(OUT, ROWS, SCHEMA, { format: "file", batch_size: 2 })?
    let r = arrow_ipc_read(OUT, 0)?
    { wrote: [w.rows, w.batches, w.bytes > 500], format: r.format, batches: r.batches, total: r.total_rows, rows: r.rows, types: r.schema.fields | map((f) => `${f.name}: ${f.type}${f.nullable ? "" : " not null"}`) }
}

route GET /stream {
    let text = arrow_ipc_encode(ROWS, SCHEMA, { format: "stream" })?
    let r = arrow_ipc_decode(text, 2)?
    let squeezed = arrow_ipc_encode([{ s: repeat("same words ", 2000) }], null, { format: "stream", compression: "lz4" })?
    { format: r.format, total: r.total_rows, got: len(r.rows), first: r.rows[0].name, squeezed: len(squeezed) < 3000, back: len(arrow_ipc_decode(squeezed, 0)?.rows[0].s) }
}

route GET /types {
    let rows = [{ i8: -128, u8: 255, u64: "18446744073709551615", f: 1.5, d: 2.25, big: 9007199254740993, t: "12:30:45", ts: "2026-11-01T09:00:00Z", nums: [[1, 2], [], null], }]
    let schema = { i8: "int8", u8: "uint8", u64: "uint64", f: "float32", d: "float64", big: "int64", t: "time64[us]", ts: "timestamp[us, UTC]", nums: "list<list<int32>>" }
    let r = arrow_ipc_decode(arrow_ipc_encode(rows, schema, {})?, 0)?
    { rows: r.rows, types: r.schema.fields | map((f) => f.type) }
}

route GET /infer = {
    schema: arrow_ipc_infer([{ a: 1, b: "x", c: [1], d: { e: 1 }, n: null }, { a: 2.5, b: "y", c: [2.5], d: { f: true }, n: null, late: 1 }])?.fields | map((f) => [f.name, f.type]),
    mixed: arrow_ipc_infer([{ a: 1 }, { a: "x" }])?.fields[0].type,
    rows: arrow_ipc_decode(arrow_ipc_encode([{ a: 1, b: null }, { b: "two" }], null, {})?, 0)?.rows,
}

route GET /column {
    arrow_ipc_write(OUT, ROWS, SCHEMA, { batch_size: 1 })?
    let s = arrow_ipc_schema(OUT)?
    { price: arrow_ipc_column(OUT, "price")?, when: arrow_ipc_column(OUT, "when")?, batches: s.batches, keys: keys(s), none: arrow_ipc_column(OUT, "nope").error != null }
}

route GET /magic {
    let empty = arrow_ipc_decode(arrow_ipc_encode([], { a: "int32" }, { format: "file" })?, 0)?
    { head: slice(arrow_ipc_encode([{ a: 1 }], null, { format: "file" })?, 0, 11), stream_head: slice(arrow_ipc_encode([{ a: 1 }], null, { format: "stream" })?, 0, 5), empty: [empty.batches, empty.total_rows, empty.schema.fields[0].type] }
}

route GET /broken = {
    too_big: arrow_ipc_encode([{ a: 300 }], { a: "int8" }, {}).error,
    not_int: arrow_ipc_encode([{ a: 1.5 }], { a: "int32" }, {}).error,
    not_null: arrow_ipc_encode([{ a: null }], [{ name: "a", type: "int32", nullable: false }], {}).error,
    bad_list: arrow_ipc_encode([{ a: 1 }], { a: "list<int32>" }, {}).error,
    bad_date: arrow_ipc_encode([{ a: "someday" }], { a: "date32" }, {}).error != null,
    bad_base64: arrow_ipc_encode([{ a: "***" }], { a: "binary" }, {}).error != null,
    bad_type: arrow_ipc_encode([{ a: 1 }], { a: "int128" }, {}).error,
    bad_format: arrow_ipc_encode([{ a: 1 }], null, { format: "csv" }).error,
    zstd: arrow_ipc_encode([{ a: 1 }], null, { compression: "zstd" }).error,
    no_columns: arrow_ipc_encode([], null, {}).error,
    not_a_map: arrow_ipc_encode([1], null, {}).error,
    short: arrow_ipc_decode("QUJD", 0).error,
    junk: arrow_ipc_decode("AAECAwQFBgcICQoLDA0ODw==", 0).error != null,
    cut: arrow_ipc_decode(slice(arrow_ipc_encode([{ a: 1 }], null, { format: "file" })?, 0, 200), 0).error != null,
    no_file: arrow_ipc_read("nothing.arrow", 0).error != null,
}
