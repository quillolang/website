// Encrypting to a public key with HPKE (RFC 9180): a note sealed to a recipient, a sender proved by
// auth mode, messages in sequence and a secret both sides derive, and every test vector of the RFC,
// all 28 setups, sealed and opened again to the byte.
//
//   quillo run hpke.qwe      then open http://localhost:8080/seal, /auth, /many, /rfc and /failures
//
// hpke_rfc9180_vectors.json holds Appendix A of the RFC as JSON.

use "hpke.qwer"

let SUITE = "x25519-sha256-chacha20poly1305"
let VECTORS = json.parse(read_file("hpke_rfc9180_vectors.json"))?

route GET /seal {
    let me = hpke_keygen(SUITE)?
    let box = hpke_seal(SUITE, me.public_key, "meet at noon", { info: "notes v1", aad: "header" })?
    let again = hpke_seal(SUITE, me.public_key, "meet at noon", { info: "notes v1", aad: "header" })?
    {
        key_bytes: len(me.public_key) / 2,
        enc_bytes: len(box.enc) / 2,
        text: hpke_open(SUITE, me.private_key, box.enc, box.ciphertext, { info: "notes v1", aad: "header" })?.text,
        differs: again.ciphertext != box.ciphertext,
        p256: len(hpke_keygen("p256-sha256-aes128gcm")?.public_key) / 2,
        p521: len(hpke_keygen("p521-sha512-aes256gcm")?.public_key) / 2,
        by_ids: len(hpke_keygen({ kem_id: 17, kdf_id: 2, aead_id: 2 })?.private_key) / 2,
    }
}

route GET /auth {
    let them = hpke_keygen(SUITE)?
    let me = hpke_keygen(SUITE)?
    let stranger = hpke_keygen(SUITE)?
    let box = hpke_seal(SUITE, them.public_key, { hex: "00ff10" }, { sender_private: me.private_key })?
    let got = hpke_open(SUITE, them.private_key, box.enc, box.ciphertext, { sender_public: me.public_key })?
    let psk = { psk: { hex: "0247fd33b913760fa1fa51e1892d9f307fbe65eb171e8132c2af18555a738b82" }, psk_id: "key-7" }
    let shared = hpke_seal(SUITE, them.public_key, "with a psk", psk)?
    {
        bytes: got.hex,
        binary_text: got.text,
        not_them: hpke_open(SUITE, them.private_key, box.enc, box.ciphertext, { sender_public: stranger.public_key }).error,
        no_auth: hpke_open(SUITE, them.private_key, box.enc, box.ciphertext, {}).error,
        psk: hpke_open(SUITE, them.private_key, shared.enc, shared.ciphertext, psk)?.text,
        half_psk: hpke_seal(SUITE, them.public_key, "x", { psk: "only this" }).error,
    }
}

route GET /many {
    let k = hpke_derive_keypair(SUITE, "not a real secret: a test's seed")?
    let sealed = hpke_seal_many(SUITE, k.public_key, [{ plaintext: "first", aad: "1" }, { plaintext: "second", aad: "2" }], { exports: [{ context: "keys", length: 16 }] })?
    let msgs = [{ ciphertext: sealed.ciphertexts[0], aad: "1" }, { ciphertext: sealed.ciphertexts[1], aad: "2" }]
    let opened = hpke_open_many(SUITE, k.private_key, sealed.enc, msgs, { exports: [{ context: "keys", length: 16 }] })?
    {
        texts: map(opened.plaintexts, (p) => p.text),
        same_secret: opened.exports[0] == sealed.exports[0],
        single: hpke_export(SUITE, k.private_key, sealed.enc, "keys", 16, {})? == sealed.exports[0],
        out_of_order: hpke_open_many(SUITE, k.private_key, sealed.enc, [msgs[1]], {}).error,
        stable: k.public_key == hpke_derive_keypair(SUITE, "not a real secret: a test's seed")?.public_key,
    }
}

fn hx(v) = { hex: v }

fn suite_of(v) = { kem_id: v.kem_id, kdf_id: v.kdf_id, aead_id: v.aead_id }

fn setup(v, side) {
    let o = { info: hx(v.info) }
    let keyed = if v.mode >= 2 {
        if side == "send" { { ...o, sender_private: v.skSm } } else { { ...o, sender_public: v.pkSm } }
    } else { o }
    if v.mode == 1 || v.mode == 3 { { ...keyed, psk: hx(v.psk), psk_id: hx(v.psk_id) } } else { keyed }
}

// The sender with the RFC's ephemeral seed must make the RFC's `enc` and each ciphertext, past 256
// messages, and the receiver must open them. Each export is compared on both sides.
fn check(v) {
    let exports = map(v.exports, (e) => { context: hx(e.context), length: e.length })
    let wanted = reduce(v.encryptions, {}, (m, e) => set(m, str(e.seq), e))
    let last = if len(v.encryptions) > 0 { 257 } else { 0 }
    let messages = map(range(0, last), (i) => {
        let e = wanted[str(i)]
        if e == null { { plaintext: "filler", aad: "filler" } } else { { plaintext: hx(e.pt), aad: hx(e.aad) } }
    })
    let sealed = hpke_seal_many(suite_of(v), v.pkRm, messages, { ...setup(v, "send"), test_ikm_e: v.ikmE, exports })?
    let bad = []
    if sealed.enc != v.enc { bad = bad + ["enc"] }
    for e in v.encryptions {
        if sealed.ciphertexts[e.seq] != e.ct { bad = bad + [`ct ${e.seq}`] }
    }
    for i in range(0, len(v.exports)) {
        if sealed.exports[i] != v.exports[i].value { bad = bad + [`send export ${i}`] }
    }
    let boxes = map(range(0, last), (i) => { ciphertext: sealed.ciphertexts[i], aad: messages[i].aad })
    let opened = hpke_open_many(suite_of(v), v.skRm, v.enc, boxes, { ...setup(v, "open"), exports })?
    for e in v.encryptions {
        if opened.plaintexts[e.seq].hex != e.pt { bad = bad + [`pt ${e.seq}`] }
    }
    for i in range(0, len(v.exports)) {
        if opened.exports[i] != v.exports[i].value { bad = bad + [`open export ${i}`] }
    }
    let derived = hpke_derive_keypair(suite_of(v), hx(v.ikmE))?
    if derived.public_key != v.pkEm { bad = bad + ["derive"] }
    { section: v.section, bad }
}

route GET /rfc {
    let results = map(VECTORS, check)
    {
        setups: len(results),
        ciphertexts: sum(map(VECTORS, (v) => len(v.encryptions))),
        exports: sum(map(VECTORS, (v) => len(v.exports))),
        failed: filter(results, (r) => len(r.bad) > 0),
    }
}

route GET /failures {
    let k = hpke_keygen(SUITE)?
    let box = hpke_seal(SUITE, k.public_key, "x", { info: "a" })?
    {
        wrong_info: hpke_open(SUITE, k.private_key, box.enc, box.ciphertext, { info: "b" }).error,
        wrong_key: hpke_open(SUITE, hpke_keygen(SUITE)?.private_key, box.enc, box.ciphertext, { info: "a" }).error,
        short_key: hpke_seal(SUITE, "abcd", "x", {}).error,
        bad_suite: hpke_keygen("x448-sha256-aes128gcm").error,
        bad_shape: hpke_keygen("x25519").error,
        export_only: hpke_seal("x25519-sha256-export", k.public_key, "x", {}).error,
        not_hex: hpke_open(SUITE, "zz", box.enc, box.ciphertext, {}).error,
    }
}
