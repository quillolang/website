// Military grid references: positions to MGRS and back, the zones that break the 6° rule in
// Norway and Svalbard, UTM, and UPS round the poles.
//
//   quillo run mgrs.qwe
//   then open http://localhost:8080/encode?lat=48.24949&lon=16.4145, /decode?ref=33UXP0500444998,
//   /zones, /poles, /utm, /square and /refused

use "mgrs.qwer"

route GET /encode ? { lat: float, lon: float, precision: int = 5 } {
    let r = mgrs_encode(lat, lon, precision)
    if is_err(r) { reply 422 r.error }
    { mgrs: r, printed: mgrs_format(r)? }
}

route GET /decode ? { ref: str } {
    let r = mgrs_decode(ref)
    if is_err(r) { reply 422 r.error }
    r
}

// Digits are cut, not rounded, so a metre's difference from programs that round is expected.
route GET /known = {
    vienna: mgrs_encode(48.24949, 16.4145, 5)?,
    monument: mgrs_encode(38.8895, -77.0352, 5)?,
    sydney: mgrs_encode(-33.8688, 151.2093, 5)?,
    arctic: mgrs_decode("24XWT783908")?,
    low_precision: mgrs_encode(48.24949, 16.4145, 1)?,
    square: mgrs_encode(48.24949, 16.4145, 0)?,
}

// Bergen is in the wide zone 32V, Svalbard's towns in odd zones only.
route GET /zones = {
    bergen: mgrs_zone(60.39, 5.32)?,
    shetland: mgrs_zone(60.15, 1.15)?.gzd,
    svalbard: mgrs_zone(78.22, 15.65)?,
    west_svalbard: mgrs_zone(75.0, 8.0)?.gzd,
    ordinary: mgrs_zone(40.0, -74.0)?,
    bergen_ref: mgrs_encode(60.39, 5.32, 3)?,
    pole: mgrs_zone(89.0, 0.0)?.exception,
}

route GET /utm {
    let t = mgrs_to_utm(40.7128, -74.006)?
    let s = mgrs_to_utm(-33.8688, 151.2093)?
    {
        new_york: t,
        back: mgrs_from_utm(t.zone, t.hemisphere, t.easting, t.northing)?,
        sydney: s.text,
        sydney_back: mgrs_from_utm(s.zone, "H", s.easting, s.northing)?,
    }
}

route GET /poles {
    let n = mgrs_to_ups(85.0, 30.0)?
    {
        north: mgrs_encode(90.0, 0.0, 5)?,
        south: mgrs_encode(-90.0, 0.0, 5)?,
        ups: n,
        back: mgrs_from_ups(n.pole, n.easting, n.northing)?,
        south_edge: mgrs_encode(-85.0, -40.0, 3)?,
        south_back: mgrs_decode(mgrs_encode(-85.0, -40.0, 5)?)?,
        north_back: mgrs_decode(mgrs_encode(86.0, -120.0, 5)?)?,
    }
}

route GET /square = {
    box: mgrs_square("33UXP0544")?,
    round_trip: mgrs_decode(mgrs_encode(-12.5, 130.8, 5)?)?,
}

route GET /refused = {
    letters: mgrs_decode("hello").error,
    odd: mgrs_decode("33UXP123").error,
    no_zone: mgrs_decode("40XWT1234").error,
    svalbard: mgrs_decode("32XMH0000000000").error,
    row: mgrs_decode("33UAA0000000000").error,
    band: mgrs_decode("33CXP0000000000").error,
    lat: mgrs_encode(91.0, 0.0, 5).error,
    precision: mgrs_encode(10.0, 10.0, 7).error,
    utm_past: mgrs_to_utm(85.0, 0.0).error,
    ups_inside: mgrs_to_ups(50.0, 0.0).error,
}
