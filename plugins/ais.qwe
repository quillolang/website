// A harbour's AIS feed: lines from a receiver decoded (positions, a container ship's voyage
// data in two parts, a yacht's class B reports, a navigation mark, a line garbled on the way),
// and the ships in it listed.
//
//   quillo run ais.qwe      then open http://localhost:8080/messages and http://localhost:8080/ships

use "ais.qwer"

let LOG = split(trim(read_file("ais_sample.nmea")?), "\n")

route GET /messages = ais_decode(LOG)

route GET /ships = ais_ships(LOG)

route GET /one = {
    seattle: ais_decode_payload("177KQJ5000G?tO`K>RA1wUbN0TKH", 0)?,
    types: map([30, 52, 70, 84], (t) => ais_ship_type(t)),
}
