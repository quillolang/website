// A feed reader's import and export of subscriptions as OPML.
//
//   quillo run opml.qwe      then open http://localhost:8080/import

use "opml.qwer"

route GET /import = opml_feeds(read_file("opml_sample.opml")?)?

route GET /tree {
    let o = opml_read(read_file("opml_sample.opml")?)?
    { title: o.title, folders: o.outlines | map((x) => { name: x.text, feeds: len(x.children) }) }
}

route GET /export.opml = respond(200, opml_write("Quillo Reader export", [
    { title: "Quillo blog", xml_url: "https://quillolang.org/blog/feed.xml", html_url: "https://quillolang.org/blog/", category: "Programming" },
    { title: "Example News", xml_url: "https://news.example.com/feed" },
    { title: "This Week in Rust", xml_url: "https://this-week-in-rust.org/rss.xml", category: "Programming" },
])?, { "content-type": "text/x-opml; charset=utf-8", "content-disposition": "attachment; filename=subscriptions.opml" })
