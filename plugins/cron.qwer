//! Cron lines read: the next times one runs, whether it is valid, for showing a schedule or running your own.
//!
//! [dependencies]
//! cron = "0.12"
//! chrono = "0.4"

use chrono::{TimeZone, Utc};
use std::str::FromStr;

/// A 5-field line (`minute hour day month weekday`) given a seconds field, as the crate wants; 6 and 7 fields pass as they are.
fn schedule(line: &str) -> Result<cron::Schedule, String> {
    let fields = line.split_whitespace().count();
    let full = if fields == 5 { format!("0 {}", line.trim()) } else { line.trim().to_string() };
    cron::Schedule::from_str(&full).map_err(|e| format!("`{}`: {}", line, e))
}

/// The next `count` times `line` runs after `after` (milliseconds since 1970; 0 for now), in UTC, as milliseconds.
pub fn cron_next(line: &str, count: i64, after: i64) -> Result<Vec<i64>, String> {
    let s = schedule(line)?;
    let from = if after > 0 { Utc.timestamp_millis_opt(after).single().ok_or("a time out of range")? } else { Utc::now() };
    Ok(s.after(&from).take(count.clamp(0, 1000) as usize).map(|t| t.timestamp_millis()).collect())
}

/// Whether `line` is a cron line this reads (5 fields, or 6 and 7 with seconds and years).
pub fn cron_valid(line: &str) -> bool {
    schedule(line).is_ok()
}
