// A backup tool's command line, described as data: flags, options with types and env fallbacks,
// subcommands, generated help, and mistakes answered the way people expect.
//
//   CLI_ARGS="restore --from /backups/monday --force" quillo run cli_args.qwe
//   then open http://localhost:8080/real; the other routes parse words given in the route.
//
// A Quillo program is not handed its command line, so the words come from `CLI_ARGS`, or from
// after a `--` where the runner lets one through.

use "cli_args.qwer"

let spec = {
    name: "backup",
    version: "1.4.2",
    about: "Backs up and restores a folder",
    args: [
        { name: "verbose", kind: "count", short: "v", help: "Say more; twice for even more" },
        { name: "config", short: "c", type: "path", env: "BACKUP_CONFIG", help: "Config file", value_name: "FILE" },
        { name: "dry_run", long: "dry-run", kind: "flag", short: "n", help: "Show what would happen" },
        { name: "token", env: "BACKUP_TOKEN", hidden: true },
    ],
    commands: [
        { name: "create", about: "Makes a backup", aliases: ["c"], args: [
            { name: "source", kind: "positional", required: true, type: "path", help: "Folder to back up" },
            { name: "level", short: "l", type: "int", default: 6, help: "Compression level" },
            { name: "ratio", type: "float", default: 0.5 },
            { name: "format", choices: ["tar", "zip", "qar"], default: "tar", help: "Archive format" },
            { name: "exclude", short: "x", multiple: true, help: "Pattern to leave out" },
            { name: "encrypt", type: "bool", env: "BACKUP_ENCRYPT" },
        ]},
        { name: "restore", about: "Restores a backup", args: [
            { name: "from", required: true, type: "path" },
            { name: "to", conflicts: ["in_place"] },
            { name: "in_place", long: "in-place", kind: "flag" },
            { name: "force", kind: "flag", requires: ["from"] },
        ]},
        { name: "db", about: "Database dumps", command_required: true, commands: [
            { name: "dump", about: "Dumps it", args: [{ name: "table", kind: "positional", multiple: true }] },
        ]},
    ],
}

fn parse(words) { cli_args_parse(spec, split(words, " ")) }

route GET /create {
    let r = parse("-vv -c /etc/b.toml create /home/ada --level 9 -x '*.log' -x tmp --format zip")?
    { command: r.command, values: r.values, sources: r.sources }
}

route GET /defaults {
    let r = parse("c /data")?
    { command: r.command, level: r.values.level, level_from: r.sources.level, ratio: r.values.ratio, format: r.values.format, exclude: r.values.exclude, verbose: r.values.verbose, encrypt: r.values.encrypt, encrypt_from: r.sources.encrypt, config: r.values.config, config_from: r.sources.config, token: r.values.token }
}

route GET /nested = parse("db dump users orders")?

route GET /mistakes = {
    bad_number: parse("create /d --level high").error,
    bad_choice: parse("create /d --format rar").error,
    missing: parse("create").error,
    unknown: parse("create /d --levle 3").error,
    typo: parse("creat /d").error,
    clash: parse("restore --from /b --to /c --in-place").error,
}

route GET /help = {
    top: parse("--help")?,
    version: parse("--version")?,
    sub: cli_args_help(spec, ["create"])?,
    deep: parse("db")?.exit,
    usage: cli_args_usage(spec)?,
}

route GET /specs = {
    ok: cli_args_check(spec)?,
    unknown_key: cli_args_check({ name: "x", arg: [] }).error,
    bad_kind: cli_args_check({ name: "x", args: [{ name: "a", kind: "switch" }] }).error,
    bad_type: cli_args_check({ name: "x", args: [{ name: "a", type: "date" }] }).error,
    twice: cli_args_check({ name: "x", args: [{ name: "a" }, { name: "a" }] }).error,
    long_short: cli_args_check({ name: "x", args: [{ name: "a", short: "ab" }] }).error,
    help_taken: cli_args_check({ name: "x", args: [{ name: "a", short: "h" }] }).error,
}

route GET /real {
    let words = cli_args_os()
    let r = cli_args_parse(spec, words)
    if is_err(r) { return { words: words, mistake: r.error } }
    { words: words, command: r.command, from: r.values.from, force: r.values.force }
}
