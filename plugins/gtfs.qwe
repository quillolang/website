// A departures board from a GTFS feed: gtfs_sample.zip is a small made-up network with a station of
// two platforms, an overnight bus, a shuttle by frequency and a holiday timetable. Live times come
// from a GTFS-Realtime feed, laid over it.
//
//   GTFS_RT_URL=https://agency.example/tripupdates.pb GTFS_RT_KEY=... quillo run gtfs.qwe
//   then open http://localhost:8080/feed, /board, /days, /night, /trip, /live and /refused

use "gtfs.qwer"

let FEED = "gtfs_sample.zip"

route GET /feed = {
    feed: gtfs_open(FEED)?,
    routes: gtfs_routes(FEED)? | map((r) => [r.route_short_name, r.mode]),
    stops: gtfs_stops(FEED, "central")? | map((s) => [s.id, s.is_station, s.platform]),
    comma: gtfs_stops(FEED, "museum")?[0].name,
    near: gtfs_stops_near(FEED, 52.3665, 4.9160, 1000.0)? | map((s) => [s.id, s.distance_m]),
}

fn board(stop, when) = gtfs_departures(FEED, stop, when, 6, 180)? | map((d) => `${d.time} ${d.route} ${d.headsign} p${d.platform ?? "-"}`)

route GET /board = {
    // Monday 2 November 2026: both platforms of the station, and a shuttle every half hour.
    station: board("CEN", "2026-11-02T07:45:00"),
    platform: board("CEN1", "2026-11-02T07:45:00"),
    in_minutes: gtfs_departures(FEED, "CEN", "2026-11-02T07:45:00", 1, 60)?[0],
    end_of_line: board("ZOO", "2026-11-02T08:00:00"),
}

route GET /days = {
    monday: gtfs_services(FEED, "2026-11-02")?,
    saturday: gtfs_services(FEED, "2026-11-07")?.services | map((s) => s.service),
    christmas: gtfs_services(FEED, "2026-12-25")?,
    after_the_feed: gtfs_services(FEED, "2027-06-01")?.services,
    weekend_board: board("CEN", "2026-11-07T09:00:00"),
    christmas_board: board("CEN", "2026-12-25T07:30:00"),
}

// The 25:30 of Monday's service leaves at 01:30 on Tuesday.
route GET /night = {
    tuesday_morning: gtfs_departures(FEED, "CEN", "2026-11-03T01:00:00", 1, 60)?[0],
    monday_late: len(gtfs_departures(FEED, "CEN", "2026-11-02T23:30:00", 5, 60)?),
    first_of_the_year: gtfs_departures(FEED, "CEN1", "2027-01-01T01:00:00", 3, 60)?,
}

route GET /trip = {
    whole: gtfs_trip(FEED, "T1-0800")?,
    // MUS has no time of its own in this trip: it falls between its neighbours.
    between: gtfs_trip(FEED, "T1-1000")?.stops | map((s) => [s.stop_id, s.depart]),
    across_midnight: gtfs_departures(FEED, "CEN", "2026-11-06T23:50:00", 4, 700)? | map((d) => [d.date, d.time, d.trip_id]),
}

route GET /live {
    let rt = gtfs_realtime_fetch(env("GTFS_RT_URL", ""), { "x-api-key": env("GTFS_RT_KEY", "") })?
    let plan = gtfs_departures(FEED, "CEN", "2026-11-02T07:45:00", 6, 180)?
    {
        header: rt.header,
        entities: rt.entities | map((e) => e.id),
        bus: rt.entities[3].vehicle,
        notice: rt.entities[4].alert,
        board: gtfs_apply_realtime(plan, rt) | map((d) => [d.trip_id, d.time, d.expected, d.status, d.delay_s]),
        wrong_key: gtfs_realtime_fetch(env("GTFS_RT_URL", ""), { "x-api-key": "wrong" }).error,
    }
}

route GET /refused = {
    no_stop: gtfs_departures(FEED, "NOPE", "2026-11-02T07:45:00", 5, 60).error,
    bad_time: gtfs_departures(FEED, "CEN", "soon", 5, 60).error,
    no_trip: gtfs_trip(FEED, "NOPE").error,
    not_zip: gtfs_open("gtfs.qwe").error != null,
    not_a_feed: gtfs_realtime_file("gtfs.qwe").error != null,
}
