// A Supabase project from the server: rows read and filtered as a signed-in user and as the service
// key, sign-in, tokens checked here, an RPC, and files with signed links.
//
//   SUPABASE_API_URL=https://xyz.supabase.co SUPABASE_API_KEY=... SUPABASE_JWT_SECRET=... quillo run supabase.qwe
//   then open /rows, /filters, /write, /signin, /storage and /broken

use "supabase.qwer"

route GET /rows = {
    all: supabase_select("todos", { select: "id,title", order: "id.asc", count: true, limit: 2 }, null)?,
    next: supabase_select("todos", { select: "id", order: "id.asc", limit: 2, offset: 2 }, null)?.rows,
}

route GET /filters = {
    open: supabase_select("todos", { select: "id", where: { done: false, priority: { gte: 2 } }, order: "id.asc" }, null)?.rows,
    among: supabase_select("todos", { select: "id", where: { title: ["Buy milk, eggs", "Call (Ada)"] }, order: "id.asc" }, null)?.rows,
    like: supabase_select("todos", { select: "id", where: { title: { ilike: "%ADA%" } } }, null)?.rows,
    none: supabase_select("todos", { select: "id", where: { note: null }, order: "id.asc" }, null)?.rows,
    not: supabase_select("todos", { select: "id", where: { priority: { not: { eq: 1 } } }, order: "id.asc" }, null)?.rows,
    either: supabase_select("todos", { select: "id", where: { or: "(priority.eq.3,done.is.true)" }, order: "id.asc" }, null)?.rows,
    text: supabase_filter("title", { in: ["a,b", "c"] })?,
}

route GET /write {
    let made = supabase_insert("todos", [{ title: "New one", priority: 1 }], null)?
    let id = made[0].id
    let changed = supabase_update("todos", { id: id }, { done: true }, null)?
    let upserted = supabase_insert("todos", { id: id, title: "Renamed", priority: 2 }, { upsert: true, on_conflict: "id" })?
    let duplicate = supabase_insert("todos", { id: id, title: "Same id", priority: 2 }, null)
    let removed = supabase_delete("todos", { id: id }, null)?
    { done: changed[0].done, title: upserted[0].title, duplicate: duplicate.error, removed: len(removed), total: supabase_rpc("count_todos", { done: false }, null)? }
}

// A visitor signs in; their token only reaches their own rows, and is checked here without a request.
route GET /signin {
    let s = supabase_sign_in("ada@example.com", "correct horse")?
    let claims = supabase_verify_jwt(s.access_token)?
    let fresh = supabase_refresh(s.refresh_token)?
    {
        email: claims.email,
        role: claims.role,
        same_user: claims.sub == s.user.id,
        mine: supabase_select("todos", { select: "id" }, { token: s.access_token })?.rows,
        me: supabase_user(s.access_token)?.email,
        refreshed: fresh.access_token != null,
        reused: supabase_refresh(s.refresh_token).error,
        wrong: supabase_sign_in("ada@example.com", "wrong").error,
        out: supabase_sign_out(fresh.access_token)?,
        after: supabase_refresh(fresh.refresh_token).error,
    }
}

route GET /tokens = {
    bad_signature: supabase_verify_jwt(tamper(supabase_sign_in("ada@example.com", "correct horse")?.access_token)).error,
    none: supabase_verify_jwt("eyJhbGciOiJub25lIn0.eyJzdWIiOiJ4In0.").error,
    junk: supabase_verify_jwt("junk").error,
}

fn tamper(t) = slice(t, 0, len(t) - 2) + "AA"

route GET /storage {
    supabase_upload("invoices", "2026/ada one.txt", "invoice 1", "text/plain", true)?
    let link = supabase_signed_url("invoices", "2026/ada one.txt", 60)?
    let got = http.get(link, {}, { public_only: false })
    {
        status: got.status,
        body: got.body,
        again: supabase_upload("invoices", "2026/ada one.txt", "x", "text/plain", false).error,
        upload: supabase_signed_upload_url("invoices", "2026/next.txt")?.token != null,
        public: supabase_public_url("logos", "a b.png")?,
        missing: supabase_signed_url("invoices", "nothing.txt", 60).error,
        removed: supabase_remove("invoices", ["2026/ada one.txt"])?,
    }
}

route GET /broken = {
    no_table: supabase_select("nothing", {}, null).error,
    no_filter: supabase_delete("todos", {}, null).error,
    bad_op: supabase_select("todos", { where: { a: { wat: 1 } } }, null).error,
}
