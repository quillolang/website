//! JSON5 and JSON with comments read as values: tsconfig.json, VS Code settings, devcontainer and Deno files, with comments, trailing commas, single quotes and unquoted keys.
//! version: 1.0.0
//!
//! [dependencies]
//! json5 = "0.4"

use serde_json::Value;

/// Texts up to 10 MB are read.
const MAX: usize = 10 * 1024 * 1024;

/// The deepest nesting of brackets outside strings: the parser recurses, and text nested thousands deep would overflow
/// the server's stack, so it is refused first.
fn too_deep(text: &str, max: usize) -> bool {
    let (mut depth, mut quote, mut esc) = (0usize, None::<char>, false);
    for c in text.chars() {
        if let Some(q) = quote {
            if esc { esc = false } else if c == '\\' { esc = true } else if c == q { quote = None }
            continue;
        }
        match c {
            '"' | '\'' => quote = Some(c),
            '[' | '{' | '(' => {
                depth += 1;
                if depth > max {
                    return true;
                }
            }
            ']' | '}' | ')' => depth = depth.saturating_sub(1),
            _ => {}
        }
    }
    false
}

/// JSON5 text as a value: `//` and `/* */` comments, trailing commas, `'single'` quotes, unquoted keys, hex numbers,
/// `+Infinity` and `NaN` (as null), and plain JSON too. The error says the line and column.
pub fn json5_parse(text: &str) -> Result<Value, String> {
    if text.len() > MAX {
        return Err("texts up to 10 MB".into());
    }
    if too_deep(text, 128) {
        return Err("nested more than 128 deep".into());
    }
    let v: Value = json5::from_str(text).map_err(|e| format!("not JSON5: {}", e))?;
    Ok(v)
}

/// A JSON5 or JSONC file (tsconfig.json, .vscode/settings.json) read as json5_parse reads text.
pub fn json5_read_file(path: &str) -> Result<Value, String> {
    let size = std::fs::metadata(path).map_err(|e| format!("{}: {}", path, e))?.len();
    if size as usize > MAX {
        return Err(format!("{}: files up to 10 MB", path));
    }
    json5_parse(&std::fs::read_to_string(path).map_err(|e| format!("{}: {}", path, e))?)
}

/// `text` with its comments and trailing commas taken out, as plain JSON text that any JSON reader takes; strings are kept as
/// they are, comments inside them too. For JSONC that must go on to a strict parser unchanged otherwise.
pub fn jsonc_strip(text: &str) -> Result<String, String> {
    if text.len() > MAX {
        return Err("texts up to 10 MB".into());
    }
    let b: Vec<char> = text.chars().collect();
    let mut out = String::with_capacity(text.len());
    let mut i = 0;
    let mut in_str: Option<char> = None;
    while i < b.len() {
        let c = b[i];
        if let Some(q) = in_str {
            out.push(c);
            if c == '\\' && i + 1 < b.len() {
                out.push(b[i + 1]);
                i += 2;
                continue;
            }
            if c == q {
                in_str = None;
            }
            i += 1;
            continue;
        }
        if c == '"' {
            in_str = Some(c);
            out.push(c);
            i += 1;
        } else if c == '/' && b.get(i + 1) == Some(&'/') {
            while i < b.len() && b[i] != '\n' {
                i += 1;
            }
        } else if c == '/' && b.get(i + 1) == Some(&'*') {
            i += 2;
            while i < b.len() && !(b[i] == '*' && b.get(i + 1) == Some(&'/')) {
                i += 1;
            }
            i += 2;
        } else if c == ',' {
            // A comma followed only by blanks and comments before `}` or `]` goes.
            let mut j = i + 1;
            loop {
                while j < b.len() && b[j].is_whitespace() {
                    j += 1;
                }
                if b.get(j) == Some(&'/') && b.get(j + 1) == Some(&'/') {
                    while j < b.len() && b[j] != '\n' { j += 1; }
                } else if b.get(j) == Some(&'/') && b.get(j + 1) == Some(&'*') {
                    j += 2;
                    while j < b.len() && !(b[j] == '*' && b.get(j + 1) == Some(&'/')) { j += 1; }
                    j += 2;
                } else {
                    break;
                }
            }
            if !matches!(b.get(j), Some('}') | Some(']')) {
                out.push(c);
            }
            i += 1;
        } else {
            out.push(c);
            i += 1;
        }
    }
    Ok(out)
}
