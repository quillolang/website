// Imports of files saved by old systems: a French menu in Windows-1252 and a Japanese price list in Shift_JIS.
//
//   quillo run text_encoding.qwe      then open http://localhost:8080/menu

use "text_encoding.qwer"

route GET /menu = { detected: charset_detect("text_encoding_sample.txt")?, lines: split(trim(charset_read("text_encoding_sample.txt", "auto")?), "\n") }

route GET /prices {
    let text = charset_read("text_encoding_sample.csv", "shift_jis")?
    let rows = split(trim(text), "\n") | map((l) => split(l, ","))
    drop(rows, 1) | map((r) => { item: r[0], yen: int(r[1]), note: r[2] })
}

// A UTF-8 copy for the rest of the app, and an export back to Windows-1252 for an old till.
route GET /convert = {
    copy: charset_to_utf8("text_encoding_sample.txt", "data/menu.utf8.txt", "auto")?,
    till: charset_write("data/till.txt", "Crème brûlée 4,50 € ✓", "windows-1252")?,
    back: charset_read("data/till.txt", "windows-1252")?,
}
