// A Swiss QR bill: the payload of the payment part, its code as an SVG with the Swiss cross, and
// what a bank's scanner refuses. The first bill is the example of SIX's Implementation Guidelines.
//
//   quillo run swiss_qr.qwe      then open http://localhost:8080/payload, /code.svg, /read and /refused

use "swiss_qr.qwer"

let BILL = {
    account: "CH44 3199 9123 0008 8901 2",
    creditor: { name: "Robert Schneider AG", street: "Rue du Lac", number: "1268", postcode: "2501", town: "Biel", country: "CH" },
    amount: "1949.75",
    currency: "CHF",
    debtor: { name: "Pia-Maria Rutschmann-Schnyder", street: "Grosse Marktgasse", number: "28", postcode: "9400", town: "Rorschach", country: "CH" },
    reference: "21 00000 00003 13947 14300 09017",
    message: "Order of 15 June 2020",
    billing_info: "//S1/10/10201409/11/200701/20/140.000-53",
}

route GET /payload = respond(200, swiss_qr_build(BILL)?, { "content-type": "text/plain; charset=utf-8" })

route GET /code.svg = respond(200, swiss_qr_svg(swiss_qr_build(BILL)?)?, { "content-type": "image/svg+xml" })

route GET /read {
    let b = swiss_qr_parse(swiss_qr_build(BILL)?)?
    { kind: b.reference_type, reference: b.reference, qr_iban: b.qr_iban, amount: b.amount, town: b.creditor.town, debtor: b.debtor.name, info: b.billing_info }
}

// An ordinary IBAN with a SCOR reference, and with none.
let ORDINARY = merge(BILL, { account: "CH58 0079 1123 0008 8901 2", amount: null, debtor: null })

route GET /scor {
    let scor = swiss_qr_parse(swiss_qr_build(merge(ORDINARY, { reference: "RF18 5390 0754 7034" }))?)?
    let none = swiss_qr_parse(swiss_qr_build(merge(ORDINARY, { reference: null }))?)?
    { scor: scor.reference_type, none: none.reference_type, amount: none.amount, debtor: none.debtor }
}

route GET /references = {
    made: swiss_qr_qrr("2100000000031394714300090")?,
    rf: swiss_qr_scor("539007547034")?,
    wrong_digit: swiss_qr_qrr_problem("210000000003139471430009018"),
    good: swiss_qr_qrr_problem("210000000003139471430009017"),
    qr_iban: swiss_qr_is_qr_iban("CH44 3199 9123 0008 8901 2"),
    ordinary: swiss_qr_is_qr_iban("CH58 0079 1123 0008 8901 2"),
}

route GET /refused = {
    non_with_qr: swiss_qr_build(merge(BILL, { reference: null })).error,
    qrr_ordinary: swiss_qr_build(merge(ORDINARY, { reference: "210000000003139471430009017" })).error,
    scor_qr: swiss_qr_build(merge(BILL, { reference: "RF18539007547034" })).error,
    digit: swiss_qr_build(merge(BILL, { reference: "210000000003139471430009018" })).error,
    currency: swiss_qr_build(merge(BILL, { currency: "USD" })).error,
    country: swiss_qr_build(merge(BILL, { account: "DE89370400440532013000" })).error,
    moved: swiss_qr_parse(replace(swiss_qr_build(BILL)?, "EPD", "XXX")).error,
}
