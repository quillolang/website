// A shop's French catalog: read, looked up with plural forms, compiled to .mo and read back, what
// it is missing, a template merged in, and mistakes found by line.
//
//   quillo run gettext_po.qwe      then open http://localhost:8080/catalog, /say, /plurals, /mo, /status, /merge and /broken

use "gettext_po.qwer"

let PO = read_file("gettext_po_sample.po")

route GET /catalog {
    let c = gettext_po_parse(PO)?
    {
        language: c.headers.Language, plural_forms: c.headers["Plural-Forms"], count: len(c.entries),
        first: c.entries[0],
        contexts: c.entries | filter((e) => e.id == "Open") | map((e) => [e.context, e.strings[0]]),
        long: c.entries[4].strings[0],
        fuzzy: c.entries[5],
        old: c.entries[8],
    }
}

route GET /say = {
    welcome: gettext_po_translate(PO, "Welcome", null, "")?,
    one: gettext_po_translate(PO, "%d item", 1, "")?,
    zero: gettext_po_translate(PO, "%d item", 0, "")?,
    five: gettext_po_translate(PO, "%d item", 5, "")?,
    verb: gettext_po_translate(PO, "Open", null, "verb")?,
    adjective: gettext_po_translate(PO, "Open", null, "adjective")?,
    fuzzy_falls_back: gettext_po_translate(PO, "Pay today", null, "")?,
    missing: gettext_po_translate(PO, "Nothing like this", null, "")?,
    partly_done: gettext_po_translate(PO, "%d order", 3, "")?,
}

let RU = "nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);"
let AR = "nplurals=6; plural=n==0 ? 0 : n==1 ? 1 : n==2 ? 2 : n%100>=3 && n%100<=10 ? 3 : n%100>=11 ? 4 : 5;"

route GET /plurals = {
    russian: [1, 2, 5, 11, 21, 22, 25, 101, 111] | map((n) => gettext_po_plural(RU, n)?),
    arabic: [0, 1, 2, 3, 11, 100, 102] | map((n) => gettext_po_plural(AR, n)?),
    japanese: gettext_po_plural("nplurals=1; plural=0;", 7)?,
    wrong: gettext_po_plural("nplurals=2; plural=n+1;", 5).error,
    bad: gettext_po_plural("nplurals=2; plural=(n>1;", 5).error,
    zero: gettext_po_plural("nplurals=2; plural=n/0;", 5).error,
}

route GET /mo {
    let compiled = gettext_po_compile(PO, ".quillo/shop.mo")?
    let m = gettext_po_read_mo(".quillo/shop.mo")?
    {
        compiled: compiled, language: m.headers.Language,
        ids: m.messages | map((x) => x.id),
        plural: find(m.messages, (x) => x.id == "%d item"),
        context: find(m.messages, (x) => x.context == "verb"),
        wrong_forms: gettext_po_compile(replace(PO, "nplurals=2; plural=(n > 1)", "nplurals=3; plural=n"), ".quillo/shop2.mo").error,
        not_mo: gettext_po_read_mo("gettext_po.qwe").error,
    }
}

route GET /status = gettext_po_status(PO)?

route GET /merge {
    let pot = "msgid \"Welcome\"\nmsgstr \"\"\n\n#: src/new.qwe:1\nmsgid \"Brand new\"\nmsgstr \"\"\n"
    let merged = gettext_po_merge(PO, pot)?
    let c = gettext_po_parse(merged)?
    {
        kept: c.entries[0].strings, new_one: c.entries[1], obsoleted: len(c.entries | filter((e) => e.obsolete)),
        lang_kept: c.headers.Language,
    }
}

// Read and written back, the catalog means the same.
route GET /roundtrip {
    let c = gettext_po_parse(PO)?
    let again = gettext_po_parse(gettext_po_write(c)?)?
    let lines = split(gettext_po_write(c)?, "\n")
    {
        same: json.stringify(c.entries | map((e) => [e.id, e.strings, e.fuzzy, e.obsolete, e.context])) == json.stringify(again.entries | map((e) => [e.id, e.strings, e.fuzzy, e.obsolete, e.context])),
        header_kept: again.headers["Plural-Forms"],
        obsolete_last: lines[len(lines) - 3],
    }
}

route GET /broken = {
    twice: gettext_po_parse("msgid \"a\"\nmsgstr \"1\"\n\nmsgid \"a\"\nmsgstr \"2\"\n").error,
    no_str: gettext_po_parse("msgid \"a\"\n").error,
    unquoted: gettext_po_parse("msgid a\nmsgstr \"\"\n").error,
    escape: gettext_po_parse("msgid \"a\\q\"\nmsgstr \"\"\n").error,
    keyword: gettext_po_parse("msgid \"a\"\nmsgstr \"b\"\n\nmsgfoo \"x\"\n").error,
}
