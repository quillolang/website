// A checkout's country select with flags and phone prefixes, and an address check.
//
//   quillo run countries.qwe      then open http://localhost:8080/country?q=Deutschland

use "countries.qwer"

route GET /country ? { q: str } = country(q)?

route GET /select = <html>
    <body>
        <select name="country">{country_list() | map((c) => <option value={c.alpha2}>{`${c.flag} ${c.name} (${c.calling_code})`}</option>)}</select>
    </body>
</html>

route GET /codes = {
    count: len(country_list()),
    plus44: country_by_calling_code("+44"),
    flag: country_flag("jp"),
    valid: [country_valid("DE"), country_valid("DEU"), country_valid("XX")],
    numeric: country("840")?.name,
}
