// A bookshop's catalog import: ISBNs from a supplier's list checked, hyphenated for the product
// page, and their language group shown.
//
//   quillo run isbn.qwe      then open http://localhost:8080/book/9780306406157 and http://localhost:8080/import

use "isbn.qwer"

route GET /book/:isbn {
    let b = isbn_parse(isbn)
    if !b.valid { reply 422 b.error }
    b
}

let SUPPLIER = "Order 2026-118: ISBN 0-306-40615-2 x3; 978-3-16-148410-0 x1; 9789712726309 (Filipino novel); 978-0-306-40615-8 (typo); 979-10-90636-07-1"

route GET /import = {
    found: isbn_find(SUPPLIER),
    pages: isbn_find(SUPPLIER) | map((i) => isbn_hyphenate(i, false)?),
    groups: isbn_find(SUPPLIER) | map((i) => isbn_parse(i).group_name),
    ten: isbn_hyphenate("9780306406157", true)?,
    no_ten: isbn_hyphenate("9791090636071", true).error,
    typo: isbn_parse("978-0-306-40615-8").error,
}
