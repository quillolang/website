// A magazine's CMS: what writers type with a keyboard, set as it would be printed, in English, French and German, in text and in HTML.
//
//   quillo run typography.qwe      then open http://localhost:8080/typography

use "typography.qwer"

fn show(s) = replace(replace(s, "\u{a0}", "~"), "\u{202f}", "_")

route GET /typography {
    {
        english: typography_text("\"It's the '90s -- or is it?\" she said... (c) 2026, 3 x 4 m", "en"),
        nested: typography_text("He said, \"Don't call it 'smart'.\"", "en"),
        french: show(typography_text("Il a dit : \"Bonjour !\" Vraiment ?", "fr")),
        german: typography_text("Sie sagte: \"Guten Tag\" -- und ging.", "de"),
        swiss: typography_text("\"Grüezi\"", "de-ch"),
        em_dash: typography_text("Wait---what?", "en"),
        html: typography_html("<p>\"Use <code>let x = \"y\"</code> here,\" she said. It's <em>\"fine\"</em>...</p>", "en"),
        widows: show(typography_widows("<h1>A headline that could leave one word alone</h1><p>And a paragraph with an ending.</p>")),
        czech: show(typography_text("Byl v Praze a u nás.", "cs")),
    }
}
