// Bluesky: a post with a link, a mention and a tag in a text with emoji before them, so the byte
// offsets matter; a reply, an image, a feed read page by page, and a token that expires and renews.
//
//   BLUESKY_HANDLE=you.bsky.social BLUESKY_APP_PASSWORD=... quillo run bluesky.qwe
//   then open http://localhost:8080/facets, /post, /image, /feed, /renew and /failures
//
// Make the app password in Settings > Privacy and Security. BLUESKY_API_URL picks another PDS.

use "bluesky.qwer"

fn sign_in() { bluesky_login(env("BLUESKY_HANDLE", ""), env("BLUESKY_APP_PASSWORD", ""), {}) }

route GET /facets {
    let text = "✨ café @ada.bsky.social see https://example.com/a?b=1. And example.org/x #quillo #123"
    { facets: bluesky_facets(text, {})?, unknown: bluesky_facets("hi @nobody.example", {})? }
}

route GET /post {
    let s = sign_in()?
    let first = bluesky_post(s, "✨ Hello @ada.bsky.social, see https://example.com #quillo", { langs: ["en"] })?
    let parent = { uri: first.uri, cid: first.cid }
    let second = bluesky_post(s, "And a reply", { reply: { root: parent, parent: parent } })?
    { url: first.url, replied: second.uri != first.uri, gone: bluesky_delete(s, second.uri, {})? }
}

route GET /image {
    let s = sign_in()?
    write_file("data/bluesky-demo.png", "not really a png")
    let embed = bluesky_image(s, "data/bluesky-demo.png", "A chart", {})?
    let post = bluesky_post(s, "With a picture", { embed: embed })?
    { blob: embed.images[0].image.ref["$link"], alt: embed.images[0].alt, posted: post.cid != null }
}

route GET /feed {
    let s = sign_in()?
    let one = bluesky_timeline(s, { limit: 2 })?
    let two = bluesky_timeline(s, { limit: 2, cursor: one.cursor })?
    let ada = bluesky_author_feed(s, "ada.bsky.social", { filter: "posts_no_replies" })?
    {
        first: map(one.posts, (p) => p.text),
        by: one.posts[0].author,
        reposted_by: one.posts[1].reposted_by,
        second: map(two.posts, (p) => p.text),
        end: two.cursor,
        ada: len(ada.posts),
    }
}

// The stand-in's first token runs out at once: the next call refreshes and goes on.
route GET /renew {
    let s = sign_in()?
    { posted: bluesky_post(s, "after renewal", { facets: [] })?.cid != null }
}

route GET /failures {
    let s = sign_in()?
    {
        wrong: bluesky_login("nobody.example", "wrong", {}).error,
        too_long: bluesky_post(s, repeat("x", 301), {}).error,
        emoji_fit: bluesky_post(s, repeat("👩‍👩‍👧", 120), {})?.cid != null,
        not_uri: bluesky_delete(s, "https://bsky.app/x", {}).error,
        retried: bluesky_post(s, "rate me", {})?.cid != null,
        bad_record: bluesky_post(s, "invalid record", {}).error,
    }
}
