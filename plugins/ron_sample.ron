// A game's settings, as Rust writes them with serde and ron.
#![enable(implicit_some)]
GameConfig(
    title: "Sky Harbor",
    window: (
        mode: Fullscreen,
        size: (1920, 1080),
        vsync: true,
        scale: 1.25,
    ),
    audio: (master: 0.8, music: Some(0.5), voice: None),
    /* key bindings: a map */
    keys: {
        "jump": 'W',
        "fire": 'F',
    },
    spawn: [
        Ship(name: "Kestrel", hull: 120),
        Drone(3),
        Asteroid,
    ],
    seed: 0xC0FFEE,
    tagline: r#"Fly "far", land soft"#,
)
