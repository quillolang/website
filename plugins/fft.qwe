// A guitar tuner's back end and a vibration check: samples in, frequencies out.
// (Here the signals are made up: an A string at 110 Hz with its overtone, and a fan running at 25 Hz.)
//
//   quillo run fft.qwe      then open http://localhost:8080/tuner

use "fft.qwer"

fn tone(freqs, rate, n) = range(n) | map((i) => sum(freqs | map((f) => f[1] * math.sin(2.0 * math.pi * f[0] * i / rate))))

route GET /tuner {
    let samples = tone([[110.0, 0.8], [220.0, 0.3]], 8000.0, 4096)
    let p = fft_peaks(samples, 8000.0, 2)?
    { note_hz: round(p[0].frequency, 0), overtone_hz: round(p[1].frequency, 0), level: fft_level(samples)? }
}

route GET /fan {
    let samples = tone([[25.0, 1.0]], 1000.0, 1000)
    fft_spectrum(samples, 1000.0, false, 3)?
}
