// A big picture cut into tiles for a zoomable viewer, a 3×3 grid for social posts, and a contact sheet of them.
//
//   quillo run image_tiles.qwe      then open http://localhost:8080/tiles

use "image_tiles.qwer"

route GET /tiles {
    let tiles = image_tiles_cut("image_tiles_sample.jpg", "data/tiles/zoom", 200, 200, "jpg")?
    let grid = image_tiles_grid("image_tiles_sample.jpg", "data/tiles/grid", 3, 3)?
    { tiles: len(tiles), last: last(tiles), grid, sheet: image_tiles_sheet(grid, "data/tiles/sheet.jpg", 3, 120)? }
}

route GET /sheet.jpg {
    image_tiles_sheet(image_tiles_grid("image_tiles_sample.jpg", "data/tiles/grid", 3, 3)?, "data/tiles/sheet.jpg", 3, 120)?
    file("data/tiles/sheet.jpg")
}
