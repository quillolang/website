// Printing PDFs straight to an office printer, no driver: a packing slip wrapped in PJL
// (two copies, duplex, tray 2, held until the PIN is typed at the printer), and the printer's
// state asked before sending, told in words.
//
//   quillo run pjl.qwe      then open http://localhost:8080/job
//   PRINTER_HOST=192.168.1.71 quillo run pjl.qwe      and http://localhost:8080/print

use "pjl.qwer"

let OPTIONS = { name: "Packing slip PS-2210", user: "dispatch", copies: 2, duplex: "long", paper: "a4", tray: "tray2", pin: "4821" }

route GET /job = respond(200, pjl_job("pjl_sample.pdf", OPTIONS)?, { "content-type": "text/plain" })

route GET /codes = {
    ready: pjl_parse_status("@PJL INFO STATUS\r\nCODE=10001\r\nDISPLAY=\"Ready\"\r\nONLINE=TRUE\r\n")?,
    no_paper: pjl_parse_status("@PJL INFO STATUS\r\nCODE=41204\r\nDISPLAY=\"Load tray 2 A4\"\r\nONLINE=TRUE\r\n")?,
    door: pjl_parse_status("CODE=40021\r\nDISPLAY=\"Close front door\"\r\nONLINE=FALSE")?,
    saved: pjl_write("pjl_sample.pdf", { copies: 1 }, "data/slip.prn")?,
}

route GET /print {
    let host = env("PRINTER_HOST", null) ?? reply 503 "set PRINTER_HOST to the printer's address (host or host:port)"
    let status = pjl_status(host, 3000)?
    if !status.ready { reply 409 { error: `the printer says: ${status.meaning}`, status: status } }
    { status: status, sent: pjl_print("pjl_sample.pdf", OPTIONS, host, 10000)? }
}
