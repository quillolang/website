// An album page made of a holiday's photos: a square grid for social posts, and justified rows for the website.
//
//   quillo run collage.qwe      then open http://localhost:8080/grid.jpg

use "collage.qwer"

// Five "photos" of different shapes, cut from one picture with Quillo's own image.convert.
fn photos() = for c in [{ x: 0, y: 0, w: 300, h: 200 }, { x: 300, y: 0, w: 300, h: 400 }, { x: 0, y: 200, w: 300, h: 200 }, { x: 100, y: 50, w: 400, h: 200 }, { x: 200, y: 100, w: 200, h: 200 }] => {
    let path = `data/album/${c.x}-${c.y}-${c.w}.jpg`
    image.convert("collage_sample.jpg", path, { crop: c, format: "jpeg", quality: 85 })?
    path
}

route GET /grid.jpg {
    collage_grid(photos(), "data/album/grid.jpg", 3, 900, 1.0, { gap: 10 })?
    file("data/album/grid.jpg")
}

route GET /rows.jpg {
    collage_rows(photos(), "data/album/rows.jpg", 900, 220, { gap: 6, background: "#1b1630" })?
    file("data/album/rows.jpg")
}

route GET /made = {
    grid: collage_grid(photos(), "data/album/grid.jpg", 3, 900, 1.0, { gap: 10 })?,
    contain: collage_grid(photos(), "data/album/contain.png", 2, 600, 1.5, { fit: "contain", background: "#00000000" })?,
    rows: collage_rows(photos(), "data/album/rows.jpg", 900, 220, { gap: 6 })?,
}
