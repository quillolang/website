// A travel, kitchen and workshop helper: speeds, temperatures, fuel economy, recipe measures and
// file sizes converted; heights and times read as people write them; values shown in their most
// readable unit for metric and US readers.
//
//   quillo run units.qwe      then open http://localhost:8080/convert and http://localhost:8080/best

use "units.qwer"

route GET /convert = {
    speed: units_convert(100.0, "km/h", "mph")?,
    oven: units_convert(350.0, "°F", "°C")?,
    economy: units_convert(6.5, "L/100km", "mpg")?,
    butter: units_convert(1.0, "cup", "mL")?,
    disk: units_convert(1.0, "GiB", "MB")?,
    torque: units_convert(100.0, "N*m", "lbf*ft")?,
    pressure: units_convert(32.0, "psi", "bar")?,
    height: units_parse("5 ft 11 in", "cm", 4)?,
    run: units_parse("1 h 32 min 10 s", "min", 5)?,
    wrong: units_convert(1.0, "kg", "m").error,
}

route GET /best = {
    tiny: units_best(0.0023, "km", "metric")?.text,
    file: units_best(3000000.0, "B", "metric")?.text,
    binary: units_best(3000000.0, "B", "binary")?.text,
    milk: units_best(2.0, "L", "us")?.text,
    talk: units_best(5400.0, "s", "metric")?.text,
    what: units_describe("kWh")?,
}
