//! Placeholder images as SVG: a box of any size with its dimensions or your text written in it, in your colours, as markup or a data: URL for an `<img>`.
//! version: 1.0.0
//!
//! [dependencies]

use serde_json::Value;

fn esc(s: &str) -> String {
    s.replace('&', "&amp;").replace('<', "&lt;").replace('>', "&gt;").replace('"', "&quot;")
}

// A colour given as "#rgb", "#rrggbb" or a plain CSS name; anything else falls back.
fn colour(v: Option<&Value>, fallback: &str) -> String {
    match v.and_then(Value::as_str) {
        Some(c) if (c.starts_with('#') && [4, 5, 7, 9].contains(&c.len()) && c[1..].chars().all(|x| x.is_ascii_hexdigit())) || (!c.is_empty() && c.len() <= 20 && c.chars().all(|x| x.is_ascii_alphabetic())) => c.to_string(),
        _ => fallback.to_string(),
    }
}

/// A placeholder `width` by `height` pixels (1 to 10,000) as SVG. `options` (or null): `background` ("#e2e8f0"), `color` of the text ("#64748b"),
/// `text` (the size, "800 × 600", when left out; "" for none), and `border` true for a dashed outline.
pub fn placeholder_svg(width: i64, height: i64, options: serde_json::Value) -> String {
    let (w, h) = (width.clamp(1, 10_000), height.clamp(1, 10_000));
    let bg = colour(options.get("background"), "#e2e8f0");
    let fg = colour(options.get("color"), "#64748b");
    let text = options.get("text").and_then(Value::as_str).map(str::to_string).unwrap_or_else(|| format!("{} × {}", w, h));
    // The text fills about two thirds of the width, and never more than a third of the height.
    let chars = text.chars().count().max(1) as f64;
    let size = ((w as f64 * 0.66 / (chars * 0.6)).min(h as f64 / 3.0)).max(6.0).round();
    let border = if options.get("border").and_then(Value::as_bool) == Some(true) {
        format!(r#"<rect x="1" y="1" width="{}" height="{}" fill="none" stroke="{}" stroke-width="2" stroke-dasharray="8 6"/>"#, (w - 2).max(0), (h - 2).max(0), fg)
    } else {
        String::new()
    };
    let label = if text.is_empty() { String::new() } else {
        format!(r#"<text x="50%" y="50%" dominant-baseline="central" text-anchor="middle" font-family="system-ui, -apple-system, Segoe UI, Roboto, sans-serif" font-size="{}" fill="{}">{}</text>"#, size, fg, esc(&text))
    };
    format!(r#"<svg xmlns="http://www.w3.org/2000/svg" width="{w}" height="{h}" viewBox="0 0 {w} {h}"><rect width="{w}" height="{h}" fill="{bg}"/>{border}{label}</svg>"#)
}

/// The same placeholder as a data: URL, for `<img src=...>` or CSS `background-image` with no request to make.
pub fn placeholder_data_url(width: i64, height: i64, options: serde_json::Value) -> String {
    let svg = placeholder_svg(width, height, options);
    let mut out = String::from("data:image/svg+xml,");
    for b in svg.bytes() {
        match b {
            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b' ' | b'-' | b'_' | b'.' | b'=' | b':' | b'/' | b',' | b';' | b'(' | b')' => out.push(b as char),
            _ => out += &format!("%{:02X}", b),
        }
    }
    out
}
