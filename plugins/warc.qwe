// A web crawl's archive: what it holds, a page taken out by offset, a CDX index for a replay tool,
// digests checked, and a small archive written by a program.
//
//   WARC_OUT=/tmp/crawl.warc.gz quillo run warc.qwe      then open http://localhost:8080/list, /plain, /page, /cdx, /verify, /surt, /write and /broken

use "warc.qwer"

let FILE = "warc_sample.warc.gz"
let OUT = env("WARC_OUT", "/tmp/warc-demo.warc.gz")

route GET /list = warc_read(FILE, 0)? | map((r) => [r.offset > 0, r.type, r.target_uri, r.http?.status, r.content_length])

route GET /first {
    let r = warc_read(FILE, 3)?[2]
    { id: r.id, date: r.date, gz: r.gzipped, version: r.version, http: r.http, digests: r.digests, count: len(warc_read(FILE, 3)?) }
}

route GET /plain {
    let a = warc_read("warc_sample.warc", 0)?
    let b = warc_read(FILE, 0)?
    { same: (a | map((r) => r.id)) == (b | map((r) => r.id)), offsets: slice(a | map((r) => r.gzipped), 0, 2), body: warc_get("warc_sample.warc", a[2].offset)?.body }
}

route GET /page {
    let list = warc_read(FILE, 0)?
    {
        html: warc_get(FILE, list[2].offset)?.body,
        gzipped: slice(warc_get(FILE, list[4].offset)?.body, 0, 13),
        chunked: warc_get(FILE, list[5].offset)?.body,
        binary: warc_get(FILE, list[6].offset)?.body_base64,
        info: warc_get(FILE, list[0].offset)?.body,
    }
}

route GET /cdx = warc_cdx("warc_sample.warc", "cdx11")?
route GET /cdxj = warc_cdx(FILE, "cdxj")?[0]

route GET /verify = warc_verify(FILE)?

route GET /surt = [
    warc_surt("https://www.Example.org/")?, warc_surt("http://example.org:8080/A/b/?z=1&a=2#frag")?,
    warc_surt("http://www2.example.co.uk/x")?, warc_surt("https://example.org:443/")?, warc_surt("http://192.0.2.1/a")?,
    warc_surt("example.org").error,
]

route GET /write {
    let placed = warc_write(OUT, [
        { type: "warcinfo", date: "2026-11-01T10:00:00Z", fields: { software: "quillo", format: "WARC File Format 1.1" } },
        { type: "response", target_uri: "https://shop.example/a", date: "2026-11-01T10:00:01Z", http: { status: 404, reason: "Not Found", headers: { "content-type": "text/plain" }, body: "nothing here — sorry" } },
        { type: "resource", target_uri: "https://shop.example/b.txt", date: "2026-11-01T10:00:02Z", content_type: "text/plain", body: "plain" },
    ], true)?
    let back = warc_read(OUT, 0)?
    {
        back: back | map((r) => [r.type, r.http?.status, r.digests.block, r.digests.payload]),
        where: (back | map((r) => r.offset)) == (placed | map((p) => p.offset)),
        linked: back[1].headers["WARC-Warcinfo-ID"] == `<${placed[0].id}>`,
        body: warc_get(OUT, placed[1].offset)?.body,
        again: warc_verify(OUT)?.bad,
        cdx: split(warc_cdx(OUT, "cdx11")?[1], " ")[1],
        no_uri: warc_write(OUT, [{ type: "response", body: "x" }], true).error,
        bad_type: warc_write(OUT, [{ type: "webpage", target_uri: "http://a/" }], true).error,
        split: warc_write(OUT, [{ target_uri: "http://a/", http: { headers: { a: "b\r\nc: d" } } }], true).error,
    }
}

route GET /broken = {
    not_warc: warc_read("warc.qwe", 0).error,
    missing: warc_read("nothing.warc", 0).error != null,
    bad_offset: warc_get(FILE, 99999999).error,
    bad_format: warc_cdx(FILE, "json").error,
    middle: warc_get(FILE, 3).error != null,
}
