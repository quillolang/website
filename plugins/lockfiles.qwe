// What a project depends on, whichever package manager locked it: each kind of lock file read into
// one list, duplicates and packages from outside a registry noticed, and what a change brought in.
//
//   quillo run lockfiles.qwe      then open http://localhost:8080/cargo, /npm, /npm-old, /yarn, /pnpm, /poetry, /go, /summary, /diff and /broken

use "lockfiles.qwer"

fn brief(list) { list | map((p) => `${p.name} ${p.version} [${p.kind}]${p.dev ? " dev" : ""}`) }
fn sample(name) { read_file(`lockfiles_sample_${name}`) }

route GET /cargo {
    let l = lockfiles_read_file("lockfiles_sample_Cargo.lock")?
    { list: brief(l), source: l[3].source, checksum: l[2].integrity }
}

route GET /npm = brief(lockfiles_read("package-lock.json", sample("package-lock.json"))?)
route GET /npm-old = brief(lockfiles_read("package-lock.json", sample("v1-package-lock.json"))?)

route GET /yarn = {
    classic: brief(lockfiles_read("yarn.lock", sample("yarn.lock"))?),
    integrity: lockfiles_read("yarn.lock", sample("yarn.lock"))?[0].integrity,
    berry: brief(lockfiles_read("yarn.lock", sample("berry-yarn.lock"))?),
}

route GET /pnpm = {
    v9: brief(lockfiles_read("pnpm-lock.yaml", sample("pnpm-lock.yaml"))?),
    v5: brief(lockfiles_read("pnpm-lock.yaml", sample("v5-pnpm-lock.yaml"))?),
}

route GET /poetry = brief(lockfiles_read("poetry.lock", sample("poetry.lock"))?)

route GET /go {
    let l = lockfiles_read("go.sum", sample("go.sum"))?
    l | map((p) => [p.name, p.version, p.go_mod_only])
}

route GET /summary = {
    cargo: lockfiles_summary(lockfiles_read("Cargo.lock", sample("Cargo.lock"))?),
    npm: lockfiles_summary(lockfiles_read("package-lock.json", sample("package-lock.json"))?),
}

route GET /diff {
    let before = lockfiles_read("package-lock.json", sample("v1-package-lock.json"))?
    let after = lockfiles_read("package-lock.json", sample("package-lock.json"))?
    lockfiles_diff(before, after)
}

route GET /broken = {
    kinds: [
        lockfiles_detect("x", sample("Cargo.lock"))?, lockfiles_detect("x", sample("package-lock.json"))?, lockfiles_detect("x", sample("yarn.lock"))?,
        lockfiles_detect("x", sample("pnpm-lock.yaml"))?, lockfiles_detect("x", sample("poetry.lock"))?, lockfiles_detect("x", sample("go.sum"))?,
    ],
    unknown: lockfiles_detect("x", "hello").error,
    bad_toml: lockfiles_read("Cargo.lock", "[[").error != null,
    no_tables: lockfiles_read("package-lock.json", "{}").error,
    bad_go: lockfiles_read("go.sum", "a b c\n").error,
    no_file: lockfiles_read_file("nothing.lock").error,
}
