// Reads a sitemap and an order in XML.
//
//   quillo run xml.qwe      then open http://localhost:8080/urls

use "xml.qwer"

let sitemap = `<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>https://quillolang.org/</loc></url>
  <url><loc>https://quillolang.org/docs/</loc><lastmod>2026-10-29</lastmod></url>
</urlset>`

route GET /urls = xml_texts(sitemap, "loc")?
route GET /order = xml_parse(`<order id="42"><item sku="A1" qty="2">Pen</item><item sku="B7" qty="1">Ink</item></order>`)?
