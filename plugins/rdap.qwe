// Who holds a name, a network or an AS, by RDAP: IANA's bootstrap files find the server, the
// registry's record is flattened to plain fields, the registrar's record is followed for the
// parts the registry leaves out, and a name nobody holds, a rate limit and a server's error each
// come back as what they are.
//
//   quillo run rdap.qwe      then open http://localhost:8080/domain/example.com
//
// RDAP_BOOTSTRAP_URL replaces data.iana.org, for a local copy of the bootstrap files.

use "rdap.qwer"

let FAST = { timeout_ms: 3000 }

route GET /domain/:name {
    let r = rdap_lookup(name, FAST)?
    if !r.found { return { found: false } }
    {
        name: r.name, status: r.status, registered: r.events.registration, expires: r.events.expiration,
        registrar: r.registrar, iana: r.registrar_iana_id, abuse: r.abuse_email, registrant: r.registrant,
        nameservers: r.nameservers, signed: r.dnssec, roles: r.entities | map((e) => e.roles[0]), followed: r.related != null,
    }
}

route GET /ip/:address {
    let r = rdap_lookup(address, FAST)?
    { name: r.name, range: [r.start, r.end], cidrs: r.cidrs, country: r.country, version: r.version, parent: r.parent, abuse: r.abuse_email }
}

route GET /as/:number {
    let r = rdap_lookup(number, FAST)?
    { name: r.name, numbers: [r.start, r.end], country: r.country, entity: r.entities[0].org }
}

route GET /server = {
    com: rdap_server("example.com", FAST)?,
    second_level: rdap_server("example.co.uk", FAST)?,
    plain_uk: rdap_server("example.uk", FAST)?,
    upper: rdap_server("EXAMPLE.COM.", FAST)?,
    idn: rdap_server("bücher.com", FAST)?,
    v4: rdap_server("8.8.8.8", FAST)?,
    longest: rdap_server("41.1.2.3", FAST)?,
    v6: rdap_server("2001:4860:4860::8888", FAST)?,
    asn: rdap_server("AS15169", FAST)?,
    bare_asn: rdap_server("3333", FAST)?,
}

route GET /failures = {
    free: rdap_lookup("nobody-has-this.com", FAST)?,
    unlisted_tld: rdap_lookup("example.nosuchtld", FAST).error,
    private_ip: rdap_lookup("10.0.0.1", FAST).error,
    private_asn: rdap_lookup("AS64512", FAST).error,
    bad_prefix: rdap_lookup("8.8.8.8/99", FAST).error,
    refused: rdap_lookup("refused.com", FAST).error,
    broken: rdap_lookup("broken.com", FAST).error,
    no_retry_budget: rdap_lookup("limited.com", { ...FAST, max_wait_ms: 100 }).error,
}

// A 429 with Retry-After: 1 is waited out; the registrar's server being down loses only its part.
route GET /patience = {
    waited: rdap_lookup("busy.com", FAST)?.name,
    half: rdap_lookup("half.com", FAST)?.related_failed,
    direct: rdap_raw(env("RDAP_DIRECT", "https://rdap.org"), "domain/example.com", FAST)?.ldhName,
}
