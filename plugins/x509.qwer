//! Read X.509 certificates (PEM): subject, issuer, the names it covers, when it starts and ends, days left, fingerprint; for expiry alerts and checking what a partner sent.
//! version: 1.0.0
//!
//! [dependencies]
//! x509-parser = "0.16"
//! sha2 = "0.10"

use serde_json::{json, Value};
use sha2::{Digest, Sha256};
use x509_parser::extensions::GeneralName;
use x509_parser::pem::Pem;
use x509_parser::prelude::X509Certificate;

fn now() -> i64 {
    std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_secs() as i64)
}

/// Unix seconds as `2026-11-02T09:00:00Z`.
fn iso(t: i64) -> String {
    let (days, secs) = (t.div_euclid(86400), t.rem_euclid(86400));
    // Howard Hinnant's civil_from_days.
    let z = days + 719468;
    let era = z.div_euclid(146097);
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    let y = yoe + era * 400 + if m <= 2 { 1 } else { 0 };
    format!("{:04}-{:02}-{:02}T{:02}:{:02}:{:02}Z", y, m, d, secs / 3600, secs % 3600 / 60, secs % 60)
}

fn names(cert: &X509Certificate) -> Vec<String> {
    let mut out = vec![];
    if let Ok(Some(san)) = cert.subject_alternative_name() {
        for n in &san.value.general_names {
            match n {
                GeneralName::DNSName(s) => out.push(s.to_string()),
                GeneralName::RFC822Name(s) => out.push(format!("email:{}", s)),
                GeneralName::URI(s) => out.push(format!("uri:{}", s)),
                GeneralName::IPAddress(b) if b.len() == 4 => out.push(std::net::Ipv4Addr::new(b[0], b[1], b[2], b[3]).to_string()),
                GeneralName::IPAddress(b) if b.len() == 16 => {
                    let a: [u8; 16] = (*b).try_into().unwrap_or([0; 16]);
                    out.push(std::net::Ipv6Addr::from(a).to_string())
                }
                _ => {}
            }
        }
    }
    out
}

fn common_name(name: &x509_parser::x509::X509Name) -> Option<String> {
    name.iter_common_name().next().and_then(|cn| cn.as_str().ok()).map(str::to_string)
}

fn describe(der: &[u8], cert: &X509Certificate) -> Value {
    let v = cert.validity();
    let (start, end) = (v.not_before.timestamp(), v.not_after.timestamp());
    let fp: Vec<String> = Sha256::digest(der).iter().map(|b| format!("{:02X}", b)).collect();
    json!({
        "subject": cert.subject().to_string(),
        "common_name": common_name(cert.subject()),
        "issuer": cert.issuer().to_string(),
        "issuer_common_name": common_name(cert.issuer()),
        "names": names(cert),
        "not_before": iso(start),
        "not_after": iso(end),
        "days_left": (end - now()).div_euclid(86400),
        "valid_now": now() >= start && now() <= end,
        "self_signed": cert.subject().as_raw() == cert.issuer().as_raw(),
        "is_ca": cert.is_ca(),
        "serial": cert.raw_serial_as_string(),
        "sha256_fingerprint": fp.join(":"),
        "key_type": match cert.public_key().algorithm.algorithm.to_id_string().as_str() {
            "1.2.840.113549.1.1.1" => "RSA".to_string(),
            "1.2.840.10045.2.1" => "EC".to_string(),
            "1.3.101.112" => "Ed25519".to_string(),
            other => other.to_string(),
        },
    })
}

fn each(pem_text: &str, max: usize) -> Result<Vec<Value>, String> {
    if pem_text.len() > 4_000_000 {
        return Err("PEM text is at most 4 MB".into());
    }
    let mut out = vec![];
    for pem in Pem::iter_from_buffer(pem_text.as_bytes()).take(max) {
        let pem = pem.map_err(|e| format!("not PEM: {}", e))?;
        if pem.label != "CERTIFICATE" {
            continue;
        }
        let cert = pem.parse_x509().map_err(|e| format!("not a certificate: {}", e))?;
        out.push(describe(&pem.contents, &cert));
    }
    if out.is_empty() {
        return Err("no `-----BEGIN CERTIFICATE-----` in the text".into());
    }
    Ok(out)
}

/// The first certificate in `pem`: `{ subject, common_name, issuer, issuer_common_name, names, not_before, not_after, days_left,
/// valid_now, self_signed, is_ca, serial, sha256_fingerprint, key_type }`. `names` are the subject alternative names (DNS names, IPs,
/// `email:` and `uri:` ones); times are UTC ISO 8601; `days_left` is negative once it has expired. Nothing checks who signed it.
pub fn x509_read(pem: &str) -> Result<Value, String> {
    Ok(each(pem, 1)?.remove(0))
}

/// Every certificate in `pem` (a chain, leaf first, or a CA bundle), each as x509_read gives it; at most 500.
pub fn x509_read_all(pem: &str) -> Result<Vec<Value>, String> {
    each(pem, 500)
}

/// Whether the first certificate names `host` among its DNS names or IPs, a `*.` wildcard covering one label (`*.example.com`
/// covers `www.example.com`, not `example.com` or `a.b.example.com`). Case does not matter.
pub fn x509_covers(pem: &str, host: &str) -> Result<bool, String> {
    let c = x509_read(pem)?;
    let host = host.trim().trim_end_matches('.').to_lowercase();
    Ok(c["names"].as_array().into_iter().flatten().filter_map(|n| n.as_str()).any(|n| {
        let n = n.to_lowercase();
        match n.strip_prefix("*.") {
            Some(rest) => host.split_once('.').is_some_and(|(first, tail)| !first.is_empty() && tail == rest),
            None => n == host,
        }
    }))
}
