// Passkeys for a site: registering, signing in, and everything a forged or copied answer gives.
// A browser and its authenticator normally stand on the other side; here a software authenticator
// plays them, making real keys and real signatures, reached through PASSKEY_AUTHENTICATOR_URL.
//
//   PASSKEY_AUTHENTICATOR_URL=http://127.0.0.1:9000 quillo run passkeys.qwe
//   then open http://localhost:8080/flow/es256, /flow/ed25519, /flow/rs256, /attested and /refused
//
// In a real page the options go to the browser and its answer comes back as JSON:
//   const o = PublicKeyCredential.parseCreationOptionsFromJSON(await (await fetch("/passkey/options")).json());
//   const c = await navigator.credentials.create({ publicKey: o });
//   await fetch("/passkey/register", { method: "POST", body: JSON.stringify(c.toJSON()) });
// Keep the challenge in the session, not in the page, and use it once.

use "passkeys.qwer"

let SITE = { id: "shop.example", name: "Example Shop" }
let ORIGIN = "https://shop.example"
let WANT = { origin: [ORIGIN, "https://www.shop.example"], rp_id: SITE.id }

fn device(path, body) {
    let r = http.post(env("PASSKEY_AUTHENTICATOR_URL", "") + path, body, { "content-type": "application/json" }, { public_only: false })?
    if r.status != 200 { return err(r.body) }
    r.json
}

// One user, one key: returns the credential to keep.
fn enrol(kind, attestation, extra) {
    let options = passkeys_register_options(SITE, { id: "user-1001", name: "ada@shop.example", display_name: "Ada" }, { attestation: attestation })?
    let answer = device("/create", merge({ options: options, origin: ORIGIN, kind: kind }, extra))?
    passkeys_register_verify(answer, merge(WANT, { challenge: options.challenge }))
}

fn sign_in(kept, extra, want) {
    let options = passkeys_signin_options(SITE.id, [kept.credential_id], {})?
    let answer = device("/get", merge({ options: options, origin: ORIGIN }, extra))?
    passkeys_signin_verify(answer, kept, merge(merge(WANT, { challenge: options.challenge }), want))
}

route GET /flow/:kind {
    let kept = enrol(kind, "none", {})?
    let first = sign_in(kept, {}, {})?
    let second = sign_in(merge(kept, { counter: first.counter }), {}, {})?
    {
        algorithm: kept.algorithm,
        attestation: kept.attestation,
        key: passkeys_key_info(kept.public_key)?,
        counters: [kept.counter, first.counter, second.counter],
        user_verified: first.user_verified,
        handle: first.user_handle,
    }
}

// Packed attestation: signed by the credential itself, and by a device certificate.
route GET /attested {
    let by_self = enrol("es256", "direct", { attest: "self" })?
    let by_ed = enrol("ed25519", "direct", { attest: "self" })?
    let by_cert = enrol("es256", "direct", { attest: "cert" })?
    {
        self: [by_self.attestation, by_ed.attestation],
        cert: by_cert.attestation,
        has_certificate: by_cert.certificate != null,
        wrong_self: enrol("es256", "direct", { attest: "self", break: "attestation" }).error,
        wrong_cert: enrol("es256", "direct", { attest: "cert", break: "attestation" }).error,
        other_format: enrol("es256", "direct", { attest: "tpm" }).error,
    }
}

route GET /refused {
    let kept = enrol("es256", "none", {})?
    let other = passkeys_register_options(SITE, { name: "x" }, {})?
    let answer = device("/create", { options: other, origin: ORIGIN, kind: "es256" })?
    let good = merge(WANT, { challenge: other.challenge })
    {
        challenge: passkeys_register_verify(answer, merge(WANT, { challenge: passkeys_challenge()? })).error,
        origin: passkeys_register_verify(answer, merge(good, { origin: "https://evil.example" })).error,
        rp_id: passkeys_register_verify(answer, merge(good, { rp_id: "other.example" })).error,
        kind: passkeys_signin_verify(answer, { credential_id: answer.id, public_key: "", counter: 0 }, good).error,
        no_verify: passkeys_register_verify(device("/create", { options: other, origin: ORIGIN, kind: "es256", uv: false })?, merge(good, { require_user_verification: true })).error,
        no_presence: passkeys_register_verify(device("/create", { options: other, origin: ORIGIN, kind: "es256", up: false })?, good).error,
        algorithm: passkeys_register_verify(device("/create", { options: other, origin: ORIGIN, kind: "ed25519" })?, merge(good, { algorithms: [-7] })).error,
        bad_signature: sign_in(kept, { break: "signature" }, {}).error,
        changed_data: sign_in(kept, { break: "client_data" }, {}).error,
        replayed_counter: sign_in(merge(kept, { counter: 100 }), {}, {}).error,
        wrong_user: sign_in(merge(kept, { user_handle: "bm90LXRoaXMtb25l" }), {}, {}).error,
        excluded: device("/create", { options: merge(other, { excludeCredentials: [{ type: "public-key", id: kept.credential_id }] }), origin: ORIGIN, kind: "es256" }).error,
        wrong_site: device("/create", { options: other, origin: "https://evil.example", kind: "es256" }).error,
    }
}
