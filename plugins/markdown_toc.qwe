// A documentation page with its table of contents beside it, and links that jump to each heading.
//
//   quillo run markdown_toc.qwe      then open http://localhost:8080/docs

use "markdown_toc.qwer"

let DOC = read_file("markdown_toc_sample.md")?

route GET /docs {
    let toc = toc_markdown(DOC, 2, 3)?
    respond(200, `<nav>${str(markdown(toc))}</nav><main>${toc_html(DOC)?}</main>`, { "content-type": "text/html; charset=utf-8" })
}

route GET /toc = { markdown: toc_markdown(DOC, 2, 3)?, headings: toc_headings(DOC)? | map((h) => `${h.level} ${h.anchor} (line ${h.line})`) }

route GET /tree = toc_tree(DOC)?
