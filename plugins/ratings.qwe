// A chess club and a five-a-side league: Elo after a game and each side's chance; Glicko-2 for a
// season with ratings' uncertainty (Glickman's own worked example); TrueSkill for 1-on-1 and
// team games; and the club's table from its results.
//
//   quillo run ratings.qwe      then open http://localhost:8080/ratings and http://localhost:8080/table

use "ratings.qwer"

route GET /ratings = {
    elo: rating_elo(1613.0, 1609.0, 0.0, 32.0)?,
    chance: rating_elo_chance(1800.0, 1600.0),
    glicko: rating_glicko2({ rating: 1500.0, rd: 200.0, volatility: 0.06 }, [{ rating: 1400.0, rd: 30.0, score: 1.0 }, { rating: 1550.0, rd: 100.0, score: 0.0 }, { rating: 1700.0, rd: 300.0, score: 0.0 }], 0.5)?,
    rested: rating_glicko2({ rating: 1720.0, rd: 60.0 }, [], 0.5)?,
    duel: rating_trueskill([{ mu: 25.0, sigma: 8.333333 }], [{ mu: 25.0, sigma: 8.333333 }], 0, {})?,
    teams: rating_trueskill([{ mu: 28.0, sigma: 4.0 }, { mu: 22.0, sigma: 6.0 }], [{ mu: 30.0, sigma: 3.0 }, { mu: 25.0, sigma: 8.0 }], -1, {})?,
}

let GAMES = [
    { a: "Ana", b: "Ben", score_a: 1.0 }, { a: "Cleo", b: "Dev", score_a: 0.5 }, { a: "Ana", b: "Cleo", score_a: 1.0 },
    { a: "Ben", b: "Dev", score_a: 0.0 }, { a: "Dev", b: "Ana", score_a: 0.5 }, { a: "Ben", b: "Cleo", score_a: 1.0 },
]

route GET /table = { elo: rating_table(GAMES, "elo", { k: 24.0 })?, glicko2: rating_table(GAMES, "glicko2", {})? }
