// Database keys that sort by time (v7), ids for imported rows that stay the same on every import (v5), and any UUID read back.
//
//   quillo run uuid_tools.qwe      then open http://localhost:8080/keys

use "uuid_tools.qwer"

route GET /keys {
    let a = uuid_v7()
    let b = uuid_v7()
    { a, b, sorted: a < b, made: uuid_parse(a)?.version, random: uuid_parse(uuid())?.version }
}

// The same customer email gives the same id on every import.
route GET /import = ["ada@example.com", "grace@example.com", "ada@example.com"] | map((e) => { email: e, id: uuid_v5("6ba7b811-9dad-11d1-80b4-00c04fd430c8", e)? })

route GET /read ? { id: str = "{CFBFF0D1-9375-5685-968C-48CE8B15AE17}" } = uuid_parse(id)?

route GET /known = { dns: uuid_v5("dns", "example.com")?, old: uuid_parse(uuid_v7_at(1767225600000)?)?.time_ms, valid: [uuid_valid("nope"), uuid_valid(uuid())] }
