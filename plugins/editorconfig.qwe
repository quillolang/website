// Code style from .editorconfig: the settings for a path, the glob language, and a file's text
// checked and fixed, as a pre-commit hook or a web editor would.
//
//   EDITORCONFIG_ROOT=~/some/repo quillo run editorconfig.qwe      then open http://localhost:8080/parse, /resolve, /globs, /nested, /check, /fix and /disk

use "editorconfig.qwer"

let TEXT = read_file("editorconfig_sample.ini")

route GET /parse = editorconfig_parse(TEXT)

route GET /resolve = {
    py: editorconfig_resolve(TEXT, "src/app.py"),
    js: editorconfig_resolve(TEXT, "web/a.js"),
    make: editorconfig_resolve(TEXT, "sub/Makefile"),
    md: editorconfig_resolve(TEXT, "README.md"),
    lib: editorconfig_resolve(TEXT, "lib/a/b.py").max_line_length,
    not_lib: editorconfig_resolve(TEXT, "src/lib/b.py").max_line_length,
    pkg: editorconfig_resolve(TEXT, "package.json").indent_size,
    range: editorconfig_resolve(TEXT, "test/2/a.txt").end_of_line,
    out_of_range: editorconfig_resolve(TEXT, "test/4/a.txt").end_of_line,
    custom: editorconfig_resolve(TEXT, "test/1/a.txt").my_plugin_key,
}

route GET /globs = [
    ["*.py", "a/b.py"], ["*.py", "b.pyc"], ["a/*.py", "a/b.py"], ["a/*.py", "a/c/b.py"], ["a/**.py", "a/c/b.py"], ["/a.py", "a.py"], ["/a.py", "b/a.py"],
    ["?.c", "a.c"], ["?.c", "ab.c"], ["[abc].c", "b.c"], ["[!abc].c", "b.c"], ["[a-c].c", "c.c"],
    ["{a,b}.c", "a.c"], ["{a,b}.c", "c.c"], ["{a,{b,c}}.c", "c.c"], ["{single}.c", "{single}.c"], ["{single}.c", "single.c"],
    ["{1..3}.c", "2.c"], ["{1..3}.c", "4.c"], ["{-2..2}.c", "-1.c"], ["{3..1}.c", "2.c"], ["{1..3}.c", "02.c"], ["a\\*.c", "a*.c"], ["a\\*.c", "ab.c"],
    ["{", "{"], ["[", "["],
] | map((g) => editorconfig_glob(g[0], g[1]))

route GET /nested {
    let files = {
        ".editorconfig": "[*]\nindent_size = 8\ncharset = latin1\n",
        "repo/.editorconfig": "root = true\n[*]\nindent_size = 4\nindent_style = tab\ntab_width = 8\n",
        "repo/web/.editorconfig": "[*.js]\nindent_size = 2\n[src/*.js]\nindent_size = unset\n",
    }
    {
        js: editorconfig_resolve_nested(files, "repo/web/a.js")?,
        inner: editorconfig_resolve_nested(files, "repo/web/src/b.js")?.properties,
        outside: editorconfig_resolve_nested(files, "other/c.js")?.properties,
        bad: editorconfig_resolve_nested({ "x.txt": "" }, "a").error,
    }
}

let RULES = { indent_style: "space", indent_size: "4", end_of_line: "lf", trim_trailing_whitespace: "true", insert_final_newline: "true", max_line_length: "20", charset: "utf-8" }

route GET /check = {
    bad: editorconfig_check("\u{feff}a\n   b  \n\tc\r\n      d\nthis line is too long, sure\nend", RULES) | map((p) => `${p.line} ${p.rule}: ${p.message}`),
    good: editorconfig_check("a\n    b\n        * c\n", RULES),
    tabs: editorconfig_check("\ta\n    b\n\t  c\n", { indent_style: "tab", indent_size: "4" }) | map((p) => [p.line, p.rule]),
    width: editorconfig_check("\t\tab\n", { max_line_length: "9", tab_width: "4" }),
}

route GET /fix {
    let fixed = editorconfig_fix("a  \r\nb\t\nc", RULES)
    {
        fixed: fixed, clean: editorconfig_check(fixed, RULES),
        crlf: editorconfig_fix("a\nb", { end_of_line: "crlf", insert_final_newline: "true" }),
        strip: editorconfig_fix("a\n\n", { insert_final_newline: "false" }),
        bom: editorconfig_fix("a", { charset: "utf-8-bom" }) == "\u{feff}a",
    }
}

route GET /disk {
    let root = env("EDITORCONFIG_ROOT", ".")
    let f = editorconfig_find(`${root}/src/deep/app.js`)?
    let c = editorconfig_check_file(`${root}/src/deep/app.js`)?
    { props: f.properties, configs: len(f.files), problems: c.problems | map((p) => [p.line, p.rule]), missing: editorconfig_check_file(`${root}/nothing`).error != null }
}
