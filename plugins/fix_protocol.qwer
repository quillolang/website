fn tag_name(t: u32) -> Option<&'static str> {
    TAGS.iter().find(|x| x.0 == t).map(|x| x.1)
}

fn tag_number(name: &str) -> Option<u32> {
    let n = name.trim();
    if let Ok(t) = n.parse::<u32>() {
        return Some(t);
    }
    TAGS.iter().find(|x| x.1.eq_ignore_ascii_case(n)).map(|x| x.0)
}

fn type_name(t: &str) -> &'static str {
    MSG_TYPES.iter().find(|x| x.0 == t).map_or("", |x| x.1)
}

fn type_code(t: &str) -> String {
    MSG_TYPES.iter().find(|x| x.1.eq_ignore_ascii_case(t)).map_or(t.to_string(), |x| x.0.to_string())
}

