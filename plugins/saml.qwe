// Sign-in with a company's identity provider by SAML 2.0: the IdP's metadata read, a visitor sent
// off with an AuthnRequest, and the answer they bring back checked in full. /wrapping sends the
// attacks that have broken real SAML libraries, each with a genuine signature, and shows them refused.
//
//   SAML_IDP_URL=https://idp.example.com quillo run saml.qwe
//   then open http://localhost:8080/metadata, /login, /signed-in, /attributes, /refused and /wrapping
//
// SAML_IDP_URL serves the IdP's metadata at /metadata. A real program keeps the IdP's certificate in
// its config, and its session holds the request id between /login and the ACS post. The test IdP
// here signs real responses, and hands them over as JSON rather than through a browser's form post.

use "saml.qwer"

let IDP = env("SAML_IDP_URL", "http://127.0.0.1:9000")
let SP = { entity_id: "https://shop.example.com/saml", acs_url: "https://shop.example.com/saml/acs", name_id_format: "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress" }

fn config() = { ...SP, idp: saml_idp_metadata(http.get(`${IDP}/metadata`).body)? }

// One round: ask for a sign-in, have the IdP answer that request.
fn signin(kind) {
    let c = config()
    let req = saml_authn_request(c, { relay_state: "/after-login" })?
    let got = http.get(`${IDP}/sso${slice(req.url, index_of(req.url, "?"), len(req.url))}&kind=${kind}`).json
    { c, req, got, read: saml_read_response(c, got.saml_response, { request_id: req.id }) }
}

route GET /metadata {
    let c = config()
    let mine = saml_metadata({ ...SP, sp_certificate: env("SAML_SP_CERT", "") })?
    {
        idp: c.idp.entity_id,
        sso: replace(c.idp.sso_redirect, IDP, ""),
        post: replace(c.idp.sso_post, IDP, ""),
        certs: len(c.idp.certificates),
        formats: len(c.idp.name_id_formats),
        idp_checks_mine: http.post(`${IDP}/check-metadata`, { xml: mine }).json,
        not_metadata: saml_idp_metadata("<a/>").error,
    }
}

route GET /login {
    let c = config()
    let req = saml_authn_request(c, { relay_state: "/after-login", force_authn: true })?
    let query = slice(req.url, index_of(req.url, "?"), len(req.url))
    let plain = http.get(`${IDP}/sso${query}&kind=plain`).json
    {
        id_ok: plain.request.id == req.id,
        issuer: plain.request.issuer,
        acs: plain.request.acs,
        force: plain.request.force_authn,
        relay: plain.relay_state,
        signed: req.signed,
        signature_good: plain.request.signature_good,
        long_relay: saml_authn_request(c, { relay_state: repeat("x", 81) }).error,
    }
}

route GET /signed-in {
    let round = signin("plain")
    let u = round.read?
    { name: u.name_id, format: u.name_id_format, session: u.session_index, issuer: u.issuer, audience: u.audience, by: u.signed, context: u.authn_context, in_response: u.in_response_to == round.req.id, replay: saml_read_response(round.c, round.got.saml_response, { request_id: round.req.id }).error != null }
}

route GET /attributes {
    let u = signin("plain").read?
    { email: u.attributes.email, groups: u.attributes.groups, by_oid: u.attributes["urn:oid:1.3.6.1.4.1.5923.1.1.1.7"], mail_friendly: u.attributes.mail }
}

// What real IdPs do differently from each other, all to be taken.
route GET /variants = {
    response_signed: signin("response-signed").read?.signed,
    both_signed: signin("both-signed").read?.signed,
    inclusive_prefixes: signin("inclusive").read?.name_id,
    ecdsa: signin("ecdsa").read?.signed,
    commented_name: signin("comment-in-name").read?.name_id,
    sha1_refused: signin("sha1").read.error,
}

route GET /c14n {
    let doc = http.get(`${IDP}/c14n-sample`).body
    let mine = saml_c14n(doc, [])?
    let inclusive = saml_c14n(doc, ["xs"])?
    { same_as_xmllint: http.post(`${IDP}/c14n-check`, { doc, mine }).json, keeps_prefix: contains(inclusive, "xmlns:xs") , drops_prefix: !contains(mine, "xmlns:xs") }
}

fn refusal(kind) = signin(kind).read.error

route GET /refused = {
    expired: refusal("expired"),
    not_yet: refusal("not-yet"),
    wrong_audience: refusal("wrong-audience"),
    no_audience: refusal("no-audience"),
    wrong_recipient: refusal("wrong-recipient"),
    confirmation_ended: refusal("confirmation-ended"),
    wrong_issuer: refusal("wrong-issuer"),
    wrong_request: refusal("wrong-request"),
    wrong_destination: refusal("wrong-destination"),
    idp_said_no: refusal("denied"),
    encrypted: refusal("encrypted"),
    unsigned: refusal("unsigned"),
    edited: refusal("edited"),
    other_key: refusal("other-key"),
    doctype: refusal("doctype"),
}

// Each is a genuine signed assertion, moved about, with a forged one where a careless reader looks.
route GET /wrapping = {
    evil_first: refusal("xsw-evil-first"),
    evil_after: refusal("xsw-evil-after"),
    in_extensions: refusal("xsw-extensions"),
    in_object: refusal("xsw-object"),
    wraps_signed: refusal("xsw-wraps-signed"),
    same_id: refusal("xsw-same-id"),
    signature_elsewhere: refusal("xsw-signature-moved"),
    response_wrapped: refusal("xsw-response"),
    moved_up: refusal("xsw-moved-up"),
    id_twin: contains(refusal("xsw-id-twin"), "elements: signature wrapping?"),
    no_unsolicited: saml_read_response(config(), signin("plain").got.saml_response, {}).error,
}
