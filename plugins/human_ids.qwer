//! Readable ids such as "brave-blue-fox" for project names, preview URLs, invite codes and test accounts: random, or always the same for a given number.
//! version: 1.0.0
//!
//! [dependencies]
//! petname = { version = "3.2", default-features = false, features = ["default-rng", "default-words"] }
//! rand = { version = "0.10", default-features = false, features = ["thread_rng"] }

use petname::{Alliterations, Generator, Petnames};
use std::sync::OnceLock;

fn names() -> &'static Petnames<'static> {
    static P: OnceLock<Petnames<'static>> = OnceLock::new();
    P.get_or_init(Petnames::small)
}

fn words(n: i64) -> Result<u8, String> {
    if (1..=8).contains(&n) { Ok(n as u8) } else { Err("from 1 to 8 words".into()) }
}

/// A random name of `words` words (1 to 8; 3 reads well) joined by `separator`: "neatly-bold-otter". Words are short, common and inoffensive English.
pub fn human_id(words: i64, separator: &str) -> Result<String, String> {
    let w = self::words(words)?;
    names().namer(w, separator).iter(&mut rand::rng()).next().ok_or_else(|| "no names".to_string())
}

/// A random name whose words all start with the same letter: "busy-brown-badger".
pub fn human_id_alliterating(words: i64, separator: &str) -> Result<String, String> {
    let w = self::words(words)?;
    let a: Alliterations = names().clone().into();
    let mut buf = String::new();
    a.generate_into(&mut buf, &mut rand::rng(), w, separator);
    Ok(buf)
}

/// The name of a number, the same every time: a readable stand-in for a database id or a hash, such as a build number's name. Not reversible, and two numbers may share a name (see `human_id_count`).
pub fn human_id_for(number: i64, words: i64, separator: &str) -> Result<String, String> {
    let w = self::words(words)?;
    let p = names();
    // splitmix64: neighbouring numbers get unrelated names.
    let mut x = number as u64;
    let mut next = || {
        x = x.wrapping_add(0x9E37_79B9_7F4A_7C15);
        let mut z = x;
        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
        z ^ (z >> 31)
    };
    fn pick<'a>(list: &[&'a str], r: u64) -> &'a str {
        list.get((r % list.len().max(1) as u64) as usize).copied().unwrap_or("")
    }
    let mut out: Vec<&str> = Vec::new();
    for _ in 0..w.saturating_sub(2) {
        out.push(pick(&p.adverbs, next()));
    }
    if w >= 2 {
        out.push(pick(&p.adjectives, next()));
    }
    out.push(pick(&p.nouns, next()));
    Ok(out.join(separator))
}

/// How many different names of `words` words there are: about 200,000 for 2 words, 52 million for 3. Pick enough words for the ids you will make, or add a number.
pub fn human_id_count(words: i64) -> Result<i64, String> {
    Ok(names().cardinality(self::words(words)?).min(i64::MAX as u128) as i64)
}
