// Ethereum addresses and signatures without a node: EIP-55 checksums, an address from a public
// key, a wallet's personal_sign checked (the sign-in step), and EIP-681 payment links.
//
//   quillo run eth_address.qwe
//   then open http://localhost:8080/check?address=0xfb6916095ca1df60bb79ce92ce3ea74c37c5d359,
//   /keys, /recover, /sign and /uri
//
// /sign needs a key of your own, a throwaway one and never one holding money:
//   ETH_DEMO_KEY=0x... quillo run eth_address.qwe

use "eth_address.qwer"

route GET /check ? { address: str } = eth_check(address)

route GET /checks = {
    right: eth_checksum("0xde709f2102306220921060314715629080e2fb77")?,
    upper: eth_check("0xFB6916095CA1DF60BB79CE92CE3EA74C37C5D359"),
    wrong: eth_check("0xfB6916095ca1df60bB79Ce92cE3Ea74c37c5d358".replace("c5d358", "c5D358")),
    short: eth_check("0x1234"),
    keccak_empty: eth_keccak("")?,
    keccak_hex: eth_keccak("0x616263")?,
}

// secp256k1's generator point: the public key of private key 1, in all three spellings.
let g = "79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8"
route GET /keys = {
    plain: eth_from_public_key("0x" + g)?,
    uncompressed: eth_from_public_key("04" + g)?,
    compressed: eth_from_public_key("0279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798")?,
    not_on_curve: eth_from_public_key("04" + replace(g, "79be", "79bf")).error,
}

// web3.js's published example: the message "Some data" signed by this account.
let account = "0x2c7536E3605D9C16a7a3D7b1898e529396a65c23"
let signed = "0xb91467e570a6466aa9e9876cbcd013baba02900b8979d43fe208a4a4f339f5fd6007e74cd82e037b800186422fc2da167c747ef045e5d18a5f5d4300f8e1a0291c"
route GET /recover = {
    who: eth_recover("Some data", signed)?,
    hash: eth_personal_hash("Some data")?,
    genuine: eth_verify("Some data", signed, account)?,
    other_text: eth_verify("Other data", signed, account)?,
    bad_v: eth_recover("Some data", slice(signed, 0, 130) + "05").error,
    short: eth_recover("Some data", "0x1234").error,
}

let key = env("ETH_DEMO_KEY", "")
route GET /sign {
    if key == "" {
        return respond(400, "Set ETH_DEMO_KEY to a throwaway key to try this.")
    }
    let s = eth_sign("Some data", key)?
    { signature: s.signature, address: s.address, checks: eth_verify("Some data", s.signature, s.address)? }
}

route GET /uri = {
    pay: eth_uri_parse("ethereum:0xfb6916095ca1df60bb79ce92ce3ea74c37c5d359?value=2.014e18")?,
    usdc: eth_uri_parse("ethereum:0x89205a3a3b2a69de6dbf7f01ed13b2108b2c43e7/transfer?address=0x8e23ee67d1332ad560396262c48ffbb01f93d052&uint256=1")?.token_transfer,
    chain: eth_uri_parse("ethereum:pay-0xfb6916095ca1df60bb79ce92ce3ea74c37c5d359@137?value=1e18&gasPrice=2.5e9")?,
    built: eth_uri_build({ to: "0xfb6916095ca1df60bb79ce92ce3ea74c37c5d359", value: "1e15", chain_id: 10 })?,
    token: eth_uri_build({ token: "0x89205a3a3b2a69de6dbf7f01ed13b2108b2c43e7", to: "vitalik.eth", amount: "2.5e6" })?,
    bad: eth_uri_parse("ethereum:0x1234").error,
    fraction: eth_uri_parse("ethereum:0xfb6916095ca1df60bb79ce92ce3ea74c37c5d359?value=1.5").error,
}
