//! The text of a PDF, whole or page by page, and the lines that hold a word: for search, imports and reading invoices.
//! version: 1.0.0
//!
//! [dependencies]
//! pdf-extract = "0.9"

use serde_json::{json, Value};

const MAX_BYTES: u64 = 100 * 1024 * 1024;

// Blank lines at the ends dropped, runs of them kept to one, spaces at line ends trimmed.
fn tidy(s: &str) -> String {
    let mut out: Vec<&str> = vec![];
    for line in s.lines().map(str::trim_end) {
        if line.trim().is_empty() && out.last().map_or(true, |l| l.is_empty()) {
            continue;
        }
        out.push(if line.trim().is_empty() { "" } else { line });
    }
    while out.last() == Some(&"") {
        out.pop();
    }
    out.join("\n")
}

fn pages(path: &str) -> Result<Vec<String>, String> {
    let size = std::fs::metadata(path).map_err(|e| format!("{}: {}", path, e))?.len();
    if size > MAX_BYTES {
        return Err(format!("{}: larger than 100 MB", path));
    }
    // A malformed PDF can make the reader panic: that is an error value here.
    let p = path.to_string();
    let r = std::panic::catch_unwind(move || pdf_extract::extract_text_by_pages(&p));
    match r {
        Ok(Ok(pages)) => Ok(pages.iter().map(|t| tidy(t)).collect()),
        Ok(Err(e)) => Err(format!("{}: {}", path, e)),
        Err(_) => Err(format!("{}: the PDF could not be read", path)),
    }
}

/// All the text of a PDF, pages parted by a blank line. Scanned pages (pictures of text) give nothing: they need OCR.
pub fn pdf_text(path: &str) -> Result<String, String> {
    Ok(pages(path)?.into_iter().filter(|p| !p.is_empty()).collect::<Vec<_>>().join("\n\n"))
}

/// The text of each page, in order: the first item is page 1.
pub fn pdf_text_pages(path: &str) -> Result<Vec<String>, String> {
    pages(path)
}

/// The lines holding `query` (in any case), as `{ page, line, text }`, pages and lines counted from 1; at most `limit` of them (up to 1,000).
pub fn pdf_text_search(path: &str, query: &str, limit: i64) -> Result<Vec<Value>, String> {
    let q = query.to_lowercase();
    if q.trim().is_empty() {
        return Ok(vec![]);
    }
    let limit = limit.clamp(1, 1000) as usize;
    let mut hits = vec![];
    for (p, text) in pages(path)?.iter().enumerate() {
        for (l, line) in text.lines().enumerate() {
            if line.to_lowercase().contains(&q) {
                hits.push(json!({ "page": p + 1, "line": l + 1, "text": line.trim() }));
                if hits.len() >= limit {
                    return Ok(hits);
                }
            }
        }
    }
    Ok(hits)
}
