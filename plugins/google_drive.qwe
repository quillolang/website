// Files in Google Drive from a server: a folder, uploads of both kinds, a search that survives a
// quote in a name, pages, a download, an export of a Google Doc, and sharing.
//
//   GOOGLE_APPLICATION_CREDENTIALS=key.json quillo run google_drive.qwe
//   then open /upload, /resumable, /find, /pages, /read, /share and /broken
//
// A service account sees only what is shared with it; GOOGLE_IMPERSONATE=user@example.com makes it
// act for a user, where domain-wide delegation is set up.

use "google_drive.qwer"

route GET /upload {
    let folder = gdrive_create_folder("Reports", "")?
    let f = gdrive_upload("it's the plan.txt", "plan text — with a dash", "text/plain", { parents: [folder.id], metadata: { description: "the plan" } })?
    { folder: folder.mimeType, id_given: f.id != null, name: f.name, in_folder: f.parents[0] == folder.id, size: f.size, read: gdrive_download(f.id)? }
}

// 300 KB in pieces of 256 KiB: one lost on the way, asked about, and sent again.
route GET /resumable {
    let content = repeat("0123456789", 30000)
    let f = gdrive_upload_resumable("big.txt", content, "text/plain", { chunk_kb: 256 })?
    { pieces: f.pieces, size: f.size, same: gdrive_download(f.id)? == content, bad_chunk: gdrive_upload_resumable("x", "y", "", { chunk_kb: 100 }).error }
}

route GET /find {
    let folder = gdrive_list({ q: "mimeType = 'application/vnd.google-apps.folder'" })?.files[0]
    {
        query: gdrive_in_folder("abc", "it's the plan.txt"),
        found: gdrive_list({ q: gdrive_in_folder(folder.id, "it's the plan.txt") })?.files | map((f) => f.name),
        none: gdrive_list({ q: gdrive_in_folder(folder.id, "nothing") })?.files,
        fields: gdrive_list({ q: "name = 'big.txt'", fields: "id,name" })?.files | map((f) => keys(f)),
        bad: gdrive_list({ q: "name ==== x" }).error,
    }
}

route GET /pages {
    for i in range(0, 5) { gdrive_upload("note-" + str(i) + ".txt", "n", "text/plain", null)? }
    let one = gdrive_list({ q: "name contains 'note-'", page_size: 2, order_by: "name" })?
    let two = gdrive_list({ q: "name contains 'note-'", page_size: 2, order_by: "name", page_token: one.next })?
    let all = gdrive_list_all("name contains 'note-'", 100)?
    let cut = gdrive_list_all("name contains 'note-'", 2)?
    { first: one.files | map((f) => f.name), second: two.files | map((f) => f.name), all: len(all.files), complete: all.complete, cut: cut.complete }
}

route GET /read {
    let doc = gdrive_list({ q: "name = 'Minutes'" })?.files[0]
    {
        export: gdrive_export(doc.id, "text/plain")?,
        download: gdrive_download(doc.id).error,
        metadata: gdrive_metadata(doc.id)?.mimeType,
        missing: gdrive_metadata("nothing")?,
    }
}

route GET /share {
    let f = gdrive_upload("shared.txt", "x", "text/plain", null)?
    let p = gdrive_share(f.id, { role: "reader", type: "user", email: "ada@example.com" }, false)?
    gdrive_share(f.id, { role: "reader", type: "anyone" }, false)?
    let list = gdrive_permissions(f.id)?
    gdrive_unshare(f.id, p.id)?
    { kinds: list | map((x) => x.type), after: len(gdrive_permissions(f.id)?), bad: gdrive_share(f.id, { role: "reader", type: "user" }, false).error, deleted: gdrive_delete(f.id)?, again: gdrive_delete(f.id)? }
}

route GET /broken = {
    download: gdrive_download("nothing").error,
    bad_kind: gdrive_share("x", { role: "reader", type: "everyone" }, false).error,
    no_file: gdrive_upload_file("/no/such/file", "x", "", null).error,
}
