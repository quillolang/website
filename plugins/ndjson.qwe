// An app's request log kept as JSON Lines: read a page at a time, searched, appended to and exported.
//
//   quillo run ndjson.qwe      then open http://localhost:8080/page?offset=15

use "ndjson.qwer"

// One page of the log, 10 lines at a time; the broken line is reported, not fatal.
route GET /page ? { offset: int = 0 } {
    let page = ndjson_read_file("ndjson_sample.jsonl", offset, 10)?
    { first: page.rows[0].at, count: len(page.rows), next: page.next, done: page.done, bad: page.bad }
}

// The errors one user met, without loading the whole file.
route GET /errors = ndjson_find("ndjson_sample.jsonl", { level: "error", "user.id": 101 }, 5)? | map((r) => { at: r.at, path: r.path })

// A log that only grows, and an export made from it.
route GET /export {
    write_file("data/events.jsonl", "")
    ndjson_append_file("data/events.jsonl", [{ event: "signup", user: "ada" }])?
    ndjson_append_file("data/events.jsonl", [{ event: "order", user: "ada", total: 42.5 }, { event: "signup", user: "grace" }])?
    let text = ndjson_write(ndjson_parse(read_file("data/events.jsonl"))? | filter((e) => e.event == "signup"))?
    { lines: ndjson_count("data/events.jsonl")?, signups: text }
}
