//! Emoji for chat and comments: shortcodes such as :tada: turned into 🎉 and back, emoji found, named and stripped, and searched by name for a picker.
//! version: 1.0.0
//!
//! [dependencies]
//! emojis = "0.9"
//! unicode-segmentation = "1.12"

use serde_json::{json, Value};
use unicode_segmentation::UnicodeSegmentation;

const MAX: usize = 1_000_000;

fn check(text: &str) -> Result<(), String> {
    if text.len() > MAX { Err("text up to 1 MB".into()) } else { Ok(()) }
}

fn info(e: &emojis::Emoji) -> Value {
    json!({ "emoji": e.as_str(), "name": e.name(), "shortcode": e.shortcode() })
}

/// `text` with GitHub and Slack shortcodes as emoji: "Shipped :tada: :+1:" is "Shipped 🎉 👍". Unknown ones such as ":nope:" stay as they are.
pub fn emoji_from_shortcodes(text: &str) -> Result<String, String> {
    check(text)?;
    let mut out = String::with_capacity(text.len());
    let mut rest = text;
    while let Some(i) = rest.find(':') {
        out.push_str(&rest[..i]);
        let after = &rest[i + 1..];
        match after.find(':') {
            Some(j) if j > 0 && after[..j].chars().all(|c| c.is_ascii_alphanumeric() || "_+-".contains(c)) => {
                if let Some(e) = emojis::get_by_shortcode(&after[..j]) {
                    out.push_str(e.as_str());
                    rest = &after[j + 1..];
                    continue;
                }
                out.push(':');
                rest = after;
            }
            _ => {
                out.push(':');
                rest = after;
            }
        }
    }
    out.push_str(rest);
    Ok(out)
}

/// `text` with each emoji as its shortcode: "Shipped 🎉" is "Shipped :tada:", for plain-text logs and systems without emoji. One without a shortcode stays.
pub fn emoji_to_shortcodes(text: &str) -> Result<String, String> {
    check(text)?;
    Ok(text.graphemes(true).map(|g| match emojis::get(g).and_then(|e| e.shortcode()) {
        Some(s) => format!(":{}:", s),
        None => g.to_string(),
    }).collect())
}

/// The emoji in `text`, in order, as `[{ emoji, name, shortcode }]`: "👍🏽" is one, with its skin tone, and flags and families count as one.
pub fn emoji_find(text: &str) -> Result<Vec<Value>, String> {
    check(text)?;
    Ok(text.graphemes(true).filter_map(emojis::get).map(info).collect())
}

/// `text` without its emoji, the spaces around them tidied: for subjects, slugs and SMS.
pub fn emoji_strip(text: &str) -> Result<String, String> {
    check(text)?;
    let s: String = text.graphemes(true).filter(|g| emojis::get(g).is_none()).collect();
    Ok(s.split(' ').filter(|w| !w.is_empty()).collect::<Vec<_>>().join(" "))
}

/// Emoji whose name or shortcode holds `query`, as `[{ emoji, name, shortcode }]`, at most `limit` (up to 200): "heart" finds ❤️, 💔, 😍... for an emoji picker.
pub fn emoji_search(query: &str, limit: i64) -> Vec<Value> {
    let q = query.trim().to_lowercase();
    emojis::iter()
        .filter(|e| e.skin_tone().map_or(true, |t| t == emojis::SkinTone::Default))
        .filter(|e| e.name().contains(&q) || e.shortcodes().any(|s| s.contains(&q)))
        .take(limit.clamp(0, 200) as usize)
        .map(info)
        .collect()
}
