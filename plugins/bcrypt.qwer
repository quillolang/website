//! Bcrypt hashes, to sign in users moved from PHP, Rails, Django or Laravel, then rehash them with Quillo's own Argon2.
//!
//! [dependencies]
//! bcrypt = "0.15"

/// Whether `password` matches a bcrypt `hash` (`$2a$`, `$2b$`, `$2y$`). False for a wrong password and for anything that is not such a hash.
pub fn bcrypt_verify(password: &str, hash: &str) -> bool {
    bcrypt::verify(password, hash).unwrap_or(false)
}

/// A bcrypt hash of `password`, at `cost` 4 to 31 (12 is usual): for systems that need bcrypt; Quillo's crypto.hash_password is better.
pub fn bcrypt_hash(password: &str, cost: i64) -> Result<String, String> {
    bcrypt::hash(password, cost.clamp(4, 31) as u32).map_err(|e| e.to_string())
}

/// Whether a stored value is a bcrypt hash (and so is due for rehashing).
pub fn is_bcrypt(hash: &str) -> bool {
    hash.len() == 60 && (hash.starts_with("$2a$") || hash.starts_with("$2b$") || hash.starts_with("$2y$"))
}
