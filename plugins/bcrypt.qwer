//! Bcrypt hashes, to sign in users moved from PHP, Rails, Django or Laravel, then rehash them with Quillo's own Argon2.
//! version: 2.0.0
//! From 1.x: bcrypt_hash refuses a password over 72 bytes; hash those with crypto.hash_password.
//!
//! [dependencies]
//! bcrypt = "0.15"

/// Bcrypt reads at most 72 bytes of a password; the bcrypt crate cut the rest without a word, so
/// two long passphrases sharing their first 72 bytes were one (quillo FEEDBACK78.md, Q-1165;
/// quillo-website branch auth-plugins).
const MOST: usize = 72;

/// Whether `password` matches a bcrypt `hash` (`$2a$`, `$2b$`, `$2y$`). False for a wrong password and for anything that is not such a hash.
/// Only the first 72 bytes of `password` count, as they did when PHP, Rails, Django or Laravel made the hash: a longer password
/// matches any password sharing those 72 bytes. Rehash it with `crypto.hash_password`, which reads all of it, once it matched.
pub fn bcrypt_verify(password: &str, hash: &str) -> bool {
    bcrypt::verify(password, hash).unwrap_or(false)
}

/// A bcrypt hash of `password`, at `cost` 4 to 31 (12 is usual): for systems that need bcrypt; Quillo's crypto.hash_password is better.
/// A password over 72 bytes is an error, as bcrypt would read only its first 72: use crypto.hash_password (Argon2id) for those.
/// From 1.x: a password over 72 bytes is refused, where 1.x hashed its first 72 bytes; hash those with `crypto.hash_password`.
pub fn bcrypt_hash(password: &str, cost: i64) -> Result<String, String> {
    if password.len() > MOST {
        return Err(format!("the password is {} bytes, and bcrypt reads only the first {}, so the rest would not count: hash it with crypto.hash_password, which reads all of it", password.len(), MOST));
    }
    bcrypt::hash(password, cost.clamp(4, 31) as u32).map_err(|e| e.to_string())
}

/// Whether a stored value is a bcrypt hash (and so is due for rehashing).
pub fn is_bcrypt(hash: &str) -> bool {
    hash.len() == 60 && (hash.starts_with("$2a$") || hash.starts_with("$2b$") || hash.starts_with("$2y$"))
}
