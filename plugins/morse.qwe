// Morse code: a text sent and read back, an accented or Cyrillic word, how long it takes to key
// at a speed, and a WAV of the tone written to disk, played by a browser and decoded again.
//
//   quillo run morse.qwe
//   then open http://localhost:8080/encode?text=Hello+world, /decode, /timing, /sound.wav and /heard

use "morse.qwer"

route GET /encode ? { text: str = "SOS HELP" } = { text: text, code: morse_encode(text, {})? }

route GET /decode = {
    plain: morse_decode("-- --- .-. ... . / -.-. --- -.. .", {})?,
    dashes: morse_decode("•••  ———", { lenient: true })?,
    russian: morse_decode(morse_encode("Привет мир", { alphabet: "cyrillic" })?, { alphabet: "cyrillic" })?,
    greek: morse_encode("Σωκράτης", { alphabet: "greek" })?,
    accented: morse_encode("Ñandú Ü", {})?,
    prosign: morse_encode("CQ <AR>", {})?,
    wrong: morse_decode("...... ---", {}).error,
    no_code: morse_encode("price: 5€", {}).error,
}

// The word PARIS is 50 units, so 20 words a minute is exactly a 60 ms dot.
route GET /timing = {
    paris: morse_timing("PARIS", { wpm: 20 })?.units,
    dot_ms: morse_timing("PARIS", { wpm: 20 })?.dot_ms,
    seconds: morse_timing("SOS", { wpm: 20 })?.seconds,
    slow: morse_timing("PARIS", { wpm: 18, farnsworth: 5 })?.word_gap_ms,
    too_fast: morse_timing("E", { wpm: 10, farnsworth: 20 }).error,
}

let path = "data/morse-example.wav"

route GET /sound.wav {
    write_file("data/.keep", "")
    morse_wav("CQ DE QUILLO", path, { wpm: 18, frequency: 700.0 })?
    file(path)
}

// Written, then read from the samples alone.
route GET /heard {
    write_file("data/.keep", "")
    let made = morse_wav("HELLO WORLD 73", path, { wpm: 25 })?
    { made: made.seconds, heard: morse_read_wav(path, {})? }
}

route GET /not-a-wav {
    write_file(path + ".txt", "nothing")
    { error: morse_read_wav(path + ".txt", {}).error }
}
