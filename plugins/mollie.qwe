// Taking payments with Mollie: a payment and its checkout link, refunds, the webhook that only says
// "look at this id", a customer's first payment, a mandate and a recurring charge.
//
//   MOLLIE_API_KEY=test_... quillo run mollie.qwe
//   then open /pay, /hook, /refund, /recurring, /lists, /amounts and /failures
//
// MOLLIE_API_URL reaches a test server. Mollie's webhookUrl must be reachable from the internet, so
// point it at POST /mollie/webhook on a public address; a real one only ever sends `id=tr_...`.

use "mollie.qwer"

route GET /pay {
    let p = mollie_payment_create(mollie_amount("10", "EUR")?, "Order 1001", "https://shop.example/back", { webhookUrl: "https://shop.example/mollie/webhook", metadata: { order: 1001 } })?
    let read = mollie_payment(p.id)?
    let gone = mollie_payment_create(mollie_amount("5", "EUR")?, "Changed my mind", "https://shop.example/back", {})?
    { state: p.status, sends_to: contains(p.checkout_url, p.id), value: read.amount.value, order: read.metadata.order, cancelled: mollie_payment_cancel(gone.id)?.status }
}

route GET /once {
    let a = mollie_payment_create(mollie_amount("3", "EUR")?, "Same key", "https://shop.example/back", { idempotency_key: "key-1" })?
    let b = mollie_payment_create(mollie_amount("3", "EUR")?, "Same key", "https://shop.example/back", { idempotency_key: "key-1" })?
    { same: a.id == b.id }
}

route POST /mollie/webhook {
    let hook = mollie_webhook(request.body)?
    if hook.paid { print("paid", hook.id) }
    // Always a 200: an unknown id is no one's business.
    "ok"
}

// What comes in is only an id: what it means is read back from Mollie.
route GET /hook {
    let p = mollie_payment_create(mollie_amount("12.50", "EUR")?, "Order 1002", "https://shop.example/back", { method: "creditcard" })?
    let seen = mollie_webhook(`id=${p.id}`)?
    {
        known: seen.known, paid: seen.paid, status: seen.status,
        unknown: mollie_webhook("id=tr_nosuch")?.known,
        empty: mollie_webhook("")?.known,
        odd: mollie_webhook("id=../../customers")?.known,
    }
}

route GET /refund {
    let p = mollie_payment_create(mollie_amount("20", "EUR")?, "Order 1003", "https://shop.example/back", { method: "creditcard" })?
    mollie_payment(p.id)?
    let back = mollie_refund(p.id, mollie_amount("5", "EUR")?, "Chipped mug")?
    let other = mollie_refund(p.id, mollie_amount("1", "EUR")?, "")?
    {
        state: back.status,
        count: len(mollie_refunds(p.id)?),
        cancelled: mollie_refund_cancel(p.id, other.id)?,
        left: len(mollie_refunds(p.id)?),
        too_much: mollie_refund(p.id, mollie_amount("99", "EUR")?, "").error,
    }
}

route GET /recurring {
    let c = mollie_customer_create({ name: "Ada Lovelace", email: "ada@example.com" })?
    let first = mollie_first_payment(c.id, mollie_amount("0.01", "EUR")?, "First payment", "https://shop.example/back", { method: "creditcard" })?
    let no_mandate = mollie_charge(c.id, mollie_amount("9.99", "EUR")?, "Too soon", "", {}).error
    mollie_payment(first.id)?
    let mandate = mollie_valid_mandate(c.id)?
    let charge = mollie_charge(c.id, mollie_amount("9.99", "EUR")?, "November", mandate.id, { idempotency_key: "nov-1" })?
    let revoked = mollie_mandate_revoke(c.id, mandate.id)?
    {
        name: mollie_customer(c.id)?.name, sequence: first.sequenceType, no_mandate: no_mandate,
        mandate: mandate.status, charge: [charge.status, charge.sequenceType, charge.checkout_url],
        revoked: revoked, now: mollie_valid_mandate(c.id)?,
    }
}

route GET /lists = {
    all: len(mollie_payments(0)?) > 600,
    capped: len(mollie_payments(70)?),
    customers: len(mollie_customers(0)?) > 300,
}

route GET /amounts = {
    euros: mollie_amount("10", "eur")?,
    cents: mollie_amount("0.5", "EUR")?,
    yen: mollie_amount("1000", "JPY")?,
    too_fine: mollie_amount("1.005", "EUR").error,
    float_like: mollie_amount("ten", "EUR").error,
}

route GET /failures = {
    missing: mollie_payment("tr_nosuch").error,
    bad_amount: mollie_payment_create(mollie_amount("0", "EUR")?, "Nothing", "https://x.example", {}).error,
    no_redirect: mollie_payment_create(mollie_amount("1", "EUR")?, "x", "", {}).error,
    not_text: mollie_payment_create({ currency: "EUR", value: 10 }, "x", "y", {}).error,
    waited: mollie_payment_create(mollie_amount("2", "EUR")?, "busy", "https://x.example", { idempotency_key: "busy-1" })?.status,
}
