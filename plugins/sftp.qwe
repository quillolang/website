// A partner's SFTP drop box: orders fetched from a folder, a report uploaded so that it appears whole,
// and the server's host key pinned so that nobody else can stand in for it.
//
//   SFTP_HOST=sftp.partner.example SFTP_USER=shop SFTP_KEY_FILE=~/.ssh/partner SFTP_HOST_KEY=SHA256:... quillo run sftp.qwe
//   then open /list, /transfer, /files, /big, /moves and /broken
//
// SFTP_PASSWORD works in place of a key. SFTP_ROOT is the folder this example works in.

use "sftp.qwer"

let root = env("SFTP_ROOT", "drop")

route GET /list {
    sftp_mkdir(root + "/in/2026/orders")?
    sftp_put(root + "/in/b.csv", "id,total\n1,12\n", null)?
    sftp_put(root + "/in/a.csv", "id,total\n", { mode: "640" })?
    let again = sftp_mkdir(root + "/in/2026/orders")?
    {
        names: sftp_list(root + "/in")? | map((e) => { name: e.name, kind: e.kind, size: e.size }),
        mode: sftp_stat(root + "/in/a.csv")?.mode,
        dated: sftp_stat(root + "/in/b.csv")?.modified > 1700000000,
        link: sftp_stat(root + "/link.txt")?.kind,
        none: sftp_stat(root + "/nothing")?,
        again: again,
    }
}

route GET /transfer {
    let r = sftp_put(root + "/out/report.txt", "héllo — report\n", null)?
    {
        written: r,
        read: sftp_get(root + "/out/report.txt", 0)?,
        no_part_left: sftp_stat(root + "/out/report.txt.part")?,
        kept: sftp_put(root + "/out/report.txt", "x", { overwrite: false }).error,
        replaced: sftp_put(root + "/out/report.txt", "second", null)?.bytes,
        now: sftp_get(root + "/out/report.txt", 0)?,
        too_big: sftp_get(root + "/out/report.txt", 3).error,
    }
}

// Whole files through local paths, with a hash to compare.
route GET /files {
    let up = sftp_put_file("sftp.qwer", root + "/out/source.txt", null)?
    let down = sftp_get_file(root + "/out/source.txt", env("SFTP_DOWNLOADS", "/tmp") + "/copy.txt")?
    { same: up.sha256 == down.sha256, bytes: up.bytes == down.bytes, more_than_nothing: up.bytes > 1000 }
}

route GET /big {
    let text = repeat("0123456789abcdef", 200000)
    let r = sftp_put(root + "/out/big.bin", text, { atomic: false })?
    { bytes: r.bytes, same: sftp_get(root + "/out/big.bin", 0)? == text, size: sftp_stat(root + "/out/big.bin")?.size }
}

route GET /moves {
    sftp_put(root + "/m1.txt", "one", null)?
    sftp_put(root + "/m2.txt", "two", null)?
    let refused = sftp_rename(root + "/m1.txt", root + "/m2.txt", false).error
    let replaced = sftp_rename(root + "/m1.txt", root + "/m2.txt", true)?
    {
        refused: refused != null,
        replaced: replaced,
        text: sftp_get(root + "/m2.txt", 0)?,
        gone: sftp_stat(root + "/m1.txt")?,
        removed: sftp_remove(root + "/m2.txt")?,
        removed_again: sftp_remove(root + "/m2.txt")?,
        made: sftp_mkdir(root + "/empty")?,
        emptied: sftp_rmdir(root + "/empty")?,
        emptied_again: sftp_rmdir(root + "/empty")?,
    }
}

route GET /broken = {
    missing: sftp_get(root + "/nothing.txt", 0).error,
    no_folder: sftp_list(root + "/nothing").error,
    not_empty: sftp_rmdir(root + "/in").error != null,
    no_local: sftp_put_file("/no/such/file", root + "/x", null).error,
    bad_mode: sftp_put(root + "/x", "y", { mode: "rwx" }).error,
    locked: sftp_put(env("SFTP_LOCKED", "") + "/x", "y", { atomic: false }).error,
}
