// A panning animation made from crops of a wide picture, served as a GIF, and read back.
//
//   quillo run gif.qwe      then open http://localhost:8080/pan.gif

use "gif.qwer"

fn make() {
    // Six windows across the 640×160 picture, cut with Quillo's own image.convert.
    let frames = for i in range(6) => {
        let path = `data/gif/frame-${i}.png`
        image.convert("gif_sample.png", path, { crop: { x: i * 64, y: 0, w: 320, h: 160 }, format: "png" })?
        path
    }
    gif_make(frames, "data/gif/pan.gif", 250, 240)
}

route GET /pan.gif {
    make()?
    file("data/gif/pan.gif")
}

route GET /info {
    let made = make()?
    { made, read: gif_info("data/gif/pan.gif")?, first: gif_frames("data/gif/pan.gif", "data/gif/frames", 1)? }
}
