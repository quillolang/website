// A runner's uploaded track: the summary, the splits, and the line for a map.
//
//   quillo run gpx.qwe      then open http://localhost:8080/run

use "gpx.qwer"

let TRACK = "gpx_sample.gpx"

route GET /run {
    let s = gpx_summary(TRACK)?
    { name: s.name, km: s.distance_km, climb_m: s.climb_m, minutes: s.duration_s / 60, stopped_s: s.duration_s - s.moving_s, moving_kmh: s.moving_kmh }
}

route GET /splits = gpx_splits(TRACK, 1.0)? | map((s) => `km ${s.split}: ${s.pace}`)

route GET /map = { line: gpx_points(TRACK, 10)? | map((p) => [round(p[0], 5), round(p[1], 5)]) }

// An upload, read from the form's file: <form method=post enctype=multipart/form-data action=/upload><input type=file name=track>
route POST /upload {
    let path = save_upload(request.files.track, `data/tracks/${uuid()}.gpx`)?
    gpx_summary(path)?
}
