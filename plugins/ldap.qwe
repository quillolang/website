// A web app's sign-in against Active Directory: a person checked by search-then-bind (and the
// reasons AD gives when it says no), their groups direct and nested, the devices OU read page by
// page, a user's entry with its SID and GUID, and a contact added, changed and deleted. Over
// StartTLS, as a service account.
//
//   LDAP_URL=ldaps://dc1.corp.example LDAP_BIND_DN="CN=svc-web,OU=Service,DC=corp,DC=example" \
//   LDAP_PASSWORD=... LDAP_BASE="DC=corp,DC=example" quillo run ldap.qwe   then open http://localhost:8080/sign-in
//
// Needs a directory at LDAP_URL (Active Directory, or OpenLDAP with other filters). ldap:// URLs
// use StartTLS here; LDAP_CA is a CA's PEM for a private certificate.

use "ldap.qwer"

let BASE = env("LDAP_BASE", "dc=quillo,dc=test")
let USERS = "(&(objectClass=user)(sAMAccountName={user}))"
let opened = ldap_connect("ad", env("LDAP_URL", "ldap://127.0.0.1:389"), {
    bind_dn: env("LDAP_BIND_DN", ""),
    password: env("LDAP_PASSWORD", ""),
    starttls: starts_with(env("LDAP_URL", "ldap://"), "ldap://"),
    ca: env("LDAP_CA", ""),
    timeout_ms: 5000,
    page_size: 10,
})

route GET /connected = opened?

route POST /sign-in ? { user: str, password: str } = ldap_sign_in("ad", BASE, USERS, user, password, { attrs: ["mail", "displayName"] })?

route GET /sign-in = {
    ada: ldap_sign_in("ad", BASE, USERS, "ada", "Correct-Horse-1", { attrs: ["mail", "displayName"] })?,
    wrong: ldap_sign_in("ad", BASE, USERS, "ada", "guess", {})?.reason,
    locked: ldap_sign_in("ad", BASE, USERS, "lou", "Correct-Horse-1", {})?.reason,
    star: ldap_sign_in("ad", BASE, USERS, "*", "Correct-Horse-1", {})?.reason,
    empty: ldap_sign_in("ad", BASE, USERS, "ada", "", {})?.ok,
}

route GET /groups {
    let ada = ldap_sign_in("ad", BASE, USERS, "ada", "Correct-Horse-1", {})?.dn
    {
        direct: map(ldap_groups("ad", ada, BASE, {})?, (g) => g.cn),
        nested: map(ldap_groups("ad", ada, BASE, { nested: true })?, (g) => g.cn),
        walked: map(ldap_groups("ad", ada, BASE, { nested: "walk" })?, (g) => g.cn),
    }
}

// 25 computers, read 10 at a time; without paging the server stops at 20.
route GET /devices {
    let all = ldap_search("ad", "ou=Devices," + BASE, "(objectClass=computer)", ["cn", "operatingSystem"], { scope: "one" })?
    {
        count: len(all),
        linux: len(filter(all, (d) => d.attrs.operatingSystem[0] == "Ubuntu 24.04")),
        unpaged: ldap_search("ad", "ou=Devices," + BASE, "(objectClass=computer)", ["cn"], { page_size: 0 }).error,
    }
}

route GET /user ? { name: str = "grace" } {
    let found = ldap_search("ad", BASE, `(&(objectClass=user)(sAMAccountName=${ldap_escape(name)}))`, ["displayName", "mail", "objectSid", "objectGUID", "title"], {})?
    len(found) == 0 ? { found: false } : found[0]
}

route GET /manage {
    let dn = `cn=${ldap_escape_dn("Babbage, Charles")},ou=People,${BASE}`
    ldap_add("ad", dn, { objectClass: ["top", "contact"], cn: "Babbage, Charles", mail: "charles@example.com", title: "Inventor" })?
    ldap_modify("ad", dn, [{ op: "replace", attr: "title", values: ["Polymath"] }, { op: "add", attr: "telephoneNumber", values: ["+44 20 7946 0001"] }])?
    let read = ldap_search("ad", dn, "(objectClass=*)", ["title", "telephoneNumber", "mail"], { scope: "base" })?[0]
    ldap_delete("ad", dn)?
    { dn, title: read.attrs.title, phone: read.attrs.telephoneNumber, gone: ldap_search("ad", dn, "(objectClass=*)", [], { scope: "base" }).error }
}

route GET /escape = { filter: ldap_escape("Ada (admin)*\\"), dn: ldap_escape_dn("Lovelace, Ada") }
