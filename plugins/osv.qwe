// Are this program's dependencies safe? Packages asked of OSV.dev by name and by purl, a lockfile's
// worth at once, versions compared the way each ecosystem compares them, and how bad each one is.
//
//   quillo run osv.qwe      then open http://localhost:8080/query, /batch, /versions, /affects, /severity and /failures
//
// The API needs no key. OSV_API_URL reaches a test server.

use "osv.qwer"

route GET /query {
    let found = osv_query({ name: "lodash", ecosystem: "npm", version: "4.17.20" })?
    let by_purl = osv_query({ purl: "pkg:npm/lodash@4.17.20" })?
    let paged = osv_query({ name: "bigpkg", ecosystem: "PyPI" })?
    { ids: map(found, (v) => v.id), same: len(by_purl) == len(found), paged: len(paged), clean: len(osv_query({ name: "lodash", ecosystem: "npm", version: "4.17.21" })?), one: osv_vuln("GHSA-35jh-r3h4-6jhm")?.aliases }
}

route GET /batch {
    let packages = [
        { name: "lodash", ecosystem: "npm", version: "4.17.20" },
        { purl: "pkg:pypi/django@3.2.0" },
        { name: "lodash", ecosystem: "npm", version: "4.17.21" },
        { name: "bigpkg", ecosystem: "PyPI" },
    ]
    let ids = osv_query_batch(packages, {})?
    let full = osv_query_batch(packages, { full: true })?
    { counts: map(ids, (l) => len(l)), first: ids[0][0].id, summary: full[0][0].summary, clean: ids[2] }
}

route GET /versions = {
    semver_pre: osv_compare("npm", "1.0.0-alpha.1", "1.0.0")?,
    semver_num: osv_compare("crates.io", "1.10.0", "1.9.0")?,
    go: osv_compare("Go", "v1.2.3", "1.2.3")?,
    pypi_rc: osv_compare("PyPI", "1.0rc1", "1.0")?,
    pypi_dev: osv_compare("PyPI", "1.0.dev1", "1.0a1")?,
    pypi_post: osv_compare("PyPI", "1.0.post1", "1.0")?,
    pypi_epoch: osv_compare("PyPI", "1!0.1", "2.0")?,
    pypi_zero: osv_compare("PyPI", "1.0", "1.0.0")?,
    debian_tilde: osv_compare("Debian:12", "1.0~rc1-1", "1.0-1")?,
    debian_epoch: osv_compare("Debian", "1:1.0-1", "2.0-1")?,
    debian_rev: osv_compare("Ubuntu:22.04", "1.2-3ubuntu1", "1.2-3")?,
    gem_pre: osv_compare("RubyGems", "1.0.0.rc1", "1.0.0")?,
    gem_nums: osv_compare("RubyGems", "1.10", "1.9")?,
    maven_rc: osv_compare("Maven", "2.0-rc1", "2.0")?,
    maven_snapshot: osv_compare("Maven", "2.0-SNAPSHOT", "2.0-rc1")?,
    maven_final: osv_compare("Maven", "2.0.Final", "2.0")?,
    maven_sp: osv_compare("Maven", "2.0-sp1", "2.0")?,
    unknown: osv_compare("Cobol", "1", "2").error,
}

route GET /affects {
    let v = osv_vuln("GHSA-35jh-r3h4-6jhm")?
    let at = (version) => osv_affects(v, "npm", "lodash", version)?
    {
        old: at("4.17.20"),
        fixed: at("4.17.21").affected,
        before: at("2.0.0").affected, older_line: at("3.9.0").affected,
        second_range: at("4.0.0").affected,
        listed_only: osv_affects(v, "npm", "lodash", "2.4.2")?.why,
        other_package: osv_affects(v, "npm", "underscore", "1.0.0")?.why,
        last: osv_affects(osv_vuln("PYSEC-2021-98")?, "PyPI", "django", "3.2.0")?.affected,
        after_last: osv_affects(osv_vuln("PYSEC-2021-98")?, "PyPI", "django", "3.2.1")?.affected,
    }
}

route GET /severity {
    let v = osv_vuln("GHSA-35jh-r3h4-6jhm")?
    {
        critical: osv_cvss("CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H")?,
        changed_scope: osv_cvss("CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N")?,
        none: osv_cvss("CVSS:3.0/AV:L/AC:H/PR:H/UI:R/S:U/C:N/I:N/A:N")?,
        from_record: osv_severity(v),
        word_only: osv_severity(osv_vuln("PYSEC-2021-98")?),
        sorted: map(osv_summaries(osv_query({ name: "lodash", ecosystem: "npm", version: "4.17.20" })?), (s) => [s.id, s.rating]),
    }
}

route GET /failures = {
    purl_twice: osv_query({ purl: "pkg:npm/lodash@1", version: "2" }).error,
    no_ecosystem: osv_query({ name: "lodash" }).error,
    not_purl: osv_query({ purl: "npm/lodash" }).error,
    missing: osv_vuln("GHSA-none-none-none").error,
    bad_id: osv_vuln("../etc").error,
    scoped: osv_purl("pkg:npm/%40angular/core@16.0.0?arch=x")?,
    maven: osv_purl("pkg:maven/org.apache.logging.log4j/log4j-core@2.14.1")?.package,
    v4: osv_cvss("CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N").error,
}
