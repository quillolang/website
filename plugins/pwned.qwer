//! Have I Been Pwned's Pwned Passwords, by k-anonymity: only the first 5 characters of the password's SHA-1 leave the server, and the answer is checked here; for sign-up and password-change forms.
//! version: 1.0.0
//!
//! [dependencies]
//! sha1 = "0.10"

use sha1::{Digest, Sha1};
use std::collections::HashMap;

fn sha1_upper(text: &str) -> String {
    Sha1::digest(text.as_bytes()).iter().map(|b| format!("{:02X}", b)).collect()
}

/// What to ask the API for `password`: `{ prefix, suffix, url }`. `url` is `https://api.pwnedpasswords.com/range/<prefix>`;
/// fetch it (with the `Add-Padding: true` header, so the answer's size says nothing) and give its text to pwned_count.
/// Neither the password nor its whole hash is sent.
pub fn pwned_range(password: &str) -> HashMap<String, String> {
    let h = sha1_upper(password);
    HashMap::from([
        ("prefix".to_string(), h[..5].to_string()),
        ("suffix".to_string(), h[5..].to_string()),
        ("url".to_string(), format!("https://api.pwnedpasswords.com/range/{}", &h[..5])),
    ])
}

/// How many times `password` appears in breaches, read from `range_text` (the API's answer for its prefix: lines of
/// `SUFFIX:COUNT`). 0 when it is not there; padding lines (count 0) are ignored. An error when the text is not such an answer.
pub fn pwned_count(password: &str, range_text: &str) -> Result<i64, String> {
    let suffix = &sha1_upper(password)[5..];
    let mut lines = 0;
    for line in range_text.lines().take(100_000) {
        let line = line.trim();
        if line.is_empty() {
            continue;
        }
        let (s, n) = line.split_once(':').ok_or_else(|| format!("`{}` is not SUFFIX:COUNT: is this the range answer?", line.chars().take(60).collect::<String>()))?;
        lines += 1;
        if s.trim().eq_ignore_ascii_case(suffix) {
            return n.trim().parse::<i64>().map_err(|_| format!("`{}` is not a count", n));
        }
    }
    if lines == 0 {
        return Err("the range answer is empty".into());
    }
    Ok(0)
}

/// The SHA-1 of `password` in upper-case hex, as Pwned Passwords writes it: for the downloadable list, or a cache of ranges.
pub fn pwned_sha1(password: &str) -> String {
    sha1_upper(password)
}
