// An order email written with a <style> block and classes, as a designer would, and inlined
// before it is sent, as email clients need.
//
//   quillo run css_inline.qwe      then open http://localhost:8080/email

use "css_inline.qwer"

let EMAIL = `<html><head><style>
  body { font-family: Helvetica, Arial, sans-serif; color: #222; }
  .button { background: #1a73e8; color: #fff !important; padding: 12px 20px; text-decoration: none; }
  td.total { font-weight: bold; text-align: right; }
  p { margin: 0 0 12px; }
  @media (max-width: 600px) { .wide { width: 100% !important; } }
</style></head>
<body><p>Thanks for your order, Ada.</p>
<table class="wide"><tr><td>Notebook × 2</td><td class="total">€9.98</td></tr></table>
<p><a class="button" href="https://shop.example/orders/1042" style="color: yellow">See your order</a></p></body></html>`

route GET /email = respond(200, css_inline(EMAIL)?, { "content-type": "text/html; charset=utf-8" })

route GET /themed = respond(200, css_inline_with("<html><body><h1>Hello</h1><p class=note>Small print</p></body></html>", "h1 { color: #0a7; margin: 0 } .note { font-size: 12px; color: #888 }", false)?, { "content-type": "text/plain" })

route GET /fragment = { html: css_inline_fragment("<p class=lead>Big news</p><p>Details</p>", "p { margin: 0 } .lead { font-size: 20px }")? }
