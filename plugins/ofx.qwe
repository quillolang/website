// A bank's OFX download imported into the books: balances checked, transactions as rows, no transaction twice.
//
//   quillo run ofx.qwe      then open http://localhost:8080/statements

use "ofx.qwer"

route GET /statements = ofx_read_file("ofx_sample.ofx")? | map((s) => {
    kind: s.kind,
    account: s.account,
    from: s.from,
    to: s.to,
    balance: s.balance.amount,
    transactions: len(s.transactions),
    total_cents: sum(s.transactions | map((t) => t.cents)),
})

route GET /rows = ofx_transactions("ofx_sample.ofx")? | map((t) => { account: t.account, date: t.date, amount: t.amount, cents: t.cents, name: t.name, id: t.id })

// The checking account's transactions, and the bank's own name from the sign-on, read from the tree.
route GET /checking {
    let text = read_file("ofx_sample.ofx")
    let s = ofx_parse(text)?[0]
    { bank: ofx_tree(text)?.OFX.SIGNONMSGSRSV1.SONRS.FI.ORG, check: (s.transactions | filter((t) => t.type == "check"))[0], card_payment_in: (ofx_parse(text)?[1].transactions | filter((t) => t.cents > 0) | map((t) => t.name)) }
}
