// The sky by calculation: Julian dates, sidereal time, the sun, moon and planets, when each rises
// and sets, what is up over a city, and which constellation a point lies in. Low-precision series
// only: no ephemeris file and no service.
//
//   quillo run astronomy.qwe
//   then open http://localhost:8080/julian, /meeus, /position?body=mars, /rise, /sky and /constellation

use "astronomy.qwer"

route GET /julian = {
    sputnik: astro_julian("1957-10-04T19:26:24Z")?.jd,
    j2000: astro_julian("2000-01-01T12:00:00Z")?,
    julian_calendar: astro_julian("0333-01-27T12:00:00Z")?.jd,
    before_christ: astro_julian("-1000-07-12T12:00:00Z")?.jd,
    zero: astro_julian("-4712-01-01T12:00:00Z")?.jd,
    back: astro_julian(2436116.31)?.iso,
    offset: astro_julian("2026-11-01T14:00:00+02:00")?.iso,
    sidereal: astro_sidereal("1987-04-10T00:00:00Z", 0.0)?,
    west: astro_sidereal("1987-04-10T00:00:00Z", -77.0)?.lst_text,
}

// Worked examples from Meeus, Astronomical Algorithms, chapters 25, 47 and 33. His moon is for 0h
// dynamical time, 59 seconds ahead of UTC that day.
route GET /meeus = {
    sun: astro_position("sun", "1992-10-13T00:00:00Z")?,
    moon: astro_position("moon", "1992-04-11T23:59:01Z")?,
    venus: astro_position("venus", "1992-12-20T00:00:00Z")?,
}

route GET /position ? { body: str = "mars", at: str = "2026-11-01T12:00:00Z" } {
    let p = astro_position(body, at)
    if is_err(p) { reply 422 p.error }
    p
}

// Meeus's example for Boston, and places where the sun does not rise or does not set.
route GET /rise = {
    venus: astro_rise_set("venus", 42.3333, -71.0833, "1988-03-20")?,
    sun_london: astro_rise_set("sun", 51.5, 0.0, "2026-06-21")?,
    moon: astro_rise_set("moon", 40.0, -75.0, "2026-11-01")?.body,
    midnight_sun: astro_rise_set("sun", 78.2, 15.6, "2026-06-21")?,
    polar_night: astro_rise_set("sun", 78.2, 15.6, "2026-12-21")?.down_all_day,
}

route GET /sky = {
    bodies: astro_sky(52.37, 4.89, "2026-11-01T21:00:00Z")?,
    zenith: astro_altaz(0.0, 90.0, 90.0, 0.0, "2026-01-01T00:00:00Z")?.altitude,
}

// Stars whose constellations everyone knows, and a point on each side of a boundary.
route GET /constellation = {
    orion: astro_constellation(83.82, -5.39, 2000.0)?.name,
    polaris: astro_constellation(37.95, 89.26, 2000.0)?.name,
    vega: astro_constellation(279.23, 38.78, 2000.0)?.name,
    sirius: astro_constellation(101.29, -16.72, 2000.0)?.name,
    crux: astro_constellation(186.65, -63.10, 2000.0)?.abbreviation,
    south_pole: astro_constellation(0.0, -90.0, 2000.0)?.name,
    sun_in_scorpius: astro_position("sun", "2026-11-25T00:00:00Z")?.constellation,
    sun_in_ophiuchus: astro_position("sun", "2026-12-05T00:00:00Z")?.constellation,
    count: len(astro_constellations()),
    separation: astro_separation(213.9154, 19.1825, 201.2983, -11.1614),
}

route GET /refused = {
    body: astro_position("pluto", "2026-01-01").error,
    earth: astro_position("earth", "2026-01-01").error,
    time: astro_position("sun", "soon").error,
    place: astro_rise_set("sun", 95.0, 0.0, "2026-01-01").error,
}
