// A game's settings in RON: read, checked, and changed in place for the Rust side to load, comments kept.
//
//   quillo run ron.qwe      then open http://localhost:8080/settings

use "ron.qwer"

route GET /settings {
    let c = ron_read_file("ron_sample.ron")?
    {
        title: c.title,
        mode: c.window.mode,
        width: c.window.size[0],
        music: c.audio.music,
        jump: c.keys.jump,
        spawn: c.spawn,
        seed: c.seed,
        tagline: c.tagline,
    }
}

// The settings screen saves: the music lower, a window instead of full screen, a tougher ship.
route GET /save {
    let text = read_file("ron_sample.ron")?
    let text = ron_set(text, "audio.music", 0.2)?
    let text = ron_set_raw(text, "window.mode", "Windowed")?
    let text = ron_set_raw(text, "window.size", "(1280, 720)")?
    let text = ron_set(text, "spawn.0.Ship.hull", 150)?
    write_file("data/settings.ron", text)
    respond(200, text, { "content-type": "text/plain; charset=utf-8" })
}

route GET /inline = {
    struct: ron_write({ x: 1.5, y: -2, label: "pin \"A\"", hidden: null }, 0),
    map: ron_write_maps({ "en-GB": "Colour", fr: "Couleur" }, 0),
    bad: ron_check("(a: 1, b: [2, 3)").error,
    missing: ron_set("(a: 1)", "b", 2).error,
}
