// Checking the address in a sign-up form.
//
//   quillo run email_address.qwe      then open http://localhost:8080/check?email=ada@Example.COM

use "email_address.qwer"

route GET /check ? { email: str } = email_valid(email) ? email_parts(email)? : { error: "That is not an email address" }
route GET /samples = { good: email_valid("ada@example.com"), bad: email_valid("ada@@example"), named: email_parts("Ada Lovelace <ada@Example.com>")? }
