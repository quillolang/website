// A sitemap, and a SOAP request to a partner, built from maps.
//
//   quillo run xml_write.qwe      then open http://localhost:8080/sitemap.xml

use "xml_write.qwer"

let PAGES = [{ path: "/", changed: "2026-11-02" }, { path: "/products?sort=new&page=2", changed: "2026-11-01" }, { path: "/about", changed: "2026-10-20" }]

route GET /sitemap.xml = respond(200, xml_build_with("urlset", {
    "@xmlns": "http://www.sitemaps.org/schemas/sitemap/0.9",
    url: PAGES | map((p) => { loc: `https://shop.example.com${p.path}`, lastmod: p.changed }),
}, { indent: 2 })?, { "content-type": "application/xml" })

route GET /soap {
    let body = xml_build_with("soap:Envelope", {
        "@xmlns:soap": "http://schemas.xmlsoap.org/soap/envelope/",
        "@xmlns:m": "http://partner.example.com/stock",
        "soap:Header": null,
        "soap:Body": { "m:GetStock": { "m:Sku": "B7", "m:Warehouse": { "@code": "AMS-1", "#text": "Amsterdam <Noord> & co" }, "m:Note": { "#cdata": "<b>urgent</b>" } } },
    }, { declaration: true })?
    // In a real app: http.post("https://partner.example.com/soap", body, { "content-type": "text/xml; charset=utf-8", soapaction: "GetStock" })
    respond(200, body, { "content-type": "text/xml" })
}

route GET /bad = { error: xml_build("order", { "1st item": "x" }).error }
