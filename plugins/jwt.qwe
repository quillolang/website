// An API that hands out tokens and checks them.
//
//   quillo run jwt.qwe      then open http://localhost:8080/token
//   curl -H "authorization: Bearer <token>" localhost:8080/me

use "jwt.qwer"

let SECRET = env("JWT_SECRET") ?? "change me: at least 32 random characters"

route GET /token = { token: jwt_sign({ sub: "user-7", role: "admin" }, SECRET, 3600)? }

route GET /me {
    let token = replace(request.headers.authorization ?? "", "Bearer ", "")
    let claims = jwt_verify(token, SECRET)
    if is_err(claims) { reply 401 { error: claims.error } }
    { user: claims.sub, role: claims.role }
}

route GET /check {
    let t = jwt_sign({ sub: "user-7" }, SECRET, 60)?
    { verified: jwt_verify(t, SECRET)?.sub, wrong_secret: is_err(jwt_verify(t, "another secret")), peek: jwt_peek(t)?.sub }
}
