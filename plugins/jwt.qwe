// An API that hands out tokens and checks them.
//
//   quillo run jwt.qwe      then open http://localhost:8080/token
//   curl -H "authorization: Bearer <token>" localhost:8080/me

use "jwt.qwer"

let SECRET = env("JWT_SECRET") ?? "change me: at least 32 random characters"

route GET /token = { token: jwt_sign({ sub: "user-7", role: "admin" }, SECRET, 3600)? }

route GET /me {
    let token = replace(request.headers.authorization ?? "", "Bearer ", "")
    let claims = jwt_verify(token, SECRET)
    if is_err(claims) { reply 401 { error: claims.error } }
    { user: claims.sub, role: claims.role }
}

// A token for another service, as an identity provider issues one: its audience and issuer
// checked, and one with no `exp` refused (it would be good for ever). A token that names no
// audience or no issuer is refused when one is asked for: otherwise a token this program signed
// for something else (an unsubscribe link) would pass as an `orders` token.
route GET /audience {
    let t = jwt_sign({ sub: "service:shop", aud: "orders", iss: "idp" }, SECRET, 60)?
    let forever = jwt_sign({ sub: "service:shop" }, SECRET, 0)?
    let bare = jwt_sign({ sub: "mallory" }, SECRET, 60)?
    let aud_only = jwt_sign({ sub: "mallory", aud: "orders" }, SECRET, 60)?
    let wrong_type = jwt_sign({ sub: "mallory", aud: 7, iss: "idp" }, SECRET, 60)?
    let lasting = jwt_sign({ sub: "service:shop", aud: "orders", iss: "idp" }, SECRET, 0)?
    {
        orders: jwt_check(t, SECRET, { audience: "orders", issuer: "idp" })?.sub,
        not_billing: error(jwt_check(t, SECRET, { audience: "billing" })),
        no_exp: error(jwt_verify(forever, SECRET)),
        plain: jwt_verify(t, SECRET)?.aud,
        bare: error(jwt_check(bare, SECRET, { audience: "orders", issuer: "idp" })),
        no_iss: error(jwt_check(aud_only, SECRET, { audience: "orders", issuer: "idp" })),
        aud_not_text: error(jwt_check(wrong_type, SECRET, { audience: "orders", issuer: "idp" })),
        require_none: error(jwt_check(forever, SECRET, { audience: "orders", require: [] })),
        no_exp_allowed: jwt_check(lasting, SECRET, { audience: "orders", issuer: "idp", require: [] })?.sub,
        only_issuer: jwt_check(t, SECRET, { issuer: "idp" })?.sub,
    }
}

// Sign in with Apple: its token endpoint takes a client secret that is a JWT signed ES256 with
// the key you download from Apple (a .p8 file), for at most six months. APPLE_KEY holds that
// file's text; the key below was made for this example only. /apple checks the secret against
// the key's JWKS, served by this program, as a provider's tokens are checked.
let APPLE_KEY = env("APPLE_KEY") ?? "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgOJhawpknF97Wv+2S\nvjSd6d2LPN86dYF5XIWqbuN3bhyhRANCAARaRoIjU6RIDwhV02YFTbo4jRKLT7uH\nhY5Rwk+G2FwNqjA/dc4vbpIpgwg54oE11JFS6ogvJVGdK6bkg0Cukquw\n-----END PRIVATE KEY-----\n"
let APPLE_KEY_ID = env("APPLE_KEY_ID") ?? "ABC123DEFG"
let APPLE_TEAM = env("APPLE_TEAM_ID") ?? "TEAM123456"
let APPLE_CLIENT = env("APPLE_CLIENT_ID") ?? "com.example.shop.web"

fn apple_client_secret() = jwt_sign_es256({ iss: APPLE_TEAM, sub: APPLE_CLIENT, aud: "https://appleid.apple.com" }, APPLE_KEY, APPLE_KEY_ID, 180 * 86400)

route GET /apple/keys = { keys: [{ kty: "EC", crv: "P-256", alg: "ES256", use: "sig", kid: "ABC123DEFG", x: "WkaCI1OkSA8IVdNmBU26OI0Si0-7h4WOUcJPhthcDao", y: "MD91zi9ukimDCDnigTXUkVLqiC8lUZ0rpuSDQK6Sq7A" }] }

route GET /apple {
    let keys = `http://${request.headers.host}/apple/keys`
    let secret = apple_client_secret()?
    let claims = jwt_verify_jwks(secret, { jwks_url: keys, audience: "https://appleid.apple.com", issuer: APPLE_TEAM, algorithms: ["ES256"] })?
    let no_aud = jwt_sign_es256({ sub: "shop", iss: APPLE_TEAM }, APPLE_KEY, APPLE_KEY_ID, 300)?
    {
        team: claims.iss,
        client: claims.sub,
        days: (claims.exp - claims.iat) / 86400,
        provider_no_aud: error(jwt_verify_jwks(no_aud, { jwks_url: keys, audience: "https://appleid.apple.com", issuer: APPLE_TEAM })),
        not_a_key: error(jwt_sign_es256({ sub: "x" }, "not a key", "", 60)),
    }
}

route GET /check {
    let t = jwt_sign({ sub: "user-7" }, SECRET, 60)?
    { verified: jwt_verify(t, SECRET)?.sub, wrong_secret: is_err(jwt_verify(t, "another secret")), peek: jwt_peek(t)?.sub }
}

// Options are checked: a list for `audience` or `issuer` means any of them, and an option of the
// wrong type, or one not known, is an error, never a check quietly left undone.
route GET /options {
    let orders = jwt_sign({ sub: "service:shop", aud: "orders", iss: "idp" }, SECRET, 60)?
    let billing = jwt_sign({ sub: "mallory", aud: "billing", iss: "idp" }, SECRET, 60)?
    let nbf_text = jwt_sign({ sub: "mallory", aud: "orders", iss: "idp", nbf: "99999999999" }, SECRET, 60)?
    let keys = `http://${request.headers.host}/apple/keys`
    {
        listed: jwt_check(orders, SECRET, { audience: ["billing", "orders"], issuer: ["idp", "idp-2"] })?.sub,
        not_listed: error(jwt_check(billing, SECRET, { audience: ["orders"], issuer: ["idp"] })),
        audience_number: error(jwt_check(orders, SECRET, { audience: 5 })),
        audience_empty: error(jwt_check(orders, SECRET, { audience: "" })),
        misspelled: error(jwt_check(orders, SECRET, { audiance: "orders" })),
        not_for_check: error(jwt_check(orders, SECRET, { jwks_url: keys })),
        leeway_too_long: error(jwt_check(orders, SECRET, { leeway: 4000000000 })),
        nbf_not_a_number: error(jwt_check(nbf_text, SECRET, { audience: "orders" })),
        algorithms_as_text: error(jwt_verify_jwks(apple_client_secret()?, { jwks_url: keys, algorithms: "ES256" })),
        audience_unset: error(jwt_check(billing, SECRET, { audience: env("NO_SUCH_AUDIENCE"), issuer: "idp" })),
        issuer_unset: error(jwt_verify_jwks(apple_client_secret()?, { jwks_url: keys, audience: "https://appleid.apple.com", issuer: env("NO_SUCH_TEAM") })),
    }
}
