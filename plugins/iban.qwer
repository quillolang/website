//! IBANs and BICs checked (country, length, check digits) and written as banks print them.
//!
//! [dependencies]
//! iban_validate = "4"

use iban::{Iban, IbanLike};
use serde_json::{json, Value};

/// `{ iban, printed, country, bban, bank }` of a valid IBAN (spaces allowed), or an error saying what is wrong.
pub fn iban_parse(text: &str) -> Result<Value, String> {
    let i: Iban = text.parse().map_err(|e: iban::ParseIbanError| e.to_string())?;
    Ok(json!({
        "iban": i.electronic_str(), "printed": i.to_string(), "country": i.country_code(),
        "bban": i.bban(), "bank": i.bank_identifier(),
    }))
}

/// Whether `text` is a valid IBAN.
pub fn iban_valid(text: &str) -> bool {
    text.parse::<Iban>().is_ok()
}

/// Whether `text` is a well-formed BIC (SWIFT code), 8 or 11 characters.
pub fn bic_valid(text: &str) -> bool {
    // Four letters for the bank, two for the country, two letters or digits for the place, and three for a branch.
    let b: Vec<char> = text.trim().to_uppercase().chars().collect();
    (b.len() == 8 || b.len() == 11)
        && b[..6].iter().all(|c| c.is_ascii_uppercase())
        && b[6..].iter().all(|c| c.is_ascii_uppercase() || c.is_ascii_digit())
}
