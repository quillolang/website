// A Japanese shop's customer form: names typed in romaji become kana, kana names get romaji for the address label, and half-width katakana from the bank's file is cleaned up.
//
//   quillo run kana.qwe      then open http://localhost:8080/kana

use "kana.qwer"

route GET /kana {
    {
        typed: kana_from_romaji("konnichiha"),
        typed_katakana: kana_from_romaji("KOOHII"),
        romaji: kana_to_romaji("とうきょう"),
        ramen: kana_to_romaji("ラーメン"),
        hiragana: kana_to_hiragana("カタカナ", false),
        hiragana_long: kana_to_hiragana("スーパー", true),
        katakana: kana_to_katakana("ひらがな"),
        bank_name: kana_fullwidth("ﾔﾏﾀﾞ ﾀﾛｳ ｶﾞｲﾄﾞ"),
        info: kana_info("東京タワーへ行く"),
    }
}

// /furigana?name=やまだ たろう: the reading of a name as katakana for the furigana field, and romaji for the label.
route GET /furigana ? { name: str } = { katakana: kana_to_katakana(name), romaji: upper(kana_to_romaji(name)) }
