// Who may see what in a photo-sharing app, decided by Cedar policies: an allow, a forbid that wins,
// a request no policy permits, each with its reason, and policies checked against a schema.
//
//   quillo run cedar.qwe      then open http://localhost:8080/allowed, /denied, /matrix, /validate and /broken

use "cedar.qwer"

let POLICIES = `
@id("viewers-see-albums")
permit (principal in Group::"viewers", action == Action::"view", resource in Album::"holiday");

@id("owners-do-anything")
permit (principal, action, resource)
when { resource has owner && resource.owner == principal };

@id("no-private-for-contractors")
forbid (principal, action == Action::"view", resource)
when { resource.private && principal.contractor };

@id("office-hours")
permit (principal == User::"tom", action == Action::"edit", resource)
when { context.hour >= 9 && context.hour < 17 };
`

let ENTITIES = [
    { uid: { type: "User", id: "alice" }, attrs: { contractor: false }, parents: [{ type: "Group", id: "viewers" }] },
    { uid: { type: "User", id: "carl" }, attrs: { contractor: true }, parents: [{ type: "Group", id: "viewers" }] },
    { uid: { type: "User", id: "tom" }, attrs: { contractor: false }, parents: [] },
    { uid: { type: "Group", id: "viewers" }, attrs: {}, parents: [] },
    { uid: { type: "Album", id: "holiday" }, attrs: {}, parents: [] },
    { uid: { type: "Photo", id: "beach.jpg" }, attrs: { private: false, owner: { __entity: { type: "User", id: "tom" } } }, parents: [{ type: "Album", id: "holiday" }] },
    { uid: { type: "Photo", id: "tax.pdf" }, attrs: { private: true, owner: { __entity: { type: "User", id: "tom" } } }, parents: [{ type: "Album", id: "holiday" }] },
]

fn ask(who, what, res, ctx) = cedar_authorize(POLICIES, ENTITIES, { principal: who, action: what, resource: res, context: ctx }, null)

route GET /allowed = {
    viewer: ask("User::\"alice\"", "Action::\"view\"", "Photo::\"beach.jpg\"", {})?,
    owner: ask({ type: "User", id: "tom" }, "Action::\"delete\"", "Photo::\"tax.pdf\"", {})?.why,
    in_hours: ask("User::\"tom\"", "Action::\"edit\"", "Photo::\"nothing\"", { hour: 10 })?.why,
}

route GET /denied = {
    forbidden: ask("User::\"carl\"", "Action::\"view\"", "Photo::\"tax.pdf\"", {})?,
    nothing: ask("User::\"alice\"", "Action::\"delete\"", "Photo::\"beach.jpg\"", {})?.why,
    late: ask("User::\"tom\"", "Action::\"edit\"", "Photo::\"nothing\"", { hour: 22 })?.why,
    // office-hours cannot see `hour`: that policy is skipped and named among the errors.
    errors: ask("User::\"tom\"", "Action::\"edit\"", "Photo::\"nothing\"", {})?.errors,
}

route GET /matrix = cedar_matrix(POLICIES, ENTITIES, ["User::\"alice\"", "User::\"carl\""], ["Action::\"view\""], ["Photo::\"beach.jpg\"", "Photo::\"tax.pdf\""])? | map((c) => [c.principal, c.resource, c.allowed])

let SCHEMA = `
entity Group;
entity Album;
entity User in [Group] { contractor: Bool };
entity Photo in [Album] { private: Bool, owner: User };
action view, edit, delete appliesTo { principal: User, resource: [Photo, Album], context: { hour?: Long } };
`

route GET /validate = {
    good: cedar_validate("permit (principal, action == Action::\"view\", resource) when { resource.private == false };", "entity User; entity Photo { private: Bool }; action view appliesTo { principal: User, resource: Photo };")?,
    typo: cedar_validate("permit (principal, action == Action::\"view\", resource)\nwhen { resource.privat };", "entity User; entity Photo { private: Bool }; action view appliesTo { principal: User, resource: Photo };")?,
    with_schema: cedar_authorize("permit (principal, action, resource);", ENTITIES, { principal: "User::\"alice\"", action: "Action::\"view\"", resource: "Photo::\"beach.jpg\"" }, SCHEMA)?.allowed,
    wrong_entity: cedar_authorize("permit (principal, action, resource);", [{ uid: { type: "User", id: "x" }, attrs: { contractor: "no" }, parents: [] }], { principal: "User::\"x\"", action: "Action::\"view\"", resource: "Album::\"a\"" }, SCHEMA).error,
    wrong_action: cedar_authorize("permit (principal, action, resource);", [], { principal: "User::\"x\"", action: "Action::\"fly\"", resource: "Album::\"a\"" }, SCHEMA).error,
}

route GET /broken = {
    check: cedar_check("permit (principal, action, resource);\n\nforbid (principal action, resource);"),
    list: cedar_check(POLICIES).policies | map((p) => `${p.effect} ${p.id}`),
    refused: cedar_authorize("permit (", [], { principal: "User::\"a\"", action: "Action::\"b\"", resource: "C::\"d\"" }, null).error,
    bad_uid: cedar_authorize("permit (principal, action, resource);", [], { principal: "alice", action: "Action::\"b\"", resource: "C::\"d\"" }, null).error,
}
