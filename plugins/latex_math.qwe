// Formulas for a page: LaTeX turned into MathML, which browsers draw with no script or font of
// their own; a text with dollar signs in it done whole; and a mistake placed for the writer.
//
//   quillo run latex_math.qwe      then open http://localhost:8080/page, /formula, /options, /text and /mistakes

use "latex_math.qwer"

let QUADRATIC = "x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}"

route GET /page = respond(200, `<!doctype html><title>Roots</title><p>The roots are ${latex_math_block(QUADRATIC)?}</p>`, { "content-type": "text/html" })

route GET /formula = {
    inline: latex_math_mathml("x^2 + y^2 = z^2")?,
    sum: latex_math_block("\\sum_{i=1}^n i = \\frac{n(n+1)}{2}")?,
    matrix: latex_math_block("\\begin{pmatrix} a & b \\\\ c & d \\end{pmatrix}")?,
}

route GET /options = {
    xml: latex_math_render("a<b", { xml: true })?,
    source_kept: latex_math_render("E=mc^2", { annotate: true })?,
    upright: latex_math_render("x", { style: "upright" })?,
    wrong_style: latex_math_render("x", { style: "gothic" }).error,
}

// Characters that mean something in markup stay text.
route GET /escaped = {
    less: latex_math_mathml("a<b")?,
    more: latex_math_mathml("a>b")?,
    amp: latex_math_mathml("a \\& b")?,
    not_less: latex_math_mathml("a \\not< b")?,
    words: latex_math_mathml("\\text{a<b & c}")?,
    name: latex_math_mathml("\\operatorname{<img src=x onerror=alert(1)>}")?,
    source: latex_math_render("a<b", { annotate: true })?,
}

route GET /text = latex_math_text("Einstein's $E=mc^2$ cost me \\$5.\n\nAnd a block: $$\\int_0^1 x\\,dx$$ and \\(a+b\\) too.")?

route GET /mistakes = {
    unclosed: latex_math_check("\\frac{a}{b"),
    unknown: latex_math_check("x + \\notacommand y"),
    second_line: latex_math_check("a + b \\\\\nc ^ ^ d"),
    good: latex_math_check("a^2").ok,
    refused: latex_math_mathml("x^2^3").error,
    open_dollar: latex_math_text("price: $5").error,
    in_text: latex_math_text("First line.\nThen $x^$ fails.").error,
}
