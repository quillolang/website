$ORIGIN shop.example.com.
$TTL 3600
@       IN  SOA   ns1.example.net. hostmaster.shop.example.com. ( 2026102901 7200 900 1209600 300 )
@       IN  NS    ns1.example.net.
@       IN  NS    ns2.example.net.
@       IN  A     203.0.113.10
@       IN  AAAA  2001:db8::10
www     IN  CNAME shop.example.com.
@       IN  MX    10 mx1.mailer.example.
@       IN  MX    20 mx2.mailer.example.
@       IN  TXT   "v=spf1 include:_spf.mailer.example -all"
_dmarc  IN  TXT   "v=DMARC1; p=reject; rua=mailto:dmarc@shop.example.com"
_sip._tcp 300 IN SRV 10 60 5060 sip.shop.example.com.
@       IN  CAA   0 issue "letsencrypt.org"
