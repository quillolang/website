//! "Sign in with Google, GitHub or Microsoft" made safe: PKCE verifier and challenge, the state value, the authorization link, and the token request to send after the redirect.
//! version: 1.0.0
//!
//! [dependencies]
//! sha2 = "0.10"
//! base64 = "0.22"
//! rand = "0.8"
//! url = "2"

use base64::engine::general_purpose::URL_SAFE_NO_PAD;
use base64::Engine;
use rand::RngCore;
use serde_json::{json, Value};
use sha2::{Digest, Sha256};
use std::collections::HashMap;

fn random(n: usize) -> String {
    let mut b = vec![0u8; n];
    rand::rngs::OsRng.fill_bytes(&mut b);
    URL_SAFE_NO_PAD.encode(b)
}

struct Provider {
    authorize: String,
    token: String,
    scopes: &'static str,
}

fn provider(name: &str) -> Result<Provider, String> {
    let p = |a: &str, t: &str, s: &'static str| Provider { authorize: a.to_string(), token: t.to_string(), scopes: s };
    Ok(match name.to_lowercase().as_str() {
        "google" => p("https://accounts.google.com/o/oauth2/v2/auth", "https://oauth2.googleapis.com/token", "openid email profile"),
        "github" => p("https://github.com/login/oauth/authorize", "https://github.com/login/oauth/access_token", "read:user user:email"),
        "microsoft" => p("https://login.microsoftonline.com/common/oauth2/v2.0/authorize", "https://login.microsoftonline.com/common/oauth2/v2.0/token", "openid email profile"),
        other => match other.strip_prefix("microsoft:") {
            // A single tenant: "microsoft:contoso.onmicrosoft.com" or its id.
            Some(tenant) if !tenant.is_empty() && tenant.chars().all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '.') => p(
                &format!("https://login.microsoftonline.com/{}/oauth2/v2.0/authorize", tenant),
                &format!("https://login.microsoftonline.com/{}/oauth2/v2.0/token", tenant),
                "openid email profile",
            ),
            _ => return Err(format!("unknown provider `{}`: google, github, microsoft or microsoft:<tenant>", name)),
        },
    })
}

/// The SHA-256 challenge of a verifier, base64url (the `S256` method). The verifier is 43 to 128 characters of
/// `A-Z a-z 0-9 - . _ ~`, as RFC 7636 says; anything else is an error.
pub fn pkce_challenge(verifier: &str) -> Result<String, String> {
    if !(43..=128).contains(&verifier.len()) || !verifier.chars().all(|c| c.is_ascii_alphanumeric() || "-._~".contains(c)) {
        return Err("a PKCE verifier is 43 to 128 characters of A-Z a-z 0-9 - . _ ~".into());
    }
    Ok(URL_SAFE_NO_PAD.encode(Sha256::digest(verifier.as_bytes())))
}

/// A new `{ verifier, challenge, method }`: keep `verifier` in the session, send `challenge` (method "S256") in the link.
pub fn pkce_pair() -> HashMap<String, String> {
    let verifier = random(48);
    let challenge = URL_SAFE_NO_PAD.encode(Sha256::digest(verifier.as_bytes()));
    HashMap::from([("verifier".into(), verifier), ("challenge".into(), challenge), ("method".into(), "S256".into())])
}

/// A random `state` (32 bytes, base64url) to keep in the session and compare when the provider sends the visitor back.
pub fn oauth_state() -> String {
    random(32)
}

/// The link that sends the visitor to `provider` ("google", "github", "microsoft", or "microsoft:<tenant>") to sign in.
/// `scopes` empty takes the provider's usual ones for a sign-in (an email and a name). `state` and `challenge` come from
/// oauth_state and pkce_pair.
pub fn oauth_authorize_url(provider_name: &str, client_id: &str, redirect_uri: &str, scopes: Vec<String>, state: &str, challenge: &str) -> Result<String, String> {
    let p = provider(provider_name)?;
    url::Url::parse(redirect_uri).map_err(|e| format!("the redirect URI `{}` is not a URL: {}", redirect_uri, e))?;
    let scope = if scopes.is_empty() { p.scopes.to_string() } else { scopes.join(" ") };
    let u = url::Url::parse_with_params(&p.authorize, &[
        ("response_type", "code"),
        ("client_id", client_id),
        ("redirect_uri", redirect_uri),
        ("scope", scope.as_str()),
        ("state", state),
        ("code_challenge", challenge),
        ("code_challenge_method", "S256"),
    ]).map_err(|e| e.to_string())?;
    Ok(u.to_string())
}

/// The request that trades the `code` the provider sent back for tokens: `{ url, body, headers }`, to send with
/// `http.post(r.url, r.body, r.headers)`. `body` is form-encoded and carries the `verifier`.
pub fn oauth_token_request(provider_name: &str, client_id: &str, client_secret: &str, code: &str, redirect_uri: &str, verifier: &str) -> Result<Value, String> {
    let p = provider(provider_name)?;
    let mut form = url::form_urlencoded::Serializer::new(String::new());
    form.append_pair("grant_type", "authorization_code").append_pair("code", code).append_pair("redirect_uri", redirect_uri)
        .append_pair("client_id", client_id).append_pair("code_verifier", verifier);
    if !client_secret.is_empty() {
        form.append_pair("client_secret", client_secret);
    }
    Ok(json!({
        "url": p.token,
        "body": form.finish(),
        "headers": { "content-type": "application/x-www-form-urlencoded", "accept": "application/json" },
    }))
}
