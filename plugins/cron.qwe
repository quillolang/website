// A page that shows when each job runs next.
//
//   quillo run cron.qwe      then open http://localhost:8080/next?line=0+9+*+*+1-5

use "cron.qwer"

route GET /next ? { line: str } = cron_next(line, 5, 0)? | map((ms) => date.format(date.from_ms(ms), "yyyy-MM-dd HH:mm"))
route GET /fixed = { runs: cron_next("30 2 * * *", 2, 1767225600000)?, valid: cron_valid("*/15 * * * *"), invalid: cron_valid("61 * * * *") }
