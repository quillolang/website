// A running club's site: members upload their watch's FIT file; the run is summed up (distance,
// time, pace, heart rate, ascent), its laps listed, its track turned into points for a map and
// into GPX for other apps.
//
//   quillo run fit.qwe      then open http://localhost:8080/run and http://localhost:8080/track.gpx

use "fit.qwer"

let FILE = "fit_sample.fit"

route GET /run = { summary: fit_summary(FILE)?, laps: fit_laps(FILE)? }

route GET /points = { first: slice(fit_records(FILE, 1)?, 0, 2), every_minute: len(fit_records(FILE, 12)?) }

route GET /track.gpx = respond(200, fit_gpx(FILE, "Thames loop")?, { "content-type": "application/gpx+xml" })

route GET /session = fit_messages(FILE, "session")?
