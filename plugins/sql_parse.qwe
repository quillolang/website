// A reports page where analysts write their own SQL: only reads are let through, and each query
// is shown with the tables it touches; and a slow-query log grouped by fingerprint.
//
//   quillo run sql_parse.qwe      then open http://localhost:8080/report?sql=select%20*%20from%20orders

use "sql_parse.qwer"

route GET /report ? { sql: str } {
    if !sql_read_only(sql, "postgresql") { reply 403 { error: "only SELECT queries here", tables: sql_tables(sql, "postgresql") } }
    { ok: true, reads: sql_tables(sql, "postgresql").reads }         // the query would run here, on a read-only connection
}

route GET /tables = sql_tables("with recent as (select * from orders where day > now() - interval '7 days')
    insert into weekly_totals (customer_id, total) select r.customer_id, sum(r.total) from recent r join customers c on c.id = r.customer_id group by 1", "postgresql")

route GET /check = {
    mysql: sql_valid("SELECT `name` FROM users LIMIT 5, 10", "mysql").ok,
    postgres: sql_valid("SELECT `name` FROM users LIMIT 5, 10", "postgresql").ok,
    typo: sql_valid("SELEC name FROM users", "").error,
    delete_is_read_only: sql_read_only("delete from orders", ""),
}

route GET /slow {
    let log = ["select * from users where id = 7", "SELECT * FROM users WHERE id = 42", "select * from orders where total > 100.5 and status = 'paid'"]
    log | group_by((q) => sql_fingerprint(q, "")?) | keys
}
