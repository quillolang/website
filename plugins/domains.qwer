//! Domain names read by the Public Suffix List: the registrable domain of "shop.example.co.uk" is "example.co.uk", its subdomain "shop"; and international names to punycode ("münchen.de" is "xn--mnchen-3ya.de") and back.
//! version: 1.0.0
//!
//! [dependencies]
//! psl = "2"
//! idna = "1"

use serde_json::{json, Value};

/// The host of a URL or a host name: no scheme, user, port, path or trailing dot, lower case, in ASCII (punycode).
fn host(input: &str) -> Result<String, String> {
    let mut s = input.trim();
    if s.len() > 2000 {
        return Err("names up to 2,000 characters".into());
    }
    if let Some(i) = s.find("://") {
        s = &s[i + 3..];
    }
    s = s.split(['/', '?', '#']).next().unwrap_or("");
    if let Some(i) = s.rfind('@') {
        s = &s[i + 1..];
    }
    if !s.starts_with('[') {
        s = s.split(':').next().unwrap_or("");
    }
    let s = s.trim_end_matches('.');
    if s.is_empty() {
        return Err(format!("no host in {:?}", input));
    }
    idna::domain_to_ascii(s).map_err(|_| format!("{:?} is not a valid domain name", s))
}

fn parts(h: &str) -> Value {
    let suffix = psl::suffix(h.as_bytes());
    let domain = psl::domain(h.as_bytes());
    let suffix_s = suffix.map(|x| String::from_utf8_lossy(x.as_bytes()).into_owned());
    let domain_s = domain.map(|x| String::from_utf8_lossy(x.as_bytes()).into_owned());
    let sub = domain_s.as_ref().and_then(|d| h.strip_suffix(d.as_str())).map(|s| s.trim_end_matches('.').to_string()).filter(|s| !s.is_empty());
    json!({
        "host": h,
        "unicode": idna::domain_to_unicode(h).0,
        "registrable": domain_s,
        "subdomain": sub,
        "suffix": suffix_s,
        "suffix_known": suffix.map_or(false, |x| x.is_known()),
        "private_suffix": suffix.and_then(|x| x.typ()) == Some(psl::Type::Private),
    })
}

/// The parts of a host, or of a URL's host: `{ host, unicode, registrable, subdomain, suffix, suffix_known, private_suffix }`. "a.b.example.co.uk" has registrable "example.co.uk", subdomain "a.b" and suffix "co.uk". Suffixes run by companies count too ("github.io", "herokuapp.com": `private_suffix` true), so "me.github.io" is a site of its own. `registrable` is null for a bare suffix ("co.uk") or an IP address.
pub fn domain_parse(name: &str) -> Result<Value, String> {
    let h = host(name)?;
    if h.parse::<std::net::IpAddr>().is_ok() || h.starts_with('[') {
        return Ok(json!({ "host": h, "unicode": h, "registrable": null, "subdomain": null, "suffix": null, "suffix_known": false, "private_suffix": false }));
    }
    Ok(parts(&h))
}

/// The registrable domain ("eTLD+1") of a host or URL, or null: what cookies, rate limits and "same site" checks should group by.
pub fn domain_registrable(name: &str) -> Result<Option<String>, String> {
    Ok(domain_parse(name)?["registrable"].as_str().map(String::from))
}

/// Whether two hosts or URLs are the same site, sharing a registrable domain: "app.example.com" and "www.example.com" are; "a.github.io" and "b.github.io" are not.
pub fn domain_same_site(a: &str, b: &str) -> Result<bool, String> {
    let (x, y) = (domain_registrable(a)?, domain_registrable(b)?);
    Ok(x.is_some() && x == y)
}

/// An international domain name in ASCII (punycode) for DNS, certificates and links: "bücher.example" is "xn--bcher-kva.example". Lower-cases and checks it; an error when it cannot be a name.
pub fn domain_to_ascii(name: &str) -> Result<String, String> {
    host(name)
}

/// A punycode name back in its own letters, for showing it: "xn--mnchen-3ya.de" is "münchen.de". Labels that do not decode stay as they were.
pub fn domain_to_unicode(name: &str) -> String {
    idna::domain_to_unicode(name.trim()).0
}
