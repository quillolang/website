// The headers of an old PHP site graded, and this app's own answers sent with a good set.
//
//   quillo run security_headers.qwe      then open http://localhost:8080/grade

use "security_headers.qwer"

let HEADERS = security_headers_recommended({ hsts_preload: true })

// Every page of this app carries the recommended headers.
route GET / = respond(200, "Hello, safely.", { ...HEADERS, "content-type": "text/plain" })

// What curl -I https://legacy.example.com printed.
let LEGACY = {
    "Server": "Apache/2.4.29 (Ubuntu)",
    "X-Powered-By": "PHP/7.2.24",
    "Strict-Transport-Security": "max-age=3600",
    "X-XSS-Protection": "1; mode=block",
    "Referrer-Policy": "unsafe-url",
    "Set-Cookie": "PHPSESSID=8d1f0c2b; path=/\ntheme=dark; Path=/; Secure; HttpOnly; SameSite=Lax",
}

route GET /grade = {
    legacy: security_headers_check(LEGACY, true),
    ours: security_headers_check(HEADERS, true),
}

route GET /headers = HEADERS
