// A shop's settings in .env files: read with quoting and expansion, checked against .env.example, linted, and one
// key changed for a deploy with the comments kept.
//
//   quillo run dotenv.qwe      then open http://localhost:8080/settings

use "dotenv.qwer"

route GET /settings = dotenv_read_file("dotenv_sample.env")?

// Before starting: what the example asks for that this file lacks.
route GET /compare = dotenv_compare(read_file("dotenv_example.env")?, read_file("dotenv_sample.env")?)?

// The production file: a new database host and a secret, written in place.
route GET /deploy {
    let text = read_file("dotenv_sample.env")?
    let text = dotenv_set(text, "DB_HOST", "db.internal")?
    let text = dotenv_set(text, "STRIPE_SECRET_KEY", "sk_live_$ecret value")?
    let text = dotenv_unset(text, "PRIVATE_KEY")?
    write_file("data/production.env", text)
    { text: text, url: dotenv_parse(text)?.DATABASE_URL, stripe: dotenv_parse(text)?.STRIPE_SECRET_KEY }
}

route GET /lint = dotenv_check("API_KEY=abc\napi_secret=two words\nAPI_KEY=def\nLINK=${HOST}/x\nBAD LINE")

route GET /write = respond(200, dotenv_write({ NAME: "Café \"Le Coin\"", PORT: 8080, PATH_HINT: "$HOME/bin", DEBUG: true })?, { "content-type": "text/plain; charset=utf-8" })
