// A warehouse robot's way from the dock to a shelf, around the racks, and how far it can get
// on what is left of its battery; the floor plan is text.
//
//   quillo run grid_paths.qwe      then open http://localhost:8080/route

use "grid_paths.qwer"

let FLOOR = [
    "S.........",
    ".####.###.",
    ".#.......3",
    ".#.####.#.",
    "...#..#.#.",
    "####..#..G",
]

route GET /route ? { diagonal: bool = false } {
    let start = grid_find(FLOOR, "S")?[0]
    let goal = grid_find(FLOOR, "G")?[0]
    let p = grid_path(FLOOR, start, goal, diagonal)?
    if p == null { reply 404 { error: "the shelf cannot be reached" } }
    { steps: p.steps, cost: p.cost, drawn: grid_draw(FLOOR, p.path, "*")? }
}

route GET /battery ? { left: float = 4.0 } = { cells: len(grid_reachable(FLOOR, [0, 0], left, false)?) }

route GET /blocked = { path: grid_path(["S#.", "##.", "..G"], [0, 0], [2, 2], true)? }
