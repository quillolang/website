// Calling AWS APIs with Quillo's own HTTP client: the request signed with Signature V4,
// checked here against AWS's published examples.
//
//   AWS_ACCESS_KEY_ID=... AWS_SECRET_ACCESS_KEY=... quillo run aws_sign.qwe      then open http://localhost:8080/iam

use "aws_sign.qwer"

// The IAM ListUsers request of AWS's Signature V4 documentation.
route GET /iam {
    let h = aws_sign_headers({ method: "GET", url: "https://iam.amazonaws.com/?Action=ListUsers&Version=2010-05-08",
        headers: { "content-type": "application/x-www-form-urlencoded; charset=utf-8" }, body: "" },
        { access_key: "AKIDEXAMPLE", secret_key: "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY" }, "us-east-1", "iam", "20150830T123600Z")?
    { authorization: h.authorization, date: h["x-amz-date"] }
}

// The presigned GET of S3's documentation (examplebucket/test.txt, a day).
route GET /presigned = { url: aws_presign_url("GET", "https://examplebucket.s3.amazonaws.com/test.txt",
    { access_key: "AKIAIOSFODNN7EXAMPLE", secret_key: "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY" }, "us-east-1", "s3", 86400, "20130524T000000Z")? }

// A message sent with SES (v2 API), credentials from AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
route GET /ses ? { to: str = "ada@example.com", send: bool = false } {
    let url = "https://email.eu-west-1.amazonaws.com/v2/email/outbound-emails"
    let body = json.stringify({
        FromEmailAddress: "shop@example.com", Destination: { ToAddresses: [to] },
        Content: { Simple: { Subject: { Data: "Welcome" }, Body: { Text: { Data: "Thanks for signing up." } } } },
    })
    let headers = aws_sign_headers({ method: "POST", url, headers: { "content-type": "application/json" }, body }, null, "eu-west-1", "ses", "")?
    if !send { return { signed_headers: keys(headers), body_sha256: aws_payload_hash(body) } }
    http.post(url, body, headers)
}
