// A YubiKey as a second factor, both ways: a server of your own decrypting the token with the key's
// AES secret and refusing a replay, and the YubiCloud call with its signed answer checked.
//
//   YUBICO_CLIENT_ID=... YUBICO_SECRET_KEY=... quillo run yubico_otp.qwe
//   then open http://localhost:8080/modhex, /own, /own-failures, /cloud and /cloud-failures
//
// The client id and key come from upgrade.yubico.com/getapikey. YUBICO_API_URL reaches a test server.

use "yubico_otp.qwer"

// The soft token below stands for a real key; a YubiKey makes these same OTPs.
let PUBLIC_ID = "vvccccfiluij"
let AES_KEY = "2b7e151628aed2a6abf7158809cf4f3c"
let PRIVATE_ID = "010203040506"

fn token(counter, session_use) = yubico_otp_make(PUBLIC_ID, AES_KEY, { uid: PRIVATE_ID, counter, session_use, timestamp: 70000, random: 4242 })

route GET /modhex = {
    encoded: yubico_modhex_encode("0123456789abcdef")?,
    decoded: yubico_modhex_decode("cbdefghijklnrtuv")?,
    dvorak: yubico_modhex_decode("jxe.uidchtnbpygk")?,
    odd: yubico_modhex_decode("cbd").error,
    letter: yubico_modhex_decode("zz").error,
    parts: yubico_otp_parse("ccccccnrhbfu" + "cbdefghijklnrtuvcbdefghijklnrtuv")?,
}

route GET /own {
    let otp = token(7, 1)?
    let first = yubico_otp_check(otp, AES_KEY, PRIVATE_ID, null)?
    let next = yubico_otp_check(token(7, 2)?, AES_KEY, PRIVATE_ID, first.state)?
    let later = yubico_otp_check(token(8, 0)?, AES_KEY, PRIVATE_ID, next.state)?
    { length: len(otp), public: first.public_id, uid: first.uid, counter: first.counter, use: next.session_use, time: first.timestamp, random: first.random, state: later.state, upper: yubico_otp_decrypt(upper(otp), AES_KEY)?.counter }
}

route GET /own-failures {
    let otp = token(9, 3)?
    let good = yubico_otp_check(otp, AES_KEY, PRIVATE_ID, null)?
    {
        replay: yubico_otp_check(otp, AES_KEY, PRIVATE_ID, good.state).error,
        older: yubico_otp_check(token(9, 2)?, AES_KEY, PRIVATE_ID, good.state).error,
        wrong_key: yubico_otp_decrypt(otp, "00000000000000000000000000000000").error,
        wrong_uid: yubico_otp_check(otp, AES_KEY, "aaaaaaaaaaaa", null).error,
        typo: yubico_otp_decrypt(slice(otp, 0, len(otp) - 1) + "c", AES_KEY).error,
        short: yubico_otp_decrypt("cccc", AES_KEY).error,
        key_size: yubico_otp_decrypt(otp, "abcd").error,
    }
}

route GET /cloud {
    let good = yubico_verify(token(21, 1)?, { sl: 50, timeout: 8 })?
    let used = yubico_verify(token(21, 1)?, {})?
    { good: good, used: used.ok, status: used.status, meaning: used.meaning }
}

// A stand-in that lies: answers unsigned, forged, for another OTP, or with an old nonce.
route GET /cloud-failures = {
    forged: yubico_verify(token(31, 1)?, {}).error,
    other_otp: yubico_verify(token(32, 1)?, {}).error,
    old_nonce: yubico_verify(token(33, 1)?, {}).error,
    unsigned: yubico_verify(token(34, 1)?, {}).error,
    backend: yubico_verify(token(35, 1)?, {}).error,
}
