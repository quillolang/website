// A code-scanning report read, summed up and joined with a second tool's: what a CI page shows,
// and what is new since the main branch, the only thing worth failing a pull request on.
//
//   quillo run sarif.qwe      then open http://localhost:8080/report, /summary, /build, /merge, /new and /broken

use "sarif.qwer"

let TEXT = read_file("sarif_sample.sarif")

route GET /report {
    let r = sarif_read(TEXT)?
    {
        tool: r.runs[0].tool, version: r.runs[0].version, rules: len(r.runs[0].rules),
        results: r.results | map((x) => `${x.level} ${x.rule} ${x.file}:${x.line}`),
        first: r.results[0].message, snippet: r.results[0].snippet, unused: r.results[1].rule_name,
        braces: r.results[2].message, span: [r.results[2].line, r.results[2].end_line],
        pass: [r.results[4].level, r.results[4].kind, r.results[4].message],
        errors: sarif_results(TEXT, { min_level: "error" })? | map((x) => x.line),
        in_auth: len(sarif_results(TEXT, { path: "src/auth", suppressed: true })?),
    }
}

route GET /summary = sarif_summary(TEXT)?

let TOOL = {
    name: "quillo-lint", version: "0.1.0", uri: "https://example.org/lint",
    rules: [{ id: "Q1", name: "NoEval", summary: "eval on input", level: "error", help: "https://example.org/Q1" }],
}
let FOUND = [
    { rule: "Q1", message: "eval of a request field", file: "app/my page.qwe", line: 12, column: 3, end_column: 20, snippet: "eval(x)", fingerprint: "f1" },
    { rule: "Q2", level: "warning", message: "route with no guard", file: "app/main.qwe", line: 3 },
    { rule: "Q1", message: "eval again", file: "app/my page.qwe", line: 40, suppressed: true },
]

route GET /build {
    let text = sarif_build(TOOL, FOUND)?
    let back = sarif_read(text)?
    {
        uri: json.parse(text).runs[0].artifacts[0].location.uri,
        levels: back.results | map((x) => [x.rule, x.level, x.file, x.line, x.column, x.suppressed]),
        rules: back.runs[0].rules | map((x) => [x.id, x.level]),
        no_message: sarif_build(TOOL, [{ rule: "Q1" }]).error,
        bad_level: sarif_build(TOOL, [{ message: "x", level: "fatal" }]).error,
        no_line_zero: sarif_build(TOOL, [{ message: "x", file: "a", line: 0 }]).error,
    }
}

route GET /merge {
    let mine = sarif_build(TOOL, FOUND)?
    let again = sarif_build(TOOL, [FOUND[1], { rule: "Q3", message: "one more", file: "app/main.qwe", line: 9 }])?
    let log = sarif_merge([TEXT, mine, again])?
    let m = sarif_read(log)?
    let run = json.parse(log).runs[1]
    {
        runs: m.runs | map((r) => [r.tool, r.results, len(r.rules)]),
        last: [run.results[3].ruleId, run.results[3].ruleIndex, run.tool.driver.rules[run.results[3].ruleIndex].id],
        artifacts: run.artifacts | map((a) => a.location.uri),
        indexes: run.results | map((r) => r.locations[0].physicalLocation.artifactLocation.index),
    }
}

route GET /new {
    let base = sarif_build(TOOL, FOUND)?
    let head = sarif_build(TOOL, [FOUND[0], { rule: "Q9", level: "error", message: "fresh", file: "app/new.qwe", line: 1 }])?
    let d = sarif_diff(base, head)?
    { new: d.new | map((x) => x.rule), fixed: d.fixed | map((x) => x.message), unchanged: d.unchanged }
}

route GET /broken = {
    not_json: sarif_read("{").error,
    old: sarif_read("{\"version\":\"1.0.0\",\"runs\":[]}").error,
    no_runs: sarif_read("{\"version\":\"2.1.0\"}").error,
    bad_filter: sarif_results(TEXT, { min_level: "fatal" }).error,
    nothing: sarif_merge([]).error,
    missing: sarif_read_file("nothing.sarif").error,
}
