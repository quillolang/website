// Gemini from a Quillo program: a question with a system instruction, a stream, a function call
// answered and sent back, embeddings, and what a blocked prompt looks like.
//
//   GEMINI_API_KEY=... GEMINI_MODEL=gemini-2.5-flash quillo run gemini.qwe
//   then open http://localhost:8080/ask, /stream, /tools, /embed, /count, /models and /failures
//
// GEMINI_API_URL points it at another address, a proxy or a test server.

use "gemini.qwer"

let weather = gemini_function("get_weather", "The weather in a city", {
    type: "object", properties: { city: { type: "string" } }, required: ["city"],
})

route GET /ask = { answer: gemini_ask("Name a prime number.", "Answer in one word.", {})? }

route GET /stream {
    let r = gemini_stream({ contents: "Write a haiku", system: "Be brief." }, {})?
    { text: r.text, finish: r.finish_reason, tokens: r.usage.totalTokenCount }
}

route GET /tools {
    let tools = gemini_tools([weather])
    let contents = [{ role: "user", parts: [{ text: "Weather in Paris?" }] }]
    let first = gemini_generate({ contents: contents, tools: tools }, {})?
    let call = first.function_calls[0]
    let answer = gemini_function_response(call.id ?? "", call.name, { city: call.args.city, celsius: 18 })
    let second = gemini_generate({ contents: gemini_continue(contents, first, [answer])?, tools: tools }, {})?
    { city: call.args.city, answer: second.text, unanswered: gemini_continue(contents, first, []).error }
}

route GET /embed {
    let one = gemini_embed("hello", { task_type: "RETRIEVAL_QUERY", dimensions: 3 })?
    let many = gemini_embed_batch(["a", "bb", "ccc"], { task_type: "RETRIEVAL_DOCUMENT", dimensions: 3 })?
    { one: one, count: len(many), third: many[2] }
}

route GET /count = {
    plain: gemini_count_tokens("How many tokens?", {})?,
    with_system: gemini_count_tokens({ contents: "How many tokens?", system: "Be brief." }, {})?,
}

route GET /models {
    let all = gemini_models({})?
    { count: len(all), last: all[len(all) - 1].name }
}

route GET /failures = {
    retried: gemini_ask("slow down", "", {})?,
    blocked: gemini_ask("blocked prompt", "", {}).error,
    safety: gemini_ask("unsafe answer", "", {}).error,
    cut_off: gemini_ask("too long", "", {}).error,
    unknown: gemini_ask("Hi", "", { model: "gemini-none" }).error,
    bad_key: gemini_ask("Hi", "", { api_key: "wrong" }).error,
}
