// A mortgage calculator, a savings plan and an investment's return: the numbers a bank's
// website shows, worked out on the server.
//
//   quillo run finance.qwe      then open http://localhost:8080/mortgage?amount=300000&rate=4.5&years=30

use "finance.qwer"

route GET /mortgage ? { amount: float, rate: float, years: int, extra: float = 0.0 } {
    let s = finance_schedule(amount, rate, years * 12, extra)?
    { monthly: finance_payment(amount, rate, years * 12)?, months: s.months, interest: s.total_interest, first: s.rows[0], last: s.rows[len(s.rows) - 1] }
}

route GET /savings ? { start: float = 1000.0, monthly: float = 200.0, rate: float = 5.0, years: float = 10.0 } = finance_compound(start, rate, years, 12, monthly)?

// A machine costing 10,000 that saves 3,000 a year for five years.
route GET /machine = { npv_at_8: finance_npv(8.0, [-10000, 3000, 3000, 3000, 3000, 3000])?, irr: finance_irr([-10000, 3000, 3000, 3000, 3000, 3000])?, never: finance_irr([100, 200]).error }
