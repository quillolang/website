// A local model through Ollama: a generate and a chat with their timings, a tool call, embeddings,
// what is installed and loaded, a pull, and what a missing model and a stopped server look like.
//
//   ollama serve; ollama pull llama3.2; ollama pull nomic-embed-text
//   OLLAMA_MODEL=llama3.2 quillo run ollama.qwe
//   then open http://localhost:8080/ask, /generate, /chat, /tools, /embed, /models and /failures
//
// OLLAMA_HOST is read as Ollama reads it: box.local, 127.0.0.1:11434 or http://box:11434.

use "ollama.qwer"

route GET /ask = { answer: ollama_ask("", "Name a prime number.", "Answer in one word.", { temperature: 0 })? }

route GET /generate {
    let r = ollama_generate("", "Why is the sky blue?", { num_predict: 20, seed: 7 })?
    { text: r.text, reason: r.done_reason, tokens: r.stats.output_tokens, speed: r.stats.tokens_per_second }
}

// A conversation: the assistant's message goes back in the next turn.
route GET /chat {
    let question = { role: "user", content: "Hi" }
    let first = ollama_chat("", [question], {})?
    let second = ollama_chat("", [question, first.message, { role: "user", content: "Again" }], {})?
    { first: first.text, second: second.text }
}

route GET /json {
    let r = ollama_generate("", "Give me a city as JSON", { format: { type: "object", properties: { city: { type: "string" } }, required: ["city"] } })?
    { city: json.parse(r.text).city }
}

route GET /tools {
    let tools = [ollama_tool("get_weather", "The weather in a city", { type: "object", properties: { city: { type: "string" } } })]
    let question = { role: "user", content: "Weather in Paris?" }
    let first = ollama_chat("", [question], { tools: tools })?
    let call = first.tool_calls[0]
    let result = { role: "tool", tool_name: call.name, content: "18 C" }
    let second = ollama_chat("", [question, first.message, result], { tools: tools })?
    { called: call.name, city: call.arguments.city, answer: second.text }
}

route GET /embed {
    let e = ollama_embed("nomic-embed-text", ["first", "second"], {})?
    { count: len(e.vectors), first: e.vectors[0], tokens: e.prompt_tokens }
}

route GET /models = {
    version: ollama_version({})?,
    installed: map(ollama_models({})?, (m) => { name: m.name, gb: m.size_gb, family: m.family }),
    running: map(ollama_running({})?, (m) => m.name),
    has_llama: ollama_has("llama3.2", {})?,
    has_other: ollama_has("mistral", {})?,
    context: ollama_show("llama3.2", {})?.context_length,
}

route GET /pull = { steps: ollama_pull("tinyllama", {})? }

route GET /failures = {
    missing: ollama_ask("no-such-model", "Hi", "", {}).error,
    part_way: ollama_ask("", "fail part way", "", {}).error,
    stopped: ollama_version({ host: "127.0.0.1:9" }).error,
    bad_pull: ollama_pull("no-such-model", {}).error,
}
