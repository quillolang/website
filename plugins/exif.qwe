// A photo library that reads where and when each photo was taken, and with what.
//
//   quillo run exif.qwe      then open http://localhost:8080/photo

use "exif.qwer"

let PHOTO = "exif_sample.jpg"

route GET /photo {
    let e = exif_read(PHOTO)? ?? reply 404 "This photo carries no EXIF"
    {
        camera: `${e.make} ${e.model}`,
        taken: e.taken,
        settings: `${e.exposure} s at f/${e.f_number}, ISO ${e.iso}, ${e.focal_length} mm`,
        gps: e.gps,
        map: e.gps == null ? null : `https://www.openstreetmap.org/?mlat=${e.gps.lat}&mlon=${e.gps.lon}#map=16/${e.gps.lat}/${e.gps.lon}`,
    }
}

route GET /gps = exif_gps(PHOTO)
route GET /tags = exif_tags(PHOTO)
route GET /none = { exif: exif_read("exif_sample.png")?, gps: exif_gps("exif_sample.png")? }
