// A restaurant's booking texts through an SMS gateway over SMPP: a confirmation sent with a
// delivery receipt asked for, a long reminder that goes in parts, a question whose answer comes
// back from the phone, the receipts and replies drained by an `every` tick, and a wrong password.
//
//   SMPP_HOST=smsc.example.net:2775 SMPP_SYSTEM_ID=quillo SMPP_PASSWORD=secret quillo run smpp.qwe
//   then open http://localhost:8080/send, /long, /ask and /receipts
//
// Needs an SMSC (your SMS provider's SMPP account, or a simulator) at SMPP_HOST. SMPP_TLS=1 and
// SMPP_CA for SMPP over TLS.

use "smpp.qwer"

let HOST = env("SMPP_HOST", "127.0.0.1:2775")

fn link() = smpp_bind("sms", HOST, {
    system_id: env("SMPP_SYSTEM_ID", "quillo"),
    password: env("SMPP_PASSWORD", ""),
    mode: "transceiver",
    enquire_link: 30,
    buffer: 1000,
    tls: env("SMPP_TLS", "") == "1",
    ca: env("SMPP_CA", ""),
    timeout_ms: 5000,
})

// Receipts and replies, taken off the session twice a second.
let receipts = []
let replies = []
fn drain() {
    let got = smpp_receive("sms", 100, 0) ?? []
    for m in got {
        if m.kind == "receipt" { receipts = receipts + [{ id: m.receipt.id, stat: m.receipt.stat, delivered: m.receipt.delivered }] }
        else { replies = replies + [{ from: m.from, text: m.text, encoding: m.encoding }] }
    }
}
every(500, drain)

route GET /send {
    link()?
    smpp_submit("sms", "QuilloCafe", "+447700900123", "Your table for 2 is booked for 19:30 tonight. Reply STOP to opt out.", { receipt: true })?
}

route GET /long {
    link()?
    let text = "Reminder: your table at Quillo Café is booked for 19:30 tonight, for 4 people. A deposit of €20 was taken {ref BK-2207}. " + "If you are running late, we keep the table for 15 minutes; after that it may be given to guests waiting at the bar. " + "To change the booking, reply with the new time or call us. Thank you!"
    let sent = smpp_submit("sms", "QuilloCafe", "+447700900123", text, {})?
    { parts: sent.parts, encoding: sent.encoding, ids: len(sent.message_ids), characters: len(text) }
}

// A question: the answer comes back as a deliver_sm, in UCS-2 here since it has an emoji.
route GET /ask {
    link()?
    let before = len(replies)
    smpp_submit("sms", "+447700900001", "+447700900123", "Can you come at 10?", { receipt: false })?
    let waited = 0
    while len(replies) == before && waited < 30 {
        sleep(100)
        waited += 1
    }
    len(replies) > before ? replies[len(replies) - 1] : { reply: null }
}

route GET /receipts {
    let waited = 0
    while len(receipts) == 0 && waited < 30 {
        sleep(100)
        waited += 1
    }
    { count: len(receipts), first: len(receipts) > 0 ? receipts[0] : null, status: smpp_status("sms")? }
}

route GET /wrong-password = { error: smpp_bind("intruder", HOST, { system_id: "quillo", password: "guess", timeout_ms: 3000 }).error }

// No network: how texts are split and encoded.
route GET /parts = {
    plain: smpp_parts("See you at 19:30!", {})?,
    euro: smpp_parts("Deposit: €20 [paid]", {}).units,
    emoji: smpp_parts("See you 👍", {})?,
    packed: smpp_parts("hello", { packed: true }).parts,
    long: smpp_parts(join(for i in 0..40 => "word", " "), {}).count,
    not_gsm: smpp_parts("Привет", { encoding: "gsm" }).error,
}
