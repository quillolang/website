// A bot on GitHub: issues opened and commented on, pull requests read and merged, a check run on a
// commit, every list followed to its end, a webhook believed only when signed, and acting as a
// GitHub App through an installation token.
//
//   GITHUB_TOKEN=... GITHUB_REPO=owner/name GITHUB_WEBHOOK_SECRET=... quillo run github_api.qwe
//   then open http://localhost:8080/issues, /pull, /checks, /app, /hook-check and /failures
//
// As an App: GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY (the .pem's text) and GITHUB_INSTALLATION_ID.
// GITHUB_API_URL is the address of GitHub Enterprise, or a test server.

use "github_api.qwer"

let REPO = env("GITHUB_REPO", "octo/shop")
let SECRET = env("GITHUB_WEBHOOK_SECRET", "")

route GET /issues {
    let issue = github_issue_create(REPO, { title: "Checkout is slow", body: "Since Tuesday.", labels: ["bug"] }, {})?
    github_comment(REPO, issue.number, "Looking into it.", {})?
    github_comment(REPO, issue.number, "Fixed in 2.4.", {})?
    let closed = github_issue_update(REPO, issue.number, { state: "closed", state_reason: "completed" }, {})?
    let open = github_issues(REPO, { state: "open" })?
    {
        number: issue.number,
        state: closed.state,
        comments: map(github_comments(REPO, issue.number, {})?, (c) => c.body),
        open_issues: len(open),
        first_three: len(github_issues(REPO, { state: "open", max_items: 3 })?),
        any_pull: len(filter(open, (i) => i.pull_request != null)),
    }
}

route GET /pull {
    let pr = github_pr_create(REPO, { title: "Faster checkout", head: "fast", base: "main", body: "Closes #1" }, {})?
    let files = github_pr_files(REPO, pr.number, {})?
    let merged = github_pr_merge(REPO, pr.number, { merge_method: "squash", sha: pr.head.sha }, {})?
    {
        number: pr.number,
        files: map(files, (f) => f.filename),
        merged: merged.merged,
        open: len(github_prs(REPO, { state: "open" })?),
        stale: github_pr_merge(REPO, pr.number, { sha: "0000" }, {}).error,
    }
}

route GET /checks {
    let token = github_installation_token(int(env("GITHUB_INSTALLATION_ID", "0")), {})?
    let o = { token: token }
    let sha = "9fceb02d0ae598e95dc970b74767f19372d61af8"
    let run = github_check_create(REPO, { name: "lint", head_sha: sha, status: "in_progress" }, o)?
    let notes = map(range(0, 120), (i) => { path: "a.qwe", start_line: i + 1, end_line: i + 1, annotation_level: "warning", message: "long line" })
    let done = github_check_update(REPO, run.id, { status: "completed", conclusion: "success", output: { title: "Lint", summary: "120 notes", annotations: notes } }, o)?
    {
        status: run.status,
        conclusion: done.conclusion,
        notes: done.output.annotations_count,
        runs: len(github_check_runs(REPO, sha, o)?),
        no_conclusion: github_check_create(REPO, { name: "x", head_sha: sha, status: "completed" }, o).error,
    }
}

// The token is kept: the second call must not make another.
route GET /app {
    let id = int(env("GITHUB_INSTALLATION_ID", "0"))
    let jwt = github_app_jwt("", "")?
    {
        jwt_parts: len(split(jwt, ".")),
        same: github_installation_token(id, {})? == github_installation_token(id, {})?,
        bad_key: github_app_jwt("1", "not a key").error,
    }
}

route GET /rate {
    let r = github_request("GET", `/repos/${REPO}`, null, {})?
    let all = github_rate_limit({})?
    { remaining: r.rate.remaining, resource: r.rate.resource, core: all.core.limit }
}

route POST /github/hook {
    let hook = github_webhook(request.headers, request.body, SECRET)
    if is_err(hook) { reply 401 hook.error }
    { event: hook.event, action: hook.action, repo: hook.repository }
}

// GitHub's own example from "Validating webhook deliveries": this body and secret give this value.
route GET /hook-check {
    let body = "Hello, World!"
    let key = "It's a Secret to Everybody"
    let sig = "sha256=757107ea0eb2509fc211221cce984b8a37570b6d7586c22c46f4379c8b043e17"
    let headers = { "X-Hub-Signature-256": sig, "X-GitHub-Event": "ping", "X-GitHub-Delivery": "72d3162e" }
    {
        good: github_signature_ok(body, sig, key),
        tampered: github_signature_ok(body + "!", sig, key),
        no_secret: github_signature_ok(body, sig, ""),
        not_json: github_webhook(headers, body, key).error,
        wrong_secret: github_webhook(headers, body, "other").error,
        unsigned: github_webhook({}, body, key).error,
    }
}

route GET /failures = {
    validation: github_issue_create(REPO, { body: "no title" }, {}).error,
    missing: github_issue(REPO, 9999, {}).error,
    bad_token: github_issue(REPO, 1, { token: "wrong" }).error,
    bad_repo: github_issue("just-a-name", 1, {}).error,
    secondary: github_comment(REPO, 1, "secondary limit", {})?.body,
    primary: github_comment(REPO, 1, "spent", { max_wait_s: 0 }).error,
    no_branch: github_pr_create(REPO, { title: "x", head: "", base: "main" }, {}).error,
    elsewhere: github_request("GET", "https://evil.example/x", null, {}).error,
}
