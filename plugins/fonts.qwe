// A font picker's checks: what an uploaded font is, whether it can write a customer's name, and how wide a title is.
//
//   quillo run fonts.qwe      then open http://localhost:8080/font

use "fonts.qwer"

let FONT = "fonts_sample.ttf"

route GET /font = font_info(FONT)

route GET /covers ? { text: str = "Quillo Café" } = font_covers(FONT, text)

route GET /ranges = font_ranges(FONT)

// Shrink a title until it fits 600 px.
route GET /fit ? { title: str = "Spring Menu Tasting Evening" } {
    let size = 96
    for step in range(20) {
        if font_text_width(FONT, title, size)? > 600 { size = size - 8 }
    }
    { title, size, width: font_text_width(FONT, title, size)? }
}
