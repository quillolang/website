//! Zip files made and opened: exports of several files, uploads of a folder, backups. Unpacking never writes outside its folder.
//!
//! [dependencies]
//! zip = { version = "2", default-features = false, features = ["deflate"] }

use serde_json::{json, Value};
use std::fs::File;
use std::path::Path;

/// Larger than this unpacked, a zip is refused: a small file can unpack to gigabytes.
const MAX_UNPACKED: u64 = 1 << 30;

/// A zip at `to` of `files`, paths relative to `base` (kept so inside the zip); its size in bytes.
pub fn zip_files(to: &str, files: Vec<String>, base: &str) -> Result<i64, String> {
    let mut z = zip::ZipWriter::new(File::create(to).map_err(|e| format!("{}: {}", to, e))?);
    let opts = zip::write::SimpleFileOptions::default().compression_method(zip::CompressionMethod::Deflated);
    for f in &files {
        let full = Path::new(base).join(f);
        z.start_file(f.replace('\\', "/"), opts).map_err(|e| e.to_string())?;
        let mut src = File::open(&full).map_err(|e| format!("{}: {}", full.display(), e))?;
        std::io::copy(&mut src, &mut z).map_err(|e| e.to_string())?;
    }
    z.finish().map_err(|e| e.to_string())?;
    Ok(std::fs::metadata(to).map_err(|e| e.to_string())?.len() as i64)
}

/// What a zip holds: `[{ name, size, packed, folder }]`, sizes in bytes.
pub fn zip_list(path: &str) -> Result<Vec<Value>, String> {
    let mut a = zip::ZipArchive::new(File::open(path).map_err(|e| format!("{}: {}", path, e))?).map_err(|e| e.to_string())?;
    (0..a.len()).map(|i| {
        let e = a.by_index(i).map_err(|e| e.to_string())?;
        Ok(json!({ "name": e.name(), "size": e.size(), "packed": e.compressed_size(), "folder": e.is_dir() }))
    }).collect()
}

/// Unpacks the zip at `from` into the folder `to` (made if needed); the names written. Paths that leave the folder are refused, and so is a zip over 1 GiB unpacked.
pub fn unzip(from: &str, to: &str) -> Result<Vec<String>, String> {
    let mut a = zip::ZipArchive::new(File::open(from).map_err(|e| format!("{}: {}", from, e))?).map_err(|e| e.to_string())?;
    let mut total = 0u64;
    for i in 0..a.len() {
        let e = a.by_index(i).map_err(|e| e.to_string())?;
        if e.enclosed_name().is_none() {
            return Err(format!("`{}` would be written outside the folder", e.name()));
        }
        total += e.size();
    }
    if total > MAX_UNPACKED {
        return Err(format!("the zip unpacks to {} bytes, over the 1 GiB allowed", total));
    }
    std::fs::create_dir_all(to).map_err(|e| e.to_string())?;
    a.extract(to).map_err(|e| e.to_string())?;
    Ok(a.file_names().map(str::to_string).collect())
}
