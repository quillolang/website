// Sending jobs to network printers as they are: a ZPL file to a label printer's port 9100 with
// retries, a status question whose answer is read back, a check that the printer answers at all,
// and the LPR control file a job to a print server's queue would carry.
//
//   quillo run raw_print.qwe      then open http://localhost:8080/lpr
//   PRINTER_HOST=192.168.1.60 quillo run raw_print.qwe      and http://localhost:8080/print

use "raw_print.qwer"

route GET /print {
    let host = env("PRINTER_HOST", null) ?? reply 503 "set PRINTER_HOST to the printer's address (host or host:port)"
    let sent = raw_print_file("raw_print_sample.zpl", host, { timeout_ms: 3000, retries: 2, retry_delay_ms: 500 })?
    // Zebra's host status question: three lines come back.
    let status = raw_print_text("~HS", host, { read_reply_ms: 500 })?
    { bytes: sent.bytes, attempts: sent.attempts, status_lines: len(split(trim(status.reply), "\n")) }
}

route GET /check {
    let host = env("PRINTER_HOST", null) ?? "127.0.0.1"
    { printer: raw_print_reachable(host, 9100, 1000).open, nothing_there: raw_print_reachable("127.0.0.1:1", 0, 500).open }
}

route GET /lpr = respond(200, raw_print_lpr_control({ user: "warehouse", name: "Pick list 7", client: "wms01", copies: 2, job: 42 })?, { "content-type": "text/plain" })

route GET /fails = { error: raw_print_text("x", "127.0.0.1:1", { timeout_ms: 300, retries: 1, retry_delay_ms: 100 }).error }
