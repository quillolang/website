// Event ids for a webhook log: sortable by time, unique without a database sequence.
//
//   quillo run ksuid.qwe      then open http://localhost:8080/events

use "ksuid.qwer"

route GET /events {
    let old = ksuid_at(1767225600000)?         // 2026-01-01
    let fresh = ksuid()
    { fresh, old, sorted: sort([fresh, old]) == [old, fresh], old_time: ksuid_parse(old)?.time_ms, valid: [ksuid_valid(fresh), ksuid_valid("nope")] }
}

route GET /read ? { id: str } = ksuid_parse(id)?
