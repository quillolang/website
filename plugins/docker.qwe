// A small admin page for the containers on this machine: what is running, one container in detail,
// its logs split into stdout and stderr, and starting and stopping it.
//
//   quillo run docker.qwe     (DOCKER_HOST=unix:///Users/me/.docker/run/docker.sock for Docker Desktop)
//   then open /containers, /inspect, /logs, /lifecycle, /stats, /images and /broken
//
// The socket gives root on the machine: keep routes like these behind a login.

use "docker.qwer"

route GET /containers = {
    daemon: docker_version()?,
    running: docker_containers(false, null)? | map((c) => c.name),
    all: docker_containers(true, null)? | map((c) => { name: c.name, state: c.state, id: c.id }),
    web: docker_containers(true, { label: ["app=web"] })? | map((c) => c.name),
    exited: docker_containers(true, { status: "exited" })? | map((c) => c.name),
}

route GET /inspect {
    let c = docker_inspect("web-1")?
    { name: c.Name, running: c.State.Running, image: c.Config.Image, none: docker_inspect("nothing")? }
}

route GET /logs {
    let l = docker_logs("web-1", { tail: 100 })?
    {
        stdout: l.stdout,
        stderr: l.stderr,
        order: l.frames | map((f) => f.stream),
        only_errors: docker_logs("web-1", { stdout: false })?.stderr,
        tty: docker_logs("console", null)?,
        large: len(docker_logs("chatty", null)?.stdout),
        cut: docker_logs("cut-off", null).error,
    }
}

route GET /lifecycle = {
    started: docker_start("worker")?,
    again: docker_start("worker")?,
    state: docker_inspect("worker")?.State.Status,
    stopped: docker_stop("worker", 1)?,
    stopped_again: docker_stop("worker", 1)?,
    restarted: docker_restart("web-1", 1)?,
    removed: docker_remove("worker", false, true)?,
    removed_again: docker_remove("worker", false, true)?,
}

route GET /stats = docker_stats("web-1")?

route GET /images {
    let pulled = docker_pull("alpine", "3.20")?
    {
        pulled: pulled,
        images: docker_images(null)? | map((i) => i.tags) | flatten,
        filtered: docker_images({ reference: "nginx:*" })? | map((i) => i.tags) | flatten,
        no_such: docker_pull("no/such-image", "").error,
        in_use: docker_remove_image("nginx:1.27", false).error,
    }
}

route GET /broken = {
    no_start: docker_start("nothing").error,
    no_logs: docker_logs("nothing", null).error,
    running_remove: docker_remove("web-1", false, false).error,
}
