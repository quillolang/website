// A read-later view: a saved page's article, without its menus, ads and footer.
//
//   quillo run readability.qwe      then open http://localhost:8080/article

use "readability.qwer"

let page = read_file("readability_sample.html")?

route GET /article {
    let a = readability_extract(page, "https://blog.example.com/posts/faster-builds")?
    { title: a.title, by: a.byline, site: a.site_name, published: a.published_time, image: a.image, words: len(split(a.text, " ")), text: a.text }
}

route GET /read {
    let a = readability_extract(page, "https://blog.example.com/posts/faster-builds")?
    <html>
        <body>
            <h1>{a.title}</h1>
            <p><i>{a.byline}</i></p>
            {raw(a.html)}
        </body>
    </html>
}

route GET /markdown = respond(200, readability_markdown(page, "https://blog.example.com/posts/faster-builds")?, { "content-type": "text/markdown; charset=utf-8" })

route GET /probable = { article: readability_probable(page), menu: readability_probable("<nav><a href='/'>Home</a></nav>") }
