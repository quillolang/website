// A "where is it" field that takes coordinates however people paste them, and shows them back
// in degrees-minutes-seconds and on the UTM grid (for search and rescue, surveying, hiking maps).
//
//   quillo run coordinates.qwe      then open http://localhost:8080/where?q=52°22'12"N%204°53'24"E

use "coordinates.qwer"

route GET /where ? { q: str } {
    let p = coords_parse(q)?
    { lat: p.lat, lon: p.lon, dms: coords_to_dms(p.lat, p.lon, 1)?, utm: coords_to_utm(p.lat, p.lon)?.text }
}

route GET /forms = ["52°22'12\"N 4°53'24\"E", "N 52° 22.2' E 4° 53.4'", "52.37, 4.89", "4°53'24\"E 52°22'12\"N", "S 33.9249 E 18.4241", "-33.9249 18.4241"]
    | map((q) => { let p = coords_parse(q)?; `${p.lat}, ${p.lon}` })

route GET /utm = { cape_town: coords_to_utm(-33.92487, 18.42406)?, back: coords_from_utm("34H 261878 6243186")?, bad: coords_parse("52 N 4 N").error }
