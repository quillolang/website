// A photo that shows blurred until it has loaded.
//
//   quillo run blurhash.qwe      then open http://localhost:8080/   (sample.jpg beside it)

use "blurhash.qwer"

let hash = blurhash_of("sample.jpg")?

route GET /sample.jpg = file("sample.jpg")
route GET /hash = { hash }
route GET / = <html><body>
    <img src="/sample.jpg" width="480" height="252" alt="The Quillo banner"
         style={`background: url(${blurhash_data_url(hash, 32, 17)?}) center / cover`}/>
</body></html>
