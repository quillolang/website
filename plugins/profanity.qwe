// Comments masked before they are shown, and a username refused when it is offensive.
//
//   quillo run profanity.qwe      then open http://localhost:8080/comments

use "profanity.qwer"

let comments = ["Great post, thanks!", "This is sh1t, you f.u.c.k.i.n.g idiot", "Well, damn, that is clever."]

route GET /comments = comments | map((c) => { shown: profanity_mask(c, "moderate")?, flagged: profanity_found(c)? })

route GET /username ? { name: str } {
    if profanity_found(name)? { reply 422 { error: "Please pick another username." } }
    { ok: name }
}

route GET /analyze ? { text: str } = profanity_analyze(text)?
