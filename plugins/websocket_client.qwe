// A WebSocket client: a program keeping a socket open to another service (an exchange's price
// feed, a chat or bot gateway, a device), sending to it, and reading what arrived when it wants:
// in a route, or every second with `every`, which keeps the latest prices for pages.
//
//   WS_URL=wss://echo.example.com/feed quillo run websocket_client.qwe
//   then open http://localhost:8080/connect, /echo, /buffer, /reconnect, /secure, /latest and /close
//
// WSS_URL is a wss:// address to try TLS with, WS_CA a PEM file to trust for it (else the public roots).

use "websocket_client.qwer"

let URL = env("WS_URL", "ws://127.0.0.1:8765/feed")

// The first message the server sends says what it saw of the headers.
route GET /connect {
    let c = ws_connect("feed", URL, { headers: { authorization: "Bearer demo-token" }, protocols: ["feed.v3", "feed.v2"] })?
    { connected: c.connected, protocol: c.protocol, welcome: ws_receive_json("feed", 1, 3000)? }
}

route GET /echo {
    ws_connect("feed", URL, { protocols: ["feed.v2"] })?
    ws_send("feed", "hello")?
    ws_send_json("feed", { op: "subscribe", args: ["trades:BTC-EUR"] })?
    ws_send_binary("feed", "AAECAwQ=")?
    ws_ping("feed", "are you there")?
    ws_send("feed", "ping-me")?                   // the server pings back; the client answers by itself
    sleep(200)
    ws_receive("feed", 10, 2000)? | map((m) => m.kind == "binary" ? `binary ${m.base64}` : `${m.kind} ${m.text}`)
}

// A small buffer: the oldest messages go when it is full, and are counted.
route GET /buffer {
    ws_connect("small", URL, { buffer: 5 })?
    ws_send("small", "burst 20")?
    sleep(300)
    let s = ws_status("small")?
    let kept = ws_receive("small", 100, 0)? | map((m) => m.text)
    ws_close("small", 1000, "done")?
    { kept, dropped: s.dropped }
}

// The server goes away; the connection comes back by itself.
route GET /reconnect {
    ws_connect("flaky", `${URL}?reconnect`, {})?
    ws_send("flaky", "close-me")?
    let tries = 0
    while tries < 50 && (ws_status("flaky")?.reconnects == 0 || !ws_status("flaky")?.connected) {
        sleep(100)
        tries += 1
    }
    ws_send("flaky", "back again")?
    sleep(200)
    let got = ws_receive("flaky", 10, 1000)? | map((m) => m.kind == "close" ? `close ${m.code} ${m.reason}` : m.text)
    let s = ws_status("flaky")?
    ws_close("flaky", 1000, "done")?
    { got, reconnects: s.reconnects, connected: s.connected }
}

route GET /secure {
    let url = env("WSS_URL", null) ?? reply 503 "set WSS_URL to a wss:// address"
    ws_connect("tls", url, { ca_file: env("WS_CA", null) })?
    ws_send("tls", "over TLS")?
    sleep(200)
    let got = ws_receive("tls", 2, 2000)? | map((m) => m.text)
    ws_close("tls", 1000, "done")?
    { got }
}

// Draining a feed on the server: every second, what came on the "ticker" connection is kept for
// pages to show (a connection of its own, so the routes above read theirs undisturbed).
let latest = []
fn drain() {
    let got = ws_receive_json("ticker", 100, 0)
    if !is_err(got) && len(got) > 0 { latest = slice(latest + got, -20) }
}
every(1000, drain)

route GET /latest {
    ws_connect("ticker", URL, {})?
    ws_send_json("ticker", { trade: "BTC-EUR", price: 61250.5 })?
    sleep(1200)
    { latest: latest | filter((m) => m.trade != null), open: ws_list() | map((c) => c.name) }
}

route GET /close {
    ws_connect("feed", URL, {})?
    {
        unread: ws_close("feed", 1000, "bye")?,
        ticker: ws_close("ticker", 1000, "bye") ?? 0,
        open: ws_list() | map((c) => c.name),
        gone: ws_send("feed", "x").error,
    }
}
