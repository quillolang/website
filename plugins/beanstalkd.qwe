// Welcome emails sent by a beanstalkd work queue: a sign-up puts a job in the "emails" tube, a
// worker takes jobs twice a second, sends them and deletes them, retries a failure later and
// buries a job that keeps failing; and a job's whole life, step by step, at /lifecycle.
//
//   BEANSTALK_URL=beanstalk://127.0.0.1:11300 quillo run beanstalkd.qwe      then open http://localhost:8080/signup?email=ada@example.com
//
// Needs a beanstalkd (beanstalkd -l 127.0.0.1 -p 11300).

use "beanstalkd.qwer"

let URL = env("BEANSTALK_URL", "beanstalk://127.0.0.1:11300")

// Two connections: one puts, one reserves (a reserve that waits holds only its own connection).
let opened = [
    beanstalk_connect("producer", URL, { use: "emails" }),
    beanstalk_connect("worker", URL, { watch: ["emails"] }),
]

let sent = []
let failures = {}

fn send_email(job) {
    let mail = json.parse(job.body)?
    if contains(mail.to, "@bounce.") { return err("the mailbox does not exist") }
    sent = sent + [{ id: job.id, to: mail.to, subject: mail.subject }]
    null
}

// Takes what is ready now (up to 20 jobs), without waiting.
fn work() {
    let done = 0
    while done < 20 {
        let job = beanstalk_reserve("worker", 0)?
        if job == null { return done }
        let r = send_email(job)
        if is_err(r) {
            let tries = (failures[str(job.id)] ?? 0) + 1
            failures = set(failures, str(job.id), tries)
            // Twice more, a second apart; then set aside for a person to look at.
            if tries >= 3 { beanstalk_bury("worker", job.id, 1024)? } else { beanstalk_release("worker", job.id, { delay: 1 })? }
        } else {
            beanstalk_delete("worker", job.id)?
        }
        done = done + 1
    }
    done
}

every(500, work)

route GET /signup ? { email: str } {
    let job = beanstalk_put("producer", json.stringify({ to: email, subject: "Welcome!" }), { priority: 100, ttr: 30 })?
    { queued: job.id, tube: job.tube }
}

// What the worker has sent, and the tube's counts (waits for the next tick).
route GET /sent {
    sleep(700)
    let tube = beanstalk_stats_tube("producer", "emails")?
    { sent: sent | map((m) => m.to), ready: tube["current-jobs-ready"], buried: tube["current-jobs-buried"], total: tube["total-jobs"] }
}

// One job's life on a tube of its own: delayed, kicked, reserved, released, buried, kicked, touched, deleted.
route GET /lifecycle {
    beanstalk_connect("life", URL, { use: "lifecycle", watch: ["lifecycle"] })?
    let job = beanstalk_put("life", "resize photo 77", { delay: 60, priority: 5 })?
    let steps = [beanstalk_stats_job("life", job.id)?.state]
    beanstalk_kick_job("life", job.id)?
    steps = steps + [beanstalk_stats_job("life", job.id)?.state]
    let got = beanstalk_reserve("life", 1)?
    steps = steps + [beanstalk_stats_job("life", got.id)?.state]
    beanstalk_release("life", got.id, { delay: 30 })?
    steps = steps + [beanstalk_stats_job("life", got.id)?.state]
    beanstalk_kick("life", 10)?
    let again = beanstalk_reserve("life", 1)?
    beanstalk_bury("life", again.id, 1024)?
    steps = steps + [beanstalk_stats_job("life", again.id)?.state, beanstalk_peek("life", "buried")?.body]
    let kicked = beanstalk_kick("life", 10)?
    let last = beanstalk_reserve("life", 1)?
    let touched = beanstalk_touch("life", last.id)?
    let stats = beanstalk_stats_job("life", last.id)?
    beanstalk_delete("life", last.id)?
    {
        steps, kicked, touched,
        reserves: stats.reserves, releases: stats.releases, buries: stats.buries, kicks: stats.kicks,
        gone: beanstalk_stats_job("life", last.id)? == null,
        nothing_left: beanstalk_reserve("life", 0)? == null,
        tubes: beanstalk_tubes("life")? | filter((t) => t == "emails" || t == "lifecycle") | sort,
    }
}
