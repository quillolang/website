// Addresses on OpenStreetMap: a search, a structured address, the street at a position, a place by
// its id, and the parts of an address in one shape. It keeps to the usage policy of the public
// server, so every call waits its turn, at one a second, and an answer is kept for a day.
//
//   NOMINATIM_USER_AGENT="myshop/1.0 (ops@example.com)" quillo run nominatim.qwe
//   then open http://localhost:8080/search?q=Dam+Amsterdam, /reverse, /parts, /status and /refused
//
// NOMINATIM_API_URL points at your own server, and NOMINATIM_MIN_INTERVAL_MS sets its gap.

use "nominatim.qwer"

route GET /search ? { q: str } {
    let r = nominatim_search(q, { limit: 3 })
    if is_err(r) { reply 502 r.error }
    r
}

route GET /structured = {
    place: first(nominatim_structured({ street: "1 Dam", city: "Amsterdam", country: "Nederland" }, { limit: 1 })?).display_name,
    none: nominatim_search("nowhere at all", {})?,
    other_country: nominatim_search("Dam", { countrycodes: "fr" })?,
    bounded: len(nominatim_search("Dam", { viewbox: "4.8,52.4,5.0,52.3", bounded: true, language: "nl" })?),
}

route GET /reverse = {
    here: nominatim_reverse(52.3731, 4.8932, { zoom: 18 })?,
    at_sea: nominatim_reverse(0.0, 0.0, {})?,
    by_id: nominatim_lookup(["W95014", "N1"], {})? | map((p) => p.osm_id),
}

route GET /parts = {
    city: first(nominatim_search("Dam", { extratags: true })?).address,
    village: first(nominatim_search("Kleindorp", {})?).address,
    tags: first(nominatim_search("Dam", { extratags: true })?).extratags,
    by_hand: nominatim_address({ town: "Oss", road: "Molenstraat", country_code: "nl" }),
}

route GET /status = nominatim_status()?

route GET /refused = {
    empty: nominatim_search("  ", {}).error,
    position: nominatim_reverse(99.0, 0.0, {}).error,
    id: nominatim_lookup(["X1"], {}).error,
    option: nominatim_search("Dam", { colour: "red" }).error,
    part: nominatim_structured({ planet: "Earth" }, {}).error,
    too_many: nominatim_search("Dam", { limit: 500 }).error,
}
