// A bakery video's captions: read, put back in sync, and served as WebVTT for the page's <track>.
//
//   quillo run subtitles.qwe      then open http://localhost:8080/cues

use "subtitles.qwer"

let SRT = read_file("subtitles_sample.srt")

route GET /cues = subtitles_parse(SRT)? | map((c) => { start: c.start, end: c.end, plain: c.plain })

// The captions came out 1.5 s early: shifted, and as WebVTT for the browser.
route GET /captions.vtt = respond(200, subtitles_to_vtt(subtitles_shift(SRT, 1500)?)?, { "content-type": "text/vtt; charset=utf-8" })

route GET /sync {
    let fixed = subtitles_resync(SRT, 2000, 140000)?
    let cues = subtitles_parse(fixed)?
    {
        first: cues[0].start,
        last: cues[4].start,
        earlier: subtitles_shift(SRT, -3000)? | subtitles_parse | map((c) => c.start),
        at_8s: subtitles_at(SRT, 8000)? | map((c) => c.plain),
        transcript: subtitles_text(SRT)?,
        written: subtitles_write([{ start_ms: 0, end_ms: 1200, text: "Hello" }, { start: "00:00:01.500", end: "00:00:03.000", text: "Bonjour" }], "srt")?,
    }
}
