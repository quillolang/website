//! People's names split into their parts, for forms, CRMs and mail merges: title, given name, middle names, family name and suffix, from "Dr. Martin Luther King, Jr." or "KING, MARTIN L".
//! version: 1.0.0
//!
//! [dependencies]
//! human_name = "2"

use human_name::Name;
use serde_json::{json, Value};

fn parse(name: &str) -> Result<Name, String> {
    if name.len() > 1000 {
        return Err("names up to 1,000 characters".into());
    }
    Name::parse(name).ok_or_else(|| format!("{:?} does not read as a person's name", name))
}

/// The parts of a full name: `{ title, given, middle, family, suffix, honorifics, initials, first_last, full }`, those missing null. It reads "Last, First" too, and fixes ALL CAPS and all lower case ("mcdonald" is "McDonald"). Western names: a name in another order (Chinese, Hungarian) is read given name first. An error when it is not a name.
pub fn name_parse(name: &str) -> Result<Value, String> {
    let n = parse(name)?;
    Ok(json!({
        "title": n.honorific_prefix(),
        "given": n.given_name(),
        "middle": n.middle_name().map(|m| m.into_owned()),
        "family": n.surname(),
        "suffix": n.generational_suffix(),
        "honorifics": n.honorific_suffix(),
        "initials": n.initials(),
        "first_last": n.display_first_last().into_owned(),
        "full": n.display_full_with_honorifics().into_owned(),
    }))
}

/// Whether two written names may be the same person: "J. Smith" and "John Smith" may, "Jane Smith" and "John Smith" may not. For finding duplicate contacts.
pub fn name_same_person(a: &str, b: &str) -> Result<bool, String> {
    Ok(parse(a)?.consistent_with(&parse(b)?))
}

/// The name as "J. Smith": the first initial and the family name, for bylines and compact lists.
pub fn name_short(name: &str) -> Result<String, String> {
    Ok(parse(name)?.display_initial_surname().into_owned())
}
