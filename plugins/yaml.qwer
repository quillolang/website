//! YAML to values and back: config files, front matter, Kubernetes and OpenAPI documents.
//!
//! [dependencies]
//! serde_yaml = "0.9"
//! serde = "1"

use serde::Deserialize;
use serde_json::Value;

/// YAML text as a value: maps, lists, text, numbers, booleans and null. Keys that are not text are refused.
pub fn yaml_parse(text: &str) -> Result<Value, String> {
    serde_yaml::from_str::<Value>(text).map_err(|e| e.to_string())
}

/// Every document of a YAML stream (separated by `---`), as a list.
pub fn yaml_parse_all(text: &str) -> Result<Vec<Value>, String> {
    serde_yaml::Deserializer::from_str(text).map(|d| Value::deserialize(d).map_err(|e| e.to_string())).collect()
}

/// A value as YAML text.
pub fn yaml_stringify(value: serde_json::Value) -> Result<String, String> {
    serde_yaml::to_string(&value).map_err(|e| e.to_string())
}

/// A Markdown file's YAML front matter (between `---` lines at its top) and the rest: `{ meta, body }`.
pub fn front_matter(text: &str) -> Result<Value, String> {
    let t = text.trim_start_matches('\u{feff}');
    let Some(rest) = t.strip_prefix("---\n").or_else(|| t.strip_prefix("---\r\n")) else {
        return Ok(serde_json::json!({ "meta": {}, "body": text }));
    };
    let end = rest.find("\n---").ok_or("the front matter has no closing `---` line")?;
    let meta = if rest[..end].trim().is_empty() { serde_json::json!({}) } else { yaml_parse(&rest[..end])? };
    let body = rest[end + 4..].trim_start_matches(['\r', '\n']).to_string();
    Ok(serde_json::json!({ "meta": meta, "body": body }))
}
