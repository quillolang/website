//! CBOR (RFC 8949), the binary format of WebAuthn passkeys, COSE and IoT devices: values to CBOR as base64 or a file, and CBOR read back as values.
//! version: 1.0.0
//!
//! [dependencies]
//! ciborium = "0.2"
//! base64 = "0.22"

use base64::engine::general_purpose::{STANDARD, URL_SAFE_NO_PAD};
use base64::Engine;
use ciborium::Value as C;
use serde_json::{json, Map, Value};

/// At most 64 MiB of CBOR is read or written.
const MAX: usize = 64 * 1024 * 1024;

fn key_text(k: C) -> String {
    match k {
        C::Text(s) => s,
        C::Integer(i) => i128::from(i).to_string(),
        C::Bytes(b) => STANDARD.encode(b),
        C::Bool(b) => b.to_string(),
        C::Float(f) => f.to_string(),
        other => format!("{:?}", other),
    }
}

fn to_json(v: C, depth: usize) -> Value {
    if depth > 256 {
        return Value::Null;
    }
    match v {
        C::Null => Value::Null,
        C::Bool(b) => Value::Bool(b),
        C::Integer(i) => {
            let n = i128::from(i);
            i64::try_from(n).map(Value::from).or_else(|_| u64::try_from(n).map(Value::from)).unwrap_or_else(|_| json!(n as f64))
        }
        C::Float(f) => json!(f),
        C::Text(s) => Value::String(s),
        // Byte strings have no JSON form: they come back as base64 text.
        C::Bytes(b) => Value::String(STANDARD.encode(b)),
        C::Array(a) => Value::Array(a.into_iter().map(|x| to_json(x, depth + 1)).collect()),
        C::Map(m) => {
            let mut out = Map::new();
            for (k, v) in m {
                out.insert(key_text(k), to_json(v, depth + 1));
            }
            Value::Object(out)
        }
        // A tag (0: a date as text, 1: a date as seconds, 32: a URL...) gives its value.
        C::Tag(_, inner) => to_json(*inner, depth + 1),
        _ => Value::Null,
    }
}

fn decode(bytes: &[u8]) -> Result<Value, String> {
    if bytes.len() > MAX {
        return Err("CBOR over 64 MiB".into());
    }
    let v: C = ciborium::from_reader(bytes).map_err(|e| format!("not CBOR: {}", e))?;
    Ok(to_json(v, 0))
}

fn encode(value: &Value) -> Result<Vec<u8>, String> {
    let mut out = Vec::new();
    ciborium::into_writer(value, &mut out).map_err(|e| e.to_string())?;
    if out.len() > MAX { Err("CBOR over 64 MiB".into()) } else { Ok(out) }
}

fn unbase64(t: &str) -> Result<Vec<u8>, String> {
    let t = t.trim();
    STANDARD.decode(t).or_else(|_| URL_SAFE_NO_PAD.decode(t.trim_end_matches('='))).map_err(|_| "not base64".to_string())
}

/// `value` as CBOR, in base64.
pub fn cbor_encode(value: serde_json::Value) -> Result<String, String> {
    Ok(STANDARD.encode(encode(&value)?))
}

/// The value in CBOR given as base64 or base64url (as WebAuthn's `attestationObject` comes). Byte strings come back as base64
/// text, tagged values as their value, map keys that are numbers (COSE keys: `1`, `-2`) as text.
pub fn cbor_decode(base64_text: &str) -> Result<Value, String> {
    decode(&unbase64(base64_text)?)
}

/// Writes `value` as CBOR to `path` (folders made); gives the bytes written.
pub fn cbor_write_file(path: &str, value: serde_json::Value) -> Result<i64, String> {
    let b = encode(&value)?;
    if let Some(dir) = std::path::Path::new(path).parent() {
        if !dir.as_os_str().is_empty() {
            std::fs::create_dir_all(dir).map_err(|e| format!("{}: {}", dir.display(), e))?;
        }
    }
    std::fs::write(path, &b).map_err(|e| format!("{}: {}", path, e))?;
    Ok(b.len() as i64)
}

/// The value in a CBOR file.
pub fn cbor_read_file(path: &str) -> Result<Value, String> {
    let size = std::fs::metadata(path).map_err(|e| format!("{}: {}", path, e))?.len();
    if size as usize > MAX {
        return Err(format!("{}: over 64 MiB", path));
    }
    decode(&std::fs::read(path).map_err(|e| format!("{}: {}", path, e))?)
}
