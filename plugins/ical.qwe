// "Add to calendar" for a booking.
//
//   quillo run ical.qwe      then open http://localhost:8080/booking.ics

use "ical.qwer"

route GET /booking.ics = respond(200, ics_calendar([{
    title: "Table for two at Quillo Café",
    start: "2026-11-20T19:00:00+01:00",
    end: "2026-11-20T21:00:00+01:00",
    location: "Keizersgracht 1, Amsterdam",
    uid: "booking-4521@quillo.example",
}])?, { "content-type": "text/calendar; charset=utf-8", "content-disposition": "attachment; filename=booking.ics" })
