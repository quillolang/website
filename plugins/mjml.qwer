//! MJML email templates rendered to responsive HTML email that works in Gmail, Outlook and Apple Mail, with `{{name}}` placeholders filled in and escaped. Pure Rust (MRML), no Node.
//! version: 1.0.0
//!
//! [dependencies]
//! mrml = { version = "4", default-features = false, features = ["parse", "render"] }

use serde_json::{json, Value};
use std::collections::HashMap;

const MAX_TEMPLATE: usize = 2 << 20;

fn escape(s: &str) -> String {
    s.replace('&', "&amp;").replace('<', "&lt;").replace('>', "&gt;").replace('"', "&quot;").replace('\'', "&#39;")
}

fn text(v: &Value) -> String {
    match v {
        Value::Null => String::new(),
        Value::String(s) => s.clone(),
        other => other.to_string(),
    }
}

/// `{{name}}` replaced by the escaped value, `{{{name}}}` by the value as it is (for HTML you made), `{{a.b}}` reaching into maps; an unknown name is an error.
fn fill(template: &str, vars: &HashMap<String, Value>) -> Result<String, String> {
    let mut out = String::with_capacity(template.len());
    let mut rest = template;
    while let Some(i) = rest.find("{{") {
        out.push_str(&rest[..i]);
        let raw = rest[i..].starts_with("{{{");
        let (open, close) = if raw { (3, "}}}") } else { (2, "}}") };
        let after = &rest[i + open..];
        let end = after.find(close).ok_or("a `{{` is not closed")?;
        let name = after[..end].trim();
        let mut parts = name.split('.');
        let first = parts.next().unwrap_or("");
        let mut v = vars.get(first).ok_or(format!("no value for {{{{{}}}}}", name))?;
        for p in parts {
            v = v.get(p).ok_or(format!("no value for {{{{{}}}}}", name))?;
        }
        out.push_str(&if raw { text(v) } else { escape(&text(v)) });
        rest = &after[end + close.len()..];
    }
    out.push_str(rest);
    Ok(out)
}

fn render(template: &str) -> Result<mrml::mjml::Mjml, String> {
    if template.len() > MAX_TEMPLATE {
        return Err("a template is at most 2 MB".into());
    }
    mrml::parse(template).map_err(|e| format!("the MJML does not parse: {}", e))
}

/// MJML (`<mjml><mj-body><mj-section><mj-column><mj-text>...`) as the email's HTML, with inline styles and tables for old clients.
/// `<mj-include>` is not followed: templates read no files.
pub fn mjml_to_html(template: &str) -> Result<String, String> {
    render(template)?.render(&Default::default()).map_err(|e| e.to_string())
}

/// A template with `vars` filled in, rendered: `{ html, title, preview }` (`title` from `<mj-title>`, `preview` from `<mj-preview>`, the line inboxes show).
/// `{{name}}` is escaped, `{{{name}}}` is not, and `{{order.id}}` reaches into maps.
pub fn mjml_render(template: &str, vars: std::collections::HashMap<String, serde_json::Value>) -> Result<Value, String> {
    let filled = fill(template, &vars)?;
    let m = render(&filled)?;
    let html = m.render(&Default::default()).map_err(|e| e.to_string())?;
    Ok(json!({ "html": html, "title": m.get_title(), "preview": m.get_preview() }))
}

/// Whether a template parses: `{ ok, error }`, for an editor that saves templates.
pub fn mjml_check(template: &str) -> Value {
    match render(template).and_then(|m| m.render(&Default::default()).map_err(|e| e.to_string())) {
        Ok(_) => json!({ "ok": true, "error": null }),
        Err(e) => json!({ "ok": false, "error": e }),
    }
}
