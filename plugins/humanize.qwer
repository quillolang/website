//! Numbers as people write them and back: durations ("2h 30m"), file sizes ("1.5 GB") and relative times ("3 days ago", "in 2 hours").
//! version: 1.0.0
//!
//! [dependencies]
//! humantime = "2.1"
//! bytesize = "2"

use bytesize::ByteSize;
use std::time::Duration;

/// `seconds` as a short duration: 9000 is "2h 30m", 90061 is "1day 1h 1m 1s"; fractions of a second as "ms". Negative is an error.
pub fn humanize_duration(seconds: f64) -> Result<String, String> {
    if !(0.0..1e15).contains(&seconds) {
        return Err("seconds from 0 up".into());
    }
    let d = Duration::from_millis((seconds * 1000.0).round() as u64);
    Ok(humantime::format_duration(d).to_string())
}

/// A duration typed by a person, in seconds: "2h 30m", "1day 3hours", "90s", "15 minutes", "500ms" (0.5). An error says what it could not read.
pub fn humanize_parse_duration(text: &str) -> Result<f64, String> {
    humantime::parse_duration(text.trim()).map(|d| d.as_secs_f64()).map_err(|e| format!("{:?}: {}", text, e))
}

/// `bytes` as a size: "1.5 GB" in powers of 1000 when `si` is true (as disks and downloads count), "1.4 GiB" in powers of 1024 when false (as memory counts).
pub fn humanize_bytes(bytes: i64, si: bool) -> String {
    let b = ByteSize::b(bytes.max(0) as u64);
    let s = if si { b.display().si().to_string() } else { b.display().iec().to_string() };
    if bytes < 0 { format!("-{}", s) } else { s }
}

/// A size typed by a person, in bytes: "1.5 GB" (1,500,000,000), "2 GiB" (2,147,483,648), "512 KB", "300" (bytes). Case does not matter.
pub fn humanize_parse_bytes(text: &str) -> Result<i64, String> {
    let t = text.trim();
    let n: ByteSize = t.parse().map_err(|e: String| format!("{:?}: {}", text, e))?;
    i64::try_from(n.as_u64()).map_err(|_| "too large".into())
}

/// How long ago (or how far ahead) `time_ms` is from `now_ms`, both in milliseconds since 1970 as `now()` gives: "just now", "5 minutes ago", "yesterday", "3 days ago", "in 2 hours", "last month", "2 years ago".
pub fn humanize_ago(time_ms: i64, now_ms: i64) -> String {
    let diff = (now_ms as i128 - time_ms as i128) / 1000;
    let past = diff >= 0;
    let s = diff.unsigned_abs() as u64;
    if s < 45 {
        return "just now".into();
    }
    let (n, unit) = match s {
        s if s < 90 => (1, "minute"),
        s if s < 3600 => ((s + 30) / 60, "minute"),
        s if s < 5400 => (1, "hour"),
        s if s < 86400 => ((s + 1800) / 3600, "hour"),
        s if s < 2 * 86400 => return if past { "yesterday".into() } else { "tomorrow".into() },
        s if s < 7 * 86400 => ((s + 43200) / 86400, "day"),
        s if s < 30 * 86400 => ((s + 3 * 86400) / (7 * 86400), "week"),
        s if s < 365 * 86400 => ((s + 15 * 86400) / (30 * 86400), "month"),
        s => ((s + 182 * 86400) / (365 * 86400), "year"),
    };
    let n = n.max(1);
    if n == 1 && (unit == "week" || unit == "month" || unit == "year") {
        return format!("{} {}", if past { "last" } else { "next" }, unit);
    }
    let words = if n == 1 { format!("{} {}", if unit == "hour" { "an" } else { "a" }, unit) } else { format!("{} {}s", n, unit) };
    if past { format!("{} ago", words) } else { format!("in {}", words) }
}
