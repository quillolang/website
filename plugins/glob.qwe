// A docs site that finds its pages by pattern, and an asset list filtered the same way.
//
//   quillo run glob.qwe      then open http://localhost:8080/pages

use "glob.qwer"

fn seed() {
    write_file("data/site/docs/index.md", "# Docs")
    write_file("data/site/docs/guide/routes.md", "# Routes")
    write_file("data/site/docs/guide/drafts/next.md", "# Soon")
    write_file("data/site/docs/logo.png", "png")
    write_file("data/site/blog/hello.md", "# Hello")
}

route GET /pages {
    seed()
    glob_files("data/site", ["docs/**/*.md", "blog/*.md"], ["**/drafts/**"])
}

route GET /match = {
    nested: glob_match("docs/**/*.md", "docs/guide/routes.md")?,
    one_level: glob_match("docs/*.md", "docs/guide/routes.md")?,
    images: glob_filter(["a.jpg", "b.PNG", "c.png", "notes.txt"], ["*.{jpg,png}"])?,
}
