// Orders through Google Cloud Pub/Sub: published with attributes, pulled twice a second by a
// worker and acknowledged; a parcel's tracking events in order (an ordering key, and a
// subscription with ordering on); and a message given back at once (deadline 0) and taken again.
//
//   GOOGLE_APPLICATION_CREDENTIALS=key.json quillo run pubsub.qwe      then open http://localhost:8080/order?id=A-1
//   PUBSUB_EMULATOR_HOST=localhost:8085 PUBSUB_PROJECT=my-project quillo run pubsub.qwe      with the emulator
//
// pubsub_sample.json is a made-up service account: the example signs with it, Google would refuse
// it. Needs Pub/Sub, or its emulator (gcloud beta emulators pubsub start).

use "pubsub.qwer"

let EMULATOR = env("PUBSUB_EMULATOR_HOST", "")
let project = pubsub_connect("gcp", {
    credentials: EMULATOR != "" ? "" : env("PUBSUB_CREDENTIALS", env("GOOGLE_APPLICATION_CREDENTIALS", "pubsub_sample.json")),
    project: env("PUBSUB_PROJECT", ""),
    endpoint: EMULATOR != "" ? EMULATOR : env("PUBSUB_ENDPOINT", ""),
    token_url: env("PUBSUB_TOKEN_URL", ""),
})
let made = [
    pubsub_create_topic("gcp", "orders"),
    pubsub_create_subscription("gcp", "orders-worker", "orders", { ack_deadline_seconds: 30 }),
    pubsub_create_topic("gcp", "parcels"),
    pubsub_create_subscription("gcp", "parcels-tracker", "parcels", { ordering: true }),
    pubsub_create_topic("gcp", "payments"),
    pubsub_create_subscription("gcp", "payments-charger", "payments", {}),
]

let processed = []

fn work() {
    let got = pubsub_pull("gcp", "orders-worker", 50, 0)?
    for m in got {
        processed = processed + [{ order: json.parse(m.data)?.id, country: m.attributes.country }]
    }
    if len(got) > 0 { pubsub_ack("gcp", "orders-worker", got)? }
    len(got)
}

every(500, work)

route GET /order ? { id: str = "A-1", country: str = "FR" } {
    let message_id = pubsub_publish("gcp", "orders", json.stringify({ id, total: 42.5 }), { attributes: { kind: "order", country } })?
    { published: message_id != "" }
}

route GET /processed {
    sleep(900)
    { processed }
}

// Four events of one parcel and one of another: each key's events come in the order published.
route GET /parcels {
    pubsub_publish_many("gcp", "parcels", [
        { data: "parcel-9 picked up", ordering_key: "parcel-9" },
        { data: "parcel-9 in Lyon", ordering_key: "parcel-9" },
        { data: "parcel-4 picked up", ordering_key: "parcel-4" },
        { data: "parcel-9 out for delivery", ordering_key: "parcel-9" },
        { data: "parcel-9 delivered", ordering_key: "parcel-9" },
    ])?
    let seen = []
    let rounds = 0
    while len(seen) < 5 && rounds < 20 {
        let got = pubsub_pull("gcp", "parcels-tracker", 10, 1000)?
        for m in got { seen = seen + [m] }
        if len(got) > 0 { pubsub_ack("gcp", "parcels-tracker", got)? }
        rounds = rounds + 1
    }
    { parcel_9: seen | filter((m) => m.ordering_key == "parcel-9") | map((m) => m.data), others: len(seen) - 4 }
}

// A payment that fails once: its deadline set to 0, it comes again with the same id.
route GET /retry {
    let id = pubsub_publish("gcp", "payments", "charge card 4242", {})?
    let first = pubsub_pull("gcp", "payments-charger", 1, 3000)?[0] ?? reply 504 "nothing came"
    pubsub_modify_ack_deadline("gcp", "payments-charger", first, 0)?
    let again = pubsub_pull("gcp", "payments-charger", 1, 3000)?[0] ?? reply 504 "it did not come again"
    pubsub_ack("gcp", "payments-charger", again)?
    let token = pubsub_access_token("gcp")?
    { same_message: again.message_id == id && first.message_id == id, data: again.data, signed_in: token.token != null }
}
