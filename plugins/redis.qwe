// A page view counter and a cached answer, in Redis.
//
//   REDIS_URL=redis://127.0.0.1/ quillo run redis.qwe      then open http://localhost:8080/views

use "redis.qwer"

route GET /views = { views: cache_incr("views:home")? }

// An answer kept for a minute, so a slow lookup runs once a minute at most.
fn slow_report() = json.stringify({ total: 4521, at: now() })
route GET /report {
    let kept = cache_get("report")?
    if kept != null { return json.parse(kept)? }
    let fresh = slow_report()
    cache_set("report", fresh, 60)?
    json.parse(fresh)?
}
