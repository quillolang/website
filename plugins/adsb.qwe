// An airfield's ADS-B receiver (an RTL-SDR with dump1090): its log of Mode S messages decoded,
// call signs, altitudes, a position from an even and odd pair, speeds and vertical rates, and the
// aircraft seen; a message garbled on the air is caught by its CRC.
//
//   quillo run adsb.qwe      then open http://localhost:8080/aircraft and http://localhost:8080/decode

use "adsb.qwer"

let LOG = split(trim(read_file("adsb_sample.txt")?), "\n")

route GET /aircraft = adsb_aircraft(LOG, { ref_lat: 52.3, ref_lon: 4.76 })

route GET /decode = {
    callsign: adsb_decode("8D4840D6202CC371C32CE0576098")?,
    velocity: adsb_decode("8D485020994409940838175B284F")?,
    airspeed: adsb_decode("8DA05F219B06B6AF189400CBC33F")?,
    garbled: adsb_decode("8D4840D6202CC371C32CE0576099")?.crc_ok,
}

route GET /position = {
    pair: adsb_position("8D40621D58C386435CC412692AD6", "8D40621D58C382D690C8AC2863A7")?,
    near_schiphol: adsb_position_near("8D40621D58C382D690C8AC2863A7", 52.3, 4.76)?,
}
