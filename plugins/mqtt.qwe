// A plant's sensor dashboard over MQTT: readings published at QoS 0, 1 and 2, a subscription with
// a `+` wildcard drained twice a second by a tick, a retained status with a last will, and MQTT 5
// user properties and a response topic.
//
//   MQTT_URL=mqtt://user:pass@127.0.0.1:1883 quillo run mqtt.qwe
//   then open http://localhost:8080/publish, /readings, /retained, /v5 and /status
//
// It needs an MQTT broker (Mosquitto, EMQX, HiveMQ, ...): MQTT_URL says where, mqtts:// for TLS.

use "mqtt.qwer"

let url = env("MQTT_URL", "mqtt://127.0.0.1:1883")
let readings = []

// The connection, made on first use and kept. Its last will marks the dashboard offline, kept
// (retained) by the broker, if the program goes away without saying goodbye.
fn broker() {
    if (mqtt_status("dash") ?? null) == null {
        mqtt_connect("dash", url, {
            client_id: "plant-dashboard",
            timeout_ms: 3000,
            will: { topic: "plant/dashboard", payload: "offline", qos: 1, retain: true },
        })?
        mqtt_subscribe("dash", "plant/+/temperature", 1)?
        mqtt_publish("dash", "plant/dashboard", "online", { qos: 1, retain: true })?
    }
    "dash"
}

// What has arrived goes into `readings` (the last 100), so pages read it without waiting.
fn drain(wait_ms: int) {
    let name = broker() ?? null
    if name == null { return 0 }
    let got = mqtt_receive(name, 100, wait_ms) ?? []
    let all = readings + got
    readings = slice(all, -100, len(all))
    len(got)
}
every(500, () => drain(0), { name: "mqtt-drain" })

// Three readings: the boiler at QoS 1 (PUBACK), the chiller at QoS 2 (PUBREC, PUBREL, PUBCOMP),
// and a pressure at QoS 0, which the `plant/+/temperature` subscription does not take.
route GET /publish {
    let name = broker()?
    {
        boiler: mqtt_publish(name, "plant/boiler/temperature", "81.5", { qos: 1 })?,
        chiller: mqtt_publish(name, "plant/chiller/temperature", "6.2", { qos: 2 })?,
        pressure: mqtt_publish(name, "plant/boiler/pressure", { bar: 2.4 }, {})?,
    }
}

route GET /readings {
    drain(1000)
    { count: len(readings), readings: readings | map((m) => { topic: m.topic, value: m.payload, qos: m.qos }) }
}

// A client that comes later still learns the dashboard's state: the broker keeps the retained
// message and sends it on subscribing.
route GET /retained {
    broker()?
    mqtt_connect("late", url, { timeout_ms: 3000 })?
    mqtt_subscribe("late", "plant/dashboard", 0)?
    let got = mqtt_receive("late", 10, 2000)?
    mqtt_close("late")?
    { retained: got | map((m) => { topic: m.topic, payload: m.payload, retain: m.retain }) }
}

// MQTT 5: a command with user properties and a response topic, read back by a subscriber with
// its properties.
route GET /v5 {
    mqtt_connect("v5", url, { version: 5, timeout_ms: 3000 })?
    mqtt_subscribe("v5", "plant/cmd/#", 1)?
    let sent = mqtt_publish("v5", "plant/cmd/valve/7", "close", {
        qos: 1, content_type: "text/plain", response_topic: "plant/replies/7",
        user_properties: { line: "3", by: "dashboard" },
    })?
    let got = mqtt_receive("v5", 10, 2000)?
    mqtt_unsubscribe("v5", "plant/cmd/#")?
    mqtt_close("v5")?
    { sent: sent.acked, received: got | map((m) => { topic: m.topic, payload: m.payload, properties: m.properties }) }
}

route GET /status = {
    status: mqtt_status(broker()?)?,
    wildcards: {
        one_level: mqtt_matches("plant/+/temperature", "plant/boiler/temperature")?,
        not_deeper: mqtt_matches("plant/+", "plant/boiler/temperature")?,
        rest: mqtt_matches("plant/#", "plant/boiler/temperature")?,
    },
}
