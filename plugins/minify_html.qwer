//! HTML made smaller for sending: spaces, comments and optional tags taken out, and the CSS and JavaScript inside it minified too.
//! version: 1.0.0
//!
//! [dependencies]
//! minify-html = "0.16"

use serde_json::{json, Value};

const MAX_BYTES: usize = 64 * 1024 * 1024;

fn cfg(o: &Value) -> minify_html::Cfg {
    let mut c = minify_html::Cfg::new();
    let flag = |k: &str, d: bool| o.get(k).and_then(Value::as_bool).unwrap_or(d);
    c.minify_css = flag("minify_css", true);
    c.minify_js = flag("minify_js", true);
    c.keep_comments = flag("keep_comments", false);
    c.keep_closing_tags = flag("keep_closing_tags", false);
    c.keep_html_and_head_opening_tags = flag("keep_html_and_head_opening_tags", false);
    // Template syntax ({{ x }}, {% x %}, <% x %>) is kept as it is.
    c.preserve_brace_template_syntax = flag("keep_templates", true);
    c.preserve_chevron_percent_template_syntax = flag("keep_templates", true);
    c
}

fn run(html: &str, o: &Value) -> Result<String, String> {
    if html.len() > MAX_BYTES {
        return Err("more than 64 MB of HTML".into());
    }
    String::from_utf8(minify_html::minify(html.as_bytes(), &cfg(o))).map_err(|e| e.to_string())
}

/// `html` minified: whitespace between tags, comments, quotes and closing tags that browsers do not need are taken out,
/// and `<style>` and `<script>` contents minified. The page shows the same; a page or a fragment alike.
pub fn minify_html(html: &str) -> Result<String, String> {
    run(html, &Value::Null)
}

/// The same with `options`, each true or false: `minify_css`, `minify_js` (both true by default), `keep_comments`, `keep_closing_tags`
/// (for HTML other tools will parse) and `keep_templates` (true: `{{ }}`, `{% %}` and `<% %>` left alone).
pub fn minify_html_with(html: &str, options: serde_json::Value) -> Result<String, String> {
    run(html, &options)
}

/// Minifies the HTML file `from` into `to` (folders are made): `{ before, after }`, the sizes in bytes.
pub fn minify_html_file(from: &str, to: &str) -> Result<Value, String> {
    let html = std::fs::read_to_string(from).map_err(|e| format!("{}: {}", from, e))?;
    let out = run(&html, &Value::Null)?;
    if let Some(dir) = std::path::Path::new(to).parent().filter(|d| !d.as_os_str().is_empty()) {
        std::fs::create_dir_all(dir).map_err(|e| format!("{}: {}", dir.display(), e))?;
    }
    std::fs::write(to, &out).map_err(|e| format!("{}: {}", to, e))?;
    Ok(json!({ "before": html.len(), "after": out.len() }))
}
