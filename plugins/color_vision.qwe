// A dashboard's colours checked before release: do the chart's series stay apart for colour-blind readers, does the error text stay readable, and how does the map look to them?
//
//   quillo run color_vision.qwe      then open http://localhost:8080/check

use "color_vision.qwer"

// The usual red and green for "down" and "up", and a palette that holds up better.
let RISKY = ["#d62728", "#2ca02c", "#ff7f0e", "#1f77b4"]
let SAFER = ["#0072b2", "#e69f00", "#009e73", "#cc79a7"]

route GET /check {
    {
        red_for_deutan: color_vision_simulate("#d62728", "deuteranopia", 1.0)?,
        green_for_deutan: color_vision_simulate("#2ca02c", "deuteranopia", 1.0)?,
        mild: color_vision_simulate("#d62728", "deuteranomaly", 0.6)?,
        risky: color_vision_palette(RISKY, 10.0)?,
        safer: color_vision_palette(SAFER, 10.0)?,
        error_text: color_vision_contrast("#d62728", "#2ca02c")?,
        body_text: color_vision_contrast("#1a1a1a", "#ffffff")?.aa,
    }
}

route GET /photo/:kind {
    let out = color_vision_image("color_vision_sample.png", kind, 1.0, `data/color_vision/${kind}.png`)?
    file(out)
}
