// A marketplace with sellers writing in Arabic and Hebrew: the page direction of each listing, names isolated in English sentences, receipts for a printer with no bidi, and usernames checked for hidden direction tricks.
//
//   quillo run bidi.qwe      then open http://localhost:8080/bidi

use "bidi.qwer"

route GET /bidi {
    {
        arabic: bidi_direction("مرحبا بالعالم"),
        english: bidi_direction("Hello, world").direction,
        mixed: bidi_direction("שלום world"),
        digits: bidi_direction("123-456").direction,
        // "Order 15 for עלמה": in memory the Hebrew letters come first to last; a printer must get them reversed.
        receipt: bidi_visual("Order 15 for עלמה", "ltr")?,
        hebrew_line: bidi_visual("abc שלום", "rtl")?,
        isolated: replace(replace(bidi_isolate("עלמה"), "\u{2068}", "[FSI]"), "\u{2069}", "[PDI]"),
        // A file name that shows as "invoice‮fdp.exe" reads "invoiceexe.pdf" on screen.
        trick: bidi_check("invoice\u{202E}fdp.exe"),
        cleaned: bidi_strip("invoice\u{202E}fdp.exe"),
        plain: bidi_check("Plain name").safe,
    }
}

route GET /listing ? { title: str = "שולחן עץ" } {
    let dir = bidi_direction(title).direction
    <html><body>
        <h1 dir={dir == "rtl" ? "rtl" : "ltr"}>{title}</h1>
        <p>Sold by <bdi>{title}</bdi> in 3 days.</p>
    </body></html>
}
