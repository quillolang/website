fn stop_words(lang: &str) -> HashSet<String> {
    let list = match lang.trim().to_lowercase().get(..2).unwrap_or("en") {
        "fr" => STOP_FR, "de" => STOP_DE, "es" => STOP_ES, "it" => STOP_IT, "nl" => STOP_NL, "pt" => STOP_PT, _ => STOP_EN,
    };
    list.split_whitespace().map(|w| w.to_string()).collect()
}

fn words(s: &str, stop: &HashSet<String>) -> HashSet<String> {
    s.unicode_words()
        .map(|w| w.to_lowercase())
        .filter(|w| w.chars().count() > 1 && !stop.contains(w) && !w.chars().all(|c| c.is_numeric()))
        // A light stem: plurals and verb endings, so "prices" meets "price".
        .map(|w| {
            for suf in ["ing", "ed", "es", "s"] {
                if w.len() > suf.len() + 3 && w.ends_with(suf) { return w[..w.len() - suf.len()].to_string() }
            }
            w
        })
        .collect()
}

struct Ranked { text: String, position: usize, score: f64 }

fn rank(text: &str, lang: &str) -> Vec<Ranked> {
    let sp = spans(text, lang);
    let sents: Vec<String> = sp.iter().map(|(s, e)| text[*s..*e].split_whitespace().collect::<Vec<_>>().join(" ")).collect();
    let stop = stop_words(lang);
    let bags: Vec<HashSet<String>> = sents.iter().map(|s| words(s, &stop)).collect();
    let n = sents.len();
    let mut w = vec![vec![0.0f64; n]; n];
    for i in 0..n {
        for j in (i + 1)..n {
            let (a, b) = (&bags[i], &bags[j]);
            if a.len() < 2 || b.len() < 2 { continue }
            let common = a.intersection(b).count() as f64;
            if common == 0.0 { continue }
            let sim = common / ((a.len() as f64).ln() + (b.len() as f64).ln());
            w[i][j] = sim;
            w[j][i] = sim;
        }
    }
    let out: Vec<f64> = w.iter().map(|r| r.iter().sum()).collect();
    let mut score = vec![1.0f64; n];
    for _ in 0..60 {
        let mut next = vec![0.15f64; n];
        for i in 0..n {
            for j in 0..n {
                if w[j][i] > 0.0 && out[j] > 0.0 { next[i] += 0.85 * w[j][i] / out[j] * score[j] }
            }
        }
        let delta: f64 = next.iter().zip(&score).map(|(a, b)| (a - b).abs()).sum();
        score = next;
        if delta < 1e-6 { break }
    }
    sents.into_iter().enumerate().map(|(i, t)| Ranked { text: t, position: i, score: score[i] }).collect()
}

fn top(text: &str, count: usize, lang: &str) -> Vec<Ranked> {
    let mut r = rank(text, lang);
    r.sort_by(|a, b| b.score.partial_cmp(&a.score).unwrap_or(std::cmp::Ordering::Equal).then(a.position.cmp(&b.position)));
    r.truncate(count);
    r.sort_by_key(|x| x.position);
    r
}

/// A summary of `text` in its `count` most central sentences, in the order they come, joined by spaces. Text with no more sentences than that comes back whole. `lang` (`"en"`, `"fr"`, `"de"`...) picks the stop words and abbreviations.
pub fn summarize_text(text: &str, count: i64, lang: &str) -> String {
    top(text, count.max(1) as usize, lang).into_iter().map(|r| r.text).collect::<Vec<_>>().join(" ")
}

/// A summary of about `ratio` of the sentences (0.3 keeps 3 in 10, at least one), in their order.
pub fn summarize_ratio(text: &str, ratio: f64, lang: &str) -> Result<String, String> {
    if !(0.0..=1.0).contains(&ratio) { return Err(format!("the ratio is 0 to 1, not {}", ratio)) }
    let n = spans(text, lang).len();
    Ok(summarize_text(text, ((n as f64 * ratio).round() as i64).max(1), lang))
}

/// Every sentence with its TextRank score, most central first: `[{ text, position, score }]`, `position` counted from 0, `score` rounded to 4 places. For highlighting key sentences in place.
pub fn summarize_ranked(text: &str, lang: &str) -> Vec<Value> {
    let mut r = rank(text, lang);
    r.sort_by(|a, b| b.score.partial_cmp(&a.score).unwrap_or(std::cmp::Ordering::Equal).then(a.position.cmp(&b.position)));
    r.into_iter().map(|x| json!({ "text": x.text, "position": x.position, "score": (x.score * 10000.0).round() / 10000.0 })).collect()
}
