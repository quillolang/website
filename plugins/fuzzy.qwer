//! Fuzzy matching: rank names against what someone typed, typos and all, and edit distances.
//! version: 1.0.0
//!
//! [dependencies]
//! strsim = "0.11"

use serde_json::{json, Value};

/// How alike two strings are, 0 to 1, ignoring case: Jaro-Winkler, which favours a shared start.
pub fn fuzzy_score(a: &str, b: &str) -> f64 {
    strsim::jaro_winkler(&a.to_lowercase(), &b.to_lowercase())
}

/// The `items` most like `query`, best first, as `[{ item, score }]`: a match at the start or inside an item counts most, then likeness. At most `limit`, none under 0.5.
pub fn fuzzy_rank(query: &str, items: Vec<String>, limit: i64) -> Vec<Value> {
    let q = query.to_lowercase();
    let mut scored: Vec<(f64, String)> = items.into_iter().map(|it| {
        let l = it.to_lowercase();
        let s = if l.starts_with(&q) { 1.0 } else if l.contains(&q) { 0.9 } else {
            strsim::jaro_winkler(&q, &l).max(l.split_whitespace().map(|w| strsim::jaro_winkler(&q, w)).fold(0.0, f64::max) * 0.95)
        };
        (s, it)
    }).filter(|(s, _)| *s >= 0.5).collect();
    scored.sort_by(|a, b| b.0.partial_cmp(&a.0).unwrap_or(std::cmp::Ordering::Equal));
    scored.into_iter().take(limit.max(0) as usize).map(|(s, it)| json!({ "item": it, "score": (s * 1000.0).round() / 1000.0 })).collect()
}

/// The edits (insertions, deletions, changes, swaps of neighbours) that turn `a` into `b`.
pub fn edit_distance(a: &str, b: &str) -> i64 {
    strsim::damerau_levenshtein(a, b) as i64
}

/// The item nearest `word` in edits, for "did you mean ...?", or null when none is within `max_edits`.
pub fn did_you_mean(word: &str, items: Vec<String>, max_edits: i64) -> Option<String> {
    items.into_iter().map(|it| (strsim::damerau_levenshtein(&word.to_lowercase(), &it.to_lowercase()) as i64, it))
        .filter(|(d, _)| *d <= max_edits).min_by_key(|(d, _)| *d).map(|(_, it)| it)
}
