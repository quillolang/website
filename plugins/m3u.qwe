// A player's view of its playlists: a stream's HLS master and media lists, an IPTV M3U and a PLS,
// URLs resolved, the rules of RFC 8216 checked, and playlists written.
//
//   quillo run m3u.qwe      then open http://localhost:8080/master, /media, /m3u, /pls, /check, /write and /broken

use "m3u.qwer"

let BASE = "https://media.example/show/master.m3u8?sig=abc"

route GET /master {
    let p = m3u_parse(read_file("m3u_sample_master.m3u8"), BASE)?
    { kind: p.kind, version: p.version, independent: p.independent_segments, first: p.variants[0], second: [p.variants[1].bandwidth, p.variants[1].resolved], media: p.media | map((m) => [m.type, m.group_id, m.name, m.language, m.default, m.resolved]), iframes: p.iframe_streams[0].resolved, data: p.session_data }
}

route GET /media {
    let p = m3u_parse(read_file("m3u_sample_media.m3u8"), "https://media.example/show/video/index.m3u8")?
    {
        head: [p.kind, p.version, p.target_duration, p.media_sequence, p.discontinuity_sequence, p.playlist_type, p.ended, p.live, p.total_duration],
        urls: p.segments | map((s) => [s.sequence, s.duration, s.resolved]),
        ranges: p.segments | map((s) => s.byterange),
        first: [p.segments[0].title, p.segments[0].program_date_time, p.segments[0].map.resolved, p.segments[0].key],
        second_key: p.segments[1].key.iv,
        third_key: [p.segments[3].key.method, p.segments[3].key.iv, p.segments[3].key.iv_implied, p.segments[3].discontinuity],
        clear: [p.segments[4].key, p.segments[4].gap],
        other: p.other_tags,
    }
}

route GET /m3u {
    let p = m3u_read_file("m3u_sample.m3u")?
    { kind: p.kind, name: p.name, total: p.total_duration, entries: p.entries | map((e) => [e.title, e.duration, e.group, e.resolved]), attributes: p.entries[0].attributes, plain: m3u_parse("a.mp3\n# comment\nhttp://x/b.mp3\n", "/music/list.m3u")? }
}

route GET /pls = m3u_parse(read_file("m3u_sample.pls"), "http://radio.example/lists/a.pls")?

route GET /check = {
    good: m3u_check(read_file("m3u_sample_master.m3u8"))?,
    media: m3u_check(read_file("m3u_sample_media.m3u8"))?,
    bad: m3u_check("#EXTINF:12.5,\na.ts\n#EXT-X-BYTERANGE:10@0\nb.ts\n")?,
    long: m3u_check("#EXTM3U\n#EXT-X-VERSION:3\n#EXT-X-TARGETDURATION:4\n#EXTINF:4.6,\na.ts\n#EXT-X-KEY:METHOD=AES-128\n#EXT-X-MEDIA-SEQUENCE:5\n")?,
    variant: m3u_check("#EXTM3U\n#EXT-X-STREAM-INF:RESOLUTION=1x1\n#EXT-X-MEDIA:TYPE=CLOSED-CAPTIONS,GROUP-ID=\"c\",NAME=\"a\",URI=\"x\"\n#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID=\"c\",NAME=\"a\"\n#EXT-X-MEDIA:GROUP-ID=\"d\",NAME=\"b\"\n")?,
    mixed: m3u_check("#EXTM3U\n#EXT-X-TARGETDURATION:4\n#EXT-X-STREAM-INF:BANDWIDTH=1\nx.m3u8\n")?,
}

route GET /resolve = [
    m3u_resolve("https://a.example/b/c.m3u8?x=1", "d/e.ts"), m3u_resolve("https://a.example/b/c.m3u8", "../d.ts"), m3u_resolve("https://a.example/b/c.m3u8", "/d.ts"),
    m3u_resolve("https://a.example/b/c.m3u8", "//cdn.example/d.ts"), m3u_resolve("https://a.example/b/c.m3u8", "http://x.example/y"), m3u_resolve("https://a.example", "d.ts"),
    m3u_resolve("https://a.example/b/", "./d.ts?t=1"), m3u_resolve("/srv/lists/a.m3u", "../b.mp3"), m3u_resolve("", "x.ts"),
]

route GET /write {
    let media = m3u_parse(read_file("m3u_sample_media.m3u8"), "")?
    let text = m3u_write(media)?
    let again = m3u_parse(text, "")?
    let master = m3u_parse(read_file("m3u_sample_master.m3u8"), "")?
    let m_text = m3u_write(master)?
    let list = m3u_parse(read_file("m3u_sample.m3u"), "")?
    {
        fixed: m3u_write(again)? == text, uris: (again.segments | map((s) => s.uri)) == (media.segments | map((s) => s.uri)), offsets: again.segments | map((s) => s.byterange?.offset),
        text: text,
        clean: m3u_check(text)?,
        variants_back: m3u_parse(m_text, "")?.variants == master.variants,
        master: split(m_text, "\n")[5],
        m3u: m3u_write(list)?,
        pls: m3u_write(merge(m3u_parse(read_file("m3u_sample.pls"), "")?, { kind: "pls" }))?,
        made: m3u_write({ kind: "hls_media", segments: [{ uri: "a.ts", duration: 4 }, { uri: "b.ts", duration: 3.5 }] })?,
        live: m3u_write({ kind: "hls_media", live: true, target_duration: 6, media_sequence: 9, segments: [{ uri: "a.ts", duration: 6 }] })?,
        too_long: m3u_write({ kind: "hls_media", target_duration: 2, segments: [{ uri: "a.ts", duration: 4 }] }).error,
        no_uri: m3u_write({ kind: "hls_media", segments: [{ duration: 4 }] }).error,
        no_bandwidth: m3u_write({ kind: "hls_master", variants: [{ uri: "a" }] }).error,
        split_line: m3u_write({ entries: [{ url: "a\nb" }] }).error,
        bad_quote: m3u_write({ kind: "hls_master", variants: [{ uri: "a", bandwidth: 1, audio: "x\"y" }] }).error,
        bad_kind: m3u_write({ kind: "wpl" }).error,
    }
}

route GET /broken = {
    empty: m3u_parse("", "").error,
    pls_no_equals: m3u_parse("[playlist]\nnonsense\n", "").error,
    pls_no_number: m3u_parse("[playlist]\nFileX=a\n", "").error,
    pls_no_file: m3u_parse("[playlist]\nTitle1=a\n", "").error,
    pls_count: m3u_parse("[playlist]\nFile1=a\nNumberOfEntries=3\n", "")?.problems,
    no_file: m3u_read_file("nothing.m3u").error != null,
    junk_attrs: m3u_parse("#EXTM3U\n#EXT-X-STREAM-INF:,,=,BANDWIDTH=5,RESOLUTION=axb\nu\n", "")?.variants,
}
