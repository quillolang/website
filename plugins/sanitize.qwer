//! HTML from users made safe to show: scripts, event handlers and dangerous links removed, formatting kept.
//!
//! [dependencies]
//! ammonia = "4"

use std::collections::HashSet;

/// `html` with only safe tags and attributes left (links, lists, tables, images, emphasis); links get `rel="noopener noreferrer"`.
pub fn sanitize_html(html: &str) -> String {
    ammonia::clean(html)
}

/// `html` with only the `tags` named left, and none of their attributes but `href` on links.
pub fn sanitize_html_only(html: &str, tags: Vec<String>) -> String {
    let set: HashSet<&str> = tags.iter().map(|t| t.as_str()).collect();
    let mut b = ammonia::Builder::empty();
    b.tags(set);
    if tags.iter().any(|t| t == "a") {
        b.add_tag_attributes("a", &["href"]).link_rel(Some("noopener noreferrer nofollow")).url_schemes(["http", "https", "mailto"].into());
    }
    b.clean(html).to_string()
}

/// The text of `html`, every tag taken out (the text stays escaped, ready for a page).
pub fn strip_tags(html: &str) -> String {
    ammonia::Builder::empty().clean(html).to_string()
}
