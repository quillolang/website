// A mosque's website: today's Hijri date in the header, Ramadan's dates, and the year's holy days.
//
//   quillo run hijri.qwe      then open http://localhost:8080/calendar

use "hijri.qwer"

route GET /calendar {
    {
        today: hijri_from_date("today", "")?.text,
        date: hijri_from_date("2026-10-29", "")?,
        civil: hijri_from_date("2026-10-29", "civil")?.text,
        ramadan: hijri_month(1448, 9, "")?,
        back: hijri_to_date(1447, 10, 1, "")?,
        bad: hijri_month(1448, 13, "").error,
    }
}

route GET /holy-days/:year(int) = hijri_holy_days(year, "")?

route GET / {
    let h = hijri_from_date("today", "")?
    <html><body>
        <header>{h.weekday}, {h.text} · <span dir="rtl" lang="ar">{h.weekday_ar} {h.text_ar}</span></header>
    </body></html>
}
