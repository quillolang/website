//! Differences between two texts: line by line, word by word, as a unified diff, and how alike they are.
//!
//! [dependencies]
//! similar = "2"

use serde_json::{json, Value};
use similar::{ChangeTag, TextDiff};

fn changes<'a, 'b>(d: &TextDiff<'a, 'a, 'b, str>) -> Vec<Value> {
    d.iter_all_changes().map(|c| {
        let op = match c.tag() { ChangeTag::Equal => "equal", ChangeTag::Insert => "insert", ChangeTag::Delete => "delete" };
        json!({ "op": op, "text": c.value() })
    }).collect()
}

/// The lines of `old` and `new` as changes: `[{ op: "equal" | "insert" | "delete", text }]`, ready to show in green and red.
pub fn diff_lines(old: &str, new: &str) -> Vec<Value> {
    changes(&TextDiff::from_lines(old, new))
}

/// The same, word by word (spaces kept as their own changes), for a sentence or a title.
pub fn diff_words(old: &str, new: &str) -> Vec<Value> {
    changes(&TextDiff::from_words(old, new))
}

/// A unified diff, as `git diff` writes one, with `context` lines around each change.
pub fn unified_diff(old: &str, new: &str, old_name: &str, new_name: &str, context: i64) -> String {
    TextDiff::from_lines(old, new).unified_diff().context_radius(context.max(0) as usize).header(old_name, new_name).to_string()
}

/// How alike two texts are, from 0 to 1, by their characters.
pub fn diff_ratio(old: &str, new: &str) -> f64 {
    TextDiff::from_chars(old, new).ratio() as f64
}
