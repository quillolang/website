<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:gx="http://www.google.com/kml/ext/2.2">
<Document>
  <name>Lakeside walk</name>
  <Style id="stop"><IconStyle><scale>1.2</scale></IconStyle></Style>
  <Folder>
    <name>Stops</name>
    <Placemark>
      <name>Car park</name>
      <description>Free on weekdays.</description>
      <styleUrl>#stop</styleUrl>
      <ExtendedData><Data name="spaces"><value>40</value></Data></ExtendedData>
      <Point><coordinates>8.5417,47.3769,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Café by the pier</name>
      <ExtendedData><Data name="opens"><value>08:00</value></Data></ExtendedData>
      <Point><coordinates>8.5452,47.3655,408</coordinates></Point>
    </Placemark>
  </Folder>
  <Placemark>
    <name>The walk</name>
    <LineString><tessellate>1</tessellate><coordinates>
      8.5417,47.3769,0 8.5430,47.3730,0 8.5441,47.3690,0 8.5452,47.3655,0
    </coordinates></LineString>
  </Placemark>
  <Placemark>
    <name>Picnic meadow</name>
    <Polygon><outerBoundaryIs><LinearRing><coordinates>
      8.5460,47.3700 8.5480,47.3700 8.5480,47.3715 8.5460,47.3715 8.5460,47.3700
    </coordinates></LinearRing></outerBoundaryIs></Polygon>
  </Placemark>
  <Placemark>
    <name>Morning run</name>
    <gx:Track><when>2026-10-29T07:00:00Z</when><when>2026-10-29T07:05:00Z</when>
      <gx:coord>8.5417 47.3769 0</gx:coord><gx:coord>8.5441 47.3690 0</gx:coord></gx:Track>
  </Placemark>
