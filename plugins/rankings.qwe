// A recipe site's lists ranked fairly: comments by the Wilson score of their votes, recipes by a
// Bayesian average and by their star counts (few votes do not win), a "hot" front page, and
// which search terms are trending today.
//
//   quillo run rankings.qwe      then open http://localhost:8080/recipes and http://localhost:8080/scores

use "rankings.qwer"

let RECIPES = [
    { name: "Lemon tart", rating: 4.9, votes: 7, counts: [0, 0, 0, 1, 6] },
    { name: "Ragù", rating: 4.6, votes: 2140, counts: [21, 43, 150, 470, 1456] },
    { name: "Brownies", rating: 4.7, votes: 310, counts: [3, 5, 20, 40, 242] },
    { name: "Kale smoothie", rating: 3.1, votes: 95, counts: [20, 15, 20, 20, 20] },
]

route GET /recipes = {
    bayesian: rank_items(RECIPES, "bayesian", { prior_count: 50.0 })? | map((x) => `${x.rank}. ${x.name} (${x.score})`),
    stars: rank_items(RECIPES, "stars", {})? | map((x) => `${x.rank}. ${x.name} (${x.score})`),
}

route GET /scores = {
    wilson: [rank_wilson(9, 10, 0.95)?, rank_wilson(900, 1000, 0.95)?],
    comments: rank_items([{ id: 1, up: 5, down: 0 }, { id: 2, up: 80, down: 12 }, { id: 3, up: 0, down: 0 }, { id: 4, up: 40, down: 6 }], "wilson", {})? | map((c) => [c.id, c.rank]),
    imdb: rank_bayesian(9.2, 1200, 6.9, 25000.0),
    stars: rank_stars([0, 0, 0, 0, 3], 0.95)?,
    hot: rank_hot(250, 20, 1761750000),
    hn: rank_hacker_news(120, 5.0, 1.8),
    decay: rank_decay(100.0, 48.0, 24.0),
    trending: rank_trending([12.0, 9.0, 15.0, 11.0, 10.0, 13.0, 12.0], 41.0),
    ties: rank_items([{ n: "a", s: 3 }, { n: "b", s: 5 }, { n: "c", s: 5 }, { n: "d", s: 1 }], "field", { field: "s" })? | map((x) => `${x.n}:${x.rank}`),
}
