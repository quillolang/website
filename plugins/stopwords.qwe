// A search box that ignores "the", "a" and "of", and a word count of what is left.
//
//   quillo run stopwords.qwe      then open http://localhost:8080/query?q=the%20history%20of%20the%20roman%20empire

use "stopwords.qwer"

route GET /query ? { q: str, lang: str = "en" } = { terms: stopwords_remove(q, lang)? }

route GET /french = { terms: stopwords_remove("Le petit prince et la rose de son astéroïde", "fr")?, is_stop: stopwords_is("Les", "fr")? }

route GET /languages = { count: len(stopwords_languages()), english: len(stopwords_list("en")?) }
