// A log file compressed with zstd, and text both ways.
//
//   quillo run zstd.qwe      then open http://localhost:8080/pack

use "zstd.qwer"

route GET /pack {
    let lines = for i in range(5000) => `2026-10-29T10:00:${i % 60} GET /menu 200 ${i % 7}ms`
    write_file("data/access.log", join(lines, "\n"))
    let size = zstd_file("data/access.log", "data/access.log.zst", 19)?
    let back = unzstd_file("data/access.log.zst", "data/access.copy.log")?
    let packed = zstd_text("hello, hello, hello", 3)?
    { log_bytes: len(read_file("data/access.log")), zst_bytes: size, unpacked_bytes: back, text: packed, back: unzstd_text(packed)? }
}
