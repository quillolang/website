// Links pasted into posts shown as players: a known provider's endpoint is asked, or the one the
// page names; the answer's HTML is cut down to one sandboxed iframe from a known player.
//
//   quillo run oembed.qwe      then open http://localhost:8080/offline
//   http://localhost:8080/embed?url=https://www.youtube.com/watch%3Fv%3DdQw4w9WgXcQ goes to the network.

use "oembed.qwer"

route GET /offline = {
    discovered: oembed_discover(read_file("oembed_sample.html")?, "https://kitchen.example.com/sourdough")?,
    youtube: oembed_endpoint("https://www.youtube.com/watch?v=dQw4w9WgXcQ", 720),
    unknown: oembed_endpoint("https://blog.example.com/post/1", 0),
    answer: oembed_read(read_file("oembed_sample.json")?, [])?,
    player: oembed_player("https://youtu.be/dQw4w9WgXcQ?t=42", 42),
}

route GET /embed ? { url: str } {
    let e = oembed_fetch(url, 720, 5000)
    if is_err(e) { reply 502 e.error }
    <figure>
        {raw(e.iframe ?? "")}
        <figcaption>{e.title} · {e.provider_name}</figcaption>
    </figure>
}
