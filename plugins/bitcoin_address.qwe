// Bitcoin addresses: each kind told apart with its network and script, a wrong one refused with
// its reason, addresses from a public key, and BIP-21 payment links both ways. No node is asked.
//
//   quillo run bitcoin_address.qwe
//   then open http://localhost:8080/check?address=bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4, /kinds, /refused, /keys and /uri

use "bitcoin_address.qwer"

route GET /check ? { address: str } {
    let a = btc_address(address)
    if is_err(a) { reply 422 a.error }
    a
}

// The addresses BIP-173 and BIP-350 give, and the genesis block's.
route GET /kinds = {
    legacy: btc_address("1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa")?,
    script: btc_address("3J98t1WpEZ73CNmQviecrnyiWrnqRhWNLy")?.type,
    segwit: btc_address("BC1QW508D6QEJXTDG4Y5R3ZARVARY0C5XW7KV8F3T4")?.script_pubkey,
    witness_script: btc_address("tb1qrp33g0q5c5txsp9arysrx4k6zdkfs4nce4xj0gdcccefvpysxf3q0sl5k7")?,
    taproot: btc_address("bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqzk5jj0")?,
    testnet: btc_address("mipcBbFg9gMiCh81Kj8tqqdgoZub1ZJRfn")?.network,
}

// One character changed, then each thing the standards forbid.
route GET /refused = {
    checksum: btc_address("1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNb").error,
    alphabet: btc_address("1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfN0").error,
    bech32: btc_address("bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t5").error,
    mixed: btc_address("bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kV8F3T4").error,
    wrong_constant: btc_address("bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqh2y7hd").error,
    private_key: btc_is_valid("5HueCGU8rMjxEXxiPuD5BDku4MkFqeZyd4dZ1jvhTVqvbTLvyTJ", ""),
    wrong_network: btc_is_valid("mipcBbFg9gMiCh81Kj8tqqdgoZub1ZJRfn", "mainnet"),
}

// The public key of private key 1, whose addresses are well known.
let key = "0279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798"
route GET /keys = {
    addresses: btc_from_pubkey(key, "mainnet")?,
    testnet: btc_from_pubkey(key, "testnet")?.p2wpkh,
    made: btc_encode("p2tr", "79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798", "mainnet")?,
    short: btc_encode("p2wsh", "00ff", "mainnet").error,
}

route GET /uri {
    let to = "bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4"
    let link = btc_uri_build(to, { amount: "0.0012", label: "Coffee & cake", message: "Order 1001" })?
    {
        link: link,
        read: btc_uri_parse(link)?,
        bip21: btc_uri_parse("bitcoin:1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN2?amount=20.3&label=Luke-Jr")?,
        sats: btc_sats("20.30000001")?,
        back: btc_amount(120000)?,
        required: btc_uri_parse("bitcoin:1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN2?req-somethingyoudontunderstand=50").error,
        exponent: btc_uri_parse("bitcoin:1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN2?amount=1e3").error,
        tiny: btc_sats("0.000000001").error,
    }
}
