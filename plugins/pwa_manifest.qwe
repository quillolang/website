// A shop installable as an app: its icons made from one image at start, its manifest served,
// and the head tags on every page.
//
//   quillo run pwa_manifest.qwe      then open http://localhost:8080/ and http://localhost:8080/manifest.webmanifest

use "pwa_manifest.qwer"

let ICONS = pwa_icons("pwa_manifest_sample.png", "data/icons", "#2e7d32", "/icons/")?

let MANIFEST = pwa_manifest({
    name: "Quillo Corner Shop",
    id: "/?app=shop",
    description: "Order groceries for pickup in ten minutes.",
    theme_color: "#2e7d32",
    background_color: "#ffffff",
    icons: ICONS,
    shortcuts: [{ name: "My orders", url: "/orders" }],
})?

route GET /manifest.webmanifest = respond(200, json.stringify(MANIFEST), { "content-type": "application/manifest+json" })

route GET /icons/:name = file(`data/icons/${name}`)

route GET / = respond(200, `<!doctype html><html><head><title>Corner Shop</title>
${pwa_head_tags("/manifest.webmanifest", "#2e7d32", "Corner Shop", "/icons/")}
</head><body><h1>Corner Shop</h1></body></html>`, { "content-type": "text/html; charset=utf-8" })

route GET /check = {
    ours: pwa_check(MANIFEST),
    bare: pwa_check('{"name": "Old site", "display": "browser", "icons": [{"src": "/i.png", "sizes": "64x64"}]}'),
    icons: len(ICONS),
}
