// A file list with sizes and ages as people read them, and settings typed as people write them.
//
//   quillo run humanize.qwe      then open http://localhost:8080/files

use "humanize.qwer"

let t = now()
let files = [
    { name: "backup.tar.gz", bytes: 1500000000, at: t - 3 * 86400000 },
    { name: "photo.jpg", bytes: 2400000, at: t - 5 * 60000 },
    { name: "notes.txt", bytes: 812, at: t - 10000 },
]

route GET /files = files | map((f) => { name: f.name, size: humanize_bytes(f.bytes, true), memory: humanize_bytes(f.bytes, false), changed: humanize_ago(f.at, t) })

// Settings a person typed: "session lasts 2h 30m", "uploads up to 25 MB".
route GET /settings ? { session: str = "2h 30m", upload: str = "25 MB" } = {
    session_seconds: humanize_parse_duration(session)?,
    upload_bytes: humanize_parse_bytes(upload)?,
    shown: humanize_duration(humanize_parse_duration(session)?)?,
}

route GET /ahead = { soon: humanize_ago(now() + 2 * 3600000, now()), later: humanize_ago(now() + 400 * 86400000, now()) }
