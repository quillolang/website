//! Code highlighted as HTML for docs, blogs and code review pages: Rust, Python, JavaScript, SQL, HTML and 70 more, with CSS classes or inline colours.
//! version: 1.0.0
//!
//! [dependencies]
//! syntect = { version = "5.3", default-features = false, features = ["parsing", "default-syntaxes", "default-themes", "html", "regex-fancy"] }

use std::sync::OnceLock;
use syntect::highlighting::ThemeSet;
use syntect::html::{css_for_theme_with_class_style, highlighted_html_for_string, ClassStyle, ClassedHTMLGenerator};
use syntect::parsing::{SyntaxReference, SyntaxSet};
use syntect::util::LinesWithEndings;

const MAX: usize = 1_000_000;

fn syntaxes() -> &'static SyntaxSet {
    static S: OnceLock<SyntaxSet> = OnceLock::new();
    S.get_or_init(SyntaxSet::load_defaults_newlines)
}

fn themes() -> &'static ThemeSet {
    static T: OnceLock<ThemeSet> = OnceLock::new();
    T.get_or_init(ThemeSet::load_defaults)
}

fn syntax<'a>(ss: &'a SyntaxSet, language: &str, code: &str) -> &'a SyntaxReference {
    let l = language.trim().trim_start_matches('.');
    let alias = match l.to_lowercase().as_str() {
        "js" | "javascript" | "jsx" | "ts" | "typescript" | "tsx" => "js",
        "py" | "python" => "py",
        "sh" | "bash" | "shell" | "zsh" => "sh",
        "rs" | "rust" => "rs",
        "md" | "markdown" => "md",
        "yml" | "yaml" => "yaml",
        "c++" | "cpp" => "cpp",
        "c#" | "csharp" | "cs" => "cs",
        "html" | "htm" => "html",
        "golang" | "go" => "go",
        "rb" | "ruby" => "rb",
        _ => l,
    };
    ss.find_syntax_by_token(alias)
        .or_else(|| ss.find_syntax_by_first_line(code))
        .unwrap_or_else(|| ss.find_syntax_plain_text())
}

/// `code` as a `<pre>` block of HTML with inline colours from `theme` (see `highlight_themes()`; "InspiredGitHub" is light, "base16-ocean.dark" dark). `language` is a name or file extension ("rust", "py", "sql"); one it does not know is plain text. Code up to 1 MB.
pub fn highlight_html(code: &str, language: &str, theme: &str) -> Result<String, String> {
    if code.len() > MAX {
        return Err("code up to 1 MB".into());
    }
    let ss = syntaxes();
    let t = themes().themes.get(theme).ok_or_else(|| format!("no theme {:?}; see highlight_themes()", theme))?;
    highlighted_html_for_string(code, ss, syntax(ss, language, code), t).map_err(|e| e.to_string())
}

/// `code` as HTML spans with classes (`<span class="source rust">`), no `<pre>` around it, for a stylesheet of your own or `highlight_css`. Code up to 1 MB.
pub fn highlight_classes(code: &str, language: &str) -> Result<String, String> {
    if code.len() > MAX {
        return Err("code up to 1 MB".into());
    }
    let ss = syntaxes();
    let mut g = ClassedHTMLGenerator::new_with_class_style(syntax(ss, language, code), ss, ClassStyle::Spaced);
    for line in LinesWithEndings::from(code) {
        g.parse_html_for_line_which_includes_newline(line).map_err(|e| e.to_string())?;
    }
    Ok(g.finalize())
}

/// The CSS for `highlight_classes`' spans in the colours of `theme`; its `.code` rule is the background, for a `<pre class="code">` around them.
pub fn highlight_css(theme: &str) -> Result<String, String> {
    let t = themes().themes.get(theme).ok_or_else(|| format!("no theme {:?}; see highlight_themes()", theme))?;
    css_for_theme_with_class_style(t, ClassStyle::Spaced).map_err(|e| e.to_string())
}

/// The names of the themes there are.
pub fn highlight_themes() -> Vec<String> {
    themes().themes.keys().cloned().collect()
}

/// The languages there are, by name, each with its file extensions: `[{ name, extensions }]`.
pub fn highlight_languages() -> Vec<serde_json::Value> {
    syntaxes().syntaxes().iter().map(|s| serde_json::json!({ "name": s.name, "extensions": s.file_extensions })).collect()
}
