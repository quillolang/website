// Where a satellite is, and when it passes over a place: the sample is an International Space
// Station TLE from July 2020, so the times asked about are then, and the first check is the SGP4
// verification table's satellite 00005.
//
//   quillo run satellites.qwe      then open http://localhost:8080/elements, /verify, /where, /look, /passes, /track and /refused
//
// Current elements come from celestrak.org: `FORMAT=tle` or `FORMAT=json`. Elements go stale fast:
// fetch them daily for a low orbit.

use "satellites.qwer"

let ISS = "ISS (ZARYA)
1 25544U 98067A   20194.88612269 -.00002218  00000-0 -31515-4 0  9992
2 25544  51.6461 221.2784 0001413  89.1723 280.4612 15.49507896236008"

// From Vallado's "Revisiting Spacetrack Report #3" test cases.
let VANGUARD = "1 00005U 58002B   00179.78495062  .00000023  00000-0  28098-4 0  4753
2 00005  34.2682 348.7242 1859667 331.7664  19.3264 10.82419157413667"

let OMM = "{\"OBJECT_NAME\":\"ISS (ZARYA)\",\"OBJECT_ID\":\"1998-067A\",\"EPOCH\":\"2020-07-12T21:16:01.000416\",\"MEAN_MOTION\":15.49507896,\"ECCENTRICITY\":0.0001413,\"INCLINATION\":51.6461,\"RA_OF_ASC_NODE\":221.2784,\"ARG_OF_PERICENTER\":89.1723,\"MEAN_ANOMALY\":280.4612,\"EPHEMERIS_TYPE\":0,\"CLASSIFICATION_TYPE\":\"U\",\"NORAD_CAT_ID\":25544,\"ELEMENT_SET_NO\":999,\"REV_AT_EPOCH\":23600,\"BSTAR\":-0.31515e-4,\"MEAN_MOTION_DOT\":-0.00002218,\"MEAN_MOTION_DDOT\":0}"

let PARIS = { latitude: 48.8566, longitude: 2.3522, altitude_m: 35.0 }

route GET /elements = {
    tle: satellites_read(ISS)?,
    two_at_once: satellites_read(ISS + "\n" + VANGUARD)? | map((s) => [s.name, s.norad_id, s.period_min]),
    omm: satellites_read(OMM)?[0].apogee_km,
    checksum: [satellites_checksum("1 25544U 98067A   20194.88612269 -.00002218  00000-0 -31515-4 0  9992"), satellites_checksum("1 25544U 98067A   20194.88612269 -.00002218  00000-0 -31515-4 0  9993")],
}

fn fixed(xs) = xs | map((x) => round(x * 1000) / 1000)

route GET /verify = {
    at_0: fixed(satellites_state(VANGUARD, 0.0)?.position),
    velocity_0: fixed(satellites_state(VANGUARD, 0.0)?.velocity),
    at_360: fixed(satellites_state(VANGUARD, 360.0)?.position),
}

route GET /where {
    let p = satellites_position(ISS, "2020-07-13T12:00:00Z")?
    let q = satellites_position(OMM, "2020-07-13T12:00:00Z")?
    { position: p, omm_within_km: abs(p.latitude - q.latitude) < 1.0 }
}

route GET /look = {
    now: satellites_look(ISS, PARIS, "2020-07-13T12:00:00Z")?,
    bad_time: satellites_look(ISS, PARIS, "tomorrow").error,
}

route GET /passes {
    let all = satellites_passes(ISS, PARIS, "2020-07-13T00:00:00Z", 24.0, 10.0)?
    let low = satellites_passes(ISS, PARIS, "2020-07-13T00:00:00Z", 24.0, 0.0)?
    {
        over_10: len(all), any: len(low), first: all[0],
        sane: all | map((p) => p.duration_s > 60 && p.duration_s < 800 && p.peak_elevation >= 10.0 && p.peak_elevation <= 90.0),
        ordered: all[0].rise < all[0].peak && all[0].peak < all[0].set,
    }
}

route GET /track {
    let t = satellites_track(ISS, "2020-07-13T12:00:00Z", 92.0, 60)?
    {
        points: len(t), highest_latitude: max(t | map((p) => abs(p.latitude))), start: t[0],
        too_many: satellites_track(ISS, "2020-07-13T12:00:00Z", 100000.0, 1).error,
    }
}

route GET /refused = {
    checksum: satellites_read("1 25544U 98067A   20194.88612269 -.00002218  00000-0 -31515-4 0  9993\n2 25544  51.6461 221.2784 0001413  89.1723 280.4612 15.49507896236008").error,
    short: satellites_read("1 25544U\n2 25544").error,
    one_line: satellites_read("1 25544U 98067A   20194.88612269 -.00002218  00000-0 -31515-4 0  9992").error,
    not_omm: satellites_read("{\"OBJECT_NAME\":\"x\"}").error != null,
    place: satellites_look(ISS, { latitude: 95.0, longitude: 0.0 }, "2020-07-13T12:00:00Z").error,
    far: satellites_passes(ISS, PARIS, "2020-07-13T00:00:00Z", 1000.0, 0.0).error,
}
