// Direct deposit set-up for a payroll app: the routing number an employee types checked before
// the first payday, a scanned check's MICR line read, and Canadian employees' bank numbers.
//
//   quillo run aba_routing.qwe      then open http://localhost:8080/check/021000021 and http://localhost:8080/demo

use "aba_routing.qwer"

route GET /check/:routing = aba_check(routing)

route GET /demo = {
    chase_ny: aba_check("021000021"),
    credit_union: aba_check("322271627").kind,
    typo: aba_check("021000022").error,
    check_digit: aba_check_digit("02100002")?,
    // A personal check, as a scanner typed it, and a business check with the check number first.
    personal: aba_micr("T121000358T 3255 0172 5O 1042")?,
    business: aba_micr("⑈001042⑈ ⑆026009593⑆ 4471 0026 63⑈")?,
    canada: aba_canada("12345", "003")?,
}
