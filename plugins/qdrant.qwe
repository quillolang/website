// Finding similar documents in Qdrant: a collection, points with payloads, a vector search narrowed
// by a filter, everything walked by scrolling, and the errors Qdrant gives.
//
//   QDRANT_API_URL=http://localhost:6333 QDRANT_API_KEY=... quillo run qdrant.qwe
//   then open /setup, /search, /filtered, /scroll, /count, /broken

use "qdrant.qwer"

route GET /setup = {
    made: qdrant_create_collection("docs", 3, "Cosine", null)?,
    again: qdrant_create_collection("docs", 3, "Cosine", null)?,
    index: qdrant_index_field("docs", "lang", "keyword")?.status,
    written: qdrant_upsert("docs", [
        { id: 1, vector: [0.9, 0.1, 0.0], payload: { lang: "en", year: 2020, title: "Rust" } },
        { id: 2, vector: [0.8, 0.2, 0.1], payload: { lang: "fr", year: 2022, title: "Rouille" } },
        { id: 3, vector: [0.0, 1.0, 0.0], payload: { lang: "en", year: 2024, title: "Python" } },
        { id: "6f2c4e0a-2d55-4b1e-9f3b-0a4f1c9d7e11", vector: [0.7, 0.0, 0.7], payload: { lang: "de", year: 2023, title: "Rost" } },
    ])?,
    info: qdrant_collection("docs")?.points_count,
}

route GET /search {
    let r = qdrant_search("docs", [1.0, 0.0, 0.0], { limit: 2 })?
    { titles: r | map((p) => p.payload.title), first: r[0].id }
}

route GET /filtered = {
    english: qdrant_search("docs", [1.0, 0.0, 0.0], { filter: { lang: "en", year: { gte: 2021 } } })? | map((p) => p.payload.title),
    any_of: qdrant_search("docs", [1.0, 0.0, 0.0], { filter: { lang: ["fr", "de"] }, limit: 5 })? | map((p) => p.payload.title),
    none_of: qdrant_search("docs", [1.0, 0.0, 0.0], { filter: { must_not: { lang: "en" } } })? | map((p) => p.payload.title),
    filter: qdrant_filter({ lang: "en", year: { gte: 2021 } })?,
}

route GET /scroll {
    let first = qdrant_scroll("docs", null, 2, null)?
    let all = qdrant_scroll_all("docs", { lang: "en" }, 10)?
    { first: first.points | map((p) => p.id), next: first.next, all: all.points | map((p) => p.id), complete: all.complete }
}

route GET /count {
    let tagged = qdrant_set_payload("docs", { tagged: true }, { lang: "de" })?
    { all: qdrant_count("docs", null)?, tagged: qdrant_count("docs", { tagged: true })?, status: tagged.status, got: qdrant_get("docs", [1, 99], false)? | map((p) => p.payload.title) }
}

route GET /broken = {
    wrong_size: qdrant_search("docs", [1.0, 0.0], null).error,
    no_collection: qdrant_search("nothing", [1.0, 0.0, 0.0], null).error,
    bad_id: qdrant_upsert("docs", [{ id: "not-a-uuid", vector: [1.0, 0.0, 0.0] }]).error,
    all_points: qdrant_delete("docs", null).error,
}
