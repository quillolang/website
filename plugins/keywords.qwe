// Tags suggested for a blog post, and the words that set a shop's products apart.
//
//   quillo run keywords.qwe      then open http://localhost:8080/tags

use "keywords.qwer"

let post = "Solar panels on the roof of a house turn sunlight into electricity. A solar panel works best facing south, without shade. Battery storage keeps the electricity for the evening, so a house with solar panels and battery storage buys less electricity from the grid. The price of solar panels has fallen every year for a decade."

route GET /tags = { rake: keywords_rake(post, 5, "en")?, textrank: keywords_textrank(post, 5, "en")? }

route GET /products = keywords_tfidf([
    "Leather wallet with coin pocket, brown leather, hand stitched",
    "Canvas backpack with laptop pocket, waterproof canvas",
    "Leather belt, black leather, brass buckle",
    "Waterproof jacket with hood, breathable",
], 5, "en")?
