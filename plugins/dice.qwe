// Dice for a tabletop game: notation parsed, rolled from a seed so a game can be replayed, a
// character's stats, and the exact chances of a hit.
//
//   quillo run dice.qwe
//   then open http://localhost:8080/roll?dice=4d6kh3&seed=7, /same, /kinds, /chances and /refused

use "dice.qwer"

route GET /roll ? { dice: str, seed: str = "demo" } {
    let r = dice_roll(dice, seed)
    if is_err(r) { reply 422 r.error }
    r
}

route GET /same = {
    equal: dice_roll("4d6kh3", 7)? == dice_roll("4d6kh3", 7)?,
    other: dice_roll("10d100", 7)?.total == dice_roll("10d100", 8)?.total,
    by_text: dice_roll("10d100", "table 3")?.total == dice_roll("10d100", "table 3")?.total,
    stats: dice_roll_many("4d6dl1", 6, 2024)?.rolls,
}

// One roll of each kind, with what must hold whatever the dice say.
route GET /kinds {
    let k = dice_roll("4d6kh3", 1)?.dice[0]
    let a = dice_roll("d20adv", 2)?.dice[0]
    let e = dice_roll("20d6!", 3)?.dice[0]
    let c = dice_roll("10d4!!", 4)?.dice[0]
    let r = dice_roll("100d6r1", 5)?.dice[0]
    let s = dice_roll("6d10>=7", 6)?.dice[0]
    let f = dice_roll("4dF", 7)?.dice[0]
    {
        keep: { kept: len(k.kept), dropped: len(k.dropped), lowest_gone: max(k.dropped) <= min(k.kept), total: sum(k.kept) == k.total },
        advantage: { rolled: len(a.rolls), best: a.total == max(a.rolls) },
        exploding: { more_than_20: len(e.rolls) == 20 + e.exploded },
        compounding: { stays_ten: len(c.rolls) == 10 },
        reroll: { no_ones: !contains(r.rolls, 1) },
        success: { count: s.total == count(s.rolls, (x) => x >= 7) },
        fudge: { faces: all(f.rolls, (x) => x >= -1 && x <= 1) },
        percent: dice_roll("d%", 8)?.total <= 100,
        sum: dice_roll("(2d1+1)*2-1", 9)?.total,
        rounded_down: dice_roll("7/2", 9)?.total,
    }
}

route GET /chances = {
    two_d6: dice_distribution("2d6")?,
    stats: dice_distribution("4d6kh3")?,
    advantage: dice_chance("d20adv", ">=", 15)?,
    disadvantage: dice_chance("d20dis", ">=", 15)?,
    plain: dice_chance("d20+5", ">=", 15)?,
    reroll_ones: dice_distribution("1d6r1")?.mean,
    reroll_once: dice_distribution("1d6ro1")?.mean,
    exploding: dice_distribution("1d6!")?.mean,
    successes: dice_distribution("3d6>=5")?.mean,
    fudge: dice_distribution("4dF")?.stddev,
}

route GET /read = dice_parse("4d6kh3 + 2")?

route GET /refused = {
    letters: dice_roll("cat", 1).error,
    sides: dice_roll("2d", 1).error,
    many: dice_roll("9999d6", 1).error,
    forever: dice_roll("3d1!", 1).error,
    always: dice_roll("1d6r<7", 1).error,
    keep: dice_roll("2d6kh3", 1).error,
    zero: dice_roll("1d6/0", 1).error,
    bracket: dice_roll("(1d6", 1).error,
}
