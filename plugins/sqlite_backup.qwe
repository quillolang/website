// A nightly backup of the shop's database: a consistent copy, checked, summed up, and a second copy for the off-site disk.
//
//   quillo run sqlite_backup.qwe      then open http://localhost:8080/backup

use "sqlite_backup.qwer"

db.open("data/shop.db")
db.exec("create table if not exists orders (id integer primary key, customer text, total real)")
db.exec("create table if not exists customers (id integer primary key, name text)")

route GET /backup {
    db.exec("delete from orders")
    for i in range(250) { db.exec("insert into orders (customer, total) values (?, ?)", `customer ${i % 40}`, i * 1.5) }
    // The program's own database is copied by its own SQLite...
    write_file("data/backups/.keep", "")          // vacuum into makes no folders
    delete_file("data/backups/shop.db")           // nor replaces a file
    db.exec("vacuum into ?", "data/backups/shop.db")?
    // ...and the copy, which nothing has open, checked and copied again.
    {
        check: sqlite_integrity("data/backups/shop.db")?,
        info: sqlite_info("data/backups/shop.db")?,
        offsite: sqlite_backup("data/backups/shop.db", "data/offsite/shop.db")?,
    }
}

