// A Notion database as a small CRM: a row added with its page body, the whole database read past
// its pages of 100, a long note appended in batches, and the failures Notion gives.
//
//   NOTION_TOKEN=... NOTION_DATABASE_ID=... quillo run notion.qwe
//   then open http://localhost:8080/add, /rows, /blocks, /text, /search and /failures
//
// Share the database with the integration, or it answers object_not_found. NOTION_API_URL reaches
// a test server, and NOTION_VERSION picks the API's version.

use "notion.qwer"

let DB = env("NOTION_DATABASE_ID", "")
let SCHEMA = { Name: "title", Stage: "select", Tags: "multi_select", Value: "number", Due: "date", Won: "checkbox", Site: "url", Notes: "rich_text" }

route GET /add {
    let props = notion_properties({ Name: "Acme order", Stage: "Open", Tags: ["vip", "eu"], Value: 1200.5, Due: "2026-12-01", Won: false, Site: "https://acme.example", Notes: "Call **Ada** first" }, SCHEMA)?
    let page = notion_page_create(DB, props, [
        notion_heading(2, "Next steps")?,
        notion_todo("Send the quote", false),
        notion_paragraph("See [the brief](https://example.com/brief) for *more*"),
        notion_code("quillo run shop.qwe", "shell"),
        notion_callout("Urgent", "⚠️"),
        notion_divider(),
    ], {})?
    let changed = notion_page_update(page.id, notion_properties({ Stage: "Won", Won: true }, SCHEMA)?, {})?
    let row = notion_row(notion_page(page.id, {})?)
    { name: row.Name, stage: notion_row(changed).Stage, tags: row.Tags, value: row.Value, due: row.Due, notes: row.Notes, trashed: notion_archive(page.id, true, {})?.archived }
}

route GET /rows {
    let filter = { property: "Stage", select: { equals: "Open" } }
    let all = notion_query(DB, { filter: filter, sorts: [{ property: "Value", direction: "descending" }] }, {})?
    let one = notion_query_page(DB, { page_size: 2 }, {})?
    { open: len(all), first: notion_row(all[0]).Name, has_more: one.has_more, capped: len(notion_query(DB, null, { max_items: 120 })?) }
}

route GET /blocks {
    let page = notion_page_create(DB, notion_properties({ Name: "Long note" }, SCHEMA)?, map(range(0, 130), (i) => notion_bullet(`Line ${i}`)), {})?
    let more = notion_append(page.id, map(range(0, 205), (i) => notion_paragraph(`More ${i}`)), {})?
    let all = notion_blocks(page.id, {})?
    { appended: more, total: len(all), last: notion_plain(all[len(all) - 1].paragraph.rich_text) }
}

// No network: rich text and the ids from a page's link.
route GET /text {
    let long = notion_text(repeat("x", 4500), null)
    let marked = notion_markdown("Plain **bold** and `code` and [a link](https://example.com) and *open")
    {
        pieces: map(long, (t) => len(t.text.content)),
        marked: map(marked, (t) => t.text.content),
        bold: marked[1].annotations.bold,
        url: marked[5].text.link.url,
        plain: notion_plain(marked),
        emoji_safe: len(notion_text(repeat("😀", 1500), null)),
    }
}

route GET /search {
    let pages = notion_search("Acme", { filter: "page" })?
    { found: len(pages), by_link: notion_page(`https://www.notion.so/Acme-${replace(DB, "-", "")}?pvs=4`, {}).error }
}

route GET /failures = {
    not_shared: notion_page("11111111111111111111111111111111", {}).error,
    bad_token: notion_page(DB, { token: "wrong" }).error,
    invalid: notion_page_create(DB, { Nope: { title: [] } }, [], {}).error,
    bad_id: notion_page("not-an-id", {}).error,
    no_type: notion_properties({ Unknown: 1 }, SCHEMA).error,
    bad_level: notion_heading(4, "x").error,
    waited: len(notion_query(DB, { filter: { property: "Name", title: { equals: "rate me" } } }, {})?),
}
