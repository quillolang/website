// A checksum for a download, and an ETag that changes with the file.
//
//   quillo run file_hash.qwe      then open http://localhost:8080/sum

use "file_hash.qwer"

route GET /sum {
    write_file("release.txt", "Quillo 0.5.0")
    { sha256: sha256_file("release.txt")?, blake3: blake3_file("release.txt")? }
}
