// Ids for a shop's orders and invite codes that give nothing away: not the count, not the time.
//
//   quillo run cuid2.qwe      then open http://localhost:8080/ids

use "cuid2.qwer"

route GET /ids {
    let order = cuid2_new()
    let invite = cuid2_sized(10)?
    let batch = cuid2_many(1000)?
    {
        order: order,
        order_length: len(order),
        invite_length: len(invite),
        all_valid: all(batch, (id) => cuid2_valid(id)),
        all_different: len(unique(batch)) == 1000,
        too_long: cuid2_sized(40).error,
    }
}

// /orders/<id>: an id that is not a CUID2 is refused before any lookup.
route GET /orders/:id {
    if !cuid2_valid(id) { reply 404 { error: "no such order", checked: id } }
    { order: id, valid: true }
}
