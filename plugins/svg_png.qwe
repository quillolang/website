// A badge drawn as SVG and served as PNG, for an email that cannot show SVG.
//
//   quillo run svg_png.qwe      then open http://localhost:8080/badge.png

use "svg_png.qwer"

fn badge(label, value, color) = `<svg xmlns="http://www.w3.org/2000/svg" width="180" height="28" viewBox="0 0 180 28">
  <rect width="180" height="28" rx="6" fill="#333"/>
  <rect x="90" width="90" height="28" rx="6" fill="${color}"/>
  <rect x="90" width="10" height="28" fill="${color}"/>
  <text x="45" y="19" font-size="14" font-family="sans-serif" fill="#fff" text-anchor="middle">${escape(label)}</text>
  <text x="135" y="19" font-size="14" font-family="sans-serif" fill="#fff" text-anchor="middle" font-weight="bold">${escape(value)}</text>
</svg>`

route GET /badge.png ? { label: str = "tests", value: str = "passing" } {
    svg_to_png(badge(label, value, "#2e9e5b"), "data/badges/badge.png", 360)?
    file("data/badges/badge.png")
}

route GET /sizes {
    let svg = badge("build", "ok", "#2e9e5b")
    { own: svg_size(svg)?, png: svg_to_png(svg, "data/badges/build.png", 0)?, double: svg_to_png(svg, "data/badges/build@2x.png", 360)? }
}
