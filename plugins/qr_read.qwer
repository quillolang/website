//! QR codes and barcodes read from pictures: QR, Data Matrix, Aztec, PDF417, EAN-13, EAN-8, UPC-A, UPC-E, Code 128, Code 39, ITF and more, for tickets, parcels and products.
//! version: 1.0.0
//!
//! [dependencies]
//! rxing = { version = "0.7", default-features = false }
//! image = { version = "0.25", default-features = false, features = ["png", "jpeg", "webp", "gif"] }

use rxing::{BarcodeFormat, DecodeHints, RXingResult};
use serde_json::{json, Value};
use std::collections::HashSet;

const MAX_SIDE: u32 = 3000;

// The picture in grey, made smaller when it is very large (codes in photos read fine at 3000 px).
fn luma(path: &str) -> Result<(Vec<u8>, u32, u32), String> {
    let mut r = image::ImageReader::open(path).map_err(|e| format!("{}: {}", path, e))?.with_guessed_format().map_err(|e| format!("{}: {}", path, e))?;
    let mut l = image::Limits::default();
    l.max_image_width = Some(12_000);
    l.max_image_height = Some(12_000);
    l.max_alloc = Some(512 * 1024 * 1024);
    r.limits(l);
    let mut img = r.decode().map_err(|e| format!("{}: {}", path, e))?;
    if img.width().max(img.height()) > MAX_SIDE {
        img = img.resize(MAX_SIDE, MAX_SIDE, image::imageops::FilterType::Triangle);
    }
    let g = img.to_luma8();
    let (w, h) = g.dimensions();
    Ok((g.into_raw(), w, h))
}

fn format_name(f: &BarcodeFormat) -> String {
    match f {
        BarcodeFormat::QR_CODE => "qr".into(),
        f => f.to_string().replace(' ', ""),
    }
}

fn record(r: &RXingResult) -> Value {
    let pts: Vec<Value> = r.getPoints().iter().map(|p| json!([p.x.round(), p.y.round()])).collect();
    json!({ "text": r.getText(), "format": format_name(r.getBarcodeFormat()), "points": pts })
}

fn hints(formats: Option<HashSet<BarcodeFormat>>) -> DecodeHints {
    let mut h = DecodeHints::default();
    h.TryHarder = Some(true);
    h.PossibleFormats = formats;
    h
}

fn catch<T>(f: impl FnOnce() -> T + std::panic::UnwindSafe) -> Result<T, String> {
    std::panic::catch_unwind(f).map_err(|_| "the picture could not be read".to_string())
}

/// The text of the QR code in the picture (PNG, JPEG, WebP, GIF), or an error when there is none it can read.
pub fn qr_read(path: &str) -> Result<String, String> {
    let (l, w, h) = luma(path)?;
    let r = catch(move || rxing::helpers::detect_in_luma_with_hints(l, w, h, None, &mut hints(Some(HashSet::from([BarcodeFormat::QR_CODE])))))?;
    r.map(|r| r.getText().to_string()).map_err(|_| format!("{}: no QR code found", path))
}

/// The first code of any kind in the picture: `{ text, format, points }`, `format` like "qr", "ean13", "upca", "code128", "datamatrix";
/// `points` the corners or ends it was found at, in pixels. Null when there is none.
pub fn qr_read_any(path: &str) -> Result<Value, String> {
    let (l, w, h) = luma(path)?;
    let r = catch(move || rxing::helpers::detect_in_luma_with_hints(l, w, h, None, &mut hints(None)))?;
    Ok(r.map(|r| record(&r)).unwrap_or(Value::Null))
}

/// Every code in the picture, each `{ text, format, points }`: a sheet of labels, a box with several barcodes. Empty when there is none.
pub fn qr_read_all(path: &str) -> Result<Vec<Value>, String> {
    let (l, w, h) = luma(path)?;
    let r = catch(move || rxing::helpers::detect_multiple_in_luma_with_hints(l, w, h, &mut hints(None)))?;
    Ok(r.map(|v| v.iter().take(100).map(record).collect()).unwrap_or_default())
}
