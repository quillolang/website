//! Colours read from any CSS form, contrast checked against WCAG (AA, AAA), and mixed: accessible themes and user-picked colours.
//! version: 1.0.0
//!
//! [dependencies]
//! csscolorparser = "0.7"

use serde_json::{json, Value};

fn parse(c: &str) -> Result<csscolorparser::Color, String> {
    c.trim().parse::<csscolorparser::Color>().map_err(|e| format!("`{}`: {}", c, e))
}

fn luminance(c: &csscolorparser::Color) -> f64 {
    let ch = |v: f32| { let v = v as f64; if v <= 0.04045 { v / 12.92 } else { ((v + 0.055) / 1.055).powf(2.4) } };
    0.2126 * ch(c.r) + 0.7152 * ch(c.g) + 0.0722 * ch(c.b)
}

/// The contrast between two colours ("#1b1630", "rgb(255 255 255)", "hsl(40 90% 60%)", "teal"), 1 to 21, and whether it passes: `{ ratio, aa, aa_large, aaa }`.
pub fn contrast(fg: &str, bg: &str) -> Result<Value, String> {
    let (a, b) = (luminance(&parse(fg)?), luminance(&parse(bg)?));
    let r = (a.max(b) + 0.05) / (a.min(b) + 0.05);
    Ok(json!({ "ratio": (r * 100.0).round() / 100.0, "aa": r >= 4.5, "aa_large": r >= 3.0, "aaa": r >= 7.0 }))
}

/// Black or white, whichever reads better on `bg`: text on a user-picked label colour.
pub fn text_on(bg: &str) -> Result<String, String> {
    let l = luminance(&parse(bg)?);
    Ok(if (1.05) / (l + 0.05) >= (l + 0.05) / 0.05 { "#ffffff".into() } else { "#000000".into() })
}

/// `{ hex, rgb, hsl }` of a colour written any CSS way.
pub fn color_forms(c: &str) -> Result<Value, String> {
    let c = parse(c)?;
    Ok(json!({ "hex": c.to_css_hex(), "rgb": c.to_css_rgb(), "hsl": c.to_css_hsl() }))
}

/// `a` mixed with `b`, `t` of the way (0 is `a`, 1 is `b`), as hex.
pub fn mix(a: &str, b: &str, t: f64) -> Result<String, String> {
    Ok(parse(a)?.interpolate_rgb(&parse(b)?, t.clamp(0.0, 1.0) as f32).to_css_hex())
}
