//! What an MP4 or MOV video holds: length, size in pixels, frame rate, codecs, bitrate and tracks, read from its header without decoding it.
//! version: 1.0.0
//!
//! [dependencies]
//! mp4 = "0.14"

use serde_json::{json, Value};

const MAX_TRACKS: usize = 64;

fn read(path: &str) -> Result<(mp4::Mp4Reader<std::io::BufReader<std::fs::File>>, u64), String> {
    let f = std::fs::File::open(path).map_err(|e| format!("{}: {}", path, e))?;
    let size = f.metadata().map_err(|e| e.to_string())?.len();
    let p = path.to_string();
    let r = std::panic::catch_unwind(move || mp4::Mp4Reader::read_header(std::io::BufReader::new(f), size));
    match r {
        Ok(Ok(m)) => Ok((m, size)),
        Ok(Err(e)) => Err(format!("{}: not an MP4 or MOV file it can read ({})", p, e)),
        Err(_) => Err(format!("{}: the file could not be read", p)),
    }
}

fn secs(d: std::time::Duration) -> f64 {
    (d.as_millis() as f64) / 1000.0
}

fn track(t: &mp4::Mp4Track) -> Value {
    let kind = t.track_type().map(|k| k.to_string().to_lowercase()).unwrap_or_else(|_| "other".into());
    let codec = t.media_type().map(|m| m.to_string()).unwrap_or_else(|_| "unknown".into());
    let mut v = json!({
        "id": t.track_id(),
        "kind": kind,
        "codec": codec,
        "duration": secs(t.duration()),
        "bitrate": t.bitrate() / 1000,
        "language": t.language(),
    });
    if kind == "video" {
        v["width"] = t.width().into();
        v["height"] = t.height().into();
        v["fps"] = ((t.frame_rate() * 100.0).round() / 100.0).into();
    }
    if kind == "audio" {
        v["sample_rate"] = t.sample_freq_index().map(|f| Value::from(f.freq())).unwrap_or(Value::Null);
        v["channels"] = t.channel_config().map(|c| Value::from(c as u8)).unwrap_or(Value::Null);
    }
    v
}

fn tracks_of(m: &mp4::Mp4Reader<std::io::BufReader<std::fs::File>>) -> Vec<Value> {
    let mut ids: Vec<&u32> = m.tracks().keys().collect();
    ids.sort();
    ids.into_iter().take(MAX_TRACKS).map(|id| track(&m.tracks()[id])).collect()
}

/// A summary of the video: `{ duration, width, height, fps, video_codec, audio_codec, sample_rate, channels, bitrate, size, brand }`.
/// `duration` in seconds (a float), `bitrate` in kbit/s for the whole file, `size` in bytes; null for what it lacks (no audio track, say).
/// Codecs are h264, h265, vp9, aac, ttxt or "unknown".
pub fn video_info(path: &str) -> Result<Value, String> {
    let (m, size) = read(path)?;
    let tracks = tracks_of(&m);
    let video = tracks.iter().find(|t| t["kind"] == "video");
    let audio = tracks.iter().find(|t| t["kind"] == "audio");
    let duration = secs(m.duration());
    let get = |t: Option<&Value>, k: &str| t.map(|t| t[k].clone()).unwrap_or(Value::Null);
    Ok(json!({
        "duration": duration,
        "width": get(video, "width"),
        "height": get(video, "height"),
        "fps": get(video, "fps"),
        "video_codec": get(video, "codec"),
        "audio_codec": get(audio, "codec"),
        "sample_rate": get(audio, "sample_rate"),
        "channels": get(audio, "channels"),
        "bitrate": if duration > 0.0 { ((size as f64 * 8.0 / duration) / 1000.0).round() as i64 } else { 0 },
        "size": size,
        "brand": m.major_brand().to_string().trim().to_string(),
    }))
}

/// Each track as `{ id, kind, codec, duration, bitrate, language }`, with `width`, `height` and `fps` for video and `sample_rate` and `channels` for audio.
/// `kind` is video, audio, subtitle or other.
pub fn video_tracks(path: &str) -> Result<Vec<Value>, String> {
    Ok(tracks_of(&read(path)?.0))
}

/// The length of the video in seconds (a float): to refuse uploads that are too long, or to show it.
pub fn video_duration(path: &str) -> Result<f64, String> {
    Ok(secs(read(path)?.0.duration()))
}
