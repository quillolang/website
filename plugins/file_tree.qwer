//! A folder's files, recursively, with their sizes and dates: listings with limits, a folder's total size, and its largest and newest files.
//! version: 1.0.0
//!
//! [dependencies]
//! walkdir = "2"

use serde_json::{json, Value};
use std::time::UNIX_EPOCH;

const MAX_ENTRIES: usize = 100_000;

fn hidden(e: &walkdir::DirEntry) -> bool {
    e.depth() > 0 && e.file_name().to_str().map_or(false, |s| s.starts_with('.'))
}

// The folder's entries below it (not following links), hidden ones left out unless asked, at most 100,000.
fn entries(dir: &str, max_depth: i64, show_hidden: bool) -> Result<Vec<walkdir::DirEntry>, String> {
    if !std::path::Path::new(dir).is_dir() {
        return Err(format!("{}: not a folder", dir));
    }
    let depth = if max_depth <= 0 { usize::MAX } else { max_depth as usize };
    let mut out = vec![];
    for e in walkdir::WalkDir::new(dir).min_depth(1).max_depth(depth).follow_links(false).sort_by_file_name().into_iter().filter_entry(|e| show_hidden || !hidden(e)) {
        let Ok(e) = e else { continue };
        out.push(e);
        if out.len() >= MAX_ENTRIES {
            break;
        }
    }
    Ok(out)
}

fn record(dir: &str, e: &walkdir::DirEntry) -> Value {
    let meta = e.metadata().ok();
    let kind = if e.file_type().is_dir() { "dir" } else if e.file_type().is_symlink() { "link" } else { "file" };
    let rel = e.path().strip_prefix(dir).unwrap_or(e.path()).to_string_lossy().replace('\\', "/");
    json!({
        "path": rel,
        "name": e.file_name().to_string_lossy(),
        "kind": kind,
        "size": if kind == "file" { meta.as_ref().map_or(0, |m| m.len()) } else { 0 },
        "modified": meta.and_then(|m| m.modified().ok()).and_then(|t| t.duration_since(UNIX_EPOCH).ok()).map_or(0, |d| d.as_secs()),
        "depth": e.depth(),
    })
}

/// Everything under the folder `dir`, folders first-to-last in name order: `{ path, name, kind, size, modified, depth }`.
/// `path` is relative to `dir`; `kind` is file, dir or link (links are not followed); `size` in bytes; `modified` in seconds since 1970.
/// `max_depth` 1 lists only `dir` itself, 0 goes all the way down; `hidden` false leaves out names starting with a dot. At most 100,000 entries.
pub fn file_tree(dir: &str, max_depth: i64, hidden: bool) -> Result<Vec<Value>, String> {
    Ok(entries(dir, max_depth, hidden)?.iter().map(|e| record(dir, e)).collect())
}

/// The folder's totals, hidden files included: `{ files, dirs, bytes }`.
pub fn file_tree_size(dir: &str) -> Result<Value, String> {
    let (mut files, mut dirs, mut bytes) = (0u64, 0u64, 0u64);
    for e in entries(dir, 0, true)? {
        if e.file_type().is_dir() {
            dirs += 1;
        } else if e.file_type().is_file() {
            files += 1;
            bytes += e.metadata().map_or(0, |m| m.len());
        }
    }
    Ok(json!({ "files": files, "dirs": dirs, "bytes": bytes }))
}

/// The `count` largest files under the folder (up to 1,000), largest first: to find what fills a disk.
pub fn file_tree_largest(dir: &str, count: i64) -> Result<Vec<Value>, String> {
    let mut files: Vec<Value> = entries(dir, 0, true)?.iter().filter(|e| e.file_type().is_file()).map(|e| record(dir, e)).collect();
    files.sort_by(|a, b| b["size"].as_u64().cmp(&a["size"].as_u64()));
    files.truncate(count.clamp(1, 1000) as usize);
    Ok(files)
}

/// The `count` files changed last under the folder (up to 1,000), newest first: for "recent uploads" or a sync.
pub fn file_tree_newest(dir: &str, count: i64) -> Result<Vec<Value>, String> {
    let mut files: Vec<Value> = entries(dir, 0, false)?.iter().filter(|e| e.file_type().is_file()).map(|e| record(dir, e)).collect();
    files.sort_by(|a, b| b["modified"].as_u64().cmp(&a["modified"].as_u64()).then(a["path"].as_str().cmp(&b["path"].as_str())));
    files.truncate(count.clamp(1, 1000) as usize);
    Ok(files)
}
