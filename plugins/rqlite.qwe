// A cluster of rqlite nodes from a program: a table made, rows written with `?` and named
// parameters, a transfer that rolls back as one, reads at each consistency level, a write that a
// follower sends on to the leader, and what a failing statement says.
//
//   RQLITE_API_URL=http://localhost:4001 quillo run rqlite.qwe
//   then open http://localhost:8080/write, /read, /transaction, /leader, /mixed and /failures
//
// RQLITE_API_URL may list several nodes, comma-separated. RQLITE_USER and RQLITE_PASSWORD when the
// cluster has auth on.

use "rqlite.qwer"

let made = rqlite_execute("CREATE TABLE IF NOT EXISTS accounts (id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE, balance INTEGER)", {})

route GET /write {
    let one = rqlite_execute(["INSERT INTO accounts(name, balance) VALUES(?, ?)", "ada", 100], {})?
    let named = rqlite_execute({ sql: "INSERT INTO accounts(name, balance) VALUES(:name, :balance)", params: { name: "bob", balance: 20 } }, {})?
    let two = rqlite_execute([["INSERT INTO accounts(name, balance) VALUES(?, ?)", "cy", 5], ["UPDATE accounts SET balance = balance + 1 WHERE name = ?", "cy"]], { timings: true })?
    { first: one[0].last_insert_id, named: named[0].last_insert_id, count: len(two), updated: two[1].rows_affected, timed: two[0].time != null }
}

route GET /read = {
    plain: rqlite_query(["SELECT name, balance FROM accounts WHERE balance > ? ORDER BY id", 10], {})?,
    weak: len(rqlite_query("SELECT * FROM accounts", { level: "weak" })?),
    stale: len(rqlite_query("SELECT * FROM accounts", { level: "none", freshness: "5m" })?),
    strong: len(rqlite_query("SELECT * FROM accounts", { level: "strong" })?),
    linearizable: len(rqlite_query("SELECT * FROM accounts", { level: "linearizable" })?),
    many: map(rqlite_query_many([["SELECT COUNT(*) AS n FROM accounts"], ["SELECT MAX(balance) AS top FROM accounts"]], {})?, (r) => r.rows[0]),
    types: rqlite_query_many([["SELECT name, balance FROM accounts LIMIT 1"]], {})?[0].types,
    level: rqlite_query("SELECT 1", { level: "perfect" }).error,
}

route GET /transaction {
    let move = rqlite_transaction([
        ["UPDATE accounts SET balance = balance - ? WHERE name = ?", 10, "ada"],
        ["UPDATE accounts SET balance = balance + ? WHERE name = ?", 10, "bob"],
    ], {})?
    let failed = rqlite_transaction([
        ["UPDATE accounts SET balance = 0 WHERE name = ?", "ada"],
        ["INSERT INTO accounts(name, balance) VALUES(?, ?)", "bob", 1],
    ], {})
    {
        moved: move[1].rows_affected,
        error: failed.error,
        ada: rqlite_query(["SELECT balance FROM accounts WHERE name = ?", "ada"], {})?[0].balance,
    }
}

// RQLITE_API_URL names a follower in the test: the write lands on the leader all the same.
route GET /leader = {
    leader: rqlite_leader({})? != "",
    nodes: len(rqlite_nodes({})?),
    write: rqlite_execute(["INSERT OR IGNORE INTO accounts(name, balance) VALUES(?, ?)", "dot", 1], {})?[0].rows_affected,
    redirected: http.get(env("RQLITE_STANDIN", "") + "/_redirects").json.redirects > 0,
    ready: rqlite_ready({})?,
    version: rqlite_status({})?.build.version,
}

route GET /mixed {
    let r = rqlite_request([["INSERT INTO accounts(name, balance) VALUES(?, ?)", "eve", 9], ["SELECT balance FROM accounts WHERE name = ?", "eve"]], { transaction: true, level: "strong" })?
    { wrote: r[0].rows_affected, read: r[1].rows[0].balance, queued: rqlite_execute(["DELETE FROM accounts WHERE name = ?", "eve"], { queue: true, wait: true, timeout: "2s" })?.queued }
}

route GET /failures = {
    missing_table: rqlite_query("SELECT * FROM absent", {}).error,
    second: rqlite_execute([["UPDATE accounts SET balance = 1 WHERE name = ?", "ada"], ["INSERT INTO nowhere VALUES(1)"]], {}).error,
    bad_shape: rqlite_execute(7, {}).error,
    no_leader: rqlite_execute("INSERT INTO accounts(name) VALUES('zed-no-leader')", {}).error,
}
