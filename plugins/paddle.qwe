// Selling through Paddle Billing: a price, a transaction for it, a subscription changed, paused and
// cancelled, lists past one page, and a webhook checked before it is believed.
//
//   PADDLE_API_KEY=... PADDLE_WEBHOOK_SECRET=... quillo run paddle.qwe
//   then open /prices, /transaction, /subscription, /lists, /money, /hook-check and /failures
//
// PADDLE_API_URL is https://api.paddle.com unless set; https://sandbox-api.paddle.com is the
// sandbox. Point a notification destination at POST /paddle/webhook.

use "paddle.qwer"

route GET /prices {
    let p = paddle_price_create("pro_01mug", "Monthly mug club", paddle_money("9.99", "USD")?, { billing_cycle: { interval: "month", frequency: 1 } })?
    paddle_price_update(p.id, { description: "Mug club, monthly" })?
    let read = paddle_price(p.id)?
    {
        amount: read.unit_price.amount, every: read.billing_cycle.interval, name: read.description,
        archived: paddle_price_update(p.id, { status: "archived" })?.status,
        bad: paddle_price_create("nosuch", "x", paddle_money("1", "USD")?, {}).error,
        plain: paddle_price_create("pro_01mug", "x", { amount: 100, currency_code: "USD" }, {}).error,
    }
}

route GET /transaction {
    let t = paddle_transaction_create([{ price_id: "pri_seed", quantity: 2 }], { custom_data: { order: 1001 } })?
    let read = paddle_transaction(t.id)?
    {
        state: read.status, total: paddle_money_text(read.details.totals.total, read.currency_code)?,
        order: read.custom_data.order,
        ready: paddle_transaction_create([{ price_id: "pri_seed", quantity: 1 }], { customer_id: "ctm_seed", address_id: "add_seed" })?.status,
        empty: paddle_transaction_create([], {}).error,
        unknown: paddle_transaction_create([{ price_id: "pri_nosuch", quantity: 1 }], {}).error,
    }
}

route GET /subscription {
    let id = "sub_seed"
    let before = paddle_subscription(id)?
    let changed = paddle_subscription_update(id, { items: [{ price_id: "pri_seed", quantity: 3 }] }, "prorated_immediately")?
    let note = paddle_subscription_update(id, { custom_data: { plan: "team" } }, "")?
    let paused = paddle_subscription_pause(id, "immediately")?
    let resumed = paddle_subscription_resume(id)?
    let cancel = paddle_subscription_cancel(id, "")?
    {
        before: before.items[0].quantity, changed: changed.items[0].quantity, plan: note.custom_data.plan,
        paused: paused.status, resumed: resumed.status, cancel: cancel.scheduled_change.action, still: cancel.status,
        no_mode: paddle_subscription_update(id, { items: [] }, "").error,
        bad_mode: paddle_subscription_update(id, {}, "soon").error,
        bad_when: paddle_subscription_cancel(id, "tomorrow").error,
    }
}

route GET /lists = {
    prices: len(paddle_prices({ status: ["active"] }, 0)?) >= 450,
    capped: len(paddle_prices({}, 250)?),
    transactions: len(paddle_transactions({ status: "completed" }, 0)?),
    subscriptions: len(paddle_subscriptions({ status: "active,paused" }, 0)?) >= 205,
}

route GET /money = {
    dollars: paddle_money("19.99", "usd")?,
    yen: paddle_money("1500", "JPY")?,
    small: paddle_money("0.05", "EUR")?,
    back: [paddle_money_text("1999", "USD")?, paddle_money_text("5", "EUR")?, paddle_money_text("1500", "JPY")?],
    too_fine: paddle_money("1.5", "JPY").error,
}

route POST /paddle/webhook {
    let event = paddle_webhook(request.body, request.headers["paddle-signature"] ?? "", env("PADDLE_WEBHOOK_SECRET", ""), 5)
    if is_err(event) { reply 401 event.error }
    { got: event.event_type }
}

// A signature made outside this plugin, by node's crypto: Paddle's format, an old time, no tolerance.
route GET /hook-check {
    let body = "{\"event_id\":\"evt_01\",\"event_type\":\"transaction.completed\",\"data\":{\"id\":\"txn_01\"}}"
    let header = "ts=1730000000;h1=11e69c8479f31326c7d1108deb96ea0476d5bd7963dcca248e62d650bb9edafc"
    let rotating = "ts=1730000000;h1=00ff;h1=" + slice(header, 17)
    let fresh = paddle_webhook_sign(body, "pdl_ntfset_test", 0)
    {
        good: paddle_webhook(body, header, "pdl_ntfset_test", 0)?.event_type,
        rotating: paddle_webhook(body, rotating, "pdl_ntfset_test", 0)?.data.id,
        fresh: paddle_webhook(body, fresh, "pdl_ntfset_test", 5)?.event_id,
        too_old: contains(paddle_webhook(body, header, "pdl_ntfset_test", 5).error, "more than the 5 s allowed"),
        tampered: paddle_webhook(body + " ", header, "pdl_ntfset_test", 0).error,
        no_ts: paddle_webhook(body, "h1=00", "pdl_ntfset_test", 0).error,
        unsigned: paddle_webhook(body, "", "pdl_ntfset_test", 0).error,
    }
}

route GET /failures = {
    missing: paddle_transaction("txn_nosuch").error,
    forbidden: paddle_subscription("sub_forbidden").error,
    waited: paddle_price("pri_busy")?.id,
}
