// A shop's product pages with schema.org JSON-LD in their head, and a checker for any page's
// structured data (here the sample page beside this file).
//
//   quillo run structured_data.qwe      then open http://localhost:8080/extract and http://localhost:8080/p/kettle

use "structured_data.qwer"

route GET /extract {
    let found = structured_extract(read_file("structured_data_sample.html")?, "https://home.example.com/p/kettle-17")
    { ...found, checks: found.json_ld + found.microdata | map(structured_check) }
}

let KETTLE = { name: "Stovetop Kettle 1.7 L", sku: "KT-17", price: 39.9, currency: "EUR", image: "https://home.example.com/img/kettle.jpg" }

route GET /p/kettle {
    let product = structured_jsonld("Product", KETTLE)?
    let crumbs = structured_jsonld("BreadcrumbList", { items: [{ name: "Kitchen", url: "https://home.example.com/kitchen" }, { name: "Kettles" }] })?
    let faq = structured_jsonld("FAQPage", { questions: [{ question: "Does it work on induction?", answer: "Yes, the base is magnetic steel." }] })?
    respond(200, `<!doctype html><html><head><title>${KETTLE.name}</title>
${structured_script([product, crumbs, faq])}
</head><body><h1>${KETTLE.name}</h1></body></html>`, { "content-type": "text/html; charset=utf-8" })
}

route GET /check = {
    ours: structured_check(structured_jsonld("Product", KETTLE)?),
    bare: structured_check({ "@type": "Event", name: "Launch party" }),
}
