// A substation's RTU seen from a control centre, by IEC 60870-5-104: the link started, a general
// interrogation read with each value's quality and time, a breaker operated with select before
// execute, a set-point, news that arrives by itself, and the sequence numbers kept past their wrap.
//
//   IEC104_HOST=192.0.2.10:2404 quillo run iec104.qwe
//   then open http://localhost:8080/interrogate, /commands, /refused, /news, /wrap and /frames
//
// Operating a breaker on real equipment is not a test: these routes want a simulator.

use "iec104.qwer"

let up = iec104_connect("rtu", { ca: 47, k: 12, w: 8, t3_ms: 1500 })

route GET /interrogate {
    up?
    let got = iec104_interrogate("rtu", {})?
    let by = (ioa) => filter(got.points, (p) => p.ioa == ioa)[0]
    {
        count: len(got.points),
        confirmed: got.confirmed,
        single: by(100),
        double: by(200).value,
        normalized: by(300).value,
        scaled: by(301).value,
        float: by(302),
        bad_quality: by(303).quality,
        timed: by(400),
        counter: by(500),
        seq_first: by(600).type_name,
        seq_last: by(639).value,
        wrong_station: iec104_interrogate("rtu", { ca: 99, wait_ms: 3000 }).error,
    }
}

route GET /commands {
    up?
    let plain = iec104_command("rtu", "single", 1000, true, {})?
    let breaker = iec104_command("rtu", "double", 2000, "on", { select: true, qualifier: 1 })?
    let setpoint = iec104_command("rtu", "setpoint_float", 3000, 49.75, {})?
    let scaled = iec104_command("rtu", "setpoint_scaled", 3001, -1200, { wait_term: false })?
    let norm = iec104_command("rtu", "setpoint_normalized", 3002, 0.5, {})?
    {
        plain: plain,
        breaker: breaker,
        setpoint: setpoint.confirmed,
        scaled: scaled.terminated,
        norm: norm.confirmed,
        readback: iec104_read("rtu", 3000, {})?.value,
        clock: iec104_clock_sync("rtu", "2026-11-01T09:30:15.250", {})?,
        clock_was: iec104_read("rtu", 9000, {})?.value,
    }
}

route GET /refused {
    up?
    {
        no_select: iec104_command("rtu", "double", 2000, "on", {}).error,
        locked: iec104_command("rtu", "double", 2001, "on", { select: true }).error,
        unknown_object: iec104_command("rtu", "single", 7777, true, {}).error,
        read_unknown: iec104_read("rtu", 7777, {}).error,
        bad_value: iec104_command("rtu", "single", 1000, "on", {}).error,
        out_of_range: iec104_command("rtu", "setpoint_normalized", 3002, 1.5, {}).error,
        bad_kind: iec104_command("rtu", "pulse", 1000, 1, {}).error,
        nobody: iec104_receive("nobody", 1, 0).error,
    }
}

// Each command above made the RTU report a change, in time-stamped frames left for this route.
route GET /news {
    up?
    let got = iec104_receive("rtu", 50, 500)?
    let spontaneous = filter(got, (a) => a.cause == "spontaneous")
    { frames: len(spontaneous) > 0, first: spontaneous[0].points[0].value, type: spontaneous[0].type_name, time: spontaneous[0].points[0].time, status: iec104_status("rtu")?.connected }
}

fn gather_periodic(want) {
    let total = 0
    for i in range(0, 100000) {
        let got = iec104_receive("rtu", 1000, 500)?
        total = total + sum(map(filter(got, (a) => a.type == 1 && a.cause == "periodic"), (a) => len(a.points)))
        if total >= want || len(got) == 0 { return total }
    }
    total
}

// Past N(S) 32767 the numbers start again from 0, and each frame must still be acknowledged.
route GET /wrap {
    up?
    iec104_command("rtu", "single", 9999, true, {})?
    let total = gather_periodic(33000)
    sleep(300)
    let s = iec104_status("rtu")?
    { received: total, wrapped: s.recv_seq < 3000, connected: s.connected, tests: s.tests_answered > 0, dropped: s.dropped }
}

route GET /frames = {
    start: iec104_encode({ format: "U", function: "STARTDT act" })?,
    decoded: iec104_decode("68 04 0b 00 00 00")?,
    ack: iec104_decode(iec104_encode({ format: "S", recv_seq: 12345 })?)?,
    measured: iec104_decode("68 12 04 00 0a 00 0d 01 03 00 2f 00 2e 01 00 00 00 48 42 00")?,
    wrong_length: iec104_decode("68 05 0b 00 00 00").error,
    not_apdu: iec104_decode("42 04 0b 00 00 00").error,
    cause: iec104_cause("spontaneous"),
}
