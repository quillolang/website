// A search box that forgives typos.
//
//   quillo run fuzzy.qwe      then open http://localhost:8080/search?q=amsterdm

use "fuzzy.qwer"

let cities = ["Amsterdam", "Rotterdam", "Antwerp", "Berlin", "Bern", "Barcelona", "Lisbon", "London"]

route GET /search ? { q: str } = fuzzy_rank(q, cities, 3)
route GET /mean ? { q: str } = { meant: did_you_mean(q, cities, 2) }
