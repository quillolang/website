// A receipt as a PDF download.
//
//   quillo run pdf.qwe      then open http://localhost:8080/receipt.pdf

use "pdf.qwer"

route GET /receipt.pdf {
    pdf_write("receipt.pdf", "Receipt 4521", "A4", [
        { text: "Quillo Café", size: 22, bold: true },
        { text: "Receipt 4521 · 20 November 2026" },
        { text: "2 × Flat white          € 7.00\n1 × Croissant            € 3.20" },
        { text: "Total                    € 10.20", bold: true },
        { text: "Thank you, and see you soon.", size: 9 },
    ])?
    file("receipt.pdf")
}
route GET /pages = { pages: pdf_write("long.pdf", "Long", "Letter", for i in range(120) => { text: `Line ${i + 1} of a long report.` })? }
