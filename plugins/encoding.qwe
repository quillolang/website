// Base64, hex and query strings, read back; and a store's webhook checked by its base64 HMAC.
//
//   quillo run encoding.qwe      then open http://localhost:8080/decode?b64=Y2Fmw6k
//   and /bytes?hex=fbff, /errors and /hook-check
//
// Point a Shopify webhook at POST /webhooks/shopify, with SHOPIFY_WEBHOOK_SECRET set.

use "encoding.qwer"

route GET /decode ? { b64: str } = { text: base64_decode(b64)?, again: base64_encode(base64_decode(b64)?) }
route GET /hex ? { text: str } = { hex: hex_encode(text), back: hex_decode(hex_encode(text))? }
route GET /form = form_decode("name=Ada+Lovelace&city=London%2C%20UK")?

// Bytes that are not text, such as an HMAC: hex and base64 both ways, with no text between.
route GET /bytes ? { hex: str } = {
    base64: hex_to_base64(hex)?,
    base64url: hex_to_base64url(hex)?,
    back: base64_to_hex(hex_to_base64(hex)?)?,
}

// A store's webhook. Shopify signs the raw body with HMAC-SHA256 and sends the bytes in
// base64, in X-Shopify-Hmac-Sha256 (WooCommerce does the same in X-WC-Webhook-Signature);
// crypto.hmac gives them in hex.
let SHOP_SECRET = env("SHOPIFY_WEBHOOK_SECRET") ?? "shpss-test"

route POST /webhooks/shopify {
    let expected = hex_to_base64(crypto.hmac(SHOP_SECRET, request.body))?
    if !crypto.equal(expected, request.headers["x-shopify-hmac-sha256"] ?? "") { reply 401 "not signed with the shop's secret" }
    { order: request.json.name }
}

// The same check, on a body and a header worked out outside Quillo:
//   printf '%s' '{"id":1001,"name":"#1001"}' | openssl dgst -sha256 -hmac shpss-test -binary | base64
let BODY = "{\"id\":1001,\"name\":\"#1001\"}"
let HEADER = "ZgCi1w+8byFqvK/1Xuk8JKKpazdbtAaxep1TSm7VS5A="

route GET /hook-check {
    let ours = hex_to_base64(crypto.hmac("shpss-test", BODY))?
    {
        signature: ours,
        good: crypto.equal(ours, HEADER),
        changed_body: crypto.equal(hex_to_base64(crypto.hmac("shpss-test", BODY + " "))?, HEADER),
        wrong_secret: crypto.equal(hex_to_base64(crypto.hmac("other", BODY))?, HEADER),
        header_as_hex: base64_to_hex(HEADER)? == crypto.hmac("shpss-test", BODY),
    }
}

// Each mistake is an error value saying what is wrong, and an HMAC is not text.
route GET /errors = {
    odd: hex_to_base64("abc").error,
    not_hex: hex_to_base64("0g").error,
    padding: base64_to_hex("Zg=").error,
    url_alphabet: base64_to_hex("-_8").error,
    not_text: hex_decode(crypto.hmac("shpss-test", BODY)).error,
}
