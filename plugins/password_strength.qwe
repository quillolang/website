// A sign-up form that refuses weak passwords and says why.
//
//   quillo run password_strength.qwe      then open http://localhost:8080/check?password=ada1815

use "password_strength.qwer"

route GET /check ? { password: str, email: str = "ada@example.com" } {
    let verdict = password_check(password, [email, "quillo shop"])
    { ...verdict, accepted: verdict.score >= 3 }
}

route GET /compare = {
    weak: password_score("password1", []),
    own_name: password_score("ada.lovelace", ["Ada Lovelace", "ada@example.com"]),
    strong: password_score("correct horse battery staple violin", []),
}
