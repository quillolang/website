//! ULIDs: unique ids that sort by the time they were made, 26 characters, safe in URLs, a good primary key.
//!
//! [dependencies]
//! ulid = "1"

use std::time::{Duration, UNIX_EPOCH};
use ulid::Ulid;

/// A new ULID, such as `01JBQ8E3X4ZK7M2N9P5R6S8T0V`: later ones sort after earlier ones.
pub fn ulid() -> String {
    Ulid::new().to_string()
}

/// A ULID for a given time, in milliseconds since 1970 (as `now()` gives), for back-filling old rows.
pub fn ulid_at(ms: i64) -> String {
    Ulid::from_datetime(UNIX_EPOCH + Duration::from_millis(ms.max(0) as u64)).to_string()
}

/// When a ULID was made, in milliseconds since 1970.
pub fn ulid_time(id: &str) -> Result<i64, String> {
    let u = Ulid::from_string(id.trim()).map_err(|e| e.to_string())?;
    Ok(u.timestamp_ms() as i64)
}

/// Whether `id` is a ULID.
pub fn ulid_valid(id: &str) -> bool {
    Ulid::from_string(id.trim()).is_ok()
}

