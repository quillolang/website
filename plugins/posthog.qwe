// Product analytics from the server: events and a big batch, a person and a company described, and
// feature flags deciding what a visitor sees.
//
//   POSTHOG_API_KEY=phc_... POSTHOG_HOST=https://eu.i.posthog.com quillo run posthog.qwe
//   then open /events, /batch, /people, /flags and /failures

use "posthog.qwer"

route GET /events = {
    plain: posthog_capture("order placed", "user-1", { total: 12.5, items: 2 }, {})?,
    grouped: posthog_capture("seat added", "user-1", { seats: 5 }, { groups: { company: "acme" } })?,
    late: posthog_capture("imported", "user-1", {}, { timestamp: "2026-10-01T12:00:00Z", uuid: "0192a6a0-0000-7000-8000-000000000001" })?,
    no_name: posthog_capture("", "user-1", {}, {}).error,
    no_person: posthog_capture("x", "", {}, {}).error,
    not_map: posthog_capture("x", "user-1", [1], {}).error,
}

route GET /batch {
    let events = map(range(0, 2300), (i) => { event: "page viewed", distinct_id: `user-${i % 7}`, properties: { n: i } })
    {
        sent: posthog_batch(events)?,
        grouped: posthog_batch([{ event: "x", distinct_id: "u", groups: { company: "acme" } }])?.sent,
        too_big: posthog_batch([{ event: "x", distinct_id: "u", properties: { blob: repeat("x", 1000001) } }]).error,
        no_id: posthog_batch([{ event: "x" }]).error,
    }
}

route GET /people = {
    identify: posthog_identify("user-1", { plan: "pro", email: "ada@example.com" }, { first_seen: "2026-11-01" })?,
    alias: posthog_alias("user-1", "anon-77")?,
    group: posthog_group_identify("company", "acme", { name: "Acme", seats: 12 })?,
    empty: posthog_identify("user-1", null, null).error,
    self: posthog_alias("user-1", "user-1").error,
}

route GET /flags {
    let f = posthog_flags("user-1", { groups: { company: "acme" }, person_properties: { plan: "pro" } })?
    {
        flags: f.flags, payload: f.payloads["new-checkout"], partial: f.partial,
        one: posthog_flag("user-1", "colour-test", {})?,
        unknown: posthog_flag("user-1", "no-such-flag", {})?,
        as_free: posthog_flag("user-2", "new-checkout", {})?,
        on: posthog_enabled("user-1", "new-checkout", false, {}),
        variant: posthog_enabled("user-1", "colour-test", false, {}),
        off: posthog_enabled("user-2", "new-checkout", true, {}),
        called: posthog_flag_called("user-1", "colour-test", "blue")?,
        some_failed: posthog_flags("partial", {})?.partial,
        fallback_partial: posthog_enabled("partial", "missing", true, {}),
    }
}

route GET /failures = {
    quota: posthog_flags("over-quota", {}).error,
    fallback: posthog_enabled("over-quota", "new-checkout", true, {}),
    bad_event: posthog_capture("refused", "user-1", {}, {}).error,
    waited: posthog_capture("busy", "user-1", {}, {})?,
    no_person: posthog_flags("", {}).error,
}
