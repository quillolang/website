// Contacts imported from a spreadsheet: one "name" column split into parts, and duplicates found.
//
//   quillo run name_parse.qwe      then open http://localhost:8080/contacts

use "name_parse.qwer"

let column = ["Dr. Martin Luther King, Jr.", "KING, MARTIN L", "ada lovelace", "Mr. John Ronald Reuel Tolkien CBE", "Juan de la Cruz"]

route GET /contacts = column | map((c) => { written: c, parts: name_parse(c)? })

route GET /duplicates = {
    j_smith: name_same_person("J. Smith", "John Smith")?,
    jane_john: name_same_person("Jane Smith", "John Smith")?,
    king: name_same_person("Dr. Martin Luther King, Jr.", "KING, MARTIN L")?,
    byline: name_short("Mr. John Ronald Reuel Tolkien CBE")?,
}

route GET /parse ? { name: str } = name_parse(name)?
