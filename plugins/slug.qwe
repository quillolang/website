// Addresses for posts, unique in the blog.
//
//   quillo run slug.qwe      then open http://localhost:8080/slugs

use "slug.qwer"

route GET /slugs = {
    plain: slugify("Crème brûlée à Paris!"),
    tokyo: slugify("東京 2026"),
    unique: unique_slug("Hello World", ["hello-world", "hello-world-2"]),
    ascii: transliterate("Zoë Saldaña"),
}
