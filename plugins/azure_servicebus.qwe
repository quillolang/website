// Orders through Azure Service Bus: sent to a queue with properties, received under a peek-lock
// and completed; events sent to a topic in one batch, each subscription getting its own copy; and
// a payment unlocked once (abandoned), received again, its lock renewed and completed.
//
//   SERVICEBUS_CONNECTION_STRING="Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=..." quillo run azure_servicebus.qwe
//   then open http://localhost:8080/order?id=A-1
//
// Needs a Service Bus namespace with the queues "orders" and "payments", and a topic "events" with
// the subscriptions "audit" and "mail" (a Standard tier, for topics).

use "azure_servicebus.qwer"

let CONN = env("SERVICEBUS_CONNECTION_STRING", "")
let bus = servicebus_connect("bus", CONN, {})

route GET /order ? { id: str = "A-1" } {
    servicebus_send("bus", "orders", json.stringify({ id, total: 42.5 }), {
        message_id: id, label: "order", content_type: "application/json",
        properties: { priority: "high", total: 42.5, gift: true },
    })?
    // Peek-locked: the message stays in the queue, hidden, until it is completed.
    let m = servicebus_receive("bus", "orders", 1, 5, { mode: "peek_lock" })?[0] ?? reply 504 "nothing came"
    servicebus_complete("bus", m)?
    { order: json.parse(m.body)?.id, label: m.label, priority: m.properties.priority, total: m.properties.total, delivery_count: m.delivery_count }
}

route GET /events {
    servicebus_send_batch("bus", "events", [
        { body: "user 7 signed up", label: "signup", properties: { user: 7 } },
        { body: "user 7 confirmed their email", label: "confirmed", properties: { user: 7 } },
    ])?
    let audit = servicebus_receive("bus", "events/subscriptions/audit", 10, 5, { mode: "receive_and_delete" })?
    let mail = servicebus_receive("bus", "events/subscriptions/mail", 10, 5, { mode: "receive_and_delete" })?
    { audit: audit | map((m) => m.label), mail: mail | map((m) => m.body), user: audit[0].properties.user }
}

// A payment whose first try fails: unlocked (abandoned), it comes again with a delivery count of 2.
route GET /retry {
    servicebus_send("bus", "payments", "charge card 4242", { message_id: "pay-1", time_to_live: 300 })?
    let first = servicebus_receive("bus", "payments", 1, 5, {})?[0] ?? reply 504 "nothing came"
    servicebus_unlock("bus", first)?
    let again = servicebus_receive("bus", "payments", 1, 5, {})?[0] ?? reply 504 "it did not come again"
    servicebus_renew_lock("bus", again)?
    servicebus_complete("bus", again)?
    let left = servicebus_receive("bus", "payments", 1, 0, {})?
    // A key that is not the namespace's: Service Bus checks the token's signature.
    servicebus_connect("forged", replace(CONN, "SharedAccessKey=", "SharedAccessKey=x"), {})?
    let forged = servicebus_send("forged", "payments", "x", {})
    {
        body: again.body, same: again.message_id == first.message_id, delivery_count: again.delivery_count, left: len(left),
        forged: is_err(forged) ? forged.error : "taken",
    }
}

// The token itself, as any Service Bus client would send it.
route GET /token {
    let t = servicebus_sas_token(CONN, "https://example.servicebus.windows.net/orders", 3600)?
    { resource: split(split(t, "&sig=")[0], " sr=")[1], key_name: split(t, "&skn=")[1] }
}
