// A build's test report: totals, what failed, what was flaky and what took longest, three runs
// compared to find the flaky ones, and a report written by a program that runs its own checks.
//
//   quillo run junit_xml.qwe      then open http://localhost:8080/report, /summary, /runs, /write, /merge and /broken

use "junit_xml.qwer"

let TEXT = read_file("junit_xml_sample.xml")

route GET /report {
    let r = junit_read_file("junit_xml_sample.xml")?
    let cart = r.suites[0]
    {
        totals: r.totals,
        suites: r.suites | map((s) => [s.name, s.tests, s.time]),
        statuses: cart.cases | map((c) => c.status),
        failure: cart.cases[1].failures[0].message, trace: split(cart.cases[1].failures[0].text, "\n")[1],
        place: [cart.cases[1].file, cart.cases[1].line], out: cart.cases[1].stdout,
        skipped: cart.cases[2].skipped, property: cart.properties,
        escaped: r.suites[1].cases[2].name, comma: r.suites[1].cases[2].time, thousands: r.suites[1].cases[0].time,
        wrong: r.suites[2].problems,
    }
}

route GET /summary = junit_summary(TEXT, 2)?

fn run(a, b) {
    `<testsuite name="s"><testcase classname="T" name="always"/><testcase classname="T" name="sometimes">${a}</testcase><testcase classname="T" name="never">${b}</testcase></testsuite>`
}

route GET /runs {
    let bad = `<failure message="no"/>`
    junit_compare_runs([run("", bad), run(bad, bad), run("", bad)])?
}

let SUITES = [{
    name: "checks <live>", time: 3.5, timestamp: "2026-11-01T10:00:00", properties: { branch: "main" },
    cases: [
        { name: "ping", class: "smoke", time: 0.5 },
        { name: "login \"form\"", class: "smoke", time: 1.5, status: "failed", failures: [{ message: "got <500> & more", type: "Assert", text: "line one\nline <two>" }], stdout: "colour \u{1b}[31mred" },
        { name: "pay", class: "smoke", status: "skipped", skipped: "sandbox down" },
        { name: "boom", class: "smoke", status: "error", message: "panic" },
    ],
}]

route GET /write {
    let xml = junit_write(SUITES)?
    let back = junit_read(xml)?
    {
        head: split(xml, "\n")[1], suite: split(xml, "\n")[2],
        totals: back.totals, name: back.suites[0].name,
        again: back.suites[0].cases | map((c) => [c.name, c.status]),
        failure: back.suites[0].cases[1].failures[0], out: back.suites[0].cases[1].stdout,
        stable: junit_write(back.suites)? == junit_write(junit_read(junit_write(back.suites)?)?.suites)?,
        unnamed: junit_write([{ name: "s", cases: [{ time: 1 }] }]).error,
    }
}

route GET /merge {
    let two = junit_merge([TEXT, run("", "")])?
    junit_read(two)?.totals
}

route GET /broken = {
    not_xml: junit_read("<testsuite").error != null,
    wrong_root: junit_read("<project/>").error,
    entity: junit_read("<!DOCTYPE a [<!ENTITY x 'y'>]><testsuite name='a'/>").error != null,
    no_file: junit_read_file("nothing.xml").error,
    second_bad: junit_compare_runs([TEXT, "<html/>"]).error,
    none: junit_compare_runs([]).error,
}
