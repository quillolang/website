// Labels that read well whatever the count: "1 comment", "3 replies", "your 2nd order", "an hour ago".
//
//   quillo run inflect.qwe      then open http://localhost:8080/labels

use "inflect.qwer"

route GET /labels = {
    comments: [0, 1, 3] | map((n) => inflect_count("comment", n)),
    replies: inflect_count("reply", 3),
    people: inflect_plural("person"),
    tables: [inflect_plural("category"), inflect_plural("Box"), inflect_singular("analyses"), inflect_singular("people")],
    orders: [1, 2, 3, 11, 22, 113] | map((n) => `your ${inflect_ordinal(n)} order`),
    articles: ["apple", "user", "hour", "FAQ", "URL", "8-hour day", "one-off"] | map((w) => inflect_article(w)),
}

route GET /plural ? { word: str } = { singular: inflect_singular(word), plural: inflect_plural(word) }
