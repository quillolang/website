// A picture as ASCII art, for the server's start-up banner, a plain-text email and a retro page.
//
//   quillo run ascii_art.qwe      then open http://localhost:8080/art

use "ascii_art.qwer"

route GET /art = ascii_art("ascii_art_sample.png", 60, "simple", false)
route GET /blocks = ascii_art("ascii_art_sample.png", 40, "blocks", false)
route GET / = <html><body style="background: #222">{raw(ascii_art_html("ascii_art_sample.png", 80, "detailed")?)}</body></html>
