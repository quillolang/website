//! RSS, Atom and JSON Feed read as one shape: news on a dashboard, a podcast's episodes, a blogroll.
//!
//! [dependencies]
//! feed-rs = "2"

use serde_json::{json, Value};

/// A feed as `{ title, link, entries: [{ id, title, link, published, summary, authors }] }`, newest as the feed orders them; times are RFC 3339 text.
pub fn feed_parse(text: &str) -> Result<Value, String> {
    let f = feed_rs::parser::parse(text.as_bytes()).map_err(|e| e.to_string())?;
    let entries: Vec<Value> = f.entries.iter().map(|e| json!({
        "id": e.id,
        "title": e.title.as_ref().map(|t| t.content.clone()),
        "link": e.links.first().map(|l| l.href.clone()),
        "published": e.published.or(e.updated).map(|d| d.to_rfc3339()),
        "summary": e.summary.as_ref().map(|t| t.content.clone()),
        "authors": e.authors.iter().map(|a| a.name.clone()).collect::<Vec<_>>(),
    })).collect();
    Ok(json!({
        "title": f.title.map(|t| t.content),
        "link": f.links.first().map(|l| l.href.clone()),
        "entries": entries,
    }))
}
