// A slow report cached on disk for a minute: the first request makes it, the next ones read it.
//
//   quillo run cache_disk.qwe      then open http://localhost:8080/report

use "cache_disk.qwer"

let CACHE = "data/cache"

fn slow_report() = json.stringify({ total: sum(range(1, 100001)), made: str(now()) })

route GET /report {
    let hit = disk_cache_get(CACHE, "report:daily")?
    if hit != null { return { from: "cache", report: json.parse(hit) } }
    disk_cache_put(CACHE, "report:daily", slow_report(), 60)?
    { from: "made", report: json.parse(disk_cache_get(CACHE, "report:daily")?) }
}

route GET /info = disk_cache_info(CACHE, "report:daily")?

route GET /flush {
    disk_cache_put(CACHE, "short", "gone soon", 1)?
    disk_cache_remove(CACHE, "report:daily")?
    { keys: disk_cache_keys(CACHE, 100)?, report: disk_cache_get(CACHE, "report:daily")? }
}
