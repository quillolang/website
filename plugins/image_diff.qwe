// A visual regression check: today's screenshot of the order page against yesterday's.
//
//   quillo run image_diff.qwe      then open http://localhost:8080/check

use "image_diff.qwer"

route GET /check = {
    diff: image_diff_save("image_diff_sample.png", "image_diff_sample2.png", "data/diff/order-page.png", 8)?,
    passes: image_diff_same("image_diff_sample.png", "image_diff_sample2.png", 0.5)?,
    unchanged: image_diff("image_diff_sample.png", "image_diff_sample.png", 0)?,
}

route GET /diff.png {
    image_diff_save("image_diff_sample.png", "image_diff_sample2.png", "data/diff/order-page.png", 8)?
    file("data/diff/order-page.png")
}
