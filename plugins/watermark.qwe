// Photos marked with the café's logo before they go on the website.
//
//   quillo run watermark.qwe      then open http://localhost:8080/photo.jpg

use "watermark.qwer"

route GET /photo.jpg {
    watermark("watermark_sample.jpg", "watermark_sample.png", "data/marked/photo.jpg", "bottom-right", 0.6)?
    file("data/marked/photo.jpg")
}

route GET /stock.jpg {
    watermark_with("watermark_sample.jpg", "watermark_sample.png", "data/marked/stock.jpg", { tile: true, opacity: 0.25, scale: 0.12 })?
    file("data/marked/stock.jpg")
}

route GET /batch = {
    corner: watermark("watermark_sample.jpg", "watermark_sample.png", "data/marked/photo.jpg", "top-left", 0.6)?,
    many: watermark_many(["watermark_sample.jpg"], "watermark_sample.png", "data/marked/all", { position: "center", opacity: 0.4 })?,
    wrong: is_err(watermark("watermark_sample.jpg", "watermark_sample.png", "data/marked/x.jpg", "middle", 0.5)),
}
