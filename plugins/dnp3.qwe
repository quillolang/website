// A remote outstation polled by DNP3 over TCP: an integrity poll, events and their times, a read
// that comes in several fragments, a relay operated by select before operate, an analog output, and
// the unsolicited events it sends by itself.
//
//   DNP3_HOST=192.0.2.20:20000 quillo run dnp3.qwe
//   then open http://localhost:8080/poll, /events, /big, /control, /refused, /unsolicited and /frames
//
// Operating outputs on real equipment is not a test: these routes want a simulator. The outstation's
// address is 10, the master's 1, unless told otherwise.

use "dnp3.qwer"

let up = dnp3_connect("rtu", { master: 1, outstation: 10, timeout_ms: 3000 })

fn point(list, kind, index) = filter(list, (p) => p.kind == kind && p.index == index)[0]

route GET /poll {
    up?
    let all = dnp3_read_classes("rtu", [1, 2, 3, 0])?
    let binary = dnp3_read("rtu", 1, 2, 0, 3)?
    let analog = dnp3_read("rtu", 30, 5, 0, 0)?
    {
        iin: all.iin,
        count: len(all.points),
        relay: point(all.points, "binary", 0),
        lost: point(all.points, "binary", 1).flags.comm_lost,
        volts: point(all.points, "analog", 0).value,
        amps: point(all.points, "analog", 1).value,
        counter: point(all.points, "counter", 0).value,
        output: point(all.points, "binary_output", 0).value,
        some: map(binary.points, (p) => p.value),
        float: analog.points[0].value,
        packed: map(dnp3_read("rtu", 1, 1, 0, 2)?.points, (p) => p.value),
        cleared: dnp3_clear_restart("rtu")?.iin,
    }
}

// /control made these: what changed is reported once, and goes when the master confirms it.
route GET /events {
    up?
    let first = dnp3_read_classes("rtu", [1, 2])?
    let again = dnp3_read_classes("rtu", [1, 2])?
    { events: map(first.points, (p) => [p.kind, p.index, p.value]), time: first.points[0].time, gone: len(again.points), iin: again.iin }
}

route GET /big {
    up?
    let r = dnp3_read("rtu", 30, 2, 0, 999)?
    { count: len(r.points), first: r.points[0].value, last: r.points[999].value, indexes: r.points[999].index, crc_errors: dnp3_crc_errors("rtu")? }
}

route GET /control {
    up?
    let on = dnp3_operate("rtu", 0, "latch_on", {})?
    let state = dnp3_read("rtu", 10, 2, 0, 0)?.points[0].value
    let off = dnp3_operate("rtu", 0, "latch_off", { direct: true })?
    let after = dnp3_read("rtu", 10, 2, 0, 0)?.points[0].value
    { on: on.status, state: state, off: off.status, after: after, pulse: dnp3_operate("rtu", 1, "pulse_on", { on_ms: 500, off_ms: 500, count: 2 })?.status, set: dnp3_analog_output("rtu", 0, 49.5, {})?.status, read: dnp3_read("rtu", 40, 3, 0, 0)?.points[0].value, int: dnp3_analog_output("rtu", 1, 7.0, { int: true })?.status, clock: dnp3_write_time("rtu", 1730000000000)?.iin }
}

route GET /refused {
    up?
    {
        locked: dnp3_operate("rtu", 2, "latch_on", {}).error,
        no_such: dnp3_operate("rtu", 9, "latch_on", { direct: true }).error,
        unknown_object: dnp3_read("rtu", 110, 0, 0, 0).error,
        bad_action: dnp3_operate("rtu", 0, "explode", {}).error,
        bad_class: dnp3_read_classes("rtu", [7]).error,
        nobody: dnp3_read_classes("nobody", [0]).error,
        wrong_address: dnp3_connect("second", { outstation: 99, timeout_ms: 300 }).error,
        past_end: dnp3_read("rtu", 1, 1, 200, 201).error,
    }
}

route GET /unsolicited {
    up?
    dnp3_unsolicited("rtu", true, [1, 2])?
    let got = dnp3_receive("rtu", 5, 1500)?
    dnp3_unsolicited("rtu", false, [1, 2])?
    { count: len(got), event: got[0].objects[0].value, iin: got[0].iin, none: len(dnp3_receive("rtu", 5, 100)?), bad: dnp3_unsolicited("rtu", true, [0]).error }
}

route GET /frames {
    let frame = dnp3_build_frame({ function: "REQUEST_LINK_STATUS", master: true, destination: 1, source: 1024 })?
    let data = "c0c101003c02063c03063c04063c0106"
    let long = dnp3_build_frame({ function: "UNCONFIRMED_USER_DATA", destination: 10, source: 1, data })?
    {
        check_value: dnp3_crc("313233343536373839")?,
        known: dnp3_crc("056405c001000004")?,
        frame: frame,
        parsed: dnp3_parse_frame(frame)?,
        round: dnp3_parse_frame(long)?.data == data,
        bad_header: dnp3_parse_frame("056405c001000000e921").error,
        bad_block: dnp3_parse_frame(replace(long, "c0c10100", "c0c10101")).error,
        response: dnp3_parse_response("c081000001020000018101")?,
        not_frame: dnp3_parse_frame("0000").error,
    }
}
