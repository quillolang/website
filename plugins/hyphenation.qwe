// A newsletter in narrow columns, hyphenated for e-mail clients that ignore CSS, and a receipt printer's 24-character lines.
//
//   quillo run hyphenation.qwe      then open http://localhost:8080/words

use "hyphenation.qwer"

route GET /words {
    {
        english: hyphenate_word("hyphenation", "en-us")?,
        british: hyphenate_word("characteristically", "en-gb")?,
        german: hyphenate_word("Donaudampfschifffahrt", "de")?,
        french: hyphenate_word("anticonstitutionnellement", "fr")?,
        dutch: hyphenate_word("ziekenhuisopname", "nl")?,
        shy: replace(hyphenate_text("Unbelievable accommodation", "en-us", 6)?, "\u{ad}", "|"),
        html: hyphenate_html("<p>Extraordinary <code>configuration</code> &amp; documentation</p>", "en-us", 6)?,
        receipt: hyphenate_wrap("International transportation surcharge applies", 16, "en-us")?,
        languages: len(hyphenate_languages()),
        unknown: hyphenate_word("x", "xx").error,
    }
}

route GET /newsletter = <html><body style="width: 220px">
    <p>{raw(hyphenate_html("Our extraordinarily comprehensive documentation explains international configuration.", "en-us", 7)?)}</p>
</body></html>
