// Integrity values for the site's scripts, a checksum of a download, and cache keys.
//
//   quillo run hashes.qwe      then open http://localhost:8080/page

use "hashes.qwer"

route GET /page {
    write_file("data/app.js", "console.log('hello from Quillo')\n")
    let integrity = sri_file("data/app.js", "sha384")?
    respond(200, `<script src="/app.js" integrity="${integrity}" crossorigin="anonymous"></script>`, { "content-type": "text/html" })
}

route GET /checksums = {
    md5: hash_text("md5", "hello")?,
    sha1: hash_text("sha1", "hello")?,
    sha3_256: hash_text("sha3-256", "hello")?,
    blake2b: hash_text("blake2b", "hello")?,
    xxh3: hash_text("xxh3", "hello")?,
    crc32: hash_text("crc32", "hello")?,
    same_as_builtin: hash_text("sha256", "hello")? == crypto.sha256("hello"),
}

route GET /download {
    write_file("data/release.txt", repeat("Quillo 1.0 release notes. ", 100))
    { sha256: hash_file("sha256", "data/release.txt")?, crc32: hash_file("crc32", "data/release.txt")? }
}

// Which algorithm an old system used, from a password reset token it stored.
route GET /which ? { text: str = "hello", hash: str = "aaf4c61ddcc5e8a2dabede0f3b482cd9aea9434d" } {
    let all = hash_all(text)
    { used: keys(all) | filter((name) => all[name] == hash) }
}
