// City type-ahead for a search box: the most populous matches first, with an id to link to.
//
//   quillo run trie.qwe      then open http://localhost:8080/complete?q=san

use "trie.qwer"

let cities = [
    { text: "San Francisco", weight: 808, data: { id: 1 } }, { text: "San Diego", weight: 1386, data: { id: 2 } },
    { text: "San Jose", weight: 971, data: { id: 3 } }, { text: "Santa Fe", weight: 88, data: { id: 4 } },
    { text: "New York", weight: 8258, data: { id: 5 } }, { text: "York", weight: 210, data: { id: 6 } },
    { text: "Sacramento", weight: 525, data: { id: 7 } }, "Salem",
]

fn index() = trie_add("cities", cities)?

route GET /complete ? { q: str, n: int = 5 } {
    if !trie_has("cities", "San Diego") { index() }
    trie_complete("cities", q, n, false) | map((c) => { city: c.text, id: c.data?.id })
}

route GET /anyword ? { q: str = "york" } {
    if !trie_has("cities", "San Diego") { index() }
    trie_complete("cities", q, 5, true) | map((c) => c.text)
}
