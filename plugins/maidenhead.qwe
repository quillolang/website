// A ham radio contest log: each contact's grid square from its position, and how far it was.
//
//   quillo run maidenhead.qwe      then open http://localhost:8080/log

use "maidenhead.qwer"

// The ARRL's station W1AW in Newington, Connecticut, and a contact in Munich.
let HOME = maidenhead_encode(41.714775, -72.727260, 6)?

route GET /log {
    let munich = maidenhead_encode(48.1467, 11.6083, 6)?
    {
        home: HOME,
        munich: munich,
        munich_square: maidenhead_decode(munich)?,
        contact: maidenhead_distance(HOME, munich)?,
        precise: maidenhead_encode(41.714775, -72.727260, 10)?,
        valid: maidenhead_valid("FN31pr"),
        invalid: maidenhead_valid("ZZ99"),
    }
}

route GET /grid/:locator = maidenhead_decode(locator)?
