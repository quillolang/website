// Mazes: one made from a seed by each algorithm, solved, measured, loosened with loops, and drawn
// as text and as an SVG in a page.
//
//   quillo run maze.qwe
//   then open http://localhost:8080/maze.svg?seed=7, /text, /algorithms, /solve, /braid and /refused

use "maze.qwer"

route GET /maze.svg ? { seed: int = 1, width: int = 24, height: int = 16 } {
    let m = maze_generate(width, height, { seed: seed, algorithm: "wilson" })?
    respond(200, maze_svg(m, { path: true, cell: 18 })?, { "content-type": "image/svg+xml" })
}

route GET /text {
    let m = maze_generate(6, 4, { seed: 3 })?
    respond(200, maze_text(m, { path: true })?, { "content-type": "text/plain; charset=utf-8" })
}

let names = ["backtracker", "prim", "kruskal", "wilson", "aldous_broder", "binary_tree", "sidewinder", "hunt_and_kill"]

// Every algorithm must give one path between any two cells; how they differ shows in the numbers.
route GET /algorithms = names | map((n) => {
    let m = maze_generate(30, 30, { algorithm: n, seed: 5 })?
    let s = maze_stats(m)?
    let solved = maze_solve(m, {})?
    { algorithm: n, perfect: s.perfect, passages: s.passages, solved: solved.solved, visited_all: solved.visited == 900, dead_ends: s.dead_ends, longest: s.longest.length }
})

route GET /solve {
    let a = maze_generate(20, 20, { seed: 9, algorithm: "prim" })?
    let p = maze_solve(a, {})?
    let across = maze_solve(a, { from: [19, 0], to: [0, 19] })?
    {
        same_seed: maze_generate(20, 20, { seed: 9, algorithm: "prim" })? == a,
        other_seed: maze_generate(20, 20, { seed: 10, algorithm: "prim" })?.cells == a.cells,
        starts: first(p.path),
        ends: last(p.path),
        steps_match: len(p.path) == p.length + 1,
        across: last(across.path),
        svg: starts_with(maze_svg(a, {})?, "<svg"),
        one_cell: maze_solve(maze_generate(1, 1, {})?, {})?,
    }
}

route GET /braid {
    let m = maze_generate(30, 30, { seed: 4, braid: 1.0 })?
    let s = maze_stats(m)?
    { loops_made: s.loops > 0, perfect: s.perfect, connected: s.connected, dead_ends: s.dead_ends }
}

route GET /refused = {
    algorithm: maze_generate(4, 4, { algorithm: "magic" }).error,
    size: maze_generate(0, 4, {}).error,
    braid: maze_generate(4, 4, { braid: 2.0 }).error,
    outside: maze_solve(maze_generate(4, 4, {})?, { from: [9, 9] }).error,
    bad_maze: maze_solve({ width: 2, height: 1, cells: [[2, 0]] }, {}).error,
    walled: maze_solve({ width: 2, height: 1, cells: [[0, 0]] }, {})?,
    color: maze_svg(maze_generate(2, 2, {})?, { color: "\"/><script>" }).error,
}
