// A bot on GitLab: issues in a project named by its path, a merge request approved and merged, a
// pipeline started and retried, long lists followed to their end, and a webhook's token checked.
//
//   GITLAB_TOKEN=... GITLAB_PROJECT=group/sub/shop GITLAB_WEBHOOK_TOKEN=... quillo run gitlab_api.qwe
//   then open http://localhost:8080/issues, /merge, /pipeline, /hook-check and /failures
//
// GITLAB_API_URL is a self-managed instance's address.

use "gitlab_api.qwer"

let PROJECT = env("GITLAB_PROJECT", "group/sub/shop")

route GET /issues {
    let issue = gitlab_issue_create(PROJECT, { title: "Checkout is slow", description: "Since Tuesday.", labels: "bug,p1" }, {})?
    gitlab_issue_note(PROJECT, issue.iid, "Looking into it.", {})?
    let closed = gitlab_issue_update(PROJECT, issue.iid, { state_event: "close" }, {})?
    {
        iid: issue.iid,
        state: closed.state,
        notes: map(gitlab_issue_notes(PROJECT, issue.iid, {})?, (n) => n.body),
        opened: len(gitlab_issues(PROJECT, { state: "opened" })?),
        capped: len(gitlab_issues(PROJECT, { state: "opened", max_items: 150 })?),
    }
}

route GET /merge {
    let mr = gitlab_mr_create(PROJECT, { source_branch: "fast", target_branch: "main", title: "Faster checkout" }, {})?
    gitlab_mr_note(PROJECT, mr.iid, "Looks good", {})?
    let approved = gitlab_mr_approve(PROJECT, mr.iid, {})?
    let done = gitlab_mr_merge(PROJECT, mr.iid, { sha: mr.sha, should_remove_source_branch: true }, {})?
    {
        iid: mr.iid,
        approved_by: approved.approved_by[0].user.username,
        state: done.state,
        merged: len(gitlab_mrs(PROJECT, { state: "merged" })?),
        again: gitlab_mr_merge(PROJECT, mr.iid, null, {}).error,
    }
}

route GET /pipeline {
    let p = gitlab_pipeline_create(PROJECT, "main", { DEPLOY: "yes", RETRIES: 3 }, {})?
    let jobs = gitlab_pipeline_jobs(PROJECT, p.id, {})?
    {
        status: p.status,
        read: gitlab_pipeline(PROJECT, p.id, {})?.ref,
        jobs: map(jobs, (j) => `${j.name}:${j.status}`),
        retried: gitlab_pipeline_retry(PROJECT, p.id, {})?.status,
        canceled: gitlab_pipeline_cancel(PROJECT, p.id, {})?.status,
        listed: len(gitlab_pipelines(PROJECT, { ref: "main" })?),
    }
}

// Keyset paging, for lists too long for page numbers: the Link header leads on.
route GET /keyset {
    let all = gitlab_all(`/projects/${url_encode(PROJECT)}/issues?pagination=keyset&order_by=id&sort=asc`, {})?
    let r = gitlab_request("GET", `/projects/${url_encode(PROJECT)}/issues?per_page=2`, null, {})?
    { all: len(all), next: r.next_page, total: r.total }
}

route POST /gitlab/hook {
    if !gitlab_webhook_ok(request.headers, "") { reply 401 "bad token" }
    let hook = gitlab_read_webhook(request.body)?
    { kind: hook.kind, project: hook.project, iid: hook.iid }
}

let sample = "{\"object_kind\":\"merge_request\",\"user\":{\"username\":\"ada\"},\"project\":{\"path_with_namespace\":\"group/sub/shop\"},\"object_attributes\":{\"iid\":7,\"state\":\"merged\",\"action\":\"merge\"}}"

route GET /hook-check {
    let hook = gitlab_read_webhook(sample)?
    {
        good: gitlab_webhook_ok({ "X-Gitlab-Token": "s3cret" }, "s3cret"),
        wrong: gitlab_webhook_ok({ "X-Gitlab-Token": "guess!" }, "s3cret"),
        absent: gitlab_webhook_ok({}, "s3cret"),
        kind: hook.kind, who: hook.user, action: hook.action, iid: hook.iid,
    }
}

route GET /failures = {
    validation: gitlab_issue_create(PROJECT, { description: "no title" }, {}).error,
    missing: gitlab_issue("group/none", 1, {}).error,
    bad_token: gitlab_issue(PROJECT, 1, { token: "wrong" }).error,
    field_errors: gitlab_mr_create(PROJECT, { source_branch: "same", target_branch: "same", title: "x" }, {}).error,
    no_branch: gitlab_mr_create(PROJECT, { source_branch: "x", target_branch: "main" }, {}).error,
    waited: gitlab_issue_note(PROJECT, 1, "rate me", {})?.body,
}
