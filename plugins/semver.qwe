// Which release a client should update to.
//
//   quillo run semver.qwe      then open http://localhost:8080/update?have=1.2.0

use "semver.qwer"

let releases = ["1.2.0", "1.2.5", "1.3.0", "2.0.0-rc.1", "2.0.0", "2.1.0"]

route GET /update ? { have: str } = {
    same_major: semver_newest(releases, `^${have}`)?,
    newest: semver_newest(releases, "*")?,
    next_minor: semver_bump(have, "minor")?,
    behind: semver_compare(have, "2.1.0")? < 0,
}
