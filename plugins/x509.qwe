// A certificate report: what a partner's certificate covers, and how long it has left.
//
//   quillo run x509.qwe      then open http://localhost:8080/certificate

use "x509.qwer"

let CHAIN = read_file("x509_sample.pem")?

route GET /certificate {
    let c = x509_read(CHAIN)?
    { for: c.common_name, from: c.issuer_common_name, names: c.names, until: c.not_after, days_left: c.days_left, fingerprint: c.sha256_fingerprint }
}

route GET /chain = x509_read_all(CHAIN)? | map((c) => { name: c.common_name, ca: c.is_ca, self_signed: c.self_signed, key: c.key_type })

route GET /covers ? { host: str = "www.shop.example.com" } = { host, covered: x509_covers(CHAIN, host)? }

// An alert for certificates that end within 30 days.
route GET /expiring = x509_read_all(CHAIN)? | filter((c) => c.days_left < 30) | map((c) => c.common_name)
