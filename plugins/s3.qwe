// Avatars uploaded by the browser straight to a bucket.
//
//   S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com S3_REGION=auto S3_BUCKET=avatars \
//   S3_ACCESS_KEY=... S3_SECRET_KEY=... quillo run s3.qwe      then open http://localhost:8080/upload-link

use "s3.qwer"

route GET /upload-link {
    let key = `avatars/${uuid()}.jpg`
    { key, put: s3_upload_url(key, 300)?, get: s3_download_url(key, 3600)? }
}
