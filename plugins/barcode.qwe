// Product labels with barcodes, and a check of the numbers a form is given.
//
//   quillo run barcode.qwe      then open http://localhost:8080/label

use "barcode.qwer"

route GET /ean.svg ? { code: str = "400638133393" } =
    respond(200, barcode_svg("ean13", code, null)?, { "content-type": "image/svg+xml" })

route GET /parcel.svg ? { id: str = "PKG-2026-0042" } =
    respond(200, barcode_svg("code128", id, { height: 60, module: 2, color: "#1b1630" })?, { "content-type": "image/svg+xml" })

route GET /label = <html><body style="font-family: sans-serif">
    <h2>Dark roast, 250 g</h2>
    <div>{raw(barcode_svg("ean13", "400638133393", { height: 50 })?)}</div>
    <div>{raw(barcode_svg("code39", "SKU-778", { module: 1, height: 40 })?)}</div>
</body></html>

route GET /check = {
    full: barcode_check_digit("400638133393")?,
    upc: barcode_check_digit("03600029145")?,
    good: barcode_valid("ean13", "4006381333931"),
    typo: barcode_valid("ean13", "4006381333932"),
    png: barcode_png("upca", "036000291452", "data/labels/upc.png", { height: 60 })?,
}
