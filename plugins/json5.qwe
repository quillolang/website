// Reading a project's tsconfig.json (JSON with comments) and a JSON5 settings text.
//
//   quillo run json5.qwe      then open http://localhost:8080/tsconfig

use "json5.qwer"

route GET /tsconfig {
    let ts = json5_read_file("json5_sample.jsonc")?
    { target: ts.compilerOptions.target, strict: ts.compilerOptions.strict, include: ts.include, builtin_json_refuses: is_err(json.parse(read_file("json5_sample.jsonc")?)) }
}

route GET /settings = json5_parse("{ theme: 'dark', fontSize: 14, maxSize: 0x400, plugins: ['git', 'quillo',], /* off for now */ telemetry: false }")?

route GET /strip = { json: json.parse(jsonc_strip(read_file("json5_sample.jsonc")?)?)? }
