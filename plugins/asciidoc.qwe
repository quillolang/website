// A handbook written in AsciiDoc shown as a page: what a docs site does with it, what it refuses
// from a stranger's text, and includes kept inside one folder.
//
//   ASCIIDOC_ROOT=docs quillo run asciidoc.qwe      then open http://localhost:8080/page, /data, /include and /broken

use "asciidoc.qwer"

let TEXT = read_file("asciidoc_sample.adoc")

route GET /page = respond(200, asciidoc_to_html(TEXT, {})?, { "content-type": "text/plain" })

route GET /data {
    let d = asciidoc_parse(TEXT, { attributes: { build: "42" } })?
    { title: d.title, author: d.attributes.author, email: d.attributes.email, rev: d.attributes.revnumber, product: d.attributes.product, build: d.attributes.build, headings: d.headings, problems: d.problems }
}

route GET /include {
    let root = env("ASCIIDOC_ROOT", ".")
    let doc = "= Book\n\ninclude::chapters/one.adoc[leveloffset=+1]\n\n----\ninclude::code.txt[lines=2..3]\n----\n\n----\ninclude::code.txt[tag=main]\n----\n\ninclude::../outside.adoc[]\n\ninclude::nothing.adoc[]\n"
    let ok = asciidoc_parse(doc, { base: root })?
    { html: ok.html, problems: ok.problems, refused: asciidoc_parse("include::a.adoc[]\n", {})?.problems, loop: asciidoc_parse("include::loop.adoc[]\n", { base: root })?.problems }
}

route GET /small = {
    trusted: asciidoc_to_html("++++\n<b>ok</b>\n++++\n\n+++<i>x</i>+++\n", { passthrough: true })?,
    table_only: asciidoc_to_html("|===\n|a|b\n|c|d\n|===\n", {})?,
    open_block: asciidoc_parse("----\nnever closed\n", {})?.problems,
    open_table: asciidoc_parse("|===\n|a\n", {})?.problems,
    open_comment: asciidoc_parse("////\nx\n", {})?.problems,
    bad_link: asciidoc_parse("link:javascript:alert(1)[x]\n", {})?.problems,
    two_ids: asciidoc_parse("== A\n\n== A\n", {})?.headings | map((h) => h.id),
    markdown: asciidoc_to_html("## Sub\n\ntext\n", {})?,
    empty: asciidoc_to_html("", {})?,
    unicode: asciidoc_to_html("== Café crème\n\n*déjà* vu\n", {})?,
    doubling: asciidoc_parse(":a: xxxxxxxxxxxxxxxx\n" + repeat(":a: {a}{a}\n", 30), {})?.problems,
}
