// Where a visitor is: country, city and network from MaxMind-format .mmdb files. The two samples
// are tiny, made by a script, and hold only documentation addresses and made-up places: GeoLite2
// data has a licence of its own, and comes from MaxMind with an account.
//
//   IP_LOCATION_CITY_DB=ip_location_city.mmdb IP_LOCATION_ASN_DB=ip_location_asn.mmdb quillo run ip_location.qwe
//   then open http://localhost:8080/where/192.0.2.10, /lookup, /kinds, /info and /refused
//
// With a real file: point the variables at GeoLite2-City.mmdb and GeoLite2-ASN.mmdb, or a paid
// GeoIP2 file. A replaced file is noticed by its date and read again.

use "ip_location.qwer"

let CITY = "ip_location_city.mmdb"
let ASN = "ip_location_asn.mmdb"

route GET /where/:ip = ip_location_city(CITY, ip, "en")?

route GET /lookup = {
    berlin: ip_location_lookup("192.0.2.10", "de")?,
    lyon: ip_location_city(CITY, "192.0.2.200", "fr")?,
    oakland: ip_location_asn(ASN, "198.51.100.77")?,
    ipv6: ip_location_city(CITY, "2001:db8:1::42", "en")?,
    asn32: ip_location_asn(ASN, "2001:db8:1:2::1")?,
    nowhere: ip_location_city(CITY, "203.0.113.5", "en")?,
    raw: ip_location_raw(CITY, "198.51.100.1")?.record.subdivisions,
}

route GET /kinds = ["8.8.8.8", "10.1.2.3", "127.0.0.1", "169.254.1.1", "100.64.0.1", "192.0.2.1", "224.0.0.1", "::1", "fd00::1", "fe80::1", "2606:4700::1111", "::ffff:10.0.0.1", "2001:db8::1"] | map((a) => ip_location_kind(a)?.kind)

route GET /info = {
    city: ip_location_info(CITY)?,
    asn_type: ip_location_info(ASN)?.type,
    sound: ip_location_verify(CITY)?,
}

route GET /refused = {
    not_ip: ip_location_city(CITY, "not-an-ip", "en").error,
    missing: ip_location_city("no-such.mmdb", "192.0.2.1", "en").error != null,
    not_mmdb: ip_location_info("ip_location.qwe").error != null,
}
