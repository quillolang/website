// A team's work in Trello: a list and cards on a board, moves and comments, a long history walked
// back, and webhooks made and checked.
//
//   TRELLO_API_KEY=... TRELLO_TOKEN=... TRELLO_API_SECRET=... TRELLO_BOARD=... quillo run trello.qwe
//   then open /board, /cards, /history, /ids, /hook, /hook-check and /failures
//
// TRELLO_API_URL reaches a test server. The webhook's callback is a public address: Trello calls it
// with HEAD when the webhook is made, and it must answer 200, which `route HEAD` here does.

use "trello.qwer"

let board = env("TRELLO_BOARD", "b0ard0000000000000000001")

route GET /board = {
    mine: map(trello_boards()?, (b) => b.name),
    name: trello_board(board)?.name,
    lists: map(trello_lists(board)?, (l) => l.name),
    doing: trello_list_named(board, "Doing")?.name,
    none: trello_list_named(board, "Nothing here")?,
}

route GET /cards {
    let todo = trello_list_named(board, "To do")?
    let done = trello_list_create(board, "Shipped & done", "bottom")?
    let c = trello_card_create(todo.id, "Ship the mugs & plates", { desc: "Line one\nLine two", due: "2026-12-01T09:00:00.000Z", idMembers: ["m1", "m2"] })?
    trello_comment(c.id, "On it: 100% sure")?
    let moved = trello_card_move(c.id, done.id, "top")?
    let read = trello_card(c.shortUrl)?
    {
        name: read.name, desc: read.desc, members: read.idMembers, comments: read.badges.comments,
        list: moved.idList == done.id, in_list: map(trello_list_cards(done.id)?, (x) => x.name),
        on_board: len(trello_board_cards(board)?),
        closed: trello_card_update(c.id, { closed: true })?.closed,
        empty: trello_comment(c.id, "").error,
        deleted: trello_card_delete(c.id)?,
        gone: trello_card(c.id).error,
    }
}

route GET /history = {
    all: len(trello_actions(board, "", 0)?),
    capped: len(trello_actions(board, "", 1500)?),
    comments: len(trello_actions(board, "commentCard", 0)?),
}

route GET /ids = {
    card: trello_id("https://trello.com/c/AbC123/12-ship-the-mugs")?,
    board: trello_id("https://trello.com/b/XyZ987/roadmap/")?,
    short: trello_id("AbC123")?,
    other: trello_id("https://trello.com/u/ada").error,
    bad: trello_id("not an id!").error,
}

route HEAD /trello/webhook = ""

route POST /trello/webhook {
    let hook = trello_webhook(request.body, request.headers["x-trello-webhook"] ?? "", env("TRELLO_CALLBACK", ""))
    if is_err(hook) { reply 401 hook.error }
    { got: hook.action.type }
}

route GET /hook {
    let h = trello_webhook_create("https://example.com/trello/webhook", board, "Quillo")?
    { active: h.active, deleted: trello_webhook_delete(h.id)?, unreachable: trello_webhook_create("https://down.example/hook", board, "x").error }
}

// A signature made outside this plugin, by node's crypto, as Trello's documentation does it.
route GET /hook-check {
    let body = "{\"action\":{\"type\":\"updateCard\",\"data\":{\"card\":{\"name\":\"Crème brûlée\"}}},\"model\":{\"id\":\"b1\"}}"
    let url = "https://example.com/trello/webhook"
    let sig = "EBurHucqwztjGRcY2VDPCWm+UeE="
    {
        good: trello_webhook(body, sig, url)?.action.type,
        card: trello_webhook(body, sig, url)?.action.data.card.name,
        other_url: trello_webhook(body, sig, "https://example.com/other").error,
        tampered: trello_webhook(body + " ", sig, url).error,
        unsigned: trello_webhook(body, "", url).error,
    }
}

route GET /failures = {
    missing: trello_card("nosuchcard").error,
    bad_id: trello_board("00000000000000000000dead").error,
    waited: trello_call("GET", "/busy", {})?.ok,
    unauthorized: trello_board("forbidden").error,
}
