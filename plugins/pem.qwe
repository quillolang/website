// A shop's TLS bundle looked into: what each block is, the certificate picked out, written as DER and read back.
//
//   quillo run pem.qwe      then open http://localhost:8080/bundle

use "pem.qwer"

route GET /bundle = pem_read_file("pem_sample.pem")? | map((b) => { label: b.label, kind: b.kind, algorithm: b.algorithm, encrypted: b.encrypted, headers: b.headers, bytes: b.bytes, sha256: b.sha256 })

// The certificate alone, to a .der file for a Java keystore, and back to PEM: the same fingerprint.
route GET /convert {
    let text = read_file("pem_sample.pem")
    let cert = pem_only(text, ["certificate"])?
    let written = pem_to_der_file(text, "CERTIFICATE", "data/shop.der")?
    let again = pem_from_der_file("data/shop.der", "CERTIFICATE")?
    {
        der_bytes: written,
        same: again == cert,
        fingerprint: pem_blocks(again)?[0].sha256,
        keys_only: len(pem_blocks(pem_only(text, ["PUBLIC KEY", "RSA PRIVATE KEY"])?)?),
    }
}

// A block of your own, with the old-style headers.
route GET /write = respond(200, pem_encode("QUILLO LICENSE", "SGVsbG8sIFF1aWxsbyE=", { "Proc-Type": "4,CRL", "Comment": "licence for shop.example" })?, { "content-type": "text/plain" })
