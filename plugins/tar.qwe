// A nightly backup of a folder as a .tar.gz, listed, read and restored.
//
//   quillo run tar.qwe      then open http://localhost:8080/backup

use "tar.qwer"

route GET /backup {
    write_file("data/site/orders.csv", "id,total\n1,120.50\n2,99.00\n")
    write_file("data/site/pages/about.md", "# About us\n\nWe roast on Mondays.\n")
    let count = tar_create("data/backup.tar.gz", ["orders.csv", "pages"], "data/site")?
    {
        files: count,
        list: tar_list("data/backup.tar.gz")? | filter((e) => e.kind == "file") | map((e) => e.name),
        about: tar_read_file("data/backup.tar.gz", "pages/about.md")?,
        restored: tar_extract("data/backup.tar.gz", "data/restored")?,
    }
}

route GET /backup.tar.gz = file("data/backup.tar.gz")
