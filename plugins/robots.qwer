//! robots.txt read as Google does: whether a user agent may fetch a path, its crawl delay and the sitemaps listed, for crawlers, link checkers and preview fetchers; and your own site's robots.txt written.
//! version: 1.0.0
//!
//! [dependencies]
//! texting_robots = "0.2"

use serde_json::{json, Value};

const MAX_TXT: usize = 500 * 1024;

fn robot(txt: &str, agent: &str) -> Result<texting_robots::Robot, String> {
    // Google reads the first 500 KiB of a robots.txt; so does this.
    let mut end = txt.len().min(MAX_TXT);
    while !txt.is_char_boundary(end) {
        end -= 1;
    }
    texting_robots::Robot::new(agent, txt[..end].as_bytes()).map_err(|e| format!("robots.txt: {}", e))
}

/// Whether `user_agent` (your crawler's name, such as "QuilloBot") may fetch `url` (a full URL or a path) under these robots.txt rules: the longest matching rule wins, Allow on a tie, `*` and `$` understood.
pub fn robots_allowed(robots_txt: &str, user_agent: &str, url: &str) -> Result<bool, String> {
    Ok(robot(robots_txt, user_agent)?.allowed(url))
}

/// Many URLs checked at once: `[{ url, allowed }]`, in order. At most 100,000.
pub fn robots_check(robots_txt: &str, user_agent: &str, urls: Vec<String>) -> Result<Vec<Value>, String> {
    if urls.len() > 100_000 {
        return Err("at most 100,000 URLs at once".into());
    }
    let r = robot(robots_txt, user_agent)?;
    Ok(urls.iter().map(|u| json!({ "url": u, "allowed": r.allowed(u) })).collect())
}

/// What the file says beyond the rules: `{ crawl_delay, sitemaps }`, the delay in seconds between requests for this agent (null when none is set).
pub fn robots_info(robots_txt: &str, user_agent: &str) -> Result<Value, String> {
    let r = robot(robots_txt, user_agent)?;
    Ok(json!({ "crawl_delay": r.delay.map(|d| d as f64), "sitemaps": r.sitemaps }))
}

/// Where a page's robots.txt is: `https://example.com/robots.txt` for any URL of that site.
pub fn robots_url(page_url: &str) -> Result<String, String> {
    texting_robots::get_robots_url(page_url).map_err(|e| format!("{}: {:?}", page_url, e))
}

/// A robots.txt for your own site: `groups` is `[{ agents: ["*"], allow: ["/"], disallow: ["/admin", "/cart"], crawl_delay: 2 }]`, `sitemaps` the sitemaps' full URLs.
pub fn robots_write(groups: Vec<serde_json::Value>, sitemaps: Vec<String>) -> Result<String, String> {
    let mut out = String::new();
    let list = |g: &Value, k: &str| -> Vec<String> { g.get(k).and_then(Value::as_array).map(|a| a.iter().filter_map(Value::as_str).map(|s| s.replace(['\n', '\r'], "")).collect()).unwrap_or_default() };
    for g in &groups {
        let agents = list(g, "agents");
        if agents.is_empty() {
            return Err("each group names its `agents` (\"*\" for all)".into());
        }
        for a in &agents {
            out.push_str(&format!("User-agent: {}\n", a));
        }
        for p in list(g, "allow") {
            out.push_str(&format!("Allow: {}\n", p));
        }
        for p in list(g, "disallow") {
            out.push_str(&format!("Disallow: {}\n", p));
        }
        if let Some(d) = g.get("crawl_delay").and_then(Value::as_f64) {
            out.push_str(&format!("Crawl-delay: {}\n", d));
        }
        out.push('\n');
    }
    for s in sitemaps {
        out.push_str(&format!("Sitemap: {}\n", s.replace(['\n', '\r'], "")));
    }
    Ok(out)
}
