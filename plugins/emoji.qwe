// Chat messages with :shortcodes:, and a picker that searches emoji by name.
//
//   quillo run emoji.qwe      then open http://localhost:8080/message?text=Shipped%20it%20:tada:%20:+1:

use "emoji.qwer"

route GET /message ? { text: str } {
    let shown = emoji_from_shortcodes(text)?
    { shown, emoji: emoji_find(shown)?, log: emoji_to_shortcodes(shown)?, subject: emoji_strip(shown)? }
}

route GET /picker ? { q: str = "heart" } = emoji_search(q, 8)

route GET /find = emoji_find("Thanks 👍🏽 from 🇫🇷 👨‍👩‍👧")?
