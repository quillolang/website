//! Random that repeats: the same seed gives the same numbers, shuffles and picks, for daily puzzles, A/B groups, fair draws and tests.
//!
//! [dependencies]
//! rand = "0.8"
//! rand_chacha = "0.3"

use rand::seq::SliceRandom;
use rand::{Rng, SeedableRng};
use rand_chacha::ChaCha8Rng;

/// FNV-1a: the same number for the same seed text, on every machine and Rust version.
fn rng(seed: &str) -> ChaCha8Rng {
    let mut h: u64 = 0xcbf29ce484222325;
    for b in seed.as_bytes() {
        h ^= *b as u64;
        h = h.wrapping_mul(0x100000001b3);
    }
    ChaCha8Rng::seed_from_u64(h)
}

/// `count` numbers from 0 (included) to 1, the same for the same `seed`.
pub fn seeded_floats(seed: &str, count: i64) -> Vec<f64> {
    let mut r = rng(seed);
    (0..count.clamp(0, 1_000_000)).map(|_| r.gen::<f64>()).collect()
}

/// A number from `lo` to `hi`, both included, the same for the same `seed`.
pub fn seeded_int(seed: &str, lo: i64, hi: i64) -> Result<i64, String> {
    if lo > hi { return Err("lo is above hi".into()); }
    Ok(rng(seed).gen_range(lo..=hi))
}

/// `items` shuffled, the same way for the same `seed`.
pub fn seeded_shuffle(items: Vec<serde_json::Value>, seed: &str) -> Vec<serde_json::Value> {
    let mut v = items;
    v.shuffle(&mut rng(seed));
    v
}

/// `n` of `items`, none twice, the same ones for the same `seed`: a fair draw anyone can check.
pub fn seeded_pick(items: Vec<serde_json::Value>, n: i64, seed: &str) -> Vec<serde_json::Value> {
    items.choose_multiple(&mut rng(seed), n.max(0) as usize).cloned().collect()
}

/// Which of `buckets` groups (0 to buckets - 1) `id` is in, always the same one: A/B tests, gradual roll-outs.
pub fn bucket(id: &str, buckets: i64) -> i64 {
    rng(id).gen_range(0..buckets.max(1))
}
