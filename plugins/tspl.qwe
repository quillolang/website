// A small online shop's parcel labels on a TSPL printer (a TSC TE210, a Rollo or a Munbyn):
// a 100 × 150 mm label with the sender's logo, the address in a block, the parcel's GS1-128
// and a QR code, and the printer's status before printing.
//
//   quillo run tspl.qwe      then open http://localhost:8080/label
//   PRINTER_HOST=192.168.1.62 quillo run tspl.qwe      and http://localhost:8080/print

use "tspl.qwer"

let OPTIONS = { dpi: 203, width: 100, height: 150, gap: 3, speed: 4, density: 8 }

fn parcel(p) = [
    { image: "tspl_sample.png", x: 4, y: 4, width: 36 },
    { text: "Ship to:", x: 4, y: 22, size: 3 },
    { text: p.to, x: 4, y: 28, size: 5, block: 92, block_height: 30 },
    { line: true, x: 2, y: 62, width: 96, thickness: 0.5 },
    { text: `Order "${p.order}"`, x: 4, y: 66, size: 4, reverse: true },
    { barcode: "qr", data: `https://shop.example/track/${p.order}`, x: 70, y: 64, magnification: 4 },
    { barcode: "gs1_128", data: p.sscc, x: 4, y: 100, height: 25, module: 3 },
    { box: true, x: 1, y: 1, width: 98, height: 146, thickness: 0.5, radius: 2 },
]

let PARCEL = { to: "Anna Kowalska, ul. Długa 5/12, 00-238 Warszawa, Polska", order: "A-5531", sscc: "(00)095011015300000010" }

route GET /label = respond(200, tspl_label(parcel(PARCEL), OPTIONS)?, { "content-type": "text/plain; charset=utf-8" })

route GET /shelf = tspl_label([
    { text: "Aisle 4 · Bin 12", x: 2, y: 2, size: 6 },
    { barcode: "ean13", data: "4006381333931", x: 4, y: 12, height: 10 },
    { barcode: "itf14", data: "1540014128876", x: 40, y: 12, height: 10, module: 2 },
    { barcode: "datamatrix", data: "BIN-04-12", x: 80, y: 2, size: 12 },
], { width: 100, height: 30, media: "mark", copies: 3 })

route GET /saved = { bytes: tspl_write(parcel(PARCEL), OPTIONS, "data/parcel.tspl")?, calibrate: tspl_command("calibrate", OPTIONS)? }

route GET /print {
    let host = env("PRINTER_HOST", null) ?? reply 503 "set PRINTER_HOST to the printer's address (host or host:port)"
    let status = tspl_status(host, 3000)?
    if !status.ready { reply 409 { error: "the printer is not ready", status: status } }
    { sent: tspl_send(parcel(PARCEL), OPTIONS, host, 5000)?, status: status }
}
