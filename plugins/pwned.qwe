// A password-change form that refuses passwords seen in data breaches.
//
//   quillo run pwned.qwe      then open http://localhost:8080/check?password=password123
//
// A real app asks the API for the range (only five characters of the hash are sent):
//   let range = http.get(pwned_range(password).url, { "add-padding": "true" })?.body
// This example reads a sample answer for the prefix CBFDA instead, so it runs offline.

use "pwned.qwer"

fn range_for(password: str) {
    let r = pwned_range(password)
    if r.prefix == "CBFDA" { return read_file("pwned_sample.txt")? }
    "00000000000000000000000000000000000:0"      // any other prefix: no breach in this sample
}

route GET /check ? { password: str } {
    let seen = pwned_count(password, range_for(password))?
    { prefix_sent: pwned_range(password).prefix, seen_in_breaches: seen, accepted: seen == 0 }
}

route GET /sample = { password123: pwned_count("password123", read_file("pwned_sample.txt")?)?, other: pwned_count("correct horse battery staple", read_file("pwned_sample.txt")?)? }
