// A slow-query log made readable: each query pretty-printed, with its parameters filled in.
//
//   quillo run sql_format.qwe      then open http://localhost:8080/slow

use "sql_format.qwer"

let slow = [
    { ms: 840, sql: "select o.id, c.name, sum(l.qty * l.price) as total from orders o join customers c on c.id = o.customer_id join lines l on l.order_id = o.id where o.created_at > ? and c.country = ? group by o.id, c.name having sum(l.qty * l.price) > 100 order by total desc limit 20", params: ["2026-01-01", "NL"] },
    { ms: 312, sql: "update stock set qty = qty - 1 where sku = :sku and qty > 0", params: { sku: "B'7" } },
]

route GET /slow = respond(200, join(slow | map((q) => `-- ${q.ms} ms\n${sql_pretty_with_params(q.sql, q.params)?}\n`), "\n"), { "content-type": "text/plain; charset=utf-8" })

route GET /pretty ? { sql: str = "SELECT a, b FROM t WHERE x = 1 AND (y = 2 OR z = 3)" } =
    respond(200, sql_pretty(sql, 4, true)?, { "content-type": "text/plain; charset=utf-8" })

route GET /one-line = { sql: sql_one_line("SELECT id,  name -- the visible ones\n  FROM users\n  /* soft-deleted are hidden */ WHERE note = 'two  spaces'\n  AND ( deleted IS NULL )")? }
