// A certificate looked into with no X.509 library: DER read to a tree, its OIDs named, times and
// serial numbers given properly, and the same kinds of value written back. Every kind of damage
// is an answer, never a crash.
//
//   quillo run asn1_der.qwe      then open http://localhost:8080/cert, /dump, /oids, /values, /write, /ber and /broken

use "asn1_der.qwer"

let PEM = read_file("asn1_der_sample.pem")
let DER = asn1_der_pem_read(PEM)?[0].hex

route GET /cert {
    let c = asn1_der_read(DER, {})?[0]
    let tbs = c.children[0]
    let name = (rdn) => rdn.children[0].children
    {
        top: [c.type, c.length, c.header, c.offset], version: tbs.children[0].type,
        serial: [tbs.children[1].value, tbs.children[1].length],
        issuer: tbs.children[3].children | map((r) => [name(r)[0].name, name(r)[1].type, name(r)[1].value]),
        valid: tbs.children[4].children | map((t) => t.value),
        key: [tbs.children[6].children[0].children[0].name, tbs.children[6].children[1].unused_bits, len(tbs.children[6].children[1].hex)],
    }
}

route GET /dump = respond(200, asn1_der_dump(DER, {})?, { "content-type": "text/plain" })

route GET /oids = asn1_der_oids(DER, { deep: true })? | map((o) => o.name ?? o.oid)

route GET /deep {
    let c = asn1_der_read(DER, { deep: true, names: { "2.5.29.15": "my name for keyUsage" } })?[0]
    let ext = c.children[0].children[7].children[0].children
    {
        san: ext[2].children[1].inner.children | map((g) => [g.type, g.text ?? g.hex]),
        usage: [ext[3].children[0].name, ext[3].children[1].inner.bits],
        eku: ext[4].children[1].inner.children[0].name,
        basic: [ext[1].children[1].value, ext[1].children[2].inner.children[0].value],
    }
}

// Each value of the tests below written and read again.
route GET /values {
    let cases = ["0", "1", "127", "128", "256", "-1", "-128", "-129", "-256", "9223372036854775807", "9223372036854775808", "340282366920938463463374607431768211456", "-340282366920938463463374607431768211457"]
    {
        ints: cases | map((v) => asn1_der_write({ type: "INTEGER", value: v })?),
        back: cases | map((v) => asn1_der_read(asn1_der_write({ type: "INTEGER", value: v })?, {})?[0].value),
        oids: ["1.2.840.113549.1.1.11", "2.999.3", "commonName"] | map((o) => asn1_der_write({ type: "OID", value: o })?),
        huge_arc: asn1_der_read("06 0b 88 80 80 80 80 80 80 80 80 80 00", {})?[0].value,
        strings: asn1_der_read(asn1_der_write([{ type: "UTF8STRING", value: "héllo" }, { type: "PRINTABLESTRING", value: "abc" }, { type: "IA5STRING", value: "a@b" }, { type: "BMPSTRING", value: "é😀" }])?, {})? | map((n) => [n.type, n.value, n.length]),
        times: asn1_der_read(asn1_der_write([{ type: "UTCTIME", value: "2026-11-01T09:30:00Z" }, { type: "GENERALIZEDTIME", value: "2150-02-28T23:59:59.25Z" }, { type: "UTCTIME", value: "1999-12-31T23:59:59Z" }])?, {})? | map((n) => n.value),
        two_digit: [asn1_der_read("170d3439303130313030303030305a", {})?[0].value, asn1_der_read("170d3530303130313030303030305a", {})?[0].value],
    }
}

route GET /write {
    let tree = { type: "SEQUENCE", children: [
        { type: "SET", children: [{ type: "UTF8STRING", value: "b" }, { type: "INTEGER", value: 5 }, { type: "BOOLEAN", value: true }] },
        { type: "NULL" }, { type: "BIT STRING", hex: "a0", unused_bits: 4 }, { type: "OCTET STRING", hex: "0102" }, { type: "ENUMERATED", value: 2 },
        { type: "[0]", children: [{ type: "INTEGER", value: 2 }] }, { type: "[1]", hex: "ff" }, { class: "application", tag: 40, hex: "00" }, { class: "private", tag: 3, children: [] },
    ] }
    let hex = asn1_der_write(tree)?
    let back = asn1_der_read(hex, {})?
    let long = asn1_der_write({ type: "OCTET STRING", hex: repeat("00", 300) })?
    {
        hex: hex,
        set: back[0].children[0].children | map((c) => c.type),
        kinds: back[0].children | map((c) => [c.type, c.class, c.tag, c.constructed]),
        same: asn1_der_write(back)? == hex, cert_again: asn1_der_write(asn1_der_read(DER, {})?)? == DER,
        long: slice(long, 0, 8),
        pem: split(asn1_der_pem_write("TEST BLOCK", "0102")?, "\n"),
        bad_type: asn1_der_write({ type: "WIDGET" }).error,
        bad_int: asn1_der_write({ type: "INTEGER", value: "12a" }).error,
        bad_oid: asn1_der_write({ type: "OID", value: "3.1" }).error,
        bad_arc: asn1_der_write({ type: "OID", value: "1.50" }).error,
        unknown_oid: asn1_der_write({ type: "OID", value: "fooBar" }).error,
        printable: asn1_der_write({ type: "PRINTABLESTRING", value: "a@b" }).error,
        utc_range: asn1_der_write({ type: "UTCTIME", value: "2060-01-01T00:00:00Z" }).error,
        bad_bits: asn1_der_write({ type: "BIT STRING", hex: "ff", unused_bits: 4 }).error,
    }
}

route GET /ber = {
    indefinite: asn1_der_read("30800201010000", { mode: "ber" })?[0],
    nested: asn1_der_read("3080308002010500000000", { mode: "ber" })?[0].children[0].children[0].value,
    long_len: asn1_der_read("02810105", { mode: "ber" })?[0].value,
    loose_true: asn1_der_read("010107", { mode: "ber" })?[0].value,
    padded: asn1_der_read("02020005", { mode: "ber" })?[0].value,
    high_tag: asn1_der_read("9f81480101", {})?[0],
    utc_offset: asn1_der_read("17113236313130313039333030302b30323030", { mode: "ber" })?[0].value,
    two_values: len(asn1_der_read("05000500", {})?),
}

route GET /broken = {
    indefinite: asn1_der_read("3080020101000000", {}).error,
    long_form: asn1_der_read("02810105", {}).error,
    too_long: asn1_der_read("0205 01", {}).error,
    huge: asn1_der_read("04ffffffffffffffffff", {}).error,
    huge_8: asn1_der_read("0488ffffffffffffffff00", {}).error,
    cut_length: asn1_der_read("0482", {}).error,
    no_tag: asn1_der_read("", {}).error,
    never_ends: asn1_der_read("3080020101", { mode: "ber" }).error,
    prim_indefinite: asn1_der_read("0480000000", { mode: "ber" }).error,
    bool_der: asn1_der_read("010107", {}).error,
    bool_size: asn1_der_read("01020000", {}).error,
    padded_int: asn1_der_read("02020005", {}).error,
    negative_pad: asn1_der_read("0202ff80", {}).error,
    empty_int: asn1_der_read("0200", {}).error,
    null_body: asn1_der_read("050100", {}).error,
    bit_unused: asn1_der_read("03020805", {}).error,
    bit_pad: asn1_der_read("0302040f", {}).error,
    oid_cut: asn1_der_read("060188", {}).error,
    oid_pad: asn1_der_read("0603 80 01 02", {}).error,
    bad_month: asn1_der_read("170d3236313330313030303030305a", {}).error,
    no_seconds: asn1_der_read("170b323631313031303933305a", {}).error,
    leap: asn1_der_read("170d3235303232393030303030305a", {}).error,
    bad_utf8: asn1_der_read("0c02c328", {}).error,
    bmp_odd: asn1_der_read("1e0100", {}).error,
    unsorted: asn1_der_read("3106020105010100", {}).error,
    constructed_string: asn1_der_read("2403040100", {}).error,
    eoc: asn1_der_read("0000", {}).error,
    deep: asn1_der_read(repeat("3080", 100), { mode: "ber" }).error,
    bad_hex: asn1_der_read("zz", {}).error,
    bad_mode: asn1_der_read("0500", { mode: "cer" }).error,
    pem_end: asn1_der_pem_read("-----BEGIN A-----\nAQI=\n-----END B-----\n").error,
    pem_open: asn1_der_pem_read("-----BEGIN A-----\n").error,
}
