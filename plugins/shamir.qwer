//! Shamir's secret sharing: a secret split into N shares, any K of which bring it back and fewer tell nothing; for recovery keys and break-glass passwords held by several people.
//! version: 1.0.0
//!
//! [dependencies]
//! sharks = "0.5"
//! sha2 = "0.10"
//! base64 = "0.22"

use base64::engine::general_purpose::URL_SAFE_NO_PAD;
use base64::Engine;
use sha2::{Digest, Sha256};
use sharks::{Share, Sharks};

/// Secrets up to 4 KB are split.
const MAX_SECRET: usize = 4096;

/// `secret` split into `shares` shares (2 to 255), any `threshold` of which (2 to `shares`) bring it back. Each share is text such
/// as `3-AbC...`: the threshold, then the share. Give each to a different person; a share alone, or fewer than `threshold`, says
/// nothing about the secret. Every call gives new shares.
pub fn shamir_split(secret: &str, shares: i64, threshold: i64) -> Result<Vec<String>, String> {
    if secret.is_empty() || secret.len() > MAX_SECRET {
        return Err("the secret is 1 to 4096 bytes".into());
    }
    if !(2..=255).contains(&shares) || !(2..=shares).contains(&threshold) {
        return Err("2 to 255 shares, and a threshold from 2 to the number of shares".into());
    }
    // A check of 4 bytes goes with the secret, so shares that do not belong together are found.
    let mut data = secret.as_bytes().to_vec();
    data.extend_from_slice(&Sha256::digest(secret.as_bytes())[..4]);
    let dealer = Sharks(threshold as u8).dealer(&data);
    Ok(dealer.take(shares as usize).map(|s| format!("{}-{}", threshold, URL_SAFE_NO_PAD.encode(Vec::from(&s)))).collect())
}

/// The secret back from `shares` (at least the threshold of them, in any order). An error for too few shares, for shares of
/// different secrets, or for a share that was changed.
pub fn shamir_combine(shares: Vec<String>) -> Result<String, String> {
    let mut threshold = 0u8;
    let mut parsed = vec![];
    for (i, s) in shares.iter().take(255).enumerate() {
        let (k, body) = s.trim().split_once('-').ok_or_else(|| format!("share {} is not threshold-share", i + 1))?;
        let k: u8 = k.parse().map_err(|_| format!("share {}: `{}` is not a threshold", i + 1, k))?;
        if threshold != 0 && k != threshold {
            return Err("the shares name different thresholds: they are not of one secret".into());
        }
        threshold = k;
        let bytes = URL_SAFE_NO_PAD.decode(body).map_err(|_| format!("share {} is not base64", i + 1))?;
        parsed.push(Share::try_from(bytes.as_slice()).map_err(|e| format!("share {}: {}", i + 1, e))?);
    }
    let mut seen = std::collections::HashSet::new();
    parsed.retain(|s| seen.insert(Vec::from(s)[0]));
    if parsed.len() < threshold as usize {
        return Err(format!("{} different shares are needed, {} given", threshold, parsed.len()));
    }
    let data = Sharks(threshold).recover(&parsed).map_err(|e| format!("the shares do not belong to one secret ({})", e.to_lowercase()))?;
    if data.len() < 5 {
        return Err("the shares do not make a secret".into());
    }
    let (secret, check) = data.split_at(data.len() - 4);
    if Sha256::digest(secret)[..4] != *check {
        return Err("the shares do not belong to one secret, or one was changed".into());
    }
    String::from_utf8(secret.to_vec()).map_err(|_| "the shares do not belong to one secret".to_string())
}
