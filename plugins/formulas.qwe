// Pricing rules that shop managers type in the admin, checked when saved and run on each cart.
//
//   quillo run formulas.qwe      then open http://localhost:8080/cart

use "formulas.qwer"

let ALLOWED = ["subtotal", "items", "country", "member"]

let rules = {
    shipping: "if(subtotal >= 50.0 || member, 0, if(country == \"NL\", 4.95, 9.95))",
    discount: "if(items >= 10, round(subtotal * 0.1 * 100) / 100, 0)",
}

route GET /cart ? { subtotal: float = 62.4, items: int = 12, country: str = "BE", member: bool = false } {
    let vars = { subtotal, items, country, member }
    let shipping = formula_eval(rules.shipping, vars)?
    let discount = formula_eval(rules.discount, vars)?
    { subtotal, shipping, discount, total: subtotal + shipping - discount }
}

route GET /save ? { formula: str } {
    let c = formula_check(formula, ALLOWED)
    if !c.ok { return { saved: false, error: c.error } }
    { saved: true, reads: c.variables, calls: c.functions }
}

route GET /margins = formula_eval_rows("(price - cost) / price * 100", [
    { price: 20, cost: 12 }, { price: 9.5, cost: 7.6 }, { price: 0, cost: 1 }, { price: 15 },
])?
