// The identity step of a sign-up form for an international payroll app: each country's number
// checked by its own rules, and the birth date it holds compared with the one typed.
//
//   quillo run national_ids.qwe      then open http://localhost:8080/samples and http://localhost:8080/check/BR/529.982.247-25

use "national_ids.qwer"

route GET /check/:country/*rest = national_id_check(country, rest)

let SAMPLES = [
    ["US", "123-45-6789"], ["GB", "AB 12 34 56 C"], ["BR", "529.982.247-25"], ["IN", "2341 2341 2346"],
    ["PH", "123-456-789-000"], ["ES", "12345678Z"], ["ES", "X1234567L"], ["IT", "RSSMRA85T10A562S"],
    ["FR", "2 55 08 14 168 025 38"], ["NL", "111222333"], ["BE", "85.07.30-033.28"], ["SE", "811228-9874"],
    ["NO", "15076500565"], ["FI", "131052-308T"], ["PL", "44051401359"], ["CN", "11010519491231002X"],
    ["ZA", "8001015009087"], ["CL", "12.345.678-5"], ["MX", "HEGG560427MVZRRL04"], ["CA", "130 692 544"],
    ["SG", "S1234567D"], ["TR", "10000000146"], ["RO", "1800101221144"], ["JP", "1234 5678 9018"],
    ["IE", "1234567T"], ["IL", "000000018"],
]

route GET /samples = SAMPLES | map((p) => { let r = national_id_check(p[0], p[1]); `${p[0]} ${r.valid ? r.kind : r.error}${r.birth_date != null ? " " + r.birth_date : ""}` })

route GET /details = {
    italy: national_id_check("IT", "RSSMRA85T10A562S"),
    china: national_id_check("CN", "11010519491231002X"),
    typo: national_id_check("BR", "529.982.247-26").error,
    ssn: national_id_check("US", "666-12-3456").error,
    masked: national_id_mask("529.982.247-25", 4),
    countries: len(national_id_countries()),
}
