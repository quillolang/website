// A crawler deciding what to fetch again from a site's sitemap, and the site's own sitemap written.
//
//   quillo run sitemap_read.qwe      then open http://localhost:8080/changed?since=2026-10-01

use "sitemap_read.qwer"

route GET /changed ? { since: str = "" } = sitemap_urls("sitemap_read_sample.xml", since)?

route GET /pages {
    let s = sitemap_read("sitemap_read_sample.xml")?
    { kind: s.kind, count: len(s.entries), images: flatten(s.entries | map((e) => e.images)), daily: s.entries | filter((e) => e.changefreq == "daily") | map((e) => e.loc) }
}

route GET /index = sitemap_read(`<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap><loc>https://shop.example.com/sitemap-products.xml.gz</loc><lastmod>2026-10-20</lastmod></sitemap>
  <sitemap><loc>https://shop.example.com/sitemap-blog.xml</loc></sitemap></sitemapindex>`)?

route GET /sitemap.xml = respond(200, sitemap_write([
    { loc: "https://quillo.example/", changefreq: "weekly", priority: 1 },
    { loc: "https://quillo.example/docs?page=1&lang=en", lastmod: "2026-10-28" },
])?, { "content-type": "application/xml" })
