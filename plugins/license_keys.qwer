//! Signed licence keys for software you sell: who it is for, which features, until when; made with your private key, checked offline with the public one, and impossible to forge.
//! version: 1.0.0
//!
//! [dependencies]
//! ed25519-dalek = "2"
//! rand = "0.8"
//! base64 = "0.22"
//! data-encoding = "2"

use base64::engine::general_purpose::STANDARD;
use base64::Engine;
use data_encoding::BASE32_NOPAD;
use ed25519_dalek::{Signature, Signer, SigningKey, VerifyingKey};
use rand::RngCore;
use serde_json::{json, Value};
use std::collections::HashMap;

fn key32(text: &str, what: &str) -> Result<[u8; 32], String> {
    let b = STANDARD.decode(text.trim()).map_err(|_| format!("the {} key is not base64", what))?;
    b.try_into().map_err(|_| format!("the {} key is 32 bytes (44 base64 characters)", what))
}

fn today() -> String {
    let days = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_secs() as i64) / 86400;
    let z = days + 719468;
    let era = z.div_euclid(146097);
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    format!("{:04}-{:02}-{:02}", yoe + era * 400 + if m <= 2 { 1 } else { 0 }, m, d)
}

fn is_date(s: &str) -> bool {
    let b = s.as_bytes();
    b.len() == 10 && b[4] == b'-' && b[7] == b'-' && s.chars().enumerate().all(|(i, c)| i == 4 || i == 7 || c.is_ascii_digit())
}

/// A new signing pair: `{ private, public }`, base64. Keep `private` where keys are made (never in the app you ship); put
/// `public` in the app.
pub fn license_keypair() -> HashMap<String, String> {
    let mut seed = [0u8; 32];
    rand::rngs::OsRng.fill_bytes(&mut seed);
    let k = SigningKey::from_bytes(&seed);
    HashMap::from([("private".into(), STANDARD.encode(k.to_bytes())), ("public".into(), STANDARD.encode(k.verifying_key().to_bytes()))])
}

/// A licence key for `customer` with `features`, valid until `expires` (a date, `2027-12-31`, included; empty for ever),
/// signed with `private_key`. Upper-case letters and digits in groups of five, such as `LIC-MFRGG-...`, about 130 to 200
/// characters: paste-able, and readable by license_check alone.
pub fn license_make(private_key: &str, customer: &str, features: Vec<String>, expires: &str) -> Result<String, String> {
    if !expires.is_empty() && !is_date(expires) {
        return Err(format!("`{}` is not a date like 2027-12-31", expires));
    }
    if customer.len() > 200 || features.len() > 50 {
        return Err("a customer of up to 200 characters, and up to 50 features".into());
    }
    let k = SigningKey::from_bytes(&key32(private_key, "private")?);
    let payload = serde_json::to_vec(&json!({ "c": customer, "f": features, "e": expires })).map_err(|e| e.to_string())?;
    let mut data = payload.clone();
    data.extend_from_slice(&k.sign(&payload).to_bytes());
    let code = BASE32_NOPAD.encode(&data);
    let groups: Vec<String> = code.as_bytes().chunks(5).map(|c| String::from_utf8_lossy(c).into_owned()).collect();
    Ok(format!("LIC-{}", groups.join("-")))
}

/// What a key says, checked with `public_key`: `{ valid, customer, features, expires, expired, reason }`. `valid` is true
/// only for a key made with the matching private key and not past its date; a typo or a forged key gives `valid: false` and a
/// `reason`. Spaces, dashes and lower case in the pasted key do not matter.
pub fn license_check(key: &str, public_key: &str) -> Result<Value, String> {
    let pk = VerifyingKey::from_bytes(&key32(public_key, "public")?).map_err(|_| "not an Ed25519 public key".to_string())?;
    let bad = |reason: &str| json!({ "valid": false, "customer": null, "features": [], "expires": null, "expired": false, "reason": reason });
    let cleaned: String = key.trim().trim_start_matches("LIC-").trim_start_matches("lic-").chars().filter(|c| c.is_ascii_alphanumeric()).collect::<String>().to_uppercase();
    if cleaned.len() > 2000 {
        return Ok(bad("too long to be a licence key"));
    }
    let Ok(data) = BASE32_NOPAD.decode(cleaned.as_bytes()) else { return Ok(bad("not a licence key: check for a typo")) };
    if data.len() <= 64 {
        return Ok(bad("not a licence key: too short"));
    }
    let (payload, sig) = data.split_at(data.len() - 64);
    let Ok(sig) = Signature::from_slice(sig) else { return Ok(bad("not a licence key")) };
    if pk.verify_strict(payload, &sig).is_err() {
        return Ok(bad("the key was not made by us, or a character is wrong"));
    }
    let v: Value = serde_json::from_slice(payload).map_err(|e| e.to_string())?;
    let expires = v["e"].as_str().unwrap_or("").to_string();
    let expired = !expires.is_empty() && today().as_str() > expires.as_str();
    Ok(json!({
        "valid": !expired,
        "customer": v["c"],
        "features": v["f"],
        "expires": if expires.is_empty() { Value::Null } else { Value::String(expires.clone()) },
        "expired": expired,
        "reason": if expired { Value::String(format!("expired on {}", expires)) } else { Value::Null },
    }))
}

/// Whether `key` is valid and holds `feature`.
pub fn license_has(key: &str, public_key: &str, feature: &str) -> Result<bool, String> {
    let c = license_check(key, public_key)?;
    Ok(c["valid"] == Value::Bool(true) && c["features"].as_array().is_some_and(|f| f.iter().any(|x| x.as_str() == Some(feature))))
}
