// A bookshop's catalog import: ISBNs and barcodes checked, and new internal codes given check digits.
//
//   quillo run check_digits.qwe      then open http://localhost:8080/isbn?code=0-306-40615-2

use "check_digits.qwer"

route GET /isbn ? { code: str } = isbn_check(code)

route GET /barcodes = ["4006381333931", "036000291452", "96385074", "4006381333932", "978-0-306-40615-7"] | map((c) => { code: c, check: barcode_check(c) })

route GET /make ? { code: str = "100023" } = {
    luhn: `${code}${check_digit(code, "luhn")?}`,
    ean: check_digit("400638133393", "ean")?,
    verhoeff: `${code}${check_digit(code, "verhoeff")?}`,
    // An ISO 11649 creditor reference: the check digits of the reference with "RF" after it.
    reference: `RF${check_digit("539007547034RF", "mod97")?}539007547034`,
    verhoeff_236: check_digit("236", "verhoeff")?,
    imei: imei_valid("490154203237518"),
}
