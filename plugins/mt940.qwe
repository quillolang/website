// A bookkeeping import of a bank's MT940 statement: balances, transactions and who each one was with.
//
//   quillo run mt940.qwe      then open http://localhost:8080/statement

use "mt940.qwer"

route GET /statement {
    let s = mt940_read_file("mt940_sample.sta")?[0]
    {
        account: s.account,
        opening: s.opening.amount,
        closing: s.closing.amount,
        adds_up: s.opening.cents + sum(s.transactions | map((t) => t.cents)) == s.closing.cents,
        transactions: s.transactions | map((t) => { date: t.date, amount: t.amount, with: t.info_fields.NAME, about: t.info_fields.REMI }),
    }
}

route GET /raw = mt940_read_file("mt940_sample.sta")?[0].transactions[2]
