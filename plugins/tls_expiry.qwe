// Certificate expiry alerts for the sites a team runs: each host's chain fetched every morning
// and checked, and the ones that expire within two weeks or are broken listed.
//
//   quillo run tls_expiry.qwe      then open http://localhost:8080/sample and http://localhost:8080/expired
//   and http://localhost:8080/check/example.com (this one goes to the network)
//
// The samples are a chain made for shop.example.com by a private CA (tls_expiry_sample_root.pem),
// and one for old.example.com that expired on 1 January 2025.

use "tls_expiry.qwer"

let SAMPLE = read_file("tls_expiry_sample.pem")?
let ROOT = read_file("tls_expiry_sample_root.pem")?

// Against Mozilla's roots the private CA is unknown; against its own root the chain is trusted.
route GET /sample = {
    public: tls_report(SAMPLE, "shop.example.com", "")?,
    private_ca: tls_report(SAMPLE, "shop.example.com", ROOT)?,
    other_host: tls_report(SAMPLE, "admin.example.com", ROOT)?.problems,
}

route GET /expired = tls_report(read_file("tls_expiry_sample_expired.pem")?, "old.example.com", ROOT)?

route GET /check/:host = tls_check(host, 443, 5000)?

let SITES = ["example.com", "quillolang.org"]

fn alerts() = SITES | map((h) => tls_check(h, 443, 5000)) | filter((r) => is_err(r) || r.days_left < 14 || !r.trusted)

route GET /alerts = alerts() | map((r) => is_err(r) ? r.error : { host: r.host, days_left: r.days_left, problems: r.problems })
