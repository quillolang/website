// An order's life drawn as a state machine, and a team's reporting lines drawn from a list.
//
//   quillo run graphviz.qwe      then open http://localhost:8080/order.svg

use "graphviz.qwer"

let ORDER = `digraph {
    rankdir=LR;
    node [shape=box, style=rounded];
    new -> paid [label="pays"];
    paid -> shipped [label="leaves the roastery"];
    shipped -> delivered;
    new -> cancelled [label="no payment in 7 days"];
    cancelled [color="red"];
}`

route GET /order.svg = respond(200, graphviz_svg(ORDER)?, { "content-type": "image/svg+xml" })

route GET /team.svg {
    let team = [{ name: "Ada", boss: null }, { name: "Grace", boss: "Ada" }, { name: "Alan", boss: "Ada" }, { name: "Edsger", boss: "Grace" }]
    let edges = team | filter((p) => p.boss != null) | map((p) => [p.boss, p.name])
    respond(200, graphviz_edges_svg(edges, null)?, { "content-type": "image/svg+xml" })
}

route GET /check = { good: graphviz_check(ORDER), bad: graphviz_check("digraph { a -> }") }
