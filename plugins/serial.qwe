// A weighing station on a serial port: a scale asked for its weight, a sensor's stream read in
// pieces, a block of lines, a binary reply, the port's settings changed, and a device that says
// nothing answered with a timeout rather than a hang.
//
//   SERIAL_PORT=/dev/ttyUSB0 quillo run serial.qwe      then open http://localhost:8080/ports and /weigh
//
// Without SERIAL_PORT the routes that need a port say so. On Linux the user must be in `dialout`.

use "serial.qwer"

let PATH = env("SERIAL_PORT", "")
let opened = null

fn scale() {
    if PATH == "" { reply 503 "set SERIAL_PORT to a device" }
    if !opened {
        let got = serial_open("scale", PATH, { baud: 9600, parity: "even", data_bits: 7, stop_bits: 1, timeout_ms: 800 })
        if is_err(got) { reply 503 got.error }
        opened = got
    }
    opened
}

route GET /ports = { listed: len(serial_ports()?) >= 0, port_given: PATH != "" }

route GET /open {
    let s = scale()
    { path_given: s.path == PATH, parity: s.parity, data_bits: s.data_bits, seen_by_device: serial_query("scale", "CONF?\r\n", {})? }
}

route GET /weigh {
    scale()
    let line = serial_query("scale", "W\r\n", {})?
    let sics = serial_query("scale", "SI\r\n", {})?
    { line: line, weight: serial_parse_weight(line)?, sics: serial_parse_weight(sics)? }
}

// The sensor sends its line in two pieces, a moment apart: read_line waits for the whole of it.
route GET /sensor {
    scale()
    serial_write("scale", "SENSOR\r\n")?
    let line = serial_read_line("scale", { timeout_ms: 1000 })?
    { line: line, fields: serial_parse_fields(line) }
}

route GET /dump {
    scale()
    serial_write("scale", "DUMP\r\n")?
    let log = serial_read_lines("scale", "END", {})?
    serial_write("scale", "PROMPT\r\n")?
    { log: log, before_prompt: serial_read_until("scale", "> ", {})?, count: len(log) }
}

route GET /binary {
    scale()
    let sent = serial_write_bytes("scale", [66, 73, 78, 13, 10])?
    { sent: sent, got: serial_read_bytes("scale", 4, {})? }
}

route GET /silent {
    scale()
    let quiet = serial_query("scale", "QUIET\r\n", { timeout_ms: 150 })
    serial_write("scale", "HALF\r\n")?
    let half = serial_read_line("scale", { timeout_ms: 150 })
    let rest = serial_read_available("scale", {})?
    { quiet: quiet.error, half: half.error, rest: rest, cleared: serial_clear("scale")? }
}

route GET /reopen {
    scale()
    let closed = serial_close("scale")?
    opened = null
    { closed: closed, gone: serial_read_line("scale", {}).error, again: scale().parity, signals: len(serial_signals("scale")?) }
}

route GET /parse = {
    gross: serial_parse_weight("ST,GS,+  12.345kg")?,
    net_moving: serial_parse_weight("US,NT,-   0.120 kg")?,
    bare: serial_parse_weight("   12.34 lb")?,
    comma: serial_parse_weight("ST,GS,+ 1,500g")?,
    sics_moving: serial_parse_weight("S D    99.98 g")?,
    over: serial_parse_weight("S +").error,
    busy: serial_parse_weight("S I").error,
    too_much: serial_parse_weight("OL,GS,+ 999.99kg").error,
    noise: serial_parse_weight("hello").error,
    fields: serial_parse_fields("temp:21.5, rh:40 status=ok"),
    nmea: serial_checksum("GPGLL,5300.97914,N,00259.98174,E,125926,A", "xor")?,
    sum: serial_checksum("ABC", "sum")?,
}

route GET /errors = {
    missing: serial_open("x", "/dev/no-such-port", {}).error,
    baud: serial_open("x", "/dev/null", { baud: 0 }).error,
    parity: serial_open("x", "/dev/null", { parity: "mark" }).error,
    closed: serial_write("never", "x").error,
}
