//! UUIDs beyond Quillo's random `uuid()`: version 7 (sorted by time, a good database key), version 5 and 3 (the same name always gives the same id), and any UUID read: its version, variant and time.
//! version: 1.0.0
//!
//! [dependencies]
//! uuid = { version = "1", features = ["v3", "v5", "v7", "std"] }

use serde_json::{json, Value};
use uuid::{NoContext, Timestamp, Uuid};

fn namespace(ns: &str) -> Result<Uuid, String> {
    Ok(match ns.trim().to_lowercase().as_str() {
        "dns" => Uuid::NAMESPACE_DNS,
        "url" => Uuid::NAMESPACE_URL,
        "oid" => Uuid::NAMESPACE_OID,
        "x500" => Uuid::NAMESPACE_X500,
        other => Uuid::parse_str(other).map_err(|_| format!("namespace is \"dns\", \"url\", \"oid\", \"x500\" or a UUID, not {:?}", ns))?,
    })
}

/// A new version 7 UUID: its first 48 bits are the time in milliseconds, so ids made later sort after (within one server, even in the same millisecond), and database indexes stay compact.
pub fn uuid_v7() -> String {
    Uuid::now_v7().to_string()
}

/// A version 7 UUID for a time in milliseconds since 1970 (as `now()` gives), the rest random: for back-filling old rows, or the lowest id of a time range.
pub fn uuid_v7_at(time_ms: i64) -> Result<String, String> {
    if time_ms < 0 {
        return Err("times from 1970".into());
    }
    Ok(Uuid::new_v7(Timestamp::from_unix(NoContext, (time_ms / 1000) as u64, ((time_ms % 1000) * 1_000_000) as u32)).to_string())
}

/// The version 5 UUID of `name` in `namespace` ("dns", "url", "oid", "x500", or a UUID of your own), by SHA-1: the same name always gives the same id, so an import can find its rows again. `uuid_v5("dns", "example.com")` is "cfbff0d1-9375-5685-968c-48ce8b15ae17".
pub fn uuid_v5(namespace: &str, name: &str) -> Result<String, String> {
    Ok(Uuid::new_v5(&self::namespace(namespace)?, name.as_bytes()).to_string())
}

/// As `uuid_v5`, by MD5 (version 3), for systems that use those.
pub fn uuid_v3(namespace: &str, name: &str) -> Result<String, String> {
    Ok(Uuid::new_v3(&self::namespace(namespace)?, name.as_bytes()).to_string())
}

/// Any UUID read, in any of its forms (with or without dashes, braces or "urn:uuid:"): `{ uuid, version, variant, time_ms, simple, urn, nil }`. `time_ms` is when versions 1, 6 and 7 were made (else null); `uuid` the usual lower-case form. An error when it is not a UUID.
pub fn uuid_parse(text: &str) -> Result<Value, String> {
    let u = Uuid::parse_str(text.trim()).map_err(|e| format!("{:?} is not a UUID: {}", text, e))?;
    let time_ms = u.get_timestamp().map(|t| { let (s, n) = t.to_unix(); s as i64 * 1000 + (n / 1_000_000) as i64 });
    Ok(json!({
        "uuid": u.hyphenated().to_string(),
        "version": u.get_version_num(),
        "variant": format!("{:?}", u.get_variant()),
        "time_ms": time_ms,
        "simple": u.simple().to_string(),
        "urn": u.urn().to_string(),
        "nil": u.is_nil(),
    }))
}

/// Whether `text` is a UUID in any of its forms.
pub fn uuid_valid(text: &str) -> bool {
    Uuid::parse_str(text.trim()).is_ok()
}
