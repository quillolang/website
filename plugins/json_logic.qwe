// Shipping tiers and promotions as JsonLogic rules, as an admin would keep them in the
// database and the checkout page would also run them in the browser (json-logic-js).
//
//   quillo run json_logic.qwe      then open http://localhost:8080/shipping?total=80&country=NL

use "json_logic.qwer"

let tiers = [
    { when: { ">=": [{ var: "total" }, 100] }, then: "free" },
    { when: { and: [{ in: [{ var: "country" }, ["NL", "BE", "LU"]] }, { ">=": [{ var: "total" }, 50] }] }, then: "benelux" },
    { when: { "==": [{ var: "member" }, true] }, then: "member" },
]

route GET /shipping ? { total: float, country: str = "DE", member: bool = false } {
    let d = jsonlogic_decide(tiers, { total, country, member }, "standard")?
    { tier: d.then, rule: d.index }
}

let customers = [
    { name: "Ada", orders: 14, country: "UK", newsletter: true },
    { name: "Bas", orders: 2, country: "NL", newsletter: true },
    { name: "Cleo", orders: 31, country: "NL", newsletter: false },
]

route GET /segment = jsonlogic_filter({ and: [{ ">": [{ var: "orders" }, 10] }, { "!": [{ "==": [{ var: "country" }, "UK"] }] }] }, customers)? | map((c) => c.name)

route GET /price = {
    discount: jsonlogic_apply({ if: [{ ">=": [{ var: "qty" }, 10] }, { "*": [{ var: "price" }, 0.1] }, 0] }, { qty: 12, price: 30 })?,
    eligible: jsonlogic_test({ "<=": [18, { var: "age" }, 65] }, { age: 40 })?,
    missing: jsonlogic_apply({ missing: ["email", "name"] }, { name: "Ada" })?,
}
