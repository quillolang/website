// A delivery company's site: "closed today" banners, the next days off in each country it ships to, and Easter for the spring sale.
//
//   quillo run holidays.qwe      then open http://localhost:8080/holidays/US/2026

use "holidays.qwer"

route GET /holidays/:country/:year(int) = holidays_list(country, year)?

route GET /check {
    {
        us_july_4_2026: holidays_list("US", 2026)? | find((h) => h.name == "Independence Day"),
        uk_christmas_2027: holidays_list("GB", 2027)? | filter((h) => h.date >= "2027-12-25") | map((h) => `${h.name} ${h.date} off ${h.observed}`),
        closed_de: holidays_on("DE", "2026-10-03")?,
        closed_us: holidays_on("US", "2026-07-03")?,
        open: holidays_on("FR", "2026-10-29")?,
        next_ph: holidays_next("PH", "2026-10-29", 3)? | map((h) => h.name),
        japan_2026_september: holidays_list("JP", 2026)? | filter((h) => slice(h.date, 5, 7) == "09") | map((h) => `${h.date} ${h.name}`),
        easter: [holidays_easter(2026, false)?, holidays_easter(2026, true)?],
        countries: len(holidays_countries()),
        unknown: holidays_list("XX", 2026).error,
    }
}
