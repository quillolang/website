// A Dockerfile checked before it is built: what it holds, which images it pulls and how well they
// are pinned, and what a reviewer would say about it.
//
//   quillo run dockerfile.qwe      then open http://localhost:8080/parse, /stages, /images, /lint, /refs and /broken

use "dockerfile.qwer"

let TEXT = read_file("dockerfile_sample.Dockerfile")

route GET /parse {
    let d = dockerfile_parse(TEXT)?
    let list = d.instructions
    {
        directives: d.directives, count: len(list),
        continued: [list[5].line, list[5].end_line, list[5].args, list[5].form],
        heredoc: list[8].heredocs, copy_heredoc: [list[9].flags, list[9].heredocs[0].text, list[9].heredocs[0].expand],
        from_flags: list[2].flags,
        env: (list | filter((i) => i.instruction == "ENV")) | map((i) => i.pairs),
        label: (list | filter((i) => i.instruction == "LABEL"))[0].pairs,
        cmd: (list | filter((i) => i.instruction == "CMD")) | map((i) => [i.form, i.list ?? i.args]),
    }
}

route GET /stages = dockerfile_stages(TEXT, {})? | map((s) => [s.index, s.name, s.image, s.from_stage, s.pin, s.platform])

route GET /images = {
    default: dockerfile_images(TEXT, {})?,
    build_arg: dockerfile_images(TEXT, { NODE_VERSION: "18" })?[0],
}

route GET /lint = dockerfile_lint(TEXT)? | map((x) => `${x.line} ${x.level} ${x.rule}`)

route GET /messages = (dockerfile_lint(TEXT)? | filter((x) => x.rule == "copy-from-unknown" || x.rule == "root-user" || x.rule == "secret-in-image")) | map((x) => x.message)

route GET /refs = {
    plain: dockerfile_image_ref("nginx")?,
    org: dockerfile_image_ref("bitnami/redis:7.2")?,
    port: dockerfile_image_ref("localhost:5000/a/b:1")?,
    ghcr: dockerfile_image_ref("ghcr.io/o/r@sha256:8f434346648f6b96df89dda901c5176b10a6d83961dd3c1ac88b59b2dc327aa4")?.digest,
    upper: dockerfile_image_ref("Nginx").error,
    bad_tag: dockerfile_image_ref("nginx:a/b:c!").error,
    bad_digest: dockerfile_image_ref("nginx@sha256:zz").error,
}

route GET /tick {
    let t = dockerfile_parse("# escape=`\nFROM scratch\nRUN dir `\n  c:\\ `\n  /b\n")?
    let good = dockerfile_lint("FROM alpine:3.19.1\nUSER 1000\nCMD [\"app\"]\n")?
    { run: t.instructions[1].args, directive: t.directives, good: good, scratch: dockerfile_lint("FROM scratch\nCOPY a /a\n")? }
}

route GET /broken = {
    unknown: dockerfile_parse("FROM a\nFROB x\n").error,
    no_from: dockerfile_stages("RUN x\n", {}).error,
    before: dockerfile_lint("ARG A=1\nRUN x\nFROM a:1.2.3\n")?[0].rule,
    heredoc: dockerfile_parse("FROM a\nRUN <<EOF\necho\n").error,
    empty_run: dockerfile_parse("FROM a\nRUN\n").error,
    bad_from: dockerfile_stages("FROM a b c d\n", {}).error,
    later: (dockerfile_lint("FROM a:1.2 AS one\nCOPY --from=two /a /b\nFROM a:1.2 AS two\nUSER x\n")? | map((x) => x.rule)),
    twice: (dockerfile_lint("FROM a:1.2 AS x\nFROM b:1.2 AS X\nUSER x\n")? | map((x) => x.rule)),
}
