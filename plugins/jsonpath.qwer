//! Query values with JSONPath (RFC 9535): `$.store.book[?@.price < 10].title` and the like, to pick fields out of large API answers and documents.
//! version: 1.0.0
//!
//! [dependencies]
//! serde_json_path = "0.7"
//! serde_json = "1"

use serde_json::{json, Value};
use serde_json_path::JsonPath;

fn path(p: &str) -> Result<JsonPath, String> {
    JsonPath::parse(p).map_err(|e| format!("not a JSONPath: {}", e))
}

/// Every value in `value` that `query` selects, in document order: `$.orders[*].total`, `$..email`, `$.items[?@.qty > 1]`,
/// `$.items[0:2]`, functions `length()`, `count()`, `match()`, `search()` and `value()`. An empty list when nothing matches.
pub fn jsonpath(value: serde_json::Value, query: &str) -> Result<Vec<Value>, String> {
    Ok(path(query)?.query(&value).all().into_iter().cloned().collect())
}

/// The first value `query` selects, or null.
pub fn jsonpath_first(value: serde_json::Value, query: &str) -> Result<Value, String> {
    Ok(path(query)?.query(&value).first().cloned().unwrap_or(Value::Null))
}

/// Where each selected value is, with the value: `{ path, value }`, `path` written as RFC 9535's normalized path (`$['items'][2]`)
/// and as a JSON Pointer (`pointer`: `/items/2`), for json_patch operations.
pub fn jsonpath_located(value: serde_json::Value, query: &str) -> Result<Vec<Value>, String> {
    Ok(path(query)?.query_located(&value).into_iter().map(|n| json!({
        "path": n.location().to_string(),
        "pointer": n.location().to_json_pointer(),
        "value": n.node(),
    })).collect())
}
