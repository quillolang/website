// Linear from a program: an issue opened in a team, a comment, the issue moved to a state by name,
// a whole team's issues read past a page, and a webhook checked.
//
//   LINEAR_API_KEY=... LINEAR_WEBHOOK_SECRET=... quillo run linear.qwe
//   then open http://localhost:8080/issue, /list, /hook-check and /failures
//
// The key comes from Settings > API. LINEAR_API_URL reaches a test server.

use "linear.qwer"

route GET /issue {
    let team = linear_teams({})?[0]
    let made = linear_issue_create({ teamId: team.id, title: "Checkout is slow", description: "Since **Tuesday**.", priority: 2 }, {})?
    linear_comment(made.id, "Looking into it.", {})?
    let moved = linear_move(made.identifier, "in progress", {})?
    let done = linear_issue_update(made.id, { priority: 1 }, {})?
    {
        team: team.key,
        identifier: made.identifier,
        first_state: made.state,
        moved: moved.state,
        priority: done.priority,
        comments: map(linear_comments(made.id, {})?, (c) => c.body),
        states: map(linear_states(team.id, {})?, (s) => s.name),
        read: linear_issue(made.identifier, {})?.title,
    }
}

route GET /list {
    let all = linear_issues({ team: { key: { eq: "ENG" } } }, {})?
    { total: len(all), first: all[0].identifier, label: all[0].labels, capped: len(linear_issues(null, { max_items: 130 })?) }
}

route POST /linear/hook {
    let hook = linear_webhook(request.body, request.headers["linear-signature"] ?? "", "", 0)
    if is_err(hook) { reply 401 hook.error }
    { action: hook.action, kind: hook.type }
}

// Worked out outside this plugin, with the secret "lin-secret".
let BODY = "{\"action\":\"create\",\"type\":\"Issue\",\"data\":{\"id\":\"i1\"},\"webhookTimestamp\":1790000000000}"
let SIG = "b8edae733e69f709ab8fb5ffbb90e3dba8f5a54b35ffe8fbe44c6391db5d9972"

route GET /hook-check = {
    kind: linear_webhook(BODY, SIG, "lin-secret", -1)?.type,
    tampered: linear_webhook(BODY + " ", SIG, "lin-secret", -1).error,
    wrong: linear_webhook(BODY, SIG, "other", -1).error,
    old: linear_webhook(BODY, SIG, "lin-secret", 0).error,
}

route GET /failures {
    let team = linear_teams({})?[0]
    {
        bad_key: linear_teams({ api_key: "wrong" }).error,
        no_title: linear_issue_create({ teamId: team.id }, {}).error,
        refused: linear_issue_create({ teamId: "none", title: "x" }, {}).error,
        missing: linear_issue("ENG-99999", {}).error,
        no_state: linear_move("ENG-1", "Shipped", {}).error,
        waited: len(linear_comments("ENG-1", {})?),
        limit: linear_graphql("query Spent { viewer { id } }", null, {}).error,
    }
}
