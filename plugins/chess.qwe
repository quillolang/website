// A chess server's rules: a position read from FEN, its legal moves, moves played and refused,
// a PGN game read back, perft to prove the move generator, and Chess960 start positions.
//
//   quillo run chess.qwe      then open http://localhost:8080/start, /moves, /play, /mate, /stalemate, /pgn, /write, /960 and /refused

use "chess.qwer"

let KIWIPETE = "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1"

route GET /start = {
    position: chess_position("")?,
    perft: [chess_perft("", 3)?, chess_perft("", 4)?, chess_perft(KIWIPETE, 3)?],
    board: chess_board("")?,
}

route GET /moves {
    let m = chess_moves(KIWIPETE)?
    {
        count: len(m),
        castles: m | filter((x) => x.castle != null) | map((x) => [x.san, x.uci, x.castle]),
        captures: len(m | filter((x) => x.capture != null)),
        promotion: find(chess_moves("8/P6k/8/8/8/8/8/K7 w - - 0 1")?, (x) => x.promotion == "knight"),
        en_passant: find(chess_moves("rnbqkbnr/ppp1pppp/8/8/3pP3/8/PPPP1PPP/RNBQKBNR b KQkq e3 0 3")?, (x) => x.en_passant),
    }
}

route GET /play {
    let a = chess_play("", "e4")?
    let b = chess_play(a.position.fen, "c7c5")?
    {
        first: [a.san, a.uci, a.piece],
        second: [b.san, b.uci],
        fen: b.position.fen,
        line: chess_line("", ["e4", "e5", "Nf3", "Nc6", "Bb5"])?.uci,
        as_uci: chess_line("", ["e2e4", "e7e5", "g1f3"])?.san,
    }
}

// Scholar's mate, a stalemate, bare kings.
route GET /mate = chess_line("", ["e4", "e5", "Bc4", "Nc6", "Qh5", "Nf6", "Qxf7#"])?

route GET /stalemate = {
    stalemate: chess_position("7k/5Q2/6K1/8/8/8/8/8 b - - 0 1")?,
    bare: chess_position("8/8/8/4k3/8/4K3/8/8 w - - 0 1")?.reason,
    fifty: chess_position("8/8/8/4k3/8/4K3/7R/8 w - - 100 80")?.fifty_move_claim,
}

let PGN = `[Event "Casual game"]
[Site "London"]
[Date "1851.06.21"]
[White "Anderssen, Adolf"]
[Black "Kieseritzky, Lionel"]
[Result "1-0"]
[Annotator "A \\"quoted\\" name"]

{The Immortal Game, its start.}
1. e4 e5 2. f4 $1 exf4 {The gambit taken} 3. Bc4 Qh4+ (3... d5 4. Bxd5) 4. Kf1 b5?! 1-0

[Event "Second"]
[White "A"]
[Black "B"]
[Result "*"]

1. e4 e5 2. Ke3 *

[Event "From a position"]
[FEN "7k/8/8/8/8/8/8/R3K3 w Q - 0 1"]
[SetUp "1"]
[Result "1/2-1/2"]

1. O-O-O Kg8 1/2-1/2
`

route GET /pgn {
    let g = chess_pgn(PGN)?
    {
        games: len(g),
        tags: g[0].tags,
        moves: g[0].moves | map((m) => m.san),
        comments: g[0].comments, intro: g[0].intro, side_lines: g[0].variations, result: g[0].result,
        after: g[0].position.fen,
        illegal: g[1].error, kept: len(g[1].moves),
        from_fen: g[2].moves | map((m) => [m.number, m.color, m.uci]),
    }
}

route GET /write {
    let text = chess_pgn_write({ White: "Ada", Black: "Grace", Date: "2026.11.01", Opening: "Sicilian" }, ["e4", "c5", "Nf3"], "*")?
    let back = chess_pgn(text)?[0]
    { text: text, back: back.moves | map((m) => m.uci), opening: back.tags.Opening }
}

route GET /960 = {
    usual: chess_960(518)?,
    first: chess_960(0)?,
    last: chess_960(959)?,
    another: chess_960(100)?.pieces,
    castle: chess_moves("bqnbrkrn/pppppppp/8/8/8/8/PPPPPPPP/BQNBRKRN w KQkq - 0 1")? | filter((m) => m.castle != null),
    out_of_range: chess_960(960).error,
}

route GET /refused = {
    illegal: chess_play("", "e5").error,
    nonsense: chess_play("", "hello").error,
    line: chess_line("", ["e4", "e5", "Ke3"]).error,
    bad_fen: chess_position("not a fen").error,
    two_kings: chess_fen_check("rnbqkbnk/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"),
    no_king: chess_fen_check("8/8/8/8/8/8/8/8 w - - 0 1").ok,
    deep: chess_perft("", 7).error,
    result: chess_pgn_write({}, [], "win").error,
}
