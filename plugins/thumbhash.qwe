// A photo gallery: each photo's ThumbHash made on upload and kept with it, then shown as a soft placeholder until the photo arrives.
//
//   quillo run thumbhash.qwe      then open http://localhost:8080/

use "thumbhash.qwer"

let PHOTO = "thumbhash_sample.png"

route GET /hash {
    let hash = thumbhash_of(PHOTO)?
    { hash: hash, length: len(hash), info: thumbhash_info(hash)?, preview_starts: slice(thumbhash_data_url(hash)?, 0, 22) }
}

route GET / {
    let hash = thumbhash_of(PHOTO)?
    let info = thumbhash_info(hash)?
    <html><body>
        <div style={`width: 480px; aspect-ratio: ${info.ratio}; background: ${info.color} url(${thumbhash_data_url(hash)?}) center / cover`}>
            <img src="/photo.png" width="480" loading="lazy" alt="Hills, the sun, a bowl of apples"/>
        </div>
    </body></html>
}

route GET /photo.png = file(PHOTO)
