// The home page in the visitor's language, picked from the browser's Accept-Language header,
// with a language menu ordered by what the visitor reads.
//
//   quillo run accept_language.qwe      then curl -H "Accept-Language: nl-BE,nl;q=0.9,en;q=0.8" localhost:8080/

use "accept_language.qwer"

let SITE = ["en", "nl", "fr", "pt-BR", "de"]
let HELLO = { en: "Welcome", nl: "Welkom", fr: "Bienvenue", "pt-BR": "Bem-vindo", de: "Willkommen" }

route GET / {
    let lang = accept_language_pick(request.headers["accept-language"] ?? "", SITE, "en")
    { lang, greeting: HELLO[lang], menu: accept_language_rank(request.headers["accept-language"] ?? "", SITE) | map((l) => l.tag) }
}

route GET /cases = {
    belgian: accept_language_pick("nl-BE,nl;q=0.9,en;q=0.8", SITE, "en"),
    portuguese: accept_language_pick("pt-PT,pt;q=0.8", SITE, "en"),
    swiss_german: accept_language_pick("gsw;q=1, de-CH;q=0.8", SITE, "en"),
    refused: accept_language_pick("fr;q=0, it", SITE, "en"),
    weights: accept_language_parse("fr-CH, fr;q=0.9, en;q=0.8, *;q=0.5, de;q=bad"),
}
