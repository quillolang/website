//! What an audio file holds: length, bitrate, sample rate, channels, its tags (title, artist, album...) and cover art, for MP3, FLAC, M4A, Ogg, Opus, WAV and AIFF.
//! version: 1.0.0
//!
//! [dependencies]
//! lofty = { version = "0.22", default-features = false }

use lofty::file::TaggedFile;
use lofty::prelude::*;
use serde_json::{json, Value};

const MAX_COVER: usize = 32 * 1024 * 1024;

fn read(path: &str) -> Result<TaggedFile, String> {
    let p = path.to_string();
    // A damaged file must not take the server down with it.
    match std::panic::catch_unwind(move || lofty::read_from_path(&p)) {
        Ok(Ok(f)) => Ok(f),
        Ok(Err(e)) => Err(format!("{}: {}", path, e)),
        Err(_) => Err(format!("{}: the file could not be read", path)),
    }
}

fn format_name(f: &TaggedFile) -> String {
    format!("{:?}", f.file_type()).to_lowercase()
}

/// Everything known about an audio file: `{ format, duration, bitrate, sample_rate, channels, bit_depth, title, artist, album, album_artist, year, track, genre, has_cover }`.
/// `duration` is in seconds (a float), `bitrate` in kbit/s, `sample_rate` in Hz; what the file does not say is null.
pub fn audio_info(path: &str) -> Result<Value, String> {
    let f = read(path)?;
    let p = f.properties();
    let tag = f.primary_tag().or_else(|| f.first_tag());
    let text = |v: Option<std::borrow::Cow<'_, str>>| v.map(|s| s.trim().to_string()).filter(|s| !s.is_empty());
    Ok(json!({
        "format": format_name(&f),
        "duration": (p.duration().as_millis() as f64) / 1000.0,
        "bitrate": p.audio_bitrate().or(p.overall_bitrate()),
        "sample_rate": p.sample_rate(),
        "channels": p.channels(),
        "bit_depth": p.bit_depth(),
        "title": tag.and_then(|t| text(t.title())),
        "artist": tag.and_then(|t| text(t.artist())),
        "album": tag.and_then(|t| text(t.album())),
        "album_artist": tag.and_then(|t| t.get_string(&ItemKey::AlbumArtist).map(str::to_string)),
        "year": tag.and_then(|t| t.year()),
        "track": tag.and_then(|t| t.track()),
        "genre": tag.and_then(|t| text(t.genre())),
        "has_cover": f.tags().iter().any(|t| !t.pictures().is_empty()),
    }))
}

/// The length of an audio file in seconds (a float): for a player, or to refuse uploads that are too long.
pub fn audio_duration(path: &str) -> Result<f64, String> {
    Ok(read(path)?.properties().duration().as_millis() as f64 / 1000.0)
}

/// Saves the file's cover art (the front cover when there are several pictures) as `to` + ".jpg" or ".png" by its type, folders made: the path written. An error when it has none.
pub fn audio_cover(path: &str, to: &str) -> Result<String, String> {
    let f = read(path)?;
    let pics: Vec<_> = f.tags().iter().flat_map(|t| t.pictures().iter()).collect();
    let pic = pics.iter().find(|p| p.pic_type() == lofty::picture::PictureType::CoverFront).or(pics.first()).ok_or_else(|| format!("{}: no cover art", path))?;
    if pic.data().len() > MAX_COVER {
        return Err(format!("{}: the cover is larger than 32 MB", path));
    }
    let ext = match pic.mime_type() {
        Some(lofty::picture::MimeType::Png) => "png",
        Some(lofty::picture::MimeType::Gif) => "gif",
        Some(lofty::picture::MimeType::Bmp) => "bmp",
        _ => if pic.data().starts_with(&[0x89, b'P']) { "png" } else { "jpg" },
    };
    let out = format!("{}.{}", to, ext);
    if let Some(dir) = std::path::Path::new(&out).parent().filter(|d| !d.as_os_str().is_empty()) {
        std::fs::create_dir_all(dir).map_err(|e| format!("{}: {}", dir.display(), e))?;
    }
    std::fs::write(&out, pic.data()).map_err(|e| format!("{}: {}", out, e))?;
    Ok(out)
}
