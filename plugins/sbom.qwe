// A release's bill of materials: read from CycloneDX or SPDX, its licences checked, why a package
// is there, what changed since the last one, and one built for a program's own dependencies.
//
//   quillo run sbom.qwe      then open http://localhost:8080/read, /spdx, /licenses, /why, /graph, /diff, /purl, /build and /broken

use "sbom.qwer"

let CDX = read_file("sbom_sample.cdx.json")
let SPDX = read_file("sbom_sample.spdx")

route GET /read {
    let b = sbom_read_file("sbom_sample.cdx.json")?
    { format: b.format, spec: b.spec_version, name: b.name, version: b.version, components: b.components | map((c) => `${c.name}@${c.version}`), first: b.components[0], problems: b.problems, deps: len(b.dependencies) }
}

route GET /spdx {
    let b = sbom_read(SPDX)?
    { format: b.format, spec: b.spec_version, name: b.name, version: b.version, parts: b.components | map((c) => [c.name, c.version, c.licenses, c.purl]), supplier: b.components[1].supplier, hash: b.components[1].hashes, deps: b.dependencies, problems: b.problems }
}

route GET /licenses = {
    all: sbom_licenses(CDX, [])?,
    policy: sbom_licenses(CDX, ["MIT", "Apache-2.0"])?.not_allowed,
}

route GET /why = {
    qs: sbom_why(CDX, "qs")?,
    spdx: sbom_why(SPDX, "left-pad")?,
    stranger: sbom_why(CDX, "react").error,
}

route GET /graph = sbom_graph(CDX)?
route GET /diff = sbom_diff(CDX, SPDX)?

route GET /purl = {
    scoped: sbom_purl_parse("pkg:npm/%40angular/core@17.0.1")?,
    qualified: sbom_purl_parse("pkg:deb/debian/curl@7.50.3-1?arch=i386&distro=jessie")?,
    pypi: sbom_purl_parse("pkg:PYPI/Django_Rest@1.0#src/./lib")?,
    made: sbom_purl_make({ type: "npm", namespace: "@angular", name: "core", version: "17.0.1" })?,
    maven: sbom_purl_make({ type: "maven", namespace: "org.apache.xmlgraphics", name: "batik-anim", version: "1.9.1", qualifiers: { repository_url: "repo.spring.io/release", classifier: "sources" } })?,
    image: sbom_purl_make({ type: "docker", name: "cassandra", version: "sha256:244fd47e07d1004f" })?,
    plus: sbom_purl_make({ type: "gem", name: "a b", version: "1.0+x", subpath: "lib/../x" })?,
    again: sbom_purl_make(sbom_purl_parse("pkg:golang/GitHub.com/Gorilla/Context@1.1.1#a/b")?)?,
    bad: [sbom_purl_parse("npm/x").error, sbom_purl_parse("pkg:npm").error, sbom_purl_parse("pkg:npm/%zz").error, sbom_purl_make({ name: "x" }).error],
}

let ROOT = { name: "billing", version: "1.0.0" }
let PARTS = [
    { name: "ureq", version: "2.10.0", purl: { type: "cargo", name: "ureq", version: "2.10.0" }, licenses: ["MIT OR Apache-2.0"], depends_on: ["ring"] },
    { name: "ring", version: "0.17.8", purl: "pkg:cargo/ring@0.17.8", licenses: ["ISC"], direct: false },
]

route GET /build {
    let cdx = sbom_cyclonedx(ROOT, PARTS, "3E671687-395B-41F5-A30F-A58921A69B79")?
    let spdx = sbom_spdx(ROOT, PARTS, "https://example.org/spdx/billing-1", "2026-11-01T09:00:00Z")?
    let a = sbom_read(cdx)?
    let b = sbom_read(spdx)?
    {
        serial: json.parse(cdx).serialNumber,
        cdx: [a.spec_version, a.name, a.problems, sbom_why(cdx, "ring")?],
        expression: json.parse(cdx).components[0].licenses,
        spdx: [b.spec_version, b.name, b.problems, sbom_why(spdx, "ring")?],
        same: sbom_diff(cdx, spdx)?,
        unknown_dep: sbom_cyclonedx(ROOT, [{ name: "a", depends_on: ["b"] }], "3E671687-395B-41F5-A30F-A58921A69B79").error,
        bad_serial: sbom_cyclonedx(ROOT, [], "nope").error,
    }
}

route GET /broken = {
    neither: sbom_read("{}").error,
    xml: sbom_read("<bom/>").error,
    no_root: sbom_why("{\"bomFormat\":\"CycloneDX\",\"components\":[{\"name\":\"x\",\"bom-ref\":\"x\"}]}", "x").error,
    dangling: sbom_read("{\"bomFormat\":\"CycloneDX\",\"specVersion\":\"1.5\",\"components\":[{\"name\":\"x\",\"bom-ref\":\"x\",\"purl\":\"pkg:npm\"}],\"dependencies\":[{\"ref\":\"x\",\"dependsOn\":[\"gone\"]}]}")?.problems,
}
