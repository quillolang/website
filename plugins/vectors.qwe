// "More like this" for a shop: products as small embeddings (from any embedding model, here
// four made-up numbers: sporty, cosy, techy, outdoorsy), searched by similarity.
//
//   quillo run vectors.qwe      then open http://localhost:8080/like?id=tent

use "vectors.qwer"

let products = [
    { id: "tent", name: "Two-person tent", v: [0.2, 0.1, 0.1, 0.95] },
    { id: "boots", name: "Hiking boots", v: [0.6, 0.1, 0.0, 0.8] },
    { id: "blanket", name: "Wool blanket", v: [0.0, 0.95, 0.0, 0.3] },
    { id: "watch", name: "GPS watch", v: [0.7, 0.0, 0.8, 0.5] },
    { id: "laptop", name: "Laptop", v: [0.0, 0.2, 0.98, 0.0] },
]

for p in products { vectors_add("products", p.id, p.v, { name: p.name })? }

route GET /like ? { id: str } {
    let p = find(products, (p) => p.id == id) ?? reply 404 "no such product"
    vectors_search("products", p.v, 4, 0.5)?
        | filter((m) => m.id != id)
        | map((m) => { name: m.metadata.name, score: round(m.score, 3) })
}

route GET /search ? { sporty: float = 0.0, cosy: float = 0.0, techy: float = 0.0, outdoorsy: float = 0.0 } =
    vectors_search("products", [sporty, cosy, techy, outdoorsy], 2, -1.0)? | map((m) => m.metadata.name)

route GET /save {
    let n = vectors_save("products", "data/products.vectors.json")?
    vectors_remove("products", "laptop")
    { saved: n, after_remove: vectors_count("products"), loaded: vectors_load("copy", "data/products.vectors.json")? }
}
