// An audit log that publishes one root a day: a receipt that proves an entry is in it, and a proof
// that today's log only added entries after yesterday's.
//
//   quillo run merkle.qwe      then open http://localhost:8080/receipt and http://localhost:8080/grew

use "merkle.qwer"

let LOG = [
    "2026-10-01 alice paid invoice 1041: 120.00",
    "2026-10-01 bob refunded order 88: 15.50",
    "2026-10-02 carol changed her email",
    "2026-10-02 admin granted dave the role auditor",
    "2026-10-03 alice paid invoice 1042: 80.00",
    "2026-10-03 erin closed her account",
    "2026-10-04 frank paid invoice 1043: 310.25",
]

// The receipt for entry 2: whoever holds it checks it against the published root alone.
route GET /receipt {
    let root = merkle_root(LOG)?
    let proof = merkle_proof(LOG, 2)?
    {
        root: root,
        steps: len(proof.path),
        holds: merkle_verify(LOG[2], proof, root)?,
        changed_entry: merkle_verify("2026-10-02 carol changed her name", proof, root)?,
        leaf_alone: merkle_verify_leaf(merkle_leaf(LOG[2]), proof, root)?,
    }
}

// Yesterday 4 entries were published; today 7. The proof shows the first 4 were left alone.
route GET /grew {
    let yesterday = merkle_root(slice(LOG, 0, 4))?
    let today = merkle_root(LOG)?
    let proof = merkle_consistency(LOG, 4)?
    let rewritten = merkle_root(["2026-10-01 alice paid invoice 1041: 12.00"] + slice(LOG, 1, 7))?
    {
        yesterday: yesterday,
        only_added: merkle_verify_consistency(proof, yesterday, today)?,
        history_rewritten: merkle_verify_consistency(merkle_consistency(["2026-10-01 alice paid invoice 1041: 12.00"] + slice(LOG, 1, 7), 4)?, yesterday, rewritten)?,
    }
}

// A file's root over 1 KB pieces, and one piece proved.
route GET /file {
    write_file("data/merkle-demo.txt", join(for i in range(100) => LOG[i % 7], "\n"))
    let f = merkle_file("data/merkle-demo.txt", 1)?
    { root: f.root, chunks: f.chunks, bytes: f.bytes, piece_2: merkle_verify_leaf(f.leaves[2], merkle_proof_of_leaves(f.leaves, 2)?, f.root)?, wrong_piece: merkle_verify_leaf(f.leaves[1], merkle_proof_of_leaves(f.leaves, 2)?, f.root)? }
}
