// What is on this network: an M-SEARCH finds a router and a media renderer, their descriptions
// say what they offer, the router is asked for its public address over SOAP, a fault comes back
// as an error, and NOTIFY messages are heard as devices come and go.
//
//   quillo run ssdp.qwe      then open http://localhost:8080/find and /router
//
// Without SSDP_TO the search goes to the multicast group 239.255.255.250:1900. Devices come from
// your own network: a LOCATION header can name any machine, so check `location_on_sender`.

use "ssdp.qwer"

let TARGET = env("SSDP_TO", "")
let search = TARGET == "" ? { st: "ssdp:all", mx: 1, wait_ms: 1300 } : { st: "ssdp:all", mx: 1, wait_ms: 400, to: TARGET }
let HEARD = int(env("SSDP_LISTEN_PORT", "0"))

route GET /find {
    let all = ssdp_search(search)?
    all | map((d) => [d.st, d.uuid, d.max_age, d.server, d.from, d.location_on_sender])
}

route GET /only-routers {
    let found = ssdp_search({ ...search, st: "urn:schemas-upnp-org:device:InternetGatewayDevice:1" })?
    found | map((d) => d.st)
}

fn router() {
    let all = ssdp_search(search)?
    let d = all | filter((x) => contains(x.st, "InternetGatewayDevice"))
    if len(d) == 0 { reply 503 "no router answered" }
    ssdp_describe(d[0].location, { timeout_ms: 2000 })?
}

route GET /router {
    let r = router()
    let wan = r.devices[0].services[0]
    {
        name: r.name, model: r.model, maker: r.manufacturer, serial: r.serial, udn: r.udn, upnp: r.upnp,
        kinds: r.services | map((s) => s.id),
        sub_device: r.devices[0].name,
        control: wan.control_url,
        icon: r.icons[0].url,
    }
}

route GET /wan {
    let r = router()
    let wan = r.devices[0].services[0]
    let scpd = ssdp_service(wan.description_url, {})?
    {
        actions: scpd.actions | map((a) => a.name),
        out: (scpd.actions | filter((a) => a.name == "GetExternalIPAddress"))[0].out,
        state: scpd.variables,
        ip: ssdp_action(wan.control_url, wan.type, "GetExternalIPAddress", {}, {})?,
        mapped: ssdp_action(wan.control_url, wan.type, "AddPortMapping", { NewExternalPort: 8080, NewProtocol: "TCP", NewPortMappingDescription: "a <test> & more" }, {})?,
        refused: ssdp_action(wan.control_url, wan.type, "DeletePortMapping", { NewExternalPort: 9 }, {}).error,
        unknown: ssdp_action(wan.control_url, wan.type, "Nonsense", {}, {}).error,
    }
}

route GET /broken {
    let base = replace(env("SSDP_HTTP", "http://127.0.0.1:1"), "\n", "")
    {
        missing: ssdp_describe(`${base}/missing.xml`, {}).error,
        not_xml: ssdp_describe(`${base}/garbage.xml`, {}).error,
        wrong_root: ssdp_describe(`${base}/wrong.xml`, {}).error,
        scheme: ssdp_describe("file:///etc/passwd", {}).error,
    }
}

// Devices saying hello and goodbye, heard on a port of our own.
route GET /heard {
    if HEARD == 0 { reply 503 "set SSDP_LISTEN_PORT, or call ssdp_listen with port 1900" }
    let port = ssdp_listen("lan", { port: HEARD })?
    udp.send("127.0.0.1", port, ssdp_notify_text({ nt: "upnp:rootdevice", usn: "uuid:abc::upnp:rootdevice", location: "http://10.0.0.5/d.xml", max_age: 60 })?)
    udp.send("127.0.0.1", port, ssdp_notify_text({ nt: "upnp:rootdevice", usn: "uuid:abc::upnp:rootdevice", event: "byebye" })?)
    let got = ssdp_receive("lan", 10, 500)?
    let more = len(got) < 2 ? ssdp_receive("lan", 10, 500)? : []
    ssdp_stop("lan")?
    (got + more) | map((n) => [n.event, n.uuid, n.max_age, n.location])
}

route GET /messages = {
    search: ssdp_search_text({ st: "upnp:rootdevice", mx: 3 })?,
    bad_mx: ssdp_search_text({ mx: 9 }).error,
    injected: ssdp_search_text({ st: "x\r\nHOST: evil" }).error,
    answer: ssdp_parse(ssdp_response_text({ st: "upnp:rootdevice", usn: "uuid:1::upnp:rootdevice", location: "http://10.0.0.5/d.xml", max_age: 120 })?)?,
    asked: ssdp_parse("M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\nMAN: \"ssdp:discover\"\r\nMX: 2\r\nST: ssdp:all\r\n\r\n")?.kind,
    noise: ssdp_parse("GET / HTTP/1.1\r\n\r\n").error,
}
