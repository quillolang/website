// A shop's colour filter: each product colour gets a name people can search for and screen readers can say.
//
//   quillo run color_names.qwe      then open http://localhost:8080/products

use "color_names.qwer"

let products = [{ name: "Mug", color: "#3b82f6" }, { name: "Scarf", color: "#b91c1c" }, { name: "Tote", color: "rgb(240, 230, 140)" }]

route GET /products = products | map((p) => merge(p, { color_name: color_name(p.color)?.name }))

route GET /name ? { c: str = "#663399" } = { nearest: color_name(c)?, others: color_name_nearest(c, 3)? | map((x) => x.name) }

route GET /hex ? { name: str = "Light Sea Green" } = { name, hex: color_name_hex(name)?, names: len(color_name_list()) }
