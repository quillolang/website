const CATEGORIES: &[&str] = &["search", "ads", "ai_training", "ai_search", "ai_assistant", "social_preview", "seo", "monitoring", "feed_reader", "archiver", "scanner", "headless", "library", "other"];

fn find(ua: &str) -> Option<&'static Bot> {
    let l = ua.to_lowercase();
    BOTS.iter().find(|b| !b.pattern.is_empty() && l.contains(&b.pattern.to_lowercase()))
}

fn describe(b: &Bot) -> Value {
    json!({
        "bot": true,
        "name": b.name,
        "category": b.category,
        "owner": if b.owner.is_empty() { Value::Null } else { json!(b.owner) },
        "robots_token": b.robots,
        "verify": if !b.rdns.is_empty() { "reverse_dns" } else if !b.ranges.is_empty() { "ip_ranges" } else { "none" },
        "rdns_domains": b.rdns,
        "ip_ranges_url": if b.ranges.is_empty() { Value::Null } else { json!(b.ranges) },
    })
}

/// What a User-Agent says about who is visiting: `{ bot, name, category, owner, robots_token, verify, rdns_domains, ip_ranges_url }`.
/// `category` is one of search, ads, ai_training, ai_search, ai_assistant (fetches for a person's question), social_preview, seo,
/// monitoring, feed_reader, archiver, scanner, headless, library or other (an unknown "bot", "crawler" or "spider"). `verify` says
/// how its operator lets you check a visit is real. A browser gives `{ bot: false }`; an empty User-Agent counts as a bot.
pub fn bot_detect(user_agent: &str) -> Value {
    let ua = user_agent.trim();
    if ua.is_empty() {
        return json!({ "bot": true, "name": null, "category": "other", "owner": null, "robots_token": null, "verify": "none", "rdns_domains": [], "ip_ranges_url": null });
    }
    if let Some(b) = find(ua) {
        return describe(b);
    }
    let l = ua.to_lowercase();
    if ["bot", "crawler", "spider", "crawl", "fetcher", "scraper", "slurp"].iter().any(|w| l.contains(w)) {
        let name = ua.split(|c: char| c == ';' || c == '(' || c == ')' || c == ' ').find(|w| { let w = w.to_lowercase(); w.contains("bot") || w.contains("crawl") || w.contains("spider") }).map(|w| w.split('/').next().unwrap_or(w).to_string());
        return json!({ "bot": true, "name": name, "category": "other", "owner": null, "robots_token": name, "verify": "none", "rdns_domains": [], "ip_ranges_url": null });
    }
    json!({ "bot": false })
}

/// Whether a visit that says it is `user_agent` comes from its operator: `ip`'s reverse DNS name must end in one of the operator's
/// domains, and that name must resolve back to `ip` (Google's, Bing's and Apple's documented check). Gives `{ claimed, verified,
/// hostname, reason }`; bots without published domains are never verified this way (compare with their IP ranges instead).
pub fn bot_verify(user_agent: &str, ip: &str) -> Result<Value, String> {
    let addr: std::net::IpAddr = ip.trim().parse().map_err(|_| format!("`{}` is not an IP address", ip))?;
    let Some(b) = find(user_agent) else {
        return Ok(json!({ "claimed": null, "verified": false, "hostname": null, "reason": "the User-Agent names no known bot" }));
    };
    if b.rdns.is_empty() {
        let how = if b.ranges.is_empty() { "its operator publishes no way to check".to_string() } else { format!("check the IP against {}", b.ranges) };
        return Ok(json!({ "claimed": b.name, "verified": false, "hostname": null, "reason": format!("{} cannot be checked by DNS: {}", b.name, how) }));
    }
    let host = match dns_lookup::lookup_addr(&addr) {
        Ok(h) => h.trim_end_matches('.').to_lowercase(),
        Err(_) => return Ok(json!({ "claimed": b.name, "verified": false, "hostname": null, "reason": format!("{} has no reverse DNS name", ip) })),
    };
    if !b.rdns.iter().any(|d| host == *d || host.ends_with(&format!(".{}", d))) {
        return Ok(json!({ "claimed": b.name, "verified": false, "hostname": host, "reason": format!("{} is not under {}: an impostor", host, b.rdns.join(" or ")) }));
    }
    let back = dns_lookup::lookup_host(&host).unwrap_or_default();
    if !back.contains(&addr) {
        return Ok(json!({ "claimed": b.name, "verified": false, "hostname": host, "reason": format!("{} does not resolve back to {}", host, ip) }));
    }
    Ok(json!({ "claimed": b.name, "verified": true, "hostname": host, "reason": "reverse and forward DNS agree" }))
}

/// Every known bot of `category` (empty for all): `[{ name, category, owner, robots_token, ... }]`.
pub fn bot_list(category: &str) -> Vec<Value> {
    BOTS.iter().filter(|b| category.is_empty() || b.category == category).map(describe).collect()
}

/// robots.txt rules that keep out every bot of the `block` categories (say `["ai_training"]`) except those named in `allow`,
/// then let everyone else in. Each token is written once; `sitemap` (a URL, or empty) is added at the end.
pub fn bot_robots(block: Vec<String>, allow: Vec<String>, sitemap: &str) -> Result<String, String> {
    for c in &block {
        if !CATEGORIES.contains(&c.as_str()) {
            return Err(format!("unknown category `{}`: {}", c, CATEGORIES.join(", ")));
        }
    }
    let allowed = |b: &Bot| allow.iter().any(|a| a.eq_ignore_ascii_case(b.name) || a.eq_ignore_ascii_case(b.robots));
    let mut tokens: Vec<&str> = vec![];
    for b in BOTS.iter().filter(|b| block.iter().any(|c| c == b.category) && !allowed(b)) {
        if !tokens.contains(&b.robots) {
            tokens.push(b.robots);
        }
    }
    let mut out = String::new();
    if !tokens.is_empty() {
        for t in &tokens {
            out.push_str(&format!("User-agent: {}\n", t));
        }
        out.push_str("Disallow: /\n\n");
    }
    out.push_str("User-agent: *\nAllow: /\n");
    if !sitemap.trim().is_empty() {
        out.push_str(&format!("\nSitemap: {}\n", sitemap.trim()));
    }
    Ok(out)
}
