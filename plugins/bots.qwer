//! Crawlers and bots told apart by their User-Agent: search engines, AI training and AI answer bots, link previews, SEO tools, monitors, feed readers, scanners and HTTP libraries, with who runs each; a claimed Googlebot or GPTBot verified by reverse and forward DNS; and robots.txt rules that block the categories you choose.
//! version: 1.0.0
//!
//! [dependencies]
//! dns-lookup = "2"

use serde_json::{json, Value};

struct Bot {
    /// Matched case-insensitively in the User-Agent; empty for robots.txt tokens no User-Agent carries.
    pattern: &'static str,
    name: &'static str,
    category: &'static str,
    owner: &'static str,
    /// The product token robots.txt rules name.
    robots: &'static str,
    /// Host names a verified visit's IP reverse-resolves to.
    rdns: &'static [&'static str],
    /// Where the operator publishes its IP ranges.
    ranges: &'static str,
}

const fn b(pattern: &'static str, name: &'static str, category: &'static str, owner: &'static str, robots: &'static str, rdns: &'static [&'static str], ranges: &'static str) -> Bot {
    Bot { pattern, name, category, owner, robots, rdns, ranges }
}

