// Supplier onboarding for a marketplace: each supplier's tax number checked by its country's
// rules before the first payout, and what the number says about them shown.
//
//   quillo run tax_ids.qwe      then open http://localhost:8080/suppliers and http://localhost:8080/check/AU/ABN/51%20824%20753%20556

use "tax_ids.qwer"

route GET /check/:country/:kind/*rest = tax_id_check(country, kind, rest)

let SUPPLIERS = [
    { name: "Pacific Teas", country: "AU", kind: "ABN", number: "51 824 753 556" },
    { name: "Ganesh Exports", country: "IN", kind: "GSTIN", number: "27AAPFU0939F1ZV" },
    { name: "Café do Sul", country: "BR", kind: "CNPJ", number: "11.222.333/0001-81" },
    { name: "Andes Coffee", country: "CO", kind: "NIT", number: "890903938-8" },
    { name: "Hangzhou Silk", country: "CN", kind: "USCC", number: "91350100M000100Y43" },
    { name: "Seoul Ceramics", country: "KR", kind: "BRN", number: "220-81-62517" },
    { name: "Typo Ltd", country: "AU", kind: "ABN", number: "51 824 753 557" },
    { name: "Acme Inc", country: "US", kind: "EIN", number: "07-1234567" },
]

route GET /suppliers = SUPPLIERS | map((s) => { let r = tax_id_check(s.country, s.kind, s.number); `${s.name}: ${r.valid ? r.formatted + (r.holder != null ? " (" + r.holder + ")" : "") : r.error}` })

route GET /guess = {
    nine_digits: tax_id_guess("123456782") | map((g) => `${g.country} ${g.type}`),
    india: tax_id_check("IN", "GSTIN", "27AAPFU0939F1ZV"),
    kinds: len(tax_id_kinds()),
}
