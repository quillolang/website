// A support ticket cleaned before it is logged or sent to an outside service.
//
//   quillo run pii_redact.qwe      then open http://localhost:8080/ticket

use "pii_redact.qwer"

let TICKET = "Hi, I'm Ada (ada.lovelace@example.com, +44 20 7946 0958). My card 4242 4242 4242 4242 was charged twice for order 2026-114; refund to NL91 ABNA 0417 1643 00 please. Seen from 203.0.113.77."

route GET /ticket = { logged: pii_redact(TICKET, [])?, support_sees: pii_mask(TICKET)? }

route GET /found = pii_find(TICKET)? | map((f) => { kind: f.kind, text: f.text })

route GET /emails_only = { text: pii_redact(TICKET, ["email"])? }
