// A store's back office through Shopify's Admin GraphQL API: a read with its cost shown, a product
// made, a list walked by cursor with the plugin keeping within the shop's bucket, and the webhook
// and OAuth checks.
//
//   SHOPIFY_SHOP=my-shop.myshopify.com SHOPIFY_ACCESS_TOKEN=... SHOPIFY_CLIENT_SECRET=... quillo run shopify.qwe
//   then open http://localhost:8080/shop, /products, /create, /hook-check, /oauth and /failures
//
// SHOPIFY_API_URL reaches a test server, and SHOPIFY_API_VERSION picks the API's version.

use "shopify.qwer"

route GET /shop {
    let r = shopify_graphql("{ shop { name currencyCode } }", null, {})?
    { name: r.data.shop.name, currency: r.data.shop.currencyCode, spent: r.cost.actual, left: r.cost.available, rate: r.cost.restore_rate }
}

let PRODUCTS = "query ($cursor: String) { products(first: 50, after: $cursor) { nodes { id title } pageInfo { hasNextPage endCursor } } }"

// Each page costs 60 of the bucket's 100, so the walk has to pause: the plugin does that.
route GET /products {
    let all = shopify_all(PRODUCTS, null, "products", { cost: 60 })?
    { total: len(all), first: all[0].title, number: shopify_id(all[0].id)?, capped: len(shopify_all(PRODUCTS, null, "products", { cost: 60, max_items: 70 })?) }
}

// With nothing said of a query's cost the plugin cannot pause first: Shopify answers THROTTLED, and
// it waits as long as the bucket says, then asks again.
route GET /burst {
    let walks = map(range(0, 3), (i) => len(shopify_all(PRODUCTS, null, "products", { cost: 1 })?))
    { walks: walks }
}

let CREATE = "mutation ($input: ProductCreateInput!) { productCreate(product: $input) { product { id title } userErrors { field message } } }"

route GET /create {
    let made = shopify_mutate(CREATE, { input: { title: "Blue mug" } }, {})?
    { id: made.product.id, title: made.product.title, refused: shopify_mutate(CREATE, { input: { title: "" } }, {}).error }
}

// Worked out outside the plugin.
let BODY = "{\"id\":1001,\"name\":\"#1001\"}"
let HMAC = "ZgCi1w+8byFqvK/1Xuk8JKKpazdbtAaxep1TSm7VS5A="

route GET /hook-check {
    let headers = { "X-Shopify-Hmac-Sha256": HMAC, "X-Shopify-Topic": "orders/create", "X-Shopify-Shop-Domain": "quillo-demo.myshopify.com", "X-Shopify-Webhook-Id": "b54557e4" }
    let hook = shopify_webhook(headers, BODY, "shpss-test")?
    {
        good: shopify_webhook_ok(BODY, HMAC, "shpss-test")?,
        tampered: shopify_webhook_ok(BODY + " ", HMAC, "shpss-test")?,
        wrong: shopify_webhook(headers, BODY, "other").error,
        unsigned: shopify_webhook({}, BODY, "shpss-test").error,
        topic: hook.topic, shop: hook.shop, order: hook.payload.name,
    }
}

route POST /shopify/hook {
    let hook = shopify_webhook(request.headers, request.body, "")
    if is_err(hook) { reply 401 hook.error }
    { topic: hook.topic }
}

let CALLBACK = { code: "0907a61c0c8d55e99db179b68161bc00", host: "abc", shop: "quillo-demo.myshopify.com", state: "nonce1", timestamp: "1790000000", hmac: "c0b6f5a54cad5593ab538ea94b888469a71531a9173d911daefaf1fd855bd3f6" }

route GET /oauth = {
    good: shopify_oauth_ok(CALLBACK, "shpss-test")?,
    tampered: shopify_oauth_ok({ code: "0907a61c0c8d55e99db179b68161bc00", host: "abc", shop: "evil.example", state: "nonce1", timestamp: "1790000000", hmac: CALLBACK.hmac }, "shpss-test")?,
    url: shopify_oauth_url("quillo-demo.myshopify.com", "client1", ["read_orders", "write_products"], "https://example.com/cb", "nonce1")?,
    bad_shop: shopify_oauth_url("evil.com/x.myshopify.com", "c", [], "u", "s").error,
    token: shopify_oauth_token("quillo-demo.myshopify.com", "good-code", "client1", "shpss-test", {})?.access_token,
    bad_code: shopify_oauth_token("quillo-demo.myshopify.com", "used", "client1", "shpss-test", {}).error,
}

route GET /failures = {
    syntax: shopify_graphql("{ nope }", null, {}).error,
    bad_token: shopify_graphql("{ shop { name } }", null, { token: "wrong" }).error,
    no_shop: shopify_graphql("{ shop { name } }", null, { base_url: "", shop: "x.example" }).error,
    not_gid: shopify_id("Product").error,
    gid: shopify_gid("Product", 123),
    no_info: shopify_all("{ products(first: 1) { nodes { id } } }", null, "products", {}).error,
}
