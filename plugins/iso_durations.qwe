// Video lengths from an API ("PT1H2M30S") shown as minutes, and subscription renewals added to dates.
//
//   quillo run iso_durations.qwe      then open http://localhost:8080/videos

use "iso_durations.qwer"

let videos = [{ title: "Intro", length: "PT4M13S" }, { title: "Deep dive", length: "PT1H2M30S" }, { title: "Live stream", length: "P1DT2H" }]

route GET /videos = videos | map((v) => { title: v.title, seconds: duration_seconds(v.length)?, back: duration_format(duration_seconds(v.length)?)? })

route GET /renew ? { from: str = "2026-01-31", every: str = "P1M" } = { next: duration_add(from, every)?, parts: duration_parse(every)? }

route GET /meeting = { ends: duration_add("2026-11-20T09:30:00+01:00", "PT1H45M")?, year_later: duration_add("2028-02-29", "P1Y")? }
