//! The numbers that identify phones and SIM cards: IMEI and IMEISV read (type allocation code, serial, check digit) and made, CDMA MEIDs converted to decimal and their pseudo-ESN worked out, SIM ICCIDs checked with their country and issuer, and IMSIs split into the network's country and operator codes.
//! version: 1.0.0
//!
//! [dependencies]
//! sha1 = "0.10"
//! serde_json = { version = "1", features = ["preserve_order"] }

use serde_json::{json, Value};
use sha1::{Digest, Sha1};

fn clean(s: &str) -> String {
    s.chars().filter(|c| c.is_ascii_alphanumeric()).map(|c| c.to_ascii_uppercase()).collect()
}

/// The Luhn check digit in `base` (10 for IMEI and ICCID, 16 for MEID) for `body`.
fn luhn_digit(body: &str, base: u32) -> Option<u32> {
    let mut sum = 0;
    for (i, c) in body.chars().rev().enumerate() {
        let v = c.to_digit(base)?;
        let x = if i % 2 == 0 { v * 2 } else { v };
        sum += x / base + x % base;
    }
    Some((base - sum % base) % base)
}

