/// Countries whose operators have three-digit network codes.
const THREE_DIGIT_MNC: &[&str] = &["302", "310", "311", "312", "313", "314", "315", "316", "334", "338", "344", "350", "365", "405", "708", "722", "732"];

/// Country calling codes for ICCIDs (ITU E.164), longest first when matching.
const CALLING: &[(&str, &str)] = &[
    ("1", "United States or Canada"), ("7", "Russia or Kazakhstan"), ("20", "Egypt"), ("27", "South Africa"), ("30", "Greece"), ("31", "Netherlands"), ("32", "Belgium"),
    ("33", "France"), ("34", "Spain"), ("36", "Hungary"), ("39", "Italy"), ("40", "Romania"), ("41", "Switzerland"), ("43", "Austria"), ("44", "United Kingdom"),
    ("45", "Denmark"), ("46", "Sweden"), ("47", "Norway"), ("48", "Poland"), ("49", "Germany"), ("51", "Peru"), ("52", "Mexico"), ("54", "Argentina"), ("55", "Brazil"),
    ("56", "Chile"), ("57", "Colombia"), ("60", "Malaysia"), ("61", "Australia"), ("62", "Indonesia"), ("63", "Philippines"), ("64", "New Zealand"), ("65", "Singapore"),
    ("66", "Thailand"), ("81", "Japan"), ("82", "South Korea"), ("84", "Vietnam"), ("86", "China"), ("90", "Turkey"), ("91", "India"), ("92", "Pakistan"), ("234", "Nigeria"),
    ("254", "Kenya"), ("351", "Portugal"), ("353", "Ireland"), ("358", "Finland"), ("380", "Ukraine"), ("852", "Hong Kong"), ("886", "Taiwan"), ("966", "Saudi Arabia"),
    ("971", "United Arab Emirates"), ("972", "Israel"), ("882", "International networks"), ("883", "International networks"),
];

/// An IMEI (15 digits) or IMEISV (16) read: `{ valid, kind, imei, tac, serial, check_digit, svn, formatted, error }`. `tac`, the type
/// allocation code, names the phone model in the GSMA's database; an IMEISV has a software version (`svn`) in place of the check digit.
pub fn imei_parse(text: &str) -> Value {
    let s = clean(text);
    if !s.chars().all(|c| c.is_ascii_digit()) {
        return json!({ "valid": false, "error": "an IMEI has only digits" });
    }
    match s.len() {
        15 => {
            let check = luhn_digit(&s[..14], 10);
            if check != s[14..].parse().ok() {
                return json!({ "valid": false, "kind": "IMEI", "error": "the check digit does not match: a typo" });
            }
            json!({ "valid": true, "kind": "IMEI", "imei": s, "tac": &s[..8], "serial": &s[8..14], "check_digit": &s[14..], "svn": null, "formatted": format!("{}-{}-{}-{}", &s[..2], &s[2..8], &s[8..14], &s[14..]), "error": null })
        }
        16 => {
            let imei = format!("{}{}", &s[..14], luhn_digit(&s[..14], 10).unwrap_or(0));
            json!({ "valid": true, "kind": "IMEISV", "imei": imei, "tac": &s[..8], "serial": &s[8..14], "check_digit": null, "svn": &s[14..], "formatted": format!("{}-{}-{}-{}", &s[..2], &s[2..8], &s[8..14], &s[14..]), "error": null })
        }
        14 => json!({ "valid": false, "kind": "IMEI", "error": format!("14 digits: the check digit is missing; with it, {}", format!("{}{}", s, luhn_digit(&s, 10).unwrap_or(0))) }),
        n => json!({ "valid": false, "error": format!("an IMEI has 15 digits (16 for an IMEISV), not {}", n) }),
    }
}

/// An IMEI from a type allocation code (8 digits) and a serial (6), with its check digit: for test data and device labels.
pub fn imei_make(tac: &str, serial: &str) -> Result<String, String> {
    let body = format!("{}{}", clean(tac), clean(serial));
    if body.len() != 14 || !body.chars().all(|c| c.is_ascii_digit()) {
        return Err("a TAC is 8 digits and a serial 6".into());
    }
    Ok(format!("{}{}", body, luhn_digit(&body, 10).unwrap_or(0)))
}

/// A CDMA MEID read, hex (14 digits, maybe with its check digit) or decimal (18 digits): `{ valid, hex, decimal, manufacturer,
/// serial, check_digit, pesn }`. `pesn` is the pseudo-ESN made from it (80 and the last 24 bits of its SHA-1), which older systems ask for.
pub fn meid_parse(text: &str) -> Value {
    let s = clean(text);
    let hex = match s.len() {
        14 | 15 if s.chars().all(|c| c.is_ascii_hexdigit()) => s[..14].to_string(),
        18 if s.chars().all(|c| c.is_ascii_digit()) => {
            let (a, b) = (s[..10].parse::<u64>().unwrap_or(u64::MAX), s[10..].parse::<u64>().unwrap_or(u64::MAX));
            if a > 0xFFFF_FFFF || b > 0xFF_FFFF {
                return json!({ "valid": false, "error": "the decimal MEID's parts are out of range" });
            }
            format!("{:08X}{:06X}", a, b)
        }
        _ => return json!({ "valid": false, "error": "a MEID is 14 hex digits (15 with its check digit) or 18 decimal digits" }),
    };
    let check = luhn_digit(&hex, 16).map(|c| format!("{:X}", c)).unwrap_or_default();
    if s.len() == 15 && s[14..] != check {
        return json!({ "valid": false, "error": "the check digit does not match: a typo" });
    }
    let bytes: Vec<u8> = (0..7).map(|i| u8::from_str_radix(&hex[i * 2..i * 2 + 2], 16).unwrap_or(0)).collect();
    let h = Sha1::digest(&bytes);
    let pesn = format!("80{:02X}{:02X}{:02X}", h[17], h[18], h[19]);
    let decimal = format!("{:010}{:08}", u64::from_str_radix(&hex[..8], 16).unwrap_or(0), u64::from_str_radix(&hex[8..], 16).unwrap_or(0));
    json!({ "valid": true, "hex": hex, "decimal": decimal, "manufacturer": &hex[..8], "serial": &hex[8..], "check_digit": check, "pesn": pesn, "error": null })
}

/// A SIM card's ICCID (18 to 20 digits, starting 89) read: `{ valid, iccid, country_code, country, issuer_and_account, check_digit, error }`,
/// checked by its Luhn digit when it has one (19 or 20 digits). The country is the calling code's (+63 the Philippines).
pub fn iccid_parse(text: &str) -> Value {
    let s = clean(text.trim_end_matches(['F', 'f']));
    if !s.chars().all(|c| c.is_ascii_digit()) || !(18..=20).contains(&s.len()) {
        return json!({ "valid": false, "error": "an ICCID has 18 to 20 digits" });
    }
    if !s.starts_with("89") {
        return json!({ "valid": false, "error": "an ICCID starts with 89 (telecommunications)" });
    }
    if s.len() >= 19 {
        let (body, last) = s.split_at(s.len() - 1);
        if luhn_digit(body, 10) != last.parse().ok() {
            return json!({ "valid": false, "error": "the check digit does not match: a typo" });
        }
    }
    let rest = &s[2..];
    let (cc, country) = [3usize, 2, 1].iter().find_map(|n| CALLING.iter().find(|(c, _)| c.len() == *n && rest.starts_with(c)).map(|(c, name)| (c.to_string(), name.to_string()))).unwrap_or_default();
    json!({
        "valid": true,
        "iccid": s,
        "country_code": if cc.is_empty() { Value::Null } else { json!(format!("+{}", cc)) },
        "country": if country.is_empty() { Value::Null } else { json!(country) },
        "issuer_and_account": &rest[cc.len()..s.len() - 2 - if s.len() >= 19 { 1 } else { 0 }],
        "check_digit": if s.len() >= 19 { json!(&s[s.len() - 1..]) } else { Value::Null },
        "error": null,
    })
}

/// An IMSI (the subscriber number on a SIM, 15 digits) split: `{ valid, mcc, mnc, msin, country }`. The network code has three
/// digits in North America and a few other countries, two elsewhere.
pub fn imsi_parse(text: &str) -> Value {
    let s = clean(text);
    if !s.chars().all(|c| c.is_ascii_digit()) || !(14..=15).contains(&s.len()) {
        return json!({ "valid": false, "error": "an IMSI has 15 digits (14 on some old networks)" });
    }
    let mcc = &s[..3];
    let Some((_, country)) = MCC.iter().find(|(c, _)| *c == mcc) else {
        return json!({ "valid": false, "error": format!("{} is not a mobile country code in use", mcc) });
    };
    let mnc_len = if THREE_DIGIT_MNC.contains(&mcc) { 3 } else { 2 };
    json!({ "valid": true, "mcc": mcc, "mnc": &s[3..3 + mnc_len], "msin": &s[3 + mnc_len..], "country": country, "error": null })
}
