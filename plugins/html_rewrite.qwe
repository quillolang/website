// A blog post's HTML prepared for its RSS feed and for the page: links made absolute, images
// lazy, outside links marked, scripts and trackers removed.
//
//   quillo run html_rewrite.qwe      then open http://localhost:8080/feed-html

use "html_rewrite.qwer"

let POST = `<article>
<p>Read <a href="/docs/routes">the routes guide</a> or <a href="https://github.com/quillolang">the code</a>.</p>
<img src="../img/cover.jpg" srcset="../img/cover.jpg 1x, ../img/cover@2x.jpg 2x" alt="Cover">
<script src="/js/tracker.js"></script>
<p class="ad">Buy now!</p>
<p>Questions? <a href="#comments">Comment</a> or <a href="mailto:ada@example.com">mail me</a>.</p>
</article>`

route GET /feed-html {
    let clean = html_remove(html_remove(POST, "script", false)?, ".ad", false)?
    respond(200, html_absolute_links(clean, "https://blog.example.com/posts/2026/hello")?, { "content-type": "text/plain; charset=utf-8" })
}

route GET /page = respond(200, html_rewrite(html_external_links(POST, "blog.example.com")?, [
    { selector: "img", set: { loading: "lazy", decoding: "async" } },
    { selector: "script, .ad", remove: true },
    { selector: "article", append_html: "<footer>Thanks for reading</footer>" },
])?, { "content-type": "text/plain; charset=utf-8" })

route GET /bad = { error: html_remove(POST, "p:nth-child(2n+1 x", false).error }
