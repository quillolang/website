// A family tree from a GEDCOM file: who is in it, how they are related, what is broken, and the
// file written back. gedcom_sample.ged is 5.5.1, gedcom_v7_sample.ged is 7; both made up.
//
//   quillo run gedcom.qwe      then open http://localhost:8080/family, /person/I3, /tree, /related, /dates, /v7, /roundtrip and /broken

use "gedcom.qwer"

let TEXT = read_file("gedcom_sample.ged")

route GET /family {
    let g = gedcom_read_file("gedcom_sample.ged")?
    {
        version: g.version, encoding: g.encoding, counts: g.counts, note: g.note, problems: g.problems,
        people: g.individuals | map((p) => `${p.id} ${p.name} ${p.sex}`),
        married: g.families[0].marriage.date.text,
    }
}

route GET /person/:id = gedcom_person(TEXT, id)?

route GET /tree = {
    up: gedcom_ancestors(TEXT, "I6", 0)?,
    one_up: gedcom_ancestors(TEXT, "@I6@", 1)? | map((p) => p.name),
    down: gedcom_descendants(TEXT, "I1", 0)? | map((p) => `${p.generation} ${p.name}`),
}

route GET /related = {
    parent: gedcom_relationship(TEXT, "I1", "I3")?.relation,
    child: gedcom_relationship(TEXT, "I3", "I1")?.relation,
    grand: gedcom_relationship(TEXT, "I1", "I6")?.relation,
    sibling: gedcom_relationship(TEXT, "I3", "I4")?,
    cousin: gedcom_relationship(TEXT, "I6", "I7")?,
    uncle: gedcom_relationship(TEXT, "I3", "I7")?.relation,
    none: gedcom_relationship(TEXT, "I5", "I2")?,
}

route GET /dates = {
    exact: gedcom_date("3 MAR 1888"),
    about: gedcom_date("ABT 1820"),
    between: gedcom_date("BET 1822 AND 1825"),
    period: gedcom_date("FROM 1880 TO 1881"),
    julian: gedcom_date("@#DJULIAN@ 2 FEB 1852"),
    dual: gedcom_date("11 FEB 1731/32").year,
    bc: gedcom_date("44 B.C.").year,
    hebrew: gedcom_date("@#DHEBREW@ 2 TVT 5758"),
    words: gedcom_date("(about the time of the flood)"),
    interpreted: gedcom_date("INT 1900 (from the census)"),
}

route GET /v7 {
    let g = gedcom_read_file("gedcom_v7_sample.ged")?
    let back = gedcom_write(gedcom_records(read_file("gedcom_v7_sample.ged"))?)?
    {
        version: g.version, note: g.note, birth: g.individuals[0].birth.date, death: g.individuals[0].death.date.calendar,
        far_back: g.individuals[1].birth.date.year, to: g.individuals[1].birth.date.to.year,
        problems: g.problems, written: back == read_file("gedcom_v7_sample.ged"),
    }
}

// Read and written back, the file comes out the same; edited, the edit is there.
route GET /roundtrip {
    let records = gedcom_records(TEXT)?
    let out = gedcom_write(records)?
    let again = gedcom_records(out)?
    let long = repeat("word ", 100)
    let edited = gedcom_write([{ tag: "HEAD", children: [{ tag: "GEDC", children: [{ tag: "VERS", value: "5.5.1" }] }] }, { xref: "N1", tag: "NOTE", value: long + "\nmail a@b" }])?
    let lines = split(edited, "\n")
    {
        same: len(records) == len(again) && json.stringify(records) == json.stringify(again),
        escaped: contains(out, "ada@@example.org"),
        continued: slice(lines[3], 0, 6), longest: max(lines | map((l) => len(l))),
        last: lines[len(lines) - 3], back: len(gedcom_records(edited)?[1].value),
    }
}

route GET /broken {
    let bad = replace(replace(TEXT, "1 CHIL @I4@\n", "1 CHIL @I9@\n"), "0 TRLR\n", "")
    {
        problems: gedcom_check(bad)?.problems,
        clean: gedcom_check(TEXT)?,
        not_gedcom: gedcom_parse("hello").error,
        jump: gedcom_parse("0 HEAD\n2 VERS 5.5.1\n0 TRLR\n").error,
        nobody: gedcom_person(TEXT, "I99").error,
    }
}
