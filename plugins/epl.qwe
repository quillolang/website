// A parcel desk's labels on an EPL2 printer (a Zebra LP 2844 or a GK420d in EPL mode): a
// 4 × 3 inch product label with an EAN-13, a Code 128 and a QR code, and a pallet's carton labels.
//
//   quillo run epl.qwe      then open http://localhost:8080/label
//   PRINTER_HOST=192.168.1.61 quillo run epl.qwe      and http://localhost:8080/print

use "epl.qwer"

let OPTIONS = { dpi: 203, width: 101.6, height: 76.2, gap: 3, speed: 3, density: 10 }

fn product(p) = [
    { image: "epl_sample.png", x: 4, y: 3, width: 30 },
    { text: p.name, x: 38, y: 4, size: 5 },
    { text: `Ref. ${p.sku} — ${p.weight}`, x: 38, y: 12, size: 3 },
    { line: true, x: 3, y: 18, width: 95, thickness: 0.4 },
    { barcode: "ean13", data: p.ean, x: 6, y: 22, height: 18, module: 2 },
    { barcode: "code128", data: p.sku, x: 6, y: 50, height: 12, module: 2 },
    { barcode: "qr", data: `https://shop.example/p/${p.sku}`, x: 72, y: 24, magnification: 5 },
    { box: true, x: 2, y: 2, width: 97, height: 72, thickness: 0.5 },
]

let ITEM = { name: "Crème de marrons", sku: "CM-250-FR", weight: "250 g", ean: "3017620422003" }

route GET /label = respond(200, epl_label(product(ITEM), OPTIONS)?, { "content-type": "text/plain; charset=utf-8" })

route GET /cartons = epl_label([
    { text: "CARTON 3 / 12", x: 4, y: 4, font: 4, multiply: 2 },
    { text: "\"Fragile\" \\ this way up", x: 4, y: 20, font: 2, reverse: true },
    { barcode: "code39", data: "PAL-0042-03", x: 4, y: 32, height: 15 },
], merge(OPTIONS, { quantity: 1, copies: 2 }))

route GET /saved = { bytes: epl_write(product(ITEM), OPTIONS, "data/label.epl")?, base64_start: slice(epl_job(product(ITEM), OPTIONS)?, 0, 12), setup: epl_setup({ width: 101.6, height: 76.2, media: "mark", speed: 2, density: 12 })? }

route GET /print {
    let host = env("PRINTER_HOST", null) ?? reply 503 "set PRINTER_HOST to the printer's address (host or host:port)"
    { sent: epl_send(product(ITEM), OPTIONS, host, 5000)? }
}
