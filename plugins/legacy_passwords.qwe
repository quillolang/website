// Signing in users moved from Django, Flask and WordPress, and moving each to Argon2 at their first sign-in.
//
//   quillo run legacy_passwords.qwe      then open http://localhost:8080/login

use "legacy_passwords.qwer"

// Users imported from the old apps; every one of them has the password "hunter22".
let imported = {
    "ada@example.com": "pbkdf2_sha256$600000$Qx7rM2pLk9sTz4wB$lFgxcYiyCVJqMgHrH6ehgm+JAuCPG6MOEBJDeQwz6eo=",
    "grace@example.com": "pbkdf2:sha256:600000$n8VbXq2Lr5Tz$0c772f8236ccfd7d2cd4fcb43ce9f973c2f9cba33acf80aa69be88bc950f1be9",
    "linus@example.com": "scrypt:32768:8:1$Hk3sPq9WmZ1aLx7c$b1893f17c3be43489677c72e05b1eaf0da5184000b94a7dbe9c558c5c4b1f29b94ad2713a5db6ab5c6b6d439fef6996a791ab0c628b89f84190cec6cb011b48b",
    "margaret@example.com": "$P$BaB3dE5gH.mccMVJmlyp7r9PZLhjXx1",
    "alan@example.com": "$wp$2y$10$kyAYiLv5VJOlGNaouYMg5.//TjnpCDzR9BdWyv2j8NYFSWidfXCiG",
}

fn sign_in(email: str, password: str) {
    let stored = imported[email] ?? null
    if stored == null { return { ok: false } }
    if starts_with(stored, "$argon2id$") { return { ok: crypto.verify_password(password, stored) } }
    if !legacy_verify(password, stored)? { return { ok: false, from: legacy_kind(stored) } }
    // Right: from now on keep an Argon2 hash (here only returned; a real app writes it to the users table).
    { ok: true, from: legacy_kind(stored), rehashed: starts_with(crypto.hash_password(password), "$argon2id$") }
}

route GET /login = keys(imported) | map((email) => { email, ...sign_in(email, "hunter22") })

route GET /wrong = keys(imported) | map((email) => sign_in(email, "hunter2").ok)

route GET /make = { hash: legacy_django_hash("hunter22", "Qx7rM2pLk9sTz4wB", 600000)? }
