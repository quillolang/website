// A boat tracker's log, uploaded from its GPS: the fixes on a map line, and one sentence read
// as it comes from a serial port.
//
//   quillo run nmea.qwe      then open http://localhost:8080/track

use "nmea.qwer"

route GET /track {
    let t = nmea_fixes(read_file("nmea_sample.log")?)?
    { points: len(t.fixes), skipped: t.skipped, last: t.fixes[len(t.fixes) - 1] }
}

route GET /line ? { s: str = "$GPGGA,123519,4807.038,N,01131.000,E,1,08,0.9,545.4,M,46.9,M,,*47" } = nmea_parse(s)?

route GET /make = { sentence: nmea_sentence("GPGLL,4916.45,N,12311.12,W,225444,A") }
