// An access log packed with LZ4 before it goes to the archive, and text both ways.
//
//   quillo run lz4.qwe      then open http://localhost:8080/pack

use "lz4.qwer"

route GET /pack {
    let lines = for i in range(5000) => `2026-10-29T10:00:${i % 60} GET /menu 200 ${i % 7}ms`
    write_file("data/lz4-access.log", join(lines, "\n"))
    let size = lz4_file("data/lz4-access.log", "data/lz4-access.log.lz4")?
    let packed = lz4_text("hello, hello, hello, hello")?
    {
        log_bytes: len(read_file("data/lz4-access.log")),
        lz4_bytes: size,
        is_lz4: lz4_is_frame("data/lz4-access.log.lz4")?,
        log_is_lz4: lz4_is_frame("data/lz4-access.log")?,
        unpacked_bytes: unlz4_file("data/lz4-access.log.lz4", "data/lz4-access.copy.log")?,
        back: unlz4_text(packed)?,
    }
}

route GET /broken = { error: unlz4_text("aGVsbG8=").error }
