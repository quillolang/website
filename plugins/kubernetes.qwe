// A status page for a Kubernetes cluster: pods as kubectl shows them, deployments and their rollouts,
// scaling, logs, and label selectors written as maps.
//
//   KUBECONFIG=~/.kube/config quillo run kubernetes.qwe
//   then open /context, /pods, /selectors, /deployments, /scale, /logs, /others and /broken
//
// In a pod it uses the service account's token by itself. KUBERNETES_CONTEXT picks a context.

use "kubernetes.qwer"

route GET /context = k8s_context()?

route GET /pods {
    let all = k8s_pods("shop", null)?
    let web = k8s_pod("shop", "web-1")?
    { names: all | map((p) => p.name), web: web, states: all | map((p) => p.state) | unique, none: k8s_pod("shop", "nothing")?, everywhere: len(k8s_pods("*", null)?) }
}

// 25 pods read 10 to a page.
route GET /many {
    let r = k8s_list("pods", "big", { page: 10 })?
    let cut = k8s_list("pods", "big", { page: 10, max: 15 })?
    { total: len(r.items), pages: r.pages, complete: r.complete, cut: len(cut.items), cut_complete: cut.complete, stale: k8s_list("pods", "stale", { page: 1 }).error }
}

route GET /selectors = {
    text: k8s_selector({ app: "web", tier: ["front", "edge"], canary: false, env: { not: "dev" }, track: { not: ["a", "b"] }, ready: true })?,
    web: k8s_pods("shop", { selector: { app: "web" } })? | map((p) => p.name),
    among: k8s_pods("shop", { selector: { app: ["web", "db"], tier: { not: "edge" } } })? | map((p) => p.name),
    lacking: k8s_pods("shop", { selector: { canary: false, app: "web" } })? | map((p) => p.name),
    on_node: k8s_pods("shop", { fields: "spec.nodeName=node-b" })? | map((p) => p.name),
    injected: k8s_selector({ app: "web,admin=true" }).error,
}

route GET /deployments {
    let all = k8s_deployments("shop", null)?
    { all: all, one: k8s_deployment("shop", "web")?.images, none: k8s_deployment("shop", "nothing")? }
}

route GET /scale {
    let s = k8s_scale("shop", "web", 5)?
    let d = k8s_deployment("shop", "web")?
    let restarted = k8s_rollout_restart("shop", "web", "2026-11-01T10:00:00Z")?
    let done = k8s_deployment("shop", "web")?.done
    {
        was: s.was,
        now: s.replicas,
        replicas: d.replicas,
        restarted: restarted,
        done: done,
        annotated: k8s_get("deployments", "shop", "web")?.spec.template.metadata.annotations["kubectl.kubernetes.io/restartedAt"],
        negative: k8s_scale("shop", "web", -1).error,
        missing: k8s_scale("shop", "nothing", 1).error,
    }
}

route GET /logs = {
    all: k8s_logs("shop", "web-1", null)?,
    tail: k8s_logs("shop", "web-1", { tail: 1 })?,
    two: k8s_logs("shop", "pair", null).error,
    sidecar: k8s_logs("shop", "pair", { container: "proxy", previous: true })?,
}

// Each sign-in the kubeconfig offers, and the account a pod has.
route GET /others {
    let reader = k8s_use_context("reader")?
    let names = k8s_pods("", null)? | map((p) => p.name)
    let denied = k8s_pods("kube-system", null).error
    let pod = k8s_use_context("in-cluster")?
    let there = len(k8s_pods("shop", null)?)
    k8s_use_context("")?
    { reader: reader, names: names, denied: denied, pod: pod.auth, namespace: pod.namespace, there: there, unknown: k8s_use_context("nope").error, back: k8s_use_context("")?.context }
}

route GET /broken {
    let deleted = k8s_delete("pods", "shop", "db-0")?
    {
        deleted: deleted,
        again: k8s_delete("pods", "shop", "db-0")?,
        kind: k8s_list("wibbles", "", null).error,
        raw: k8s_request("GET", "/api/v1/namespaces/shop/pods/web-1", null)?.metadata.name,
    }
}
