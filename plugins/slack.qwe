// New orders announced in the team's Slack channel with Block Kit: who ordered, what, and a
// button to the order.
//
//   SLACK_WEBHOOK_URL=https://hooks.slack.com/services/... quillo run slack.qwe      then open http://localhost:8080/notify
//   (or SLACK_BOT_TOKEN=xoxb-... and http://localhost:8080/post)

use "slack.qwer"

let WEBHOOK = env("SLACK_WEBHOOK_URL", null) ?? `${env("SINK_URL", "")}/services/T000/B000/XXXX`

let ORDER = { id: "A-1042", customer: "Ada <script>", total: "€39.90", items: 3 }

fn order_blocks(o) = slack_blocks([
    { header: `New order ${o.id}` },
    { text: `*${slack_escape(o.customer)}* ordered ${o.items} items.` },
    { fields: { Total: o.total, Pickup: "Today, 17:00" } },
    { buttons: [{ text: "Open order", url: `https://shop.example.com/admin/orders/${o.id}`, style: "primary" }] },
    { divider: true },
    { context: "Sent by the shop" },
])

route GET /notify = slack_webhook(WEBHOOK, `New order ${ORDER.id} (${ORDER.total})`, order_blocks(ORDER)?)?

route GET /post = slack_post("", env("SLACK_CHANNEL", "#orders"), `New order ${ORDER.id}`, order_blocks(ORDER)?, { unfurl_links: false })?

route GET /blocks = order_blocks(ORDER)?
