// A newsletter list in Mailchimp: a sign-up that can run twice, a batch import with its bad rows
// reported, tags, unsubscribes, and the webhook that tells you who left.
//
//   MAILCHIMP_API_KEY=abc123-us21 MAILCHIMP_LIST_ID=... MAILCHIMP_WEBHOOK_SECRET=... quillo run mailchimp.qwe
//   then open http://localhost:8080/member, /batch, /tags, /hook-check and /failures
//
// The key's ending picks the data centre. MAILCHIMP_API_URL reaches a test server.

use "mailchimp.qwer"

let LIST = env("MAILCHIMP_LIST_ID", "")
let SECRET = env("MAILCHIMP_WEBHOOK_SECRET", "")

route GET /member {
    let m = mailchimp_upsert(LIST, "  Ada@Example.COM ", { status_if_new: "subscribed", merge_fields: { FNAME: "Ada" } })?
    let again = mailchimp_upsert(LIST, "ada@example.com", { merge_fields: { LNAME: "Lovelace" } })?
    mailchimp_unsubscribe(LIST, "ADA@example.com", {})?
    let left = mailchimp_status(LIST, "ada@example.com", {})?
    {
        id: m.id,
        hash: mailchimp_hash("  Ada@Example.COM "),
        same_member: m.id == again.id,
        merged: again.merge_fields,
        left: left,
        unknown: mailchimp_status(LIST, "nobody@example.com", {})?,
        archived: mailchimp_archive(LIST, "ada@example.com", {})?,
        forgotten: mailchimp_forget(LIST, "gone@example.com", {})?,
    }
}

route GET /batch {
    let rows = map(range(0, 1250), (i) => `p${i}@example.com`)
    let first = mailchimp_batch_subscribe(LIST, rows, false, {})?
    let second = mailchimp_batch_subscribe(LIST, [
        { email_address: "p0@example.com", merge_fields: { FNAME: "Zero" } },
        "bad-address@fake",
    ], true, {})?
    {
        created: first.created,
        updated: second.updated,
        failed: second.failed,
        why: second.errors[0],
        listed: len(mailchimp_members(LIST, {})?),
        capped: len(mailchimp_members(LIST, { max_items: 1100 })?),
    }
}

route GET /tags {
    mailchimp_upsert(LIST, "tags@example.com", { status_if_new: "subscribed" })?
    mailchimp_tag(LIST, "tags@example.com", ["vip", "eu"], [], {})?
    mailchimp_tag(LIST, "tags@example.com", ["2026"], ["eu"], {})?
    {
        tags: mailchimp_tags(LIST, "tags@example.com", {})?,
        hook: mailchimp_webhook_create(LIST, `https://example.com/mailchimp/${SECRET}`, ["unsubscribe", "cleaned"], ["user", "admin"], {})?.id,
        hooks: map(mailchimp_webhooks(LIST, {})?, (h) => h.events.unsubscribe),
        nothing: mailchimp_tag(LIST, "tags@example.com", [], [], {}).error,
    }
}

// Mailchimp checks a webhook's URL with a GET before it will use it.
route GET /mailchimp/:secret {
    if !mailchimp_secret_ok(secret, SECRET) { reply 404 "not here" }
    "ok"
}

route POST /mailchimp/:secret {
    if !mailchimp_secret_ok(secret, SECRET) { reply 404 "not here" }
    let hook = mailchimp_read_webhook(request.body)?
    { kind: hook.type, email: hook.data.email }
}

route GET /hook-check {
    let hook = mailchimp_read_webhook("type=unsubscribe&fired_at=2026-11-01+10%3A00%3A00&data%5Baction%5D=unsub&data%5Breason%5D=manual&data%5Bemail%5D=api%2Bone%40example.com&data[merges][FNAME]=Ada&data[merges][INTERESTS]=a%2C+b")?
    {
        kind: hook.type,
        fired: hook.fired_at,
        email: hook.data.email,
        name: hook.data.merges.FNAME,
        interests: hook.data.merges.INTERESTS,
        not_hook: mailchimp_read_webhook("a=1").error,
        good: mailchimp_secret_ok("abc", "abc"),
        wrong: mailchimp_secret_ok("abd", "abc"),
    }
}

route GET /failures = {
    bad_email: mailchimp_upsert(LIST, "not an email", {}).error,
    bad_status: mailchimp_upsert(LIST, "a@example.com", { status_if_new: "maybe" }).error,
    fake: mailchimp_upsert(LIST, "fake@fake.example", { status_if_new: "subscribed" }).error,
    no_list: mailchimp_member("nope", "a@example.com", {}).error,
    bad_key: mailchimp_member(LIST, "a@example.com", { api_key: "wrong-us1" }).error,
    missing_dc: mailchimp_member(LIST, "a@example.com", { base_url: "", api_key: "nodash" }).error,
    waited: mailchimp_upsert(LIST, "rate@example.com", {})?.status,
}
