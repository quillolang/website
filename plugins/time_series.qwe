// A small server's metrics kept in one file: CPU every 10 s and a request counter written for ten
// minutes, read back by the minute (average, max, p95, the counter's rate), two series for a
// chart, the series listed, the old raw points compacted and anything past a day dropped.
//
//   quillo run time_series.qwe      then open http://localhost:8080/metrics

use "time_series.qwer"

let DB = "data/metrics.redb"
let T0 = 1761696000000   // 2025-10-29 00:00 UTC

fn cpu(i) = 20.0 + float(i % 6) * 5.0 + (i == 33 ? 50.0 : 0.0)

route GET /metrics {
    ts_write(DB, "web.cpu", map(range(60), (i) => [T0 + i * 10000, cpu(i)]))?
    ts_write(DB, "web.requests", map(range(60), (i) => [T0 + i * 10000, float(i * 40)]))?
    ts_write(DB, "web.old", map(range(120), (i) => [T0 - 86400000 * 2 + i * 1000, float(i)]))?
    {
        avg: ts_downsample(DB, "web.cpu", T0, T0 + 300000, 60000, "avg", null)?,
        max: ts_downsample(DB, "web.cpu", T0, T0 + 600000, 60000, "max", null)? | map((b) => b[1]),
        p95: ts_downsample(DB, "web.cpu", T0, T0 + 600000, 600000, "p95", null)?[0][1],
        rate: ts_downsample(DB, "web.requests", T0, T0 + 120000, 60000, "rate", 0)?,
        chart: ts_chart(DB, ["web.cpu", "web.requests"], T0, T0 + 180000, 60000, "last")?,
        raw: len(ts_read(DB, "web.cpu", T0, T0 + 60000)?),
        compacted: ts_compact(DB, "web.old", T0 - 86400000, 60000, "avg")?,
        dropped: ts_retain(DB, "web.old", 86400000, T0),
        series: ts_series(DB, "web.")? | map((s) => `${s.series}: ${s.points}`),
    }
}
