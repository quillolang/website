// A welcome email, sent in the background so the sign-up answers at once.
//
//   SMTP_URL=smtps://user:password@smtp.example.com SMTP_FROM="Shop <shop@example.com>" quillo run smtp.qwe
//   then open http://localhost:8080/welcome?to=ada@example.com

use "smtp.qwer"

route GET /welcome ? { to: str } {
    send_email(to, "Welcome to the shop", "Thanks for signing up!", "<h1>Welcome!</h1><p>Thanks for signing up.</p>")?
    { sent: true }
}
