// A warehouse's labels for Zebra printers: a 4 × 6 inch shipping label with the pallet's SSCC
// as GS1-128, the bin labels of a shelf from one layout, and the printing itself.
//
//   quillo run zpl.qwe      then open http://localhost:8080/shipping.zpl
//   PRINTER_HOST=192.168.1.60 quillo run zpl.qwe      and http://localhost:8080/print
//
// Paste a label's ZPL into labelary.com/viewer.html to see it, or use the zpl_preview plugin.

use "zpl.qwer"

let SHIPMENT = {
    sscc: "(00)095011015300000010",
    from: "Quillo Coffee Roasters, 12 Dock Road, Leeds LS1 4AB",
    to: ["Café Montmartre", "Rue Lepic 18", "75018 Paris", "FRANCE"],
    gtin: "(01)09501101530003(10)LOT-2026-10(17)270131",
    po: "PO 7731-A",
    weight: "18.4 kg",
}

let LABEL = { dpi: 203, width: 101.6, height: 152.4, darkness: 22, speed: 4, media: "gap", method: "transfer" }

fn shipping(s) = [
    { image: "zpl_sample.png", x: 4, y: 4, width: 38 },
    { text: "FROM", x: 46, y: 4, size: 2.2 },
    { text: s.from, x: 46, y: 8, size: 2.6, block: 52, lines: 3 },
    { line: true, x: 2, y: 20, width: 97.6, thickness: 0.5 },
    { text: "SHIP TO", x: 4, y: 23, size: 2.5 },
    { text: join(s.to, "\n"), x: 4, y: 28, size: 5, block: 92, lines: 4 },
    { box: true, x: 2, y: 54, width: 97.6, height: 18, thickness: 0.5 },
    { text: s.po, x: 5, y: 58, size: 4 },
    { text: s.weight, x: 60, y: 58, size: 4 },
    { barcode: "qr", data: `https://track.example/${s.po}`, x: 82, y: 56, magnification: 3 },
    { text: "GTIN / LOT / BEST BEFORE", x: 4, y: 76, size: 2.5 },
    { barcode: "gs1_128", data: s.gtin, x: 4, y: 80, height: 14, module: 2 },
    { line: true, x: 2, y: 104, width: 97.6, thickness: 0.5 },
    { text: "SSCC", x: 4, y: 107, size: 2.5 },
    { barcode: "gs1_128", data: s.sscc, x: 6, y: 112, height: 25, module: 3 },
]

route GET /shipping.zpl = respond(200, zpl_label(shipping(SHIPMENT), LABEL)?, { "content-type": "text/plain; charset=utf-8" })

// 50 × 25 mm bin labels for one aisle, from one layout and a row per bin.
let BIN = [
    { text: "{{bin}}", x: 3, y: 2, size: 8 },
    { text: "{{zone}}", x: 34, y: 3, size: 3, reverse: true },
    { barcode: "code128", data: "{{bin}}", x: 3, y: 12, height: 10, module: 2, readable: false },
]

route GET /bins.zpl {
    let rows = map([1, 2, 3, 4], (n) => { bin: `A-04-0${n}`, zone: "DRY" })
    respond(200, zpl_labels(BIN, rows, { width: 50, height: 25, quantity: 1 })?, { "content-type": "text/plain" })
}

route GET /parts = {
    serial: zpl_label([{ text: "SN 000101", serial: 1, x: 2, y: 2, size: 4 }, { barcode: "datamatrix", data: "(01)09501101530003(21)A77", gs1: true, x: 30, y: 2, module: 4 }], { quantity: 3 })?,
    escaped: zpl_field_data("50% ^ off ~ today"),
    logo: slice(zpl_image("zpl_sample.png", 150, 128, false)?, 0, 20),
    setup: zpl_setup({ darkness: 25, speed: 3, media: "mark", method: "direct" })?,
}

route GET /print {
    let host = env("PRINTER_HOST", null) ?? reply 503 "set PRINTER_HOST to the printer's address (host or host:port)"
    let status = zpl_status(host, 3000)?
    if !status.ready { reply 409 { error: "the printer is not ready", status: status } }
    { sent: zpl_send(zpl_label(shipping(SHIPMENT), merge(LABEL, { quantity: 2 }))?, host, 5000)?, status: status }
}
