// Counterparties on a trade confirmation checked by their LEIs before the report goes to the
// regulator; a typo is caught offline, and a lookup shows who the LEI belongs to.
//
//   quillo run lei.qwe      then open http://localhost:8080/check and http://localhost:8080/who/HWUPKR0MPOU8FGXBT394 (network)

use "lei.qwer"

let CONFIRMATION = "Trade 77812. Buyer LEI: HWUPKR0MPOU8FGXBT394. Seller LEI: 5493001KJTIIGC8Y1R12. Broker: 5493001KJTIIGC8Y1R17 (as typed)."

route GET /check = {
    found: lei_find(CONFIRMATION),
    buyer: lei_check("HWUP KR0M POU8 FGXB T394"),
    typo: lei_check("5493001KJTIIGC8Y1R17").error,
    made: lei_make("5493001KJTIIGC8Y1R")?,
    short: lei_check("5493001KJ").error,
}

route GET /who/:lei = lei_lookup(lei, "")?
