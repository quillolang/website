// A directory of shops: "open now" badges, "opens at" hints and an hours table, from the opening_hours tags shops have on OpenStreetMap.
//
//   quillo run opening_hours.qwe      then open http://localhost:8080/bakery

use "opening_hours.qwer"

let BAKERY = "Mo-Fr 07:00-13:00,14:00-19:00; Sa 07:00-13:00; Su,PH off"

route GET /bakery {
    {
        // Thursday 29 October 2026, at 13:30: the lunch break.
        lunch: opening_hours_state(BAKERY, "2026-10-29T13:30", "FR")?,
        afternoon: opening_hours_state(BAKERY, "2026-10-29T15:00", "FR")?.open,
        // 11 November is a public holiday in France.
        armistice: opening_hours_state(BAKERY, "2026-11-11T10:00", "FR")?.state,
        opens: opening_hours_next_open(BAKERY, "2026-10-31T18:00", "FR")?,
        check: opening_hours_check("mo-fr 9:00-17:00"),
        broken: opening_hours_check("Mo-Fr 25:00-30:00").valid,
    }
}

route GET /week = opening_hours_week(BAKERY, "2026-11-09", "FR")? | map((d) => { day: d.weekday, hours: join(d.hours | map((h) => `${h.from}-${h.to}`), ", ") })

route GET /bar = opening_hours_week("Tu-Sa 18:00-02:00; Mo 18:00-22:00 \"quiz night\"", "2026-11-02", "")?
