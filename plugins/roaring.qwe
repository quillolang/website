// Audience segments for a newsletter: customers who bought, who opened, and who did not unsubscribe, combined as sets.
//
//   quillo run roaring.qwe      then open http://localhost:8080/segment

use "roaring.qwer"

route GET /segment {
    let bought = roaring_from(range(1, 100001))?                          // customers 1 to 100,000
    let opened = roaring_from(range(1, 200001) | filter((i) => i % 3 == 0))?
    let unsubscribed = roaring_from([3, 6, 9, 12, 99999])?
    let target = roaring_op("difference", [roaring_op("intersect", [bought, opened])?, unsubscribed])?
    {
        target: roaring_count(target)?,
        first: roaring_ids(target, 0, 5)?,
        has_15: roaring_contains(target, 15)?,
        has_12: roaring_contains(target, 12)?,
        stored_chars: len(bought),
    }
}

route GET /likes {
    let likes = roaring_change("", [7, 42, 1001], [])?
    let after = roaring_change(likes, [5], [42])?
    { likes: roaring_ids(after, 0, 10)?, count: roaring_count(after)?, both: roaring_count(roaring_op("union", [likes, after])?)? }
}
