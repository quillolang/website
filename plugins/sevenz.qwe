// A .7z of menus sent by a head office: listed, one file read, unpacked, and a reply packed.
//
//   quillo run sevenz.qwe      then open http://localhost:8080/menus

use "sevenz.qwer"

let ARCHIVE = "sevenz_sample.7z"

route GET /menus = {
    files: sevenz_list(ARCHIVE)? | filter((e) => e.kind == "file") | map((e) => { name: e.name, size: e.size }),
    readme: sevenz_read_file(ARCHIVE, "readme.txt")?,
}

route GET /unpack = sevenz_extract(ARCHIVE, "data/menus")?

route GET /reply {
    write_file("data/reply/answer.txt", "Thank you: the menus are up on the website.\n")
    { bytes: sevenz_create("data/reply.7z", "data/reply")?, inside: sevenz_list("data/reply.7z")? | map((e) => e.name) }
}
