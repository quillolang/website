//! Which language a text is in, of 69, with its script and how sure: route support tickets, pick a spell-checker, tag posts.
//! version: 1.0.0
//!
//! [dependencies]
//! whatlang = "0.16"

use serde_json::{json, Value};

/// `{ code, name, script, confidence, reliable }` for `text` (`code` is ISO 639-3: "eng", "fra", "jpn"), or null when it cannot tell.
pub fn detect_language(text: &str) -> Option<Value> {
    whatlang::detect(text).map(|i| json!({
        "code": i.lang().code(),
        "name": i.lang().eng_name(),
        "script": i.script().name(),
        "confidence": (i.confidence() * 100.0).round() / 100.0,
        "reliable": i.is_reliable(),
    }))
}

/// Only the script `text` is written in ("Latin", "Cyrillic", "Arabic", "Han", ...), or null.
pub fn detect_script(text: &str) -> Option<String> {
    whatlang::detect_script(text).map(|s| s.name().to_string())
}
