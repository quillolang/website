// Running other programs safely: arguments as a list, so a hostile file name stays a file name;
// a hang ended by a timeout, with what it started; a flood stopped at a limit; exit codes and
// signals told apart; a pipeline with no shell; and a job watched in the background.
//
//   quillo run cli_run.qwe      then open http://localhost:8080/basic, /injection and /timeout

use "cli_run.qwer"

route GET /basic {
    let r = cli_run("sh", ["-c", "echo to-stdout; echo to-stderr >&2; exit 3"], {})?
    { ok: r.ok, status: r.status, signal: r.signal, out: r.stdout, err: r.stderr, output: cli_output("echo", ["hello", "world"], {})?, failed: cli_output("sh", ["-c", "echo nope >&2; exit 2"], {}).error }
}

// A file name someone uploaded. Through a shell this runs `touch`.
route GET /injection {
    let name = "report; touch /tmp/quillo-cli-run-pwned #.txt"
    let r = cli_run("echo", [name], {})?
    let ls = cli_run("ls", ["--", name], {})?
    { echoed: r.stdout, still_one_argument: ls.status != 0, looks_like_a_shell: cli_run("ls -la", [], {}).error, nul: cli_run("echo", ["a\u0000b"], {}).error }
}

route GET /environment {
    let folder = cli_run("pwd", [], { cwd: "/" })?.stdout
    let added = cli_run("sh", ["-c", "echo \"$GREETING\""], { env: { GREETING: "hi" } })?.stdout
    let cleared = cli_run("/usr/bin/env", [], { clear_env: true, env: { ONLY: "this" } })?.stdout
    let typed = cli_run("cat", [], { stdin: "from the program" })?.stdout
    { folder: folder, added: added, cleared: cleared, typed: typed, no_folder: cli_run("pwd", [], { cwd: "/no/such" }).error }
}

route GET /timeout {
    let r = cli_run("sleep", ["30"], { timeout_ms: 100, grace_ms: 200 })?
    { timed_out: r.timed_out, signal: r.signal_name, ok: r.ok, quick: r.duration_ms < 2000, as_error: cli_output("sleep", ["30"], { timeout_ms: 50 }).error != null }
}

// A shell that ignores SIGTERM and has started another process: the group goes, every member.
route GET /group {
    let script = "trap '' TERM; sleep 31 & echo $!; wait"
    let r = cli_run("sh", ["-c", script], { timeout_ms: 150, grace_ms: 100 })?
    let child = trim(r.stdout)
    sleep(100)
    { timed_out: r.timed_out, signal: r.signal_name, child_gone: cli_run("kill", ["-0", child], {})?.status != 0, finishes: r.duration_ms < 3000 }
}

route GET /limit {
    let flood = cli_run("yes", ["spam"], { max_output: 1000, timeout_ms: 5000 })?
    let kept = cli_run("sh", ["-c", "seq 1 1000; echo done >&2"], { max_output: 20, on_limit: "truncate" })?
    { hit: flood.output_limit_hit, stopped: !flood.ok, size: len(flood.stdout), truncated: kept.truncated, ok: kept.ok, wrote: kept.stdout_bytes, kept: len(kept.stdout), err: kept.stderr }
}

route GET /signals {
    let r = cli_run("sh", ["-c", "kill -SEGV $$"], {})?
    { status: r.status, signal: r.signal, name: r.signal_name, ok: r.ok, as_error: cli_output("sh", ["-c", "kill -KILL $$"], {}).error }
}

route GET /missing = {
    program: cli_run("no-such-program-here", [], {}).error,
    option: cli_run("echo", [], { timeuot_ms: 1 }).error,
    on_limit: cli_run("echo", [], { on_limit: "shrug" }).error,
    bad_env: cli_run("echo", [], { env: { "A=B": "c" } }).error,
    which_sh: cli_which("sh") != null,
    which_none: cli_which("no-such-program-here"),
}

route GET /pipeline {
    let ok = cli_pipeline([["printf", "b\\na\\nc\\na\\n"], ["sort"], ["uniq", "-c"], ["wc", "-l"]], {})?
    let fed = cli_pipeline([["tr", "a-z", "A-Z"]], { stdin: "shout" })?
    let bad = cli_pipeline([["sh", "-c", "echo x; exit 4"], ["cat"]], {})?
    let slow = cli_pipeline([["sleep", "30"], ["cat"]], { timeout_ms: 100 })?
    { lines: trim(ok.stdout), every: len(ok.statuses), fed: fed.stdout, failed_step: [bad.ok, bad.stdout, bad.statuses[0].status, bad.statuses[1].status], timed_out: slow.timed_out, none: cli_pipeline([], {}).error, missing: cli_pipeline([["echo", "x"], ["no-such-program-here"]], {}).error }
}

route GET /background {
    let pid = cli_start("tail", "sh", ["-c", "echo started; sleep 30"], {})?
    sleep(150)
    let first = cli_poll("tail")?
    let twice = cli_start("tail", "echo", [], {}).error
    let stopped = cli_stop("tail", 200)?
    cli_start("short", "sh", ["-c", "echo done; exit 5"], {})?
    sleep(150)
    let ended = cli_poll("short")?
    { pid: pid > 0, running: first.running, out: first.stdout, twice: twice, stopped: stopped.signal_name, ended: [ended.running, ended.status, ended.stdout], gone: cli_poll("short").error }
}

route GET /quote = [cli_quote("plain-word"), cli_quote("two words"), cli_quote("it's"), cli_quote("")]
