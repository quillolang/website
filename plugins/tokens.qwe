// A prompt kept inside a budget of tokens before it is sent to an OpenAI model.
//
//   quillo run tokens.qwe      then open http://localhost:8080/count?text=Hello%20world

use "tokens.qwer"

let article = repeat("Quillo is a small language for web apps. Routes, pages and components live in one file, and the server is built in. ", 20)

route GET /count ? { text: str, model: str = "gpt-4o" } = { tokens: tokens_count(text, model)?, window: tokens_window(model) }

route GET /budget {
    let prompt = tokens_cut(article, "gpt-4o", 50)?
    { full: tokens_count(article, "gpt-4o")?, kept: tokens_count(prompt, "gpt-4o")?, prompt, pieces: len(tokens_split(article, "gpt-4o", 200)?) }
}
