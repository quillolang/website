// A notebook in a repository: read, stripped before a commit, turned into Markdown and a script,
// its charts pulled out to files, and a report written as a new notebook.
//
//   IPYNB_OUT=/tmp/ipynb-figures quillo run ipynb.qwe      then open http://localhost:8080/read, /strip, /markdown, /script, /images, /write, /old and /broken

use "ipynb.qwer"

let TEXT = read_file("ipynb_sample.ipynb")
let OUT = env("IPYNB_OUT", "/tmp/ipynb-figures")

route GET /read {
    let nb = ipynb_read_file("ipynb_sample.ipynb")?
    {
        format: nb.format, language: nb.language, kernel: nb.kernel, counts: nb.counts, in_order: nb.in_order, errors: nb.errors,
        title: nb.cells[0].source, code: nb.cells[1].source, tags: nb.cells[1].tags,
        kinds: nb.cells[2].outputs | map((o) => [o.type, o.count, o.mime_types, o.text, o.images]),
        error: nb.cells[3].outputs[0],
    }
}

route GET /strip {
    let plain = ipynb_strip(TEXT, {})?
    let kept = ipynb_strip(TEXT, { keep_tag: "keep" })?
    let again = ipynb_read(kept)?
    {
        smaller: len(plain) < len(TEXT),
        outputs: ipynb_read(plain)?.cells | map((c) => len(c.outputs)),
        counts: ipynb_read(plain)?.counts.run,
        kept: again.cells | map((c) => c.execution_count),
        twice: ipynb_strip(plain, {})? == plain,
        no_png: !contains(plain, "image/png"),
    }
}

route GET /markdown = {
    inline: split(ipynb_to_markdown(TEXT, {})?, "\n") | filter((l) => starts_with(l, "![") ) | map((l) => slice(l, 0, 36)),
    folder: ipynb_to_markdown(TEXT, { images: "fig" })?,
    omit: contains(ipynb_to_markdown(TEXT, { images: "omit" })?, "!["),
}

route GET /script = respond(200, ipynb_to_script(TEXT)?, { "content-type": "text/plain" })

route GET /images {
    let files = ipynb_images(TEXT, OUT)?
    { files: files | map((f) => [f.cell, f.output, f.mime, f.bytes, f.sha256]) }
}

route GET /write {
    let text = ipynb_write([
        { type: "markdown", source: "# Report\n\nMade by a program.\n" },
        { type: "code", source: "x = 1\nx + 1", outputs: [{ type: "stream", text: "2\nok\n" }] },
    ], "python")?
    let nb = ipynb_read(text)?
    {
        lines: json.parse(text).cells[0].source,
        cells: nb.cells | map((c) => [c.type, c.source]), output: nb.cells[1].outputs[0],
        id: len(nb.cells[0].id), head: slice(text, 0, 13), format: nb.format,
        bad_kind: ipynb_write([{ type: "sql", source: "x" }], "python").error,
        bad_id: ipynb_write([{ type: "raw", id: "no spaces!", source: "x" }], "python").error,
        no_source: ipynb_write([{ type: "code" }], "python").error,
    }
}

route GET /old {
    let nb = ipynb_read(read_file("ipynb_v3_sample.ipynb"))?
    { format: nb.format, cells: nb.cells | map((c) => [c.type, c.source, c.execution_count, len(c.outputs)]), result: nb.cells[1].outputs[0].text, error: nb.cells[2].outputs[0].name, stream: nb.cells[2].outputs[1].name }
}

route GET /broken = {
    not_json: ipynb_read("{").error != null,
    no_format: ipynb_read("{}").error,
    too_old: ipynb_read("{\"nbformat\":2}").error,
    no_cells: ipynb_read("{\"nbformat\":4}").error,
    bad_image: ipynb_images("{\"nbformat\":4,\"cells\":[{\"cell_type\":\"code\",\"source\":[],\"outputs\":[{\"output_type\":\"display_data\",\"data\":{\"image/png\":\"@@\"}}]}]}", OUT).error != null,
}
