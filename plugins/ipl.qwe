// A distribution centre's pallet labels on Intermec printers in IPL (PM4i, PF2i, PX4i):
// the format is saved in the printer once with its fields, each print sends only the data;
// the next pallet's label is printed from the saved format with new data.
//
//   quillo run ipl.qwe      then open http://localhost:8080/label
//   PRINTER_HOST=192.168.1.64 quillo run ipl.qwe      and http://localhost:8080/print

use "ipl.qwer"

let OPTIONS = { dpi: 203, format: 7, quantity: 2 }

fn pallet(p) = [
    { box: true, x: 2, y: 2, width: 96, height: 146, thickness: 0.5 },
    { text: "PALLET", x: 6, y: 6, size: 4 },
    { text: p.customer, x: 6, y: 14, size: 7, font: 25 },
    { line: true, x: 2, y: 30, width: 96, thickness: 0.4 },
    { text: `Dock ${p.dock} / ${p.cartons} cartons`, x: 6, y: 34, size: 4 },
    { barcode: "code128", data: p.order, x: 6, y: 44, height: 18, module: 2 },
    { barcode: "qr", data: `https://wms.example/pallet/${p.order}`, x: 70, y: 70, magnification: 5 },
    { text: "SSCC", x: 6, y: 102, size: 3 },
    { barcode: "gs1_128", data: p.sscc, x: 6, y: 108, height: 28, module: 3 },
]

let PALLET = { customer: "Nordic Foods AB", dock: "D-07", cartons: 48, order: "SO-88417", sscc: "(00)095011015300000010" }

route GET /label = respond(200, ipl_label(pallet(PALLET), OPTIONS)?, { "content-type": "text/plain; charset=utf-8" })

// Field numbers follow the list from 1: 3 is the customer, 5 the dock line, 6 the order's barcode.
route GET /next = { job: ipl_fill(7, { "3": "Baltic Trade OU", "5": "Dock D-02 / 12 cartons", "6": "SO-88418" }, 1), bytes: ipl_write(pallet(PALLET), OPTIONS, "data/pallet.ipl")? }

route GET /print {
    let host = env("PRINTER_HOST", null) ?? reply 503 "set PRINTER_HOST to the printer's address (host or host:port)"
    { sent: ipl_send(pallet(PALLET), OPTIONS, host, 5000)? }
}
