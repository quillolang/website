//! CSV in and out: rows as maps keyed by the header, quotes, commas and line breaks in cells handled.
//! version: 1.0.0
//!
//! [dependencies]
//! csv = "1"

use serde_json::Value;
use std::collections::HashMap;

fn maps<R: std::io::Read>(mut r: csv::Reader<R>) -> Result<Vec<HashMap<String, String>>, String> {
    let headers: Vec<String> = r.headers().map_err(|e| e.to_string())?.iter().map(|h| h.trim().to_string()).collect();
    let mut out = Vec::new();
    for rec in r.records() {
        let rec = rec.map_err(|e| e.to_string())?;
        out.push(headers.iter().cloned().zip(rec.iter().map(str::to_string)).collect());
    }
    Ok(out)
}

fn delim(d: &str) -> Result<u8, String> {
    match d.as_bytes() {
        [b] => Ok(*b),
        _ => Err(format!("the delimiter is one character, not `{}`", d)),
    }
}

/// CSV text as a list of maps, keyed by the first row. Cells are text; rows may be short.
pub fn csv_parse(text: &str) -> Result<Vec<HashMap<String, String>>, String> {
    maps(csv::ReaderBuilder::new().flexible(true).from_reader(text.as_bytes()))
}

/// A CSV file as a list of maps, read straight from the disk: for exports too big to read as text first.
pub fn csv_read_file(path: &str) -> Result<Vec<HashMap<String, String>>, String> {
    maps(csv::ReaderBuilder::new().flexible(true).from_path(path).map_err(|e| format!("{}: {}", path, e))?)
}

/// CSV text as lists of cells, the first row too; `delimiter` is one character: ",", ";", "\t" or "|".
pub fn csv_rows(text: &str, delimiter: &str) -> Result<Vec<Vec<String>>, String> {
    let mut r = csv::ReaderBuilder::new().has_headers(false).flexible(true).delimiter(delim(delimiter)?).from_reader(text.as_bytes());
    r.records().map(|rec| rec.map(|r| r.iter().map(str::to_string).collect()).map_err(|e| e.to_string())).collect()
}

fn cell(v: Option<&Value>) -> String {
    match v {
        None | Some(Value::Null) => String::new(),
        Some(Value::String(s)) => s.clone(),
        Some(v) => v.to_string(),
    }
}

/// Maps as CSV text: `columns` are the header and the order. `null` is an empty cell; lists and maps are written as JSON.
pub fn csv_write(rows: Vec<std::collections::HashMap<String, serde_json::Value>>, columns: Vec<String>) -> Result<String, String> {
    let mut w = csv::Writer::from_writer(Vec::new());
    w.write_record(&columns).map_err(|e| e.to_string())?;
    for row in &rows {
        w.write_record(columns.iter().map(|c| cell(row.get(c)))).map_err(|e| e.to_string())?;
    }
    String::from_utf8(w.into_inner().map_err(|e| e.to_string())?).map_err(|e| e.to_string())
}
