// A small video pipeline around the ffmpeg command: a file probed, a poster frame, a clip, a
// smaller copy, HLS for a player, and a long job followed in the background. The sample is made by
// ffmpeg's own test source, so nothing ships with this example.
//
//   FFMPEG_OUT=/tmp/video-work quillo run ffmpeg_cli.qwe      then open http://localhost:8080/probe
//
// ffmpeg and ffprobe must be installed: FFMPEG_BIN and FFPROBE_BIN name them if not on PATH.

use "ffmpeg_cli.qwer"

let OUT = env("FFMPEG_OUT", "/tmp/quillo-ffmpeg-demo")
let SAMPLE = `${OUT}/sample.mp4`
let DONE = { overwrite: true, timeout_ms: 60000 }

ffmpeg_generate(SAMPLE, { seconds: 4, width: 320, height: 240, fps: 25, overwrite: true })

route GET /probe {
    let p = ffmpeg_probe(SAMPLE)?
    { format: p.format, duration: p.duration, video: [p.video.codec, p.video.width, p.video.height, p.video.pixel_format, p.video.fps], audio: [p.audio.codec, p.audio.sample_rate, p.audio.channels], streams: p.streams | map((s) => s.type) }
}

route GET /thumbnail {
    let t = ffmpeg_thumbnail(SAMPLE, `${OUT}/poster.jpg`, { ...DONE, at: 1.5, width: 160 })?
    let p = ffmpeg_probe(`${OUT}/poster.jpg`)?
    { made: t.bytes > 500, size: [p.video.width, p.video.height], codec: p.video.codec }
}

route GET /trim {
    let c = ffmpeg_trim(SAMPLE, `${OUT}/clip.mp4`, { ...DONE, start: 1, duration: 2 })?
    let e = ffmpeg_trim(SAMPLE, `${OUT}/exact.mp4`, { ...DONE, start: "00:00:00.5", end: "00:00:01.5", copy: false })?
    { clip: round(ffmpeg_probe(c.output)?.duration), exact: round(ffmpeg_probe(e.output)?.duration * 10), same_codec: ffmpeg_probe(c.output)?.video.codec }
}

route GET /transcode {
    let r = ffmpeg_transcode(SAMPLE, `${OUT}/small.mp4`, { ...DONE, width: 160, crf: 30, preset: "ultrafast", audio_bitrate: "64k", faststart: true, video_codec: "libx264", audio_codec: "aac" })?
    let silent = ffmpeg_transcode(SAMPLE, `${OUT}/silent.mp4`, { ...DONE, no_audio: true, video_codec: "libx264", preset: "ultrafast" })?
    let sound = ffmpeg_transcode(SAMPLE, `${OUT}/sound.m4a`, { ...DONE, no_video: true })?
    let p = ffmpeg_probe(r.output)?
    { size: [p.video.width, p.video.height], frames: r.frames, progress_read: r.out_ms > 3000, silent: ffmpeg_probe(silent.output)?.audio, sound: ffmpeg_probe(sound.output)?.video, sound_audio: ffmpeg_probe(sound.output)?.audio.codec }
}

route GET /hls {
    let h = ffmpeg_hls(SAMPLE, `${OUT}/hls`, { ...DONE, segment_seconds: 1 })?
    { count_ok: len(h.segments) >= 3, first: h.segments[0].file, ended: h.ended, target: h.target_duration, total: round(reduce(h.segments, 0, (a, s) => a + s.duration)), bytes_ok: h.bytes > 1000 }
}

route GET /background {
    ffmpeg_start("job", SAMPLE, `${OUT}/job.mp4`, { ...DONE, video_codec: "libx264", preset: "ultrafast" })?
    let twice = ffmpeg_start("job", SAMPLE, `${OUT}/x.mp4`, DONE).error
    let tries = 0
    let last = ffmpeg_progress("job")?
    while last.running && tries < 500 {
        sleep(20)
        last = ffmpeg_progress("job")?
        tries = tries + 1
    }
    ffmpeg_start("stop-me", SAMPLE, `${OUT}/stopped.mp4`, { ...DONE, video_codec: "libx264" })?
    { running: last.running, percent: last.percent, finished: last.finished, made: last.result.bytes > 1000, twice: twice, gone: ffmpeg_progress("job").error, cancelled: ffmpeg_cancel("stop-me")?, no_such: ffmpeg_cancel("stop-me")? }
}

// What reaches the command line: a hostile name stays a path, and a bad value never gets there.
route GET /safety = {
    args: ffmpeg_transcode_args(SAMPLE, `${OUT}/a.mp4`, { ...DONE, video_codec: "libx264", crf: 23, width: 640, audio_bitrate: "128k" })? | filter((a) => !contains(a, "demo") && !contains(a, OUT)),
    url: ffmpeg_probe("http://example.com/a.mp4").error,
    concat: ffmpeg_probe("concat:/etc/passwd|/etc/hosts").error,
    option: ffmpeg_probe("-version").error,
    codec: ffmpeg_transcode(SAMPLE, `${OUT}/b.mp4`, { ...DONE, video_codec: "x; rm -rf /" }).error,
    preset: ffmpeg_transcode(SAMPLE, `${OUT}/b.mp4`, { ...DONE, preset: "-y" }).error,
    time: ffmpeg_thumbnail(SAMPLE, `${OUT}/c.jpg`, { ...DONE, at: "1;2" }).error,
    crf: ffmpeg_transcode(SAMPLE, `${OUT}/b.mp4`, { ...DONE, crf: 99 }).error,
    size: ffmpeg_transcode(SAMPLE, `${OUT}/b.mp4`, { ...DONE, width: 1 }).error,
    typo: ffmpeg_transcode(SAMPLE, `${OUT}/b.mp4`, { ...DONE, vidoe_codec: "h264" }).error,
    both: ffmpeg_trim(SAMPLE, `${OUT}/b.mp4`, { ...DONE, end: 2, duration: 1 }).error,
    backwards: ffmpeg_trim(SAMPLE, `${OUT}/b.mp4`, { ...DONE, start: 3, end: 2 }).error,
    extension: ffmpeg_transcode(SAMPLE, `${OUT}/noext`, DONE).error,
}

route GET /failures = {
    not_media: ffmpeg_probe("ffmpeg_cli.qwe").error,
    missing: ffmpeg_probe("nothing-here.mp4").error,
    exists: ffmpeg_transcode(SAMPLE, SAMPLE, {}).error != null,
    bad_encoder: ffmpeg_transcode(SAMPLE, `${OUT}/b.mp4`, { ...DONE, video_codec: "no_such_codec" }).error,
    version_known: ffmpeg_version()?.version != null,
}
