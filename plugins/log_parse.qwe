// An nginx access log read into rows: errors, the busiest paths and slow requests; and
// syslog, logfmt and JSON lines read the same way.
//
//   quillo run log_parse.qwe      then open http://localhost:8080/access

use "log_parse.qwer"

route GET /access {
    let log = log_parse_file("log_parse_sample.log", "auto", 100000)?
    let rows = log.rows
    {
        format: log.format,
        requests: len(rows),
        skipped_lines: log.skipped,
        statuses: log_top(rows, "status_class", 5),
        busiest: log_top(rows, "path", 3),
        errors: rows | filter((r) => r.status >= 500) | map((r) => `${r.time} ${r.method} ${r.path}`),
        // nginx's $request_time, written after the user agent, is in `extra`.
        slow: rows | filter((r) => r.extra[0] > 0.8) | map((r) => r.path),
    }
}

route GET /first = log_parse_file("log_parse_sample.log", "combined", 1)?.rows[0]

route GET /others = {
    syslog: log_parse_line("<34>Oct 29 13:55:36 web1 sshd[4242]: Failed password for root from 203.0.113.7 port 52144 ssh2", "auto")?,
    rfc5424: log_parse_line("<165>1 2026-10-29T13:55:36.003Z web1 billing 77 INV42 - invoice 1042 sent", "syslog")?,
    logfmt: log_parse_line(`level=warn at=2026-10-29T13:55:36Z msg="slow query" duration_ms=812 table=orders`, "auto")?,
    json: log_parse_text(`{"level":"error","msg":"payment failed","order":1042}` + "\n" + `{"level":"info","msg":"ok"}`, "auto")?,
    detected: log_detect("ts=1 level=info msg=hello\nts=2 level=info msg=again"),
}
