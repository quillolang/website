//! Picture captchas made on your own server: distorted letters as a PNG data URL and the answer, for sign-up and contact forms without a third party.
//! version: 1.0.0
//!
//! [dependencies]
//! captcha = "0.0.9"

use captcha::filters::{Dots, Noise, Wave};
use captcha::Captcha;
use std::collections::HashMap;

/// A new captcha of `length` characters (4 to 8): `{ image, answer }`. `image` is a `data:image/png;base64,...` URL for an
/// `<img src>`, 220 by 110 pixels; keep `answer` on the server (in the session), never in the page. `hard` adds more noise and waves.
pub fn captcha_new(length: i64, hard: bool) -> Result<HashMap<String, String>, String> {
    let n = length.clamp(4, 8) as u32;
    let mut c = Captcha::new();
    c.add_chars(n);
    if hard {
        c.apply_filter(Noise::new(0.5)).apply_filter(Wave::new(2.0, 20.0)).apply_filter(Wave::new(2.0, 20.0).vertical()).apply_filter(Dots::new(15));
    } else {
        c.apply_filter(Noise::new(0.3)).apply_filter(Wave::new(2.0, 12.0)).apply_filter(Dots::new(6));
    }
    c.view(220, 110);
    let answer = c.chars_as_string();
    let image = c.as_base64().ok_or("the picture could not be made")?;
    Ok(HashMap::from([
        ("image".to_string(), format!("data:image/png;base64,{}", image)),
        ("answer".to_string(), answer),
    ]))
}

/// Whether what the visitor typed is the answer: spaces around it ignored, and capitals too, since some letters look alike in both.
/// An empty answer on either side is false.
pub fn captcha_check(answer: &str, typed: &str) -> bool {
    let (a, t) = (answer.trim().to_lowercase(), typed.trim().to_lowercase());
    !a.is_empty() && a.len() == t.len() && a.bytes().zip(t.bytes()).fold(0u8, |acc, (x, y)| acc | (x ^ y)) == 0
}
