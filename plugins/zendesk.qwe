// A help desk through Zendesk: a ticket opened from a form, a public reply and an internal note,
// all open tickets read past a page, a search, and a webhook checked before it is believed.
//
//   ZENDESK_SUBDOMAIN=acme ZENDESK_EMAIL=agent@acme.com ZENDESK_API_TOKEN=... ZENDESK_WEBHOOK_SECRET=... quillo run zendesk.qwe
//   then open http://localhost:8080/ticket, /list, /search, /hook-check and /failures
//
// ZENDESK_API_URL reaches a test server.

use "zendesk.qwer"

route GET /ticket {
    let t = zendesk_ticket_create({ subject: "Blue mug arrived broken", comment: "It came in two pieces.", priority: "high", requester: { name: "Ada", email: "ada@example.com" }, tags: ["damage"] }, {})?
    zendesk_comment(t.id, "Sorry about that: a new one is on its way.", true, {})?
    zendesk_comment(t.id, "Refund approved by Sam.", false, {})?
    let solved = zendesk_ticket_update(t.id, { status: "solved", additional_tags: ["refunded"] }, {})?
    let notes = zendesk_comments(t.id, {})?
    {
        status: solved.status,
        tags: solved.tags,
        comments: map(notes, (c) => c.body),
        public: map(notes, (c) => c.public),
        read: zendesk_ticket(t.id, {})?.subject,
    }
}

route GET /list {
    let all = zendesk_tickets({})?
    { total: len(all), first: all[0].subject, capped: len(zendesk_tickets({ max_items: 120 })?) }
}

route GET /search {
    let r = zendesk_search("type:ticket status:open", {})?
    let every = zendesk_search_export("status:open", "ticket", {})?
    { count: r.count, page: len(r.results), every: len(every) }
}

let BODY = "{\"ticket\":1}"
let STAMP = "2026-11-01T10:00:00Z"
// Worked out outside the plugin, with the secret "zd-secret".
let SIG = "bnJ/3N7EE0PMTAXdg5iEVc4ekzM32GtUXkogFAkrgBw="

route GET /hook-check = {
    good: zendesk_webhook_ok(BODY, SIG, STAMP, "zd-secret")?,
    tampered: zendesk_webhook_ok(BODY + " ", SIG, STAMP, "zd-secret")?,
    other_time: zendesk_webhook_ok(BODY, SIG, "2026-11-01T10:00:01Z", "zd-secret")?,
    wrong_secret: zendesk_webhook_ok(BODY, SIG, STAMP, "other")?,
    not_base64: zendesk_webhook_ok(BODY, "!!!", STAMP, "zd-secret")?,
}

route POST /zendesk/hook {
    let h = request.headers
    let ok = zendesk_webhook_ok(request.body, h["x-zendesk-webhook-signature"] ?? "", h["x-zendesk-webhook-signature-timestamp"] ?? "", "")?
    if !ok { reply 401 "bad signature" }
    { got: true }
}

route GET /failures = {
    invalid: zendesk_ticket_create({ subject: "", comment: "x", priority: "soon" }, {}).error,
    missing: zendesk_ticket(999999, {}).error,
    bad_token: zendesk_ticket(1, { token: "wrong" }).error,
    no_comment: zendesk_ticket_create({ subject: "x" }, {}).error,
    empty: zendesk_comment(1, " ", true, {}).error,
    waited: zendesk_request("GET", "/api/v2/users/me.json", null, {})?.user.email,
}
