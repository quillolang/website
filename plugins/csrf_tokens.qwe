// A money transfer form protected from cross-site requests: a token signed for the visitor's
// session in the form, checked when it comes back, and the Origin checked too.
//
//   CSRF_SECRET=$(openssl rand -hex 32) quillo run csrf_tokens.qwe      then open http://localhost:8080/transfer

use "csrf_tokens.qwer"

let SECRET = env("CSRF_SECRET", "dev-only-secret-change-me-0123456789")
let ORIGINS = ["http://localhost:8080", "https://bank.example.com"]

fn session_id() {
    let s = session()
    if s.sid != null { return s.sid }
    let sid = crypto.token(16)
    set_session({ ...s, sid })
    sid
}

route GET /transfer {
    let token = csrf_token(SECRET, session_id())?
    <form method="post" action="/transfer">
        <input type="hidden" name="csrf" value={token}/>
        <label>To <input name="to"/></label>
        <label>Amount <input name="amount"/></label>
        <button>Send</button>
    </form>
}

route POST /transfer { form: { csrf: str, to: str, amount: str } } {
    let sid = session().sid ?? reply 403 "no session"
    let ok = csrf_verify(SECRET, sid, csrf, 3600)
    if is_err(ok) { reply 403 ok.error }
    let same = csrf_origin_check(request.headers, ORIGINS)
    if is_err(same) { reply 403 same.error }
    `Sent ${amount} to ${to}`
}

// The checks at work, without a browser.
route GET /selftest {
    let token = csrf_token(SECRET, "session-a")?
    let old = csrf_token_at(SECRET, "session-a", int(now() / 1000) - 7200)?
    {
        fresh: csrf_verify(SECRET, "session-a", token, 3600)?,
        other_session: csrf_verify(SECRET, "session-b", token, 3600).error,
        expired: csrf_verify(SECRET, "session-a", old, 3600).error,
        double_submit: csrf_double_submit(SECRET, "session-a", token, token, 3600)?,
        same_origin: csrf_origin_check({ "sec-fetch-site": "same-origin" }, ORIGINS)?,
        evil_origin: csrf_origin_check({ origin: "https://evil.example" }, ORIGINS).error,
        our_referer: csrf_origin_check({ referer: "https://bank.example.com/transfer?x=1" }, ORIGINS)?,
    }
}
