// A used-car listing form that reads the VIN: check digit, maker, country and model year.
//
//   quillo run vin.qwe      then open http://localhost:8080/vin/1HGCM82633A004352

use "vin.qwer"

route GET /vin/:vin = vin_decode(vin)?

route GET /check = ["1HGCM82633A004352", "1HGCM82633A004353", "5YJ3E1EA2KF317000", "WBA3A5C57CF256651"] | map((v) => { vin: v, valid: vin_valid(v), should_be: vin_check_digit(v)? })
