// Invite links and coupon codes: random ids in a URL-safe alphabet, and readable ones for print.
//
//   quillo run nanoid.qwe      then open http://localhost:8080/invite

use "nanoid.qwer"

route GET /invite = { url: `https://app.example.com/join/${nanoid(0)?}` }

route GET /coupons ? { n: int = 3 } = range(0, n) | map((i) => `SALE-${nanoid_with(8, "readable")?}`)

route GET /odds = {
    default_21: nanoid_safe_count(21, "")?,
    readable_8: nanoid_safe_count(8, "readable")?,
    pin: nanoid_with(6, "numbers")?,
    own: nanoid_with(10, "ABC123")?,
    length: len(nanoid(0)?),
}
