// Ids for messages made on several servers at once, sortable by time, and "since yesterday" without a date column.
//
//   quillo run snowflake.qwe      then open http://localhost:8080/ids

use "snowflake.qwer"

let WORKER = int(env("WORKER_ID") ?? "7")

route GET /ids {
    let ids = range(0, 3) | map((i) => snowflake(WORKER)?)
    { ids: ids | map((i) => str(i)), sorted: sort(ids) == ids, first: snowflake_parse(ids[0])? }
}

route GET /since = { yesterday: str(snowflake_at(now() - 86400000)?), fixed: snowflake_parse(snowflake_at(1767225600000)?)? }
