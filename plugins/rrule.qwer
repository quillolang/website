//! Repeating events from iCalendar RRULEs ("every Monday and Wednesday at 9", "the last Friday of each month"): the dates between two days, in the event's time zone, daylight saving included.
//! version: 1.0.0
//!
//! [dependencies]
//! rrule = "0.13"
//! chrono = "0.4"

use chrono::{DateTime, NaiveDate, NaiveDateTime, TimeZone};
use rrule::{RRuleSet, Tz};

fn set(rule_text: &str) -> Result<RRuleSet, String> {
    if rule_text.len() > 10_000 {
        return Err("a rule is at most 10,000 characters".into());
    }
    rule_text.trim().replace("\\n", "\n").parse::<RRuleSet>().map_err(|e| format!("not a recurrence rule: {}", e))
}

/// A date (`2026-11-01`, midnight in `tz`) or a date-time with an offset (`2026-11-01T08:00:00Z`).
fn instant(text: &str, tz: &Tz) -> Result<DateTime<Tz>, String> {
    let t = text.trim();
    if let Ok(d) = DateTime::parse_from_rfc3339(t) {
        return Ok(d.with_timezone(tz));
    }
    if let Ok(d) = NaiveDate::parse_from_str(t, "%Y-%m-%d") {
        let n = d.and_hms_opt(0, 0, 0).ok_or("bad date")?;
        return tz.from_local_datetime(&n).earliest().ok_or_else(|| format!("{} does not exist in that zone", t));
    }
    Err(format!("`{}` is not a date (2026-11-01) or a date-time with an offset (2026-11-01T08:00:00Z)", text))
}

/// The text of a rule set from its parts: `start` the first time, local to `tz` (`2026-11-02T09:00:00` or `2026-11-02T09:00`),
/// `tz` an IANA zone (`Europe/Paris`, or `UTC`), and `rule` the RRULE itself (`FREQ=WEEKLY;BYDAY=MO,WE;COUNT=10`).
/// Gives `DTSTART;TZID=Europe/Paris:20261102T090000` and the `RRULE:` line, as .ics files hold them, for rrule_between.
pub fn rrule_text(start: &str, tz: &str, rule: &str) -> Result<String, String> {
    let s = start.trim();
    let n = NaiveDateTime::parse_from_str(s, "%Y-%m-%dT%H:%M:%S").or_else(|_| NaiveDateTime::parse_from_str(s, "%Y-%m-%dT%H:%M"))
        .map_err(|_| format!("`{}` is not a local date-time like 2026-11-02T09:00:00", start))?;
    let r = rule.trim().trim_start_matches("RRULE:");
    let first = if tz.is_empty() || tz.eq_ignore_ascii_case("UTC") {
        format!("DTSTART:{}Z", n.format("%Y%m%dT%H%M%S"))
    } else {
        format!("DTSTART;TZID={}:{}", tz, n.format("%Y%m%dT%H%M%S"))
    };
    let text = format!("{}\nRRULE:{}", first, r);
    // Parsing it checks the zone's name and the rule.
    set(&text)?;
    Ok(text)
}

/// The times `rule_text` (a DTSTART line and RRULE, RDATE and EXDATE lines, as rrule_text makes or an .ics VEVENT holds) gives
/// from `from` up to `until`, both included: dates (`2026-11-01`, midnight in the rule's zone) or date-times with an offset.
/// Each is an RFC 3339 date-time at the zone's offset that day. At most `limit` (1 to 10,000).
pub fn rrule_between(rule_text: &str, from: &str, until: &str, limit: i64) -> Result<Vec<String>, String> {
    let s = set(rule_text)?;
    let tz = s.get_dt_start().timezone();
    let (a, b) = (instant(from, &tz)?, instant(until, &tz)?);
    let r = s.after(a).before(b).all(limit.clamp(1, 10_000) as u16);
    Ok(r.dates.iter().map(|d| d.to_rfc3339()).collect())
}

/// The first `count` times of a rule (1 to 10,000), from its start: a course's sessions, a loan's payment days.
pub fn rrule_first(rule_text: &str, count: i64) -> Result<Vec<String>, String> {
    let r = set(rule_text)?.all(count.clamp(1, 10_000) as u16);
    Ok(r.dates.iter().map(|d| d.to_rfc3339()).collect())
}

/// The next time a rule gives after now, or null when it has ended.
pub fn rrule_next(rule_text: &str) -> Result<Option<String>, String> {
    let s = set(rule_text)?;
    let now = chrono::Utc::now().with_timezone(&s.get_dt_start().timezone());
    Ok(s.after(now).all(1).dates.first().map(|d| d.to_rfc3339()))
}
