// Go game records: an SGF file read, its variations listed, a game replayed with captures and ko,
// an illegal move refused, a position scored, and a new record written.
//
//   quillo run go_sgf.qwe
//   then open http://localhost:8080/read, /moves, /replay, /ko, /score, /write and /refused

use "go_sgf.qwer"

// A short game with a comment holding an escaped bracket, a pass, and two variations.
let game = "(;GM[1]FF[4]CA[UTF-8]SZ[9]KM[6.5]PB[Ada]BR[3k]PW[Bob]WR[2k]DT[2026-11-01]RE[W+3.5]C[A friendly game \\[teaching\\]]
;B[ee]C[Tengen];W[cc]
(;B[gc];W[cg];B[tt])
(;B[ge]C[A slower line];W[cg]
(;B[gg])
(;B[gc];W[ee])))"

route GET /read {
    let g = first(sgf_parse(game)?)
    { info: g.info, result: g.result, moves: g.moves, nodes: g.nodes, variations: g.variations, root: first(first(g.tree).nodes).C }
}

route GET /moves = {
    main: sgf_moves(game, {})?,
    second: sgf_moves(game, { path: [1, 0] })?,
    lines: sgf_variations(game)?,
}

// Black takes the white stone at E5 in the corner of a little fight.
let capture = "(;SZ[9];B[dd];W[ee];B[ed];W[tt];B[fe];W[tt];B[ef];W[tt];B[de])"

// A ko: black takes at D5; white may not take back at once, but may after a move elsewhere.
let ko = "(;SZ[9]AB[cd][dc][de]AW[ec][ee][fd][dd];B[ed];W[dd])"
let ko_waited = "(;SZ[9]AB[cd][dc][de]AW[ec][ee][fd][dd];B[ed];W[aa];B[ba];W[dd])"

route GET /replay {
    let r = go_replay(capture, {})?
    {
        board: r.board,
        captured: r.captured,
        to_play: r.to_play,
        halfway: go_replay(capture, { move: 3 })?.board[3],
        last: last(r.log),
    }
}

route GET /ko = {
    position: go_replay(ko, { move: 1 })?.ko,
    refused: go_replay(ko, {}).error,
    after_a_threat: go_replay(ko_waited, {})?.captured,
}

let life = "XXXXOOOO.
XXXXOOOO.
XXXXOOOOO
XXXXOOOOO
XXXXOOOOO
XXXXOOOOO
XXXXOOOOO
XX.XO.OOO
XXXXOOOOO"

let dead_stone = ".X.O.
XX.OO
.X.O.
XX.OO
.XOO.
"

route GET /score = {
    file: go_score(game, { path: [0] })?,
    board: go_score(life, {})?,
    even: go_score(life, { komi: 0.0 })?.result,
    with_dead: go_score(dead_stone, { komi: 0.5, dead: ["C1"] })?,
    without: go_score(dead_stone, { komi: 0.5 })?.result,
}

route GET /write {
    let g = first(sgf_parse(game)?)
    let text = sgf_write(g.tree)?
    {
        same_moves: sgf_moves(text, { path: [1, 1] })? == sgf_moves(game, { path: [1, 1] })?,
        escaped: contains(text, "[teaching\\]"),
        built: sgf_from_moves(["D4", "F6", "pass", "J9"], { size: 9, komi: 6.5, black: "Ada", white: "Bob" })?,
    }
}

// Forks 80 deep, as a teaching file might have: too deep to be nested maps.
fn deep(n) = reduce(range(n), "", (rest, i) => "(;B[aa];W[bb]" + rest + "(;B[cc]))")

route GET /deep {
    let text = "(;SZ[9]" + deep(80) + ")"
    let g = first(sgf_parse(text)?)
    { variations: g.variations, branches: len(g.tree), same: sgf_write(g.tree)? == text }
}

route GET /refused = {
    taken: go_replay("(;SZ[9];B[ee];W[ee])", {}).error,
    suicide: go_replay("(;SZ[9]AB[ba][ab];W[aa])", {}).error,
    allowed: go_replay("(;SZ[9]AB[ba][ab];W[aa])", { suicide: true })?.captured,
    superko: go_replay("(;SZ[5];B[aa];W[tt])", { superko: true })?.moves,
    broken: sgf_parse("(;GM[1]SZ[9").error,
    no_tree: sgf_parse("hello").error,
    off: sgf_moves("(;SZ[9];B[zz])", {}).error,
    fork: sgf_moves(game, { path: [5] }).error,
    dead: go_score(life, { dead: ["C2"] }).error,
    column: sgf_from_moves(["I3"], {}).error,
    tree: sgf_write([{ parent: 3, nodes: [] }]).error,
}
