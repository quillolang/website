// Order confirmations sent through whichever email API the shop has a key for, chosen by
// MAIL_PROVIDER, with the invoice attached.
//
//   MAIL_PROVIDER=resend RESEND_API_KEY=re_... MAIL_FROM="Shop <shop@example.com>" quillo run mail_api.qwe
//   then open http://localhost:8080/confirm and http://localhost:8080/preview
//
// MAIL_API_URL (here SINK_URL, in tests) points every provider at another server.

use "mail_api.qwer"

let PROVIDER = env("MAIL_PROVIDER", "resend")
let CONFIG = { base_url: env("MAIL_API_URL", null) ?? env("SINK_URL", null), domain: env("MAILGUN_DOMAIN", "mg.example.com") }

fn confirmation(to) = {
    from: env("MAIL_FROM", "Quillo Shop <shop@example.com>"),
    to,
    subject: "Your order A-1042",
    text: "Thanks! Your order A-1042 is on its way.",
    html: "<p>Thanks! Your order <b>A-1042</b> is on its way.</p>",
    reply_to: "help@example.com",
    tags: ["order-confirmation"],
    attachments: [{ path: "mail_api_sample.txt", filename: "invoice-A-1042.txt", content_type: "text/plain" }],
}

route GET /confirm = mailapi_send(PROVIDER, CONFIG, confirmation("Ada Lovelace <ada@example.org>"))?

// The same message as each provider wants it.
route GET /preview = {
    resend: mailapi_request("resend", CONFIG, confirmation("ada@example.org"))?.body,
    postmark: mailapi_request("postmark", CONFIG, confirmation("ada@example.org"))?.body.To,
    sendgrid: mailapi_request("sendgrid", CONFIG, confirmation("Ada Lovelace <ada@example.org>"))?.body.personalizations,
    mailgun: mailapi_request("mailgun", CONFIG, { ...confirmation("ada@example.org"), attachments: [] })?.url,
    missing: mailapi_request("resend", CONFIG, { to: "ada@example.org", subject: "Hi" }).error,
}
