// An API that takes the identity provider's tokens: the key is picked from its JWKS by `kid`.
//
//   quillo run jwks.qwe      then open http://localhost:8080/check
//
// In a real app the JWKS comes from the provider, fetched now and then:
//   let JWKS = http.get("https://YOUR_TENANT.auth0.com/.well-known/jwks.json")?.body
// Here it is a sample file, and the sample private key stands in for the provider.

use "jwks.qwer"

let JWKS = read_file("jwks_sample.json")?
let ISSUER = "https://id.example.com/"
let AUDIENCE = "orders-api"

fn signed_in(req) {
    let token = replace(req.headers.authorization ?? "", "Bearer ", "")
    let claims = jwks_verify(token, JWKS, AUDIENCE, ISSUER)
    if is_err(claims) { reply 401 { error: claims.error } }
    claims
}

route GET /keys = jwks_keys(JWKS)?

route GET /check {
    let key = read_file("jwks_sample_key.pem")?
    let token = jwks_sign({ sub: "user-42", aud: AUDIENCE, iss: ISSUER }, key, "2026-11-key-1", 300)?
    let wrong_audience = jwks_sign({ sub: "user-42", aud: "billing", iss: ISSUER }, key, "2026-11-key-1", 300)?
    let unknown_kid = jwks_sign({ sub: "user-42", aud: AUDIENCE, iss: ISSUER }, key, "old-key", 300)?
    {
        user: jwks_verify(token, JWKS, AUDIENCE, ISSUER)?.sub,
        wrong_audience: jwks_verify(wrong_audience, JWKS, AUDIENCE, ISSUER).error,
        unknown_kid: jwks_verify(unknown_kid, JWKS, AUDIENCE, ISSUER).error,
    }
}

route GET /me = request | signed_in | ((c) => { user: c.sub })

// What a token must have. One with no `exp` is good for ever, and one with no `aud` or `iss`
// could be meant for anything the provider signs: each is refused when it matters. jwks_check
// takes options, and allows a token with no `exp` only when told to.
route GET /strict {
    let key = read_file("jwks_sample_key.pem")?
    let kid = "2026-11-key-1"
    let secs = floor(now() / 1000)
    let forever = jwks_sign({ sub: "mallory" }, key, kid, 0)?
    let no_aud = jwks_sign({ sub: "user-42", iss: ISSUER }, key, kid, 300)?
    let no_iss = jwks_sign({ sub: "user-42", aud: AUDIENCE }, key, kid, 300)?
    let lasting = jwks_sign({ sub: "user-42", aud: AUDIENCE, iss: ISSUER }, key, kid, 0)?
    let old = jwks_sign({ sub: "user-42", aud: AUDIENCE, iss: ISSUER, exp: 1000000000 }, key, kid, 0)?
    let early = jwks_sign({ sub: "user-42", aud: AUDIENCE, iss: ISSUER, nbf: secs + 3600 }, key, kid, 7200)?
    {
        no_exp: jwks_verify(forever, JWKS, AUDIENCE, ISSUER).error,
        no_aud: jwks_verify(no_aud, JWKS, AUDIENCE, ISSUER).error,
        no_iss: jwks_verify(no_iss, JWKS, AUDIENCE, ISSUER).error,
        expired: jwks_verify(old, JWKS, AUDIENCE, ISSUER).error,
        not_yet: jwks_verify(early, JWKS, AUDIENCE, ISSUER).error,
        allowed_no_exp: jwks_check(lasting, JWKS, { audience: AUDIENCE, issuer: ISSUER, allow_no_exp: true })?.sub,
        still_needs_aud: jwks_check(forever, JWKS, { audience: AUDIENCE, allow_no_exp: true }).error,
        none_asked: jwks_verify(no_aud, JWKS, "", ISSUER)?.sub,
        bad_option: jwks_check(lasting, JWKS, { audiance: AUDIENCE }).error,
    }
}

// jwks_check's options are checked: a list for `audience` or `issuer` means any of them, and an
// option of the wrong type is an error, never a check quietly left undone.
route GET /options {
    let key = read_file("jwks_sample_key.pem")?
    let kid = "2026-11-key-1"
    let mine = jwks_sign({ sub: "user-42", aud: AUDIENCE, iss: ISSUER }, key, kid, 300)?
    let other = jwks_sign({ sub: "user-42", aud: "billing", iss: ISSUER }, key, kid, 300)?
    let no_aud = jwks_sign({ sub: "user-42", iss: ISSUER }, key, kid, 300)?
    let nbf_text = jwks_sign({ sub: "user-42", aud: AUDIENCE, iss: ISSUER, nbf: "99999999999" }, key, kid, 300)?
    {
        listed: jwks_check(mine, JWKS, { audience: ["billing", AUDIENCE], issuer: [ISSUER] })?.sub,
        not_listed: jwks_check(other, JWKS, { audience: [AUDIENCE], issuer: [ISSUER] }).error,
        audience_number: jwks_check(no_aud, JWKS, { audience: 5 }).error,
        allow_as_text: jwks_check(mine, JWKS, { allow_no_exp: "yes" }).error,
        leeway_too_long: jwks_check(mine, JWKS, { leeway: 99999999 }).error,
        nbf_not_a_number: jwks_verify(nbf_text, JWKS, AUDIENCE, ISSUER).error,
        audience_unset: jwks_check(other, JWKS, { audience: env("NO_SUCH_AUDIENCE"), issuer: ISSUER }).error,
    }
}
