// A podcast page: each episode's length and tags, and its cover art served beside it.
//
//   quillo run audio_info.qwe      then open http://localhost:8080/episode

use "audio_info.qwer"

let EPISODE = "audio_info_sample.mp3"

fn mmss(seconds) = `${floor(seconds / 60)}:${slice(str(100 + round(seconds) % 60), 1, 3)}`

route GET /episode {
    let info = audio_info(EPISODE)?
    merge(info, { length: mmss(info.duration) })
}

route GET /cover {
    let path = audio_cover(EPISODE, "data/covers/episode-1")?
    file(path)
}

route GET / {
    let info = audio_info(EPISODE)?
    <html><body>
        <img src="/cover" width="120" alt=""/>
        <h1>{info.title}</h1>
        <p>{info.artist} · {info.album} · {mmss(info.duration)}</p>
        <audio controls src="/episode.mp3"></audio>
    </body></html>
}

route GET /episode.mp3 = file(EPISODE)
