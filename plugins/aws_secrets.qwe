// A program's credentials and settings kept in AWS: a database password read from Secrets Manager
// (and not asked for again on each request), the password before it, where a rotation stands, and
// a site's settings read from Parameter Store by path, with a parameter's history.
//
//   AWS_REGION=eu-west-1 AWS_ACCESS_KEY_ID=... AWS_SECRET_ACCESS_KEY=... quillo run aws_secrets.qwe
//   then open http://localhost:8080/secret, /cache, /rotation, /put, /params and /missing
//
// It wants a secret prod/db holding JSON, and parameters under /app/prod/. SECRETSMANAGER_API_URL
// and SSM_API_URL reach LocalStack or a test server.

use "aws_secrets.qwer"

route GET /secret {
    let s = secrets_get("prod/db", { cache_ms: 0 })?
    let old = secrets_get("prod/db", { stage: "AWSPREVIOUS", cache_ms: 0 })?
    { name: s.name, stages: s.stages, user: secrets_json("prod/db", {})?.username, port: secrets_json("prod/db", {})?.port, previous: json.parse(old.value)?.password }
}

// Ten reads, one request: the stand-in counts them, /calls says how many it had.
route GET /cache {
    secrets_forget()
    for i in range(0, 10) { secrets_get("prod/api-key", { cache_ms: 60000 })? }
    { value: secrets_get("prod/api-key", {})?.value, calls: http.get(env("SECRETSMANAGER_API_URL", "") + "/_calls").json.calls }
}

route GET /rotation = {
    stable: secrets_rotation("prod/db", {})?,
    midway: secrets_rotation("prod/rotating", {})?.state,
    never: secrets_rotation("prod/api-key", {})?.state,
    versions: len(secrets_versions("prod/db", {})?),
}

route GET /put {
    let put = secrets_put("prod/db", { username: "app", password: "new-one", port: 5432 }, {})?
    let read = secrets_json("prod/db", { cache_ms: 0 })?
    { stage: put.stages, password: read.password, rotated: len(secrets_rotate("prod/db", {})?) > 0 }
}

route GET /params {
    let all = param_path("/app/prod/", {})?
    param_put("/app/prod/banner", "Back at 9", { overwrite: true })?
    {
        count: len(all),
        host: param_get("/app/prod/db/host", { cache_ms: 0 })?.value,
        secure: param_get("/app/prod/token", { cache_ms: 0 })?,
        shown: param_get("/app/prod/token", { decrypt: false, cache_ms: 0 })?.value != "open-sesame",
        config: param_map("/app/prod/", {})?,
        history: map(param_history("/app/prod/banner", {})?, (p) => p.value),
        taken: param_put("/app/prod/banner", "x", {}).error,
    }
}

route GET /missing = {
    secret: secrets_get("prod/nothing", {}).error,
    param: param_get("/app/nothing", {}).error,
    not_json: secrets_json("prod/api-key", {}).error,
}
