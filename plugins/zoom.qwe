// Meetings run through Zoom: one scheduled, changed and deleted, lists past one page, who attended,
// and webhooks with their validation challenge.
//
//   ZOOM_ACCOUNT_ID=... ZOOM_CLIENT_ID=... ZOOM_CLIENT_SECRET=... ZOOM_WEBHOOK_SECRET=... quillo run zoom.qwe
//   then open /meeting, /lists, /uuids, /hook-check and /failures
//
// ZOOM_API_URL and ZOOM_OAUTH_URL reach a test server. Point an event subscription at POST
// /zoom/webhook: Zoom sends a challenge to it first, and every 72 hours.

use "zoom.qwer"

route GET /meeting {
    let m = zoom_meeting_create("me", { topic: "Launch review", start_time: "2026-11-20T10:00:00Z", duration: 45, password: "mugs" })?
    zoom_meeting_update(m.id, { topic: "Launch review, again" })?
    let read = zoom_meeting(m.id)?
    {
        kind: m.type, joins: contains(m.join_url, str(m.id)), topic: read.topic, minutes: read.duration,
        ended: zoom_meeting_end(m.id)?,
        deleted: zoom_meeting_delete(m.id, true)?,
        gone: zoom_meeting(m.id).error,
        long_password: zoom_meeting_create("me", { password: "12345678901" }).error,
        no_zone: zoom_meeting_create("me", { start_time: "2026-11-20T10:00:00" }).error,
        bad_time: zoom_meeting_create("me", { start_time: "tomorrow" }).error,
        bad_field: zoom_meeting_create("me", { topic: repeat("x", 201) }).error,
    }
}

route GET /lists = {
    meetings: len(zoom_meetings("me", "scheduled", 0)?),
    capped: len(zoom_meetings("me", "", 350)?),
    users: len(zoom_users("active", 0)?),
    attended: map(zoom_past_participants("/abc//def==", 0)?, (p) => p.name),
    plain_uuid: len(zoom_past_participants("abcdef==", 0)?),
}

route GET /uuids = {
    plain: zoom_uuid("4444AAAiAAAAAiAiAiiAii=="),
    slash: zoom_uuid("/ajXp112QmuoKj4854875=="),
    double: zoom_uuid("ab//cd=="),
}

route POST /zoom/webhook {
    let hook = zoom_webhook(request.headers, request.body, env("ZOOM_WEBHOOK_SECRET", ""), 300)
    if is_err(hook) { reply 401 hook.error }
    if hook.challenge != null { hook.challenge } else { { got: hook.event } }
}

// Signatures made outside this plugin, by node's crypto, on an old timestamp: 0 skips its age.
route GET /hook-check {
    let body = "{\"event\":\"meeting.started\",\"payload\":{\"object\":{\"id\":\"1\"}},\"event_ts\":1730000000000}"
    let challenge = "{\"event\":\"endpoint.url_validation\",\"payload\":{\"plainToken\":\"qgg8vlvZRS6UYooatFL8Aw\"},\"event_ts\":1730000000000}"
    let at = "1730000000"
    let event = { "x-zm-signature": "v0=a09d3aa69a8d211ba6456ff29e2886a16907f2b6ac1054646e80bdef1eaa0860", "x-zm-request-timestamp": at }
    let check = { "x-zm-signature": "v0=ed2b5ec2d5cd286ef879f62623b94df495b286ee68a8686a3b0dd0ece4831974", "x-zm-request-timestamp": at }
    {
        event: zoom_webhook(event, body, "zoom-secret", 0)?.event,
        challenge: zoom_webhook(check, challenge, "zoom-secret", 0)?.challenge,
        direct: zoom_url_validation("qgg8vlvZRS6UYooatFL8Aw", "zoom-secret").encryptedToken,
        too_old: contains(zoom_webhook(event, body, "zoom-secret", 300).error, "more than the 300 s allowed"),
        tampered: zoom_webhook(event, body + " ", "zoom-secret", 0).error,
        other_secret: zoom_webhook(event, body, "other", 0).error,
        unsigned: zoom_webhook({}, body, "zoom-secret", 0).error,
        bad_form: zoom_webhook({ "x-zm-signature": "abc", "x-zm-request-timestamp": at }, body, "zoom-secret", 0).error,
    }
}

route GET /failures = {
    missing: zoom_meeting(1).error,
    waited: zoom_call("get", "/busy", null)?.ok,
    daily: zoom_call("get", "/daily", null).error,
    renewed: zoom_call("get", "/expire", null)?.ok,
}
