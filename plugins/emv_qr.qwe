// EMV merchant-presented QR codes: a Thai PromptPay code, a Singapore PayNow code and a Malaysian
// DuitNow code, a code of your own scheme, and any code read back, a broken one refused.
//
//   quillo run emv_qr.qwe      then open http://localhost:8080/promptpay, /paynow, /duitnow, /custom, /read, /code.svg and /refused

use "emv_qr.qwer"

route GET /promptpay = {
    mobile: emv_qr_promptpay({ mobile: "081-234-5678" })?,
    amount: emv_qr_promptpay({ national_id: "1234567890123", amount: "420" })?,
    read: emv_qr_parse(emv_qr_promptpay({ mobile: "0812345678" })?)?.schemes,
}

route GET /paynow {
    let code = emv_qr_paynow({ uen: "201403121W", name: "Kopi Corner", amount: "12.5", reference: "INV-77", editable: false, expiry: "20261231" })?
    let r = emv_qr_parse(code)?
    { code: code, scheme: r.schemes[0].scheme, proxy: r.schemes[0].fields, amount: r.amount, reference: r.additional.bill_number }
}

route GET /duitnow = {
    // PayNet's first example: the code it prints, made here.
    made: emv_qr_duitnow({ acquirer_id: "501664", qr_id: "123456789", name: "QRCSDNBHD", city: "BANGI", category: "9999", amount: "10" })?,
    read: emv_qr_parse("00020201021126410014A000000615000101065016640209123456789520499995303458540510.005802MY5909QRCSDNBHD6005BANGI6304343F")?.schemes,
}

// Any other scheme: the tags given directly, a template as a nested map.
route GET /custom {
    let code = emv_qr_build({
        "01": "11",
        "27": { "00": "com.example.pay", "01": "MERCHANT42" },
        "52": "5812", "53": "840", "58": "US", "59": "Blue Bottle", "60": "Oakland",
        "62": { "03": "STORE7", "07": "TILL2" },
        "64": { "00": "ZH", "01": "蓝瓶" },
    })?
    let r = emv_qr_parse(code)?
    { code: code, additional: r.additional, language: r.language, tree: emv_qr_tlv(code)?[2] }
}

route GET /code.svg = respond(200, emv_qr_svg(emv_qr_promptpay({ mobile: "0812345678" })?, 300)?, { "content-type": "image/svg+xml" })

route GET /refused {
    let good = emv_qr_promptpay({ mobile: "0812345678", amount: "10" })?
    {
        changed: emv_qr_parse(replace(good, "10.00", "90.00")).error,
        short: emv_qr_parse("000201010211").error,
        runs_off: emv_qr_tlv("00020129990016A0000006").error,
        no_id: emv_qr_promptpay({}).error,
        long: emv_qr_build({ "59": repeat("x", 120) }).error,
    }
}
