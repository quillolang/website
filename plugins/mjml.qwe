// A "your order has shipped" email from an MJML template, filled in per customer and shown in the browser.
//
//   quillo run mjml.qwe      then open http://localhost:8080/email

use "mjml.qwer"

let TEMPLATE = read_file("mjml_sample.mjml")?

fn rows(lines) = join(lines | map((l) => `<tr><td>${escape(l.item)}</td><td align="right">${l.qty} × €${l.price}</td></tr>`), "")

fn shipped_email(name, order) = mjml_render(TEMPLATE, { name, order, rows: rows(order.lines) })

let order = { id: "A-1042", arrives: "Friday", url: "https://shop.example/track/A-1042",
              lines: [{ item: "Notebook", qty: 2, price: "4.99" }, { item: "Pen <blue>", qty: 3, price: "1.25" }] }

route GET /email = raw(shipped_email("Ada & co", order)?.html)

route GET /subject {
    let e = shipped_email("Ada", order)?
    { subject: e.title, preview: e.preview, bytes: len(e.html) > 1000 }
}

route GET /check = { good: mjml_check(TEMPLATE).ok, broken: mjml_check("<mjml><mj-body><mj-section></mj-body></mjml>").ok, missing: mjml_render(TEMPLATE, { name: "Ada" }).error }
