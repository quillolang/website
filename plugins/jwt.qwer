//! JSON Web Tokens: sign and verify HS256 tokens, check a token's audience and issuer, verify RS256, ES256 and EdDSA tokens against a key or an identity provider's JWKS, and sign ES256 tokens such as Sign in with Apple's client secret.
//! version: 3.0.0
//! effects: http, time
//! From 2.x: a token with no `aud` or `iss` is refused when an audience or an issuer is asked for (have such tokens name them, or stop asking), and an option not known or of the wrong type is an error.
//!
//! [dependencies]
//! jsonwebtoken = "9"
//! ureq = "2"

use jsonwebtoken::{decode, decode_header, encode, Algorithm, DecodingKey, EncodingKey, Header, Validation};
use serde_json::Value;
use std::collections::HashMap;
use std::sync::Mutex;
use std::time::{Duration, Instant};

fn now() -> i64 {
    std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_secs() as i64)
}

/// The checks every verifier makes: the signature, `exp` (which a token must have: one without
/// is good for ever), `nbf`, and 30 s of leeway for clocks that differ. `aud` is checked only when
/// one is asked for, so a token that names one is not refused for it; when one is asked for, a
/// token must have it (see `checked`).
fn validation(alg: Algorithm) -> Validation {
    let mut v = Validation::new(alg);
    v.required_spec_claims = ["exp".to_string()].into_iter().collect();
    v.validate_nbf = true;
    v.validate_aud = false;
    v.leeway = 30;
    v
}

/// The longest leeway taken: a day. More would take tokens that ended long ago.
const MOST_LEEWAY: u64 = 86400;

/// Whether an audience and an issuer were asked for, so a token must have them.
struct Asked {
    audience: bool,
    issuer: bool,
}

/// An option that is a text, or a list of texts (any of them will do), none of them empty; `None`
/// when it is not given. Given as null, it is an error: `{ audience: env("JWT_AUDIENCE") }` with the
/// variable unset turned the check off (quillo FEEDBACK78.md, Q-1150, found in review; quillo-website
/// branch auth-plugins).
fn texts(options: &Value, k: &str) -> Result<Option<Vec<String>>, String> {
    match options.as_object().and_then(|o| o.get(k)) {
        None => Ok(None),
        Some(Value::Null) => Err(format!("option `{}` is null: leave it out to check no {}, or give a text", k, k)),
        Some(Value::String(t)) if !t.is_empty() => Ok(Some(vec![t.clone()])),
        Some(Value::Array(l)) if !l.is_empty() && l.iter().all(|x| x.as_str().is_some_and(|t| !t.is_empty())) => Ok(Some(l.iter().filter_map(|x| x.as_str().map(str::to_string)).collect())),
        Some(_) => Err(format!("option `{}` is a text, or a list of texts, none of them empty", k)),
    }
}

/// `options` of `jwt_check` and `jwt_verify_jwks` (which also takes `jwks_url` and `algorithms`):
/// `audience` and `issuer` (a text, or a list of texts the token's must be one of), `require`
/// (claims a token must have, `exp` by default; `[]` for none) and `leeway` (seconds, at most a
/// day). `aud` and `iss` are required whenever `audience` and `issuer` are given, whatever
/// `require` says. An option not known, or of the wrong type, is an error: read as text only, a
/// list given for `audience` was skipped, and with it the check (quillo FEEDBACK78.md, Q-1150,
/// found in review; quillo-website branch auth-plugins).
fn apply(v: &mut Validation, options: &Value, more: &[&str]) -> Result<Asked, String> {
    let known = ["audience", "issuer", "require", "leeway"];
    match options {
        Value::Object(o) => {
            for k in o.keys() {
                if !known.contains(&k.as_str()) && !more.contains(&k.as_str()) {
                    let all: Vec<&str> = known.iter().chain(more.iter()).copied().collect();
                    return Err(format!("no option `{}` ({})", k, all.join(", ")));
                }
            }
        }
        Value::Null => {}
        _ => return Err("the options are a map".into()),
    }
    let audience = texts(options, "audience")?;
    if let Some(a) = &audience {
        v.set_audience(a);
        v.validate_aud = true;
    }
    let issuer = texts(options, "issuer")?;
    if let Some(i) = &issuer {
        v.set_issuer(i);
    }
    match &options["require"] {
        Value::Null => {}
        Value::Array(r) if r.iter().all(Value::is_string) => v.required_spec_claims = r.iter().filter_map(|c| c.as_str().map(str::to_string)).collect(),
        _ => return Err("option `require` is a list of claim names".into()),
    }
    match &options["leeway"] {
        Value::Null => {}
        l => match l.as_u64() {
            Some(n) if n <= MOST_LEEWAY => v.leeway = n,
            _ => return Err(format!("option `leeway` is a whole number of seconds, at most {} (a day)", MOST_LEEWAY)),
        },
    }
    Ok(Asked { audience: audience.is_some(), issuer: issuer.is_some() })
}

/// What jsonwebtoken leaves unchecked. A token's `aud` and `iss` must be there whenever an audience
/// and an issuer are asked for: jsonwebtoken checks them only when a token has them, so a token that
/// named neither passed as an `orders` token: one signed with the same key for another use (an
/// unsubscribe link, an email check), or a provider's token for no audience (quillo FEEDBACK78.md,
/// Q-1150; quillo-website branch auth-plugins). Asked in a fixed order, so the error always names the
/// same claim; a value of the wrong type (a number, a map), which jsonwebtoken skips, counts as
/// missing. And an `exp` or `nbf` that is not a whole number of seconds is refused, where jsonwebtoken
/// skips it (found in review).
fn checked(claims: Value, asked: &Asked) -> Result<Value, String> {
    for k in ["exp", "nbf"] {
        if !claims[k].is_null() && claims[k].as_u64().is_none() {
            return Err(format!("the token's {} is not a whole number of seconds", k));
        }
    }
    if asked.audience {
        let ok = match &claims["aud"] {
            Value::String(s) => !s.is_empty(),
            Value::Array(l) => !l.is_empty() && l.iter().all(Value::is_string),
            _ => false,
        };
        if !ok {
            return Err("Missing required claim: aud".into());
        }
    }
    if asked.issuer && !claims["iss"].as_str().is_some_and(|i| !i.is_empty()) {
        return Err("Missing required claim: iss".into());
    }
    Ok(claims)
}

/// A token for `claims`, signed with HMAC-SHA256: `iat` is added, and `exp` when `expires_in` (seconds) is above 0.
pub fn jwt_sign(claims: serde_json::Value, secret: &str, expires_in: i64) -> Result<String, String> {
    let Value::Object(mut c) = claims else { return Err("the claims are a map".into()) };
    c.insert("iat".into(), now().into());
    if expires_in > 0 {
        c.insert("exp".into(), (now() + expires_in).into());
    }
    encode(&Header::default(), &Value::Object(c), &EncodingKey::from_secret(secret.as_bytes())).map_err(|e| e.to_string())
}

/// The claims of an HS256 token signed with `secret`, or an error: a bad signature, an expired token, one with no `exp`, another algorithm.
/// It checks no audience and no issuer, so any token signed with `secret` passes: for an API, use `jwt_check` with `audience`.
pub fn jwt_verify(token: &str, secret: &str) -> Result<Value, String> {
    let claims = decode::<Value>(token, &DecodingKey::from_secret(secret.as_bytes()), &validation(Algorithm::HS256)).map(|d| d.claims).map_err(|e| e.to_string())?;
    checked(claims, &Asked { audience: false, issuer: false })
}

/// `jwt_verify`, with `options`: `audience` (`aud` must name it, or one of them when it is a list), `issuer` (`iss` must be it, or one of them), `require` (the claims it must have, `["exp"]` unless given) and `leeway` (seconds, at most 86400). A token with no `aud` when `audience` is given, or no `iss` when `issuer` is, is refused, whatever `require` says. An option not known, or of the wrong type, is an error.
/// From 2.x: a token with no `aud` (or `iss`) is now refused when `audience` (or `issuer`) is given, here, in `jwt_verify_jwks` and in `jwt_verify_rs256`.
pub fn jwt_check(token: &str, secret: &str, options: serde_json::Value) -> Result<Value, String> {
    let mut v = validation(Algorithm::HS256);
    let asked = apply(&mut v, &options, &[])?;
    let claims = decode::<Value>(token, &DecodingKey::from_secret(secret.as_bytes()), &v).map(|d| d.claims).map_err(|e| e.to_string())?;
    checked(claims, &asked)
}

/// The claims of an RS256 token, checked with the issuer's public key (PEM) and its audience (`aud`, which the token must have; empty for none).
pub fn jwt_verify_rs256(token: &str, public_key_pem: &str, audience: &str) -> Result<Value, String> {
    let key = DecodingKey::from_rsa_pem(public_key_pem.as_bytes()).map_err(|e| e.to_string())?;
    let mut v = validation(Algorithm::RS256);
    if !audience.is_empty() {
        v.set_audience(&[audience]);
        v.validate_aud = true;
    }
    let claims = decode::<Value>(token, &key, &v).map(|d| d.claims).map_err(|e| e.to_string())?;
    checked(claims, &Asked { audience: !audience.is_empty(), issuer: false })
}

/// Each JWKS fetched: its keys, when, and when a token with a new `kid` last fetched it again.
static JWKS: Mutex<Option<HashMap<String, (jsonwebtoken::jwk::JwkSet, Instant, Option<Instant>)>>> = Mutex::new(None);

fn jwks(url: &str, again: bool) -> Result<jsonwebtoken::jwk::JwkSet, String> {
    let held = JWKS.lock().unwrap().as_ref().and_then(|c| c.get(url).cloned());
    if let Some((set, at, forced)) = &held {
        // A `kid` nobody knows fetches the keys again, at most every 30 s, so a forged token cannot make us flood the provider.
        let keep = if again { forced.is_some_and(|f| f.elapsed() < Duration::from_secs(30)) } else { at.elapsed() < Duration::from_secs(600) };
        if keep {
            return Ok(set.clone());
        }
    }
    let local = ["http://localhost", "http://127.0.0.1", "http://[::1]"].iter().any(|p| url.starts_with(p));
    if !url.starts_with("https://") && !local {
        return Err(format!("the JWKS `{}` is not https", url));
    }
    let text = ureq::AgentBuilder::new().timeout(Duration::from_secs(10)).build().get(url).call().map_err(|e| format!("{}: {}", url, e))?.into_string().map_err(|e| e.to_string())?;
    let set: jsonwebtoken::jwk::JwkSet = serde_json::from_str(&text).map_err(|e| format!("{} is not a JWKS: {}", url, e))?;
    let forced = if again { Some(Instant::now()) } else { held.and_then(|h| h.2) };
    JWKS.lock().unwrap().get_or_insert_with(HashMap::new).insert(url.to_string(), (set.clone(), Instant::now(), forced));
    Ok(set)
}

/// The claims of an access token from an identity provider, checked against its JWKS: `options` has `jwks_url`, and `audience`, `issuer`, `require`, `leeway` as `jwt_check` takes them (so a token with no `aud` or `iss` is refused when they are given), and `algorithms` (a list: RS256, ES256 and EdDSA by default; never HS256 or `none`). A `kid` the keys do not have fetches them again. An option not known, or of the wrong type, is an error.
pub fn jwt_verify_jwks(token: &str, options: serde_json::Value) -> Result<Value, String> {
    let mut v = validation(Algorithm::RS256);
    apply(&mut v, &options, &["jwks_url", "algorithms"])?;
    let url = options["jwks_url"].as_str().filter(|u| !u.is_empty()).ok_or("option `jwks_url`, the identity provider's keys, is a text")?;
    let header = decode_header(token).map_err(|e| e.to_string())?;
    let allowed: Vec<String> = match &options["algorithms"] {
        Value::Null => vec!["RS256".into(), "ES256".into(), "EdDSA".into()],
        Value::Array(l) if !l.is_empty() && l.iter().all(Value::is_string) => l.iter().filter_map(|a| a.as_str().map(str::to_string)).collect(),
        _ => return Err("option `algorithms` is a list of algorithm names, such as [\"RS256\"]".into()),
    };
    let name = format!("{:?}", header.alg);
    if name.starts_with("HS") || !allowed.iter().any(|a| *a == name) {
        return Err(format!("algorithm `{}` is refused: {} are taken", name, allowed.join(", ")));
    }
    let kid = header.kid.clone();
    let find = |set: &jsonwebtoken::jwk::JwkSet| match &kid {
        Some(k) => set.find(k).cloned(),
        None if set.keys.len() == 1 => set.keys.first().cloned(),
        None => None,
    };
    let key = match find(&jwks(url, false)?) {
        Some(k) => k,
        None => find(&jwks(url, true)?).ok_or_else(|| format!("no key in {} for kid {}", url, kid.as_deref().unwrap_or("(none)")))?,
    };
    let mut v = validation(header.alg);
    let asked = apply(&mut v, &options, &["jwks_url", "algorithms"])?;
    let key = DecodingKey::from_jwk(&key).map_err(|e| e.to_string())?;
    let claims = decode::<Value>(token, &key, &v).map(|d| d.claims).map_err(|e| e.to_string())?;
    checked(claims, &asked)
}

/// A token for `claims` signed ES256 with a P-256 private key (PKCS#8 PEM, as Apple's `.p8` file is), with `kid` in its header: Sign in with Apple's client secret is one, with `iss` your team id, `sub` the client id and `aud` `https://appleid.apple.com` (Apple takes at most 15777000 s, six months). `iat` is added, and `exp` when `expires_in` (seconds) is above 0.
pub fn jwt_sign_es256(claims: serde_json::Value, private_key_pem: &str, kid: &str, expires_in: i64) -> Result<String, String> {
    // Sign in with Apple's token endpoint takes only a client secret that is an ES256 JWT, which no
    // plugin signed (quillo FEEDBACK78.md, Q-1161; quillo-website branch auth-plugins).
    let Value::Object(mut c) = claims else { return Err("the claims are a map".into()) };
    c.insert("iat".into(), now().into());
    if expires_in > 0 {
        c.insert("exp".into(), (now() + expires_in).into());
    }
    let mut h = Header::new(Algorithm::ES256);
    if !kid.is_empty() {
        h.kid = Some(kid.to_string());
    }
    let key = EncodingKey::from_ec_pem(private_key_pem.trim().as_bytes()).map_err(|e| format!("not a P-256 private key in PKCS#8 PEM: {}", e))?;
    encode(&h, &Value::Object(c), &key).map_err(|e| format!("not a P-256 private key in PKCS#8 PEM: {}", e))
}

/// A token's claims without checking anything: to show or log them, never to trust them.
pub fn jwt_peek(token: &str) -> Result<Value, String> {
    let mut v = Validation::new(Algorithm::HS256);
    v.insecure_disable_signature_validation();
    v.required_spec_claims.clear();
    v.validate_exp = false;
    v.validate_aud = false;
    v.algorithms = vec![Algorithm::HS256, Algorithm::HS384, Algorithm::HS512, Algorithm::RS256, Algorithm::RS384, Algorithm::RS512, Algorithm::ES256, Algorithm::ES384, Algorithm::PS256, Algorithm::EdDSA];
    decode::<Value>(token, &DecodingKey::from_secret(&[]), &v).map(|d| d.claims).map_err(|e| e.to_string())
}
