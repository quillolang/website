// Delivery zones kept in PostGIS: drawn on a map as GeoJSON, stored as WKB, logged as WKT.
//
//   quillo run wkt.qwe      then open http://localhost:8080/zones

use "wkt.qwer"

let ZONE = "SRID=4326;POLYGON((4.85 52.35, 4.95 52.35, 4.95 52.40, 4.85 52.40, 4.85 52.35), (4.89 52.37, 4.90 52.37, 4.90 52.38, 4.89 52.37))"

route GET /zones {
    let shape = wkt_to_geojson(ZONE)?
    {
        geojson: shape,
        info: wkt_info(ZONE)?,
        back: wkt_from_geojson(shape, 4326)?,
        // What PostGIS's SELECT ST_AsEWKB('SRID=4326;POINT(1 2)') gives, in hex.
        postgis_point: wkb_to_geojson("0101000020E6100000000000000000F03F0000000000000040")?,
        hex: wkb_from_geojson({ type: "Point", coordinates: [1.0, 2.0] }, 4326)?,
        line_3d: wkt_from_geojson({ type: "LineString", coordinates: [[0, 0, 10], [1, 1, 12.5]] }, 0)?,
        round_trip: wkb_to_wkt(wkb_from_geojson(wkt_to_geojson("MULTIPOINT((1 2), (3 4))")?, 0)?)?,
        bad: wkt_to_geojson("POLYGON((1 2, 3)").error,
    }
}

// POST a GeoJSON geometry, get it ready for the database.
route POST /store {
    let g = request.json
    { wkt: wkt_from_geojson(g, 4326)?, ewkb: wkb_from_geojson(g, 4326)? }
}
