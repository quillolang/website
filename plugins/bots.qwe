// Who is visiting: AI crawlers kept out by robots.txt and refused if they come anyway, link
// previews let in, and a visitor that claims to be Googlebot checked by DNS.
//
//   quillo run bots.qwe      then open http://localhost:8080/robots.txt and http://localhost:8080/who

use "bots.qwer"

route GET /robots.txt = respond(200, bot_robots(["ai_training", "seo"], ["Applebot-Extended"], "https://shop.example.com/sitemap.xml")?, { "content-type": "text/plain" })

route GET /who = {
    gptbot: bot_detect("Mozilla/5.0 AppleWebKit/537.36 (KHTML, like Gecko; compatible; GPTBot/1.2; +https://openai.com/gptbot)"),
    google: bot_detect("Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)"),
    slack: bot_detect("Slackbot-LinkExpanding 1.0 (+https://api.slack.com/robots)").category,
    unknown: bot_detect("Mozilla/5.0 (compatible; ShinyNewCrawler/0.3)"),
    firefox: bot_detect("Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:132.0) Gecko/20100101 Firefox/132.0"),
    // A request from this machine that claims to be Googlebot.
    fake_google: bot_verify("Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)", "127.0.0.1")?,
    ai_training_bots: len(bot_list("ai_training")),
}

// Pages refuse AI training crawlers that ignore robots.txt.
route GET /articles/:id {
    let who = bot_detect(request.headers["user-agent"] ?? "")
    if who.bot && who.category == "ai_training" { reply 403 "AI training crawlers are not allowed here" }
    `Article ${id}`
}
