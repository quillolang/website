// OpenStreetMap extracts: a small `.osm.pbf` read directly, with cafes found, a street given its
// coordinates, a route's members, tags counted, and matches as GeoJSON. For a real one, Geofabrik
// has a file for each country; nothing here needs a database or a download.
//
//   node standins/osm_pbf_sample.mjs      makes the tiny sample file
//   quillo run osm_pbf.qwe
//   then open http://localhost:8080/info, /nodes, /ways, /relations, /tags, /map.geojson and /refused

use "osm_pbf.qwer"

let pbf = "osm_pbf_sample.osm.pbf"

route GET /info = osm_info(pbf)?

route GET /nodes = {
    cafes: osm_nodes(pbf, "amenity=cafe")?,
    drinks: osm_nodes(pbf, "amenity=cafe|pub")? | map((n) => n.tags.name),
    named: osm_nodes(pbf, { tags: { name: true }, not: "amenity=pub" })? | map((n) => n.id),
    in_town: osm_nodes(pbf, { tags: "amenity", bbox: [4.8, 52.3, 5.0, 52.4] })? | map((n) => n.id),
    bare_in_box: osm_nodes(pbf, { bbox: [4.879, 52.359, 4.882, 52.362] })? | map((n) => n.id),
    first_only: len(osm_nodes(pbf, { tags: "name", limit: 1 })?),
    with_meta: first(osm_nodes(pbf, { tags: "shop", meta: true })?).meta,
    plain_block: osm_nodes(pbf, "tourism=museum")?,
}

route GET /ways = {
    streets: osm_ways(pbf, "highway", false)? | map((w) => w.id),
    street: first(osm_ways(pbf, "highway=residential", true)?),
    block: first(osm_ways(pbf, "building", true)?).closed,
    in_box: osm_ways(pbf, { bbox: [4.879, 52.359, 4.882, 52.362] }, false)? | map((w) => w.id),
    no_tags_rule: len(osm_ways(pbf, {}, false)?),
}

route GET /relations = {
    routes: osm_relations(pbf, "route=bicycle")?,
    all: osm_relations(pbf, {})? | map((r) => r.tags.type),
}

route GET /tags = {
    keys: osm_tag_counts(pbf, "", 3)?,
    amenity: osm_tag_counts(pbf, "amenity", 10)?,
}

route GET /map.geojson = osm_geojson(pbf, { tags: { name: true } })?

route GET /refused = {
    no_file: osm_info("nothing.osm.pbf").error,
    not_pbf: osm_info("osm_pbf.qwe").error,
    rule: osm_nodes(pbf, 5).error,
    bbox: osm_nodes(pbf, { bbox: [5, 5, 1, 1] }).error,
    limit: osm_nodes(pbf, { limit: 0 }).error,
}
