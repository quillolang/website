// "Your order has shipped" sent to a customer's phone through Firebase Cloud Messaging.
//
//   FCM_SERVICE_ACCOUNT=firebase-key.json quillo run fcm.qwe      then open http://localhost:8080/ship?device=<token>
//   (fcm_sample.json is a made-up account: the example signs with it, Google would refuse it)
//   FCM_ACCESS_TOKEN and SINK_URL stand in for Google, in tests.

use "fcm.qwer"

let SA = env("FCM_SERVICE_ACCOUNT", "fcm_sample.json")
let FCM_URL = env("SINK_URL", "")

route GET /assertion {
    let a = fcm_assertion(SA)?
    { parts: len(split(a.assertion, ".")), scope: a.claims.scope, iss: a.claims.iss }
}

route GET /ship ? { device: str = "dGVzdC1kZXZpY2UtdG9rZW4", order: str = "A-1042" } {
    let token = env("FCM_ACCESS_TOKEN", null) ?? fcm_access_token(SA, "")?
    let r = fcm_send(SA, token, {
        token: device,
        notification: { title: "Shipped", body: `Order ${order} is on its way` },
        data: { order, link: `/orders/${order}` },
    }, FCM_URL)?
    if r.unregistered { return { sent: false, forget_device: device } }
    { sent: r.ok, status: r.status }
}
