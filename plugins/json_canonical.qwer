//! Canonical JSON (RFC 8785, JCS): the one way to write a value, keys sorted and numbers as JavaScript writes them, so a signature or hash of JSON holds however it was spaced or ordered.
//! version: 1.0.0
//!
//! [dependencies]
//! serde_json = { version = "1", features = ["float_roundtrip"] }
//! ryu-js = "1"
//! sha2 = "0.10"
//! hmac = "0.12"

use hmac::{Hmac, Mac};
use serde_json::Value;
use sha2::{Digest, Sha256};

/// Integers past 2^53 are not exact as JSON numbers in JavaScript, which JCS follows.
const SAFE: i64 = 9_007_199_254_740_991;

fn number(n: &serde_json::Number, out: &mut String) -> Result<(), String> {
    if let Some(i) = n.as_i64() {
        if i.abs() <= SAFE {
            out.push_str(&i.to_string());
            return Ok(());
        }
    }
    if n.as_u64().is_some() || n.as_i64().is_some() {
        return Err(format!("{} is past 2^53, where JSON numbers stop being exact: send it as text", n));
    }
    let f = n.as_f64().ok_or_else(|| format!("{} is not a number JSON can hold", n))?;
    if !f.is_finite() {
        return Err("NaN and infinity have no JSON form".into());
    }
    out.push_str(ryu_js::Buffer::new().format(f));
    Ok(())
}

fn write(v: &Value, out: &mut String, depth: usize) -> Result<(), String> {
    if depth > 512 {
        return Err("nested more than 512 deep".into());
    }
    match v {
        Value::Null => out.push_str("null"),
        Value::Bool(b) => out.push_str(if *b { "true" } else { "false" }),
        Value::Number(n) => number(n, out)?,
        // serde_json escapes as JCS asks: \b \t \n \f \r \" \\, other controls as \u00xx, the rest as it is.
        Value::String(s) => out.push_str(&serde_json::to_string(s).map_err(|e| e.to_string())?),
        Value::Array(a) => {
            out.push('[');
            for (i, x) in a.iter().enumerate() {
                if i > 0 {
                    out.push(',');
                }
                write(x, out, depth + 1)?;
            }
            out.push(']');
        }
        Value::Object(m) => {
            // Keys sorted by their UTF-16 code units, as JavaScript compares strings.
            let mut keys: Vec<(&String, Vec<u16>)> = m.keys().map(|k| (k, k.encode_utf16().collect())).collect();
            keys.sort_by(|a, b| a.1.cmp(&b.1));
            out.push('{');
            for (i, (k, _)) in keys.iter().enumerate() {
                if i > 0 {
                    out.push(',');
                }
                out.push_str(&serde_json::to_string(k).map_err(|e| e.to_string())?);
                out.push(':');
                write(&m[k.as_str()], out, depth + 1)?;
            }
            out.push('}');
        }
    }
    Ok(())
}

fn canon(v: &Value) -> Result<String, String> {
    let mut out = String::new();
    write(v, &mut out, 0)?;
    Ok(out)
}

fn parse(text: &str) -> Result<Value, String> {
    serde_json::from_str(text.trim_start_matches('\u{feff}')).map_err(|e| format!("not JSON: {}", e))
}

fn hex(b: &[u8]) -> String {
    b.iter().map(|x| format!("{:02x}", x)).collect()
}

fn mac(secret: &str, text: &str) -> Hmac<Sha256> {
    let mut m = Hmac::<Sha256>::new_from_slice(secret.as_bytes()).expect("HMAC takes any key length");
    m.update(text.as_bytes());
    m
}

/// `value` as canonical JSON text (RFC 8785): no spaces, map keys sorted by UTF-16 code units, numbers as JavaScript
/// writes them (1.0 is `1`, 1e30 is `1e+30`), strings with only the escapes JSON needs. Integers past 2^53 are an error.
pub fn jcs_canonical(value: serde_json::Value) -> Result<String, String> {
    canon(&value)
}

/// JSON text, as received, made canonical: the form to check a signature against. Numbers are read exactly as written
/// (`333333333.33333329` is `333333333.3333333`, as in JavaScript).
pub fn jcs_canonical_text(json: &str) -> Result<String, String> {
    canon(&parse(json)?)
}

/// The SHA-256 of the value's canonical form, in hex: the same for the same data however its JSON was written. For
/// content ids, deduplication and detached signatures.
pub fn jcs_sha256(value: serde_json::Value) -> Result<String, String> {
    Ok(hex(&Sha256::digest(canon(&value)?.as_bytes())))
}

/// An HMAC-SHA256 of the value's canonical form with `secret`, in hex: a signature that survives the JSON being
/// re-spaced or its keys reordered on the way.
pub fn jcs_hmac(value: serde_json::Value, secret: &str) -> Result<String, String> {
    Ok(hex(&mac(secret, &canon(&value)?).finalize().into_bytes()))
}

/// Whether `signature` (hex, from `jcs_hmac`) is the HMAC of the value's canonical form with `secret`, compared in constant time.
pub fn jcs_hmac_verify(value: serde_json::Value, secret: &str, signature: &str) -> Result<bool, String> {
    let text = canon(&value)?;
    let s = signature.trim();
    if s.len() % 2 != 0 {
        return Ok(false);
    }
    let bytes: Option<Vec<u8>> = (0..s.len()).step_by(2).map(|i| u8::from_str_radix(s.get(i..i + 2)?, 16).ok()).collect();
    Ok(bytes.is_some_and(|b| mac(secret, &text).verify_slice(&b).is_ok()))
}

/// Whether two JSON texts hold the same data, whatever their spacing, key order and number spelling (`1.0` and `1`, `1E2` and `100`).
pub fn jcs_same(a: &str, b: &str) -> Result<bool, String> {
    Ok(canon(&parse(a)?)? == canon(&parse(b)?)?)
}
