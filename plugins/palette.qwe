// A product card coloured from its photo: the background, the text on it, and a strip of the photo's colours.
//
//   quillo run palette.qwe      then open http://localhost:8080/

use "palette.qwer"

let PHOTO = "palette_sample.png"

route GET /colors = { palette: palette(PHOTO, 6)?, dominant: palette_dominant(PHOTO)?, shares: palette_shares(PHOTO, 4)? }

route GET /photo.png = file(PHOTO)

route GET / {
    let main = palette_shares(PHOTO, 5)?[0]
    <html><body style={`margin: 0; font-family: sans-serif; background: ${main.hex}; color: ${main.text}`}>
        <div style="padding: 24px">
            <img src="/photo.png" width="300" alt="Sunset over the hills"/>
            <h1>Sunset blend</h1>
            <div style="display: flex">{for c in palette(PHOTO, 6)? => <div style={`width: 40px; height: 24px; background: ${c}`}></div>}</div>
        </div>
    </body></html>
}
