//! What a User-Agent header says: browser, version, system, device kind, and whether it is a crawler.
//! version: 1.0.0
//!
//! [dependencies]
//! woothee = "0.13"

use serde_json::{json, Value};

/// `{ browser, version, os, os_version, category, vendor }` for a User-Agent (category: "pc", "smartphone", "mobilephone", "crawler", "appliance", "misc"), or null when it is unknown.
pub fn parse_user_agent(ua: &str) -> Option<Value> {
    let r = woothee::parser::Parser::new().parse(ua)?;
    Some(json!({
        "browser": r.name, "version": r.version, "os": r.os, "os_version": r.os_version.to_string(),
        "category": r.category, "vendor": r.vendor,
    }))
}

/// Whether the User-Agent is a search engine's or another crawler's.
pub fn is_crawler(ua: &str) -> bool {
    woothee::is_crawler(ua)
}
