//! HCL, the language of Terraform, Nomad, Packer and Vault files: read as values (with `var.x` left as `${var.x}`, or worked out from your variables), and values written back as HCL.
//! version: 1.0.0
//!
//! [dependencies]
//! hcl-rs = "0.18"

use serde_json::Value;

/// Files up to 10 MB are read.
const MAX: usize = 10 * 1024 * 1024;

fn size(text: &str) -> Result<(), String> {
    if text.len() > MAX {
        return Err("HCL files up to 10 MB".into());
    }
    if too_deep(text, 128) {
        return Err("nested more than 128 deep".into());
    }
    Ok(())
}

/// The deepest nesting of brackets outside strings: the parser recurses, and text nested thousands deep would overflow
/// the server's stack, so it is refused first.
fn too_deep(text: &str, max: usize) -> bool {
    let (mut depth, mut quote, mut esc) = (0usize, None::<char>, false);
    for c in text.chars() {
        if let Some(q) = quote {
            if esc { esc = false } else if c == '\\' { esc = true } else if c == q { quote = None }
            continue;
        }
        match c {
            '"' => quote = Some(c),
            '[' | '{' | '(' => {
                depth += 1;
                if depth > max {
                    return true;
                }
            }
            ']' | '}' | ')' => depth = depth.saturating_sub(1),
            _ => {}
        }
    }
    false
}


/// HCL text as a map: attributes as keys, blocks as nested maps by their labels (`resource "aws_instance" "web" { ... }` is
/// `resource.aws_instance.web`), a block type used several times as a list. Expressions that need evaluating (`var.region`,
/// `"${local.name}-web"`, function calls) stay as their text in `${...}`.
pub fn hcl_parse(text: &str) -> Result<Value, String> {
    size(text)?;
    hcl::from_str::<Value>(text).map_err(|e| format!("not HCL: {}", e))
}

/// An HCL file read as hcl_parse reads text.
pub fn hcl_read_file(path: &str) -> Result<Value, String> {
    let t = std::fs::read_to_string(path).map_err(|e| format!("{}: {}", path, e))?;
    hcl_parse(&t)
}

/// HCL text with its expressions worked out where they can be: `var.<name>` from `variables` (a map), `local.<name>` from
/// `locals`, arithmetic, conditions, `for` expressions and template strings. What cannot be (a name not given, a type such as
/// `string`, Terraform's functions) stays as its text in `${...}`, as hcl_parse leaves it.
pub fn hcl_eval(text: &str, variables: serde_json::Value, locals: serde_json::Value) -> Result<Value, String> {
    use hcl::eval::Evaluate;
    size(text)?;
    let mut ctx = hcl::eval::Context::new();
    ctx.declare_var("var", hcl::to_value(&variables).map_err(|e| e.to_string())?);
    ctx.declare_var("local", hcl::to_value(&locals).map_err(|e| e.to_string())?);
    let mut body = hcl::parse(text).map_err(|e| format!("not HCL: {}", e))?;
    // Every expression that can be worked out is; the errors of the others are left aside.
    let _ = body.evaluate_in_place(&ctx);
    hcl::from_body::<Value>(body).map_err(|e| e.to_string())
}

/// A map written as HCL text: keys holding text, numbers, booleans and lists as attributes (`name = "web"`), maps as maps.
pub fn hcl_write(value: serde_json::Value) -> Result<String, String> {
    if !value.is_object() {
        return Err("HCL is written from a map".into());
    }
    hcl::to_string(&hcl::to_value(&value).map_err(|e| e.to_string())?).map_err(|e| e.to_string())
}
