// A product API that answers 304 when the client already has the latest version, and a look at
// how caches treat a few responses.
//
//   quillo run http_cache.qwe      then: curl -i http://localhost:8080/products/7
//   and again with -H 'If-None-Match: <the etag it gave>'

use "http_cache.qwer"

let PRODUCTS = { "7": { id: 7, name: "Kettle", price: 39.9, updated: 1793260800 } }

route GET /products/:id {
    let p = PRODUCTS[id] ?? reply 404 "no such product"
    let body = json.stringify(p)
    let etag = httpcache_etag(body, false)
    let headers = { etag, "last-modified": httpcache_date(p.updated), "cache-control": httpcache_preset("api")? }
    if httpcache_not_modified(request.headers, etag, p.updated) {
        respond(304, "", headers)
    } else {
        respond(200, body, { ...headers, "content-type": "application/json" })
    }
}

// A response a cache stored ten minutes ago, its page last changed three days before that.
fn stored() {
    let at = int(now() / 1000) - 600
    {
        date: httpcache_date(at),
        "cache-control": "public, max-age=300, s-maxage=3600, stale-while-revalidate=60",
        "last-modified": httpcache_date(at - 3 * 86400),
    }
}

route GET /demo {
    let body = json.stringify(PRODUCTS["7"])
    let etag = httpcache_etag(body, false)
    let s = stored()
    {
        built: httpcache_build({ "max-age": 31536000, public: true, immutable: true }),
        etag_matches: httpcache_not_modified({ "if-none-match": `W/${etag}, "old"` }, etag, 0),
        etag_old: httpcache_not_modified({ "if-none-match": "\"old\"" }, etag, 0),
        since: httpcache_not_modified({ "if-modified-since": "Fri, 30 Oct 2026 00:00:00 GMT" }, "", 1793260800),
        parsed: httpcache_parse(s["cache-control"]),
        stored_at: httpcache_date_parse(s.date)?,
        // In a browser (max-age 300: stale) and in a CDN (s-maxage 3600: fresh for 50 more minutes).
        browser: httpcache_freshness(s, 200, 0, false),
        cdn: httpcache_freshness(s, 200, 0, true),
        // No Cache-Control: a tenth of the three days since it changed.
        heuristic: httpcache_freshness({ date: s.date, "last-modified": s["last-modified"] }, 200, 0, false).lifetime,
        logged_in_page: httpcache_storable("GET", 200, { authorization: "Bearer x" }, { "cache-control": "max-age=60" }, true),
        private_page: httpcache_storable("GET", 200, {}, { "cache-control": "private, max-age=60" }, false),
    }
}
