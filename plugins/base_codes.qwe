// Codes for people to read and type, keys in Base58, and addresses in Bech32.
//
//   quillo run base_codes.qwe      then open http://localhost:8080/samples

use "base_codes.qwer"

route GET /samples = {
    base32: basex_encode("base32", "hello")?,
    crockford: basex_encode("crockford", "hello")?,
    zbase32: basex_encode("zbase32", "hello")?,
    base58: basex_encode("base58", "hello")?,
    base58check: basex_encode_hex("base58check", "00f54a5851e9372b87810a8e60cdd2e7cfd80b6e31")?,
    typed_badly: basex_decode("crockford", "d1JPRV-3F")?,
}

// A voucher code from a number, readable over the phone.
route GET /voucher ? { id: int = 4521 } {
    let code = basex_encode("crockford", `QS-${id}`)?
    { code, back: basex_decode("crockford", lower(code))? }
}

route GET /bech32 {
    let npub = bech32_encode("npub", "3bf0c63fcb93463407af97a5e5ee64fa883d107ef9e558472c4eb9aaaefa459d", "bech32")?
    {
        npub,
        back: bech32_decode(npub)?.hex,
        segwit: bech32_decode("bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4")?.segwit,
        typo: bech32_decode("bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t5").error,
    }
}
