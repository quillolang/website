// A script and a style sheet minified when the site is built, and served small.
//
//   quillo run js_minify.qwe      then open http://localhost:8080/app.min.js

use "js_minify.qwer"

let SCRIPT = `// Adds up the basket.
function total(items) {
    let sum = 0;   /* in cents */
    for (const item of items) {
        sum += item.price * item.qty;
    }
    return sum;
}
console.log("Total:", total([{ price: 650, qty: 2 }]));
`

let STYLE = `/* the cards */
.card {
    padding: 12px;
    border-radius: 4px;
}
.card .price { font-weight: bold; }
`

route GET /app.min.js = respond(200, minify_js(SCRIPT)?, { "content-type": "text/javascript; charset=utf-8" })
route GET /site.min.css = respond(200, minify_css(STYLE)?, { "content-type": "text/css; charset=utf-8" })

route GET /build {
    write_file("data/src/app.js", SCRIPT)
    write_file("data/src/site.css", STYLE)
    {
        js: minify_file("data/src/app.js", "data/dist/app.min.js")?,
        css: minify_file("data/src/site.css", "data/dist/site.min.css")?,
        json: minify_json("{\n  \"name\": \"Quillo Café\",\n  \"open\": true\n}"),
    }
}
