//! Redis as a cache and counter store: get, set with a lifetime, delete, count, and one connection kept open.
//!
//! [dependencies]
//! redis = "0.27"

use std::sync::Mutex;

/// The connection, opened on the first call (`REDIS_URL`, else Redis on this machine) and opened again after an error.
static CON: Mutex<Option<redis::Connection>> = Mutex::new(None);

fn with<T>(f: impl Fn(&mut redis::Connection) -> redis::RedisResult<T>) -> Result<T, String> {
    let mut slot = CON.lock().unwrap_or_else(|e| e.into_inner());
    if slot.is_none() {
        let url = std::env::var("REDIS_URL").unwrap_or_else(|_| "redis://127.0.0.1/".into());
        let client = redis::Client::open(url).map_err(|e| e.to_string())?;
        *slot = Some(client.get_connection_with_timeout(std::time::Duration::from_secs(2)).map_err(|e| e.to_string())?);
    }
    let r = f(slot.as_mut().unwrap());
    if r.is_err() {
        *slot = None;
    }
    r.map_err(|e| e.to_string())
}

/// The text at `key`, or null.
pub fn cache_get(key: &str) -> Result<Option<String>, String> {
    with(|c| redis::cmd("GET").arg(key).query(c))
}

/// Keeps `value` at `key` for `ttl` seconds (0: for good).
pub fn cache_set(key: &str, value: &str, ttl: i64) -> Result<(), String> {
    with(|c| {
        let mut cmd = redis::cmd("SET");
        cmd.arg(key).arg(value);
        if ttl > 0 { cmd.arg("EX").arg(ttl); }
        cmd.query(c)
    })
}

/// Takes `key` away; whether it was there.
pub fn cache_del(key: &str) -> Result<bool, String> {
    with(|c| redis::cmd("DEL").arg(key).query::<i64>(c)).map(|n| n > 0)
}

/// Adds one to the number at `key` (0 when there is none) and gives the new number: page views, rate limits.
pub fn cache_incr(key: &str) -> Result<i64, String> {
    with(|c| redis::cmd("INCR").arg(key).query(c))
}
