// A VoIP monitor: is the PBX alive (OPTIONS over UDP and TCP), an extension registered with digest
// authentication, what a phone offers in its SDP, a request that gets a 404, and messages read
// and answered. RFC 2617's example checks the digest.
//
//   SIP_SERVER=pbx.example.net SIP_USER=1001 SIP_PASSWORD=... quillo run sip.qwe
//   then open http://localhost:8080/ping and /register

use "sip.qwer"

let SERVER = env("SIP_SERVER", "127.0.0.1:5060")
let FAST = { timeout_ms: 1500, t1_ms: 100 }
let USER = { ...FAST, username: env("SIP_USER", "1001"), password: env("SIP_PASSWORD", "") }

route GET /ping {
    let u = sip_options(SERVER, FAST)?
    let t = sip_options(SERVER, { ...FAST, transport: "tcp" })?
    { udp: [u.status, u.reason, u.ok, u.server, u.allow, u.sends], tcp: [t.status, t.ok, t.sends], by_uri: sip_options(`sip:${SERVER};transport=tcp`, FAST)?.status }
}

route GET /retry {
    let r = sip_options(SERVER, { ...FAST, uri: "sip:flaky@stand-in.test" })?
    let slow = sip_options(SERVER, { ...FAST, uri: "sip:slow@stand-in.test" })?
    { sends: r.sends, status: r.status, slow: [slow.status, slow.provisional, slow.sends], compact: sip_options(SERVER, { ...FAST, uri: "sip:compact@stand-in.test", transport: "tcp" })?.allow }
}

route GET /register {
    let r = sip_register(SERVER, { ...USER, expires: 600 })?
    let t = sip_register(SERVER, { ...USER, expires: 600, transport: "tcp" })?
    {
        status: r.status, authenticated: r.authenticated, bound: r.contact[0].params.expires, tcp: [t.status, t.authenticated],
        wrong: sip_register(SERVER, { ...USER, password: "wrong" })?.status,
        none: sip_register(SERVER, FAST)?.status,
        sha: sip_register(SERVER, { ...USER, uri: "sip:sha256@stand-in.test" })?.status,
    }
}

route GET /call {
    let offer = sip_sdp_build({ address: "192.0.2.10", name: "call", session_id: 42, media: [{ type: "audio", port: 49170, direction: "sendrecv", codecs: [{ payload: 0, name: "PCMU", rate: 8000 }, { payload: 96, name: "opus", rate: 48000, fmtp: "useinbandfec=1" }] }] })?
    let r = sip_request(SERVER, "INVITE", { ...FAST, uri: "sip:echo@stand-in.test", body: offer, headers: { "Content-Type": "application/sdp" } })?
    {
        status: r.status, provisional: r.provisional,
        answer: r.sdp.media[0].codecs, connection: r.sdp.connection, media_port: r.sdp.media[0].port, direction: r.sdp.media[0].direction,
    }
}

route GET /errors = {
    missing: sip_request(SERVER, "MESSAGE", { ...FAST, uri: "sip:nobody@stand-in.test" })?,
    silent: sip_options("127.0.0.1:1", { timeout_ms: 300, t1_ms: 50 }).error,
    offline: sip_options("127.0.0.1:1", { timeout_ms: 300, transport: "tcp" }).error,
    bad_method: sip_request(SERVER, "options", FAST).error,
    bad_transport: sip_options(SERVER, { transport: "carrier-pigeon" }).error,
    injected: sip_options(SERVER, { ...FAST, headers: { "Subject": "x\r\nEvil: 1" } }).error,
}

// RFC 2617's example: the answer must be 6629fae49393a05397450978507c4ef1.
route GET /digest = {
    rfc: sip_digest("Digest realm=\"testrealm@host.com\", qop=\"auth,auth-int\", nonce=\"dcd98b7102dd2f0e8b11d0f600bfb0c093\", opaque=\"5ccc069c403ebaf9f0171e9517f40e41\"", { method: "GET", uri: "/dir/index.html", username: "Mufasa", password: "Circle Of Life", cnonce: "0a4f113b", nc: 1 })?,
    no_qop: sip_digest("Digest realm=\"r\", nonce=\"n\"", { method: "REGISTER", uri: "sip:x", username: "u", password: "p" })?,
    unknown: sip_digest("Digest realm=\"r\", nonce=\"n\", algorithm=SHA-512", { method: "A", uri: "b", username: "u", password: "p" }).error,
    no_nonce: sip_digest("Digest realm=\"r\"", { method: "A", uri: "b", username: "u", password: "p" }).error,
}

let RAW = "INVITE sip:bob@example.com SIP/2.0\r\nv: SIP/2.0/UDP pc33.example.com;branch=z9hG4bK776;received=192.0.2.1, SIP/2.0/TCP bigbox3.site3.example.com;branch=z9hG4bK77ef\r\nMax-Forwards: 69\r\nf: \"Alice, the \\\"great\\\"\" <sip:alice@example.com>;tag=1928301774\r\nt: Bob <sip:bob@example.com>\r\ni: a84b4c76e66710@pc33\r\nCSeq: 314159 INVITE\r\nSubject: a long\r\n  folded subject\r\nm: <sip:alice@pc33.example.com>;q=0.7, <sip:a2@pc34>;expires=60\r\nc: application/sdp\r\nl: 129\r\n\r\nv=0\r\no=alice 2890844526 2890844526 IN IP4 pc33\r\ns=-\r\nc=IN IP4 192.0.2.101\r\nt=0 0\r\nm=audio 49172 RTP/AVP 0\r\na=sendonly\r\na=ptime:20\r\n"

route GET /parse {
    let m = sip_parse(RAW)?
    {
        line: [m.kind, m.method, m.uri],
        via: m.via | map((v) => [v.protocol, v.sent_by, v.branch, v.received]),
        from: m.from, to: m.to.name, call: m.call_id, cseq: m.cseq,
        subject: m.headers.subject, contacts: m.contact | map((c) => c.uri),
        sdp: [m.sdp.origin.username, m.sdp.connection, m.sdp.media[0].port, m.sdp.media[0].codecs[0].name, m.sdp.media[0].direction, m.sdp.media[0].attributes.ptime],
    }
}

route GET /answer {
    let t = sip_response(RAW, 180, "Ringing", { tag: "as1" })?
    let m = sip_parse(t)?
    { line: [m.status, m.reason], via_kept: len(m.via), to_tag: m.to.tag, same_call: m.call_id, cseq: m.cseq.number, bad: sip_parse("hello there").error }
}

route GET /uris = {
    full: sip_uri("sips:alice:secret@atlanta.com:5061;transport=tcp;lr?subject=hi&priority=urgent")?,
    v6: sip_uri("sip:bob@[2001:db8::1]:5080")?.host,
    tel: sip_uri("tel:+15551234;phone-context=x")?.user,
    bad: sip_uri("http://example.com").error,
}
