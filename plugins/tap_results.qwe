// A test run's TAP read for a dashboard: what passed by TAP's own rules, what failed and where,
// and a program's checks written as TAP for a harness to read.
//
//   quillo run tap_results.qwe      then open http://localhost:8080/read, /summary, /yaml, /write, /old and /broken

use "tap_results.qwer"

let TEXT = read_file("tap_results_sample.tap")

route GET /read {
    let t = tap_parse(TEXT)?
    {
        version: t.version, plan: t.plan, passed: t.passed, comments: t.comments, problems: t.problems,
        tests: t.tests | map((x) => [x.number, x.ok, x.description, x.directive, x.reason]),
        subtest: [t.tests[5].subtest.name, t.tests[5].subtest.plan.end, t.tests[5].subtest.tests[2].subtest.name],
        buffered: t.tests[7].subtest.tests[0].description,
    }
}

route GET /summary = tap_summary(TEXT)?

route GET /yaml = tap_parse(TEXT)?.tests[1].diagnostics

let CHECKS = [
    { ok: true, description: "boots" },
    { ok: false, description: "pays # twice", diagnostics: { message: "two: charges", wanted: 1, found: 2, lines: "first\nsecond\n", tags: ["a", "b"], nested: { deep: true, none: null } } },
    { ok: true, description: "mail", directive: "skip", reason: "no sink" },
    { ok: false, description: "search", directive: "todo", reason: "soon" },
    { description: "group", subtest: [{ ok: true, description: "one" }, { ok: false, description: "two" }] },
    { ok: true },
]

route GET /write {
    let text = tap_write(CHECKS)?
    let back = tap_parse(text)?
    {
        text: text, plan: back.plan.end, passed: back.passed, problems: back.problems,
        hash: back.tests[1].description, yaml: back.tests[1].diagnostics,
        group: [back.tests[4].ok, back.tests[4].subtest.passed],
        same: tap_write(back.tests | map((t) => t.subtest == null ? t : merge(t, { subtest: t.subtest.tests })))? == text,
        bad: tap_write([{ ok: true, directive: "later" }]).error,
        newline: tap_write([{ ok: true, description: "a\nb" }]).error,
    }
}

route GET /old = {
    plan_last: tap_parse("ok 1\nok\nnot ok - third # TODO later\n1..3\n")?.passed,
    skip_all: tap_summary("1..0 # SKIP no database\n")?,
    plan_reason: tap_parse("1..0 # skipped: none\n")?.plan,
    case: tap_parse("ok 1 - x # skipped because\nok 2 - y # ToDo soon\n1..2\n")?.tests | map((t) => [t.directive, t.reason]),
    no_number: tap_parse("ok - x\nok - y\n1..2")?.tests | map((t) => t.number),
    crlf: tap_parse("ok 1\r\n1..1\r\n")?.passed,
    junk: tap_parse("hello\nok 1\n1..1\n")?.unknown_lines,
    bad_yaml: tap_parse("not ok 1\n  ---\n  : [\n  ...\n1..1\n")?.tests[0].diagnostics,
}

route GET /broken = {
    no_plan: tap_summary("ok 1\n")?,
    too_few: tap_parse("1..3\nok 1\n")?.problems,
    two_plans: tap_parse("1..1\nok 1\n1..1\n")?.problems,
    middle: tap_parse("ok 1\n1..2\nok 2\n")?.problems,
    order: tap_parse("ok 2\nok 1\n1..2\n")?.problems,
    bail: tap_summary("1..3\nok 1\nBail out! database down\nok 2\n")?,
    open_yaml: tap_parse("ok 1\n  ---\n  a: 1\n1..1\n")?.problems,
    bad_sub: tap_summary("    not ok 1 - inner\n    1..1\nok 1 - outer\n1..1\n")?.ok,
}
