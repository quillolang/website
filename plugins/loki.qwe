// A program's logs in Grafana Loki: lines pushed with labels and nanosecond times, read back as one
// sorted list across streams, a range read past its limit, an error rate from a metric query, and
// what labels exist.
//
//   LOKI_API_URL=http://localhost:3100 quillo run loki.qwe
//   then open http://localhost:8080/push, /read, /all, /metrics, /labels and /failures
//
// Grafana Cloud wants LOKI_USER and LOKI_PASSWORD; a multi-tenant Loki wants LOKI_TENANT.

use "loki.qwer"

route GET /push {
    let base = "1730000000000000001"
    let sent = loki_push({ app: "shop", env: "prod" }, [
        { time: "1730000000000000002", line: "order 2 paid" },
        { time: base, line: "order 1 paid", metadata: { trace_id: "abc" } },
        { time: "2024-10-27T03:33:20.000000003Z", line: "order 3 failed: card declined" },
    ], {})?
    let many = loki_push_many([
        { labels: { app: "cart", env: "prod" }, line: "cart 1", time: "1730000000000000004" },
        { labels: { env: "prod", app: "cart" }, line: "cart 2", time: "1730000000000000005" },
        { labels: { app: "mail", env: "prod" }, line: "mail 1", time: "1730000000000000006" },
    ], {})?
    { sent: sent, many: many, plain: loki_push({ app: "plain" }, ["just text"], {})? }
}

route GET /read {
    let range = { start: "1730000000000000000", end: "1730000000000000100" }
    let got = loki_query_range("{env=\"prod\"}", { ...range, direction: "forward" })?
    let newest = loki_query_range("{app=\"shop\"}", { ...range, limit: 1 })?
    {
        type: got.type,
        lines: map(got.entries, (e) => e.line),
        first: got.entries[0],
        newest: newest.entries[0].line,
        iso: loki_time("1730000000000000006")?,
        ns: loki_ns("2024-10-27T03:33:20.123456789+01:00")?,
        ms: loki_ns(1730000000000)?,
    }
}

route GET /all {
    loki_push({ app: "busy" }, map(range(0, 25), (i) => { time: `173000000000000${1000 + i - i % 2}`, line: `line ${i}` }), {})?
    let window = { start: "1730000000000000000", end: "1730000000000900000" }
    let back = loki_query_all("{app=\"busy\"}", { ...window, page_size: 10 })?
    let fwd = loki_query_all("{app=\"busy\"}", { ...window, page_size: 10, direction: "forward" })?
    let cut = loki_query_all("{app=\"busy\"}", { ...window, page_size: 10, max_lines: 15 })?
    { lines: len(back.entries), unique: len(unique(map(back.entries, (e) => e.line))), pages: back.pages > 2, oldest: back.entries[len(back.entries) - 1].line, forward: len(fwd.entries), first: fwd.entries[0].line, cut: [len(cut.entries), cut.cut] }
}

route GET /metrics {
    let m = loki_query_range("sum by (app) (rate({env=\"prod\"} |= \"failed\" [5m]))", { start: "1730000000", end: "1730000600", step: 300 })?
    let v = loki_query("sum(count_over_time({env=\"prod\"}[1h]))", { time: "1730000000" })?
    { type: m.type, app: m.series[0].metric.app, values: m.series[0].values, now: v.samples[0].value, vector: v.type }
}

route GET /labels = {
    names: loki_labels({})?,
    apps: loki_label_values("app", {})?,
    series: len(loki_series("{env=\"prod\"}", {})?),
    ready: loki_ready({})?,
}

route GET /failures = {
    parse: loki_query_range("{app=", {}).error,
    instant_logs: loki_query("{app=\"shop\"}", {}).error,
    bad_label: loki_push({ "1bad": "x" }, ["y"], {}).error,
    not_text: loki_push({ port: 8080 }, ["y"], {}).error,
    backwards: loki_query_range("{a=\"b\"}", { start: 200, end: 100 }).error,
    limited_then_fine: loki_push({ app: "limited" }, ["ok"], {})?,
    no_time: loki_ns("yesterday").error,
}
