// Music theory by name: a note's MIDI number and frequency, intervals, scales, chords built and
// named, keys, progressions in Roman numerals, and a song moved for a singer.
//
//   quillo run music_theory.qwe
//   then open http://localhost:8080/note?n=C%234, /chord?s=F%23m7b5, /scale?tonic=Eb&kind=dorian,
//   /intervals, /chords, /keys and /refused

use "music_theory.qwer"

route GET /note ? { n: str } {
    let r = music_note(n)
    if is_err(r) { reply 422 r.error }
    r
}

route GET /chord ? { s: str } {
    let r = music_chord(s)
    if is_err(r) { reply 422 r.error }
    r
}

route GET /scale ? { tonic: str, kind: str = "major" } {
    let r = music_scale(tonic, kind)
    if is_err(r) { reply 422 r.error }
    r
}

route GET /pitch = {
    midi: music_from_midi(61, false)?,
    flat: music_from_midi(61, true)?,
    a432: music_frequency("A4", 432.0)?,
    middle_c: music_frequency("C4", 440.0)?,
    tuner: music_from_frequency(445.0, 440.0)?,
}

route GET /intervals = {
    third: music_interval("C4", "E4")?,
    diminished: music_interval("C", "Fb")?.name,
    tritone: music_interval("F4", "B4")?,
    ninth: music_interval("C4", "D5")?,
    down: music_interval("E4", "C4")?,
    up_a_third: music_transpose("C4", "M3")?,
    spelled: music_transpose("Eb", "A4")?,
    double: music_transpose("B", "M3")?,
    down_a_fifth: music_transpose("C5", "-P5")?,
}

route GET /scales = {
    f_sharp: music_scale("F#", "major")?.notes,
    gb: music_scale("Gb", "major")?.notes,
    harmonic: music_scale("A", "harmonic_minor")?.notes,
    blues: music_scale("E", "blues")?.notes,
    octaves: music_scale("C4", "lydian")?.notes,
    fits: len(music_find_scales(["C", "E", "G", "Bb"])?),
}

route GET /chords = {
    dominant: music_chord("Bb7#9")?.notes,
    half: music_chord("F#m7b5")?.notes,
    dim7: music_chord("Ao7")?.notes,
    thirteen: music_chord("G13b9")?.notes,
    slash: music_chord("C/E")?.bass,
    voiced: music_chord_midi("C/E", 4)?,
    named: first(music_chord_name(["C", "E", "G", "Bb"])?).name,
    inverted: first(music_chord_name(["E", "G", "C"])?).name,
    both: music_chord_name(["A", "C", "E", "G"])?,
    moved: music_transpose_chords(["Dm7", "G7/B", "Cmaj7"], "M2")?,
}

route GET /keys = {
    eb: music_key("Eb major")?,
    f_sharp_minor: music_key("F# minor")?.signature,
    theoretical: music_key("G#")?.theoretical,
    diatonic: music_diatonic("C", false)?,
    sevenths: music_diatonic("A minor", true)?,
    two_five_one: music_progression("C", "ii7 V7 Imaj7")?,
    borrowed: music_progression("D", "I bVII IV V7/V")?,
    minor: music_progression("Am", "i iv V7 i")?,
    circle: first(music_circle_of_fifths()),
}

route GET /refused = {
    note: music_note("H4").error,
    midi: music_from_midi(128, false).error,
    interval: music_transpose("C", "P3").error,
    scale: music_scale("C", "klingon").error,
    chord: music_chord("Cxyz").error,
    none: music_chord_name(["C", "C#", "D", "D#"]).error,
    numeral: music_progression("C", "viii").error,
}
