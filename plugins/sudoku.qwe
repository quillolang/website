// Sudoku: a well-known puzzle solved, a hard one graded, one with a mistake refused, a new puzzle
// made from a seed, and a hint.
//
//   quillo run sudoku.qwe
//   then open http://localhost:8080/solve, /grade, /generate?seed=7, /hint and /refused

use "sudoku.qwer"

// Wikipedia's example puzzle, Arto Inkala's "hardest" one, and a board with two 5s in a row.
let easy = "53..7....6..195....98....6.8...6...34..8.3..17...2...6.6....28....419..5....8..79"
let inkala = "8..........36......7..9.2...5...7.......457.....1...3...1....68..85...1..9....4.."
let wrong = "55..7....6..195....98....6.8...6...34..8.3..17...2...6.6....28....419..5....8..79"

route GET /solve = {
    wikipedia: sudoku_solve(easy)?,
    hardest: sudoku_solve(inkala)?.solution,
    drawn: sudoku_parse("5 3 . | . 7 . | . . .\n6 . . | 1 9 5 | . . .\n. 9 8 | . . . | . 6 .\n------+-------+------\n8 . . | . 6 . | . . 3\n4 . . | 8 . 3 | . . 1\n7 . . | . 2 . | . . 6\n------+-------+------\n. 6 . | . . . | 2 8 .\n. . . | 4 1 9 | . . 5\n. . . | . 8 . | . 7 9\n")?.puzzle,
    empty_corner: sudoku_solve(replace(easy, "53", ".."))?.count,
}

route GET /grade = {
    wikipedia: sudoku_grade(easy)?,
    hardest: sudoku_grade(inkala)?,
}

route GET /hint = {
    first: sudoku_hint(easy)?,
    stuck: sudoku_hint(inkala)?,
}

route GET /generate ? { seed: int = 7 } {
    let p = sudoku_generate(seed, { clues: 30 })?
    {
        puzzle: p.puzzle,
        clues: p.clues,
        grade: p.grade.level,
        unique: sudoku_solve(p.puzzle)?.unique,
        solves_to_its_solution: sudoku_solve(p.puzzle)?.solution == p.solution,
        same_again: sudoku_generate(seed, { clues: 30 })?.puzzle == p.puzzle,
        other_seed: sudoku_generate(seed + 1, { clues: 30 })?.puzzle == p.puzzle,
        drawn: sudoku_format(p.puzzle)?,
    }
}

route GET /refused = {
    conflict: sudoku_validate(wrong)?,
    solve: sudoku_solve(wrong).error,
    no_solution: sudoku_solve(replace(easy, "53..7....", "53..7...4"))?.solved,
    short: sudoku_solve("123").error,
    letter: sudoku_solve("x" + slice(easy, 1, 81)).error,
    too_few: sudoku_generate(1, { clues: 10 }).error,
}
