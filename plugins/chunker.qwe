// A help article split into chunks for an embeddings index: by headings, with a little overlap.
//
//   quillo run chunker.qwe      then open http://localhost:8080/chunks

use "chunker.qwer"

let guide = read_file("chunker_sample.md")?

route GET /chunks ? { size: int = 300, overlap: int = 0 } = chunk_markdown(guide, size, overlap)? | map((c) => { chars: len(c), text: c })

route GET /tokens = chunk_tokens(guide, 80, 10, true)? | map((c) => { start: slice(c, 0, 40) })

route GET /text = chunk_text("One sentence here. Another sentence there. And a third one to finish.", 40, 0)?
