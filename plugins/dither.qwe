// A photo for a café's receipt printer (black dots only, 384 wide on 58 mm paper) and for a 7-colour e-ink sign.
//
//   quillo run dither.qwe      then open http://localhost:8080/dither

use "dither.qwer"

let PHOTO = "dither_sample.png"

route GET /dither {
    {
        receipt: dither_image(PHOTO, "data/dither/receipt.png", { method: "atkinson", width: 384, contrast: 1.2 })?,
        eink: dither_image(PHOTO, "data/dither/eink.png", { palette: "eink-7" })?.width,
        ordered: dither_image(PHOTO, "data/dither/bayer.png", { method: "bayer", palette: ["#000000", "#ff0000", "#ffffff"] })?.colors,
        printer: slice(json.stringify(dither_bits(PHOTO, { width: 384 })?), 0, 80),
        bad: dither_image(PHOTO, "data/dither/x.png", { method: "magic" }).error,
    }
}

route GET /receipt.png {
    dither_image(PHOTO, "data/dither/receipt.png", { method: "atkinson", width: 384, contrast: 1.2 })?
    file("data/dither/receipt.png")
}

route GET /eink.png {
    dither_image(PHOTO, "data/dither/eink.png", { palette: "eink-7" })?
    file("data/dither/eink.png")
}
