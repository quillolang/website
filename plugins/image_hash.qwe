// Duplicate photo detection: a smaller, recompressed copy is found; a different picture is not.
//
//   quillo run image_hash.qwe      then open http://localhost:8080/duplicates

use "image_hash.qwer"

route GET /duplicates {
    image.convert("image_hash_sample.jpg", "data/hash/copy.jpg", { width: 160, format: "jpeg", quality: 50 })?
    {
        copy: image_hash_compare("image_hash_sample.jpg", "data/hash/copy.jpg")?,
        other: image_hash_compare("image_hash_sample.jpg", "image_hash_sample.png")?,
    }
}

// The library keeps each photo's hash; a new upload is looked up among them.
route GET /seen {
    image.convert("image_hash_sample.jpg", "data/hash/copy.jpg", { width: 160, format: "jpeg", quality: 50 })?
    let library = [
        { id: 1, hash: image_hash("image_hash_sample.png")? },
        { id: 2, hash: image_hash("image_hash_sample.jpg")? },
    ]
    { hash: image_hash("data/hash/copy.jpg")?, matches: image_hash_nearest(image_hash("data/hash/copy.jpg")?, library, 10)? }
}
