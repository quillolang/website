// Service discovery and shared settings on Consul: keys with a check-and-set, a blocking watch,
// instances and their health, and a lock held by a session.
//
//   CONSUL_API_URL=http://localhost:8500 CONSUL_TOKEN=... quillo run consul.qwe
//   then open /kv, /cas, /watch, /services, /sessions and /broken

use "consul.qwer"

route GET /kv {
    consul_put("config/app/name", "shop", 0)?
    consul_put("config/app/limits", { rate: 10 }, 42)?
    consul_put("config/db/url", "postgres://db", 0)?
    let one = consul_get("config/app/limits")?
    {
        value: one.value,
        flags: one.flags,
        missing: consul_get("config/nothing")?,
        all: consul_list("config/app/")? | map((k) => k.key),
        keys: consul_keys("config/", "/")?,
        none: consul_list("nothing/")?,
    }
}

route GET /cas {
    consul_delete("counter", false)?
    let made = consul_cas("counter", "1", 0)?
    let twice = consul_cas("counter", "1", 0)?
    let at = consul_get("counter")?.modify_index
    let moved = consul_cas("counter", "2", at)?
    { made: made, twice: twice, moved: moved, stale: consul_cas("counter", "3", at)?, value: consul_get("counter")?.value }
}

// The first call gives the index at once. The next waits; the stand-in changes the key a moment later.
route GET /watch {
    consul_put("flag", "off", 0)?
    let first = consul_watch("flag", 0, 5)?
    let changed = consul_watch("flag", first.index, 5)?
    let quiet = consul_watch("quiet-key", 0, 1)?
    let waited = consul_watch("quiet-key", quiet.index, 1)?
    { first: first.entry.value, after: changed.entry.value, changed: changed.changed, later: changed.index > first.index, gone: quiet.entry, timed_out: waited.changed }
}

// The index going backwards means a restored store: the next watch starts over.
route GET /reset = consul_watch("restored", 999999, 1)?.index

route GET /services {
    consul_register({ name: "web", id: "web-1", address: "10.0.0.5", port: 8080, tags: ["v2"], check: { ttl: "30s" } })?
    consul_register({ name: "web", id: "web-2", port: 8081, tags: ["v1"], check: { ttl: "30s" } })?
    consul_check("service:web-1", "pass", "fine")?
    consul_check("service:web-2", "fail", "out of memory")?
    let all = consul_health("web", null)?
    let healthy = consul_health("web", { passing: true })?
    consul_deregister("web-2")?
    {
        catalog: consul_services()?.web,
        all: all.instances | map((i) => { id: i.id, address: i.address, port: i.port, status: i.status }),
        healthy: healthy.instances | map((i) => i.id),
        tagged: consul_health("web", { tag: "v2" })?.instances | map((i) => i.id),
        after: len(consul_health("web", null)?.instances),
        bad: consul_check("x", "ok", "").error,
    }
}

route GET /sessions {
    let a = consul_session_create({ name: "worker-a", ttl: "30s", behavior: "release" })?
    let b = consul_session_create({ name: "worker-b", ttl: "30s" })?
    let got = consul_lock("locks/report", a, "worker-a")?
    let refused = consul_lock("locks/report", b, "worker-b")?
    let holder = consul_lock_holder("locks/report")? == a
    let index = consul_get("locks/report")?.lock_index
    let not_mine = consul_unlock("locks/report", b, "")?
    let released = consul_unlock("locks/report", a, "done")?
    let taken = consul_lock("locks/report", b, "worker-b")?
    consul_session_destroy(b)?
    { got: got, refused: refused, holder: holder, index: index, not_mine: not_mine, released: released, taken: taken, renewed: consul_session_renew(a)?, ended: consul_session_renew(b)?, free: consul_lock_holder("locks/report")? }
}

route GET /broken = {
    slash: consul_get("/leading").error,
    forbidden: consul_get("secret/key").error,
    no_name: consul_register({ port: 1 }).error,
}
