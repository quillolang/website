// A Chinese restaurant's site: today's lunar date on the menu, this year's festivals, and the solar terms for its seasonal dishes.
//
//   quillo run chinese_calendar.qwe      then open http://localhost:8080/calendar

use "chinese_calendar.qwer"

route GET /calendar {
    {
        today: chinese_date("2026-10-29")?,
        new_year_2026: chinese_new_year(2026)?,
        new_year_2027: chinese_new_year(2027)?.date,
        before_new_year: chinese_date("2026-02-16")?.animal,
        dragon_boat: chinese_to_date(2026, 5, 5, false)?,
        mid_autumn: chinese_to_date(2026, 8, 15, false)?,
        leap: chinese_date("2025-07-30")?.text,
        no_leap: chinese_to_date(2026, 6, 1, true).error,
    }
}

route GET /terms/:year(int) = chinese_solar_terms(year)? | map((t) => `${t.date} ${t.name} ${t.english}`)
