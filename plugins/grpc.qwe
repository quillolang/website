// gRPC without generated code: a service called from its .proto file (grpc_sample.proto here) or
// from what the server says of itself (reflection), with JSON in and out: unary calls, streams
// both ways, metadata, deadlines, status codes and TLS.
//
//   GRPC_URL=http://127.0.0.1:50051 quillo run grpc.qwe
//   then open http://localhost:8080/item, /list, /restock, /deadline, /streams, /reflection, /tls and /local
//
// GRPC_TLS_URL is an https:// address to try TLS with, GRPC_CA a PEM file to trust for it.

use "grpc.qwer"

let URL = env("GRPC_URL", "http://127.0.0.1:50051")
let PROTO = { proto: "grpc_sample.proto" }
let INV = "quillo.demo.Inventory"

route GET /item = {
    item: grpc_call(URL, `${INV}/GetItem`, { sku: "A-1042" }, PROTO)?,
    missing: grpc_call(URL, `${INV}/GetItem`, { sku: "Z-9" }, PROTO).error,
    wrong_field: grpc_call(URL, `${INV}/GetItem`, { id: "A-1042" }, PROTO).error,
    no_method: grpc_call(URL, `${INV}/Delete`, {}, PROTO).error,
}

// A server stream, collected; with a limit, the rest is cancelled.
route GET /list {
    let all = grpc_stream(URL, `${INV}/ListItems`, { min_quantity: 1 }, 100, PROTO)?
    let first = grpc_invoke(URL, `${INV}/ListItems`, {}, PROTO + { limit: 1 })?
    { in_stock: all | map((i) => `${i.sku} ${i.name} x${i.quantity}`), first: first.responses | map((i) => i.sku), truncated: first.truncated }
}

// Metadata both ways, and the status when it is not OK.
route GET /restock {
    let auth = PROTO + { metadata: { authorization: "Bearer demo-token", "x-request-id": "req-77" } }
    let r = grpc_invoke(URL, `${INV}/Restock`, { sku: "B-7", add: 5 }, auth)?
    {
        quantity: r.response.quantity, availability: r.response.availability, request_id: r.headers["x-request-id"], trailer: r.trailers["x-restocked-by"],
        no_token: grpc_invoke(URL, `${INV}/Restock`, { sku: "B-7", add: 5 }, PROTO)? | (x) => `${x.status} ${x.code}: ${x.message}`,
        bad_count: grpc_call(URL, `${INV}/Restock`, { sku: "B-7", add: 0 }, auth).error,
    }
}

route GET /deadline {
    let late = grpc_invoke(URL, `${INV}/Slow`, { ms: 3000 }, PROTO + { timeout_ms: 300 })?
    { late: `${late.status}: ${late.message}`, within: late.ms < 1500, in_time: grpc_call(URL, `${INV}/Slow`, { ms: 50 }, PROTO + { timeout_ms: 2000 })?.sku }
}

// Client streaming (a list of requests) and both ways.
route GET /streams = {
    count: grpc_call(URL, `${INV}/CountSkus`, [{ sku: "A-1042" }, { sku: "C-310" }, { sku: "nope" }], PROTO)?,
    watch: grpc_stream(URL, `${INV}/Watch`, [{ sku: "C-310" }, { sku: "A-1042" }], 10, PROTO)? | map((i) => i.name),
}

// No .proto at all: the server's reflection says what it offers, and the call uses that.
route GET /reflection {
    let services = grpc_services(URL, {})?
    {
        services: services | map((s) => s.name),
        methods: services[0].methods | map((m) => `${m.name}${m.server_streaming ? " (stream)" : ""}`),
        item: grpc_call(URL, `${INV}/GetItem`, { sku: "C-310" }, { json_names: true })?,
    }
}

route GET /tls {
    let url = env("GRPC_TLS_URL", null) ?? reply 503 "set GRPC_TLS_URL to an https:// gRPC address"
    { item: grpc_call(url, `${INV}/GetItem`, { sku: "A-1042" }, PROTO + { ca_file: env("GRPC_CA", null) })?.name }
}

// The .proto file on its own: what it defines, and messages as bytes.
route GET /local {
    let bytes = grpc_encode("grpc_sample.proto", "quillo.demo.Item", { sku: "X-1", price: 9.5, tags: ["a", "b"], availability: "IN_STOCK" })?
    {
        methods: grpc_methods("grpc_sample.proto", [])?[0].methods | map((m) => m.path),
        fields: grpc_fields("grpc_sample.proto", "quillo.demo.Dimensions")? | map((f) => `${f.number} ${f.name} ${f.type}`),
        bytes,
        back: grpc_decode("grpc_sample.proto", "quillo.demo.Item", bytes)?,
    }
}
