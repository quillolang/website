// A building's controllers over BACnet/IP: devices found with Who-Is, a room's temperature and
// its units read, a setpoint written at a priority and let go again, an object list longer than
// one packet walked item by item, and what a device says when it refuses.
//
//   BACNET_TO=192.168.1.255 BACNET_DEVICE=192.168.1.20 quillo run bacnet.qwe
//   then open http://localhost:8080/devices, /room and /setpoint
//
// Answers to a broadcast Who-Is often go to port 47808 itself: give { local_port: 47808 } on a
// machine where nothing else holds it. A device has one address per port: "host:47809".

use "bacnet.qwer"

let TO = env("BACNET_TO", "255.255.255.255")
let DEVICE = env("BACNET_DEVICE", "127.0.0.1")
let FAST = { timeout_ms: 500, retries: 1 }

route GET /devices = {
    all: bacnet_who_is({ to: TO, wait_ms: 300 })?,
    only_1000s: bacnet_who_is({ to: TO, low: 1000, high: 1999, wait_ms: 300 })? | map((d) => d.device),
}

route GET /room {
    let t = bacnet_read(DEVICE, "analog-input:1", "present-value", FAST)?
    {
        temperature: t.value,
        kind: t.type,
        name: bacnet_read(DEVICE, "analog-input:1", "object-name", FAST)?.value,
        units: bacnet_read(DEVICE, "analog-input:1", "units", FAST)?.name,
        flags: bacnet_read(DEVICE, "analog-input:1", "status-flags", FAST)?.value,
        vendor: bacnet_read(DEVICE, "device:1234", "vendor-name", FAST)?.value,
        by_number: bacnet_read(DEVICE, "analog-input:1", 85, FAST)?.value,
    }
}

route GET /many = bacnet_read_multiple(DEVICE, [
    { object: "analog-input:1", properties: ["present-value", "object-name", "units", "reliability"] },
    { object: "binary-output:2", properties: ["present-value"] },
], FAST)?

route GET /objects {
    let list = bacnet_read_list(DEVICE, "device:1234", "object-list", FAST)?
    { count: len(list), first: list[0], last: list[len(list) - 1], names: bacnet_read_list(DEVICE, "multi-state-value:1", "state-text", FAST)? }
}

// A setpoint held at priority 8, and let go: the value falls back on what is below it.
route GET /setpoint {
    bacnet_write(DEVICE, "analog-value:3", "present-value", 22.5, { ...FAST, priority: 8 })?
    let held = bacnet_read(DEVICE, "analog-value:3", "present-value", FAST)?.value
    bacnet_write(DEVICE, "analog-value:3", "present-value", null, { ...FAST, priority: 8 })?
    let after = bacnet_read(DEVICE, "analog-value:3", "present-value", FAST)?.value
    let on = bacnet_write(DEVICE, "binary-output:2", "present-value", 1, { ...FAST, type: "enumerated", priority: 9 })?
    { held: held, after: after, on: on, now: bacnet_read(DEVICE, "binary-output:2", "present-value", FAST)?.value }
}

route GET /refused = {
    no_object: bacnet_read(DEVICE, "analog-input:99", "present-value", FAST).error,
    no_property: bacnet_read(DEVICE, "analog-input:1", "polarity", FAST).error,
    read_only: bacnet_write(DEVICE, "analog-input:1", "present-value", 1.0, FAST).error,
    rejected: bacnet_read(DEVICE, "analog-input:1", 60000, FAST).error,
    silent: bacnet_read("127.0.0.1:47999", "analog-input:1", "present-value", { timeout_ms: 100, retries: 1 }).error,
    bad_object: bacnet_read(DEVICE, "thermostat:1", "present-value", FAST).error,
    bad_instance: bacnet_read(DEVICE, "analog-input:4194304", "present-value", FAST).error,
    bad_priority: bacnet_write(DEVICE, "analog-value:3", "present-value", 1.0, { priority: 17 }).error,
}

route GET /tags = {
    real: bacnet_encode("real", 21.5)?,
    unsigned: bacnet_encode("unsigned", 1000)?,
    signed: bacnet_encode("signed", -2)?,
    enumerated: bacnet_encode("enumerated", 1)?,
    text: bacnet_encode("character-string", "Room 12")?,
    object: bacnet_encode("object-id", "analog-input:1")?,
    long_text: bacnet_decode(bacnet_encode("character-string", repeat("x", 300))?)?[0].value == repeat("x", 300),
    many: bacnet_decode("00" + "11" + "4441ac0000" + "9101" + "a47a0b01ff" + "b40a1e0000" + "8200ff")?,
    bits: bacnet_decode(bacnet_encode("bit-string", [false, true, false, false])?)?[0].value,
    bad: bacnet_encode("real", "warm").error,
    who_is: bacnet_parse("810b000c0120ffff00ff1008")?,
    i_am: bacnet_parse("810a0014" + "0100" + "1000" + "c4020004d2" + "2205c4" + "9103" + "2107")?,
}
