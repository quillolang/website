// Shared bikes and scooters on a map of the Netherlands: the browser asks for its view and zoom, and gets clusters with counts instead of 400 markers.
//
//   quillo run map_clusters.qwe      then open http://localhost:8080/clusters?zoom=7

use "map_clusters.qwer"

let LOADED = map_clusters_load("vehicles", json.parse(read_file("map_clusters_sample.geojson")), { radius: 60.0, max_zoom: 16 })?

// /clusters?zoom=9&west=3.3&south=50.7&east=7.3&north=53.6, as a map sends on each move.
route GET /clusters ? { zoom: int = 7, west: float = 3.3, south: float = 50.7, east: float = 7.3, north: float = 53.6 } {
    let features = map_clusters_get("vehicles", [west, south, east, north], zoom)?
    {
        loaded: LOADED,
        shown: len(features),
        counts: features | filter((f) => f.properties.cluster ?? false) | map((f) => f.properties.point_count) | sort,
        type: "FeatureCollection",
        features: features,
    }
}

// What a click on the biggest cluster at zoom 7 does: the zoom to fly to, and the first points for a list.
route GET /biggest {
    let clusters = map_clusters_get("vehicles", [3.3, 50.7, 7.3, 53.6], 7)? | filter((f) => f.properties.cluster ?? false)
    let big = last(sort_by(clusters, (f) => f.properties.point_count))
    let id = big.properties.cluster_id
    {
        count: big.properties.point_count,
        zoom_to: map_clusters_expansion_zoom("vehicles", id)?,
        splits_into: len(map_clusters_children("vehicles", id)?),
        first_three: map_clusters_leaves("vehicles", id, 3, 0)? | map((f) => f.properties.city),
        at_zoom_17: len(map_clusters_get("vehicles", [3.3, 50.7, 7.3, 53.6], 17)?),
    }
}
