//! Text wrapped and filled at a width, for plain-text emails, terminals and fixed-width files: paragraphs kept, words never cut unless longer than a line, indents and "> " quoting.
//! version: 1.0.0
//!
//! [dependencies]
//! textwrap = "0.16"

use textwrap::Options;

const MAX: usize = 5_000_000;

fn check(text: &str, width: i64) -> Result<usize, String> {
    if text.len() > MAX {
        return Err("text up to 5 MB".into());
    }
    Ok(width.clamp(1, 10_000) as usize)
}

fn each_paragraph(text: &str, f: impl Fn(&str) -> String) -> String {
    text.split("\n\n").map(|p| f(&p.split_whitespace().collect::<Vec<_>>().join(" "))).collect::<Vec<_>>().join("\n\n")
}

/// `text` as lines of at most `width` columns, breaking between words (wide characters such as 日本 count 2). Line breaks in the text are kept; a word longer than a line is split.
pub fn wrap_lines(text: &str, width: i64) -> Result<Vec<String>, String> {
    let w = check(text, width)?;
    Ok(textwrap::wrap(text, w).into_iter().map(|l| l.into_owned()).collect())
}

/// `text` refilled at `width`: each paragraph (blank line apart) joined and wrapped again, for a plain-text email body.
pub fn wrap_fill(text: &str, width: i64) -> Result<String, String> {
    let w = check(text, width)?;
    Ok(each_paragraph(text, |p| textwrap::fill(p, w)))
}

/// `text` refilled at `width` with `first` before its first line and `rest` before the others, per paragraph: a hanging indent ("1. " and "   ") or a bullet ("* " and "  ").
pub fn wrap_hanging(text: &str, width: i64, first: &str, rest: &str) -> Result<String, String> {
    let w = check(text, width)?;
    Ok(each_paragraph(text, |p| textwrap::fill(p, Options::new(w).initial_indent(first).subsequent_indent(rest))))
}

/// `text` quoted for a reply, each line refilled at `width` and starting with "> ", blank lines as ">".
pub fn wrap_quote(text: &str, width: i64) -> Result<String, String> {
    let w = check(text, width)?;
    let filled = each_paragraph(text, |p| textwrap::fill(p, Options::new(w.saturating_sub(2).max(1)).initial_indent("").subsequent_indent("")));
    Ok(filled.lines().map(|l| if l.is_empty() { ">".to_string() } else { format!("> {}", l) }).collect::<Vec<_>>().join("\n"))
}

/// `text` with `prefix` before each line that is not blank.
pub fn wrap_indent(text: &str, prefix: &str) -> Result<String, String> {
    check(text, 1)?;
    Ok(textwrap::indent(text, prefix))
}

/// `text` with the spaces all its lines share taken off the front: for text written indented inside code.
pub fn wrap_dedent(text: &str) -> Result<String, String> {
    check(text, 1)?;
    Ok(textwrap::dedent(text))
}
