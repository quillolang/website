//! An SNMP manager (v1, v2c and v3 with USM: MD5, SHA and SHA-2 authentication, DES and AES privacy): get, get-next, get-bulk, walk, whole tables and set; traps and informs sent, and received ones read for a `udp.listen` handler (informs answered); OIDs and common MIB names (system, interfaces, ifXTable, host resources, Printer-MIB, UPS-MIB, entity) both ways.
//! version: 1.0.0
//!
//! [dependencies]
//! md-5 = "0.10"
//! sha1 = "0.10"
//! sha2 = "0.10"
//! hmac = "0.12"
//! aes = "0.8"
//! des = "0.8"

use serde_json::{json, Map, Value};
use std::collections::HashMap;
use std::net::{SocketAddr, ToSocketAddrs, UdpSocket};
use std::sync::{Mutex, OnceLock};
use std::time::{Duration, Instant};

