// MIME types for downloads, and the extensions an upload form accepts.
//
//   quillo run mime.qwe      then open http://localhost:8080/types

use "mime.qwer"

route GET /types = ["report.pdf", "Photo.JPG", "style.css", "data.json", "song.mp3", "backup.tar.gz", "css", "notes.unknown"]
    | map((n) => { name: n, type: mime_of(n), header: mime_content_type(n) })

route GET /extensions ? { type: str = "image/jpeg" } = { type, extensions: mime_extensions(type), all_for_xml: mime_all("feed.xml") }

// A file served with the type its name says.
route GET /docs/:name {
    write_file("data/docs/notes.md", "# Notes\n\nShipped on Friday.\n")
    let text = read_file(`data/docs/${name}`) ?? reply 404 "No such document"
    respond(200, text, { "content-type": mime_content_type(name) })
}
