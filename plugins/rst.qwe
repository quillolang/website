// reStructuredText shown as a page, as a docs site would: the document, its table of contents,
// the fields at its top, and a list of what does not resolve, for a build to fail on.
//
//   quillo run rst.qwe      then open http://localhost:8080/page, /data, /fields and /small

use "rst.qwer"

let TEXT = read_file("rst_sample.rst")

route GET /page = respond(200, rst_to_html(TEXT), { "content-type": "text/plain" })

route GET /data {
    let d = rst_parse(TEXT)
    { title: d.title, headings: d.headings | map((h) => [h.level, h.title, h.id]), problems: d.problems }
}

route GET /fields = rst_fields(TEXT)

route GET /small = {
    transition: rst_to_html("a\n\n----\n\nb\n"),
    empty: rst_to_html(""),
    levels: rst_parse("A\n=\n\nB\n-\n\nC\n=\n\nD\n~\n\nE\n-\n").headings | map((h) => h.level),
    duplicate: rst_parse("Same\n====\n\nSame\n====\n").headings | map((h) => h.id),
    crlf: rst_to_html("Title\r\n=====\r\n\r\ntext\r\n"),
    literal_end: rst_to_html("Words::\n\n  code\n\nafter\n"),
    nested_inline: rst_to_html("*a* *b*, (*c*) d*e* *\n"),
    bad_grid: rst_parse("+---+\n| a\n+---+\n").problems,
    long: rst_to_html(repeat("word ", 3)),
    self_naming: rst_parse(".. |a| replace:: x |a|\n\n|a|\n").problems,
}
