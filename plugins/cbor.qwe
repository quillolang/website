// Reading the COSE public key a passkey sends at registration, and CBOR both ways.
//
//   quillo run cbor.qwe      then open http://localhost:8080/cose

use "cbor.qwer"

// A COSE EC2 key as WebAuthn sends it, base64url: { 1: 2 (EC2), 3: -7 (ES256), -1: 1 (P-256), -2: x, -3: y }.
let COSE_KEY = "pQECAyYgASFYIAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4fIlggICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8"

route GET /cose {
    let k = cbor_decode(COSE_KEY)?
    { key_type: k["1"] == 2 ? "EC2" : "other", algorithm: k["3"] == -7 ? "ES256" : "other", curve: k["-1"] == 1 ? "P-256" : "other", x: k["-2"] }
}

route GET /roundtrip {
    let reading = { sensor: "greenhouse-3", celsius: 21.5, humidity: 64, at: 1793530800, ok: true }
    let bytes = cbor_write_file("data/reading.cbor", reading)?
    { bytes, json_bytes: len(json.stringify(reading)), back: cbor_read_file("data/reading.cbor")?, base64: cbor_encode(reading)? }
}
