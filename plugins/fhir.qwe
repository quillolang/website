// A small FHIR R4 server and a client's reading of what it says: resources checked before they are
// taken, a search with paging, a Bundle built and read, references resolved, fields read by path.
// Every record here is made up.
//
//   quillo run fhir.qwe      then open http://localhost:8080/fhir/Patient?family=lov, /check, /path, /bundle, /search and /refused

use "fhir.qwer"

let BASE = "http://localhost:8080/fhir"

let ADA = {
    resourceType: "Patient", id: "p1", gender: "female", birthDate: "1815-12-10",
    name: [{ use: "official", family: "Lovelace", given: ["Augusta", "Ada"] }, { use: "nickname", given: ["Ada"] }],
    telecom: [{ system: "phone", value: "+44 20 7946 0000" }, { system: "email", value: "ada@example.org" }],
    identifier: [{ system: "http://hospital.example/mrn", value: "MRN-1" }],
}

let STORE = [
    ADA,
    { resourceType: "Patient", id: "p2", gender: "male", birthDate: "1791-12-26", name: [{ family: "Babbage", given: ["Charles"] }] },
    { resourceType: "Patient", id: "p3", gender: "female", birthDate: "1906-12-09", name: [{ family: "Hopper", given: ["Grace"] }] },
    { resourceType: "Patient", id: "p4", gender: "male", birthDate: "1912-06-23", name: [{ family: "Turing", given: ["Alan"] }] },
    { resourceType: "Patient", id: "p5", gender: "female", birthDate: "1910-01-01", name: [{ family: "Lovett", given: ["Mary"] }] },
    { resourceType: "Observation", id: "o1", status: "final", code: { coding: [{ system: "http://loinc.org", code: "8867-4", display: "Heart rate" }] }, subject: { reference: "Patient/p1", display: "Ada" }, effectiveDateTime: "2026-10-01T09:30:00Z", valueQuantity: { value: 72, unit: "beats/minute" } },
    { resourceType: "Observation", id: "o2", status: "preliminary", code: { coding: [{ system: "http://loinc.org", code: "8310-5", display: "Body temperature" }] }, subject: { reference: "Patient/p2" }, effectiveDateTime: "2026-10-02T09:30:00+01:00", valueQuantity: { value: 36.6, unit: "Cel" } },
]

// The search of a FHIR server, its answer a searchset Bundle.
route GET /fhir/:kind {
    let r = fhir_search(kind, STORE, fhir_query_text(request.query), BASE)
    if is_err(r) { reply 400 fhir_outcome("error", "not-supported", r.error) }
    r
}

route GET /fhir/:kind/:id {
    let found = find(STORE, (x) => x.resourceType == kind && x.id == id)
    if found == null { reply 404 fhir_outcome("error", "not-found", `${kind}/${id} is not known`) }
    found
}

// A client's check of what it means to send.
route POST /fhir/:kind {
    let body = request.json ?? {}
    let checked = fhir_check(body)
    if !checked.ok { reply 422 fhir_outcome("error", "invalid", join(checked.problems, "; ")) }
    { accepted: true }
}

route GET /check = {
    good: fhir_check(ADA),
    observation: fhir_check({ resourceType: "Observation", code: { text: "x" } }).problems,
    codes: fhir_check({ resourceType: "Patient", gender: "woman", birthDate: "1815-13-10" }).problems,
    time_zone: fhir_check({ resourceType: "Observation", status: "final", code: { text: "x" }, effectiveDateTime: "2026-10-01T09:30:00" }).problems,
    choice: fhir_check({ resourceType: "MedicationRequest", status: "active", intent: "order", subject: { reference: "Patient/p1" } }).problems,
    empty: fhir_check({ resourceType: "Patient", name: [], gender: "" }).problems,
    not_one: fhir_check({ resourceType: "Patent" }).problems,
    org: fhir_check({ resourceType: "Organization" }).problems,
    bundle: fhir_check({ resourceType: "Bundle", type: "transaction", total: 1, entry: [{ resource: { resourceType: "Observation" } }] }).problems,
}

route GET /path = {
    family: fhir_get(ADA, "name.where(use='official').family")?,
    given: fhir_path(ADA, "Patient.name[0].given")?,
    phone: fhir_get(ADA, "telecom.where(system='phone').value")?,
    first: fhir_get(ADA, "name.given.first()")?,
    count: fhir_get(ADA, "telecom.count()")?,
    missing: fhir_get(ADA, "deceasedBoolean")?,
    choice: fhir_get(STORE[5], "value.value")?,
    unknown: fhir_path(ADA, "name.select(family)").error,
}

route GET /bundle {
    let b = fhir_bundle_build("transaction", [STORE[0], STORE[5], { resourceType: "Patient", name: [{ family: "New" }] }], BASE)?
    let read = fhir_bundle_read(b)?
    {
        ok: fhir_check(b).ok,
        requests: read.entries | map((e) => e.request),
        urls: read.entries | map((e) => e.full_url),
        subject: fhir_resolve(b, STORE[5].subject, null)?.id,
        by_url: fhir_resolve(b, "http://localhost:8080/fhir/Patient/p1", null)?.gender,
        versioned: fhir_resolve(b, "Patient/p1/_history/3", null)?.id,
        absent: fhir_resolve(b, "Patient/none", null),
        contained: fhir_resolve(b, "#m1", { contained: [{ resourceType: "Medication", id: "m1" }] })?.resourceType,
        refs: fhir_references(STORE[5]),
        wrong_kind: fhir_bundle_read(ADA).error,
        wrong_type: fhir_bundle_build("pile", [], "").error,
    }
}

route GET /search {
    let page1 = fhir_bundle_read(fhir_search("Patient", STORE, "gender=female&_sort=-birthdate&_count=2", BASE)?)?
    let page2 = fhir_bundle_read(fhir_search("Patient", STORE, "gender=female&_sort=-birthdate&_count=2&_offset=2", BASE)?)?
    {
        total: page1.total, first: page1.entries | map((e) => e.id), next: page1.links.next,
        second: page2.entries | map((e) => e.id), previous: page2.links.previous, no_next: page2.links.next,
        parsed: fhir_search_parse("birthdate=ge1900-01-01&name:exact=Ada&code=http://loinc.org|8867-4,8310-5&_count=5&_include=Observation:patient")?,
        dates: fhir_bundle_read(fhir_search("Patient", STORE, "birthdate=ge1900&birthdate=lt1911", BASE)?)?.entries | map((e) => e.id),
        token: fhir_bundle_read(fhir_search("Observation", STORE, "code=http://loinc.org|8867-4", BASE)?)?.entries | map((e) => e.id),
        identifier: fhir_bundle_read(fhir_search("Patient", STORE, "identifier=http://hospital.example/mrn|MRN-1", BASE)?)?.total,
        email: fhir_bundle_read(fhir_search("Patient", STORE, "email=ada@example.org", BASE)?)?.total,
        with_patient: fhir_bundle_read(fhir_search("Observation", STORE, "patient=p1&_include=Observation:patient", BASE)?)?.entries | map((e) => [e.search_mode, e.id]),
        url: fhir_search_url(BASE, "Patient", { family: "Lovelace jr", _count: "5" }),
    }
}


route GET /refused = {
    unknown: fhir_search("Patient", STORE, "shoe_size=9", BASE).error,
    modifier: fhir_search("Patient", STORE, "name:phonetic=x", BASE).error,
    count: fhir_search_parse("_count=many").error,
    outcome: fhir_outcome("error", "not-found", "Patient/x is not known"),
}
