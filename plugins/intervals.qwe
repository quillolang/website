// A day of meeting-room bookings: double bookings found, a room's free slots, how many rooms the day
// needs, the bookings given rooms, and what is on at a moment from an index kept in memory.
//
//   quillo run intervals.qwe      then open http://localhost:8080/day

use "intervals.qwer"

let BOOKINGS = [
    { id: 1, room: "Oak", who: "Ana", start: "2026-11-02T09:00", end: "2026-11-02T10:00" },
    { id: 2, room: "Oak", who: "Ben", start: "2026-11-02T09:30", end: "2026-11-02T11:00" },
    { id: 3, room: "Pine", who: "Cy", start: "2026-11-02T10:00", end: "2026-11-02T12:00" },
    { id: 4, room: "Oak", who: "Dee", start: "2026-11-02T11:00", end: "2026-11-02T12:30" },
    { id: 5, room: "Pine", who: "Eve", start: "2026-11-02T13:00", end: "2026-11-02T14:00" },
    { id: 6, room: "Oak", who: "Fay", start: "2026-11-02T15:00", end: "2026-11-02T16:00" },
]

route GET /day {
    let oak = BOOKINGS | filter((b) => b.room == "Oak")
    {
        double_booked: intervals_conflicts(BOOKINGS, "room")? | map((c) => { room: c.a.room, who: [c.a.who, c.b.who], from: c.from, to: c.to }),
        oak_free: intervals_free(oak, "2026-11-02T08:00", "2026-11-02T18:00", "30m")?,
        oak_busy: intervals_merge(oak)?,
        rooms_needed: intervals_peak(BOOKINGS)?,
        after_10: intervals_overlapping(BOOKINGS, "2026-11-02T10:00", "2026-11-02T10:30")? | map((b) => b.who),
    }
}

// The same bookings given rooms again, so that none overlap; one room is not enough.
route GET /replan {
    let two = intervals_assign(BOOKINGS, ["Oak", "Pine"])?
    let one = intervals_assign(BOOKINGS, ["Oak"])?
    {
        rooms: two.items | map((b) => `${b.who}: ${b.place}`),
        needed: intervals_assign(BOOKINGS, [])?.needed,
        one_room_leaves_out: one.unplaced | map((b) => b.who),
    }
}

route GET /now ? { at: str = "2026-11-02T11:30" } {
    if intervals_count("rooms") == 0 { intervals_add("rooms", BOOKINGS)? }
    { at: at, on: intervals_find("rooms", at, at)? | map((b) => `${b.who} in ${b.room}`) }
}
