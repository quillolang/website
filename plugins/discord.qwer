//! Messages to Discord channels through webhooks: content, embeds (title, color, fields, images, footer, timestamp) built and checked against Discord's limits, mentions kept off unless asked for, threads, and the rate limit's wait reported.
//! version: 1.0.0
//!
//! [dependencies]
//! ureq = "2"
//! serde_json = { version = "1", features = ["preserve_order"] }

use serde_json::{json, Map, Value};

fn color(v: &Value) -> Result<Option<i64>, String> {
    match v {
        Value::Null => Ok(None),
        Value::Number(n) => Ok(n.as_i64()),
        Value::String(s) => {
            let h = s.trim().trim_start_matches('#');
            let full: String = if h.len() == 3 { h.chars().flat_map(|c| [c, c]).collect() } else { h.to_string() };
            i64::from_str_radix(&full, 16).map(Some).map_err(|_| format!("color `{}` is not #rrggbb", s))
        }
        _ => Err("color is #rrggbb or a number".into()),
    }
}

/// An embed from a map: `title`, `description`, `url`, `color` ("#5865f2" or a number), `fields` (a map of name to value, or
/// `[{ name, value, inline }]`), `image`, `thumbnail`, `author` (a name, or `{ name, url, icon_url }`), `footer`, `timestamp`
/// (ISO 8601). Gives an error value naming the limit a part breaks (256 for a title, 4096 for a description, 25 fields...).
pub fn discord_embed(spec: serde_json::Value) -> Result<Value, String> {
    let s = |k: &str| spec[k].as_str();
    let mut e = Map::new();
    let limit = |k: &str, v: &str, n: usize| if v.chars().count() > n { Err(format!("an embed's {} is at most {} characters ({} given)", k, n, v.chars().count())) } else { Ok(()) };
    if let Some(t) = s("title") { limit("title", t, 256)?; e.insert("title".into(), json!(t)); }
    if let Some(d) = s("description") { limit("description", d, 4096)?; e.insert("description".into(), json!(d)); }
    if let Some(u) = s("url") { e.insert("url".into(), json!(u)); }
    if let Some(c) = color(&spec["color"])? { e.insert("color".into(), json!(c)); }
    let fields: Vec<Value> = match &spec["fields"] {
        Value::Object(m) => m.iter().map(|(k, v)| json!({ "name": k, "value": v.as_str().map(str::to_string).unwrap_or_else(|| v.to_string()), "inline": true })).collect(),
        Value::Array(a) => a.clone(),
        _ => vec![],
    };
    if fields.len() > 25 {
        return Err(format!("an embed has at most 25 fields ({} given)", fields.len()));
    }
    for f in &fields {
        limit("field name", f["name"].as_str().unwrap_or(""), 256)?;
        limit("field value", f["value"].as_str().unwrap_or(""), 1024)?;
    }
    if !fields.is_empty() { e.insert("fields".into(), json!(fields)); }
    if let Some(i) = s("image") { e.insert("image".into(), json!({ "url": i })); }
    if let Some(i) = s("thumbnail") { e.insert("thumbnail".into(), json!({ "url": i })); }
    match &spec["author"] {
        Value::String(a) => { e.insert("author".into(), json!({ "name": a })); }
        Value::Object(a) => { e.insert("author".into(), Value::Object(a.clone())); }
        _ => {}
    }
    match &spec["footer"] {
        Value::String(f) => { limit("footer", f, 2048)?; e.insert("footer".into(), json!({ "text": f })); }
        Value::Object(f) => { e.insert("footer".into(), Value::Object(f.clone())); }
        _ => {}
    }
    if let Some(t) = s("timestamp") { e.insert("timestamp".into(), json!(t)); }
    let total: usize = ["title", "description"].iter().filter_map(|k| e.get(*k).and_then(|v| v.as_str())).map(|v| v.chars().count()).sum::<usize>()
        + fields.iter().map(|f| f["name"].as_str().unwrap_or("").chars().count() + f["value"].as_str().unwrap_or("").chars().count()).sum::<usize>();
    if total > 6000 {
        return Err(format!("an embed's text is at most 6000 characters in all ({} given)", total));
    }
    Ok(Value::Object(e))
}

/// Posts to a channel's webhook (`https://discord.com/api/webhooks/<id>/<token>`; empty: DISCORD_WEBHOOK_URL). `message` holds
/// `content` (up to 2000 characters) and/or `embeds` (up to 10, from `discord_embed`), and maybe `username`, `avatar_url`,
/// `thread_id` (post in a thread) and `mentions` (true lets @everyone and user mentions ping; off by default). Gives
/// `{ ok, status, id, retry_after }`: when Discord says slow down, `retry_after` is the seconds to wait.
pub fn discord_send(webhook_url: &str, message: serde_json::Value) -> Result<Value, String> {
    let url = if webhook_url.is_empty() { std::env::var("DISCORD_WEBHOOK_URL").map_err(|_| "no webhook URL, and DISCORD_WEBHOOK_URL is not set".to_string())? } else { webhook_url.to_string() };
    let m = message.as_object().ok_or("the message is a map: { content, embeds }")?;
    let content = m.get("content").and_then(|v| v.as_str()).unwrap_or("");
    let embeds = m.get("embeds").and_then(|v| v.as_array()).cloned().unwrap_or_default();
    if content.is_empty() && embeds.is_empty() {
        return Err("a message needs content or embeds".into());
    }
    if content.chars().count() > 2000 {
        return Err(format!("content is at most 2000 characters ({} given)", content.chars().count()));
    }
    if embeds.len() > 10 {
        return Err("a message has at most 10 embeds".into());
    }
    let mut body = Map::new();
    if !content.is_empty() { body.insert("content".into(), json!(content)); }
    if !embeds.is_empty() { body.insert("embeds".into(), json!(embeds)); }
    for k in ["username", "avatar_url", "tts"] {
        if let Some(v) = m.get(k) { body.insert(k.into(), v.clone()); }
    }
    let mentions = m.get("mentions").and_then(|v| v.as_bool()).unwrap_or(false);
    body.insert("allowed_mentions".into(), if mentions { json!({ "parse": ["users", "roles", "everyone"] }) } else { json!({ "parse": [] }) });
    let mut full = format!("{}{}wait=true", url, if url.contains('?') { "&" } else { "?" });
    if let Some(t) = m.get("thread_id").and_then(|v| v.as_str()) {
        full.push_str(&format!("&thread_id={}", t));
    }
    let res = ureq::post(&full).timeout(std::time::Duration::from_secs(15)).set("Content-Type", "application/json").send_string(&Value::Object(body).to_string());
    let (status, text) = match res {
        Ok(r) => (r.status(), r.into_string().unwrap_or_default()),
        Err(ureq::Error::Status(c, r)) => (c, r.into_string().unwrap_or_default()),
        Err(e) => return Err(e.to_string()),
    };
    let v: Value = serde_json::from_str(&text).unwrap_or(Value::Null);
    let ok = (200..300).contains(&status);
    Ok(json!({
        "ok": ok,
        "status": status,
        "id": v["id"],
        "retry_after": if status == 429 { v["retry_after"].clone() } else { Value::Null },
        "error": if ok { Value::Null } else { v["message"].clone() },
    }))
}
