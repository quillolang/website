// Secrets from HashiCorp Vault: a secret and its versions, an AppRole sign-in, data encrypted by a
// key that never leaves Vault, and short-lived database credentials under a lease.
//
//   VAULT_API_URL=http://localhost:8200 VAULT_ROLE_ID=... VAULT_SECRET_ID=... quillo run vault.qwe
//   then open /health, /kv, /versions, /transit, /leases and /broken
//
// VAULT_TOKEN=... works in place of AppRole.

use "vault.qwer"

route GET /health = { health: vault_health()?, login: vault_login()?.ttl_seconds > 0 }

route GET /kv {
    let one = vault_kv_put("shop/stripe", { api_key: "one", mode: "test" }, 0)?
    let read = vault_kv_get("shop/stripe", 0)?
    {
        version: one.version,
        data: read.data,
        only_if_new: vault_kv_put("shop/stripe", { api_key: "x" }, 0).error,
        none: vault_kv_get("shop/nothing", 0)?,
    }
}

route GET /versions {
    let two = vault_kv_put("app/db", { password: "first" }, -1)?
    let three = vault_kv_put("app/db", { password: "second" }, two.version)?
    let stale = vault_kv_put("app/db", { password: "late" }, two.version).error
    let patched = vault_kv_patch("app/db", { user: "app" }, -1)?
    let now = vault_kv_get("app/db", 0)?
    let old = vault_kv_get("app/db", two.version)?
    vault_kv_delete("app/db", [two.version])?
    let deleted = vault_kv_get("app/db", two.version)?
    vault_kv_undelete("app/db", [two.version])?
    let back = vault_kv_get("app/db", two.version)?
    vault_kv_destroy("app/db", [three.version])?
    let gone = vault_kv_get("app/db", three.version)?
    let meta = vault_kv_metadata("app/db")?
    {
        stale: stale,
        now: now.data,
        current: patched.version,
        old: old.data,
        deleted: deleted.data,
        deleted_at: deleted.deleted_time != null,
        back: back.data,
        destroyed: gone.destroyed,
        versions: len(keys(meta.versions)),
        listed: vault_kv_list("app")?,
        top: vault_kv_list("")?,
        empty: vault_kv_list("nothing")?,
    }
}

route GET /transit {
    let c = vault_encrypt("orders", "card 4242 — é", "")?
    let rotated = vault_rotate("orders")?
    let d = vault_rewrap("orders", c)?
    let many = vault_encrypt_many("orders", ["a", "b"])?
    {
        prefix: slice(c, 0, 9),
        plain: vault_decrypt("orders", c, "")?,
        rotated: rotated,
        rewrapped: slice(d, 0, 9),
        still: vault_decrypt("orders", d, "")?,
        many: vault_decrypt_many("orders", [many[0].ciphertext, "vault:v1:bad", many[1].ciphertext])?,
        forged: vault_decrypt("orders", "vault:v1:AAAA", "").error,
        not_cipher: vault_decrypt("orders", "plain text", "").error,
        no_key: vault_encrypt("nothing", "x", "").error,
    }
}

route GET /leases {
    let c = vault_read("database/creds/readonly")?
    let more = vault_lease_renew(c.lease_id, 600)?
    let look = vault_lease_lookup(c.lease_id)?
    vault_lease_revoke(c.lease_id)?
    { user: c.data.username, renewable: c.renewable, renewed: more.lease_duration, ttl: look.ttl, ended: vault_lease_lookup(c.lease_id).error, no_path: vault_read("no/such/path")? }
}

route GET /broken = {
    forbidden: vault_kv_get("forbidden/key", 0).error,
    dots: vault_kv_get("../sys/seal", 0).error,
    not_map: vault_kv_put("x", "text", -1).error,
}
