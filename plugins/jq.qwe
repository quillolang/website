// jq filters over an order API's answer, and over a day of JSON-lines events, as an admin
// might save them for reports.
//
//   quillo run jq.qwe      then open http://localhost:8080/report

use "jq.qwer"

let ORDERS = {
    orders: [
        { id: 1042, customer: { name: "Ada", country: "NL" }, items: [{ sku: "MUG", qty: 2, price: 9.5 }, { sku: "TEA", qty: 1, price: 6.0 }], status: "paid" },
        { id: 1043, customer: { name: "Bas", country: "BE" }, items: [{ sku: "MUG", qty: 1, price: 9.5 }], status: "refunded" },
        { id: 1044, customer: { name: "Cleo", country: "NL" }, items: [{ sku: "POT", qty: 1, price: 32.0 }, { sku: "TEA", qty: 3, price: 6.0 }], status: "paid" },
    ],
}

route GET /report = {
    paid_totals: jq_run(`.orders[] | select(.status == "paid") | { id, total: ([.items[] | .qty * .price] | add) }`, ORDERS)?,
    by_country: jq_first(`[.orders[] | { c: .customer.country, n: 1 }] | group_by(.c) | map({ key: .[0].c, value: length }) | from_entries`, ORDERS)?,
    skus: jq_first(`[.orders[].items[].sku] | unique | join(", ")`, ORDERS)?,
    csv: jq_run(`.orders[] | [.id, .customer.name, .status] | @csv`, ORDERS)?,
    under: jq_with(`[.orders[] | select(([.items[] | .qty * .price] | add) < $max) | .id]`, ORDERS, { max: 25 })?,
}

let EVENTS = `{"at":"09:00","type":"signup","user":"u1"}
{"at":"09:05","type":"purchase","user":"u1","amount":19.0}
{"at":"09:30","type":"purchase","user":"u2","amount":42.5}
{"at":"10:10","type":"signup","user":"u3"}`

route GET /events = {
    purchases: jq_stream(`select(.type == "purchase") | .amount`, EVENTS, false)?,
    revenue: jq_stream(`map(.amount // 0) | add`, EVENTS, true)?[0],
}

route GET /check = {
    fine: jq_check(`.orders | map(.id)`),
    typo: jq_check(`.orders | map(.id`),
    unknown: jq_check(`.orders | mapp(.id)`),
    runtime: jq_run(`.orders[0].id | ascii_downcase`, ORDERS).error,
}
