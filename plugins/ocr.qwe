// An invoice photographed or scanned, read: all its text, its lines with where they are,
// and its fields by the part of the page they are always in.
//
//   quillo run ocr.qwe      then open http://localhost:8080/text
//
// The first picture read downloads the two models (12 MB) into ~/.cache/quillo/ocr, once;
// GET /models gets them ahead of time. OCR_MODELS names another folder for them.

use "ocr.qwer"

route GET /text = ocr_text("ocr_sample.png")

route GET /lines = ocr_lines("ocr_sample.png") | map((l) => { text: l.text, x: l.x, y: l.y, words: len(l.words) })

// Row by row, as a receipt is read: each item with its price.
route GET /rows = ocr_read("ocr_sample.png", { order: "rows" }).text

// The amount at the right of the total's line: only digits and the point may be read.
route GET /total = {
    let r = ocr_read("ocr_sample.png", { range: { x: "75%", y: "58%", height: "12%" }, chars: "0123456789." })
    { total: r.text, range: r.range, seconds: r.seconds }
}

// A form's fields, each where it always is on the page.
route GET /fields = ocr_ranges("ocr_sample.png", {
    invoice: { x: 0, y: "18%", width: "55%", height: "9%" },
    date: { x: "60%", y: "18%", height: "9%" },
    total: { range: { x: "75%", y: "58%", height: "12%" }, chars: "0123456789." },
}, {})

route GET /models = ocr_models(true)
