// A sign-up form that refuses passwords from a leaked list, kept as a 12 KB Bloom filter.
//
//   quillo run bloom.qwe      then open http://localhost:8080/password?p=123456

use "bloom.qwer"

let FILTER = "data/leaked-passwords.bloom"

fn load_filter() {
    if bloom_open(FILTER, 10000, 0.01)? {
        bloom_add(FILTER, ["123456", "password", "qwerty", "111111", "letmein", "iloveyou", "dragon", "monkey"])?
    }
}

route GET /password ? { p: str } {
    load_filter()
    { leaked: bloom_check(FILTER, p)? }
}

route GET /batch {
    load_filter()
    { checks: bloom_check_many(FILTER, ["qwerty", "correct horse battery staple", "dragon"])?, info: bloom_info(FILTER)?, again: bloom_add(FILTER, ["qwerty"])? }
}
