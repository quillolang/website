// Google Analytics 4 from the server: events checked and sent, the validation endpoint, and reports
// read back as rows.
//
//   GA4_MEASUREMENT_ID=G-... GA4_API_SECRET=... GA4_PROPERTY_ID=123456789 \
//   GOOGLE_APPLICATION_CREDENTIALS=key.json quillo run ga4.qwe
//   then open /send, /checks, /validate, /report, /realtime and /failures
//
// The API secret is made under Data Streams in GA4's admin. Add the service account's address to the
// property's access. GA4_MP_URL and GA4_DATA_API_URL reach the EU, or a test server.

use "ga4.qwer"

route GET /send = {
    one: ga4_send("555.1234567890", [ga4_event("purchase", { currency: "EUR", value: 12.5, transaction_id: "T1" })], { user_id: "user-1", user_properties: { plan: "pro" } })?,
    many: ga4_send("555.1234567890", map(range(0, 60), (i) => ga4_event("page_view", { n: i })), {})?,
    not_sent: ga4_send("555.1234567890", [ga4_event("first_open", {})], {}).error,
    no_client: ga4_send("", [ga4_event("x", {})], {}).error,
    none: ga4_send("555.1", [], {}).error,
}

route GET /checks = {
    fit: ga4_check("c", [ga4_event("sign_up", { method: "email" })], {}),
    reserved: ga4_check("c", [ga4_event("session_start", {})], {}),
    long: ga4_check("c", [ga4_event(repeat("a", 41), {})], {}),
    digit: ga4_check("c", [ga4_event("1st", {})], {}),
    prefix: ga4_check("c", [ga4_event("google_thing", { ga_x: 1 })], {}),
    value: ga4_check("c", [ga4_event("x", { note: repeat("n", 101) })], {}),
    map_param: ga4_check("c", [ga4_event("x", { nested: { a: 1 } })], {}),
    user: ga4_check("c", [ga4_event("x", {})], { user_properties: { user_id: "1", favourite_colour_of_my_cat: "x", plan: repeat("p", 37) } }),
    old: ga4_check("c", [ga4_event("x", {})], { timestamp_micros: 1600000000000000 }),
    params: len(ga4_check("c", [ga4_event("x", reduce(range(0, 26), {}, (m, i) => set(m, `p${i}`, i)))], {})),
}

route GET /validate = {
    fit: ga4_validate("555.1", [ga4_event("sign_up", {})], {})?,
    wrong: ga4_validate("555.1", [ga4_event("_bad", {})], {})?,
}

route GET /report {
    let r = ga4_report("", { dimensions: ["country"], metrics: ["activeUsers", "bounceRate", "totalRevenue"], start: "7daysAgo", end: "yesterday", orderBys: [{ metric: { metricName: "activeUsers" }, desc: true }] }, 0)?
    let paged = ga4_report("123456789", { dimensions: ["pagePath"], metrics: ["screenPageViews"], page_size: 500 }, 0)?
    {
        first: r.rows[0], count: r.row_count, quota: r.quota, currency: r.currency, zone: r.time_zone,
        paged: len(paged.rows), capped: len(ga4_report("properties/123456789", { dimensions: ["pagePath"], metrics: ["screenPageViews"], page_size: 500 }, 700)?.rows),
        empty: ga4_report("", { metrics: ["sessions"], dimensions: ["emptySet"] }, 0)?,
        no_metrics: ga4_report("", {}, 0).error,
        g_id: ga4_report("G-ABC123", { metrics: ["sessions"] }, 0).error,
    }
}

route GET /realtime = {
    now: ga4_realtime("", { dimensions: ["unifiedScreenName"], metrics: ["activeUsers"] })?,
}

route GET /failures = {
    bad_metric: ga4_report("", { metrics: ["nonsense"] }, 0).error,
    no_access: ga4_report("999", { metrics: ["sessions"] }, 0).error,
    spent: ga4_report("888", { metrics: ["sessions"] }, 0).error,
    waited: ga4_report("777", { metrics: ["sessions"] }, 0)?.row_count,
}
