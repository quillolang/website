// A thesis's bibliography: the .bib file read, its reference list in APA and IEEE, CSL-JSON for pandoc, and a new entry written.
//
//   quillo run bibtex.qwe      then open http://localhost:8080/apa

use "bibtex.qwer"

route GET /entries = bibtex_read_file("bibtex_sample.bib")? | map((e) => { key: e.key, type: e.type, title: e.title, authors: e.authors | map((p) => p.family), year: e.year, month: e.month, journal: e.journal })

route GET /apa = bibtex_format(read_file("bibtex_sample.bib")?, "apa")? | map((r) => r.text)

route GET /ieee = bibtex_format(read_file("bibtex_sample.bib")?, "ieee")?

route GET /csl = bibtex_to_csl(read_file("bibtex_sample.bib")?)?[2]

route GET /write = respond(200, bibtex_write([{ key: "lovelace1843", type: "article", fields: { author: "Lovelace, Ada", title: "Notes on the Analytical Engine", journal: "Taylor's Scientific Memoirs", year: "1843", note: "Notes A & G" } }])?, { "content-type": "text/plain; charset=utf-8" })
