// Preview deployments named like "brave-blue-fox" instead of numbers.
//
//   quillo run human_ids.qwe      then open http://localhost:8080/deploys

use "human_ids.qwer"

route GET /deploys = [101, 102, 103] | map((n) => { build: n, url: `https://${human_id_for(n, 3, "-")?}.preview.example.com` })

route GET /new = { names_of_2: human_id_count(2)?, project: human_id(2, "-")?, invite: human_id(3, "-")?, alliterating: human_id_alliterating(3, "-")?, names_of_3: human_id_count(3)? }
