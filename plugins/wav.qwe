// A doorbell sound for a shop's web app, made once and served, with its details.
//
//   quillo run wav.qwe      then open http://localhost:8080/doorbell.wav

use "wav.qwer"

fn doorbell() = wav_melody("data/sounds/ding.wav", [
    { frequency: 659.25, seconds: 0.35, volume: 0.6 },
    { frequency: 0, seconds: 0.05 },
    { frequency: 523.25, seconds: 0.6, volume: 0.6 },
])

route GET /doorbell.wav {
    doorbell()?
    file("data/sounds/ding.wav")
}

route GET /sounds {
    doorbell()?
    wav_tone("data/sounds/beep.wav", 880.0, 0.2, 0.5)?
    wav_silence("data/sounds/gap.wav", 0.5)?
    let seconds = wav_join(["data/sounds/beep.wav", "data/sounds/gap.wav", "data/sounds/beep.wav"], "data/sounds/beep-beep.wav")?
    { doorbell: wav_info("data/sounds/ding.wav")?, beep_beep_seconds: seconds }
}
