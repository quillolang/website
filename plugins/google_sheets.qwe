// A Google Sheet as a small database: ranges read and written, rows appended, a table read as maps,
// two ranges at once, a tab added, and A1 notation worked out.
//
//   GOOGLE_APPLICATION_CREDENTIALS=key.json SPREADSHEET_ID=... quillo run google_sheets.qwe
//   then open /a1, /write, /read, /append, /many, /tabs and /broken
//
// Share the spreadsheet with the service account's address first.

use "google_sheets.qwer"

let id = env("SPREADSHEET_ID", "")

route GET /a1 = {
    letters: [1, 26, 27, 52, 703, 18278] | map((n) => gsheets_column_letters(n)),
    numbers: ["A", "Z", "AA", "az", "ZZZ"] | map((c) => gsheets_column_number(c)),
    plain: gsheets_range("Orders", 2, 1, 5, 3)?,
    quoted: gsheets_range("Q1 sales", 2, 1, 5, 3)?,
    apostrophe: gsheets_range("Bob's", 1, 2, 1, 2)?,
    whole: gsheets_range("", 1, 1, 0, 3)?,
    read: gsheets_parse_range("'Bob''s tab'!B2:D5")?,
    open: gsheets_parse_range("Orders!A:C")?,
    cell: gsheets_parse_range("$C$3")?,
    grid: gsheets_grid_range(7, "B2:D5")?,
    backwards: gsheets_range("x", 5, 1, 2, 3).error,
    zero: gsheets_column_letters(0).error,
}

route GET /write = {
    table: gsheets_write(id, "Orders!A1", [["Order", "Customer", "Total"], [1001, "Ada", "12.50"], [1002, "Grace", "=2*20"]], "user")?,
    kept: gsheets_write(id, "'Q1 sales'!A1", [["=1+1", "5"]], "raw")?,
}

route GET /read = {
    shown: gsheets_get(id, "Orders!A1:C3", "")?,
    numbers: gsheets_get(id, "Orders!A2:C3", "unformatted")?,
    formula: gsheets_get(id, "Orders!C3", "formula")?,
    rows: gsheets_get_rows(id, "Orders!A1:C3", "unformatted")?,
    kept: gsheets_get(id, "'Q1 sales'!A1:B1", "unformatted")?,
    empty: gsheets_get(id, "Orders!H1:H9", "")?,
}

route GET /append {
    let r = gsheets_append(id, "Orders!A1", [[1003, "Alan"]], "user", true)?
    { range: r.range, table: r.table, rows: r.rows, last: gsheets_get(id, "Orders!A4:B4", "unformatted")? }
}

route GET /many {
    let w = gsheets_write_many(id, [{ range: "Orders!E1", values: [["a"]] }, { range: "Orders!F1:F2", values: [["b"], ["c"]] }], "raw")?
    let cleared = gsheets_clear(id, "Orders!F1:F2")?
    { cells: w.cells, read: gsheets_get_many(id, ["Orders!E1", "Orders!F1:F2"], "")?, cleared: cleared }
}

route GET /tabs {
    let tab = gsheets_add_sheet(id, "Archive")?
    let grid = gsheets_grid_range(tab, "A1:B2")?
    gsheets_batch_update(id, [{ repeatCell: { range: grid, cell: { userEnteredFormat: { textFormat: { bold: true } } }, fields: "userEnteredFormat.textFormat.bold" } }])?
    let info = gsheets_info(id)?
    { title: info.title, tabs: info.sheets | map((s) => s.title), same_id: (info.sheets | filter((s) => s.title == "Archive"))[0].id == tab, again: gsheets_add_sheet(id, "Archive").error }
}

route GET /broken = {
    no_tab: gsheets_get(id, "Nowhere!A1", "").error,
    no_file: gsheets_get("missing-spreadsheet", "A1", "").error,
    forbidden: gsheets_get("forbidden-spreadsheet", "A1", "").error,
    bad_rows: gsheets_write(id, "Orders!A1", ["not rows"], "").error,
    bad_mode: gsheets_write(id, "Orders!A1", [["x"]], "typed").error,
}
