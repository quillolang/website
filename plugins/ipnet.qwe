// An admin page open only from the office and the VPN.
//
//   quillo run ipnet.qwe      then open http://localhost:8080/admin

use "ipnet.qwer"

let OFFICE = ["127.0.0.1", "::1", "10.20.0.0/16", "2001:db8:42::/48"]

fn office_only(req) {
    if !ip_in(req.ip, OFFICE)? { reply 403 "From the office only" }
    req
}

route GET /admin = request | office_only | ((r) => { welcome: "admin", from: r.ip })
route GET /samples = { vpn: ip_in("10.20.3.4", OFFICE)?, outside: ip_in("8.8.8.8", OFFICE)?, private: ip_private("192.168.1.9")?, v6: ip_version("2001:db8::1")? }
