//! OpenStreetMap opening_hours strings ("Mo-Fr 08:00-18:00; Sa 09:00-13:00; PH off") read as people and maps write them: open now or not, when that changes, when it next opens, each day's hours for a week, with the public holidays of the shop's country, and expressions checked and tidied.
//! version: 1.0.0
//!
//! [dependencies]
//! opening-hours = { version = "=2.1.4", default-features = false }
//! chrono = { version = "0.4", default-features = false, features = ["std", "clock"] }
//! serde_json = { version = "1", features = ["preserve_order"] }

use chrono::{Duration, NaiveDate, NaiveDateTime};
use opening_hours::localization::Country;
use opening_hours::{Context, OpeningHours, RuleKind};
use serde_json::{json, Value};

fn parse_oh(expr: &str, country: &str) -> Result<OpeningHours, String> {
    let oh = OpeningHours::parse(expr.trim()).map_err(|e| format!("`{}` is not an opening_hours expression: {}", expr.trim(), e))?;
    let c = country.trim();
    if c.is_empty() { return Ok(oh) }
    let country: Country = c.to_uppercase().parse().map_err(|_| format!("`{}` is not a country code (\"FR\", \"PH\")", c))?;
    Ok(oh.with_context(Context::default().with_holidays(country.holidays())))
}

fn parse_time(s: &str) -> Result<NaiveDateTime, String> {
    let t = s.trim();
    if t.is_empty() || t == "now" { return Ok(chrono::Local::now().naive_local()) }
    if let Ok(d) = chrono::DateTime::parse_from_rfc3339(t) { return Ok(d.naive_local()) }
    for f in ["%Y-%m-%dT%H:%M:%S", "%Y-%m-%dT%H:%M", "%Y-%m-%d %H:%M"] {
        if let Ok(d) = NaiveDateTime::parse_from_str(t, f) { return Ok(d) }
    }
    Err(format!("`{}` is not a local date and time (2026-10-29T14:30)", s))
}

fn kind(k: RuleKind) -> &'static str {
    match k { RuleKind::Open => "open", RuleKind::Closed => "closed", RuleKind::Unknown => "unknown" }
}

fn fmt(t: NaiveDateTime) -> String { t.format("%Y-%m-%dT%H:%M").to_string() }

fn horizon(t: NaiveDateTime) -> NaiveDateTime { t + Duration::days(400) }

/// The state at a local time (`"2026-10-29T14:30"`, or `"now"` on the server's clock) of the shop with hours `expr`, in `country` (`"FR"`; `""` when `PH` rules are not used):
/// `{ state, open, comment, next_change, next_state }`; `state` is "open", "closed" or "unknown" (as `"Mo 10:00-12:00 unknown"` or `"by appointment"` give); `next_change` is null when nothing changes within a year.
pub fn opening_hours_state(expr: &str, at: &str, country: &str) -> Result<Value, String> {
    let oh = parse_oh(expr, country)?;
    let t = parse_time(at)?;
    let mut it = oh.iter_range(t, horizon(t));
    let cur = it.next();
    let (state, comment) = cur.as_ref().map(|r| (kind(r.kind), r.comment.to_string())).unwrap_or(("closed", String::new()));
    let next = it.next();
    Ok(json!({
        "state": state,
        "open": state == "open",
        "comment": if comment.is_empty() { Value::Null } else { json!(comment) },
        "next_change": next.as_ref().map(|r| fmt(r.range.start)),
        "next_state": next.as_ref().map(|r| kind(r.kind)),
    }))
}

/// When the place next opens from `at`: the local time, `at` itself when it is open then, or null when it does not open within a year.
pub fn opening_hours_next_open(expr: &str, at: &str, country: &str) -> Result<Option<String>, String> {
    let oh = parse_oh(expr, country)?;
    let t = parse_time(at)?;
    Ok(oh.iter_range(t, horizon(t)).find(|r| r.kind == RuleKind::Open).map(|r| fmt(r.range.start.max(t))))
}

/// The hours of the 7 days from `from_date` (`"2026-11-02"`): a list of `{ date, weekday, hours }`, `hours` a list of `{ from, to, state, comment }` for the open and unknown times ("24:00" for midnight at the end), empty on a closed day. For the hours table on a shop's page.
pub fn opening_hours_week(expr: &str, from_date: &str, country: &str) -> Result<Vec<Value>, String> {
    let oh = parse_oh(expr, country)?;
    let d0 = NaiveDate::parse_from_str(from_date.trim(), "%Y-%m-%d").map_err(|_| format!("`{}` is not a date (2026-11-02)", from_date))?;
    let mut out = Vec::new();
    for i in 0..7 {
        let d = d0 + Duration::days(i);
        let (a, b) = (d.and_hms_opt(0, 0, 0).unwrap(), (d + Duration::days(1)).and_hms_opt(0, 0, 0).unwrap());
        let hours: Vec<Value> = oh.iter_range(a, b).filter(|r| r.kind != RuleKind::Closed).map(|r| {
            let to = if r.range.end >= b { "24:00".to_string() } else { r.range.end.format("%H:%M").to_string() };
            json!({ "from": r.range.start.format("%H:%M").to_string(), "to": to, "state": kind(r.kind), "comment": if r.comment.is_empty() { Value::Null } else { json!(r.comment.to_string()) } })
        }).collect();
        out.push(json!({ "date": d.to_string(), "weekday": d.format("%A").to_string(), "hours": hours }));
    }
    Ok(out)
}

/// Whether `expr` is a valid opening_hours value: `{ valid, error, normalized }`, `normalized` its tidy, unambiguous form (as written back to OpenStreetMap).
pub fn opening_hours_check(expr: &str) -> Value {
    match OpeningHours::parse(expr.trim()) {
        Ok(oh) => json!({ "valid": true, "error": Value::Null, "normalized": oh.normalize().to_string() }),
        Err(e) => json!({ "valid": false, "error": e.to_string(), "normalized": Value::Null }),
    }
}
