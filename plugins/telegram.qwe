// A Telegram bot: a message, a long one split, a photo by URL and by upload, buttons, a webhook whose
// secret is checked before its update is believed, and the Login Widget's hash verified.
//
//   TELEGRAM_BOT_TOKEN=... TELEGRAM_CHAT_ID=... TELEGRAM_WEBHOOK_SECRET=... quillo run telegram.qwe
//   then open http://localhost:8080/send, /long, /photo, /buttons and /login
//
// The token comes from @BotFather. Point the bot at POST /telegram/hook with setWebhook, or see
// /poll. TELEGRAM_API_URL reaches a local Bot API server or a test.

use "telegram.qwer"

let CHAT = env("TELEGRAM_CHAT_ID", "")
let SECRET = env("TELEGRAM_WEBHOOK_SECRET", "")

route GET /send {
    let sent = telegram_send(CHAT, `*Order ${telegram_escape("#1001")}* shipped`, { parse_mode: "MarkdownV2" })?
    { message_id: sent[0].message_id, chat: sent[0].chat.id }
}

route GET /long {
    let sent = telegram_send(CHAT, repeat("A line of the report.\n", 400), {})?
    { parts: len(sent), lengths: map(sent, (m) => len(m.text)) }
}

route GET /photo {
    write_file("data/telegram-demo.jpg", "not really a jpeg")
    {
        by_url: telegram_photo(CHAT, "https://example.com/cat.jpg", "A cat", {})?.caption,
        uploaded: telegram_photo_upload(CHAT, "data/telegram-demo.jpg", "From disk", {})?.caption,
        long_caption: telegram_photo(CHAT, "https://example.com/cat.jpg", repeat("x", 1025), {}).error,
    }
}

route GET /buttons {
    let keys = telegram_keyboard([
        [{ text: "Approve", callback_data: "approve:1001" }, { text: "Reject", callback_data: "reject:1001" }],
        [{ text: "Open", url: "https://example.com/orders/1001" }],
    ])?
    let sent = telegram_send(CHAT, "Order 1001 needs a decision", { reply_markup: keys })?
    let id = sent[0].message_id
    {
        buttons: len(sent[0].reply_markup.inline_keyboard),
        edited: telegram_edit(CHAT, id, "Order 1001: approved", {})?,
        same_again: telegram_edit(CHAT, id, "Order 1001: approved", {})?,
        too_much: telegram_keyboard([[{ text: "x", callback_data: repeat("y", 65) }]]).error,
        no_action: telegram_keyboard([[{ text: "x" }]]).error,
    }
}

route GET /failures = {
    no_chat: telegram_send("-1", "Hi", {}).error,
    blocked: telegram_send("403", "Hi", {}).error,
    empty: telegram_send(CHAT, " ", {}).error,
    retried: telegram_send(CHAT, "flood", {})?[0].text,
}

route GET /hook-setup = {
    set: telegram_set_webhook("https://example.com/telegram/hook", SECRET, { allowed_updates: ["message", "callback_query"] })?,
    bad_secret: telegram_set_webhook("https://example.com/telegram/hook", "no spaces allowed", {}).error,
}

route GET /poll {
    let got = telegram_updates(0, 0, {})?
    { count: len(got), first: got[0].kind, text: got[0].text, command: got[0].command, press: got[1].data }
}

// Telegram posts here: the secret first, then the update.
route POST /telegram/hook {
    if !telegram_webhook_ok(request.headers, SECRET) { reply 401 "not from Telegram" }
    let u = telegram_read_update(request.body)?
    if u.kind == "callback" { telegram_answer_callback(u.callback_id, "Done", false, {})? }
    { kind: u.kind, text: u.text ?? u.data }
}

route GET /hook-check = {
    good: telegram_webhook_ok({ "X-Telegram-Bot-Api-Secret-Token": SECRET }, SECRET),
    wrong: telegram_webhook_ok({ "X-Telegram-Bot-Api-Secret-Token": "guess" }, SECRET),
    absent: telegram_webhook_ok({}, SECRET),
}

// A sign-in with a hash worked out outside this plugin, for the bot token in `login`; a changed
// field fails it. A real one is a fresh auth_date, so give it a limit such as 86400.
let login = { token: "110201543:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw" }
let signed = { id: "42", first_name: "Ada", username: "ada", auth_date: "1790000000", hash: "23ba64017d6199737e8d7559955c5422d50c44c97b606fd9a3783420d0419e86" }

route GET /login = {
    user: telegram_login_check(signed, 0, login)?.first_name,
    tampered: telegram_login_check({ ...signed, id: "43" }, 0, login).error,
    too_old: telegram_login_check(signed, 60, login).error,
}
