// The plain-text part of an HTML email, made from the HTML, and a one-line preview.
//
//   quillo run html_text.qwe      then open http://localhost:8080/email.txt

use "html_text.qwer"

let email = "<h1>Your order has shipped</h1>
<p>Hi Ada, your order <b>#1042</b> is on its way. <a href=\"https://shop.example.com/orders/1042\">Track it here</a>.</p>
<table><tr><th>Item</th><th>Qty</th><th>Price</th></tr><tr><td>Notebook</td><td>2</td><td>€9.00</td></tr><tr><td>Fountain pen</td><td>1</td><td>€1,225.00</td></tr></table>
<ul><li>Arrives Thursday</li><li>Signed for at the door</li></ul>
<p>Questions? <a href=\"mailto:help@example.com\">Write to us</a>.</p>"

route GET /email.txt = respond(200, html_to_text(email, 72)?, { "content-type": "text/plain; charset=utf-8" })

route GET /preview = { preview: html_preview(email, 60)?, bare: html_to_bare_text("<p>Hello <b>there</b>, <a href='/x'>friend</a></p>", 0)? }
