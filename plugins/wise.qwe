// Paying someone abroad with Wise: the profile found, a quote, a recipient, a transfer, and its
// funding, where Wise asks for a signature and gets one.
//
//   WISE_API_TOKEN=... WISE_PRIVATE_KEY_FILE=private.pem WISE_API_URL=https://api.sandbox.transferwise.tech quillo run wise.qwe
//   then open /profiles, /quote, /recipient, /transfer, /signing, /lists and /failures
//
// The public half of the key goes in Wise's settings. In the sandbox strong customer authentication
// is off until you turn it on with that key.

use "wise.qwer"

route GET /profiles {
    let id = wise_profile_id("business")?
    { business: id, personal: wise_profile_id("personal")?, kinds: map(wise_profiles()?, (p) => p.type), none: wise_profile_id("charity").error }
}

route GET /quote {
    let pid = wise_profile_id("business")?
    let sent = wise_quote(pid, "gbp", "eur", 1000.0, "source", {})?
    let due = wise_quote(pid, "GBP", "EUR", 500.0, "target", {})?
    {
        rate: sent.rate,
        pay_in: sent.best.payIn,
        fee: sent.best.fee.total,
        arrives: sent.best.targetAmount,
        leaves: due.best.sourceAmount,
        bad_side: wise_quote(pid, "GBP", "EUR", 1.0, "middle", {}).error,
        none: wise_quote(pid, "GBP", "EUR", 0.0, "source", {}).error,
        refused: wise_quote(pid, "GBP", "XXX", 1.0, "source", {}).error,
    }
}

route GET /recipient {
    let pid = wise_profile_id("business")?
    let r = wise_recipient_create(pid, "eur", "iban", "Ada Lovelace", { legalType: "PRIVATE", iban: "DE89370400440532013000" })?
    {
        id_given: r.id != null,
        listed: len(wise_recipients(pid, "EUR")?),
        other: len(wise_recipients(pid, "USD")?),
        short_name: wise_recipient_create(pid, "EUR", "iban", "Ada", {}).error,
        bad_iban: wise_recipient_create(pid, "EUR", "iban", "Ada Lovelace", { iban: "DE00" }).error,
        deleted: wise_recipient_delete(r.id)?,
    }
}

// The whole path: funding is the call Wise protects with a one-time token to sign.
route GET /transfer {
    let pid = wise_profile_id("business")?
    let r = wise_recipient_create(pid, "EUR", "iban", "Grace Hopper", { legalType: "PRIVATE", iban: "DE89370400440532013000" })?
    let q = wise_quote(pid, "GBP", "EUR", 250.0, "source", {})?
    let tied = wise_quote_for_recipient(pid, q.id, r.id)?
    let key = wise_new_transaction_id()
    let t = wise_transfer(r.id, q.id, key, { reference: "Invoice 1001" })?
    let again = wise_transfer(r.id, q.id, key, { reference: "Invoice 1001" })?
    let funded = wise_fund(pid, t.id)?
    {
        tied: tied.targetAccount == r.id,
        waiting: t.status,
        same: t.id == again.id,
        funded: funded.status,
        now: wise_transfer_get(t.id)?.status,
        not_uuid: wise_transfer(r.id, q.id, "order-1", {}).error,
        short_balance: wise_fund(pid, 777).error,
    }
}

route GET /signing {
    let pid = wise_profile_id("business")?
    {
        balances: map(wise_balances(pid)?, (b) => b.currency),
        other_key: wise_fund(222, 778).error,
        signature: len(wise_sign("5932d5b5-ec13-452f-8688-308feade7834")?),
    }
}

route GET /lists {
    let pid = wise_profile_id("business")?
    { all: len(wise_transfers(pid, { status: "outgoing_payment_sent" }, 0)?), capped: len(wise_transfers(pid, {}, 120)?) }
}

route GET /failures = {
    missing: wise_transfer_get(1).error,
    cancelled: wise_transfer_cancel(55).error,
    any_call: wise_call("get", "/v1/nosuch", null).error,
}
