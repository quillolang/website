// A GraphQL endpoint's guard: each query is read, checked against the schema and refused when
// it is too deep or too big, before any resolver runs.
//
//   quillo run graphql_parse.qwe      then open http://localhost:8080/guard
//   curl -X POST localhost:8080/graphql -H 'content-type: application/json' -d '{"query":"{ me { name } }"}'

use "graphql_parse.qwer"

let SCHEMA = `
type Query { me: User, post(id: ID!): Post }
type User { id: ID!, name: String, friends: [User], posts: [Post] }
type Post { id: ID!, title: String, author: User, comments: [Comment] }
type Comment { text: String, author: User }
`

fn guard(query) {
    let limits = graphql_check_limits(query, 5, 50)
    if !limits.ok { return { ok: false, problems: limits.problems } }
    let problems = graphql_validate(query, SCHEMA)?
    { ok: len(problems) == 0, problems, depth: limits.depth }
}

route POST /graphql { json: { query: str } } {
    let g = guard(json.query)
    if !g.ok { reply 400 { errors: g.problems | map((p) => { message: p }) } }
    { data: { me: { name: "Ada" } } }           // the resolvers would run here
}

route GET /guard = {
    fine: guard("query Me { me { name posts { title } } }"),
    typo: guard("{ me { name emial } }"),
    deep: guard("{ me { friends { friends { friends { friends { friends { name } } } } } } }"),
    broken: guard("{ me { name }"),
}

route GET /info = graphql_info("query Feed($n: Int) { me { ...who posts { title comments { text } } } } fragment who on User { id name }")?
