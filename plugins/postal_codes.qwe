// An address form that checks the postal code for the chosen country and writes it the post office's way.
//
//   quillo run postal_codes.qwe      then open http://localhost:8080/check?code=sw1a1aa&country=GB

use "postal_codes.qwer"

route GET /check ? { code: str, country: str } = postal_check(code, country)?

route GET /examples = [
    { code: "sw1a1aa", country: "GB" }, { code: "1012js", country: "NL" }, { code: "k1a0b1", country: "CA" },
    { code: "1000001", country: "JP" }, { code: "205000001", country: "US" }, { code: "00950", country: "PL" },
    { code: "1050", country: "LV" }, { code: "1234", country: "DE" },
] | map((a) => { country: a.country, typed: a.code, shown: postal_format(a.code, a.country) ?? "invalid" })

route POST /address {
    let a = request.json ?? {}
    if !postal_valid(a.postal_code ?? "", a.country ?? "")? { reply 422 { error: "Please check the postal code." } }
    { ok: true, postal_code: postal_format(a.postal_code, a.country)? }
}
