// A clothing store's RFID: the EPC to write on each item's tag from its GTIN and a serial, the
// pallet's SSCC and the shop floor's GLN as tags, and a reader's inventory decoded back.
//
//   quillo run epc.qwe      then open http://localhost:8080/encode and http://localhost:8080/inventory

use "epc.qwer"

route GET /encode = {
    shirt: epc_sgtin("80614141123458", 7, 6789, 1)?,
    from_uri: epc_from_uri("urn:epc:tag:sgtin-96:3.0614141.812345.6789")?,
    pallet: epc_sscc("106141411234567897", 7, 2)?,
    floor: epc_sgln("0614141123452", 7, 5678, 0)?,
    keg: epc_grai("0614141", "12345", 400, 0)?,
    laptop: epc_giai("0614141", "5678", 0)?,
    bad: epc_sgtin("80614141123459", 7, 1, 1).error,
}

route GET /decode = epc_decode("3074257BF7194E4000001A85")?

route GET /inventory = epc_inventory(["3074257BF7194E4000001A85", "3074257BF7194E4000001A85", "3174257BF4499602D2000000", "E2801160600002084F9B2B5E"])
