// Delivery slots shown in the customer's own time: the time zone of an address's coordinates,
// and what time it is there.
//
//   quillo run timezone_at.qwe      then open http://localhost:8080/zone?lat=40.71&lon=-74.0

use "timezone_at.qwer"

route GET /zone ? { lat: float, lon: float } {
    let here = timezone_local(lat, lon, 0)?
    { zone: here.zone, offset: here.offset, now_there: here.local }
}

// 1 July 2026 12:00 UTC at four warehouses: summer time shows in the offsets.
route GET /warehouses = [
    { city: "Amsterdam", lat: 52.37, lon: 4.89 }, { city: "Sydney", lat: -33.87, lon: 151.21 },
    { city: "Phoenix", lat: 33.45, lon: -112.07 }, { city: "Kathmandu", lat: 27.7, lon: 85.32 },
] | map((w) => { let t = timezone_local(w.lat, w.lon, 1782907200)?; { city: w.city, zone: t.zone, local: t.local, abbreviation: t.abbreviation } })

route GET /sea = { atlantic: timezone_at(30.0, -40.0)?, bad: timezone_at(95.0, 0.0).error }
