// A bakery's LibreOffice files read by its website: the opening letter's text and outline, the orders sheet as typed rows,
// and the slides with their notes.
//
//   quillo run odf_text.qwe      then open http://localhost:8080/letter, /outline, /orders and /slides

use "odf_text.qwer"

route GET /letter = respond(200, odf_text("odf_text_sample.odt")?, { "content-type": "text/plain; charset=utf-8" })

route GET /outline {
    let paras = odf_paragraphs("odf_text_sample.odt")?
    {
        headings: paras | filter((p) => p.kind == "heading") | map((p) => p.text),
        list: paras | filter((p) => p.kind == "list item") | map((p) => { text: p.text, level: p.level }),
        info: odf_info("odf_text_sample.odt")?,
    }
}

route GET /orders {
    let sheet = odf_sheets("odf_text_sample.ods")?[0]
    let rows = slice(sheet.rows, 1, len(sheet.rows))
    {
        sheet: sheet.name,
        header: sheet.rows[0],
        rows: rows,
        total: sum(rows | map((r) => r[1] * r[2])),
        unpaid: rows | filter((r) => !r[4]) | map((r) => r[0]),
    }
}

route GET /slides = odf_slides("odf_text_sample.odp")?

route GET /wrong = { error: odf_sheets("odf_text_sample.odt").error }
