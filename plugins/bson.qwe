// Documents for MongoDB written as BSON, read back, and the time inside an ObjectId.
//
//   quillo run bson.qwe      then open http://localhost:8080/roundtrip

use "bson.qwer"

route GET /roundtrip {
    let id = bson_object_id()
    let doc = { _id: { "$oid": id }, name: "Ada", signed_up: { "$date": "2026-11-02T09:00:00Z" }, orders: 3, balance: 12.5, tags: ["beta"] }
    let packed = bson_encode(doc)?
    let back = bson_decode(packed)?
    { packed, back, same_id: back._id["$oid"] == id }
}

route GET /id ? { id: str = "6716a3c0e4b0a1b2c3d4e5f6" } = bson_object_id_info(id)

route GET /bad = { not_hex: bson_object_id_info("hello").valid, not_a_map: bson_encode([1, 2]).error }
