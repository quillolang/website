// TopoJSON: the specification's example read, two neighbouring regions made into a topology with
// one shared border, and back to GeoJSON.
//
//   quillo run topojson.qwe
//   then open http://localhost:8080/spec, /build, /round, /neighbors and /refused

use "topojson.qwer"

// The example in the TopoJSON specification.
let spec = {
    type: "Topology",
    transform: { scale: [0.0005, 0.0001], translate: [100, 0] },
    objects: { example: { type: "GeometryCollection", geometries: [
        { type: "Point", properties: { prop0: "value0" }, coordinates: [4000, 5000] },
        { type: "LineString", properties: { prop0: "value0", prop1: 0 }, arcs: [0] },
        { type: "Polygon", properties: { prop0: "value0", prop1: { this: "that" } }, arcs: [[1]] },
    ] } },
    arcs: [
        [[4000, 0], [1999, 9999], [2000, -9999], [2000, 9999]],
        [[0, 0], [0, 9999], [2000, 0], [0, -9999], [-2000, 0]],
    ],
}

route GET /spec = {
    info: topo_info(spec)?,
    arcs: topo_arcs(spec)?,
    geojson: topo_to_geojson(spec, "example")?,
    from_text: topo_info(json.stringify(spec))?.arcs,
}

fn square(id, x) = {
    type: "Feature", id: id, properties: { name: id },
    geometry: { type: "Polygon", coordinates: [[[x, 0], [x + 1, 0], [x + 1, 1], [x, 1], [x, 0]]] },
}

// Three squares in a row: the middle one shares a border with each neighbour.
let squares = { type: "FeatureCollection", features: [square("west", 0), square("middle", 1), square("east", 2)] }

route GET /build {
    let t = topo_from_geojson(squares, { name: "regions", quantization: 10001 })?
    let exact = topo_from_geojson(squares, { name: "regions", quantization: 0 })?
    {
        arcs: len(t.arcs),
        topology: t,
        exact_arcs: exact.arcs,
        info: topo_info(t)?,
    }
}

route GET /round {
    let t = topo_from_geojson(squares, { name: "regions", quantization: 10001 })?
    let back = topo_to_geojson(t, "regions")?
    let line = topo_from_geojson({ type: "LineString", coordinates: [[0, 0], [1, 2], [3, 3]] }, { quantization: 0 })?
    let point = topo_from_geojson({ type: "Feature", properties: { a: 1 }, geometry: { type: "Point", coordinates: [5, 7] } }, {})?
    {
        first: first(back.features),
        last: last(back.features).id,
        line: topo_to_geojson(line, "collection")?.geometry,
        point: topo_to_geojson(point, "")?,
    }
}

route GET /neighbors {
    let t = topo_from_geojson(squares, { name: "regions" })?
    {
        neighbors: topo_neighbors(t, "regions")?,
        interior: len(topo_mesh(t, "regions", "interior")?.coordinates),
        exterior: len(topo_mesh(t, "regions", "exterior")?.coordinates),
        all: len(topo_mesh(t, "regions", "all")?.coordinates),
    }
}

route GET /refused = {
    not_topology: topo_info({ type: "FeatureCollection" }).error,
    object: topo_to_geojson(spec, "missing").error,
    arc: topo_to_geojson({ type: "Topology", objects: { a: { type: "LineString", arcs: [5] } }, arcs: [] }, "a").error,
    not_json: topo_info("{").error,
    open_ring: topo_from_geojson({ type: "Polygon", coordinates: [[[0, 0], [1, 0], [1, 1], [0, 1]]] }, {}).error,
    bad_geometry: topo_from_geojson({ type: "Circle" }, {}).error,
    quantization: topo_from_geojson(squares, { quantization: 1 }).error,
    mesh: topo_mesh(spec, "example", "some").error,
}
