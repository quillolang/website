// A dashboard table with a sparkline in each row, and the same trend in a plain-text email.
//
//   quillo run sparkline.qwe      then open http://localhost:8080/

use "sparkline.qwer"

let shops = [
    { name: "Lyon", week: [120, 135, 128, 150, 172, 165, 190], profit: [12, 8, -3, 15, 20, -6, 18] },
    { name: "Nantes", week: [90, 95, 110, 105, null, 130, 138], profit: [5, -2, 7, 9, 3, 4, 11] },
]

route GET / = <html><body style="font-family: sans-serif">
    <table>
        <tr><th>Shop</th><th>Orders this week</th><th>Profit by day</th></tr>
        {for s in shops => <tr>
            <td>{s.name}</td>
            <td>{raw(sparkline_svg(s.week, { width: 120, height: 28, fill: true, min: 0, max: 200 })?)} {last(s.week)}</td>
            <td>{raw(sparkline_bars_svg(s.profit, { width: 84, height: 28 })?)}</td>
        </tr>}
    </table>
</body></html>

route GET /email = join(shops | map((s) => `${s.name}: ${sparkline_text(s.week)?}`), "\n")

route GET /lyon.svg = respond(200, sparkline_svg(shops[0].week, null)?, { "content-type": "image/svg+xml" })
