// A blog moving to Markdown files: old HTML posts imported, the menus and footers dropped, and rich-text editor output saved as Markdown.
//
//   quillo run html_markdown.qwe      then open http://localhost:8080/post.md

use "html_markdown.qwer"

route GET /post.md = respond(200, html_file_to_markdown("html_markdown_sample.html", { skip: ["nav", "footer"] })?, { "content-type": "text/markdown; charset=utf-8" })

route GET /snippets {
    {
        editor: html_to_markdown("<p>Hello <b>world</b>!</p><ul><li>one</li><li>two</li></ul>")?,
        stars: html_to_markdown_with("<ul><li>one</li></ul><hr>", { bullet: "*", hr: "***" })?,
        references: html_to_markdown_with("<p>See <a href=\"https://example.com/a\">this</a> and <a href=\"https://example.com/b\">that</a>.</p>", { links: "referenced" })?,
        no_script: html_to_markdown("<p>Text</p><script>alert(1)</script>")?,
    }
}

// POST HTML from a rich-text editor, get Markdown to store.
route POST /convert = { markdown: html_to_markdown(request.body)? }
