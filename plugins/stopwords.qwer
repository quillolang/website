//! Stop words ("the", "and", "of"; "le", "et", "de") of 50+ languages, and text with them taken out, for search, keywords and tag clouds.
//! version: 1.0.0
//!
//! [dependencies]
//! stop-words = "0.10"

use std::collections::HashSet;

fn words(language: &str) -> Result<&'static [&'static str], String> {
    let l = language.trim().to_lowercase();
    stop_words::lookup(if l.is_empty() { "en" } else { &l }).ok_or_else(|| format!("no stop words for {:?}; see stopwords_languages()", language))
}

/// The stop words of `language`, a two-letter code ("en", "fr", "de", "es", "ja"...), in lower case.
pub fn stopwords_list(language: &str) -> Result<Vec<String>, String> {
    Ok(words(language)?.iter().map(|w| w.to_string()).collect())
}

/// Whether `word` is a stop word of `language`, case ignored.
pub fn stopwords_is(word: &str, language: &str) -> Result<bool, String> {
    Ok(words(language)?.contains(&word.trim().to_lowercase().as_str()))
}

/// The words of `text` that are not stop words, in order, as written: the text split at anything but letters, digits, `'` and `-`. Up to 1 MB.
pub fn stopwords_remove(text: &str, language: &str) -> Result<Vec<String>, String> {
    if text.len() > 1_000_000 {
        return Err("text up to 1 MB".into());
    }
    let set: HashSet<&str> = words(language)?.iter().copied().collect();
    Ok(text
        .split(|c: char| !(c.is_alphanumeric() || c == '\'' || c == '’' || c == '-'))
        .map(|w| w.trim_matches(|c: char| c == '\'' || c == '’' || c == '-'))
        .filter(|w| !w.is_empty() && !set.contains(w.to_lowercase().as_str()))
        .map(String::from)
        .collect())
}

/// The languages there are, as codes.
pub fn stopwords_languages() -> Vec<String> {
    stop_words::available_languages().iter().map(|s| s.to_string()).collect()
}
