// A shop's support mailbox exported from Thunderbird: the list, a search, one message in full, each saved as .eml,
// and the shop's own answers kept in a "sent" mailbox.
//
//   quillo run mbox.qwe      then open http://localhost:8080/inbox, /search?q=order, /message/1 and /reply

use "mbox.qwer"

route GET /inbox = {
    count: mbox_count("mbox_sample.mbox")?,
    messages: mbox_list("mbox_sample.mbox", 0, 50)? | map((m) => { index: m.index, from: m.from.email, subject: m.subject, date: m.date, attachments: m.attachments }),
}

route GET /search ? { q: str } = mbox_search("mbox_sample.mbox", q, 20)? | map((m) => { index: m.index, subject: m.subject, snippet: m.snippet })

route GET /message/:n(int) = mbox_message("mbox_sample.mbox", n)?

route GET /split = { written: mbox_split("mbox_sample.mbox", "data/support-eml")? }

route GET /reply {
    delete_file("data/sent.mbox")
    mbox_append("data/sent.mbox", { from: { name: "Shop support", email: "support@shop.example" }, to: "zoe@example.org", subject: "Re: Crème brûlée moulds — in stock?", text: "Bonjour Zoë,\n\nFrom Monday, yes: 40 of them.\n", in_reply_to: "moulds@example.org", date: 1793606400 })?
    let n = mbox_append("data/sent.mbox", { from: "support@shop.example", to: [{ name: "Grace Hopper", email: "grace@example.com" }], subject: "Your parcel", text: "It arrives tomorrow.", html: "<p>It arrives <b>tomorrow</b>.</p>", date: 1793610000 })?
    let first = mbox_message("data/sent.mbox", 0)?
    { sent: n, subject: first.subject, text: first.text, date: first.date, raw_line: split(read_file("data/sent.mbox"), "\n")[0] }
}
