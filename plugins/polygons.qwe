// Delivery zones drawn on a map (GeoJSON from geojson.io or QGIS): the fee for an address,
// and how big each zone is.
//
//   quillo run polygons.qwe      then open http://localhost:8080/fee?lat=52.373&lon=4.892

use "polygons.qwer"

let ZONES = json.parse(read_file("polygons_sample.geojson")?)

route GET /fee ? { lat: float, lon: float } {
    let z = polygon_find(ZONES, lat, lon)?
    if z == null { return { delivers: false } }
    { delivers: true, zone: z.zone, fee: z.fee, minutes: z.minutes }
}

route GET /zones = ZONES.features | map((f) => merge({ zone: f.properties.zone }, polygon_measure(f)?))

route GET /inside = { centre: polygon_contains(ZONES.features[0], 52.373, 4.892)?, ring_hole: polygon_contains(ZONES.features[1], 52.373, 4.892)? }
