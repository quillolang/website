//! JavaScript, CSS and JSON minified: comments and spaces out, for scripts and styles served or embedded in pages.
//! version: 1.0.0
//!
//! [dependencies]
//! minifier = { version = "0.3", default-features = false }

use serde_json::{json, Value};

const MAX_BYTES: usize = 64 * 1024 * 1024;

fn check(code: &str) -> Result<(), String> {
    if code.len() > MAX_BYTES { Err("more than 64 MB of code".into()) } else { Ok(()) }
}

/// JavaScript minified: comments, line breaks and spaces taken out where the code means the same without them. Names are kept.
pub fn minify_js(code: &str) -> Result<String, String> {
    check(code)?;
    Ok(minifier::js::minify(code).to_string())
}

/// CSS minified: comments, line breaks and spaces out. An error for CSS it cannot read (an unclosed comment or string).
pub fn minify_css(code: &str) -> Result<String, String> {
    check(code)?;
    minifier::css::minify(code).map(|m| m.to_string().trim().to_string()).map_err(|e| e.to_string())
}

/// JSON text minified: the spaces and line breaks between values out, strings kept as they are.
pub fn minify_json(text: &str) -> Result<String, String> {
    check(text)?;
    Ok(minifier::json::minify(text).to_string())
}

/// Minifies the file `from` into `to` (folders are made), as .js, .mjs, .css or .json by its extension: `{ before, after }`, the sizes in bytes.
pub fn minify_file(from: &str, to: &str) -> Result<Value, String> {
    let code = std::fs::read_to_string(from).map_err(|e| format!("{}: {}", from, e))?;
    let ext = from.rsplit_once('.').map(|(_, e)| e.to_lowercase()).unwrap_or_default();
    let out = match ext.as_str() {
        "js" | "mjs" | "cjs" => minify_js(&code)?,
        "css" => minify_css(&code)?,
        "json" => minify_json(&code)?,
        _ => return Err(format!("{}: minify .js, .css or .json files", from)),
    };
    if let Some(dir) = std::path::Path::new(to).parent().filter(|d| !d.as_os_str().is_empty()) {
        std::fs::create_dir_all(dir).map_err(|e| format!("{}: {}", dir.display(), e))?;
    }
    std::fs::write(to, &out).map_err(|e| format!("{}: {}", to, e))?;
    Ok(json!({ "before": code.len(), "after": out.len() }))
}
