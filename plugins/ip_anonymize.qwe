// Privacy-friendly access logs and a daily visitor count that keep no full IP address.
//
//   quillo run ip_anonymize.qwe      then open http://localhost:8080/samples

use "ip_anonymize.qwer"

let SECRET = env("IP_SALT_SECRET") ?? crypto.token(32)

// A new salt each day: today's pseudonyms cannot be tied to tomorrow's.
fn todays_salt() = crypto.sha256(`${SECRET}:${date.today()}`)

route GET /visit {
    let line = { at: now(), ip: ip_anonymize(request.ip)?, path: request.path, visitor: ip_pseudonym(request.ip, todays_salt())? }
    write_file("data/access.log", json.stringify(line))
    line
}

route GET /samples = {
    v4: ip_anonymize("203.0.113.77")?,
    v6: ip_anonymize("2001:db8:85a3:8d3:1319:8a2e:370:7348")?,
    mapped: ip_anonymize("::ffff:198.51.100.23")?,
    coarse: ip_network("203.0.113.77", 16, 32)?,
    same_visitor: ip_pseudonym("203.0.113.77", "a salt of at least sixteen") == ip_pseudonym("203.0.113.77", "a salt of at least sixteen"),
    no_salt: ip_pseudonym("203.0.113.77", "").error,
}
