// A rowing club's membership form: its fields listed, filled from a sign-up, and flattened into a PDF for the archive.
//
//   quillo run pdf_forms.qwe      then open http://localhost:8080/fields, /fill and /flatten

use "pdf_forms.qwer"

let SIGNUP = {
    "applicant.name": "Zoë Saldaña",
    "applicant.email": "zoe@example.org",
    member_type: "student",
    country: "Ireland",
    newsletter: true,
    notes: "Rowed for two years at university; free on Saturday mornings. Allergic to bees.",
    shoe_size: "41",
}

route GET /fields = pdf_form_fields("pdf_forms_sample.pdf")? | map((f) => { name: f.name, type: f.type, value: f.value, options: f.options, page: f.page })

route GET /fill {
    let r = pdf_form_fill("pdf_forms_sample.pdf", SIGNUP, "data/membership-filled.pdf")?
    { result: r, values: pdf_form_values("data/membership-filled.pdf")? }
}

route GET /refused = pdf_form_fill("pdf_forms_sample.pdf", { country: "Atlantis", member_type: "honorary" }, "data/membership-bad.pdf")?

route GET /flatten {
    let r = pdf_form_flatten("pdf_forms_sample.pdf", SIGNUP, "data/membership-final.pdf")?
    { flattened: r.flattened, fields_left: len(pdf_form_fields("data/membership-final.pdf")?) }
}

route GET /pdf = file("data/membership-final.pdf")
