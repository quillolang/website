//! English words in the right form for counts and labels: plurals and singulars ("person" and "people", "category" and "categories"), "3 items", "1st, 2nd, 23rd", and "a" or "an".
//! version: 1.0.0
//!
//! [dependencies]
//! pluralizer = "0.6"

/// The plural of `word`: "category" is "categories", "person" is "people", "sheep" stays "sheep". Case is kept ("Box" is "Boxes").
pub fn inflect_plural(word: &str) -> String {
    pluralizer::pluralize(word, 2, false)
}

/// The singular of `word`: "categories" is "category", "people" is "person", "analyses" is "analysis".
pub fn inflect_singular(word: &str) -> String {
    pluralizer::pluralize(word, 1, false)
}

/// `count` with `word` in the right form: "1 item", "0 items", "3 people".
pub fn inflect_count(word: &str, count: i64) -> String {
    format!("{} {}", count, pluralizer::pluralize(word, if count == 1 { 1 } else { 2 }, false))
}

/// `n` as an ordinal: "1st", "2nd", "3rd", "11th", "22nd", "113th", "-1st".
pub fn inflect_ordinal(n: i64) -> String {
    let a = n.unsigned_abs();
    let suffix = match (a % 10, a % 100) {
        (_, 11..=13) => "th",
        (1, _) => "st",
        (2, _) => "nd",
        (3, _) => "rd",
        _ => "th",
    };
    format!("{}{}", n, suffix)
}

/// `word` with "a" or "an" before it, by how it sounds: "an apple", "a user", "an hour", "a one-off", "an FAQ", "an 8-hour day".
pub fn inflect_article(word: &str) -> String {
    let w = word.trim();
    let l = w.to_lowercase();
    let first = l.chars().next().unwrap_or(' ');
    let an = if ["hour", "honest", "honor", "honour", "heir"].iter().any(|p| l.starts_with(p)) {
        true
    } else if ["uni", "use", "usu", "uti", "ufo", "eu", "ewe", "one", "once", "ure"].iter().any(|p| l.starts_with(p)) {
        false
    } else if first.is_ascii_digit() {
        // "an 8", "an 11", "an 18", "an 80": the numbers said with a vowel first.
        let digits: String = l.chars().take_while(|c| c.is_ascii_digit()).collect();
        digits.starts_with('8') || digits == "11" || digits == "18" || (digits.len() % 3 == 2 && (digits.starts_with("11") || digits.starts_with("18")))
    } else if w.len() > 1 && w.chars().take_while(|c| c.is_alphabetic()).all(|c| c.is_uppercase()) && w.chars().take(2).all(|c| c.is_alphabetic()) {
        // Initials are said letter by letter: "an FAQ", "an SQL query", "a URL".
        "AEFHILMNORSX".contains(w.chars().next().unwrap_or(' ')) && !w.starts_with("URL") && !w.starts_with("UK") && !w.starts_with("US")
    } else {
        "aeiou".contains(first)
    };
    format!("{} {}", if an { "an" } else { "a" }, w)
}
