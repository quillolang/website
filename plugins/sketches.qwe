// Unique visitors per day and for the week, and the top pages, counted in a few kilobytes.
//
//   quillo run sketches.qwe      then open http://localhost:8080/stats

use "sketches.qwer"

// Every page view counts its visitor and its page.
route GET /page/:name {
    hll_add("visitors:today", [request.ip])?
    topk_add("pages", [name])?
    { page: name }
}

// 10,000 visitors on Monday and 10,000 on Tuesday, 5,000 of them the same people; pages viewed unevenly.
route GET /stats {
    sketch_reset("mon")
    sketch_reset("tue")
    sketch_reset("demo-pages")
    hll_add("mon", range(0, 10000) | map((i) => `visitor-${i}`))?
    hll_add("tue", range(5000, 15000) | map((i) => `visitor-${i}`))?
    topk_add("demo-pages", range(0, 3000) | map((i) => i % 3 == 0 ? "/pricing" : i % 5 == 0 ? "/blog" : `/item/${i % 200}`))?
    {
        monday: hll_count(["mon"]),
        week: hll_count(["mon", "tue"]),
        top: topk_top("demo-pages", 3),
        pricing: topk_count("demo-pages", "/pricing"),
    }
}
