// Demo data for a CRM: customers in three countries' styles, their addresses and
// companies, and an orders table, the same every time for the same seed.
//
//   quillo run fake_data.qwe      then open http://localhost:8080/customers

use "fake_data.qwer"

route GET /customers ? { locale: str = "en", n: int = 3 } = fake_people(locale, n, "demo-2026")?

route GET /mixed = {
    en: fake_people("en", 1, "demo-2026")?[0],
    fr: fake_people("fr_fr", 1, "demo-2026")?[0].name,
    ja: fake_people("ja_jp", 1, "demo-2026")?[0].name,
    address: fake_addresses("pt_br", 1, "demo-2026")?[0],
    company: fake_companies("en", 1, "demo-2026")?[0],
    locales: fake_locales(),
}

route GET /orders = fake_rows({
    id: "id",
    first_name: "first_name",
    last_name: "last_name",
    email: "email",
    city: "city",
    total: "money:5-500",
    status: "pick:new|paid|shipped",
    placed: "date:2025-2026",
    gift: "bool:0.1",
}, 5, "en", "orders-1")?

// The same seed gives the same rows: a test can rely on them.
route GET /same = { same: fake_rows({ n: "int:1-1000" }, 50, "en", "x")? == fake_rows({ n: "int:1-1000" }, 50, "en", "x")?, other: fake_rows({ n: "int:1-1000" }, 3, "en", "y")? }
