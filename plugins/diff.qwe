// What changed between two versions of a page.
//
//   quillo run diff.qwe      then open http://localhost:8080/changes

use "diff.qwer"

let before = "Quillo is a language.\nIt runs on the server.\n"
let after = "Quillo is a web language.\nIt runs on the server.\nAnd in the browser.\n"

route GET /changes = diff_lines(before, after)
route GET /patch = unified_diff(before, after, "page.md", "page.md", 3)
route GET /alike = { ratio: diff_ratio(before, after) }
