// An orders API that checks each body against a JSON Schema and says what is wrong, field by field.
//
//   quillo run json_schema.qwe      then open http://localhost:8080/samples

use "json_schema.qwer"

let ORDER = {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    type: "object",
    required: ["customer", "items"],
    properties: {
        customer: { type: "string", format: "email" },
        items: {
            type: "array", minItems: 1,
            items: { type: "object", required: ["sku", "qty"], properties: { sku: { type: "string", pattern: "^[A-Z][0-9]+$" }, qty: { type: "integer", minimum: 1 } } },
        },
        note: { type: "string", maxLength: 200 },
    },
    additionalProperties: false,
}

route POST /orders {
    let errors = schema_errors(request.json, ORDER)?
    if len(errors) > 0 { reply 422 { errors } }
    { accepted: request.json.customer }
}

route GET /samples = {
    good: schema_valid({ customer: "ada@example.com", items: [{ sku: "B7", qty: 2 }] }, ORDER)?,
    bad: schema_errors({ customer: "ada@example.com", items: [{ sku: "b7", qty: 0 }, { qty: 1 }], colour: "red" }, ORDER)? | map((e) => `${e.path}: ${e.message}`),
    broken_schema: schema_problems({ type: "strnig" }),
}
