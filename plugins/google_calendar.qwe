// A calendar kept by a program: events made in both kinds of time, read through every page, kept
// up to date by sync tokens, free/busy across people, and a user impersonated.
//
//   GOOGLE_APPLICATION_CREDENTIALS=key.json GOOGLE_CALENDAR_ID=primary GOOGLE_CALENDAR_SUBJECT=ada@example.com quillo run google_calendar.qwe
//   then open /times, /events, /lists, /sync, /free, /people and /failures
//
// To act as a user the service account needs domain-wide delegation, for the calendar scope. Or
// share the calendar with its address and leave out the subject.

use "google_calendar.qwer"

let cal = env("GOOGLE_CALENDAR_ID", "primary")

route GET /times = {
    day: google_calendar_time("2026-11-20", "")?,
    offset: google_calendar_time("2026-11-20T10:00:00+01:00", "")?,
    utc: google_calendar_time("2026-11-20T10:00:00Z", "")?,
    zone: google_calendar_time("2026-11-20T10:00:00", "Europe/Paris")?,
    no_zone: google_calendar_time("2026-11-20T10:00:00", "").error,
    bad: google_calendar_time("20 Nov", "").error,
    not_a_day: google_calendar_time("2026-02-30", "").error,
    leap: google_calendar_all_day("2024-02-28", "2024-02-29")?,
    year_end: google_calendar_all_day("2026-12-31", "2026-12-31")?,
    backwards: google_calendar_all_day("2026-11-20", "2026-11-19").error,
    span: google_calendar_span({ start: { date: "2026-11-20" }, end: { date: "2026-11-23" } })?,
    timed: google_calendar_span({ start: { dateTime: "2026-11-20T10:00:00Z" }, end: { dateTime: "2026-11-20T11:00:00Z" } })?.all_day,
}

route GET /events {
    let range = google_calendar_all_day("2026-11-20", "2026-11-22")?
    let trip = google_calendar_create(cal, { summary: "Trip", start: range.start, end: range.end }, {})?
    let meet = google_calendar_create(cal, {
        summary: "Review",
        start: google_calendar_time("2026-11-20T10:00:00", "Europe/Paris")?,
        end: google_calendar_time("2026-11-20T11:00:00", "Europe/Paris")?,
        attendees: [{ email: "grace@example.com" }],
    }, { send_updates: "all" })?
    google_calendar_patch(cal, meet.id, { summary: "Review, moved" }, {})?
    {
        trip_days: google_calendar_span(google_calendar_event(cal, trip.id, {})?)?.days,
        zone: google_calendar_event(cal, meet.id, {})?.start.timeZone,
        summary: google_calendar_event(cal, meet.id, {})?.summary,
        told: meet.notified,
        deleted: google_calendar_delete(cal, trip.id, {})?,
        twice: google_calendar_delete(cal, trip.id, {}).error,
        no_end: google_calendar_create(cal, { start: range.start }, {}).error,
        mixed: google_calendar_create(cal, { start: range.start, end: google_calendar_time("2026-11-20T10:00:00Z", "")? }, {}).error,
    }
}

route GET /lists {
    let all = google_calendar_events("history@example.com", {}, {})?
    let some = google_calendar_events("history@example.com", { timeMin: "2026-01-01T00:00:00Z", singleEvents: true, orderBy: "startTime" }, { max_items: 3000 })?
    { all: len(all.items), has_token: all.sync_token != null, some: len(some.items), bad_time: google_calendar_events(cal, { timeMin: "2026-01-01T00:00:00" }, {}).error }
}

route GET /sync {
    let first = google_calendar_events("sync@example.com", {}, {})?
    let e = google_calendar_create("sync@example.com", { summary: "New", start: google_calendar_time("2026-11-21T10:00:00Z", "")?, end: google_calendar_time("2026-11-21T11:00:00Z", "")? }, {})?
    google_calendar_delete("sync@example.com", first.items[0].id, {})?
    let second = google_calendar_sync("sync@example.com", first.sync_token, {})?
    let third = google_calendar_sync("sync@example.com", second.sync_token, {})?
    let old = google_calendar_sync("sync@example.com", "expired-token", {})?
    {
        first: len(first.items),
        changed: sort(map(second.items, (x) => x.status)),
        was_new: contains(map(second.items, (x) => x.id), e.id),
        then: len(third.items),
        old: old,
        empty: google_calendar_sync(cal, "", {}).error,
    }
}

route GET /free = {
    busy: google_calendar_freebusy(["ada@example.com", "secret@example.com"], "2026-11-20T00:00:00Z", "2026-11-21T00:00:00Z", {})?,
    bad: google_calendar_freebusy(["x"], "2026-11-20", "2026-11-21", {}).error,
    none: google_calendar_freebusy([], "2026-11-20T00:00:00Z", "2026-11-21T00:00:00Z", {}).error,
}

// The same call as two people: the stand-in checks `sub`, and shows each their own calendar.
route GET /people = {
    default_is: google_calendar_events("whoami", {}, {})?.items[0].summary,
    other: google_calendar_events("whoami", {}, { subject: "grace@example.com" })?.items[0].summary,
    refused: google_calendar_events("whoami", {}, { subject: "stranger@elsewhere.example" }).error,
}

route GET /failures = {
    missing: google_calendar_event(cal, "nosuch", {}).error,
    waited: google_calendar_event(cal, "busy", {})?.summary,
    no_calendar: google_calendar_events("nobody@example.com", {}, {}).error,
}
