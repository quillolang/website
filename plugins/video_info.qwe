// An upload check for videos: refuse those too long or too large, and show what was sent.
//
//   quillo run video_info.qwe      then open http://localhost:8080/clip

use "video_info.qwer"

let CLIP = "video_info_sample.mp4"

route GET /clip = video_info(CLIP)
route GET /tracks = video_tracks(CLIP)

route POST /upload {
    let f = request.files.video ?? reply 400 "Choose a video"
    let path = save_upload(f, `data/videos/${uuid()}.mp4`)?
    let info = video_info(path)
    if is_err(info) { delete_file(path); reply 415 "MP4 or MOV videos only" }
    if info.duration > 60 || info.height > 1080 { delete_file(path); reply 413 "Up to a minute, up to 1080p" }
    { saved: path, seconds: info.duration, size: `${info.width}×${info.height}` }
}
