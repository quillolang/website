// A shop's customers grouped by what they spend and how often they come (k-means, with k chosen
// by the elbow and silhouette), delivery drop-offs grouped into neighbourhoods with DBSCAN in
// metres, and a few products grouped by hierarchical clustering.
//
//   quillo run clustering.qwe      then open http://localhost:8080/customers and http://localhost:8080/drops

use "clustering.qwer"

let CUSTOMERS = [
    { spend: 12.0, visits: 1 }, { spend: 15.0, visits: 2 }, { spend: 9.5, visits: 1 }, { spend: 14.0, visits: 1 },
    { spend: 220.0, visits: 3 }, { spend: 260.0, visits: 2 }, { spend: 240.0, visits: 4 },
    { spend: 55.0, visits: 18 }, { spend: 61.0, visits: 22 }, { spend: 48.0, visits: 20 }, { spend: 58.0, visits: 25 },
]

route GET /customers = {
    groups: cluster_kmeans(CUSTOMERS, 3, { fields: ["spend", "visits"], seed: 7 })?,
    choose: cluster_choose_k(CUSTOMERS, 5, { fields: ["spend", "visits"] })? | map((r) => `k=${r.k} silhouette=${r.silhouette}`),
}

// Drop-offs as [lat, lon]: two neighbourhoods of Lyon and one stray address.
let DROPS = [[45.7640, 4.8357], [45.7642, 4.8360], [45.7638, 4.8352], [45.7645, 4.8363], [45.7484, 4.8467], [45.7487, 4.8470], [45.7481, 4.8462], [45.7790, 4.8020]]

route GET /drops = cluster_dbscan(DROPS, 150.0, 3, { metric: "haversine" })?

route GET /products = cluster_hierarchical([[1.0, 1.0], [1.2, 0.9], [5.0, 5.2], [5.1, 4.9], [9.0, 1.0]], 3, 0.0, "average", {})?
