// A shop's UPI payment link and QR code: built for an order, read back as an app reads it, the
// amount in paise so no float rounds it, and what a wrong address or amount gives.
//
//   quillo run upi_qr.qwe      then open http://localhost:8080/link, /code.svg, /read, /paise and /refused

use "upi_qr.qwer"

let ORDER = { vpa: "chai.shop@okaxis", name: "Chai & Co", amount: "149.5", note: "Order 1001", reference: "ORD1001", merchant_code: "5812", transaction_id: "T1001" }

route GET /link = { link: upi_qr_build(ORDER)? }

route GET /code.svg = respond(200, upi_qr_svg(upi_qr_build(ORDER)?, 300)?, { "content-type": "image/svg+xml" })

route GET /read = upi_qr_parse(upi_qr_build(ORDER)?)?

// A person's link with no amount, and a parameter this plugin does not know kept for the app.
route GET /open = upi_qr_parse("upi://pay?pa=ada@upi&pn=Ada%20L&cu=INR&orgid=000000")?

route GET /paise = {
    paise: upi_qr_paise("149.5")?,
    float_safe: upi_qr_paise("0.29")?,
    number: upi_qr_paise(12.34)?,
    rupees: upi_qr_rupees(14950),
    built: upi_qr_build({ vpa: "a.b@ybl", name: "A", paise: 1999 })?,
}

route GET /refused = {
    no_at: upi_qr_vpa_problem("chai.shop"),
    bad_bank: upi_qr_vpa_problem("chai@ok-axis!"),
    good: upi_qr_vpa_problem("chai.shop@okaxis"),
    decimals: upi_qr_build(merge(ORDER, { amount: "1.999" })).error,
    zero: upi_qr_build(merge(ORDER, { amount: "0" })).error,
    too_much: upi_qr_build(merge(ORDER, { amount: "100000.01" })).error,
    no_ref: upi_qr_build({ vpa: "a@b1", name: "A", merchant_code: "5812" }).error,
    twice: upi_qr_parse("upi://pay?pa=a@b1&am=1&am=2").error,
    dollars: upi_qr_parse("upi://pay?pa=a@b1&am=1&cu=USD").error,
    other: upi_qr_parse("https://example.com/pay?pa=a@b1").error,
}
