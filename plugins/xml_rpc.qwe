// XML-RPC, still behind WordPress, Odoo, Bugzilla, Confluence's old API and many routers: calls
// to a server (faults and system.multicall too), and this program serving XML-RPC itself.
//
//   XMLRPC_URL=https://example.com/xmlrpc.php quillo run xml_rpc.qwe
//   then open http://localhost:8080/call, /echo, /multicall and /serve; POST /RPC2 serves calls

use "xml_rpc.qwer"

let URL = env("XMLRPC_URL", "http://127.0.0.1:8000/RPC2")

route GET /call = {
    state: xmlrpc_call(URL, "examples.getStateName", [41], {})?,
    both: xmlrpc_call(URL, "sample.sumAndDifference", [10, 3], {})?,
    fault: xmlrpc_call(URL, "examples.getStateName", [99], {}).error,
    unknown: xmlrpc_call(URL, "examples.nothing", [], {}).error,
}

// Every type there and back: the server's echo gives its params back.
route GET /echo {
    let sent = [42, 9007199254740993, 3.25, true, null, "a < b & c", xmlrpc_datetime("2026-10-30T12:00:00")?, xmlrpc_base64("aGVsbG8="), { sku: "A-1", sizes: [38, 39] }]
    { back: xmlrpc_call(URL, "echo", sent, { timeout_ms: 5000 })? }
}

route GET /multicall = xmlrpc_multicall(URL, [
    { method: "examples.getStateName", params: [5] },
    { method: "examples.getStateName", params: [0] },
    { method: "system.listMethods" },
], {})?

// Serving XML-RPC: the methods this program answers.
fn answer(call) = match call {
    { method: "orders.status", params: [str as id] } => xmlrpc_response({ id, status: id == "A-1042" ? "shipped" : "unknown", updated: xmlrpc_datetime("2026-10-29T16:30:00")? })
    { method: "orders.status" } => xmlrpc_fault(-32602, "orders.status takes one string, the order id")
    { method: "math.add", params: [num as a, num as b] } => xmlrpc_response(a + b)
    { method } => xmlrpc_fault(-32601, `no method ${method}`)
}

fn serve(body) {
    let call = xmlrpc_parse(body)
    if is_err(call) || call.kind != "call" { return xmlrpc_fault(-32700, `not an XML-RPC call: ${call.error ?? call.kind}`) }
    answer(call)?
}

route POST /RPC2 = respond(200, serve(request.body), { "content-type": "text/xml" })

// What a client sending to POST /RPC2 sees: its calls made here, and the answers read back.
route GET /serve = {
    status: xmlrpc_parse(serve(xmlrpc_request("orders.status", ["A-1042"])?))?,
    sum: xmlrpc_parse(serve(xmlrpc_request("math.add", [2, 0.5])?))?.value,
    wrong: xmlrpc_parse(serve(xmlrpc_request("orders.status", [7])?))?,
    request: xmlrpc_request("orders.status", ["A-1042"])?,
}
