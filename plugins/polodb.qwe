// A small contacts book in a PoloDB file: add people, find them by filter, mark and remove them.
//
//   quillo run polodb.qwe      then open http://localhost:8080/contacts/seed

use "polodb.qwer"

let DB = "data/contacts.polo"

route GET /contacts/seed {
    polodb_delete(DB, "contacts", {})?
    polodb_insert(DB, "contacts", { name: "Ada", city: "London", age: 36, tags: ["maths"] })?
    polodb_insert(DB, "contacts", { name: "Grace", city: "New York", age: 45, tags: ["navy", "cobol"] })?
    polodb_insert(DB, "contacts", { name: "Linus", city: "Portland", age: 29, tags: [] })?
    { count: polodb_count(DB, "contacts")? }
}

route GET /contacts ? { min_age: int = 0 } =
    polodb_find(DB, "contacts", { age: { "$gte": min_age } }, 100)? | map((c) => { name: c.name, city: c.city, age: c.age })

route GET /contacts/birthday ? { name: str } {
    let changed = polodb_update(DB, "contacts", { name: name }, { "$inc": { age: 1 } })?
    { changed, now: polodb_find(DB, "contacts", { name: name }, 1)?[0].age }
}
