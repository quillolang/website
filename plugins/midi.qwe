// A music school's practice pieces: a MIDI file read for an on-screen piano roll, a scale written for practice, and the piece moved into another key.
//
//   quillo run midi.qwe      then open http://localhost:8080/piece

use "midi.qwer"

let PIECE = "midi_sample.mid"

route GET /piece {
    let song = midi_read(PIECE, 1000)?
    {
        bpm: song.bpm,
        time_signature: song.time_signature,
        duration: song.duration,
        tracks: song.tracks | map((t) => { name: t.name, instrument: t.instrument, notes: len(t.notes) }),
        opening: slice(song.tracks[0].notes, 0, 3),
        melody: join(song.tracks[0].notes | map((n) => n.name), " "),
    }
}

// A C major scale, up and down, at 90 beats a minute: written, then read back.
route GET /scale {
    let up = ["C4", "D4", "E4", "F4", "G4", "A4", "B4", "C5"]
    let notes = (up + reverse(slice(up, 0, 7))) | enumerate | map((p) => { note: p[1], start: float(p[0]) * 0.5, length: 0.5, velocity: 80 })
    let written = midi_write({ bpm: 90.0, tracks: [{ name: "Scale", program: 0, notes: notes }] }, "data/midi/scale.mid")?
    let back = midi_read("data/midi/scale.mid", 100)?
    { written: written, duration: back.duration, last: last(back.tracks[0].notes).name }
}

route GET /notes = {
    a4: midi_note("A4")?,
    middle_c: midi_note(60)?,
    flat: midi_note("Bb3")?.name,
    transposed: midi_transpose(PIECE, "data/midi/in-d.mid", 2)?,
    in_d: join(midi_read("data/midi/in-d.mid", 4)?.tracks[0].notes | map((n) => n.name), " "),
}
