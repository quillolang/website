// Certificates in .p12 files: one made by OpenSSL opened, its key and chain read out in order, a
// wrong password told as that, a file on the old ciphers refused by name, and a file written here
// that OpenSSL opens in turn.
//
//   PKCS12_SAMPLES=http://127.0.0.1:9000 quillo run pkcs12.qwe
//   then open http://localhost:8080/read, /info, /write, /roundtrip and /failures
//
// The samples come from a helper that makes them with the openssl command, base64 over HTTP, as a
// real program would get them from a file (`pkcs12_read_file`) or an upload.

use "pkcs12.qwer"

let SAMPLES = env("PKCS12_SAMPLES", "http://127.0.0.1:9000")
fn sample(kind) = http.get(`${SAMPLES}/sample/${kind}`).body

route GET /read {
    let p = pkcs12_read(sample("modern"), "correct horse")?
    {
        key: p.key_type,
        name: p.friendly_name,
        pem: starts_with(p.private_key, "-----BEGIN PRIVATE KEY-----"),
        subjects: map(p.chain, (c) => c.subject),
        issuers: map(p.chain, (c) => c.issuer),
        leaf_is_first: p.certificate == p.chain[0].pem,
        ec: pkcs12_read(sample("ec"), "correct horse")?.key_type,
        empty: pkcs12_read(sample("nopass"), "")?.key_type,
        none_mac: pkcs12_read(sample("modern"), "correct horse")?.protected_by_mac,
    }
}

route GET /info = {
    modern: pkcs12_info(sample("modern"))?,
    old: pkcs12_info(sample("old"))?,
}

route GET /write {
    let p = pkcs12_read(sample("modern"), "correct horse")?
    let made = pkcs12_write({ private_key: p.private_key, certificates: map(p.chain, (c) => c.pem), friendly_name: "Plüsch web", iterations: 2000 }, "new pässword")?
    // Node and the openssl command both try the file; neither is this plugin.
    let by_openssl = http.post(`${SAMPLES}/check`, { password: "new pässword", file: made }).json
    let again = pkcs12_read(made, "new pässword")?
    { openssl: by_openssl, name: again.friendly_name, same_key: again.private_key == p.private_key, chain: len(again.chain), info: pkcs12_info(made)?.parts[0].cipher }
}

route GET /roundtrip {
    let p = pkcs12_read(sample("modern"), "correct horse")?
    let store = pkcs12_write({ certificates: [p.chain[1].pem], iterations: 2000 }, "x")?
    let path = ".quillo/pkcs12-sample.p12"
    let size = pkcs12_write_file(path, { private_key: p.private_key, certificate: p.certificate, iterations: 2000 }, "file")?
    let read = pkcs12_read_file(path, "file")?
    delete_file(path)
    { trust_store: pkcs12_read(store, "x")?.private_key, keys: pkcs12_read(store, "x")?.keys, written: size > 500, from_file: read.key_type }
}

route GET /failures = {
    wrong_password: pkcs12_read(sample("modern"), "wrong").error,
    old: pkcs12_read(sample("old"), "correct horse").error,
    three_des: pkcs12_read(sample("des3"), "correct horse").error,
    not_p12: pkcs12_read("aGVsbG8gd29ybGQ=", "x").error,
    not_base64: pkcs12_read("%%%", "x").error,
    no_cert: pkcs12_write({}, "x").error,
    no_key_text: pkcs12_write({ certificate: "nope" }, "x").error,
    encrypted_key: pkcs12_write({ certificate: pkcs12_read(sample("modern"), "correct horse")?.certificate, private_key: "-----BEGIN ENCRYPTED PRIVATE KEY-----\nAA==\n-----END ENCRYPTED PRIVATE KEY-----\n" }, "x").error,
    no_file: pkcs12_read_file("nothing.p12", "x").error != null,
}
