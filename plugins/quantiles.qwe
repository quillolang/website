// Response-time percentiles for a status page, kept in memory as requests come in.
//
//   quillo run quantiles.qwe      then open http://localhost:8080/latency

use "quantiles.qwer"

// Each API request adds its time; here, 10,000 made-up timings: most fast, a few slow.
route GET /latency {
    quantile_reset("api")
    quantile_add("api", range(1, 10001) | map((i) => i % 100 == 0 ? 900 + i % 7 : 20 + i % 61))?
    { summary: quantile_summary("api"), p999: quantile_get("api", 0.999), slower_than: quantile_rank("api", 85.0) }
}

route GET /order-values = {
    added: quantile_add("orders", [12.5, 40, 22, 99.9, 15, 18, 250, 31])?,
    median: quantile_get("orders", 0.5),
    empty: quantile_summary("nothing").p50,
}
