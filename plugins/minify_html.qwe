// Pages minified before they are sent or saved for a static export.
//
//   quillo run minify_html.qwe      then open http://localhost:8080/page

use "minify_html.qwer"

let PAGE = `<!DOCTYPE html>
<html>
  <head>
    <title>  Menu  </title>
    <style>
      body { margin: 0px; color: #ff0000; }
      .price   { font-weight: bold; }
    </style>
  </head>
  <body>
    <!-- the menu of the day -->
    <h1 class="title">Today's menu</h1>
    <ul>
      <li>Soup  <span class="price">6.50</span></li>
      <li>Tart  <span class="price">11.00</span></li>
    </ul>
    <script>
      const total = function (a, b) { return a + b; };
      console.log( total(6.5, 11) );
    </script>
  </body>
</html>`

route GET /page = respond(200, minify_html(PAGE)?, { "content-type": "text/html; charset=utf-8" })

route GET /sizes {
    write_file("data/menu.html", PAGE)
    {
        file: minify_html_file("data/menu.html", "data/export/menu.html")?,
        with_comments: minify_html_with(PAGE, { keep_comments: true, minify_js: false })?,
    }
}
