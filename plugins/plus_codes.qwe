// Deliveries to places without a street address: the driver gets a plus code, the customer can type a short one.
//
//   quillo run plus_codes.qwe      then open http://localhost:8080/codes

use "plus_codes.qwer"

route GET /codes {
    // Google's office in Mountain View, and the reference codes of the Open Location Code tests.
    let office = plus_code_encode(37.4220041, -122.0862462, 10)?
    {
        office: office,
        office_precise: plus_code_encode(37.4220041, -122.0862462, 11)?,
        area: plus_code_decode("7FG49QCJ+2V")?,
        region: plus_code_encode(20.3700625, 2.7821875, 4)?,
        near: plus_code_shorten("9C3W9QCJ+2VX", 51.3701125, -1.217765625)?,
        further: plus_code_shorten("9C3W9QCJ+2VX", 51.3708675, -1.217765625)?,
        recovered: plus_code_recover("9QCJ+2VX", 51.3708675, -1.217765625)?,
        kinds: [plus_code_kind("9C3W9QCJ+2VX"), plus_code_kind("QCJ+2VX"), plus_code_kind("9C3W9QCJ"), plus_code_kind("CJ+2VX")],
    }
}

// /where?code=CJ+2VX&lat=51.37&lon=-1.21: a code from a form, short or full, as a map position.
route GET /where ? { code: str, lat: float = 51.37, lon: float = -1.21 } {
    let full = plus_code_recover(code, lat, lon)?
    merge({ code: full }, plus_code_decode(full)?)
}
