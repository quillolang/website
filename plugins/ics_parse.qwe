// Importing bookings from a calendar file, as Google Calendar, Outlook and booking sites export them.
//
//   quillo run ics_parse.qwe      then open http://localhost:8080/bookings

use "ics_parse.qwer"

route GET /bookings {
    let cal = ics_parse_file("ics_parse_sample.ics")?
    { calendar: cal.name, events: cal.events | map((e) => { title: e.summary, start: e.start, end: e.end, zone: e.timezone, where: e.location, all_day: e.all_day }) }
}

route GET /details = ics_parse_file("ics_parse_sample.ics")?.events[0]

route GET /repeating = ics_parse_file("ics_parse_sample.ics")?.events | filter((e) => e.recurrence != null) | map((e) => { title: e.summary, rule: e.rrule, recurrence: e.recurrence })

route POST /import = ics_parse(request.body)?.events | map((e) => e.summary)
