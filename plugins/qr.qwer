//! QR codes as SVG: links, tickets, payments, Wi-Fi and two-factor set-up, sharp at any size.
//!
//! [dependencies]
//! qrcode = { version = "0.14", default-features = false, features = ["svg"] }

use qrcode::render::svg;
use qrcode::{EcLevel, QrCode};

fn code(text: &str, level: &str) -> Result<QrCode, String> {
    let ec = match level { "L" | "l" => EcLevel::L, "Q" | "q" => EcLevel::Q, "H" | "h" => EcLevel::H, _ => EcLevel::M };
    QrCode::with_error_correction_level(text.as_bytes(), ec).map_err(|e| e.to_string())
}

/// An SVG image of `text` as a QR code, at least `size` pixels wide, dark on light; put it in a page with `raw(...)` or serve it as image/svg+xml.
pub fn qr_svg(text: &str, size: i64) -> Result<String, String> {
    qr_svg_colors(text, size, "#000000", "#ffffff")
}

/// The same, in the colours given (CSS colours), with error correction "M"; use a dark colour on a light one for scanners.
pub fn qr_svg_colors(text: &str, size: i64, dark: &str, light: &str) -> Result<String, String> {
    let s = size.clamp(32, 4096) as u32;
    Ok(code(text, "M")?.render::<svg::Color>().min_dimensions(s, s).dark_color(svg::Color(dark)).light_color(svg::Color(light)).build())
}

/// The QR code drawn in text, for a terminal or a log: `quillo run` printing a link to scan.
pub fn qr_text(text: &str) -> Result<String, String> {
    Ok(code(text, "L")?.render::<char>().quiet_zone(true).module_dimensions(2, 1).dark_color('█').light_color(' ').build())
}

/// The text a phone's camera joins a Wi-Fi network from (`WPA` security), for a QR code by the door.
pub fn wifi_qr_text(ssid: &str, password: &str) -> String {
    let esc = |s: &str| s.replace('\\', "\\\\").replace(';', "\\;").replace(',', "\\,").replace(':', "\\:").replace('"', "\\\"");
    format!("WIFI:T:WPA;S:{};P:{};;", esc(ssid), esc(password))
}
