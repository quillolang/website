// Orders kept in Amazon DynamoDB: a customer's orders put and read back as plain maps, a stock
// count changed with ADD, a put refused because the key is taken, a query read past one page, 60
// items written in a batch of which DynamoDB processed only part at first, and numbers and sets
// that survive the trip.
//
//   AWS_REGION=eu-west-1 AWS_ACCESS_KEY_ID=... AWS_SECRET_ACCESS_KEY=... quillo run aws_dynamodb.qwe
//   then open http://localhost:8080/item, /update, /query, /batch and /types
//
// It wants a table `orders` with partition key `pk` (string) and sort key `sk` (string).
// DYNAMODB_API_URL reaches DynamoDB Local or a test server.

use "aws_dynamodb.qwer"

let TABLE = "orders"

route GET /item {
    let key = { pk: "customer#7", sk: "order#1001" }
    dynamodb_put(TABLE, { ...key, status: "paid", total: 42.5, lines: [{ sku: "A", qty: 2 }], note: null }, {})?
    let taken = dynamodb_put(TABLE, { ...key, status: "again" }, { if_absent: "pk" })
    let read = dynamodb_get(TABLE, key, { consistent: true })?
    let gone = dynamodb_delete(TABLE, key, {})?
    {
        status: read.status,
        total: read.total,
        qty: read.lines[0].qty,
        refused: taken.error,
        deleted: gone.status,
        after: dynamodb_get(TABLE, key, {})?,
        no_table: dynamodb_get("missing", key, {}).error,
    }
}

route GET /update {
    let key = { pk: "stock", sk: "A-1" }
    dynamodb_put(TABLE, { ...key, count: 10, name: "widget", old: true }, {})?
    let after = dynamodb_update(TABLE, key, { count: { "$add": -3 }, name: "gadget", old: null, "where.shelf": 4 }, {})?
    let stale = dynamodb_update(TABLE, key, { count: 0 }, { condition: "#c > :big", names: { c: "count" }, values: { big: 100 } })
    { count: after.count, name: after.name, has_old: has(after, "old"), refused: stale.error }
}

route GET /query {
    for i in range(0, 7) {
        dynamodb_put(TABLE, { pk: "cust#9", sk: `order#${i}`, n: i }, {})?
    }
    let first = dynamodb_query(TABLE, "pk = :p AND begins_with(sk, :s)", { p: "cust#9", s: "order#" }, { limit: 3 })?
    let second = dynamodb_query(TABLE, "pk = :p AND begins_with(sk, :s)", { p: "cust#9", s: "order#" }, { limit: 3, start: first.next })?
    let all = dynamodb_query_all(TABLE, "pk = :p", { p: "cust#9" }, { limit: 3 })?
    let newest = dynamodb_query(TABLE, "pk = :p", { p: "cust#9" }, { limit: 1, forward: false })?
    {
        first: map(first.items, (i) => i.n),
        second: map(second.items, (i) => i.n),
        total: len(all.items),
        pages: all.pages,
        newest: newest.items[0].n,
    }
}

route GET /batch {
    let puts = map(range(0, 60), (i) => { pk: "batch", sk: `item#${i}`, n: i })
    let done = dynamodb_batch_write(TABLE, { put: puts }, {})?
    let read = dynamodb_batch_get(TABLE, map(range(0, 60), (i) => { pk: "batch", sk: `item#${i}` }), {})?
    let cleared = dynamodb_batch_write(TABLE, { delete: map(range(0, 5), (i) => { pk: "batch", sk: `item#${i}` }) }, {})?
    { written: done.written, requests: done.requests, resent: done.resent > 0, read: len(read), cleared: cleared.written, left: len(dynamodb_query_all(TABLE, "pk = :p", { p: "batch" }, {})?.items) }
}

// A number DynamoDB keeps to 38 digits comes back whole; sets stay sets; an answer the network
// garbled (its CRC32 does not match) is asked for again.
route GET /types {
    let item = { pk: "types", sk: "1", big: { "$number": "12345678901234567890123456789012345678" }, tags: { "$set": ["a", "b"] }, nums: { "$set": [1, 2] }, bin: { "$binary": "aGk=" }, ok: true }
    dynamodb_put(TABLE, item, {})?
    {
        wire: dynamodb_marshal({ n: 7, f: 1.5, s: "x", b: false, z: null, l: [1], m: { a: "b" } })?,
        back: dynamodb_get(TABLE, { pk: "types", sk: "1" }, {})?,
        plain: dynamodb_unmarshal({ n: { N: "7" }, f: { N: "2.5" }, l: { L: [{ S: "x" }] } })?,
        empty_set: dynamodb_marshal({ s: { "$set": [] } }).error,
        garbled: dynamodb_get(TABLE, { pk: "garbled", sk: "1" }, {})?.fine,
    }
}
