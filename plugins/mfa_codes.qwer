//! Recovery codes for two-factor sign-in: a set made once, shown once, stored only as hashes, and each usable one time.
//! version: 1.0.0
//!
//! [dependencies]
//! rand = "0.8"
//! sha2 = "0.10"

use rand::Rng;
use sha2::{Digest, Sha256};

/// No 0, o, 1, i or l, so a code copied from paper is read right.
const ALPHABET: &[u8] = b"23456789abcdefghjkmnpqrstuvwxyz";

fn normal(code: &str) -> String {
    code.chars().filter(|c| c.is_ascii_alphanumeric()).collect::<String>().to_lowercase()
}

fn hash(code: &str) -> String {
    let n = normal(code);
    Sha256::digest(format!("mfa-recovery:{}", n).as_bytes()).iter().map(|b| format!("{:02x}", b)).collect()
}

/// `count` new codes (1 to 50; 10 is usual), each 10 characters as `xxxxx-xxxxx` (about 49 bits): show them to the user once,
/// then store mfa_hash of each and forget the codes.
pub fn mfa_codes(count: i64) -> Vec<String> {
    let mut rng = rand::rngs::OsRng;
    (0..count.clamp(1, 50)).map(|_| {
        let s: String = (0..10).map(|_| ALPHABET[rng.gen_range(0..ALPHABET.len())] as char).collect();
        format!("{}-{}", &s[..5], &s[5..])
    }).collect()
}

/// The hash to store for a code (SHA-256, hex). Spaces, dashes and capitals do not count, so `ABCDE FGHJK` is `abcde-fghjk`.
pub fn mfa_hash(code: &str) -> String {
    hash(code)
}

/// Which stored hash `code` matches: its position in `hashes`, or -1 for none. Remove that hash once it is used: each code
/// works one time. Every hash is compared, in constant time, so the answer's timing tells nothing.
pub fn mfa_check(code: &str, hashes: Vec<String>) -> i64 {
    if normal(code).len() < 8 {
        return -1;
    }
    let h = hash(code);
    let mut found = -1i64;
    for (i, s) in hashes.iter().enumerate() {
        let same = s.len() == h.len() && s.bytes().zip(h.bytes()).fold(0u8, |acc, (a, b)| acc | (a ^ b)) == 0;
        if same && found < 0 {
            found = i as i64;
        }
    }
    found
}
