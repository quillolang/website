//! Check values against a JSON Schema (drafts 4 to 2020-12): every error with the path of the value at fault, for API bodies, imports and config files.
//! version: 1.0.0
//!
//! [dependencies]
//! jsonschema = { version = "0.26", default-features = false }

use serde_json::{json, Value};

fn validator(schema: &Value) -> Result<jsonschema::Validator, String> {
    jsonschema::validator_for(schema).map_err(|e| format!("the schema is not valid: {} (at {})", e, e.instance_path))
}

/// Every way `value` breaks `schema`: `{ path, message, schema_path }` each, `path` a JSON Pointer to the value at fault (`/items/2/price`,
/// `""` for the whole value), `schema_path` the rule it broke. An empty list when it is valid. The draft is the schema's
/// `$schema`, 2020-12 when it names none; `$ref`s to other files or URLs are not fetched. At most 200 errors.
pub fn schema_errors(value: serde_json::Value, schema: serde_json::Value) -> Result<Vec<Value>, String> {
    let v = validator(&schema)?;
    Ok(v.iter_errors(&value).take(200).map(|e| json!({
        "path": e.instance_path.to_string(),
        "message": e.to_string(),
        "schema_path": e.schema_path.to_string(),
    })).collect())
}

/// Whether `value` is valid against `schema`.
pub fn schema_valid(value: serde_json::Value, schema: serde_json::Value) -> Result<bool, String> {
    Ok(validator(&schema)?.is_valid(&value))
}

/// The problems of a schema itself (a misspelt type, a bad pattern): an empty list for a schema that can be used.
pub fn schema_problems(schema: serde_json::Value) -> Vec<String> {
    match jsonschema::validator_for(&schema) {
        Ok(_) => vec![],
        Err(e) => vec![format!("{} (at {})", e, e.instance_path)],
    }
}
