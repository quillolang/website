// A small uptime check: this machine pinged with ICMP, a web server by TCP connect, several hosts
// at once, a closed port told apart from a dead host, and the classic summary line. Unprivileged:
// macOS allows ICMP datagram sockets, and Linux does for groups in net.ipv4.ping_group_range.
//
//   quillo run ping.qwe      then open http://localhost:8080/local and /web

use "ping.qwer"

let OPEN = int(env("PING_OPEN_PORT", "22"))
let QUICK = { count: 3, interval_ms: 20, timeout_ms: 500 }

route GET /local {
    let r = ping_host("127.0.0.1", QUICK)?
    { method: r.method, address: r.address, sent: r.sent, received: r.received, alive: r.alive, loss: r.loss_percent, times: len(r.times_ms), fast: r.max_ms < 400, ordered: r.min_ms <= r.avg_ms && r.avg_ms <= r.max_ms }
}

route GET /six {
    let r = ping_host("::1", { ...QUICK, size: 200 })?
    { method: r.method, address: r.address, received: r.received }
}

route GET /web {
    let open = ping_tcp("127.0.0.1", OPEN, QUICK)?
    let closed = ping_tcp("127.0.0.1", 1, QUICK)?
    { open: [open.method, open.port, open.received, open.alive, open.port_open], closed: [closed.alive, closed.port_open] }
}

route GET /many {
    let all = ping_many(["127.0.0.1", "localhost", "no-such-host.invalid"], QUICK)?
    all | map((r) => [r.host, r.alive, r.error != null])
}

route GET /summary {
    let r = ping_tcp("127.0.0.1", OPEN, { ...QUICK, count: 2 })?
    let s = ping_summary(r)?
    { line: split(s, "\n")[0], has_times: contains(s, "rtt min/avg/max/stddev"), none: ping_summary({ sent: 2, received: 0, loss_percent: 100 })? }
}

route GET /allowed = ping_allowed()

route GET /errors = {
    no_host: ping_host("no-such-host.invalid", QUICK).error != null,
    bad_port: ping_tcp("127.0.0.1", 70000, QUICK).error,
    bad_method: ping_host("127.0.0.1", { method: "carrier" }).error,
    not_result: ping_summary({ nothing: true }).error,
    unanswered: ping_host("127.0.0.1", { ...QUICK, method: "tcp", port: 1, count: 1 })?.port_open,
}
