// A bakery's numbers: what each loaf costs from three weeks of totals, the inverse of a transform,
// and a trend line through monthly sales.
//
//   quillo run matrix.qwe      then open http://localhost:8080/costs

use "matrix.qwer"

// Three weeks of flour, butter and sugar used for bread, croissants and cakes (kg each),
// and what they cost in total: the price of each ingredient per kg.
route GET /costs {
    let used = [[20, 2, 1], [10, 6, 3], [5, 3, 6]]
    let paid = [41.5, 49.5, 36.0]
    let p = matrix_solve(used, paid)?
    { flour: p[0], butter: p[1], sugar: p[2] }
}

route GET /inverse = {
    inverse: matrix_inverse([[4, 7], [2, 6]])?,
    det: matrix_determinant([[4, 7], [2, 6]])?,
    check: matrix_multiply([[4, 7], [2, 6]], matrix_inverse([[4, 7], [2, 6]])?)?,
    singular: matrix_inverse([[1, 2], [2, 4]]).error,
}

route GET /trend {
    let sales = [120, 135, 149, 160, 178, 190]
    let fit = matrix_least_squares(range(len(sales)) | map((m) => [float(m), 1.0]), sales)?
    { per_month: round(fit[0], 2), start: round(fit[1], 2), month_7: round(fit[0] * 6 + fit[1], 1) }
}
