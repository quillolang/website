        }
        "NZ" => {
            add(ymd(y, 1, 1), "New Year's Day", true);
            add(ymd(y, 1, 2), "Day after New Year's Day", true);
            add(ymd(y, 2, 6), "Waitangi Day", y >= 2014);
            add(ed(-2), "Good Friday", false);
            add(ed(1), "Easter Monday", false);
            add(ymd(y, 4, 25), "Anzac Day", y >= 2015);
            add(nth(y, 6, Mon, 1), "King's Birthday", false);
            let matariki = [(2022, 6, 24), (2023, 7, 14), (2024, 6, 28), (2025, 6, 20), (2026, 7, 10), (2027, 6, 25), (2028, 7, 14), (2029, 7, 6), (2030, 6, 21)];
            if let Some((_, m, d)) = matariki.iter().find(|(yy, _, _)| *yy == y) { add(ymd(y, *m, *d), "Matariki", false) }
            add(nth(y, 10, Mon, 4), "Labour Day", false);
            add(ymd(y, 12, 25), "Christmas Day", true);
