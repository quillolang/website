            add(ymd(y, 12, 25), "Christmas Day", false);
            add(ymd(y, 12, 30), "Rizal Day", false);
            add(ymd(y, 12, 31), "Last Day of the Year", false);
        }
        "JP" => {
            let since = (y - 1980) as f64;
            let leap = ((y - 1980) / 4) as f64;
            add(ymd(y, 1, 1), "New Year's Day", true);
            add(nth(y, 1, Mon, 2), "Coming of Age Day", false);
            add(ymd(y, 2, 11), "National Foundation Day", true);
            if y >= 2020 { add(ymd(y, 2, 23), "Emperor's Birthday", true) }
            add(ymd(y, 3, (20.8431 + 0.242194 * since - leap).floor() as u32), "Vernal Equinox Day", true);
            add(ymd(y, 4, 29), "Showa Day", true);
            add(ymd(y, 5, 3), "Constitution Memorial Day", true);
            add(ymd(y, 5, 4), "Greenery Day", true);
            add(ymd(y, 5, 5), "Children's Day", true);
            add(nth(y, 7, Mon, 3), "Marine Day", false);
            if y >= 2016 { add(ymd(y, 8, 11), "Mountain Day", true) }
            add(nth(y, 9, Mon, 3), "Respect for the Aged Day", false);
            add(ymd(y, 9, (23.2488 + 0.242194 * since - leap).floor() as u32), "Autumnal Equinox Day", true);
            add(nth(y, 10, Mon, 2), "Sports Day", false);
            add(ymd(y, 11, 3), "Culture Day", true);
            add(ymd(y, 11, 23), "Labour Thanksgiving Day", true);
        }
        "ZA" => {
            add(ymd(y, 1, 1), "New Year's Day", true);
            add(ymd(y, 3, 21), "Human Rights Day", true);
            add(ed(-2), "Good Friday", false);
            add(ed(1), "Family Day", false);
            add(ymd(y, 4, 27), "Freedom Day", true);
            add(ymd(y, 5, 1), "Workers' Day", true);
            add(ymd(y, 6, 16), "Youth Day", true);
            add(ymd(y, 8, 9), "National Women's Day", true);
            add(ymd(y, 9, 24), "Heritage Day", true);
            add(ymd(y, 12, 16), "Day of Reconciliation", true);
            add(ymd(y, 12, 25), "Christmas Day", true);
            add(ymd(y, 12, 26), "Day of Goodwill", true);
        }
        _ => {}
    }
    v.sort_by_key(|x| x.0);
    v
}

fn country(code: &str) -> Result<&'static Country, String> {
    let c = code.trim().to_uppercase();
    let c = if c == "UK" { "GB".to_string() } else { c };
    COUNTRIES.iter().find(|x| x.code == c).ok_or_else(|| format!("`{}` is not a country this knows: {}", code, COUNTRIES.iter().map(|c| c.code).collect::<Vec<_>>().join(", ")))
}

struct Holiday { date: D, name: &'static str, observed: D }

fn year_list(c: &Country, y: i32) -> Vec<Holiday> {
    let raw = rules(c.code, y);
    let weekend = |d: D| matches!(d.weekday(), Sat | Sun);
    let mut taken: Vec<D> = raw.iter().map(|h| h.0).filter(|d| !weekend(*d)).collect();
    let mut out = Vec::new();
    for (d, name, moved) in &raw {
        let mut obs = *d;
        if *moved {
            match c.shift {
                Shift::UsStyle => { if d.weekday() == Sat { obs = *d - Duration::days(1) } else if d.weekday() == Sun { obs = *d + Duration::days(1) } }
                Shift::NextWeekday => {
                    if weekend(*d) {
                        let mut n = *d + Duration::days(1);
                        while weekend(n) || taken.contains(&n) { n += Duration::days(1) }
                        obs = n;
                        taken.push(n);
                    }
                }
                Shift::SundayToMonday => { if d.weekday() == Sun { obs = *d + Duration::days(1) } }
                Shift::Japan => {
                    if d.weekday() == Sun {
                        let all: Vec<D> = raw.iter().map(|h| h.0).collect();
                        let mut n = *d + Duration::days(1);
                        while all.contains(&n) || taken.contains(&n) { n += Duration::days(1) }
                        obs = n;
                        taken.push(n);
                    }
                }
                Shift::None => {}
            }
        }
        out.push(Holiday { date: *d, name, observed: obs });
    }
    if c.shift == Shift::Japan {
        // A day between two holidays is a holiday too (kokumin no kyūjitsu).
        let dates: Vec<D> = out.iter().map(|h| h.date).collect();
        for &d in &dates {
            let gap = d + Duration::days(1);
            if dates.contains(&(d + Duration::days(2))) && !dates.contains(&gap) && gap.weekday() != Sun {
                out.push(Holiday { date: gap, name: "Citizens' Holiday", observed: gap });
            }
        }
        out.sort_by_key(|h| h.date);
    }
    out
}

fn to_json(h: &Holiday) -> Value {
    json!({
        "date": h.date.to_string(),
        "name": h.name,
        "weekday": h.date.format("%A").to_string(),
        "observed": h.observed.to_string(),
    })
}

fn year_ok(y: i64) -> Result<i32, String> {
    if !(1970..=2099).contains(&y) { return Err(format!("years 1970 to 2099, not {}", y)) }
    Ok(y as i32)
}

fn parse(d: &str) -> Result<D, String> {
    NaiveDate::parse_from_str(d.trim().get(..10).unwrap_or(d), "%Y-%m-%d").map_err(|_| format!("`{}` is not a date (2026-12-25)", d))
}

/// The public holidays of `country` (`"US"`, `"GB"`, `"DE"`, `"JP"`, `"PH"`...) in `year`: a list of `{ date, name, weekday, observed }`, in date order.
/// `observed` is the day off when the holiday is moved for falling on a weekend (US Saturday holidays on the Friday, UK and Australian ones on the next Monday...), else `date`. National holidays only: not regional ones, nor ones fixed each year by decree.
pub fn holidays_list(country: &str, year: i64) -> Result<Vec<Value>, String> {
    let c = self::country(country)?;
    Ok(year_list(c, year_ok(year)?).iter().map(to_json).collect())
}

/// The holiday on `date` in `country`, as its name, counting the day it is observed on; null when it is a working day. For "closed today" banners and delivery dates.
pub fn holidays_on(country: &str, date: &str) -> Result<Option<String>, String> {
    let c = self::country(country)?;
    let d = parse(date)?;
    let y = year_ok(d.year() as i64)?;
    let hit = year_list(c, y).into_iter().chain(if y < 2099 { year_list(c, y + 1) } else { vec![] }).find(|h| h.date == d || h.observed == d);
    Ok(hit.map(|h| if h.date == d { h.name.to_string() } else { format!("{} (observed)", h.name) }))
}

/// The next `count` holidays in `country` from `date` on (that day included).
pub fn holidays_next(country: &str, date: &str, count: i64) -> Result<Vec<Value>, String> {
    let c = self::country(country)?;
    let d = parse(date)?;
    let mut out = Vec::new();
    let mut y = year_ok(d.year() as i64)?;
    while (out.len() as i64) < count.min(200) && y <= 2099 {
        for h in year_list(c, y) {
            if h.date >= d && (out.len() as i64) < count { out.push(to_json(&h)) }
        }
        y += 1;
    }
    Ok(out)
}

/// The countries this knows: a list of `{ code, name }`.
pub fn holidays_countries() -> Vec<Value> {
    COUNTRIES.iter().map(|c| json!({ "code": c.code, "name": c.name })).collect()
}

/// Easter Sunday of `year`, Western, or Orthodox when `orthodox` (as a Gregorian date).
pub fn holidays_easter(year: i64, orthodox: bool) -> Result<String, String> {
    if !(1583..=4099).contains(&year) { return Err("years 1583 to 4099".into()) }
    Ok(if orthodox { orthodox_easter(year as i32) } else { easter(year as i32) }.to_string())
}
