            add(nth(y, 2, Mon, 1), "Constitution Day", false);
            add(nth(y, 3, Mon, 3), "Benito Juárez's Birthday", false);
            add(ymd(y, 5, 1), "Labour Day", false);
            add(ymd(y, 9, 16), "Independence Day", false);
            if y >= 2024 && (y - 2024) % 6 == 0 { add(ymd(y, 10, 1), "Inauguration Day", false) }
            add(nth(y, 11, Mon, 3), "Revolution Day", false);
            add(ymd(y, 12, 25), "Christmas Day", false);
        }
        "AU" => {
            add(ymd(y, 1, 1), "New Year's Day", true);
            add(ymd(y, 1, 26), "Australia Day", true);
            add(ed(-2), "Good Friday", false);
            add(ed(-1), "Easter Saturday", false);
            add(ed(1), "Easter Monday", false);
            add(ymd(y, 4, 25), "Anzac Day", false);
