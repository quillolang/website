//! Public holidays of 27 countries for any year from 1970 to 2099, computed (Easter and its feasts, "the last Monday of May", Japan's equinoxes): their dates, the weekday they are taken when they fall on a weekend, whether a date is one, and the next ones.
//! version: 1.0.0
//!
//! [dependencies]
//! chrono = { version = "0.4", default-features = false, features = ["std", "clock"] }
//! serde_json = { version = "1", features = ["preserve_order"] }

use chrono::{Datelike, Duration, NaiveDate, Weekday};
use serde_json::{json, Value};

type D = NaiveDate;

fn ymd(y: i32, m: u32, d: u32) -> D { NaiveDate::from_ymd_opt(y, m, d).unwrap() }

/// Western Easter Sunday (the Gregorian computus).
fn easter(y: i32) -> D {
    let a = y % 19;
    let b = y / 100;
    let c = y % 100;
    let d = b / 4;
    let e = b % 4;
    let f = (b + 8) / 25;
    let g = (b - f + 1) / 3;
    let h = (19 * a + b - d - g + 15) % 30;
    let i = c / 4;
    let k = c % 4;
    let l = (32 + 2 * e + 2 * i - h - k) % 7;
    let m = (a + 11 * h + 22 * l) / 451;
    let month = (h + l - 7 * m + 114) / 31;
    let day = (h + l - 7 * m + 114) % 31 + 1;
    ymd(y, month as u32, day as u32)
}

/// Orthodox Easter Sunday (the Julian computus, as a Gregorian date).
fn orthodox_easter(y: i32) -> D {
    let a = y % 4;
    let b = y % 7;
    let c = y % 19;
    let d = (19 * c + 15) % 30;
    let e = (2 * a + 4 * b - d + 34) % 7;
    let month = (d + e + 114) / 31;
    let day = (d + e + 114) % 31 + 1;
    ymd(y, month as u32, day as u32) + Duration::days(13)
}

/// The `n`th `wd` of a month (n = -1 for the last).
fn nth(y: i32, m: u32, wd: Weekday, n: i32) -> D {
    if n > 0 {
        let first = ymd(y, m, 1);
        let shift = (wd.num_days_from_monday() as i64 - first.weekday().num_days_from_monday() as i64).rem_euclid(7);
        first + Duration::days(shift + 7 * (n as i64 - 1))
    } else {
        let last = if m == 12 { ymd(y + 1, 1, 1) } else { ymd(y, m + 1, 1) } - Duration::days(1);
        let shift = (last.weekday().num_days_from_monday() as i64 - wd.num_days_from_monday() as i64).rem_euclid(7);
        last - Duration::days(shift)
    }
}

/// The first `wd` on or after a date.
fn on_or_after(d: D, wd: Weekday) -> D {
    d + Duration::days((wd.num_days_from_monday() as i64 - d.weekday().num_days_from_monday() as i64).rem_euclid(7))
}

#[derive(Clone, Copy, PartialEq)]
enum Shift { None, UsStyle, NextWeekday, SundayToMonday, Japan }

struct Country { code: &'static str, name: &'static str, shift: Shift }

const COUNTRIES: [Country; 27] = [
    Country { code: "AT", name: "Austria", shift: Shift::None },
    Country { code: "AU", name: "Australia", shift: Shift::NextWeekday },
    Country { code: "BE", name: "Belgium", shift: Shift::None },
    Country { code: "BR", name: "Brazil", shift: Shift::None },
    Country { code: "CA", name: "Canada", shift: Shift::NextWeekday },
    Country { code: "CH", name: "Switzerland", shift: Shift::None },
    Country { code: "CZ", name: "Czechia", shift: Shift::None },
    Country { code: "DE", name: "Germany", shift: Shift::None },
    Country { code: "DK", name: "Denmark", shift: Shift::None },
    Country { code: "ES", name: "Spain", shift: Shift::None },
    Country { code: "FI", name: "Finland", shift: Shift::None },
    Country { code: "FR", name: "France", shift: Shift::None },
    Country { code: "GB", name: "United Kingdom (England and Wales)", shift: Shift::NextWeekday },
    Country { code: "GR", name: "Greece", shift: Shift::None },
    Country { code: "IE", name: "Ireland", shift: Shift::None },
    Country { code: "IT", name: "Italy", shift: Shift::None },
    Country { code: "JP", name: "Japan", shift: Shift::Japan },
    Country { code: "MX", name: "Mexico", shift: Shift::None },
    Country { code: "NL", name: "Netherlands", shift: Shift::None },
    Country { code: "NO", name: "Norway", shift: Shift::None },
    Country { code: "NZ", name: "New Zealand", shift: Shift::NextWeekday },
    Country { code: "PH", name: "Philippines", shift: Shift::None },
    Country { code: "PL", name: "Poland", shift: Shift::None },
    Country { code: "PT", name: "Portugal", shift: Shift::None },
    Country { code: "SE", name: "Sweden", shift: Shift::None },
    Country { code: "US", name: "United States (federal)", shift: Shift::UsStyle },
    Country { code: "ZA", name: "South Africa", shift: Shift::SundayToMonday },
];

use Weekday::*;

// (date, name, moved when it falls on a weekend)
fn rules(code: &str, y: i32) -> Vec<(D, &'static str, bool)> {
    let e = easter(y);
    let ed = |n: i64| e + Duration::days(n);
    let mut v: Vec<(D, &'static str, bool)> = Vec::new();
    let mut add = |d: D, n: &'static str, moved: bool| v.push((d, n, moved));
    match code {
        "US" => {
            add(ymd(y, 1, 1), "New Year's Day", true);
            add(nth(y, 1, Mon, 3), "Martin Luther King Jr. Day", false);
            add(nth(y, 2, Mon, 3), "Washington's Birthday", false);
            add(nth(y, 5, Mon, -1), "Memorial Day", false);
            if y >= 2021 { add(ymd(y, 6, 19), "Juneteenth", true) }
            add(ymd(y, 7, 4), "Independence Day", true);
            add(nth(y, 9, Mon, 1), "Labor Day", false);
            add(nth(y, 10, Mon, 2), "Columbus Day", false);
            add(ymd(y, 11, 11), "Veterans Day", true);
            add(nth(y, 11, Thu, 4), "Thanksgiving Day", false);
            add(ymd(y, 12, 25), "Christmas Day", true);
        }
        "CA" => {
            add(ymd(y, 1, 1), "New Year's Day", true);
            add(ed(-2), "Good Friday", false);
            add(on_or_after(ymd(y, 5, 18), Mon), "Victoria Day", false);
            add(ymd(y, 7, 1), "Canada Day", true);
            add(nth(y, 9, Mon, 1), "Labour Day", false);
            if y >= 2021 { add(ymd(y, 9, 30), "National Day for Truth and Reconciliation", true) }
            add(nth(y, 10, Mon, 2), "Thanksgiving", false);
            add(ymd(y, 11, 11), "Remembrance Day", true);
            add(ymd(y, 12, 25), "Christmas Day", true);
            add(ymd(y, 12, 26), "Boxing Day", true);
        }
        "GB" => {
            add(ymd(y, 1, 1), "New Year's Day", true);
            add(ed(-2), "Good Friday", false);
            add(ed(1), "Easter Monday", false);
            add(nth(y, 5, Mon, 1), "Early May bank holiday", false);
            add(nth(y, 5, Mon, -1), "Spring bank holiday", false);
            add(nth(y, 8, Mon, -1), "Summer bank holiday", false);
            add(ymd(y, 12, 25), "Christmas Day", true);
            add(ymd(y, 12, 26), "Boxing Day", true);
        }
        "IE" => {
            add(ymd(y, 1, 1), "New Year's Day", false);
            if y >= 2023 { let f1 = ymd(y, 2, 1); add(if f1.weekday() == Fri { f1 } else { nth(y, 2, Mon, 1) }, "Saint Brigid's Day", false) }
            add(ymd(y, 3, 17), "Saint Patrick's Day", false);
            add(ed(1), "Easter Monday", false);
            add(nth(y, 5, Mon, 1), "May Day", false);
            add(nth(y, 6, Mon, 1), "June bank holiday", false);
            add(nth(y, 8, Mon, 1), "August bank holiday", false);
            add(nth(y, 10, Mon, -1), "October bank holiday", false);
            add(ymd(y, 12, 25), "Christmas Day", false);
            add(ymd(y, 12, 26), "Saint Stephen's Day", false);
        }
        "FR" => {
            add(ymd(y, 1, 1), "New Year's Day", false);
            add(ed(1), "Easter Monday", false);
            add(ymd(y, 5, 1), "Labour Day", false);
            add(ymd(y, 5, 8), "Victory in Europe Day", false);
            add(ed(39), "Ascension Day", false);
            add(ed(50), "Whit Monday", false);
            add(ymd(y, 7, 14), "Bastille Day", false);
            add(ymd(y, 8, 15), "Assumption", false);
            add(ymd(y, 11, 1), "All Saints' Day", false);
            add(ymd(y, 11, 11), "Armistice Day", false);
            add(ymd(y, 12, 25), "Christmas Day", false);
        }
        "DE" => {
            add(ymd(y, 1, 1), "New Year's Day", false);
            add(ed(-2), "Good Friday", false);
            add(ed(1), "Easter Monday", false);
            add(ymd(y, 5, 1), "Labour Day", false);
            add(ed(39), "Ascension Day", false);
            add(ed(50), "Whit Monday", false);
            add(ymd(y, 10, 3), "German Unity Day", false);
            add(ymd(y, 12, 25), "Christmas Day", false);
            add(ymd(y, 12, 26), "Second Day of Christmas", false);
        }
        "NL" => {
            add(ymd(y, 1, 1), "New Year's Day", false);
            add(e, "Easter Sunday", false);
            add(ed(1), "Easter Monday", false);
            let kd = ymd(y, 4, 27);
            add(if kd.weekday() == Sun { ymd(y, 4, 26) } else { kd }, "King's Day", false);
            add(ymd(y, 5, 5), "Liberation Day", false);
            add(ed(39), "Ascension Day", false);
            add(ed(49), "Whit Sunday", false);
            add(ed(50), "Whit Monday", false);
            add(ymd(y, 12, 25), "Christmas Day", false);
            add(ymd(y, 12, 26), "Second Day of Christmas", false);
        }
        "BE" => {
            add(ymd(y, 1, 1), "New Year's Day", false);
            add(ed(1), "Easter Monday", false);
            add(ymd(y, 5, 1), "Labour Day", false);
            add(ed(39), "Ascension Day", false);
            add(ed(50), "Whit Monday", false);
            add(ymd(y, 7, 21), "National Day", false);
            add(ymd(y, 8, 15), "Assumption", false);
            add(ymd(y, 11, 1), "All Saints' Day", false);
            add(ymd(y, 11, 11), "Armistice Day", false);
            add(ymd(y, 12, 25), "Christmas Day", false);
        }
        "ES" => {
            add(ymd(y, 1, 1), "New Year's Day", false);
            add(ymd(y, 1, 6), "Epiphany", false);
            add(ed(-2), "Good Friday", false);
            add(ymd(y, 5, 1), "Labour Day", false);
            add(ymd(y, 8, 15), "Assumption", false);
            add(ymd(y, 10, 12), "National Day of Spain", false);
            add(ymd(y, 11, 1), "All Saints' Day", false);
            add(ymd(y, 12, 6), "Constitution Day", false);
            add(ymd(y, 12, 8), "Immaculate Conception", false);
            add(ymd(y, 12, 25), "Christmas Day", false);
        }
        "IT" => {
            add(ymd(y, 1, 1), "New Year's Day", false);
            add(ymd(y, 1, 6), "Epiphany", false);
            add(e, "Easter Sunday", false);
            add(ed(1), "Easter Monday", false);
            add(ymd(y, 4, 25), "Liberation Day", false);
            add(ymd(y, 5, 1), "Labour Day", false);
            add(ymd(y, 6, 2), "Republic Day", false);
            add(ymd(y, 8, 15), "Ferragosto", false);
            add(ymd(y, 11, 1), "All Saints' Day", false);
            add(ymd(y, 12, 8), "Immaculate Conception", false);
            add(ymd(y, 12, 25), "Christmas Day", false);
            add(ymd(y, 12, 26), "Saint Stephen's Day", false);
        }
        "PT" => {
            add(ymd(y, 1, 1), "New Year's Day", false);
            add(ed(-2), "Good Friday", false);
            add(e, "Easter Sunday", false);
            add(ymd(y, 4, 25), "Freedom Day", false);
            add(ymd(y, 5, 1), "Labour Day", false);
            add(ymd(y, 6, 10), "Portugal Day", false);
            add(ed(60), "Corpus Christi", false);
            add(ymd(y, 8, 15), "Assumption", false);
            add(ymd(y, 10, 5), "Republic Day", false);
            add(ymd(y, 11, 1), "All Saints' Day", false);
            add(ymd(y, 12, 1), "Restoration of Independence", false);
            add(ymd(y, 12, 8), "Immaculate Conception", false);
            add(ymd(y, 12, 25), "Christmas Day", false);
        }
        "AT" => {
            add(ymd(y, 1, 1), "New Year's Day", false);
            add(ymd(y, 1, 6), "Epiphany", false);
            add(ed(1), "Easter Monday", false);
            add(ymd(y, 5, 1), "Labour Day", false);
            add(ed(39), "Ascension Day", false);
            add(ed(50), "Whit Monday", false);
            add(ed(60), "Corpus Christi", false);
            add(ymd(y, 8, 15), "Assumption", false);
            add(ymd(y, 10, 26), "National Day", false);
            add(ymd(y, 11, 1), "All Saints' Day", false);
            add(ymd(y, 12, 8), "Immaculate Conception", false);
            add(ymd(y, 12, 25), "Christmas Day", false);
            add(ymd(y, 12, 26), "Saint Stephen's Day", false);
        }
        "CH" => {
            add(ymd(y, 1, 1), "New Year's Day", false);
            add(ed(-2), "Good Friday", false);
            add(ed(1), "Easter Monday", false);
            add(ed(39), "Ascension Day", false);
            add(ed(50), "Whit Monday", false);
            add(ymd(y, 8, 1), "Swiss National Day", false);
            add(ymd(y, 12, 25), "Christmas Day", false);
            add(ymd(y, 12, 26), "Saint Stephen's Day", false);
        }
        "SE" => {
            add(ymd(y, 1, 1), "New Year's Day", false);
            add(ymd(y, 1, 6), "Epiphany", false);
            add(ed(-2), "Good Friday", false);
            add(e, "Easter Sunday", false);
            add(ed(1), "Easter Monday", false);
            add(ymd(y, 5, 1), "May Day", false);
            add(ed(39), "Ascension Day", false);
            add(ed(49), "Whit Sunday", false);
            add(ymd(y, 6, 6), "National Day", false);
            add(on_or_after(ymd(y, 6, 19), Fri), "Midsummer Eve", false);
            add(on_or_after(ymd(y, 6, 20), Sat), "Midsummer Day", false);
            add(on_or_after(ymd(y, 10, 31), Sat), "All Saints' Day", false);
            add(ymd(y, 12, 24), "Christmas Eve", false);
            add(ymd(y, 12, 25), "Christmas Day", false);
            add(ymd(y, 12, 26), "Second Day of Christmas", false);
            add(ymd(y, 12, 31), "New Year's Eve", false);
        }
        "NO" => {
            add(ymd(y, 1, 1), "New Year's Day", false);
            add(ed(-3), "Maundy Thursday", false);
            add(ed(-2), "Good Friday", false);
            add(e, "Easter Sunday", false);
            add(ed(1), "Easter Monday", false);
            add(ymd(y, 5, 1), "Labour Day", false);
            add(ymd(y, 5, 17), "Constitution Day", false);
            add(ed(39), "Ascension Day", false);
            add(ed(49), "Whit Sunday", false);
            add(ed(50), "Whit Monday", false);
            add(ymd(y, 12, 25), "Christmas Day", false);
            add(ymd(y, 12, 26), "Saint Stephen's Day", false);
        }
        "DK" => {
            add(ymd(y, 1, 1), "New Year's Day", false);
            add(ed(-3), "Maundy Thursday", false);
            add(ed(-2), "Good Friday", false);
            add(e, "Easter Sunday", false);
            add(ed(1), "Easter Monday", false);
            if y < 2024 { add(ed(26), "Great Prayer Day", false) }
            add(ed(39), "Ascension Day", false);
            add(ed(49), "Whit Sunday", false);
            add(ed(50), "Whit Monday", false);
            add(ymd(y, 12, 25), "Christmas Day", false);
            add(ymd(y, 12, 26), "Second Day of Christmas", false);
        }
        "FI" => {
            add(ymd(y, 1, 1), "New Year's Day", false);
            add(ymd(y, 1, 6), "Epiphany", false);
            add(ed(-2), "Good Friday", false);
            add(e, "Easter Sunday", false);
            add(ed(1), "Easter Monday", false);
            add(ymd(y, 5, 1), "May Day", false);
            add(ed(39), "Ascension Day", false);
            add(ed(49), "Whit Sunday", false);
            add(on_or_after(ymd(y, 6, 19), Fri), "Midsummer Eve", false);
            add(on_or_after(ymd(y, 6, 20), Sat), "Midsummer Day", false);
            add(on_or_after(ymd(y, 10, 31), Sat), "All Saints' Day", false);
            add(ymd(y, 12, 6), "Independence Day", false);
            add(ymd(y, 12, 24), "Christmas Eve", false);
            add(ymd(y, 12, 25), "Christmas Day", false);
            add(ymd(y, 12, 26), "Saint Stephen's Day", false);
        }
        "PL" => {
            add(ymd(y, 1, 1), "New Year's Day", false);
            if y >= 2011 { add(ymd(y, 1, 6), "Epiphany", false) }
            add(e, "Easter Sunday", false);
            add(ed(1), "Easter Monday", false);
            add(ymd(y, 5, 1), "Labour Day", false);
            add(ymd(y, 5, 3), "Constitution Day", false);
            add(ed(49), "Whit Sunday", false);
            add(ed(60), "Corpus Christi", false);
            add(ymd(y, 8, 15), "Assumption", false);
            add(ymd(y, 11, 1), "All Saints' Day", false);
            add(ymd(y, 11, 11), "Independence Day", false);
            if y >= 2025 { add(ymd(y, 12, 24), "Christmas Eve", false) }
            add(ymd(y, 12, 25), "Christmas Day", false);
            add(ymd(y, 12, 26), "Second Day of Christmas", false);
        }
        "CZ" => {
            add(ymd(y, 1, 1), "Restoration Day of the Independent Czech State", false);
            add(ed(-2), "Good Friday", false);
            add(ed(1), "Easter Monday", false);
            add(ymd(y, 5, 1), "Labour Day", false);
            add(ymd(y, 5, 8), "Liberation Day", false);
            add(ymd(y, 7, 5), "Saints Cyril and Methodius Day", false);
            add(ymd(y, 7, 6), "Jan Hus Day", false);
            add(ymd(y, 9, 28), "Statehood Day", false);
            add(ymd(y, 10, 28), "Independent Czechoslovak State Day", false);
            add(ymd(y, 11, 17), "Struggle for Freedom and Democracy Day", false);
            add(ymd(y, 12, 24), "Christmas Eve", false);
            add(ymd(y, 12, 25), "Christmas Day", false);
            add(ymd(y, 12, 26), "Saint Stephen's Day", false);
        }
        "GR" => {
            let o = orthodox_easter(y);
            add(ymd(y, 1, 1), "New Year's Day", false);
            add(ymd(y, 1, 6), "Epiphany", false);
            add(o - Duration::days(48), "Clean Monday", false);
            add(ymd(y, 3, 25), "Independence Day", false);
            add(o - Duration::days(2), "Orthodox Good Friday", false);
            add(o, "Orthodox Easter Sunday", false);
            add(o + Duration::days(1), "Orthodox Easter Monday", false);
            add(ymd(y, 5, 1), "Labour Day", false);
            add(o + Duration::days(50), "Orthodox Whit Monday", false);
            add(ymd(y, 8, 15), "Assumption", false);
            add(ymd(y, 10, 28), "Ohi Day", false);
            add(ymd(y, 12, 25), "Christmas Day", false);
            add(ymd(y, 12, 26), "Synaxis of the Mother of God", false);
        }
        "BR" => {
            add(ymd(y, 1, 1), "New Year's Day", false);
            add(ed(-48), "Carnival Monday", false);
            add(ed(-47), "Carnival Tuesday", false);
            add(ed(-2), "Good Friday", false);
            add(ymd(y, 4, 21), "Tiradentes", false);
            add(ymd(y, 5, 1), "Labour Day", false);
            add(ed(60), "Corpus Christi", false);
            add(ymd(y, 9, 7), "Independence Day", false);
            add(ymd(y, 10, 12), "Our Lady of Aparecida", false);
            add(ymd(y, 11, 2), "All Souls' Day", false);
            add(ymd(y, 11, 15), "Republic Proclamation Day", false);
            if y >= 2024 { add(ymd(y, 11, 20), "Black Consciousness Day", false) }
            add(ymd(y, 12, 25), "Christmas Day", false);
        }
        "MX" => {
