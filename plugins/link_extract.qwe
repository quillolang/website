// Comments shown with their links made clickable (and nofollow), and a check of where they point.
//
//   quillo run link_extract.qwe      then open http://localhost:8080/comment

use "link_extract.qwer"

let COMMENT = "Great post! The docs (https://quillolang.org/docs/routes) helped.\nMail me at Ada@Example.com, or see www.example.org/talk. <b>not bold</b>"

route GET /comment = raw(`<p>${links_html(COMMENT, true, true)?}</p>`)

route GET /links = {
    found: links_find(COMMENT, true)? | map((l) => `${l.kind}: ${l.href} at ${l.start}`),
    hosts: links_hosts(COMMENT, true)?,
    emails: links_emails("Ada <ada@example.com>; bob@example.org, ADA@example.com")?,
}
