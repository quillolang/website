// Provisioning a factory's IP phones and switches over TFTP: a phone's configuration read
// from the provisioning server, a firmware image fetched to disk (a lost block asked for
// again), a switch's configuration backed up and read back, and this program's own TFTP
// server for the devices, its transfers logged.
//
// It needs a TFTP server for the first routes: TFTP_HOST (host or host:port).
//
//   TFTP_HOST=10.0.0.5 quillo run tftp.qwe      then open http://localhost:8080/phone
//   quillo run tftp.qwe      and http://localhost:8080/self (its own server, port 6969)

use "tftp.qwer"

let HOST = env("TFTP_HOST", "127.0.0.1")
let OPTS = { timeout_ms: 500, retries: 6 }

route GET /phone {
    let cfg = tftp_get_text(HOST, "SEP001122334455.cnf.xml", OPTS)?
    let between = (a, b) => split(split(cfg, a)[1] ?? "", b)[0]
    { bytes: len(cfg), firmware: between("<loadInformation>", "</loadInformation>"), line: between("<featureLabel>", "</featureLabel>") }
}

route GET /firmware {
    let got = tftp_get(HOST, "firmware/phone-9.4.bin", "data/firmware/phone-9.4.bin", OPTS + { blksize: 1428 })?
    { bytes: got.bytes, blocks: got.blocks, blksize: got.blksize, size_announced: got.options.tsize, asked_again: got.retransmissions > 0, path: got.path }
}

// A switch's running configuration backed up, then read back to be sure.
route GET /backup {
    let config = "hostname switch-hall-2\ninterface Gi1/0/1\n description uplink to core\n switchport mode trunk\n!\nend\n"
    let sent = tftp_put_text(HOST, "backups/switch-hall-2.cfg", config, OPTS)?
    { sent: sent.bytes, same: tftp_get_text(HOST, "backups/switch-hall-2.cfg", OPTS)? == config, again: tftp_put_text(HOST, "backups/switch-hall-2.cfg", config, OPTS).error }
}

route GET /errors = {
    missing: tftp_get_text(HOST, "SEP999999999999.cnf.xml", OPTS).error,
    read_only: tftp_put_text(HOST, "firmware/evil.bin", "x", OPTS).error,
    text_lines: split(tftp_get_text(HOST, "boot/menu.txt", OPTS + { mode: "netascii" })?, "\n")[1],
}

// This program's own server: phones fetch data/tftp/*, and may upload to it.
let PORT = int(env("TFTP_SERVE_PORT", "6969"))
write_file("data/tftp/phone-defaults.cfg", "ntp=10.0.0.1\nvlan=20\nsyslog=10.0.0.5\n")
let started = tftp_serve("lan", "data/tftp", { port: PORT, allow_write: true })

route GET /self {
    started?
    let me = `127.0.0.1:${PORT}`
    let text = tftp_get_text(me, "phone-defaults.cfg", OPTS)?
    tftp_put_text(me, `uploads/log-${now()}.txt`, "phone 4103 booted\n", OPTS)?
    {
        defaults: split(text, "\n")[1],
        outside: tftp_get_text(me, "../tftp.qwe", OPTS).error,
        transfers: tftp_transfers("lan", 10, 500)? | map((t) => `${t.op} ${t.ok ? "ok" : "failed"}`),
    }
}
