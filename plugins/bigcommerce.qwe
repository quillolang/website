// A BigCommerce store run from outside it: products on V3, orders on V2, a batch with part refused,
// the rate limit, and an app's signed payloads checked in both forms.
//
//   BIGCOMMERCE_STORE_HASH=... BIGCOMMERCE_ACCESS_TOKEN=... BIGCOMMERCE_CLIENT_ID=... BIGCOMMERCE_CLIENT_SECRET=... quillo run bigcommerce.qwe
//   then open /products, /orders, /batch, /limits, /signed and /failures
//
// BIGCOMMERCE_API_URL reaches a test server. An app's load callback gets `signed_payload_jwt`: see
// GET /load.

use "bigcommerce.qwer"

route GET /products {
    let p = bigcommerce_product_create({ name: "Blue mug", type: "physical", weight: 1, price: 12.5, sku: "MUG-B" })?
    bigcommerce_product_update(p.id, { price: 13 })?
    let read = bigcommerce_product(p.id, "variants")?
    {
        name: read.name, price: read.price,
        variants: len(read.variants), same: len(bigcommerce_variants(p.id)?),
        all: len(bigcommerce_products({ is_visible: true }, 0)?),
        capped: len(bigcommerce_products({}, 300)?),
        taken: bigcommerce_product_create({ name: "Blue mug", type: "physical", weight: 1, price: 1 }).error,
        bad: bigcommerce_product_create({ name: "x" }).error,
        deleted: bigcommerce_product_delete(p.id)?,
        categories: len(bigcommerce_categories({}, 0)?),
    }
}

route GET /orders {
    let o = bigcommerce_order_create({ products: [{ name: "Mug", quantity: 2, price_inc_tax: 10, price_ex_tax: 10 }], billing_address: { first_name: "Ada", email: "ada@example.com" } })?
    {
        total: o.total_inc_tax,
        shipped: bigcommerce_order_update(o.id, { status_id: 10 })?.status,
        lines: map(bigcommerce_order_products(o.id)?, (p) => p.quantity),
        all: len(bigcommerce_orders({ status_id: 11 }, 0)?),
        capped: len(bigcommerce_orders({ status_id: 11 }, 260)?),
        none: bigcommerce_orders({ status_id: 5 }, 0)?,
        no_lines: bigcommerce_order_create({ billing_address: {} }).error,
    }
}

route GET /batch {
    let found = bigcommerce_products({ "name:like": "Item" }, 25)?
    let changes = map(found, (p) => { id: p.id, price: 2 })
    let r = bigcommerce_products_update(changes + [{ id: 999999, price: 1 }])?
    { updated: r.updated, errors: len(r.errors), first: r.errors[0].title, no_id: bigcommerce_products_update([{ price: 1 }]).error }
}

route GET /limits {
    let before = bigcommerce_call("get", "/v3/catalog/summary", null)?
    { summary: before.data.variant_count, seen: bigcommerce_rate_limit(), waited: bigcommerce_call("get", "/v3/busy", null)?.data }
}

route GET /load {
    let claims = bigcommerce_signed_jwt(request.query.signed_payload_jwt ?? "", env("BIGCOMMERCE_CLIENT_ID", ""), env("BIGCOMMERCE_CLIENT_SECRET", ""), 0)
    if is_err(claims) { reply 401 claims.error }
    { store: claims.store_hash, user: claims.user.email }
}

// Payloads made outside this plugin, by node's crypto.
route GET /signed {
    let old = "eyJ1c2VyIjp7ImlkIjoxLCJlbWFpbCI6ImFkYUBleGFtcGxlLmNvbSJ9LCJvd25lciI6eyJpZCI6MX0sImNvbnRleHQiOiJzdG9yZXMvYWJjMTIzIiwic3RvcmVfaGFzaCI6ImFiYzEyMyIsInRpbWVzdGFtcCI6MTczMDAwMDAwMC41fQ==.M2NlODMxZWZhYmFhY2NmNmY4NDQ4OTllODYzZjk0NzEyNGEwMDJkMzM0MDk3OGExY2YxMTk4NTljY2UxMTRkYQ=="
    let jwt = "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJhdWQiOiJjbGllbnQtaWQiLCJpc3MiOiJiYyIsImlhdCI6MTczMDAwMDAwMCwibmJmIjoxNzMwMDAwMDAwLCJleHAiOjE3MzAwODY0MDAsImp0aSI6ImoxIiwic3ViIjoic3RvcmVzL2FiYzEyMyIsInVzZXIiOnsiaWQiOjEsImVtYWlsIjoiYWRhQGV4YW1wbGUuY29tIn0sIm93bmVyIjp7ImlkIjoxLCJlbWFpbCI6Im93bmVyQGV4YW1wbGUuY29tIn0sInVybCI6Ii8ifQ.6b3xmXbd45b4eOjG-XOT2dNYYx8QMCFsLfoUqfbXJsA"
    let at = 1730000100
    {
        old: bigcommerce_signed_payload(old, "client-secret")?.store_hash,
        changed: bigcommerce_signed_payload("x" + old, "client-secret").error,
        wrong: bigcommerce_signed_payload(old, "other").error,
        one_part: bigcommerce_signed_payload("abc", "client-secret").error,
        jwt: [bigcommerce_signed_jwt(jwt, "client-id", "client-secret", at)?.store_hash, bigcommerce_signed_jwt(jwt, "client-id", "client-secret", at)?.user.email],
        late: bigcommerce_signed_jwt(jwt, "client-id", "client-secret", at + 100000).error,
        other_app: bigcommerce_signed_jwt(jwt, "another", "client-secret", at).error,
        other_secret: bigcommerce_signed_jwt(jwt, "client-id", "other", at).error,
        none_alg: bigcommerce_signed_jwt("eyJhbGciOiJub25lIn0.e30.", "client-id", "client-secret", at).error,
    }
}

route GET /failures = {
    missing: bigcommerce_product(999999, "").error,
    order: bigcommerce_order(999999).error,
}
