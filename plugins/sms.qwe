// Pickup codes sent by SMS through Twilio or Vonage, the message's cost checked first, and
// replies from customers received on a webhook only Twilio can call.
//
//   SMS_PROVIDER=twilio TWILIO_ACCOUNT_SID=AC... TWILIO_AUTH_TOKEN=... quillo run sms.qwe
//   then open http://localhost:8080/send and http://localhost:8080/segments
//
// TWILIO_API_URL and VONAGE_API_URL (here SINK_URL, in tests) point it at another server.

use "sms.qwer"

let PROVIDER = env("SMS_PROVIDER", "twilio")
let CONFIG = { base_url: env("SINK_URL", null) }
let FROM = env("SMS_FROM", "+15005550006")

route GET /send = sms_send(PROVIDER, CONFIG, "+639171234567", FROM, "Your pickup code is 4821. Show it at the counter.")?

route GET /segments = {
    plain: sms_segments("Your pickup code is 4821. Show it at the counter."),
    emoji: sms_segments("Your order is ready 🎉 Show code 4821 at the counter, and thanks for shopping with us today!"),
    long: sms_segments(repeat("Reminder: ", 20)),
}

// Twilio posts each reply here; anyone else's post is refused.
route POST /sms/incoming {
    let url = `https://shop.example.com${request.path}`
    if !sms_twilio_valid(url, request.form, request.headers["x-twilio-signature"] ?? "", env("TWILIO_AUTH_TOKEN", "")) { reply 403 "not from Twilio" }
    respond(200, "<Response><Message>Thanks, we got it.</Message></Response>", { "content-type": "text/xml" })
}

route GET /signature {
    let params = { From: "+639171234567", Body: "STOP", MessageSid: "SM123" }
    let sig = sms_twilio_signature("https://shop.example.com/sms/incoming", params, "token-123")
    {
        valid: sms_twilio_valid("https://shop.example.com/sms/incoming", params, sig, "token-123"),
        changed: sms_twilio_valid("https://shop.example.com/sms/incoming", { ...params, Body: "START" }, sig, "token-123"),
    }
}
