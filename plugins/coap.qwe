// A greenhouse's controller over CoAP: its resources discovered, sensors read, its
// configuration written, read and deleted, a valve opened (the device answers when it has
// moved), a day's log fetched in blocks and a firmware image sent in blocks, the air
// temperature observed (each change kept, drained by an `every` tick), and a CoAP server of
// this program's own on udp.listen.
//
// It needs a device: COAP_DEVICE (coap://host[:port]).
//
//   COAP_DEVICE=coap://192.168.4.20 quillo run coap.qwe      then open http://localhost:8080/discover

use "coap.qwer"

let DEVICE = env("COAP_DEVICE", "coap://127.0.0.1")
let FAST = { ack_timeout_ms: 300, retries: 4 }

route GET /discover = {
    all: coap_discover(DEVICE, {})? | map((l) => l.href),
    sensors: coap_discover(`${DEVICE}?rt=temperature-c`, {})?,
}

route GET /read {
    let t = coap_get(`${DEVICE}/sensors/temp`, {})?
    let h = coap_get(`${DEVICE}/sensors/humidity`, { accept: "json" })?
    { temperature: float(t.payload), format: t.content_format, max_age: t.max_age, humidity: json.parse(h.payload).rh, missing: coap_get(`${DEVICE}/sensors/co2`, {})?.status }
}

route GET /config {
    let put = coap_put(`${DEVICE}/config`, json.stringify({ interval_s: 30, target_c: 23.5 }), { content_format: "json" })?
    let now_set = json.parse(coap_get(`${DEVICE}/config`, {})?.payload)
    let as_text = coap_put(`${DEVICE}/config`, "interval=30", { content_format: "text" })?
    let gone = coap_delete(`${DEVICE}/config`, {})?
    { put: put.status, target: now_set.target_c, as_text: [as_text.code, as_text.status], deleted: gone.status, after: coap_get(`${DEVICE}/config`, {})?.code, post: coap_post(`${DEVICE}/config`, "x", {})?.status }
}

// The device acknowledges at once, and answers when the valve has moved.
route GET /valve {
    let r = coap_post(`${DEVICE}/actuators/valve`, "open", {})?
    { answer: r.payload, waited: r.ms >= 250 }
}

route GET /blocks {
    let log = coap_get(`${DEVICE}/logs/today`, { block_size: 128 })?
    let image = join(range(1500) | map((i) => str(i % 10)), "")
    let sent = coap_put(`${DEVICE}/firmware`, image, { block_size: 1024, content_format: "octet" })?
    { log_bytes: log.bytes, log_blocks: log.blocks, first_line: split(log.payload, "\n")[0], firmware: sent.payload, firmware_code: sent.code }
}

route GET /flaky {
    let r = coap_get(`${DEVICE}/flaky`, FAST)?
    { payload: r.payload, retransmissions: r.retransmissions }
}

// The air temperature observed: each change kept (the last 50), drained every half second.
// The tick starts observing (and tries again while the device does not answer).
let readings = []
let watch = null
fn drain() {
    if !watch {
        watch = coap_observe("air", `${DEVICE}/sensors/temp`, { ack_timeout_ms: 500, retries: 2 })
        return null
    }
    let got = coap_receive("air", 100, 0)
    if got { readings = slice(readings + (got | map((n) => float(n.payload))), -50) }
}
every(500, drain)

route GET /watch {
    sleep(1200)
    let w = (watch ?? reply 503 "not observing yet: is the device on?")?
    { observing: w.observing, rising: len(readings) >= 3 && readings[len(readings) - 1] > readings[0], count_ok: len(readings) >= 3 }
}

// A CoAP server of this program's own: /hello and /echo.
udp.listen(int(env("COAP_LISTEN_PORT", "5683")), (p) => {
    let req = coap_parse(p.bytes)
    if !req || req.method == null { return null }
    let r = req.path == "/hello" ? coap_response(p.bytes, "2.05", "hello from Quillo", { content_format: "text", max_age: 10 })
        : req.path == "/echo" && req.method == "POST" ? coap_response(p.bytes, "2.04", upper(req.payload), {})
        : coap_response(p.bytes, "4.04", "", {})
    if r { udp.reply(p, r) }
})

route GET /own {
    let me = `coap://127.0.0.1:${env("COAP_LISTEN_PORT", "5683")}`
    { hello: coap_get(`${me}/hello`, {})?.payload, echo: coap_post(`${me}/echo`, "shout", {})?.payload, missing: coap_get(`${me}/nope`, {})?.status }
}

route GET /links = coap_links("</sensors/temp>;rt=\"temperature-c\";if=\"sensor\";obs,</config>;ct=\"0 50\";title=\"Settings, all of them\"")?
