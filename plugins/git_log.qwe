// A changelog page and a "last updated" date, read from the git repository the program is in.
//
//   quillo run git_log.qwe      then open http://localhost:8080/changes
//   (run it inside any git repository; REPO=/path/to/repo picks another one)

use "git_log.qwer"

let REPO = env("REPO", ".")

route GET /changes ? { n: int = 5 } =
    git_log(REPO, "HEAD", n)? | map((c) => { id: c.short, when: slice(c.date, 0, 10), who: c.author, what: c.summary })

route GET /commit ? { rev: str = "HEAD" } {
    let c = git_commit(REPO, rev)?
    { id: c.short, author: c.author, message: trim(c.message), files: c.files }
}

route GET /file ? { path: str, rev: str = "HEAD" } {
    let text = git_show_file(REPO, rev, path)? ?? reply 404 `${path} is not in ${rev}`
    let history = git_file_history(REPO, rev, path, 200)?
    { path, lines: len(split(text, "\n")), first_line: split(text, "\n")[0], changes: len(history), last_updated: len(history) > 0 ? history[0].date : null }
}

route GET /authors = git_authors(REPO, "HEAD", 200)? | map((a) => `${a.name}: ${a.commits}`)
