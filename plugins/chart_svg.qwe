// A weekly sales email's charts, drawn on the server: a line chart of two shops and a bar chart of one.
//
//   quillo run chart_svg.qwe      then open http://localhost:8080/

use "chart_svg.qwer"

let weeks = {
    labels: ["W1", "W2", "W3", "W4", "W5", "W6", "W7", "W8"],
    series: [
        { name: "Lyon", values: [1200, 1350, 1280, 1500, 1720, 1650, 1900, 2100] },
        { name: "Nantes", values: [900, 950, 1100, 1050, null, 1300, 1380, 1420] },
    ],
}

let drinks = { labels: ["Flat white", "Espresso", "Tea", "Hot chocolate"], series: [{ name: "Cups sold", values: [412, 380, 129, 64] }] }

route GET /sales.svg = respond(200, chart_line_svg(weeks, { title: "Weekly sales", prefix: "€" })?, { "content-type": "image/svg+xml" })
route GET /drinks.svg = respond(200, chart_bar_svg(drinks, { title: "Cups sold this week", width: 480, height: 280 })?, { "content-type": "image/svg+xml" })

route GET / = <html><body style="font-family: sans-serif; max-width: 680px">
    <h1>Your week</h1>
    {raw(chart_line_svg(weeks, { title: "Weekly sales", prefix: "€", theme: "auto" })?)}
    {raw(chart_bar_svg(drinks, { title: "Cups sold this week", width: 480, height: 280, theme: "auto" })?)}
    <details><summary>The numbers</summary>{raw(chart_table_html(weeks, { prefix: "€" })?)}</details>
</body></html>
