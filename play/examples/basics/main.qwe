// The language in one file: let, maps, lists,
// conditions, match, for, while and pipes.
// Press Run (Ctrl+Enter): what it prints shows in
// Output. Change anything and run again.

// ---- let: a name for a value
print("-- let --")
let name = "Ada"
let year = 1843
print(`${name} wrote the first program in ${year}`)
let count = 1
count += 2          // =, += and -= give a new value
print(`count is ${count}`)

// ---- maps: names to values
print("-- maps --")
let person = { name: "Ada", born: 1815 }
print(person.name)
print(person["born"])
print(get(person, "email") ?? "no email")
let moved = { ...person, city: "London" }
print(keys(moved))
print(has(person, "city"))  // person is unchanged
let renamed = set(person, "name", "Ada Lovelace")
print(renamed.name)
for [key, value] in { apples: 3, pears: 5 } {
    print(`${key}: ${value}`)
}

// ---- lists
print("-- lists --")
let nums = [5, 3, 8, 1]
print(nums[0])          // the first
print(nums[-1])         // the last
print(len(nums))
print(push(nums, 9))    // a new list; nums stays
print(nums + [10, 11])
print(sort(nums))
print(reverse(nums))
print(slice(nums, 1, 3))
print(sum(nums))
print(max(nums))
print(contains(nums, 8))
print(join(["a", "b", "c"], "-"))

// ---- conditions
print("-- conditions --")
let temp = 23
if temp > 30 {
    print("hot")
} else if temp > 15 {
    print("warm")
} else {
    print("cold")
}
print(temp >= 20 ? "t-shirt" : "jacket")
let nickname = null
print(nickname ?? "no nickname")

// ---- match: pick by the shape of a value
print("-- match --")
fn describe(x) = match x {
    0 => "zero"
    int as n if n < 0 => "a negative number"
    int => "a positive number"
    "hi" | "hello" => "a greeting"
    str as s => `the text "${s}"`
    [] => "an empty list"
    [first, ..rest] => `${first}, then ${len(rest)} more`
    { x: int, y: int } => `a point at ${x},${y}`
    _ => "something else"
}
print(describe(0))
print(describe(-7))
print(describe(42))
print(describe("hello"))
print(describe("Quillo"))
print(describe([]))
print(describe([1, 2, 3]))
print(describe({ x: 3, y: 4 }))
print(describe(true))

// ---- for
print("-- for --")
for fruit in ["apple", "pear", "fig"] {
    print(fruit)
}
for i in 0..3 {         // 0, 1, 2: 3 is not in it
    print(`round ${i}`)
}
let squares = for n in 1..6 => n * n  // makes a list
print(squares)

// ---- while
print("-- while --")
let k = 27
let steps = 0
while k != 1 {          // halve if even, else 3k + 1
    k = k % 2 == 0 ? k / 2 : 3 * k + 1
    steps += 1
}
print(`27 reaches 1 in ${steps} steps`)

// ---- pipes: a | f(b) is f(a, b)
print("-- pipes --")
let words = ["pear", "Fig", "apple", "kiwi", "banana"]
let long_words = words
    | map((w) => lower(w))
    | filter((w) => len(w) > 3)
    | sort()
    | join(", ")
print(long_words)
let even_squares = 1..11
    | filter((x) => x % 2 == 0)
    | map((x) => x * x)
print(even_squares)
print(even_squares | sum)
let scores = [
    { name: "Ann", score: 91 },
    { name: "Bo", score: 78 },
    { name: "Cy", score: 85 },
]
let best = scores | sort_by((s) => -s.score) | first
print(`best: ${best.name} with ${best.score}`)
let total = scores
    | map((s) => s.score)
    | reduce(0, (a, b) => a + b)
print(`total: ${total}`)
