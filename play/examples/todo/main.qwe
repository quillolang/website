// A to-do list in the browser: state, a list made from it, and handlers that make new
// values (Quillo's values do not change in place: `items = items + [...]`).

component Todo() {
    state items = [
        { id: 1, text: "Read the tour", done: true },
        { id: 2, text: "Write a route", done: false },
    ]
    state draft = ""
    let left = items | filter((i) => !i.done) | len

    <form onsubmit={() => {
        if trim(draft) != "" {
            items = items + [{ id: len(items) + 1, text: draft, done: false }]
            draft = ""
        }
    }}>
        <input value={draft} placeholder="Add something…"/>
        <ul>{for i in items =>
            <li key={i.id} class={i.done && "done"} onclick={() => {
                items = items | map((j) => j.id == i.id ? merge(j, { done: !j.done }) : j)
            }}>{i.text}</li>
        }</ul>
        <small>{left} left</small>
    </form>
}

route GET / =
    <html>
        <head><title>To-do</title>
            <style>{css}</style>
        </head>
        <body><h1>To-do</h1><Todo/></body>
    </html>

let css = "body { font: 16px system-ui, sans-serif; margin: 2rem; } li { cursor: pointer; } .done { text-decoration: line-through; opacity: .6; }"
