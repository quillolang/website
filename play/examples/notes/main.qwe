// Notes kept in SQLite, live: `live(load_notes)` runs the loader again whenever the notes
// table changes, for every open page. Open the preview in two tabs and add a note in one.

db.open("notes.db")
db.exec("create table if not exists notes (id integer primary key, text text not null)")

server fn load_notes() -> list = db.query("select id, text from notes order by id")

server fn add_note(text: str) -> map = db.exec("insert into notes (text) values (?)", text)

component Notes() {
    state notes = live(load_notes)
    state draft = ""
    <div>
        <ul>{for n in notes => <li key={n.id}>{n.text}</li>}</ul>
        <form onsubmit={() => { add_note(draft); draft = "" }}>
            <input value={draft} placeholder="A note"/>
            <button>Add</button>
        </form>
    </div>
}

route GET / =
    <html>
        <head><title>Live notes</title><style>{css}</style></head>
        <body><h1>Live notes</h1><Notes/></body>
    </html>

let css = "body { font: 16px system-ui, sans-serif; margin: 2rem; }"
