// A page, and a component that runs in the browser: the button changes `count`, and only
// the text that shows it changes. Press Run (Ctrl+Enter), then edit and run again.

fn greeting(name: str) -> str = `Hello, ${name}!`

component Counter(start: int = 0) {
    state count = start
    <div class="card">
        <p>You clicked {count} {count == 1 ? "time" : "times"}.</p>
        <button onclick={() => count += 1}>Click me</button>
        <button onclick={() => count = start}>Reset</button>
    </div>
}

route GET / =
    <html>
        <head><title>Hello</title><style>{css}</style></head>
        <body>
            <h1>{greeting("Quillo")}</h1>
            <Counter start={0}/>
            <p><a href="/about">A second page</a></p>
        </body>
    </html>

route GET /about =
    <html>
        <head><title>About</title><style>{css}</style></head>
        <body><h1>Routes are pages</h1><p><a href="/">Back</a></p></body>
    </html>

let css = "body { font: 16px system-ui, sans-serif; margin: 2rem; } .card { padding: 1rem; border: 1px solid #ccc; border-radius: 8px; max-width: 20rem; } button { margin-right: .5rem; }"
