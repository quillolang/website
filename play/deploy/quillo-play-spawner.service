# The playground's spawner (play/runner): root, as it starts systemd units; it talks only to
# the proxy, over /run/quillo-play/spawner.sock, and never sees a visitor's bytes.
[Unit]
Description=Quillo playground spawner
After=network.target

[Service]
ExecStart=/usr/local/bin/quillo-play spawner
Restart=on-failure
RestartSec=2
# It writes runs' files under /var/lib/quillo-play and its socket under /run/quillo-play only.
ProtectSystem=strict
ReadWritePaths=/var/lib/quillo-play /run
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
