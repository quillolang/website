# The playground's spawner (play/runner): root, as it starts systemd units; it talks only to
# the proxy, over /run/quillo-play/spawner.sock, and never sees a visitor's bytes.
[Unit]
Description=Quillo playground spawner
After=network.target

[Service]
ExecStart=/usr/local/bin/quillo-play spawner
Restart=on-failure
RestartSec=2
# It writes runs' files under /var/lib/quillo-play and its socket under /run/quillo-play only.
ProtectSystem=strict
ReadWritePaths=/var/lib/quillo-play /run
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
# Only what it does needs (review L9): chown and write the runs' files (CHOWN, FOWNER,
# DAC_OVERRIDE, DAC_READ_SEARCH), and open a program's socket inside /proc/<pid>/root of
# another user (SYS_PTRACE). systemd-run and systemctl talk to PID 1 as uid 0, which needs no
# capability. VERIFY on the server after each change: a run starts, connects and stops.
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
SystemCallFilter=@system-service
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
