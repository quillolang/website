# The playground's preview hosts, s01..s20.play.quillolang.org, to quillo-play's proxy (port 4310).
# Appended to /etc/limer/Limerfile. Certificates: Limer's own, http-01, one a host (DNS: *.play A).
# keepalive_idle 0: no upstream connection is reused, so one host's request never rides another's;
# max_fails 0: a visitor's program that fails never takes the proxy out of the pool.
s01.play.quillolang.org, s02.play.quillolang.org, s03.play.quillolang.org, s04.play.quillolang.org, s05.play.quillolang.org, s06.play.quillolang.org, s07.play.quillolang.org, s08.play.quillolang.org, s09.play.quillolang.org, s10.play.quillolang.org, s11.play.quillolang.org, s12.play.quillolang.org, s13.play.quillolang.org, s14.play.quillolang.org, s15.play.quillolang.org, s16.play.quillolang.org, s17.play.quillolang.org, s18.play.quillolang.org, s19.play.quillolang.org, s20.play.quillolang.org {
    log {
        output file /var/log/limer/quillo-play-access.log
        format json
    }
    reverse_proxy 127.0.0.1:4310 {
        header_up X-Forwarded-For {remote_ip}
        header_up X-Forwarded-Proto {scheme}
        keepalive_idle 0
        max_fails 0
        response_timeout 120s
    }
}
