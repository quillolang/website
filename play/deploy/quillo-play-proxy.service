# The playground's proxy (play/runner): the website's API on 127.0.0.1:4311 and the previews'
# traffic from Limer on 127.0.0.1:4310, as user quillo-play.
[Unit]
Description=Quillo playground proxy
After=quillo-play-spawner.service
Requires=quillo-play-spawner.service

[Service]
User=quillo-play
Group=quillo-play
ExecStart=/usr/local/bin/quillo-play proxy --secret-file /etc/quillo-play/secret
Restart=on-failure
RestartSec=2
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=256M
TasksMax=512

[Install]
WantedBy=multi-user.target
