// /blog/: notes on Quillo's design, from blog/<slug>.md. Each post starts with a
// front matter block (title, date, summary, tags between two `---` lines), then
// markdown as the guides have it: `### ` headings, ```quillo fences highlighted.
// /blog/feed.xml is an Atom feed of them all.

let BLOG_SLUGS = ["routes-as-syntax", "html-is-a-value", "requests-at-the-door", "pipelines", "errors-as-values",
                  "effects", "one-file", "resume-dont-redo", "live-data", "an-interpreter-first",
                  "patterns-everywhere", "records-from-requests", "no-async-await", "money-is-not-a-float", "sessions",
                  "a-checker-that-knows-routes", "first-request", "small-syntax-decisions", "translations",
                  "pages-before-the-click", "payments-that-run-once", "one-app-many-servers", "real-time-channels",
                  "when-rust-is-the-tool", "arithmetic-at-machine-speed", "editors-that-know-quillo", "money-the-type",
                  "apps-that-find-the-edges", "styles-that-travel", "491-components", "few-love-rust", "the-dream-monolith", "the-consolidated-tech-stack", "a-node-is-not-enough", "the-unusual-language", "the-accidental-name", "quillo-0-6", "javascript-libraries-by-name"]
let blog_style = read_file("blog.css")

// A post: its front matter's fields, and its body as the docs' blocks.
fn blog_post(s: str) {
    let lines = split(read_file(`blog/${s}.md`), "\n")
    let end = index_of(drop(lines, 1), "---") + 1
    let meta = reduce(slice(lines, 1, end), {}, (m, l) => {
        let at = index_of(l, ": ")
        at == null ? m : set(m, trim(slice(l, 0, at)), trim(slice(l, at + 2)))
    })
    let body = drop(lines, end + 1)
    let words = len(split(join(body, " "), " ") | filter((w) => w != ""))
    {
        slug: s, url: `/blog/${s}/`, title: meta.title, date: meta.date, summary: meta.summary,
        tags: split(meta.tags ?? "", ",") | map((t) => trim(t)) | filter((t) => t != ""),
        minutes: max([1, ceil(words / 200)]),
        blocks: blocks(body),
    }
}

// Newest first.
let blog_posts = reverse(sort_by(BLOG_SLUGS | map(blog_post), (p) => p.date))

fn blog_date(d: str) = date.format(d, { locale: "en-GB", style: "long" })

view BlogMeta(p: map) =
    <p.blog-meta>
        <time datetime={p.date}>{blog_date(p.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{p.minutes} min read</span>
    </p>

view BlogPage(title: str, path: str, description: str, kind: str = "website", published: str? = null, thread: bool = false,
              ld: list = [], children) =
    <html lang="en">
        <Head title={title} path={path} css={style + docs_style + blog_style} description={description}
            kind={kind} published={published} ld={ld}
            fonts={["instrument-serif", "inter", "jetbrains-mono"]}/>
        <body.docs-body>
            <header.nav>
                <div.nav-left>
                    <a.brand href="/" aria-label="Quillo"><Logo/><span>Quillo<span.brand-ext>.qwe</span></span></a>
                    <a.docs-label href="/blog/">Blog</a>
                </div>
                <nav><a.nav-extra href="/docs/">Docs</a><a.nav-extra href="/components/">Components</a><a.nav-extra href="/plugins/">Plugins</a><SiteThreadNav thread={thread}/><Stars/></nav>
            </header>
            <main.blog>{children}</main>
        <SiteFooter/>
        </body>
    </html>

// Structured data: the blog and its posts, and a post with its date and tags.
fn blog_ld_post(p: map) =
    { "@type": "BlogPosting", headline: p.title, description: p.summary, url: SITE + p.url,
      mainEntityOfPage: SITE + p.url, datePublished: p.date, dateModified: p.date, inLanguage: "en",
      keywords: join(p.tags, ", "), image: SITE + "/banner.png",
      author: { "@type": "Organization", name: "Quillo", url: SITE + "/" },
      publisher: { "@id": SEO_LANGUAGE }, about: { "@id": SEO_LANGUAGE }, isPartOf: { "@id": SITE + "/blog/#blog" } }

fn blog_ld_index() = [
    { "@type": "Blog", "@id": SITE + "/blog/#blog", name: "The Quillo blog", url: SITE + "/blog/",
      description: "Notes on the Quillo programming language's design, and how it was made.",
      publisher: { "@id": SEO_LANGUAGE },
      blogPost: blog_posts | map((p) => { "@type": "BlogPosting", headline: p.title, url: SITE + p.url, datePublished: p.date }) },
    seo_crumbs([["Quillo", "/"], ["Blog", "/blog/"]]),
]

fn blog_index() =
    <BlogPage title="Blog · Quillo" path="/blog/" ld={blog_ld_index()}
              description="Notes on Quillo's design: routes as syntax, HTML as a value, errors as values, effects, components that resume and pages that follow the database.">
        <div.prose>
            <p.kicker>Blog</p>
            <h1>Notes on the design</h1>
            <p.lede>How Quillo's ideas came about, from the year it was only an idea: what each one is for,
                and what it replaces. <a href="/blog/feed.xml">Follow the feed</a>, or get them by email.</p>
            <SiteSubscribe from="/blog/" compact={true}/>
        </div>
        <ol.blog-list>{for p in blog_posts =>
            <li>
                <article.blog-card>
                    <h2><a href={p.url}>{p.title}</a></h2>
                    <BlogMeta p={p}/>
                    <p>{p.summary}</p>
                </article>
            </li>}</ol>
    </BlogPage>

fn blog_page(s: str) {
    let p = find(blog_posts, (x) => x.slug == s) ?? reply 404 "No such post"
    let i = index_of(blog_posts | map((x) => x.slug), s)
    let newer = i > 0 ? blog_posts[i - 1] : null
    let older = blog_posts[i + 1]
    <BlogPage title={`${p.title} · Quillo blog`} path={p.url} description={p.summary} kind="article" thread={true}
              published={p.date} ld={[blog_ld_post(p), seo_crumbs([["Quillo", "/"], ["Blog", "/blog/"], [p.title, p.url]])]}>
        <article.prose.blog-post>
            <p.kicker><a href="/blog/">Blog</a></p>
            <h1>{p.title}</h1>
            <BlogMeta p={p}/>
            <p.lede>{p.summary}</p>
            {for b in p.blocks => <Block b={b}/>}
            <SiteSubscribe from={p.url}/>
            <SiteCommunity page={p.url}/>
            <nav.pager aria-label="More posts">
                {older ? <a.prev href={older.url}><small>Older</small>{older.title}</a> : <span></span>}
                {newer ? <a.next href={newer.url}><small>Newer</small>{newer.title}</a> : <span></span>}
            </nav>
        </article>
    </BlogPage>
}

// The Atom feed: each post's title, date, summary and link.
fn blog_feed() {
    let entry = (p) => `  <entry>
    <title>${escape(p.title)}</title>
    <link href="${SITE}${p.url}"/>
    <id>${SITE}${p.url}</id>
    <updated>${p.date}T00:00:00Z</updated>
    <summary>${escape(p.summary)}</summary>
  </entry>`
    let xml = `<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Quillo blog</title>
  <link href="${SITE}/blog/"/>
  <link rel="self" href="${SITE}/blog/feed.xml"/>
  <id>${SITE}/blog/</id>
  <updated>${first(blog_posts).date}T00:00:00Z</updated>
  <author><name>Quillo</name></author>
${join(blog_posts | map(entry), "\n")}
</feed>
`
    respond(200, xml, { "content-type": "application/atom+xml; charset=utf-8" })
}

route GET /blog = blog_index()
route GET /blog/feed.xml = blog_feed()
route GET /blog/:slug {
    if any(blog_posts, (p) => p.url == `/blog/${slug}/`) { st_hit(request, "view", `/blog/${slug}/`) }
    blog_page(slug)
}
