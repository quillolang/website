// /admin/: for the GitHub logins in SITE_ADMINS. Moderation (what is held, reported or
// new: show, hide, delete, ban), and the newsletter (issues to write, digests to
// approve, test sends, the outbox, subscribers). Every action is a plain form post.

// The admin signed in, or the answer to give instead: a sign-in, or 403.
fn adm_gate(path: str) {
    let u = cm_me_row()
    if u == null { return { stop: redirect(`/auth/github?next=${url_encode(path)}`) } }
    if !cm_is_admin(u) { return { stop: respond(403, "Admins only: your GitHub login is not in SITE_ADMINS.") } }
    { user: u }
}

view AdmNav(on: str) =
    <nav.adm-nav aria-label="Admin">
        <a href="/admin/" aria-current={on == "mod" ? "page" : null}>Moderation</a>
        <a href="/admin/newsletter/" aria-current={on == "nl" ? "page" : null}>Newsletter</a>
        <a href="/admin/subscribers.csv">Subscribers (CSV)</a>
    </nav>

fn adm_page(title: str, on: str, children) =
    <SitePage title={`${title} · Admin · Quillo`} path="/admin/" label="Admin" href="/admin/" wide={true}
              description="The site's moderation and newsletter.">
        <meta name="robots" content="noindex"/>
        <h1.adm-title>{title}</h1>
        <AdmNav on={on}/>
        {children}
    </SitePage>

fn adm_count(sql: str) = db.one(sql).n

// What can be moderated, one list: comments, samples and projects, newest first.
fn adm_items(status: str, limit: int) {
    let s = contains(["held", "shown", "hidden"], status) ? status : "all"
    db.query("select 'comment' as kind, x.id, x.page as at, x.body as text, x.status as status, x.reports as reports, x.created as created, u.login as login, u.id as uid, u.banned as banned from comments x join users u on u.id = x.user_id where (? = 'all' or x.status = ?) union all select 'sample', x.id, x.page, x.title || char(10) || x.code, x.status, x.reports, x.created, u.login, u.id, u.banned from samples x join users u on u.id = x.user_id where (? = 'all' or x.status = ?) union all select 'project', x.id, '/showcase/' || x.id || '/', x.name || ': ' || x.summary || char(10) || x.url, x.status, x.reports, x.created, u.login, u.id, u.banned from projects x join users u on u.id = x.user_id where (? = 'all' or x.status = ?) order by created desc limit ?",
        s, s, s, s, s, s, limit)
}

view AdmItem(r) =
    <article.adm-item class={`adm-${r.status}`}>
        <header>
            <b>{r.kind}</b> by <a href={`https://github.com/${r.login}`}>{r.login}</a>{r.banned == 1 && <em> (banned)</em>}
            · <a href={r.kind == "project" ? r.at : `${r.at}#${r.kind}-${r.id}`}>{r.at}</a> · {cm_ago(r.created)}
            · <span.adm-status>{r.status}</span>{r.reports > 0 && <span.adm-reports>{r.reports} report{r.reports == 1 ? "" : "s"}</span>}
        </header>
        <pre.adm-text>{slice(r.text, 0, 600)}{len(r.text) > 600 ? "…" : ""}</pre>
        <form method="post" action="/admin/moderate/">
            <input type="hidden" name="kind" value={r.kind}/>
            <input type="hidden" name="id" value={str(r.id)}/>
            <input type="hidden" name="uid" value={str(r.uid)}/>
            {r.status != "shown" && <button name="action" value="show">Show</button>}
            {r.status != "hidden" && <button name="action" value="hide">Hide</button>}
            <button name="action" value="delete">Delete</button>
            <button name="action" value={r.banned == 1 ? "unban" : "ban"}>{r.banned == 1 ? "Unban" : "Ban"} {r.login}</button>
        </form>
    </article>

route GET /admin ? { status: str = "held" } {
    let g = adm_gate("/admin/")
    if g.stop != null { return g.stop }
    let items = adm_items(status, 100)
    adm_page("Moderation", "mod", [
        <div.adm-stats>
            <span><b>{adm_count("select count(*) as n from users")}</b> people</span>
            <span><b>{adm_count("select count(*) as n from comments where status = 'shown'")}</b> comments</span>
            <span><b>{adm_count("select count(*) as n from samples where status = 'shown'")}</b> samples</span>
            <span><b>{adm_count("select count(*) as n from projects where status = 'shown'")}</b> projects</span>
            <span><b>{adm_count("select count(*) as n from votes")}</b> likes</span>
            <span><b>{adm_count("select count(*) as n from subscribers where status = 'confirmed'")}</b> subscribers</span>
        </div>,
        <nav.sc-sort aria-label="Which">
            {for s in ["held", "shown", "hidden", "all"] => <a href={`/admin/?status=${s}`} aria-current={s == status ? "page" : null}>{s == "held" ? `Held (${adm_count("select (select count(*) from comments where status = 'held') + (select count(*) from samples where status = 'held') + (select count(*) from projects where status = 'held') as n")})` : s}</a>}
        </nav>,
        len(items) == 0 ? <p.cm-empty>Nothing {status == "all" ? "yet" : status}.</p> : <div>{for r in items => <AdmItem r={r}/>}</div>,
    ])
}

route POST /admin/moderate { form: { kind: str, id: int, uid: int = 0, action: str } } {
    let g = adm_gate("/admin/")
    if g.stop != null { return g.stop }
    if !contains(CM_KINDS, kind) { reply 400 "No such kind" }
    match action {
        "show" => { cm_set_status(kind, id, "shown") }
        "hide" => { cm_set_status(kind, id, "hidden") }
        "delete" => { cm_remove(kind, id) }
        "ban" => { db.exec("update users set banned = 1 where id = ?", uid) }
        "unban" => { db.exec("update users set banned = 0 where id = ?", uid) }
        _ => { reply 400 "No such action" }
    }
    redirect(request.headers.referer ?? "/admin/")
}

// ---- the newsletter --------------------------------------------------------------------------

route GET /admin/newsletter {
    let g = adm_gate("/admin/newsletter/")
    if g.stop != null { return g.stop }
    let issues = db.query("select * from issues order by id desc limit 50")
    let outbox = db.query("select id, email, subject, status, tries, error, created from outbox order by id desc limit 40")
    adm_page("Newsletter", "nl", [
        <div.adm-stats>
            <span><b>{adm_count("select count(*) as n from subscribers where status = 'confirmed'")}</b> confirmed</span>
            <span><b>{adm_count("select count(*) as n from subscribers where status = 'pending'")}</b> waiting to confirm</span>
            <span><b>{adm_count("select count(*) as n from subscribers where status = 'unsubscribed'")}</b> left</span>
            <span><b>{adm_count("select count(*) as n from outbox where status = 'queued'")}</b> queued</span>
            <span><b>{adm_count("select count(*) as n from outbox where status = 'failed'")}</b> failed</span>
            <span>Sending: <b>{NL_PROVIDER}</b>{NL_PROVIDER == "log" ? " (kept here, not sent)" : ` as ${NL_FROM}`}</span>
        </div>,
        <h2>Write an issue</h2>,
        <form.cm-form method="post" action="/admin/newsletter/save/">
            <input name="subject" placeholder="Subject" maxlength="150" required/>
            <textarea name="body" rows="10" placeholder="The issue, in Markdown" required></textarea>
            <div.cm-row><button.cm-btn>Save as a draft</button></div>
        </form>,
        <h2>Issues</h2>,
        <table.adm-table>
            <thead><tr><th>Kind</th><th>Subject</th><th>Status</th><th>Sent to</th><th></th></tr></thead>
            <tbody>{for i in issues => <tr>
                <td>{i.kind}</td><td><a href={`/admin/newsletter/${i.id}/`}>{i.subject}</a></td><td>{i.status}</td>
                <td>{i.status == "sent" ? `${i.recipients}, ${cm_ago(i.sent)}` : ""}</td>
                <td><a href={`/admin/newsletter/${i.id}/`}>{i.status == "draft" ? "Look and send" : "Look"}</a></td></tr>}</tbody>
        </table>,
        <h2>Outbox</h2>,
        <p.cm-empty>The last emails, newest first.{NL_PROVIDER == "log" ? " With MAIL_PROVIDER at log, they are kept here and not sent." : ""}</p>,
        <table.adm-table>
            <thead><tr><th>To</th><th>Subject</th><th>Status</th><th>When</th></tr></thead>
            <tbody>{for m in outbox => <tr><td>{m.email}</td><td><a href={`/admin/outbox/${m.id}/`}>{m.subject}</a></td>
                <td>{m.status}{m.error != null && <small> {slice(m.error, 0, 120)}</small>}</td><td>{cm_ago(m.created)}</td></tr>}</tbody>
        </table>,
    ])
}

route POST /admin/newsletter/save { form: { id: int = 0, subject: str, body: str } } {
    let g = adm_gate("/admin/newsletter/")
    if g.stop != null { return g.stop }
    if id == 0 {
        db.exec("insert into issues (kind, subject, body, status, created) values ('issue', ?, ?, 'draft', ?)", trim(subject), body, now())
        return redirect(`/admin/newsletter/${db.one("select max(id) as id from issues").id}/`)
    }
    db.exec("update issues set subject = ?, body = ? where id = ? and status = 'draft'", trim(subject), body, id)
    redirect(`/admin/newsletter/${id}/`)
}

route GET /admin/newsletter/:id(int) {
    let g = adm_gate(`/admin/newsletter/${id}/`)
    if g.stop != null { return g.stop }
    let i = db.one("select * from issues where id = ?", id) ?? reply 404 "No such issue"
    let pref = NL_KINDS[i.kind] ?? "issues"
    let to = len(nl_wanting(pref))
    adm_page(i.subject, "nl", [
        <p.cm-empty>{i.kind == "issue" ? "An" : "A"} {i.kind}, {i.status}{i.status == "sent" ? `, to ${i.recipients} people` : `: it would go to ${to} subscriber${to == 1 ? "" : "s"}`}.</p>,
        <div.adm-preview>{raw(nl_html(i.subject, str(markdown(i.body, { html: true })), "#unsubscribe"))}</div>,
        i.status == "draft" ? <div>
            <h2>Change it</h2>
            <form.cm-form method="post" action="/admin/newsletter/save/">
                <input type="hidden" name="id" value={str(i.id)}/>
                <input name="subject" value={i.subject} maxlength="150" required/>
                <textarea name="body" rows="12" required>{i.body}</textarea>
                <div.cm-row><button.cm-btn.cm-btn-quiet>Save</button></div>
            </form>
            <h2>Send it</h2>
            <form.cm-form.cm-row method="post" action={`/admin/newsletter/${i.id}/test/`}>
                <input name="email" type="email" placeholder="Send a test to" required/>
                <button.cm-btn.cm-btn-quiet>Send a test</button>
            </form>
            <form method="post" action={`/admin/newsletter/${i.id}/send/`}>
                <button.cm-btn>Send to {to} subscriber{to == 1 ? "" : "s"}</button>
            </form>
        </div> : null,
    ])
}

route POST /admin/newsletter/:id(int)/test { form: { email: str } } {
    let g = adm_gate("/admin/newsletter/")
    if g.stop != null { return g.stop }
    let i = db.one("select * from issues where id = ?", id) ?? reply 404 "No such issue"
    if !nl_email_ok(lower(trim(email))) { reply 400 "That address does not look right" }
    let body = str(markdown(i.body, { html: true }))
    nl_queue(lower(trim(email)), `[Test] ${i.subject}`, nl_html(i.subject, body, `${CM_SITE}/newsletter/`), nl_text(body), `${CM_SITE}/newsletter/`, 0)
    redirect(`/admin/newsletter/${id}/`)
}

route POST /admin/newsletter/:id(int)/send {
    let g = adm_gate("/admin/newsletter/")
    if g.stop != null { return g.stop }
    nl_send_issue(id)
    redirect(`/admin/newsletter/${id}/`)
}

route GET /admin/outbox/:id(int) {
    let g = adm_gate("/admin/newsletter/")
    if g.stop != null { return g.stop }
    let m = db.one("select * from outbox where id = ?", id) ?? reply 404 "No such email"
    adm_page(m.subject, "nl", [
        <p.cm-empty>To {m.email} · {m.status}{m.error != null ? ` · ${m.error}` : ""} · {cm_ago(m.created)}</p>,
        <div.adm-preview>{raw(m.html)}</div>,
    ])
}

route GET /admin/subscribers.csv {
    let g = adm_gate("/admin/")
    if g.stop != null { return g.stop }
    let q = (s: str) => `"${replace(s ?? "", "\"", "\"\"")}"`
    let rows = db.query("select email, status, issues, digest, alerts, created, confirmed from subscribers order by id")
        | map((s) => join([q(s.email), s.status, str(s.issues), str(s.digest), str(s.alerts),
            date.format(date.from_ms(s.created), "yyyy-MM-dd"), s.confirmed != null ? date.format(date.from_ms(s.confirmed), "yyyy-MM-dd") : ""], ","))
    respond(200, "email,status,issues,digest,alerts,created,confirmed\n" + join(rows, "\n") + "\n",
        { "content-type": "text/csv; charset=utf-8", "content-disposition": "attachment; filename=subscribers.csv" })
}
