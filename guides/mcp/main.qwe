//! A notebook of short notes.
//! Call search_notes before add_note, so the same note is not written twice.

db.open("notes.db")
db.exec("create table if not exists notes (id integer primary key, text text not null)")

type Note = { id: int, text: str }

/// The notes whose text contains `word`, newest first.
fn mcp search_notes(word: str, limit: int = 20) -> list<Note> with db =
    db.query("select id, text from notes where text like ? order by id desc limit ?", `%${word}%`, limit)

/// Adds a note, and gives its id.
fn mcp add_note(text: str) -> int with db =
    db.one("insert into notes (text) values (?) returning id", text).id

/// Deletes every note, after asking the person.
fn mcp clear_notes() -> int ! str with db {
    let n = db.one("select count(*) as n from notes").n
    if !confirm(`Delete all ${n} notes?`) { return err("nothing was deleted: the user said no") }
    db.exec("delete from notes")
    n
}

route GET / with db =
    <ul>{for n in db.query("select id, text from notes order by id desc") => <li>{n.text}</li>}</ul>
