// lib/books.qwe: the books, kept in a SQLite table.

fn create_tables() with db =
    db.exec(sql`create table if not exists books (
        id integer primary key,
        title text not null,
        author text not null,
        stars integer not null default 0
    )`)

fn all_books() with db = db.query(sql`select id, title, author, stars from books order by id desc`)

fn add_book(title: str, author: str) with db =
    db.exec(sql`insert into books (title, author) values (?, ?)`, title, author)

fn remove_book(id: int) with db = db.exec(sql`delete from books where id = ?`, id)

fn star_counts(books: list) = for s in range(1, 6) => count(books, (b) => b.stars == s)

server fn rate(id: int, stars: int) -> int ! str with db {
    if stars < 1 || stars > 5 { return err("from 1 to 5 stars") }
    db.exec(sql`update books set stars = ? where id = ?`, stars, id)?
    stars
}
