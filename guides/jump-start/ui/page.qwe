// ui/page.qwe: the frame every page is drawn in.

let page_css = read_file("ui/page.css")         // read once, as the program starts

view Page(title: str, children) {
    style global page_css
    <html lang="en">
        <head>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
            <title>{title}</title>
        </head>
        <body>
            <nav><a href="/">Bookshelf</a> <a href="/admin">Admin</a></nav>
            <main>{children}</main>
        </body>
    </html>
}
