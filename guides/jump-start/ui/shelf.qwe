// ui/shelf.qwe: the parts that run in the browser, and the libraries they call.

preload "https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" use Chart
client "https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"
    use confetti
preconnect "https://unpkg.com/dayjs@1.11.13/dayjs.min.js" use dayjs
import lib/books use rate

component Stars(id: int, stars: int) {
    style css`
      button { border: 0; background: none; font-size: 20px; color: #bbb; cursor: pointer; }
      .on { color: #e8a317; }
    `
    state n = stars
    state saved = null
    <span>
        {for s in range(1, 6) =>
            <button class={s <= n && "on"} title={`${s} of 5`} onclick={() => {
                n = rate(id, s) ?? n
                saved = dayjs().format("HH:mm")
                if s == 5 { confetti({ particleCount: 80 }) }
            }}>★</button>}
        {saved && <small>saved at {saved}</small>}
    </span>
}

component Ratings(counts: list) {
    <canvas height="120" onmount={(el) => {
        let chart = Chart.new(el, {
            type: "bar",
            data: { labels: ["1 ★", "2 ★", "3 ★", "4 ★", "5 ★"], datasets: [{ label: "Books", data: counts }] },
        })
        () => chart.destroy()
    }}></canvas>
}
