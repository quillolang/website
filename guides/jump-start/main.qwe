// main.qwe: the program. Start it with `quillo run main.qwe --watch`.

use lib/books                                   // every public name in lib/books.qwe
import ui/page use Page                         // only Page from ui/page.qwe
import ui/shelf use Stars, Ratings

db.open("books.db")
create_tables()

route GET / {
    let books = all_books()
    <Page title="Bookshelf">
        <h1>My bookshelf</h1>
        <Ratings counts={star_counts(books)}/>
        <ul>
            {for b in books =>
                <li><b>{b.title}</b> by {b.author} <Stars id={b.id} stars={b.stars}/></li>}
        </ul>
        <form method="post" action="/books">
            <input name="title" placeholder="Title" required/>
            <input name="author" placeholder="Author" required/>
            <button>Add</button>
        </form>
    </Page>
}

route POST /books { form: { title: str, author: str } } {
    if trim(title) == "" || trim(author) == "" { reply 400 "A book needs a title and an author" }
    add_book(trim(title), trim(author))
    redirect("/")
}

route GET /login =
    <Page title="Sign in">
        <form method="post" action="/login">
            <input type="password" name="password" placeholder="Password" required/>
            <button>Sign in</button>
        </form>
    </Page>

route POST /login { form: { password: str } } {
    let wanted = env("ADMIN_PASSWORD") ?? reply 503 "Set ADMIN_PASSWORD first"
    if !crypto.equal(password, wanted) { reply 401 "Wrong password" }
    set_session({ admin: true })
    redirect("/admin")
}

fn admin_only(r) = session().admin == true ? r : redirect("/login")

routes /admin | admin_only {
    route GET / =
        <Page title="Admin">
            <h1>Remove books</h1>
            {for b in all_books() =>
                <form method="post" action={`/admin/books/${b.id}/delete`}>
                    {b.title} <button>Delete</button>
                </form>}
        </Page>

    route POST /books/:id(int)/delete {
        remove_book(id)
        redirect("/admin")
    }
}
