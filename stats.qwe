// Views and downloads: how often a page was read and a file taken. A visitor counts once
// an hour per page or file; crawlers, prefetches and HEADs are not views. The totals are
// read once a minute into `st_cache` for the cards and the lists, and fresh from the
// table for the number a page shows (SiteStats).

db.exec("create table if not exists hits (key text, kind text, n integer default 0, primary key (key, kind))")
db.exec("create table if not exists hits_seen (key text, kind text, who text, hour integer, primary key (key, kind, who, hour))")

let ST_BOTS = ["bot", "crawl", "spider", "slurp", "facebookexternalhit", "preview", "headlesschrome", "lighthouse", "pagespeed", "monitor", "python-requests", "go-http-client"]

fn st_who(req: map) = crypto.sha256(`${env("QUILLO_SECRET") ?? "dev"}:${req.ip}:${req.headers["user-agent"] ?? ""}`)

fn st_bot(req: map) {
    let ua = lower(req.headers["user-agent"] ?? "")
    ua == "" || any(ST_BOTS, (b) => contains(ua, b))
}

// One more view of `key` (a page) or download of it (a file), unless this visitor had
// one in the last hour. Now and then the hours gone by are forgotten.
fn st_hit(req: map, kind: str, key: str) {
    if req.method == "HEAD" { return null }
    if kind == "view" && (req.headers["x-quillo-prefetch"] == "1" || st_bot(req)) { return null }
    let hour = floor(now() / 3600000)
    let r = db.exec("insert or ignore into hits_seen (key, kind, who, hour) values (?, ?, ?, ?)", key, kind, st_who(req), hour)
    if r.changes == 0 { return null }
    db.exec("insert into hits (key, kind, n) values (?, ?, 1) on conflict (key, kind) do update set n = n + 1", key, kind)
    if random_int(0, 100) == 0 { db.exec("delete from hits_seen where hour < ?", hour - 24) }
    null
}

fn st_counts() = reduce(db.query("select key, kind, n from hits"), {}, (m, r) => set(m, `${r.kind}:${r.key}`, r.n))

let st_cache = st_counts()
fn st_refresh() { st_cache = st_counts() }
schedule("1m", st_refresh)

// A count as the cards and lists show it, from the totals read a minute ago at most.
fn st_n(kind: str, key: str) = st_cache[`${kind}:${key}`] ?? 0

fn st_fmt(n: int) = n >= 1000000 ? `${round(n / 1000000, 1)}M` : n >= 10000 ? `${round(n / 1000)}k` : n >= 1000 ? `${round(n / 1000, 1)}k` : str(n)

// "1.2k views · 340 downloads", or "" when there is nothing to say yet.
fn st_line(page: str, files: list) {
    let v = st_n("view", page)
    let d = files | map((f) => st_n("download", f)) | sum
    let parts = (v > 0 ? [`${st_fmt(v)} ${v == 1 ? "view" : "views"}`] : []) + (d > 0 ? [`${st_fmt(d)} ${d == 1 ? "download" : "downloads"}`] : [])
    join(parts, " · ")
}

// The fresh numbers for one page: its views, and the downloads of its files.
server fn st_stats(page: str, files: list) {
    let one = (kind, key) => (db.one("select n from hits where key = ? and kind = ?", key, kind) ?? { n: 0 }).n
    { views: one("view", page), downloads: files | map((f) => one("download", f)) | sum }
}

// On a page: how many read it, and took its files.
component SiteStats(page: str, files: list = []) {
    state s = st_stats(page, files)
    <span.st-line aria-label="Views and downloads">
        <span title="Readers, counted once an hour each">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>
            {st_fmt(s.views)}</span>
        {len(files) > 0 && <span title="Downloads of its files, counted once an hour each">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M12 3v12m0 0l-5-5m5 5l5-5M4 21h16"/></svg>
            {st_fmt(s.downloads)}</span>}
    </span>
}
