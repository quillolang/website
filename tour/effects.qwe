fn load_user(id: int) -> map? with db = db.one("select * from users where id = ?", id)
fn fetch_avatar(url: str) -> str with http = http.get(url, {}, { public_only: true }).body

fn profile(id: int) -> map with db, http {
    let [user, orders] = parallel(() => load_user(id), () => load_orders(id))
    { user, orders, avatar: fetch_avatar(user.avatar) }
}
