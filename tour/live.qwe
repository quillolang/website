server fn load_notes() -> list with db = db.query("select * from notes order by id")

server fn add_note(text: str) -> map with db = db.exec("insert into notes (text) values (?)", text)

component Notes() {
    state notes = live(load_notes)  // every open page sees new notes
    <ul>{for n in notes => <li key={n.id}>{n.text}</li>}</ul>
}
