// /acknowledgements/: the people and projects Quillo is built on. The crates come
// from acknowledgements.json, written by tools/acknowledgements.mjs from Quillo's
// Cargo.toml (each crate's authors, licence and repository as cargo reports them,
// and the comment Cargo.toml gives it), so the list follows the code. What this
// site itself uses is written here.

let ACK = json.parse(read_file("acknowledgements.json"))

// What each crate does for Quillo, in a line, where Cargo.toml's comment says none.
let ACK_FOR = {
    "mio": "the event loop: one thread over every connection, with kqueue on macOS and epoll on Linux",
    "libc": "the system's own calls where Rust's library has none: file events, waiting on a slow client",
    "httparse": "reading HTTP requests",
    "corosensei": "a coroutine for each request, with a stack of its own",
    "psm": "switching stacks for those coroutines",
    "stacker": "room on the stack for deep recursion",
    "tokio": "the threads that wait on databases and the network while the loop goes on",
    "tokio-postgres": "PostgreSQL, with queries pipelined on shared connections",
    "postgres": "PostgreSQL from scripts and jobs",
    "tokio-postgres-rustls": "TLS to PostgreSQL",
    "mysql_async": "MySQL and MariaDB for db",
    "rusqlite": "SQLite, bundled, the database a program starts with",
    "rustls": "TLS, in Rust",
    "webpki-roots": "the root certificates browsers trust, for connections Quillo makes",
    "rustls-native-certs": "the operating system's own root certificates, when asked",
    "ureq": "the HTTP client behind http.* and services",
    "indexmap": "maps that keep their keys in the order written",
    "fastrand": "random, random_int and uuid",
    "getrandom": "randomness from the system, for keys and tokens",
    "ctrlc": "stopping cleanly on Ctrl-C and on a signal",
    "libmimalloc-sys": "mimalloc, the allocator on the loop and the waiting threads",
    "sha2": "crypto.sha256 and crypto.hmac",
    "argon2": "crypto.hash_password",
    "flate2": "gzip for text answers",
    "image": "image.info and image.convert",
    "regex": "re, with patterns that match as JavaScript's do",
    "pulldown-cmark": "markdown, CommonMark with tables and task lists",
    "bytes": "buffers shared between the loop and the waiting threads",
    "serde_json": "JSON, read and written exactly",
    "jiff": "dates and time zones, with the IANA database bundled where the system has none",
    "cranelift-codegen": "numeric functions compiled to machine code",
    "cranelift-frontend": "the same: building the code",
    "cranelift-jit": "the same: running it",
    "cranelift-module": "the same: its modules",
    "cranelift-native": "the same: for the machine it runs on",
    "wtransport": "channels and media over WebTransport",
    "wry": "quillo app: the program in a native window",
    "tao": "the window itself",
    "muda": "the macOS menu bar, for copy and paste in the window",
    "rcgen": "certificates for the tests of TLS to databases",
    "libloading": "loading the Rust a program writes in .qwer files",
}

// The web itself: the ideas Quillo is made of, and who had them. Each names the
// people and the body that wrote it down, and where.
let ACK_WEB = [
    { name: "The web, HTTP and URLs", by: "Tim Berners-Lee at CERN, 1989 to 1991; HTTP/1.1 by Roy Fielding, Henrik Frystyk Nielsen and others at the IETF", what: "what a Quillo program speaks: requests, answers, addresses, keep-alive, chunked bodies", at: "IETF RFC 9110 and RFC 3986", url: "https://www.rfc-editor.org/rfc/rfc9110" },
    { name: "HTML", by: "Tim Berners-Lee; the living standard by the WHATWG, Ian Hickson and others", what: "what pages are made of; Quillo's HTML literals are HTML", at: "WHATWG HTML", url: "https://html.spec.whatwg.org/" },
    { name: "CSS", by: "Håkon Wium Lie and Bert Bos, 1994 to 1996; the W3C CSS working group", what: "a component's style, scoped, and the sheets a page gets", at: "W3C CSS", url: "https://www.w3.org/Style/CSS/" },
    { name: "JavaScript", by: "Brendan Eich at Netscape, 1995; ECMAScript by Ecma TC39", what: "what components compile to, and run as in the browser", at: "ECMA-262", url: "https://tc39.es/ecma262/" },
    { name: "JavaScript engines and the DOM", by: "V8 by Lars Bak and the team at Google; SpiderMonkey by Brendan Eich and Mozilla; JavaScriptCore at Apple; the DOM by the W3C and the WHATWG", what: "what runs a component in the browser, and the document it changes", at: "WHATWG DOM", url: "https://dom.spec.whatwg.org/" },
    { name: "JSON", by: "Douglas Crockford, who wrote it down in 2001", what: "every API answer, every call to the server, the island's state", at: "ECMA-404 and RFC 8259", url: "https://www.json.org/" },
    { name: "Cookies", by: "Lou Montulli at Netscape, 1994", what: "sessions, signed", at: "IETF RFC 6265", url: "https://www.rfc-editor.org/rfc/rfc6265" },
    { name: "WebSockets", by: "Ian Hickson at the WHATWG; Ian Fette and Alexey Melnikov at the IETF", what: "live data and --watch reloads reaching open pages", at: "IETF RFC 6455", url: "https://www.rfc-editor.org/rfc/rfc6455" },
    { name: "Server-sent events", by: "Ian Hickson at the WHATWG", what: "events(), a stream of updates a page listens to", at: "WHATWG HTML, section 9.2", url: "https://html.spec.whatwg.org/multipage/server-sent-events.html" },
    { name: "QUIC, HTTP/3 and WebTransport", by: "Jim Roskind at Google, then the IETF QUIC working group; WebTransport by Victor Vasiliev and the W3C", what: "channels and media over datagrams and streams", at: "IETF RFC 9000 and RFC 9114; W3C WebTransport", url: "https://www.w3.org/TR/webtransport/" },
    { name: "TLS", by: "SSL by Taher Elgamal and Kipp Hickman at Netscape; TLS by Tim Dierks, Christopher Allen and Eric Rescorla at the IETF", what: "every connection Quillo makes to a database or another server", at: "IETF RFC 8446", url: "https://www.rfc-editor.org/rfc/rfc8446" },
    { name: "SQL", by: "Donald D. Chamberlin and Raymond F. Boyce at IBM, 1974", what: "what db.query and the rest speak", at: "ISO/IEC 9075", url: "https://en.wikipedia.org/wiki/SQL" },
    { name: "TCP and UDP", by: "Vint Cerf and Bob Kahn, 1974; UDP by David P. Reed, 1980", what: "the server's connections, and udp.listen and udp.send", at: "IETF RFC 9293 and RFC 768", url: "https://www.rfc-editor.org/rfc/rfc768" },
    { name: "Unicode and UTF-8", by: "Joe Becker, Lee Collins and Mark Davis for Unicode; UTF-8 by Ken Thompson and Rob Pike, 1992", what: "every string, counted in characters", at: "The Unicode Standard; IETF RFC 3629", url: "https://home.unicode.org/" },
    { name: "DEFLATE and gzip", by: "Phil Katz; gzip and zlib by Jean-loup Gailly and Mark Adler", what: "text answers, compressed", at: "IETF RFC 1951 and RFC 1952", url: "https://www.rfc-editor.org/rfc/rfc1952" },
    { name: "SHA-2 and HMAC", by: "SHA-2 by the NSA, published by NIST; HMAC by Mihir Bellare, Ran Canetti and Hugo Krawczyk, 1996", what: "crypto.sha256, crypto.hmac, and the signatures on sessions and calls between services", at: "FIPS 180-4; IETF RFC 2104", url: "https://www.rfc-editor.org/rfc/rfc2104" },
    { name: "Argon2", by: "Alex Biryukov, Daniel Dinu and Dmitry Khovratovich, 2015, winner of the Password Hashing Competition", what: "crypto.hash_password", at: "IETF RFC 9106", url: "https://www.rfc-editor.org/rfc/rfc9106" },
    { name: "Regular expressions", by: "Stephen Cole Kleene, 1951; in software by Ken Thompson, 1968; JavaScript's dialect by Ecma TC39", what: "re.test and the rest, the same on the server and in the browser", at: "ECMA-262, RegExp", url: "https://tc39.es/ecma262/#sec-regexp-regular-expression-objects" },
    { name: "Markdown", by: "John Gruber with Aaron Swartz, 2004; CommonMark by John MacFarlane and others, 2014", what: "markdown(), and the docs you are reading", at: "CommonMark", url: "https://commonmark.org/" },
    { name: "cron", by: "Ken Thompson in Version 7 Unix, 1979; the five fields as most know them by Paul Vixie, 1987", what: "schedule(\"@daily\", ...) and the fields it reads", at: "Vixie cron's crontab(5)", url: "https://man7.org/linux/man-pages/man5/crontab.5.html" },
    { name: "kqueue, epoll and inotify", by: "kqueue by Jonathan Lemon for FreeBSD, 2000; epoll by Davide Libenzi for Linux, 2002; inotify by John McCutchan, 2005", what: "the event loop over every connection, and the watcher told of a saved file", at: "FreeBSD and Linux manual pages", url: "https://man7.org/linux/man-pages/man7/epoll.7.html" },
    { name: "Source maps", by: "John Lenz at Google and Nick Fitzgerald at Mozilla, the version 3 proposal, 2011", what: "a breakpoint in a .qwe file, set from the browser or an editor", at: "The Source Map specification, now at TC39", url: "https://tc39.es/ecma426/" },
    { name: "The Language Server and Debug Adapter Protocols", by: "Microsoft, with Red Hat and Codenvy, 2016", what: "quillo lsp and quillo dap: completion, diagnostics, breakpoints and stepping in any editor", at: "LSP and DAP specifications", url: "https://microsoft.github.io/language-server-protocol/" },
    { name: "OpenAPI", by: "Tony Tam, as Swagger, 2011; the OpenAPI Initiative under the Linux Foundation", what: "quillo docs and --describe: a program's API, written down", at: "OpenAPI 3", url: "https://www.openapis.org/" },
    { name: "JSX", by: "Jordan Walke and the React team at Facebook, 2013", what: "the shape of Quillo's HTML literals: markup in code, expressions in braces", at: "The JSX specification", url: "https://facebook.github.io/jsx/" },
    { name: "Islands", by: "Katie Sylor-Miller, who named them, and Jason Miller, who wrote them up, 2019 to 2020", what: "how a page is served whole and its components wake where they stand", at: "Jason Miller's essay", url: "https://jasonformat.com/islands-architecture/" },
]

// Ideas in the language: how a route, a group, a pattern or a pipeline is written in
// Quillo, and who wrote it that way first. Each names the people and where to read it.
let ACK_IDEAS = [
    { name: "A route as a line of the program", by: "Sinatra, by Blake Mizerany, 2007: get '/hi' do ... end", what: "route GET /hi = ..., the method and the path as syntax, the body as the answer", url: "https://sinatrarb.com/" },
    { name: "Typed path parameters", by: "Ruby on Rails, by David Heinemeier Hansson, 2004, with constraints on a segment; Sinatra's :name", what: ":id(int) in a route, converted and refused before the body runs", url: "https://guides.rubyonrails.org/routing.html" },
    { name: "Request patterns", by: "Pattern matching in function heads, from Erlang by Joe Armstrong, Robert Virding and Mike Williams, and Elixir by José Valim; Phoenix's router and Plug, by Chris McCord", what: "{ query, form, json, headers } after a route's path: the request's shape decides which route answers, and binds its names", url: "https://hexdocs.pm/phoenix/routing.html" },
    { name: "Middleware as a chain the request passes through", by: "Rack, by Christian Neukirchen, 2007; Connect and Express, by TJ Holowaychuk, 2010", what: "request | auth.required | ..., and a group's | signed_in | admins: each stage gives the request back or answers in the route's place", url: "https://expressjs.com/en/guide/using-middleware.html" },
    { name: "Route groups with a prefix, middleware and a host", by: "Laravel, by Taylor Otwell, 2011: Route::prefix()->middleware()->group() and Route::domain()", what: "routes /admin | signed_in { ... } and routes /api { headers: { host: ... } } { ... }, nested", url: "https://laravel.com/docs/routing#route-groups" },
    { name: "Ending the request from anywhere", by: "Sinatra's halt; Rails' render ... and return", what: "reply 404 { error: ... } in a helper, a pipeline stage or a ?? fallback", url: "https://sinatrarb.com/intro.html" },
    { name: "Pipelines", by: "Unix pipes, by Doug McIlroy, 1973; the |> of F#, by Don Syme, and of Elixir, by José Valim", what: "xs | map(f) | filter(g): the value on the left goes in as the first argument", url: "https://elixir-lang.org/getting-started/enumerables-and-streams.html#the-pipe-operator" },
    { name: "Errors as values, passed on with ?", by: "Rust's ? and Result, by the Rust Project, 2016; Go's errors as values, by Rob Pike, Robert Griesemer and Ken Thompson", what: "err(...), is_err, and ? after a call that returns the error from the function it is in", url: "https://doc.rust-lang.org/book/ch09-02-recoverable-errors-with-result.html" },
    { name: "Fine-grained reactivity", by: "SolidJS, by Ryan Carniato, 2018; Svelte 5's runes, by Rich Harris; Knockout's observables, by Steve Sanderson, 2010", what: "state, and the lets, views and elements that follow what they read, each updated on its own", url: "https://www.solidjs.com/guides/reactivity" },
    { name: "Effects a function declares", by: "Koka's effect types, by Daan Leijen, 2014; Unison's abilities", what: "fn load(id) with db = ...: what a function may do besides compute, checked where it is called", url: "https://koka-lang.github.io/koka/doc/book.html#sec-effect-types" },
    { name: "Records with defaults, checked at the edges", by: "TypeScript, by Anders Hejlsberg and Microsoft, 2012; Zod, by Colin McDonnell, 2020; pydantic, by Samuel Colvin, 2017", what: "type User = { ... } and User(request.json): the shape of the data said once, checked on the way in", url: "https://zod.dev/" },
    { name: "Calling the server like a function", by: "Meteor's methods, by the Meteor Development Group, 2012; Server Functions in React and Next.js, by Meta and Vercel", what: "server fn, called from a component as if it were local, awaited by the compiler", url: "https://react.dev/reference/rsc/server-functions" },
]

// The projects behind the crates, and the ones this site uses, with who made them.
let ACK_FOUNDATIONS = [
    { name: "Rust", by: "the Rust Project and its contributors", what: "the language Quillo is written in, and the compiler and cargo that build it", url: "https://www.rust-lang.org/", license: "MIT OR Apache-2.0" },
    { name: "SQLite", by: "D. Richard Hipp and the SQLite team", what: "the database a Quillo program starts with, bundled in every build", url: "https://sqlite.org/", license: "Public domain" },
    { name: "PostgreSQL", by: "the PostgreSQL Global Development Group", what: "the database for programs that outgrow one machine", url: "https://www.postgresql.org/", license: "PostgreSQL License" },
    { name: "MySQL and MariaDB", by: "Oracle, and the MariaDB Foundation", what: "the other databases `db` speaks to", url: "https://mariadb.org/", license: "GPL-2.0" },
    { name: "mimalloc", by: "Daan Leijen and Microsoft Research", what: "the allocator on Quillo's loop and waiting threads", url: "https://github.com/microsoft/mimalloc", license: "MIT" },
    { name: "Cranelift", by: "the Bytecode Alliance", what: "the code generator behind compiled numbers", url: "https://cranelift.dev/", license: "Apache-2.0 WITH LLVM-exception" },
    { name: "CommonMark", by: "John MacFarlane and the CommonMark group", what: "the Markdown `markdown` reads", url: "https://commonmark.org/", license: "CC-BY-SA 4.0" },
    { name: "The IANA time zone database", by: "Paul Eggert and its contributors", what: "every time zone `date` knows", url: "https://www.iana.org/time-zones", license: "Public domain" },
    { name: "Chromium", by: "the Chromium authors", what: "the browser Quillo's tests and this site's checks drive, headless", url: "https://www.chromium.org/", license: "BSD-3-Clause" },
    { name: "Node.js", by: "the OpenJS Foundation and its contributors", what: "the tools beside Quillo: the reference's harness, the repros' runner", url: "https://nodejs.org/", license: "MIT" },
]

let ACK_SITE = [
    { name: "Instrument Serif", by: "Rodrigo Fuenzalida and Jordan Egstad", what: "the headings", url: "https://github.com/Instrument/instrument-serif", license: "OFL-1.1" },
    { name: "Inter", by: "Rasmus Andersson", what: "the text", url: "https://rsms.me/inter/", license: "OFL-1.1" },
    { name: "JetBrains Mono", by: "JetBrains", what: "the code", url: "https://www.jetbrains.com/lp/mono/", license: "OFL-1.1" },
    { name: "Leaflet", by: "Volodymyr Agafonkin and contributors", what: "the map in the MapView component, loaded on its page", url: "https://leafletjs.com/", license: "BSD-2-Clause" },
    { name: "OpenStreetMap", by: "the OpenStreetMap contributors", what: "the map tiles MapView shows", url: "https://www.openstreetmap.org/copyright", license: "ODbL" },
    { name: "cdnjs", by: "Cloudflare and the cdnjs community", what: "where that page fetches Leaflet from", url: "https://cdnjs.com/", license: "MIT" },
    { name: "GitHub", by: "GitHub, Inc.", what: "where Quillo, the components, the plugins and this site are kept, and sign-in for comments and samples", url: "https://github.com/quillolang", license: "" },
]

// Authors as cargo lists them, without email addresses.
fn ack_people(authors: list) = authors | map((a) => trim(re.replace(a, "\\s*<[^>]*>", ""))) | filter((a) => a != "") | join(", ")

fn ack_repo(c: map) = starts_with(c.repository, "http") ? c.repository : `https://crates.io/crates/${c.name}`

view AckWebRow(w: map) =
    <tr>
        <td><a href={w.url}>{w.name}</a></td>
        <td>{w.by}</td>
        <td>{w.what}</td>
        <td>{w.at}</td>
    </tr>

view AckRow(name: str, by: str, what: str, url: str, license: str) =
    <tr>
        <td><a href={url}>{name}</a></td>
        <td>{by}</td>
        <td>{what}</td>
        <td><code>{license}</code></td>
    </tr>

route GET /acknowledgements {
    let crates = ACK.crates | filter((c) => c.kind != "dev")
    let dev = ACK.crates | filter((c) => c.kind == "dev")
    <SitePage title="Acknowledgements" path="/acknowledgements/" label="Acknowledgements" href="/acknowledgements/"
              description="The people and projects Quillo is built on: the Rust crates inside it, with their authors and licences, the databases and tools beside it, and what this site uses.">
        <div.prose>
            <p.kicker>Thanks</p>
            <h1>What Quillo is built on</h1>
            <p.lede>Quillo is one binary, but not one piece of work. It speaks the web's protocols and formats, which people
                thought of and wrote down over fifty years; the way its routes, groups, patterns and pipelines are written
                was seen in other languages and frameworks first; inside it are {len(crates)} Rust crates, each written and kept by people
                who share it; around it, databases, a code generator, a browser and a runtime for its tools; and on this site,
                fonts and a map. This page names them. The list of crates is made from Quillo's own <code>Cargo.toml</code>,
                so it follows the code.</p>

            <h2 id="web">The web itself</h2>
            <p>Before any crate, the ideas: the protocols, formats and standards Quillo speaks, and the people who
                thought of them and wrote them down.</p>
            <table.ack.ack-web>
                <thead><tr><th>Idea</th><th>By</th><th>In Quillo</th><th>Written down at</th></tr></thead>
                <tbody>{for w in ACK_WEB => <AckWebRow w={w}/>}</tbody>
            </table>

            <h2 id="ideas">Ideas, and where they were seen before</h2>
            <p>How a route, a group, a pattern or a pipeline is written in Quillo did not start here. Each line names the
                people who wrote it that way first, and where to read it.</p>
            <table.ack.ack-web>
                <thead><tr><th>In Quillo</th><th>Seen before in</th><th>What it looks like here</th></tr></thead>
                <tbody>{for i in ACK_IDEAS =>
                    <tr><td><a href={i.url}>{i.name}</a></td><td>{i.by}</td><td>{i.what}</td></tr>}</tbody>
            </table>

            <h2 id="foundations">Foundations</h2>
            <table.ack>
                <thead><tr><th>Project</th><th>By</th><th>What it does for Quillo</th><th>Licence</th></tr></thead>
                <tbody>{for f in ACK_FOUNDATIONS => <AckRow name={f.name} by={f.by} what={f.what} url={f.url} license={f.license}/>}</tbody>
            </table>

            <h2 id="crates">Inside Quillo {ACK.quillo}</h2>
            <p>Every crate Quillo depends on directly, as <code>cargo metadata</code> reports it. The crates these bring in turn,
                a few hundred, are listed in Quillo's <code>Cargo.lock</code>.</p>
            <table.ack>
                <thead><tr><th>Crate</th><th>By</th><th>What it does for Quillo</th><th>Licence</th></tr></thead>
                <tbody>{for c in crates =>
                    <AckRow name={`${c.name} ${c.version}`} by={ack_people(c.authors)} what={ACK_FOR[c.name] ?? c.note ?? c.description} url={ack_repo(c)} license={c.license}/>}</tbody>
            </table>
            {len(dev) > 0 && [
                <p>And for the tests only:</p>,
                <table.ack>
                    <thead><tr><th>Crate</th><th>By</th><th>What it does</th><th>Licence</th></tr></thead>
                    <tbody>{for c in dev =>
                        <AckRow name={`${c.name} ${c.version}`} by={ack_people(c.authors)} what={ACK_FOR[c.name] ?? c.note ?? c.description} url={ack_repo(c)} license={c.license}/>}</tbody>
                </table>
            ]}

            <h2 id="site">On this site</h2>
            <table.ack>
                <thead><tr><th>Project</th><th>By</th><th>Where</th><th>Licence</th></tr></thead>
                <tbody>{for s in ACK_SITE => <AckRow name={s.name} by={s.by} what={s.what} url={s.url} license={s.license}/>}</tbody>
            </table>

            <p>Quillo itself is MIT licensed. If you made something here and want it named differently, or something is missing,
                say so on <a href={DISCORD}>Discord</a> or in an issue on <a href={REPO}>GitHub</a>.</p>
        </div>
    </SitePage>
}
