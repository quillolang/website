// /acknowledgements/: the people and projects Quillo is built on. The crates come
// from acknowledgements.json, written by tools/acknowledgements.mjs from Quillo's
// Cargo.toml (each crate's authors, licence and repository as cargo reports them,
// and the comment Cargo.toml gives it), so the list follows the code. What this
// site itself uses is written here.

let ACK = json.parse(read_file("acknowledgements.json"))

// What each crate does for Quillo, in a line, where Cargo.toml's comment says none.
let ACK_FOR = {
    "mio": "the event loop: one thread over every connection, with kqueue on macOS and epoll on Linux",
    "libc": "the system's own calls where Rust's library has none: file events, waiting on a slow client",
    "httparse": "reading HTTP requests",
    "corosensei": "a coroutine for each request, with a stack of its own",
    "psm": "switching stacks for those coroutines",
    "stacker": "room on the stack for deep recursion",
    "tokio": "the threads that wait on databases and the network while the loop goes on",
    "tokio-postgres": "PostgreSQL, with queries pipelined on shared connections",
    "postgres": "PostgreSQL from scripts and jobs",
    "tokio-postgres-rustls": "TLS to PostgreSQL",
    "mysql_async": "MySQL and MariaDB for db",
    "rusqlite": "SQLite, bundled, the database a program starts with",
    "rustls": "TLS, in Rust",
    "webpki-roots": "the root certificates browsers trust, for connections Quillo makes",
    "rustls-native-certs": "the operating system's own root certificates, when asked",
    "ureq": "the HTTP client behind http.* and services",
    "indexmap": "maps that keep their keys in the order written",
    "fastrand": "random, random_int and uuid",
    "getrandom": "randomness from the system, for keys and tokens",
    "ctrlc": "stopping cleanly on Ctrl-C and on a signal",
    "libmimalloc-sys": "mimalloc, the allocator on the loop and the waiting threads",
    "sha2": "crypto.sha256 and crypto.hmac",
    "argon2": "crypto.hash_password",
    "flate2": "gzip for text answers",
    "image": "image.info and image.convert",
    "regex": "re, with patterns that match as JavaScript's do",
    "pulldown-cmark": "markdown, CommonMark with tables and task lists",
    "bytes": "buffers shared between the loop and the waiting threads",
    "serde_json": "JSON, read and written exactly",
    "jiff": "dates and time zones, with the IANA database bundled where the system has none",
    "cranelift-codegen": "numeric functions compiled to machine code",
    "cranelift-frontend": "the same: building the code",
    "cranelift-jit": "the same: running it",
    "cranelift-module": "the same: its modules",
    "cranelift-native": "the same: for the machine it runs on",
    "wtransport": "channels and media over WebTransport",
    "wry": "quillo app: the program in a native window",
    "tao": "the window itself",
    "muda": "the macOS menu bar, for copy and paste in the window",
    "rcgen": "certificates for the tests of TLS to databases",
    "libloading": "loading the Rust a program writes in .qwer files",
}

// The projects behind the crates, and the ones this site uses, with who made them.
let ACK_FOUNDATIONS = [
    { name: "Rust", by: "the Rust Project and its contributors", what: "the language Quillo is written in, and the compiler and cargo that build it", url: "https://www.rust-lang.org/", license: "MIT OR Apache-2.0" },
    { name: "SQLite", by: "D. Richard Hipp and the SQLite team", what: "the database a Quillo program starts with, bundled in every build", url: "https://sqlite.org/", license: "Public domain" },
    { name: "PostgreSQL", by: "the PostgreSQL Global Development Group", what: "the database for programs that outgrow one machine", url: "https://www.postgresql.org/", license: "PostgreSQL License" },
    { name: "MySQL and MariaDB", by: "Oracle, and the MariaDB Foundation", what: "the other databases `db` speaks to", url: "https://mariadb.org/", license: "GPL-2.0" },
    { name: "mimalloc", by: "Daan Leijen and Microsoft Research", what: "the allocator on Quillo's loop and waiting threads", url: "https://github.com/microsoft/mimalloc", license: "MIT" },
    { name: "Cranelift", by: "the Bytecode Alliance", what: "the code generator behind compiled numbers", url: "https://cranelift.dev/", license: "Apache-2.0 WITH LLVM-exception" },
    { name: "CommonMark", by: "John MacFarlane and the CommonMark group", what: "the Markdown `markdown` reads", url: "https://commonmark.org/", license: "CC-BY-SA 4.0" },
    { name: "The IANA time zone database", by: "Paul Eggert and its contributors", what: "every time zone `date` knows", url: "https://www.iana.org/time-zones", license: "Public domain" },
    { name: "Chromium", by: "the Chromium authors", what: "the browser Quillo's tests and this site's checks drive, headless", url: "https://www.chromium.org/", license: "BSD-3-Clause" },
    { name: "Node.js", by: "the OpenJS Foundation and its contributors", what: "the tools beside Quillo: the reference's harness, the repros' runner", url: "https://nodejs.org/", license: "MIT" },
]

let ACK_SITE = [
    { name: "Instrument Serif", by: "Rodrigo Fuenzalida and Jordan Egstad", what: "the headings", url: "https://github.com/Instrument/instrument-serif", license: "OFL-1.1" },
    { name: "Inter", by: "Rasmus Andersson", what: "the text", url: "https://rsms.me/inter/", license: "OFL-1.1" },
    { name: "JetBrains Mono", by: "JetBrains", what: "the code", url: "https://www.jetbrains.com/lp/mono/", license: "OFL-1.1" },
    { name: "Leaflet", by: "Volodymyr Agafonkin and contributors", what: "the map in the MapView component, loaded on its page", url: "https://leafletjs.com/", license: "BSD-2-Clause" },
    { name: "OpenStreetMap", by: "the OpenStreetMap contributors", what: "the map tiles MapView shows", url: "https://www.openstreetmap.org/copyright", license: "ODbL" },
    { name: "cdnjs", by: "Cloudflare and the cdnjs community", what: "where that page fetches Leaflet from", url: "https://cdnjs.com/", license: "MIT" },
    { name: "GitHub", by: "GitHub, Inc.", what: "where Quillo, the components, the plugins and this site are kept, and sign-in for comments and samples", url: "https://github.com/quillolang", license: "" },
]

// Authors as cargo lists them, without email addresses.
fn ack_people(authors: list) = authors | map((a) => trim(re.replace(a, "\\s*<[^>]*>", ""))) | filter((a) => a != "") | join(", ")

fn ack_repo(c: map) = starts_with(c.repository, "http") ? c.repository : `https://crates.io/crates/${c.name}`

view AckRow(name: str, by: str, what: str, url: str, license: str) =
    <tr>
        <td><a href={url}>{name}</a></td>
        <td>{by}</td>
        <td>{what}</td>
        <td><code>{license}</code></td>
    </tr>

route GET /acknowledgements {
    let crates = ACK.crates | filter((c) => c.kind != "dev")
    let dev = ACK.crates | filter((c) => c.kind == "dev")
    <SitePage title="Acknowledgements" path="/acknowledgements/" label="Acknowledgements" href="/acknowledgements/"
              description="The people and projects Quillo is built on: the Rust crates inside it, with their authors and licences, the databases and tools beside it, and what this site uses.">
        <div.prose>
            <p.kicker>Thanks</p>
            <h1>What Quillo is built on</h1>
            <p.lede>Quillo is one binary, but not one piece of work. Inside it are {len(crates)} Rust crates, each written and kept by
                people who share it; around it, databases, a code generator, a browser and a runtime for its tools; and on this
                site, fonts and a map. This page names them. The list of crates is made from Quillo's own <code>Cargo.toml</code>,
                so it follows the code.</p>

            <h2 id="foundations">Foundations</h2>
            <table.ack>
                <thead><tr><th>Project</th><th>By</th><th>What it does for Quillo</th><th>Licence</th></tr></thead>
                <tbody>{for f in ACK_FOUNDATIONS => <AckRow name={f.name} by={f.by} what={f.what} url={f.url} license={f.license}/>}</tbody>
            </table>

            <h2 id="crates">Inside Quillo {ACK.quillo}</h2>
            <p>Every crate Quillo depends on directly, as <code>cargo metadata</code> reports it. The crates these bring in turn,
                a few hundred, are listed in Quillo's <code>Cargo.lock</code>.</p>
            <table.ack>
                <thead><tr><th>Crate</th><th>By</th><th>What it does for Quillo</th><th>Licence</th></tr></thead>
                <tbody>{for c in crates =>
                    <AckRow name={`${c.name} ${c.version}`} by={ack_people(c.authors)} what={ACK_FOR[c.name] ?? c.note ?? c.description} url={ack_repo(c)} license={c.license}/>}</tbody>
            </table>
            {len(dev) > 0 && [
                <p>And for the tests only:</p>,
                <table.ack>
                    <thead><tr><th>Crate</th><th>By</th><th>What it does</th><th>Licence</th></tr></thead>
                    <tbody>{for c in dev =>
                        <AckRow name={`${c.name} ${c.version}`} by={ack_people(c.authors)} what={ACK_FOR[c.name] ?? c.note ?? c.description} url={ack_repo(c)} license={c.license}/>}</tbody>
                </table>
            ]}

            <h2 id="site">On this site</h2>
            <table.ack>
                <thead><tr><th>Project</th><th>By</th><th>Where</th><th>Licence</th></tr></thead>
                <tbody>{for s in ACK_SITE => <AckRow name={s.name} by={s.by} what={s.what} url={s.url} license={s.license}/>}</tbody>
            </table>

            <p>Quillo itself is MIT licensed. If you made something here and want it named differently, or something is missing,
                say so on <a href={DISCORD}>Discord</a> or in an issue on <a href={REPO}>GitHub</a>.</p>
        </div>
    </SitePage>
}
