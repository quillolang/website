// The playground at /play/: write a Quillo program in the browser, run it in a sandbox on
// this server, and see its pages beside the code; signed in with GitHub, save it to come back
// to it, or share its link (/play/<id>/). Anyone may run; saving needs an account.
//
// The sandboxes are play/runner's (`quillo-play`): each Run starts the program in one of 20
// slots, sNN.play.quillolang.org, with no network, its own user and a few minutes to live. The
// site asks the runner at PLAY_URL (http://127.0.0.1:4311) with PLAY_SECRET, both from
// site.env; without them the page still edits and saves, and says running is off here.
// The editor is play/editor's bundle, public/play/editor.mjs (CodeMirror 6), taken as a module,
// so nothing goes on `window`.

client module /play/editor.mjs use createEditor

db.exec("create table if not exists play_projects (id text primary key, user_id integer not null, title text not null, files text not null, forked_from text, created integer, updated integer)")
db.exec("create index if not exists play_projects_user on play_projects (user_id, updated)")

let PLAY_URL = trim(env("PLAY_URL") ?? "")
let PLAY_SECRET = trim(env("PLAY_SECRET") ?? "")
let PLAY_ON = PLAY_URL != "" && PLAY_SECRET != ""
let PLAY_MAX_FILES = 30
let PLAY_MAX_BYTES = 256 * 1024
let PLAY_MAX_PROJECTS = 50
let PLAY_MAX_TITLE = 80
// Bytes, as stored (UTF-8 JSON, measured by SQLite): one program's files with their names and
// escapes, and all of one account's programs (review M7: characters had been counted).
let PLAY_MAX_ROW = 320 * 1024
let PLAY_MAX_USER = 8 * 1024 * 1024
// A file's name: letters, digits, `_`, `.` and `-`, in at most two folders (folder/folder/file),
// at most 200 characters; no part starts with a dot (no `..`, no `.quillo/`). The runner's rules
// (play/runner/src/files.rs), so a program that saves is one that runs.
let PLAY_NAME = "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*){0,2}$"

fn play_example(slug: str, name: str, note: str) =
    { slug: slug, name: name, note: note, files: { "main.qwe": read_file(`play/examples/${slug}/main.qwe`) } }

let PLAY_EXAMPLES = [
    play_example("hello", "Hello", "A page, a component that counts, and a second route"),
    play_example("todo", "To-do", "State, a list made from it, and handlers"),
    play_example("notes", "Live notes", "SQLite and live data: open the preview in two tabs"),
    play_example("basics", "Basics", "let, maps, lists, conditions, match, for, while and pipes, printed"),
    play_example("empty", "Empty", "Just the language: no page or server, what it prints shows in Output"),
]

// Whether quillo said it serves no routes: a program that only computes and prints, with
// nothing for the preview to show (without a route, not even public/ files are served).
fn play_pageless(lines: list) -> bool = any(lines, (l) => starts_with(l, "quillo: 0 routes listening on "))

// What is wrong with a program's files, or null: the runner's limits, so a save is one that runs.
fn play_wrong(files) -> str? {
    if type_of(files) != "map" { return "the files are not a map of names to text" }
    let names = keys(files)
    if !has(files, "main.qwe") { return "a program needs a main.qwe" }
    if len(names) > PLAY_MAX_FILES { return `at most ${PLAY_MAX_FILES} files` }
    if len(unique(names | map((n) => lower(n)))) != len(names) { return "two files have the same name but for capitals" }
    let total = 0
    for n in names {
        if !re.test(n, PLAY_NAME) || len(n) > 200 { return `not a file name here: ${n}` }
        if n == "app.sock" { return "app.sock is where the program listens: give the file another name" }
        if any(names, (m) => starts_with(m, n + "/")) { return `${n} is a file and a folder` }
        let text = files[n]
        if type_of(text) != "str" { return `${n} is not text` }
        if contains(text, "\u{0}") { return `${n} is not text` }
        total += len(text) + len(n)
    }
    if total > PLAY_MAX_BYTES { return "at most 256 KB of code in all" }
    null
}

// The UTF-8 bytes of a program's code, as the runner counts them (len counts characters).
fn play_bytes(files) -> int = db.one("select length(cast(? as blob)) as n", join(values(files), "")).n

// The runner's answer to one request, or an error value that says why not.
fn play_ask(method: str, path: str, body) {
    if !PLAY_ON { return err("running is off on this server") }
    let r = http.request(method, PLAY_URL + path, body, { authorization: `Bearer ${PLAY_SECRET}` }, { timeout: 20, redirects: 0, public_only: false })
    if is_err(r) { return err("the sandbox is not answering; try again in a minute") }
    if !r.ok {
        let said = r.json == null ? null : r.json.error
        return err(said ?? `the sandbox answered ${r.status}`)
    }
    r.json
}

// ---- running ----------------------------------------------------------------------------

// Starts the program: { session, host, enter, log, next, running, exit }, or { error }.
// One sandbox at a time for each visitor (by account, else by address): a second Run ends the first.
server fn play_run(files: map) {
    let wrong = play_wrong(files)
    if wrong != null { return { error: wrong } }
    if play_bytes(files) > PLAY_MAX_BYTES { return { error: "at most 256 KB of code in all" } }
    let u = cm_me_row()
    if u != null && u.banned == 1 { return { error: "this account cannot run programs here" } }
    let client = u != null ? `u${u.id}` : `ip:${request.ip}`
    let r = play_ask("POST", "/run", { files: files, client: client })
    is_err(r) ? { error: error(r) } : r
}

// What the program printed since line `after`: { lines: [{ n, text }], next, running, exit }.
// `gone` when the runner has no such session (it ended); `retry` when the runner did not answer
// (a restart, a slow moment): the session may well be running still (review L5).
server fn play_log(session: str, after: int = 0) {
    let gone = { lines: [], next: after, running: false, exit: null, gone: true }
    if !re.test(session, "^[0-9a-f]{32}$") || !PLAY_ON { return gone }
    let r = http.request("GET", `${PLAY_URL}/log?session=${session}&after=${after}`, null, { authorization: `Bearer ${PLAY_SECRET}` }, { timeout: 10, redirects: 0, public_only: false })
    if is_err(r) || r.status >= 500 { return { lines: [], next: after, running: true, exit: null, retry: true } }
    r.ok ? r.json : gone
}

server fn play_stop(session: str) {
    if re.test(session, "^[0-9a-f]{32}$") { play_ask("POST", "/stop", { session: session }) }
    null
}

// ---- saving -----------------------------------------------------------------------------

// Saves over `id` when it is the visitor's; else (no id, or someone else's program) makes a
// new one, noting what it was copied from. { id, created } or { error, signin }.
server fn play_save(id: str, title: str, files: map) {
    let u = cm_me_row()
    if u == null { return { error: "sign in with GitHub to save", signin: true } }
    if u.banned == 1 { return { error: "this account cannot save here" } }
    let wrong = play_wrong(files)
    if wrong != null { return { error: wrong } }
    if play_bytes(files) > PLAY_MAX_BYTES { return { error: "at most 256 KB of code in all" } }
    let name = trim(title) == "" ? "Untitled" : slice(trim(title), 0, PLAY_MAX_TITLE)
    let text = json.stringify(files)
    let size = db.one("select length(cast(? as blob)) as n", text).n
    if size > PLAY_MAX_ROW { return { error: "with its file names and escapes, a program is at most 320 KB as saved" } }
    let t = now()
    // Each write is one statement that holds the limits itself (the count, the account's bytes,
    // one save a second), so they hold however many saves come at once, from any instance.
    if id != "" && db.one("select id from play_projects where id = ? and user_id = ?", id, u.id) != null {
        let r = db.exec("update play_projects set title = ?, files = ?, updated = ? where id = ? and user_id = ? and (select coalesce(max(updated), 0) from play_projects where user_id = ?) <= ? and (select coalesce(sum(length(cast(files as blob))), 0) from play_projects where user_id = ? and id != ?) + ? <= ?",
            name, text, t, id, u.id, u.id, t - 1000, u.id, id, size, PLAY_MAX_USER)
        if r.changes > 0 { return { id: id, created: false, updated: t } }
        return { error: play_save_refusal(u.id, size, id) }
    }
    let from = id == "" ? null : db.one("select id from play_projects where id = ?", id)
    let new_id = crypto.token(9)
    let r = db.exec("insert into play_projects (id, user_id, title, files, forked_from, created, updated) select ?, ?, ?, ?, ?, ?, ? where (select count(*) from play_projects where user_id = ?) < ? and (select coalesce(sum(length(cast(files as blob))), 0) from play_projects where user_id = ?) + ? <= ? and (select coalesce(max(updated), 0) from play_projects where user_id = ?) <= ?",
        new_id, u.id, name, text, from == null ? null : from.id, t, t, u.id, PLAY_MAX_PROJECTS, u.id, size, PLAY_MAX_USER, u.id, t - 1000)
    if r.changes == 0 { return { error: play_save_refusal(u.id, size, "") } }
    { id: new_id, created: true, updated: t }
}

// Why a save was refused, in words, once it has been (the write itself held the limits).
fn play_save_refusal(uid: int, size: int, id: str) -> str {
    let n = db.one("select count(*) as n, coalesce(sum(length(cast(files as blob))), 0) as bytes, coalesce(max(updated), 0) as last from play_projects where user_id = ? and id != ?", uid, id)
    if id == "" && n.n >= PLAY_MAX_PROJECTS { return `you have ${PLAY_MAX_PROJECTS} saved programs, the most there can be: delete one first` }
    if n.bytes + size > PLAY_MAX_USER { return "your saved programs are 8 MB in all, the most there can be: delete one first" }
    "saved a moment ago: try again in a second"
}

// The visitor's saved programs, newest first: [{ id, title, updated }].
server fn play_mine() {
    let u = cm_me_row()
    if u == null { return [] }
    db.query("select id, title, updated from play_projects where user_id = ? order by updated desc", u.id)
}

server fn play_delete(id: str) {
    let u = cm_me_row()
    if u == null { return false }
    db.exec("delete from play_projects where id = ? and user_id = ?", id, u.id).changes > 0
}

// ---- the page ---------------------------------------------------------------------------

// main.qwe first, then the rest by name.
fn play_order(names: list) -> list = ["main.qwe"] + (names | filter((n) => n != "main.qwe") | sort)

// The file panel's rows: each folder once, before its files, and each file under it, with its
// depth for the indent. Folders are only those the files' names have (no empty ones).
fn play_tree(names: list) -> list {
    let rows = []
    let seen = []
    for n in play_order(names) {
        let parts = split(n, "/")
        let i = 0
        while i < len(parts) - 1 {
            let dir = join(take(parts, i + 1), "/")
            if !contains(seen, dir) {
                seen = seen + [dir]
                rows = rows + [{ kind: "dir", path: dir, name: parts[i], depth: i }]
            }
            i += 1
        }
        rows = rows + [{ kind: "file", path: n, name: last(parts), depth: len(parts) - 1 }]
    }
    rows
}

// A line of the program's output that names a place in its files: { file, line, severity, message }.
fn play_problem(text: str) {
    let m = re.find(text, "^(?:/work/|\\./)?([A-Za-z0-9_./-]+\\.qwe):([0-9]+): (error|warning): (.*)$")
    m == null ? null : { file: m.groups[0], line: int(m.groups[1]), severity: m.groups[2], message: m.groups[3] }
}

// The page's own part, in the browser. `ed` is the editor (play/editor's createEditor), which
// holds every file's text; `names` is the list the file panel shows. A run is `session`, polled
// for output by one loop at a time: `gen` counts runs and stops, and a loop of an older one ends.
component Playground(project, examples: list, runner: bool) {
    let start = project != null ? project.files : examples[0].files
    state ed = null
    state names = play_order(keys(start))
    state open = "main.qwe"
    state title = project != null ? project.title : ""
    state pid = project != null ? project.id : ""
    state author = project != null ? project.author : ""
    state base = project != null ? project.updated : 0
    state me = null
    state me_known = false
    state session = ""
    state host = ""
    state preview = ""
    state lines = []
    state next = 0
    state running = false
    state exit_code = null
    state gen = 0
    state misses = 0
    state tab = "preview"
    state pages = true
    state note = ""
    state starting = false
    state cancelled = false
    state saving = false
    state dirty = false
    state draft_due = false
    state draft_failed = false
    state mine = null
    state log_el = null
    state menu_el = null
    state restored = false
    let problems = lines | map((l) => play_problem(l)) | filter((p) => p != null)
    let errors = problems | filter((p) => p.severity == "error") | len
    let own = pid != "" && me != null && me.login == author
    let draft_key = pid == "" ? "quillo-play-draft" : `quillo-play-draft:${pid}`

    // The browser's draft of unsaved work: written a moment after the last edit, with the saved
    // version it was made from (`base`), so a draft older than what was saved since, from
    // another browser, is not brought back over it. A browser that keeps nothing still edits.
    fn keep_draft() {
        draft_due = false
        if ed == null || !dirty { return null }
        let text = `{"title":${json.stringify(title)},"base":${base},"files":${ed.filesJson()}}`
        let put = js("localStorage.setItem", draft_key, text)
        if is_err(put) && !draft_failed {
            draft_failed = true
            note = "This browser keeps no drafts (storage full or off): save to keep your work"
        }
        null
    }
    fn later_draft() {
        if !draft_due {
            draft_due = true
            run_after(800, keep_draft)
        }
    }
    fn drop_draft() { js("localStorage.removeItem", draft_key) ?? null }

    fn show(files) {
        ed.reset()
        names = play_order(keys(files))
        for n in names { ed.open(n, files[n]) }
        open = "main.qwe"
        ed.open("main.qwe", files["main.qwe"])
    }

    fn mark() {
        let by = {}
        for p in problems { by = set(by, p.file, (get(by, p.file) ?? []) + [{ line: p.line, severity: p.severity, message: p.message }]) }
        if ed != null { ed.diagnostics(by) }
    }

    fn follow() {
        if log_el != null { log_el.scrollTop = log_el.scrollHeight }
    }

    // The output kept: at most 2,000 lines and 256 K characters, the newest (review L6).
    fn keep_lines(all: list) -> list {
        let kept = len(all) > 2000 ? drop(all, len(all) - 2000) : all
        let size = sum(kept | map((l) => len(l) + 1))
        let cut = 0
        while size > 262144 && cut < len(kept) - 1 {
            size -= len(kept[cut]) + 1
            cut += 1
        }
        cut == 0 ? kept : drop(kept, cut)
    }

    // One loop a run: `g` is the run it belongs to. A hidden tab does not poll (so its sandbox
    // ends after the runner's idle time); it looks again every 1.5 s.
    fn poll(g: int) {
        if g != gen || session == "" { return null }
        if ed != null && !ed.visible() {
            run_after(1500, () => poll(g))
            return null
        }
        let s = session
        let r = play_log(s, next)
        if g != gen || s != session { return null }
        if is_err(r) || r.retry == true {
            misses += 1
            if misses > 20 {
                note = "Lost touch with the sandbox: press Run to start again"
                running = false
                return null
            }
            run_after(2000, () => poll(g))
            return null
        }
        misses = 0
        if len(r.lines) > 0 {
            let got = r.lines | map((l) => l.text)
            lines = keep_lines(lines + got)
            mark()
            // said after /run answered: a program with no routes shows its output instead
            if pages && play_pageless(got) {
                pages = false
                if tab == "preview" { tab = "output" }
            }
            run_after(0, follow)
        }
        next = r.next
        running = r.running
        exit_code = r.exit
        if r.gone == true {
            running = false
            preview = ""
            session = ""
        }
        if running { run_after(700, () => poll(g)) }
        null
    }

    // A run that fails to start leaves the one still going (and its loop) as they were; one
    // that starts takes over, and the old loop ends (`gen`). Stop meanwhile cancels it.
    fn run() {
        if ed == null || starting || !runner { return null }
        starting = true
        cancelled = false
        note = ""
        let r = play_run(json.parse(ed.filesJson()))
        starting = false
        if cancelled {
            if !is_err(r) && r.session != null { play_stop(r.session) }
            return null
        }
        if is_err(r) {
            note = `Could not run it: ${error(r)}`
            return null
        }
        if r.error != null {
            note = r.error
            return null
        }
        gen += 1
        let g = gen
        session = r.session
        host = r.host
        preview = r.enter
        lines = keep_lines(r.log | map((l) => l.text))
        pages = !play_pageless(r.log | map((l) => l.text))
        next = r.next
        running = r.running
        exit_code = r.exit
        misses = 0
        mark()
        if !running || errors > 0 || !pages { tab = "output" } else { tab = "preview" }
        if running { run_after(700, () => poll(g)) }
        null
    }

    fn stop() {
        gen += 1
        if starting { cancelled = true }
        if session != "" { play_stop(session) }
        session = ""
        running = false
        preview = ""
    }

    fn save() {
        if ed == null || saving { return null }
        if !me_known {
            me = cm_me() ?? null
            me_known = true
        }
        if me == null {
            keep_draft()
            js("location.assign", `/auth/github?next=${url_encode(pid == "" ? "/play/" : `/play/${pid}/`)}`)
            return null
        }
        saving = true
        let r = play_save(pid, title, json.parse(ed.filesJson()))
        saving = false
        if is_err(r) {
            note = `Not saved: ${error(r)}`
            return null
        }
        if r.error != null {
            if r.signin == true { me = null }
            note = r.error
            return null
        }
        drop_draft()
        restored = false
        if r.id != pid {
            pid = r.id
            author = me.login
            js("history.replaceState", null, "", `/play/${r.id}/`) ?? null
        }
        base = r.updated
        dirty = false
        note = r.created ? "Saved: its link is in the address bar" : "Saved"
        mine = null
        run_after(4000, () => { if note == "Saved" || starts_with(note, "Saved:") { note = "" } })
        null
    }

    fn load_example(ex) {
        if menu_el != null { menu_el.open = false }
        if dirty && !(js("confirm", `Replace what is in the editor with the ${ex.name} example?`) ?? true) { return null }
        drop_draft()
        show(ex.files)
        title = ex.name
        pid = ""
        author = ""
        base = 0
        dirty = false
        restored = false
        js("history.replaceState", null, "", "/play/") ?? null
        null
    }

    fn add_file() {
        let n = js("prompt", "A new file's name, e.g. lib/tasks.qwe", "lib/helpers.qwe") ?? null
        if n == null || trim(n) == "" { return null }
        let name = trim(n)
        if !re.test(name, PLAY_NAME) || len(name) > 200 || name == "app.sock" {
            note = `Not a file name here: ${name} (letters, digits, _ . - and at most two folders)`
            return null
        }
        if contains(names, name) {
            ed.open(name, "")
            open = name
            return null
        }
        if len(names) >= PLAY_MAX_FILES {
            note = `At most ${PLAY_MAX_FILES} files`
            return null
        }
        let wrong = play_wrong(set(json.parse(ed.filesJson()), name, ""))
        if wrong != null {
            note = wrong
            return null
        }
        names = play_order(names + [name])
        ed.open(name, `// ${name}: what this file holds.\n`)
        open = name
        dirty = true
        later_draft()
        null
    }

    fn rename_file(n: str) {
        if n == "main.qwe" { return null }
        let asked = js("prompt", `Rename ${n} to`, n) ?? null
        if asked == null || trim(asked) == "" || trim(asked) == n { return null }
        let to = trim(asked)
        if !re.test(to, PLAY_NAME) || len(to) > 200 || to == "app.sock" {
            note = `Not a file name here: ${to} (letters, digits, _ . - and at most two folders)`
            return null
        }
        if contains(names, to) {
            note = `There is a ${to} already`
            return null
        }
        let files = json.parse(ed.filesJson())
        let wrong = play_wrong(set(remove(files, n), to, files[n]))
        if wrong != null {
            note = wrong
            return null
        }
        ed.rename(n, to)
        names = play_order((names | filter((x) => x != n)) + [to])
        if open == n { open = to }
        dirty = true
        later_draft()
        null
    }

    fn remove_file(n: str) {
        if n == "main.qwe" { return null }
        if !(js("confirm", `Delete ${n}?`) ?? false) { return null }
        ed.remove(n)
        names = names | filter((x) => x != n)
        if open == n {
            open = "main.qwe"
            ed.open("main.qwe", "")
        }
        dirty = true
        later_draft()
        null
    }

    fn pick(n: str) {
        open = n
        ed.open(n, "")
    }

    fn list_mine() {
        mine = mine == null ? play_mine() : null
    }

    fn forget(id: str) {
        if !(js("confirm", "Delete this saved program? Its link stops working.") ?? false) { return null }
        play_delete(id)
        mine = play_mine()
        if id == pid {
            pid = ""
            author = ""
            base = 0
            js("history.replaceState", null, "", "/play/") ?? null
        }
        null
    }

    <div.play>
        <div.play-bar>
            <input.play-title bind:value={title} placeholder="Untitled" maxlength="80" aria-label="Title" @input={() => { dirty = true; later_draft() }}/>
            <button.play-run onclick={run} disabled={!runner || starting} title="Ctrl+Enter">{starting ? "Starting…" : running ? "Run again" : "Run"}</button>
            {(running || starting) && <button onclick={stop}>Stop</button>}
            <button onclick={save} disabled={saving} title="Ctrl+S">{saving ? "Saving…" : me_known && me == null ? "Sign in to save" : own || pid == "" ? "Save" : "Save a copy"}</button>
            <details.play-menu @mount={(el) => { menu_el = el }}>
                <summary>Examples</summary>
                <div.play-sheet>{for ex in examples =>
                    <button onclick={() => load_example(ex)}><strong>{ex.name}</strong><span>{ex.note}</span></button>
                }</div>
            </details>
            {me != null && <button onclick={list_mine}>My programs</button>}
            <span.play-note role="status">{note}</span>
        </div>
        {mine != null && <div.play-mine>
            {len(mine) == 0 ? <p>Nothing saved yet.</p> : <ul>{for p in mine =>
                <li key={p.id}><a href={`/play/${p.id}/`}>{p.title}</a>
                    <button.play-x aria-label={`Delete ${p.title}`} onclick={() => forget(p.id)}>×</button></li>
            }</ul>}
        </div>}
        // Someone else's program: its pages run in this browser, under play.quillolang.org, and
        // can set cookies there (review M1, kept by the user's choice of subdomain).
        {author != "" && !own && <p.play-author>
            By <a href={`https://github.com/${author}`}>@{author}</a>. Its pages run in your browser when you press Run:
            run programs from people you trust.</p>}
        {restored && <p.play-restored>Your unsaved changes in this browser are back.
            <button onclick={() => { drop_draft(); restored = false; show(start); title = project != null ? project.title : ""; dirty = false }}>Discard them</button></p>}
        <div.play-main>
            <section.play-code aria-label="Code">
                <nav.play-files aria-label="Files">
                    <div.play-files-head><span>Files</span>
                        <button.play-add onclick={add_file} title="New file (a name with a folder, lib/x.qwe, makes the folder)" aria-label="New file">+</button></div>
                    <ul>{for r in play_tree(names) =>
                        r.kind == "dir"
                            ? <li key={`d:${r.path}`} class="play-dir" style={`--depth: ${r.depth}`}>{r.name}/</li>
                            : <li key={r.path} class={r.path == open ? "play-file on" : "play-file"} style={`--depth: ${r.depth}`}>
                                <button onclick={() => pick(r.path)} aria-current={r.path == open ? "true" : "false"} title={r.path}>{r.name}</button>
                                {r.path != "main.qwe" && <span.play-file-acts>
                                    <button.play-x aria-label={`Rename ${r.path}`} title="Rename" onclick={() => rename_file(r.path)}>✎</button>
                                    <button.play-x aria-label={`Delete ${r.path}`} title="Delete" onclick={() => remove_file(r.path)}>×</button>
                                </span>}
                              </li>
                    }</ul>
                </nav>
                <div.play-edit-col>
                <div.play-path>{open}</div>
                <div.play-editor @mount={(el) => {
                    let made = createEditor(el, {})
                    if is_err(made) {
                        note = `The editor did not load: ${error(made)}. Reload the page to try again.`
                        return null
                    }
                    ed = made
                    // A draft is brought back only if it was made from the version saved now.
                    let saved = json.parse(js("localStorage.getItem", draft_key) ?? "null") ?? null
                    let usable = saved != null && type_of(saved) == "map" && (saved.base ?? -1) == base && play_wrong(saved.files ?? null) == null
                    let files = usable ? saved.files : start
                    if saved != null && !usable { drop_draft() }
                    names = play_order(keys(files))
                    for n in names { ed.open(n, files[n]) }
                    ed.open("main.qwe", files["main.qwe"])
                    if usable {
                        restored = true
                        dirty = true
                        title = saved.title ?? title
                    }
                    ed.onChange((n) => {
                        dirty = true
                        later_draft()
                    })
                    ed.onKey((what) => { if what == "save" { save() } else { run() } })
                    ed.onHide((why) => keep_draft())
                    me = cm_me() ?? null
                    me_known = true
                    () => {
                        stop()
                        ed.destroy()
                    }
                }}></div>
                </div>
            </section>
            <section.play-out aria-label="What the program shows">
                <div.play-tabs role="tablist">
                    <span class={tab == "preview" ? "play-tab on" : "play-tab"}><button role="tab" aria-selected={tab == "preview"} onclick={() => { tab = "preview" }}>Preview</button></span>
                    <span class={tab == "output" ? "play-tab on" : "play-tab"}><button role="tab" aria-selected={tab == "output"} onclick={() => { tab = "output"; run_after(0, follow) }}>
                        Output{errors > 0 && <b.play-errs>{errors}</b>}</button></span>
                    {host != "" && running && pages && <a.play-open href={`https://${host}/`} target="_blank" rel="noopener">Open in a tab ↗</a>}
                </div>
                <div class={tab == "preview" ? "play-pane" : "play-pane play-hidden"}>
                    {preview != "" && pages
                        ? <iframe.play-frame src={preview} title="The program's page"
                              sandbox="allow-scripts allow-forms allow-same-origin allow-modals allow-popups allow-downloads"></iframe>
                        : <div.play-empty>
                            {!runner
                                ? <p>Running programs is off on this server. The editor still works, and so does saving.</p>
                                : starting ? <p>Starting the program…</p>
                                : !pages && session != "" ? <p>This program has no pages (no <code>route</code>), so nothing shows here: what it prints is in <strong>Output</strong>.</p>
                                : session == "" && len(lines) > 0 ? <p>The program has stopped. Press <strong>Run</strong> to start it again.</p>
                                : <p>Press <strong>Run</strong> (Ctrl+Enter) to start the program in a sandbox: its pages show here.
                                    It runs for up to ten minutes, with no network, and stops a few minutes after you leave.</p>}
                        </div>}
                </div>
                <div class={tab == "output" ? "play-pane" : "play-pane play-hidden"}>
                    <pre.play-log @mount={(el) => { log_el = el }}>{len(lines) == 0 ? "What the program prints shows here." : join(lines, "\n")}{exit_code != null && `\n\n(the program stopped, exit code ${exit_code})`}</pre>
                </div>
            </section>
        </div>
        <p.play-foot>Ctrl+Enter runs, Ctrl+S saves. Programs run on Quillo {QUILLO_VERSION}: see the <a href="/docs/">docs</a> and the <a href="/docs/language-tour/">language tour</a>.
            If quillolang.org stops loading after you ran a program, clear this site's cookies in your browser's settings.</p>
    </div>
}

fn play_page(project, path: str) =
    <SitePage title={project == null ? "Playground" : `${project.title} · Playground`} path={path} label="Playground" href="/play/" wide={true}
              description="Write a Quillo program in the browser and run it in a sandbox: its pages show beside the code. Sign in with GitHub to save it and share its link."
              noindex={project != null}>
        <style>{play_style}</style>
        <Playground project={project} examples={PLAY_EXAMPLES} runner={PLAY_ON}/>
    </SitePage>

// The editor's bundle (play/editor, `npm run build`); a module script, so it must be served as JavaScript.
// No `cache`: the browser asks each time (a 304 when unchanged), so a deploy's page never runs an
// hour-old editor (review L8).
route GET /play/editor.mjs = file("public/play/editor.mjs")

route GET /play = play_page(null, "/play/")

route GET /play/:id {
    if !re.test(id, "^[A-Za-z0-9_-]{1,24}$") { return not_found(request.path) }
    // A banned account's programs are gone with it, as its posts are.
    let p = db.one("select p.id, p.title, p.files, p.updated, u.login from play_projects p join users u on u.id = p.user_id where p.id = ? and u.banned = 0", id)
    if p == null { return not_found(request.path) }
    play_page({ id: p.id, title: p.title, files: json.parse(p.files), updated: p.updated, author: p.login }, `/play/${p.id}/`)
}

let play_style = read_file("play/play.css")
