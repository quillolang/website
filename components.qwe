// /components/: Quillo UI, the kit of components to download, from a checkout of
// quillolang/components linked at content/components (see link.sh). Each one gets
// a page with its demo running, its example and its source; export.sh copies the
// files themselves (quillo-ui.qwe, ui/*.qwe and a zip of the kit) into dist/.

use "content/components/quillo-ui.qwe"
use "content/components/demos.qwe"

let KIT_REPO = "https://github.com/quillolang/components"
let KIT_GROUPS = ["Layout", "Actions", "Forms", "Feedback", "Overlays", "Navigation", "Data"]
let kit_style = read_file("components.css")

let kit_items = KIT_GROUPS | map((g) => ui_gallery | filter((c) => c.group == g) | sort_by((c) => c.name)) | flatten

fn kit_group(g: str) = kit_items | filter((c) => c.group == g)

// The demo's code without the line that adds it to the gallery.
fn kit_example(slug: str) {
    let text = read_file(`content/components/demos/${slug}.qwe`)
    let at = index_of(text, "ui_gallery = ui_gallery")
    trim(at == null ? text : slice(text, 0, at))
}

// A light or dark backdrop for the demo, which the page itself is not. A view,
// so the demo's own components inside it are resumed as they are in any page;
// the button is wired by kit_stage_script.
view KitStage(children) =
    <div.kit-stage.ui-dark>
        <div.kit-stage-bar>
            <span>Preview</span>
            <button type="button" data-kit-theme aria-pressed="true">Light</button>
        </div>
        <div.kit-stage-body>{children}</div>
    </div>

let kit_stage_script = `document.addEventListener("click", function (e) {
  var c = e.target.closest && e.target.closest("[data-kit-copy]");
  if (c) {
    var lines = c.closest(".snippet").querySelectorAll(".ln");
    var text = Array.prototype.map.call(lines, function (l) { return l.textContent; }).join("\\n");
    var say = function (t) { c.textContent = t; clearTimeout(c._t); c._t = setTimeout(function () { c.textContent = "Copy"; }, 1600); };
    navigator.clipboard.writeText(text).then(function () { say("Copied"); }, function () { say("Copy failed"); });
    return;
  }
  var b = e.target.closest && e.target.closest("[data-kit-theme]");
  if (!b) return;
  var s = b.closest(".kit-stage"), dark = s.classList.toggle("ui-dark");
  s.classList.toggle("ui-light", !dark);
  b.textContent = dark ? "Light" : "Dark";
  b.setAttribute("aria-pressed", dark ? "true" : "false");
});`

// Puts the sidebar back where it was scrolled on the last page, before it is
// drawn, and the current component in view if it is not; runs right after it.
let kit_side_script = `(function () {
  var s = document.querySelector(".kit .sidebar"), k = "quillo-kit-side";
  if (!s) return;
  try { var y = sessionStorage.getItem(k); if (y !== null) s.scrollTop = +y; } catch (e) {}
  var a = s.querySelector("a.active");
  if (a) {
    var r = a.getBoundingClientRect(), b = s.getBoundingClientRect();
    if (r.top < b.top || r.bottom > b.bottom) s.scrollTop += r.top - b.top - (b.height - r.height) / 2;
  }
  addEventListener("pagehide", function () { try { sessionStorage.setItem(k, s.scrollTop); } catch (e) {} });
})();`

view KitSide(current: str) =
    <aside.sidebar aria-label="Components">
        <div.side-group class={current == "" && "current"}>
            <p>Quillo UI</p>
            <ul><li><a href="/components/" class={current == "" && "active"}
                       aria-current={current == "" ? "page" : null}>All {len(kit_items)} components</a></li></ul>
        </div>
        {for g in KIT_GROUPS =>
            <div.side-group class={any(kit_group(g), (c) => c.slug == current) && "current"}>
                <p>{g}</p>
                <ul>{for c in kit_group(g) =>
                    <li><a href={`/components/${c.slug}/`} class={c.slug == current && "active"}
                           aria-current={c.slug == current ? "page" : null}>{c.name}</a></li>}</ul>
            </div>}
    </aside>

view KitPage(title: str, path: str, description: str, current: str, children) =
    <html lang="en">
        <Head title={title} path={path} css={style + docs_style + ui_css + demo_css + kit_style}
            description={description} fonts={["instrument-serif", "inter", "jetbrains-mono"]}/>
        <body.docs-body>
            <header.nav>
                <div.nav-left>
                    <a.brand href="/"><Logo/>Quillo</a>
                    <a.docs-label href="/components/">Components</a>
                </div>
                <nav><a.nav-extra href="/docs/">Docs</a><Stars/><a.gh href={KIT_REPO}>GitHub</a></nav>
            </header>
            <div.docs.kit>
                <input type="checkbox" id="docs-menu" hidden/>
                <label.menu-button for="docs-menu">Components</label>
                <KitSide current={current}/>
                <script>{raw(kit_side_script)}</script>
                <main.kit-main>{children}</main>
            </div>
            <script>{raw(kit_stage_script)}</script>
        </body>
    </html>

// A block of code with a Copy button (wired by kit_stage_script), which copies
// its lines as they are written.
view KitSnippet(file: str? = null, text: str, lang: str = "quillo") =
    <div.snippet.kit-snippet class={lang == "shell" && "terminal"}>
        {file != null && <div.file>{file}</div>}
        <button.kit-copy type="button" data-kit-copy aria-label={file != null ? `Copy ${file}` : "Copy the command"}>Copy</button>
        <Code lines={lang == "shell" ? shell(split(text, "\n")).lines : highlight(text)}/>
    </div>

fn kit_index() =
    <KitPage title={`Quillo UI · ${len(kit_items)} components to download`} path="/components/" current=""
             description={`${len(kit_items)} UI components for Quillo, each one .qwe file to download or clone: forms, sign-in, date pickers, dialogs, editable and virtual tables, charts and more.`}>
        <div.prose>
        <p.kicker>Quillo UI</p>
        <h1>{len(kit_items)} components, one file each</h1>
        <p.lede>Buttons, forms, sign-in, date pickers, dialogs, editable and virtual tables, charts and more, each one <code>.qwe</code> file
            to copy into your program. They bring their styles, follow the system's light or dark theme,
            and work with the keyboard and screen readers. Most are views that add no JavaScript;
            the rest run in the browser as components.</p>
        </div>
        <div.kit-get>
            <a.kit-dl href="/components/quillo-ui.qwe" download>
                <b>quillo-ui.qwe</b><span>The whole kit in one file</span></a>
            <a.kit-dl href="/components/quillo-ui.zip" download>
                <b>quillo-ui.zip</b><span>Every file, the gallery and its tests</span></a>
            <a.kit-dl href={KIT_REPO}>
                <b>quillolang/components</b><span>Clone it, or add it as a submodule</span></a>
        </div>
        <div.prose>
        <h2 id="use">Use the whole kit</h2>
        <KitSnippet lang="shell" text="curl -O https://quillolang.org/components/quillo-ui.qwe"/>
        <KitSnippet file="main.qwe" text={`use "quillo-ui.qwe"

route GET / =
    <html>
        <head><style>{ui_css}</style></head>
        <body class="ui-root">
            <Button href="/start">Get started</Button>
        </body>
    </html>`}/>
        <h2 id="pick">Or only what you use</h2>
        <p>Each component is its own file, and every one needs <code>theme.qwe</code>. Put
            <code>theme_css</code> first in the style, then each component's <code>_css</code>.
            <code>use</code> paths count from the folder of the program's main file.</p>
        <KitSnippet lang="shell" text={`mkdir -p ui && cd ui
curl -O https://quillolang.org/components/ui/theme.qwe
curl -O https://quillolang.org/components/ui/modal.qwe`}/>
        <KitSnippet file="main.qwe" text={`use "ui/theme.qwe"
use "ui/modal.qwe"

let styles = theme_css + modal_css`}/>
        <h2 id="git">With git</h2>
        <KitSnippet lang="shell" text={`git submodule add ${KIT_REPO} vendor/quillo-ui
git submodule update --remote vendor/quillo-ui      # later, for the newest`}/>
        <KitSnippet file="main.qwe" text={`use "vendor/quillo-ui/quillo-ui.qwe"`}/>
        <h2 id="theme">Make it yours</h2>
        <p>Every colour, font and radius is a CSS variable from <code>theme.qwe</code>. Set them
            again after the kit's styles; <code>class="ui-dark"</code> or <code>class="ui-light"</code>
            on any element fixes the theme inside it.</p>
        <KitSnippet file="style.css" text=":root { --ui-accent: #0a7d55; --ui-radius: 4px; --ui-font: \"IBM Plex Sans\", sans-serif; }"/>
        {for g in KIT_GROUPS =>
            <div>
                <h2 id={lower(g)}>{g}</h2>
                <div.cards>{for c in kit_group(g) =>
                    <a.card href={`/components/${c.slug}/`}><b>{c.name}</b><span>{c.summary}</span>
                        <code>{c.slug}.qwe</code></a>}</div>
            </div>}
        </div>
    </KitPage>

fn kit_page(slug: str) {
    let c = find(kit_items, (x) => x.slug == slug) ?? reply 404 "No such component"
    let i = index_of(kit_items | map((x) => x.slug), slug)
    let prev = i > 0 ? kit_items[i - 1] : null
    let next = kit_items[i + 1]
    let source = read_file(`content/components/ui/${slug}.qwe`)
    <KitPage title={`${c.name} · Quillo UI`} path={`/components/${slug}/`} current={slug}
             description={`${c.name}, a Quillo UI component: ${c.summary}`}>
        <div.prose>
            <p.kicker>{c.group}</p>
            <h1>{c.name}</h1>
            <p.lede>{c.summary}</p>
        </div>
        <h2.visually-hidden id="demo">Demo</h2>
        <KitStage>{c.demo()}</KitStage>
        <div.kit-actions>
            <a.kit-btn href={`/components/ui/${slug}.qwe`} download>Download {slug}.qwe</a>
            <a.kit-btn.kit-btn-quiet href="/components/ui/theme.qwe" download>theme.qwe</a>
            <a.kit-btn.kit-btn-quiet href={`${KIT_REPO}/blob/main/ui/${slug}.qwe`}>On GitHub</a>
        </div>
        <div.prose>
        <h2 id="get">Get it</h2>
        <p>It needs <code>theme.qwe</code>, as every component does; or take the whole kit,
            <a href="/components/quillo-ui.qwe" download><code>quillo-ui.qwe</code></a>.</p>
        <KitSnippet lang="shell" text={`curl -O https://quillolang.org/components/ui/theme.qwe
curl -O https://quillolang.org/components/ui/${slug}.qwe`}/>
        <KitSnippet file="main.qwe" text={`use "ui/theme.qwe"
use "ui/${slug}.qwe"

let styles = theme_css + ${slug}_css     // in the page: <style>{styles}</style>`}/>
        <h2 id="example">Example</h2>
        <p>The code of the preview above.</p>
        <KitSnippet file={`demos/${slug}.qwe`} text={kit_example(slug)}/>
        <h2 id="source">Source</h2>
        <KitSnippet file={`ui/${slug}.qwe`} text={source}/>
        <nav.pager>
            {prev ? <a.prev href={`/components/${prev.slug}/`}><small>Previous</small>{prev.name}</a> : <span></span>}
            {next ? <a.next href={`/components/${next.slug}/`}><small>Next</small>{next.name}</a> : <span></span>}
        </nav>
        </div>
    </KitPage>
}

// The files, for `quillo run`; export.sh copies them into dist/ as they are.
route GET /components/quillo-ui.qwe = file("content/components/quillo-ui.qwe")
route GET /components/ui/:name = file(`content/components/ui/${name}`)
route GET /components = kit_index()
route GET /components/:slug = kit_page(slug)
