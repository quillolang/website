// /components/: Quillo UI, the kit of components to download, from a checkout of
// quillolang/components linked at content/components (see link.sh). Each one gets
// a page with its demo running, its example and its source; export.sh copies the
// files themselves (quillo-ui.qwe, ui/*.qwe and a zip of the kit) into dist/.
//
// The index finds components as one types, by group and by tags (several tags keep
// what has them all), and keeps the filters in the address (?q=, ?group=, ?tag=a,b),
// so a search can be shared. Each tag has a page of its own (/components/tags/<tag>/),
// which works without JavaScript and is in the sitemap.

use "content/components/quillo-ui.qwe"
use "content/components/demos.qwe"

let KIT_REPO = "https://github.com/quillolang/components"
let KIT_GROUPS = ["Layout", "Typography", "Actions", "Forms", "Feedback", "Overlays", "Navigation", "Data",
                  "Charts", "Media", "Commerce", "Finance", "News", "Travel", "Blogging", "Marketing", "Dashboard", "Social", "Scheduling", "Utilities"]
// Tags shown before "All tags" is opened.
let KIT_TOP_TAGS = 28
let kit_style = read_file("components.css")
// What a program pays for the components it holds: scripts/bench.mjs in the kit.
let kit_bench = json.parse(read_file("content/components/bench.json") ?? "null")

let kit_items = KIT_GROUPS | map((g) => ui_gallery | filter((c) => c.group == g) | sort_by((c) => c.name)) | flatten

fn kit_group(g: str) = kit_items | filter((c) => c.group == g)

fn kit_groups_used() = KIT_GROUPS | filter((g) => len(kit_group(g)) > 0)

// Every tag with how many components have it: the most used first, then by name.
fn kit_tags() {
    let all_tags = kit_items | map((c) => c.tags ?? []) | flatten
    all_tags | unique | sort | map((t) => { tag: t, n: len(all_tags | filter((x) => x == t)) }) | sort_by((t) => -t.n)
}

fn kit_tagged(tag: str) = kit_items | filter((c) => contains(c.tags ?? [], tag))

// The components most like this one: the most tags in common, the same group first.
fn kit_related(c) {
    let mine = c.tags ?? []
    let score = (x) => len((x.tags ?? []) | filter((t) => contains(mine, t) && t != "no-js" && t != "interactive"))
        + (x.group == c.group ? 1 : 0)
    kit_items | filter((x) => x.slug != c.slug && score(x) > 1) | sort_by((x) => -score(x)) | take(6)
}

// The demo's code without the line that adds it to the gallery.
fn kit_example(slug: str) {
    let text = read_file(`content/components/demos/${slug}.qwe`)
    let at = index_of(text, "ui_gallery = ui_gallery")
    trim(at == null ? text : slice(text, 0, at))
}

// A light or dark backdrop for the demo, which the page itself is not. A view,
// so the demo's own components inside it are resumed as they are in any page;
// the button is wired by kit_stage_script.
view KitStage(children) =
    <div.kit-stage.ui-dark>
        <div.kit-stage-bar>
            <span>Preview</span>
            <button type="button" data-kit-theme aria-pressed="true">Light</button>
        </div>
        <div.kit-stage-body>{children}</div>
    </div>

let kit_stage_script = `document.addEventListener("click", function (e) {
  var c = e.target.closest && e.target.closest("[data-kit-copy]");
  if (c) {
    var lines = c.closest(".snippet").querySelectorAll(".ln");
    var text = Array.prototype.map.call(lines, function (l) { return l.textContent; }).join("\\n");
    var say = function (t) { c.textContent = t; clearTimeout(c._t); c._t = setTimeout(function () { c.textContent = "Copy"; }, 1600); };
    navigator.clipboard.writeText(text).then(function () { say("Copied"); }, function () { say("Copy failed"); });
    return;
  }
  var b = e.target.closest && e.target.closest("[data-kit-theme]");
  if (!b) return;
  var s = b.closest(".kit-stage"), dark = s.classList.toggle("ui-dark");
  s.classList.toggle("ui-light", !dark);
  b.textContent = dark ? "Light" : "Dark";
  b.setAttribute("aria-pressed", dark ? "true" : "false");
});`

// The sidebar: puts it back where it was scrolled on the last page, before it is
// drawn, and the current component in view if it is not; filters its links as one
// types, opening the groups that have matches. Runs right after it.
let kit_side_script = `(function () {
  var s = document.querySelector(".kit .sidebar"), k = "quillo-kit-side";
  if (!s) return;
  try { var y = sessionStorage.getItem(k); if (y !== null) s.scrollTop = +y; } catch (e) {}
  var a = s.querySelector("a.active");
  if (a) {
    var r = a.getBoundingClientRect(), b = s.getBoundingClientRect();
    if (r.top < b.top || r.bottom > b.bottom) s.scrollTop += r.top - b.top - (b.height - r.height) / 2;
  }
  addEventListener("pagehide", function () { try { sessionStorage.setItem(k, s.scrollTop); } catch (e) {} });
  var q = document.getElementById("kit-side-q"), groups = [].slice.call(s.querySelectorAll("details.kit-side-group"));
  var was = groups.map(function (g) { return g.open; }), none = document.getElementById("kit-side-none");
  q.hidden = false;
  q.addEventListener("input", function () {
    var words = q.value.toLowerCase().split(/\\s+/).filter(Boolean), any = false;
    groups.forEach(function (g, i) {
      var n = 0;
      [].forEach.call(g.querySelectorAll("li"), function (li) {
        var hay = li.dataset.find, ok = words.every(function (w) { return hay.indexOf(w) >= 0; });
        li.hidden = !ok; if (ok) n++;
      });
      g.hidden = words.length > 0 && n === 0;
      g.open = words.length ? n > 0 : was[i];
      if (n) any = true;
    });
    none.hidden = any || !words.length;
  });
  q.addEventListener("keydown", function (e) {
    if (e.key === "Escape") { q.value = ""; q.dispatchEvent(new Event("input")); }
    if (e.key === "Enter") { var f = s.querySelector("li:not([hidden]) a"); if (f) location.href = f.href; }
  });
})();`

// The index's search and filters: hides the cards that do not match, counts what
// is left for every chip, and keeps the address in step (?q=, ?group=, ?tag=a,b).
let kit_browse_script = `(function () {
  var root = document.querySelector("[data-kit-browse]");
  if (!root) return;
  var box = document.getElementById("kit-q"), cards = [].slice.call(document.querySelectorAll("[data-kit-item]"));
  var blocks = [].slice.call(document.querySelectorAll("[data-kit-block]"));
  var tagChips = [].slice.call(root.querySelectorAll("[data-kit-tag]")), groupChips = [].slice.call(root.querySelectorAll("[data-kit-group]"));
  var count = document.getElementById("kit-count"), none = document.getElementById("kit-none");
  var clear = document.getElementById("kit-clear"), more = document.getElementById("kit-more-tags");
  function read() {
    var p = new URLSearchParams(location.search);
    return { q: p.get("q") || "", group: p.get("group") || "", tags: (p.get("tag") || "").split(",").filter(Boolean) };
  }
  var state = read();
  var data = cards.map(function (el) {
    return { el: el, group: el.dataset.group, tags: el.dataset.tags ? el.dataset.tags.split(" ") : [],
             hay: (el.dataset.name + " " + el.dataset.slug + " " + el.dataset.summary + " " + el.dataset.group + " " + el.dataset.tags).toLowerCase() };
  });
  function matches(d, skipTag) {
    var words = state.q.toLowerCase().split(/\\s+/).filter(Boolean);
    if (state.group && d.group !== state.group) return false;
    for (var i = 0; i < words.length; i++) if (d.hay.indexOf(words[i]) < 0) return false;
    for (var j = 0; j < state.tags.length; j++) if (state.tags[j] !== skipTag && d.tags.indexOf(state.tags[j]) < 0) return false;
    return true;
  }
  function apply(push) {
    var n = 0;
    data.forEach(function (d) { var ok = matches(d); d.el.hidden = !ok; if (ok) n++; });
    blocks.forEach(function (b) { b.hidden = !b.querySelector("[data-kit-item]:not([hidden])"); });
    tagChips.forEach(function (c) {
      var t = c.dataset.kitTag, on = state.tags.indexOf(t) >= 0;
      var k = data.filter(function (d) { return d.tags.indexOf(t) >= 0 && matches(d, t); }).length;
      if (on) c.setAttribute("aria-current", "true"); else c.removeAttribute("aria-current");
      c.querySelector("small").textContent = k;
      if (k === 0 && !on) c.setAttribute("data-empty", ""); else c.removeAttribute("data-empty");
      if (on) c.removeAttribute("data-more");
    });
    groupChips.forEach(function (c) {
      var g = c.dataset.kitGroup;
      if (g === state.group) c.setAttribute("aria-current", "true"); else c.removeAttribute("aria-current");
      c.querySelector("small").textContent = data.filter(function (d) {
        var keep = state.group; state.group = ""; var ok = d.group === g && matches(d); state.group = keep; return ok;
      }).length;
    });
    var all = cards.length, filtered = state.q || state.group || state.tags.length;
    count.textContent = filtered ? n + " of " + all + " components" : "All " + all + " components";
    none.hidden = n > 0;
    clear.hidden = !filtered;
    var p = new URLSearchParams();
    if (state.q) p.set("q", state.q);
    if (state.group) p.set("group", state.group);
    if (state.tags.length) p.set("tag", state.tags.join(","));
    var url = location.pathname + (p.toString() ? "?" + p : "") + location.hash;
    if (url !== location.pathname + location.search + location.hash) history[push ? "pushState" : "replaceState"](null, "", url);
  }
  box.value = state.q;
  box.addEventListener("input", function () { state.q = box.value; apply(false); });
  box.form.addEventListener("submit", function (e) { e.preventDefault(); });
  root.addEventListener("click", function (e) {
    if (e.button || e.metaKey || e.ctrlKey || e.shiftKey) return;
    var t = e.target.closest("[data-kit-tag]"), g = e.target.closest("[data-kit-group]");
    if (t) {
      e.preventDefault();
      var i = state.tags.indexOf(t.dataset.kitTag);
      if (i >= 0) state.tags.splice(i, 1); else state.tags.push(t.dataset.kitTag);
      apply(true);
    } else if (g) {
      e.preventDefault();
      state.group = state.group === g.dataset.kitGroup ? "" : g.dataset.kitGroup;
      apply(true);
    } else if (e.target === clear) {
      e.preventDefault();
      state = { q: "", group: "", tags: [] }; box.value = ""; apply(true); box.focus();
    } else if (e.target === more) {
      var open = root.classList.toggle("kit-all-tags");
      more.textContent = open ? "Fewer tags" : "All tags";
      more.setAttribute("aria-expanded", open ? "true" : "false");
    }
  });
  // On the window, so a component's own "/" (a search box of its own) goes first.
  addEventListener("keydown", function (e) {
    if (e.defaultPrevented) return;
    var a = document.activeElement, typing = a && (/^(INPUT|TEXTAREA|SELECT)$/.test(a.tagName) || a.isContentEditable);
    if (e.key === "/" && !typing) { e.preventDefault(); box.focus(); box.select(); }
    else if (e.key === "Escape" && a === box && box.value) { box.value = ""; state.q = ""; apply(false); }
  });
  addEventListener("popstate", function () { state = read(); box.value = state.q; apply(false); });
  apply(false);
})();`

view KitSide(current: str) {
    let cur = find(kit_items, (c) => c.slug == current)
    <aside.sidebar aria-label="Components">
        <div.kit-side-head>
            <input.kit-side-q type="search" id="kit-side-q" placeholder="Filter components" aria-label="Filter the components"
                   autocomplete="off" hidden/>
        </div>
        <div.side-group.current>
            <ul><li><a href="/components/" class={current == "" && "active"}
                       aria-current={current == "" ? "page" : null}>All {len(kit_items)} components</a></li>
                <li><a href="/components/tags/" class={current == "#tags" && "active"}
                       aria-current={current == "#tags" ? "page" : null}>Browse by tag</a></li></ul>
        </div>
        <p.kit-side-none id="kit-side-none" hidden>Nothing matches.</p>
        {for g in kit_groups_used() =>
            <details.side-group.kit-side-group open={cur != null && cur.group == g}>
                <summary><span>{g}</span><small>{len(kit_group(g))}</small></summary>
                <ul>{for c in kit_group(g) =>
                    <li data-find={lower(join([c.name, c.slug] + (c.tags ?? []), " "))}>
                        <a href={`/components/${c.slug}/`} class={c.slug == current && "active"}
                           aria-current={c.slug == current ? "page" : null}>{c.name}</a></li>}</ul>
            </details>}
    </aside>
}

view KitPage(title: str, path: str, description: str, current: str, ld: list = [], thread: bool = false, children) =
    <html lang="en">
        <Head title={title} path={path} css={style + docs_style + ui_css + demo_css + kit_style}
            description={description} fonts={["instrument-serif", "inter", "jetbrains-mono"]} ld={ld}/>
        <body.docs-body>
            <header.nav>
                <div.nav-left>
                    <a.brand href="/" aria-label="Quillo"><Logo/><span>Quillo<span.brand-ext>.qwe</span></span></a>
                    <a.docs-label href="/components/">Components</a>
                </div>
                <nav><a.nav-extra href="/docs/">Docs</a><a.nav-extra href="/plugins/">Plugins</a><a.nav-extra href="/blog/">Blog</a><SiteThreadNav thread={thread}/><Stars/></nav>
            </header>
            <div.docs.kit>
                <input type="checkbox" id="docs-menu" hidden/>
                <label.menu-button for="docs-menu">Components</label>
                <KitSide current={current}/>
                <script>{raw(kit_side_script)}</script>
                <main.kit-main>{children}</main>
            </div>
            <script>{raw(kit_stage_script)}</script>
        <SiteFooter/>
        </body>
    </html>

// A block of code with a Copy button (wired by kit_stage_script), which copies
// its lines as they are written.
view KitSnippet(file: str? = null, text: str, lang: str = "quillo") =
    <div.snippet.kit-snippet class={lang == "shell" && "terminal"}>
        {file != null && <div.file>{file}</div>}
        <button.kit-copy type="button" data-kit-copy aria-label={file != null ? `Copy ${file}` : "Copy the command"}>Copy</button>
        <Code lines={lang == "shell" ? shell(split(text, "\n")).lines : highlight(text)}/>
    </div>

// Size and speed, from the kit's bench.json.
view KitBench() =
    <div>
        <h2 id="size">Size and speed</h2>
        <p>What a program pays for the components it holds, whether or not a page shows them. The kit's
            <code>scripts/bench.mjs</code> loads its components into one program, then the kit several times
            over, renamed, as a stand-in for a large app:</p>
        <table.kit-bench>
            <thead><tr><th>Components in one program</th><th><code>quillo check</code></th><th>Start-up</th>
                <th>Memory, running</th><th>A page</th></tr></thead>
            <tbody>{for r in kit_bench.rows => <tr>
                <td>{format_number(r.components, "en-US", 0)}</td><td>{r.check_s} s</td><td>{r.start_s} s</td>
                <td>{r.memory_mb} MB</td><td>{r.page_ms} ms</td></tr>}</tbody>
        </table>
        <p.kit-bench-note>{kit_bench.quillo}, {kit_bench.machine}, {kit_bench.date}.</p>
        <ul>
            <li><b>Visitors pay only for what a page shows.</b> A page carries the components it shows and their
                styles, whatever the program holds.</li>
            <li><b>The server holds what the program declares.</b> Start-up and memory grow in a straight line,
                about 1 ms and 0.3 MB a component, once per process (each <code>--watch</code> reload,
                <code>--instances</code> copy and service copy is one). Pages stay fast at any size.</li>
            <li><b>The leanest app takes the files it uses.</b> <code>quillo-ui.qwe</code> is the whole kit in one
                <code>use</code>; picking files keeps a process to what the app shows. Each component's page gives
                the commands, with the files it needs.</li>
        </ul>
    </div>

// A component's card: what the index filters, by the data on it.
view KitCard(c) =
    <a.card.kit-card href={`/components/${c.slug}/`} data-kit-item data-slug={c.slug} data-name={c.name}
       data-group={c.group} data-summary={c.summary} data-tags={join(c.tags ?? [], " ")}>
        <b>{c.name}</b>
        <span>{c.summary}</span>
        <span.kit-card-tags>{for t in c.tags ?? [] => <i>{t}</i>}</span>
        {st_line(`/components/${c.slug}/`, [`ui/${c.slug}.qwe`]) != "" && <span.kit-card-n>{st_line(`/components/${c.slug}/`, [`ui/${c.slug}.qwe`])}</span>}
    </a>

// The tags as links to their pages; `on` marks the current one.
view KitTagLinks(on: str = "", limit: int = 0) {
    let tags = kit_tags()
    <p.kit-chips>{for [i, t] in enumerate(tags) =>
        <a.kit-chip href={`/components/tags/${t.tag}/`} aria-current={t.tag == on ? "page" : null}
           data-more={limit > 0 && i >= limit ? "" : null}>{t.tag}<small>{t.n}</small></a>}</p>
}

// Structured data: the kit as a list of its components, a component as Quillo
// source code in the kit's repository, and breadcrumbs.
let KIT_LD_LANG = { "@type": "ComputerLanguage", name: "Quillo", url: "https://quillolang.org/" }

fn kit_ld_index() = [
    { "@type": "CollectionPage", name: "Quillo UI components", url: SITE + "/components/",
      description: `${len(kit_items)} UI components for the Quillo programming language, one .qwe file each.`,
      isPartOf: { "@id": SEO_WEBSITE }, about: { "@id": SEO_LANGUAGE },
      mainEntity: { "@type": "ItemList", numberOfItems: len(kit_items),
          itemListElement: for [i, c] in enumerate(kit_items) =>
              { "@type": "ListItem", position: i + 1, name: c.name, url: `${SITE}/components/${c.slug}/` } } },
    seo_crumbs([["Quillo", "/"], ["Components", "/components/"]]),
]

fn kit_ld_component(c: map) = [
    { "@type": "SoftwareSourceCode", name: `${c.name}, a Quillo UI component`, description: c.summary,
      url: `${SITE}/components/${c.slug}/`, programmingLanguage: KIT_LD_LANG,
      codeRepository: KIT_REPO, license: "https://opensource.org/licenses/MIT",
      keywords: join(c.tags ?? [], ", "), isPartOf: { "@id": SEO_WEBSITE } },
    seo_crumbs([["Quillo", "/"], ["Components", "/components/"], [c.name, `/components/${c.slug}/`]]),
]

fn kit_ld_tag(tag: str, items: list) = [
    { "@type": "CollectionPage", name: `Quillo UI components tagged ${tag}`, url: `${SITE}/components/tags/${tag}/`,
      isPartOf: { "@id": SEO_WEBSITE },
      mainEntity: { "@type": "ItemList", numberOfItems: len(items),
          itemListElement: for [i, c] in enumerate(items) =>
              { "@type": "ListItem", position: i + 1, name: c.name, url: `${SITE}/components/${c.slug}/` } } },
    seo_crumbs([["Quillo", "/"], ["Components", "/components/"], ["Tags", "/components/tags/"], [tag, `/components/tags/${tag}/`]]),
]

fn kit_index() =
    <KitPage title={`Quillo UI · ${len(kit_items)} components to download`} path="/components/" current="" ld={kit_ld_index()}
             description={`${len(kit_items)} UI components for Quillo, each one .qwe file to download or clone: forms, sign-in, date pickers, dialogs, tables, charts, trading charts and more, to search by name, group and tag.`}>
        <div.prose>
        <p.kicker>Quillo UI</p>
        <h1>{len(kit_items)} components, one file each</h1>
        <p.lede>Buttons, forms, sign-in, date pickers, dialogs, tables, charts and trading charts, commerce,
            dashboards and more, each one <code>.qwe</code> file to copy into your program. They bring their
            styles, follow the system's light or dark theme, and work with the keyboard and screen readers.
            Most are views that add no JavaScript; the rest run in the browser as components.</p>
        </div>
        <div.kit-get>
            <a.kit-dl href="/components/quillo-ui.qwe" download>
                <b>quillo-ui.qwe</b><span>The whole kit in one file</span></a>
            <a.kit-dl href="/components/quillo-ui.zip" download>
                <b>quillo-ui.zip</b><span>Every file, the gallery and its tests</span></a>
            <a.kit-dl href={KIT_REPO}>
                <b>quillolang/components</b><span>Clone it, or add it as a submodule</span></a>
        </div>
        <div.kit-browse data-kit-browse>
            <form.kit-search role="search" method="get" action="/components/">
                <label.visually-hidden for="kit-q">Search the components</label>
                <input.kit-q type="search" id="kit-q" name="q" autocomplete="off"
                       placeholder={`Search ${len(kit_items)} components by name, use or tag`}/>
                <kbd.kit-kbd aria-hidden="true">/</kbd>
            </form>
            <div.kit-filter>
                <span.kit-filter-label>Group</span>
                <p.kit-chips>{for g in kit_groups_used() =>
                    <a.kit-chip href={`#${lower(g)}`} data-kit-group={g}>{g}<small>{len(kit_group(g))}</small></a>}</p>
            </div>
            <div.kit-filter>
                <span.kit-filter-label>Tags</span>
                <p.kit-chips>{for [i, t] in enumerate(kit_tags()) =>
                    <a.kit-chip href={`/components/tags/${t.tag}/`} data-kit-tag={t.tag}
                       data-more={i >= KIT_TOP_TAGS ? "" : null}>{t.tag}<small>{t.n}</small></a>}</p>
            </div>
            <div.kit-status>
                <span id="kit-count" role="status" aria-live="polite">All {len(kit_items)} components</span>
                {len(kit_tags()) > KIT_TOP_TAGS &&
                    <button type="button" id="kit-more-tags" aria-expanded="false">All tags</button>}
                <button type="button" id="kit-clear" hidden>Clear filters</button>
            </div>
        </div>
        <p.kit-none id="kit-none" hidden>No component matches. Try fewer words, or take a tag off.</p>
        {for g in kit_groups_used() =>
            <section.kit-block data-kit-block>
                <h2.kit-block-title id={lower(g)}>{g} <small>{len(kit_group(g))}</small></h2>
                <div.cards.kit-cards>{for c in kit_group(g) => <KitCard c={c}/>}</div>
            </section>}
        <div.prose>
        <h2 id="use">Use the whole kit</h2>
        <KitSnippet lang="shell" text="curl -O https://quillolang.org/components/quillo-ui.qwe"/>
        <KitSnippet file="main.qwe" text={`use "quillo-ui.qwe"

route GET / =
    <html>
        <head><style>{ui_css}</style></head>
        <body class="ui-root">
            <Button href="/start">Get started</Button>
        <SiteFooter/>
        </body>
    </html>`}/>
        <h2 id="pick">Or only what you use</h2>
        <p>Each component is its own file, and every one needs <code>theme.qwe</code>: put
            <code>theme_css</code> in the page's style, and each component brings its own CSS to the
            pages that show it. A few need another file, which their page names.
            <code>use</code> paths count from the folder of the program's main file.</p>
        <KitSnippet lang="shell" text={`mkdir -p ui && cd ui
curl -O https://quillolang.org/components/ui/theme.qwe
curl -O https://quillolang.org/components/ui/modal.qwe`}/>
        <KitSnippet file="main.qwe" text={`use "ui/theme.qwe"
use "ui/modal.qwe"

route GET / = <html><head><style>{theme_css}</style></head><body class="ui-root">...</body></html>`}/>
        <h2 id="git">With git</h2>
        <KitSnippet lang="shell" text={`git submodule add ${KIT_REPO} vendor/quillo-ui
git submodule update --remote vendor/quillo-ui      # later, for the newest`}/>
        <KitSnippet file="main.qwe" text={`use "vendor/quillo-ui/quillo-ui.qwe"`}/>
        <h2 id="theme">Make it yours</h2>
        <p>Every colour, font and radius is a CSS variable from <code>theme.qwe</code>. Set them
            again after the kit's styles; <code>class="ui-dark"</code> or <code>class="ui-light"</code>
            on any element fixes the theme inside it.</p>
        <KitSnippet file="style.css" text=":root { --ui-accent: #0a7d55; --ui-radius: 4px; --ui-font: \"IBM Plex Sans\", sans-serif; }"/>
        {kit_bench != null && <KitBench/>}
        </div>
        <script>{raw(kit_browse_script)}</script>
    </KitPage>

// Every tag, with how many components have it.
fn kit_tags_page() =
    <KitPage title="Tags · Quillo UI" path="/components/tags/" current="#tags" ld={[seo_crumbs([["Quillo", "/"], ["Components", "/components/"], ["Tags", "/components/tags/"]])]}
             description={`The ${len(kit_tags())} tags of Quillo UI's ${len(kit_items)} components: forms, inputs, buttons, charts, trading and more.`}>
        <div.prose>
            <p.kicker>Quillo UI</p>
            <h1>Browse by tag</h1>
            <p.lede>A tag cuts across the groups: <a href="/components/tags/forms/">forms</a> has every input and
                button, <a href="/components/tags/no-js/">no-js</a> every component that adds no JavaScript.
                On <a href="/components/">the index</a> several tags can be picked together.</p>
        </div>
        <KitTagLinks/>
    </KitPage>

fn kit_tag_page(tag: str) {
    let items = kit_tagged(tag)
    if len(items) == 0 { reply 404 "No such tag" }
    <KitPage title={`${tag} · Quillo UI`} path={`/components/tags/${tag}/`} current="#tags" ld={kit_ld_tag(tag, items)}
             description={`${len(items)} Quillo UI components tagged ${tag}: ${join(items | take(8) | map((c) => c.name), ", ")}${len(items) > 8 ? " and more" : ""}.`}>
        <div.prose>
            <p.kicker><a href="/components/tags/">Tags</a></p>
            <h1>#{tag}</h1>
            <p.lede>{len(items)} component{len(items) == 1 ? "" : "s"} tagged <b>{tag}</b>.{" "}
                <a href={`/components/?tag=${url_encode(tag)}`}>Narrow them down</a> with a search or more tags.</p>
        </div>
        {for g in kit_groups_used() | filter((g) => any(items, (c) => c.group == g)) =>
            <section.kit-block>
                <h2.kit-block-title>{g} <small>{len(items | filter((c) => c.group == g))}</small></h2>
                <div.cards.kit-cards>{for c in items | filter((c) => c.group == g) => <KitCard c={c}/>}</div>
            </section>}
        <h2.kit-block-title>Other tags</h2>
        <KitTagLinks on={tag} limit={0}/>
    </KitPage>
}

fn kit_page(slug: str) {
    let c = find(kit_items, (x) => x.slug == slug) ?? reply 404 "No such component"
    let i = index_of(kit_items | map((x) => x.slug), slug)
    let prev = i > 0 ? kit_items[i - 1] : null
    let next = kit_items[i + 1]
    let source = read_file(`content/components/ui/${slug}.qwe`)
    let related = kit_related(c)
    let needs = c.needs ?? []
    <KitPage title={`${c.name} · Quillo UI`} path={`/components/${slug}/`} current={slug} thread={true} ld={kit_ld_component(c)}
             description={`${c.name}, a Quillo UI component: ${c.summary}`}>
        <div.prose>
            <p.kicker><a href={`/components/?group=${url_encode(c.group)}`}>{c.group}</a></p>
            <h1>{c.name}</h1>
            <p.lede>{c.summary}</p>
        </div>
        {len(c.tags ?? []) > 0 && <p.kit-chips.kit-page-tags aria-label="Tags">{for t in c.tags ?? [] =>
            <a.kit-chip href={`/components/tags/${t}/`}>#{t}</a>}</p>}
        <h2.visually-hidden id="demo">Demo</h2>
        <KitStage>{c.demo()}</KitStage>
        <div.kit-actions>
            <a.kit-btn href={`/components/ui/${slug}.qwe`} download>Download {slug}.qwe</a>
            <a.kit-btn.kit-btn-quiet href="/components/ui/theme.qwe" download>theme.qwe</a>
            <a.kit-btn.kit-btn-quiet href={`${KIT_REPO}/blob/main/ui/${slug}.qwe`}>On GitHub</a>
        </div>
        <div.prose>
        <h2 id="get">Get it</h2>
        <p>It needs <code>theme.qwe</code>, as every component does{len(needs) > 0 ? ", and " : ""}{for [i, n] in enumerate(needs) =>
            <span>{i > 0 ? (i == len(needs) - 1 ? " and " : ", ") : ""}<a href={`/components/${n}/`}><code>{n}.qwe</code></a></span>};
            or take the whole kit, <a href="/components/quillo-ui.qwe" download><code>quillo-ui.qwe</code></a>.
            Each component brings its own styles to the pages that show it.</p>
        <KitSnippet lang="shell" text={join((["theme"] + needs + [slug]) | map((f) => `curl -O https://quillolang.org/components/ui/${f}.qwe`), "\n")}/>
        <KitSnippet file="main.qwe" text={join((["theme"] + needs + [slug]) | map((f) => `use "ui/${f}.qwe"`), "\n") + `

route GET / = <html><head><style>{theme_css}</style></head><body class="ui-root">...</body></html>`}/>
        <h2 id="example">Example</h2>
        <p>The code of the preview above.</p>
        <KitSnippet file={`demos/${slug}.qwe`} text={kit_example(slug)}/>
        <h2 id="source">Source</h2>
        <KitSnippet file={`ui/${slug}.qwe`} text={source}/>
        {len(related) > 0 && <h2 id="related">Related</h2>}
        </div>
        {len(related) > 0 && <div.cards.kit-cards>{for r in related => <KitCard c={r}/>}</div>}
        <SiteCommunity page={`/components/${slug}/`} name={c.name} samples={true} files={[`ui/${slug}.qwe`]}/>
        <div.prose>
        <nav.pager>
            {prev ? <a.prev href={`/components/${prev.slug}/`}><small>Previous</small>{prev.name}</a> : <span></span>}
            {next ? <a.next href={`/components/${next.slug}/`}><small>Next</small>{next.name}</a> : <span></span>}
        </nav>
        </div>
    </KitPage>
}

// The files, for `quillo run`; export.sh copies them into dist/ as they are.
route GET /components/quillo-ui.qwe { st_hit(request, "download", "quillo-ui.qwe"); file("content/components/quillo-ui.qwe") }
route GET /components/ui/:name {
    let r = file(`content/components/ui/${name}`)
    if r.status == 200 { st_hit(request, "download", `ui/${name}`) }
    r
}
route GET /components = kit_index()
route GET /components/tags = kit_tags_page()
route GET /components/tags/:tag = kit_tag_page(tag)
route GET /components/:slug {
    if any(kit_items, (c) => c.slug == slug) { st_hit(request, "view", `/components/${slug}/`) }
    kit_page(slug)
}
