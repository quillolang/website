// /sponsors/: sponsoring Quillo. Companies and people apply with a short form; an admin
// approves those to show (on /sponsors/ and the home page) at /admin/sponsors/. The
// amounts are agreed with each sponsor, so the tiers say what each gets, not a price.

db.exec("create table if not exists sponsors (id integer primary key, name text, contact text, email text, website text, tier text, kind text, cadence text, logo text, message text, public integer default 1, status text, ip text, created integer, approved integer)")

let SP_TIERS = [
    { key: "backer", name: "Backer", who: "For people who use Quillo and want it to grow.",
      gets: ["Your name on this page", "The sponsors' channel on Discord"] },
    { key: "supporter", name: "Supporter", who: "For small companies and studios building with Quillo.",
      gets: ["Your logo on this page", "A mention in the newsletter", "Everything a backer gets"] },
    { key: "partner", name: "Partner", who: "For companies that run Quillo in production.",
      gets: ["Your logo on the home page", "A say in what is built next", "Help from the people who make Quillo", "Everything a supporter gets"] },
    { key: "founding", name: "Founding sponsor", who: "For the few who back Quillo from its first year.",
      gets: ["The top place on the home page and here, for good", "A blog post about you and what you build", "A seat at the roadmap meetings", "Everything a partner gets"] },
]

fn sp_tier(key: str) = find(SP_TIERS, (t) => t.key == key)
fn sp_shown() = db.query("select * from sponsors where status = 'approved' and public = 1 order by case tier when 'founding' then 0 when 'partner' then 1 when 'supporter' then 2 else 3 end, approved")

view SpLogo(s) =
    <a.sp-logo href={s.website != "" ? s.website : null} rel="sponsored noopener" target="_blank" title={s.name}>
        {s.logo != "" && s.tier != "backer"
            ? <img src={s.logo} alt={s.name} loading="lazy" referrerpolicy="no-referrer"/>
            : <span>{s.name}</span>}
    </a>

// The home page's band: the sponsors shown there (partners and up), or an invitation.
view SponsorsBand() {
    let top = sp_shown() | filter((s) => s.tier == "founding" || s.tier == "partner")
    <section#sponsors.section.sp-band>
        <p.kicker>Sponsors</p>
        {len(top) == 0
            ? <div.sp-invite>
                <h2>Quillo is made in the open. <em>Back it.</em></h2>
                <p.sub>Sponsors pay for the language, the components, the plugins and the docs, and get a say in what comes next.</p>
                <p><a.kit-btn href="/sponsors/">Become a founding sponsor</a></p>
              </div>
            : <div>
                <h2>Backed by</h2>
                <div.sp-logos>{for s in top => <SpLogo s={s}/>}</div>
                <p><a href="/sponsors/">Become a sponsor →</a></p>
              </div>}
    </section>
}

fn sp_page(problem: str?, f: map, sent: bool) {
    let shown = sp_shown()
    <SitePage title="Sponsor Quillo" path="/sponsors/" label="Sponsors" href="/sponsors/"
              description="Sponsor Quillo, the web language: fund the language, its components, plugins and docs, and get your name or logo here, a mention in the newsletter, and a say in what is built next.">
        <div.prose>
            <p.kicker>Sponsors</p>
            <h1>Sponsor Quillo</h1>
            <p.lede>Quillo is open source and made in the open. Sponsors pay for the work: the language and its checker,
                the {len(kit_items)} components, the {len(plug_items)} plugins, the docs, and the servers this site runs on.
                In return, they get seen, and heard.</p>
        </div>
        <div.sp-tiers>{for t in SP_TIERS =>
            <article.sp-tier class={t.key == "founding" ? "sp-top" : null}>
                <h2>{t.name}</h2>
                <p>{t.who}</p>
                <ul>{for g in t.gets => <li>{g}</li>}</ul>
                <a.cm-link href={`#apply`} data-tier={t.key}>Apply as {lower(t.name)} →</a>
            </article>}</div>
        <div.prose>
            <p>Monthly or once, as a company or as a person: the amount is agreed with you. Sponsoring buys no say over
                Quillo's licence, which stays MIT, or over what it accepts from others.</p>
            {len(shown) > 0 && <h2 id="now">Our sponsors</h2>}
        </div>
        {len(shown) > 0 && <div.sp-logos.sp-all>{for s in shown => <SpLogo s={s}/>}</div>}
        <div.prose><h2 id="apply">Apply</h2></div>
        {sent
            ? <p.cm-note role="status">Thank you for backing Quillo: we will write back within a few days to agree the details.</p>
            : <form.cm-form.sc-form method="post" action="/sponsors/">
                {problem != null && <p.cm-problem role="alert">{problem}</p>}
                <label>Name to show <small>(your company's, or yours)</small> <input name="name" value={f.name ?? ""} maxlength="100" required/></label>
                <label>Your name <input name="contact" value={f.contact ?? ""} maxlength="100" required/></label>
                <label>Email <input name="email" type="email" value={f.email ?? ""} maxlength="254" required/></label>
                <label>Website <small>(optional)</small> <input name="website" type="url" value={f.website ?? ""} maxlength="300" placeholder="https://"/></label>
                <label>Tier <select name="tier">{for t in SP_TIERS => <option value={t.key} selected={(f.tier ?? "supporter") == t.key}>{t.name}</option>}</select></label>
                <label>As <select name="kind"><option value="company" selected={f.kind != "person"}>a company</option><option value="person" selected={f.kind == "person"}>a person</option></select></label>
                <label>How <select name="cadence"><option value="monthly" selected={f.cadence != "once"}>monthly</option><option value="once" selected={f.cadence == "once"}>once</option></select></label>
                <label>Logo's address <small>(optional, an https image; shown from Supporter up)</small> <input name="logo" type="url" value={f.logo ?? ""} maxlength="300"/></label>
                <label>Anything to add? <small>(optional)</small> <textarea name="message" rows="4" maxlength="3000">{f.message ?? ""}</textarea></label>
                <label.nl-check><input type="checkbox" name="public" value="1" checked={f.public != "0"}/> Show us on the sponsors' list</label>
                <input type="hidden" name="public_sent" value="1"/>
                <input.cm-trap name="url" tabindex="-1" autocomplete="off" aria-hidden="true"/>
                <button.cm-btn>Apply</button>
              </form>}
        <script>{raw(`document.addEventListener("click", function (e) { var a = e.target.closest && e.target.closest("[data-tier]"); if (!a) return; var s = document.querySelector("select[name=tier]"); if (s) s.value = a.dataset.tier; });`)}</script>
    </SitePage>
}

route GET /sponsors = sp_page(null, {}, false)

route POST /sponsors { form: { name: str = "", contact: str = "", email: str = "", website: str = "", tier: str = "supporter", kind: str = "company", cadence: str = "monthly", logo: str = "", message: str = "", public: str = "", url: str = "" } } {
    let f = request.form
    let fail = (why: str) => respond(422, sp_page(why, f, false))
    if url != "" { return fail("Something went wrong: try again") }
    if len(trim(name)) < 2 || len(trim(contact)) < 2 { return fail("Fill in the name to show and yours") }
    if !nl_email_ok(lower(trim(email))) { return fail("That email address does not look right") }
    if sp_tier(tier) == null { return fail("Pick a tier") }
    if trim(website) != "" && !sc_url_ok(trim(website)) { return fail("The website's address starts with https://") }
    if !sc_image_ok(trim(logo)) { return fail("The logo's address starts with https://") }
    if len(message) > 3000 { return fail("At most 3,000 characters") }
    let ip = crypto.sha256(`${env("QUILLO_SECRET") ?? "dev"}:${request.ip}`)
    if db.one("select count(*) as n from sponsors where ip = ? and created > ?", ip, now() - CM_DAY).n >= 3 { return fail("We have your application already: we will write back") }
    db.exec("insert into sponsors (name, contact, email, website, tier, kind, cadence, logo, message, public, status, ip, created) values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'new', ?, ?)",
        trim(name), trim(contact), lower(trim(email)), trim(website), tier, kind == "person" ? "person" : "company", cadence == "once" ? "once" : "monthly",
        trim(logo), trim(message), public == "1" ? 1 : 0, ip, now())
    sp_page(null, {}, true)
}

route GET /admin/sponsors {
    let g = adm_gate("/admin/sponsors/")
    if g.stop != null { return g.stop }
    let rows = db.query("select * from sponsors order by case status when 'new' then 0 when 'approved' then 1 else 2 end, id desc limit 300")
    adm_page("Sponsors", "sp", [
        <p.cm-empty>{len(rows) == 0 ? "No applications yet." : "Approve one to show it (if it asked to be shown): from Partner up on the home page, all on /sponsors/."}</p>,
        <div>{for s in rows =>
            <article.adm-item class={s.status == "new" ? "adm-held" : s.status == "approved" ? null : "adm-hidden"}>
                <header><b>{s.name}</b> · {sp_tier(s.tier)?.name ?? s.tier} · {s.kind}, {s.cadence} · <span.adm-status>{s.status}</span>
                    {s.public == 0 && <span.adm-status> · not to be shown</span>} · {cm_ago(s.created)}</header>
                <p>{s.contact}, <a href={`mailto:${s.email}`}>{s.email}</a>{s.website != "" && <span> · <a href={s.website} rel="nofollow noopener">{s.website}</a></span>}</p>
                {s.logo != "" && <p><img.sp-admin-logo src={s.logo} alt="" referrerpolicy="no-referrer"/></p>}
                {s.message != "" && <pre.adm-text>{s.message}</pre>}
                <form method="post" action="/admin/sponsors/">
                    <input type="hidden" name="id" value={str(s.id)}/>
                    {s.status != "approved" && <button name="action" value="approve">Approve</button>}
                    {s.status != "declined" && <button name="action" value="decline">{s.status == "approved" ? "Take down" : "Decline"}</button>}
                    <select name="tier" aria-label="Tier">{for t in SP_TIERS => <option value={t.key} selected={s.tier == t.key}>{t.name}</option>}</select>
                    <button name="action" value="tier">Set the tier</button>
                </form>
            </article>}</div>,
    ])
}

route POST /admin/sponsors { form: { id: int, action: str, tier: str = "" } } {
    let g = adm_gate("/admin/sponsors/")
    if g.stop != null { return g.stop }
    match action {
        "approve" => { db.exec("update sponsors set status = 'approved', approved = ? where id = ?", now(), id) }
        "decline" => { db.exec("update sponsors set status = 'declined' where id = ?", id) }
        "tier" => { if sp_tier(tier) != null { db.exec("update sponsors set tier = ? where id = ?", tier, id) } }
        _ => { reply 400 "No such action" }
    }
    redirect("/admin/sponsors/")
}
