// The docs, made from the user guide (USERGUIDE.md) so they never drift from it: each `## `
// section is a page, and its `### ` and `#### ` headings are the page's
// contents. Code fences marked `quillo` are highlighted like the home page's.
// The Examples pages show each program in examples/, whole. Both are read
// through content/, links (made by link.sh) to quillolang/quillo's USERGUIDE.md
// and to quillolang/examples.

use "demos/reactivity/counter.qwe"
use "demos/reactivity/timer.qwe"
use "demos/reactivity/rows.qwe"
use "demos/reactivity/branch.qwe"
use "demos/reactivity/props.qwe"

let GROUPS = [
    { name: "Guide", pages: ["introduction", "install", "possible-or-not", "language-tour", "components", "reactivity", "async", "routes", "route-groups", "headers-cookies-sessions", "realtime", "prefetching", "validation", "database", "money", "structure", "microservices", "rust", "hosting"] },
    { name: "Reference", pages: ["standard-library", "reference", "checking", "concurrency-and-reloading", "cached-views", "compiled-numbers"] },
    { name: "Examples", pages: ["examples", "examples/hello", "examples/orders", "examples/todo",
        "examples/notes", "examples/compose", "examples/layout", "examples/spa", "examples/scroll",
        "examples/virtual", "examples/life", "examples/storm", "examples/telemetry", "examples/media", "examples/rust",
        "examples/services", "examples/index"] },
    { name: "Project", pages: ["layout", "not-built-yet"] },
]

// What each example is called here, and what it shows, in a line.
let EXAMPLES = [
    { name: "hello", title: "Hello, routes", blurb: "Path parameters, typed query patterns and JSON answers in fifteen lines." },
    { name: "orders", title: "Payload routing", blurb: "One path, several handlers, chosen by what is inside the JSON body." },
    { name: "todo", title: "Todo app", blurb: "A server-rendered app with forms, redirects and a JSON API next to it." },
    { name: "notes", title: "Notes", blurb: "SQLite on the server, a live component in the browser, in sync across tabs." },
    { name: "compose", title: "Composition", blurb: "Views and components built from each other: props down, callbacks up, slots." },
    { name: "layout", title: "JSON layout", blurb: "A page described as JSON, rendered by one view, with a live editor beside it." },
    { name: "spa", title: "Single-page app", blurb: "Client-side navigation, deep links, a cart that survives pages and live stock." },
    { name: "scroll", title: "Infinite scroll", blurb: "100,000 rows, loaded 200 at a time, with only the visible ones in the page." },
    { name: "virtual", title: "Virtual list", blurb: "A million rows of ten columns, twenty on screen: drag the scrollbar anywhere." },
    { name: "life", title: "Game of Life", blurb: "A board in a component's state, stepped by a timer that runs in the browser." },
    { name: "storm", title: "State storm", blurb: "A dashboard under a storm of random changes, tested for leaks." },
    { name: "telemetry", title: "Telemetry", blurb: "Sensors send readings over UDP; every page sees them as they come, over a channel.",
      also: ["sensors.qwe"] },
    { name: "media", title: "Camera", blurb: "A camera's RTP stream, played in the page a fraction of a second behind." },
    { name: "rust", title: "Rust in a program", blurb: "Primes and Collatz chains in a .qwer file, called from a component through server fns.",
      also: ["rust.qwer"] },
    { name: "services", title: "Services", blurb: "A shop that bills through a billing service, in one process or split apart.",
      files: ["app.qwe", "shop.qwe", "billing.qwe"] },
    { name: "index", title: "All examples", blurb: "Every example mounted under its own path in one server, behind tabs." },
]
let RENAMED = { "layout": "Source layout", "not-built-yet": "Roadmap" }
let ALNUM = "abcdefghijklmnopqrstuvwxyz0123456789"

// As GitHub makes heading anchors: lower case, spaces to dashes, other marks dropped.
fn slug(text: str) =
    split(lower(text), "") | map((c) => contains(ALNUM, c) ? c : c == " " || c == "-" ? "-" : "") | join("")

fn page_url(s: str) = s == "introduction" ? "/docs/" : `/docs/${s}/`

// Pages written for the site rather than cut from the README: guides/<slug>.md,
// a `# ` title, then headings and code as the README has them.
let GUIDES = ["install", "hosting", "async", "realtime", "prefetching", "validation", "database", "money", "structure", "microservices", "headers-cookies-sessions", "route-groups"]

fn guide(s: str) {
    let lines = split(read_file(`guides/${s}.md`), "\n")
    { slug: s, title: slice(first(lines), 2), blocks: blocks(drop(lines, 1)), guide: true }
}

// The comment a file starts with, as markdown: lines indented further than a
// list item's are commands, shown as code.
fn header_lines(lines: list) =
    reduce(lines, { out: [], done: false }, (st, l) =>
        !st.done && starts_with(l, "//") ? merge(st, { out: push(st.out, l) }) : merge(st, { done: true })).out

fn about(header: list) =
    header | map((l) => {
        let t = starts_with(l, "// ") ? slice(l, 3) : slice(l, 2)
        let line = trim(t)
        let command = starts_with(t, "  ") && (starts_with(line, "quillo ") || starts_with(line, "curl "))
        let gap = index_of(line, "  ")
        // "quillo run x.qwe --watch     then open ...": the command, then the words after it.
        command ? "\n`" + (gap != null ? slice(line, 0, gap) : line) + "`" + (gap != null ? " " + trim(slice(line, gap)) : "") + "\n" : t
    }) | join("\n")

fn shell(lines: list) = { type: "shell", lines: lines | map((l) => [{ k: "prompt", text: "$ " }, { k: "plain", text: l }]) }

fn example_page(e: map) {
    // `files`: a directory's; `also`: files beside the example's own, shown after it.
    let files = e.files ? e.files | map((f) => `${e.name}/${f}`) : [`${e.name}.qwe`] + (e.also ?? [])
    let main = split(read_file(`content/examples/${first(files)}`), "\n")
    let head = header_lines(main)
    let sources = for [i, f] in enumerate(files) => {
        let lines = i == 0 ? drop(main, len(head)) : split(read_file(`content/examples/${f}`), "\n")
        [{ type: "h", level: 3, text: len(files) == 1 ? "Source" : f, id: len(files) == 1 ? "source" : slug(replace(f, "/", " ")) },
         { type: "code", lang: ends_with(f, ".qwer") ? "rust" : "quillo", lines, file: f }]
    }
    {
        title: e.title,
        blocks: [
            { type: "h", level: 3, text: "About", id: "about" },
            { type: "md", text: about(head) },
            { type: "h", level: 3, text: "Run it", id: "run-it" },
            shell([`quillo run ${first(files)} --watch`]),
        ] + flatten(sources) + [
            { type: "md", raw: true, text: `[See ${e.name}${e.files ? "/" : ".qwe"} on GitHub](${EXAMPLES_REPO}/${e.files ? "tree" : "blob"}/main/${e.files ? e.name : `${e.name}.qwe`})` },
        ],
    }
}

let overview = {
    title: "Overview",
    blocks: [
        { type: "md", text: "Small programs, each showing one part of Quillo, with its whole source. They live in [quillolang/examples](https://github.com/quillolang/examples): clone it, and each runs with `quillo run <name>.qwe --watch`, or all together with `quillo run index.qwe`." },
        { type: "cards" },
    ],
}

// The README's lines, cut at each `## ` outside a code fence.
fn cut_pages(text: str) {
    let st = reduce(split(text, "\n"), { pages: [], cur: { title: "Introduction", lines: [] }, fence: false }, (st, line) =>
        !st.fence && starts_with(line, "## ")
            ? { pages: push(st.pages, st.cur), cur: { title: slice(line, 3), lines: [] }, fence: false }
        : !st.fence && starts_with(line, "# ") ? st
        : merge(st, {
            cur: merge(st.cur, { lines: push(st.cur.lines, line) }),
            fence: starts_with(line, "```") ? !st.fence : st.fence,
        }))
    push(st.pages, st.cur)
}

fn flush(st: map) =
    len(st.md) > 0 ? merge(st, { out: push(st.out, { type: "md", text: join(st.md, "\n") }), md: [] }) : st

// A page's lines as blocks: markdown, code fences and headings.
fn blocks(lines: list) =
    flush(reduce(lines, { out: [], md: [], code: null }, (st, line) =>
        st.code != null
            ? (starts_with(line, "```")
                ? merge(st, { out: push(st.out, merge(st.code, { type: "code" })), code: null })
                : merge(st, { code: merge(st.code, { lines: push(st.code.lines, line) }) }))
        : starts_with(line, "```") ? merge(flush(st), { code: { lang: trim(slice(line, 3)), lines: [] } })
        // `{{demo counter}}`: a live demo, its code beside it (see Demo).
        : starts_with(line, "{{demo ") ? merge(flush(st), { out: push(flush(st).out, { type: "demo", name: trim(slice(line, 7, len(line) - 2)) }) })
        : starts_with(line, "### ") || starts_with(line, "#### ") ? {
            let level = starts_with(line, "#### ") ? 4 : 3
            let text = trim(slice(line, level + 1))
            merge(flush(st), { out: push(flush(st).out, { type: "h", level, text, id: slug(replace(text, "`", "")) }) })
        }
        : merge(st, { md: push(st.md, line) }))).out

fn quillo_like(b: map) = b.lang == "quillo" || (b.lang == "" && any(b.lines, (l) => contains(l, "fn ") || contains(l, "route ")))

// Sections written for the site, added at the end of a README page: extras/<slug>.md.
let EXTRAS = ["introduction", "reactivity"]

fn extra(s: str) = contains(EXTRAS, s) ? blocks(split(read_file(`extras/${s}.md`), "\n")) : []

// ---- the function reference ------------------------------------------------------------
// One page per builtin, reference/<name>.md: `# name`, its signature as the checker
// knows it, `group: <Group>`, then sections (What it does, Examples, Edge cases,
// Errors, Chaining, See also). Every ```quillo example is followed by the ```output
// block tools/refcheck.mjs wrote by running it, so the outputs are the binary's.
// reference/builtins.json is the checker's table (tools/builtins.mjs), which says
// which functions exist and in what order.
let REF_BUILTINS = json.parse(read_file("reference/builtins.json")) | filter((b) => !starts_with(b.name, "__"))   // the compiler's own are not for programs
let REF_ORDER = ["General", "Strings", "Regular expressions", "Lists", "Maps", "Records and errors", "JSON", "Math", "Statistics", "Vectors",
    "Dates", "Decimals and money", "Markup", "Translations", "Web", "Requests and pages", "Cookies and sessions", "Tenants",
    "Database", "HTTP client", "Files and processes", "Crypto", "Channels", "Media", "UDP", "Jobs and services", "Browser"]

// A reference page's blocks: its examples' outputs as terminals, a failing
// example and one shown but not run marked by their file label.
fn ref_blocks(lines: list) =
    blocks(lines) | map((k) =>
        k.type != "code" ? k
        : k.lang == "output" ? merge(k, { file: "output", terminal: true })
        : k.lang == "quillo error" ? merge(k, { lang: "quillo", file: "this one fails" })
        : k.lang == "quillo noexec" ? merge(k, { lang: "quillo", file: "in a program" })
        : k)

// What the index needs of a page, read at load: its signature, group and first
// sentence. Its blocks are made when the page is asked for (ref_page), which
// keeps the program's load short: parsing all 315 pages took 0.1 s of it.
fn ref_read(b: map) {
    let text = read_file(`reference/${b.name}.md`)
    if is_err(text) { return null }
    let lines = split(text, "\n")
    let sig = lines[1]
    let group = trim(slice(lines[2], 6))
    let body = drop(lines, 3)
    let rest = drop(body, (index_of(body, "### What it does") ?? -1) + 1)
    let tail = drop(rest, index_of(rest | map((l) => trim(l) != ""), true) ?? 0)
    let para = join(take(tail, index_of(tail | map((l) => trim(l) == ""), true) ?? len(tail)), " ")
    let summary = first(split(para, ". ")) | (s) => ends_with(s, ".") || s == "" ? s : s + "."   // the first sentence
    { name: b.name, sig, group, summary, body }
}

let ref_entries = REF_BUILTINS | map(ref_read) | filter((e) => e != null)
let REF_SET = reduce(ref_entries, {}, (m, e) => set(m, e.name, true))

// A code span naming a builtin, `len` or `map(xs, f)`, becomes a link to its reference
// page, on every docs page but the reference's own; one already inside a link is left.
fn link_refs(text: str) =
    re.replace(text, "(^|[^\\[])`([a-z_]+(?:\\.[a-z_]+)?)(\\([^`]*\\))?`", (m) =>
        has(REF_SET, m.groups[1])
            ? `${m.groups[0]}[\`${m.groups[1]}${m.groups[2] ?? ""}\`](/docs/reference/${m.groups[1]}/)`
            : m.text)

let ref_groups = unique(ref_entries | map((e) => e.group))
    | sort_by((g) => index_of(REF_ORDER, g) ?? len(REF_ORDER))

// The index: each group, its functions with their signatures and first sentence.
let ref_index = {
    slug: "reference", title: "Function reference", guide: true,
    blocks: [{ type: "md", text: `Every builtin, one page each, with what it does, examples whose outputs were made by running them, the edge cases, what it gives back when it fails, and how it reads in a pipeline. ${len(ref_entries)} functions in ${len(ref_groups)} groups; [Standard library](/docs/standard-library/) is the overview, and each page takes comments and code samples at the foot.` }]
        + flatten(ref_groups | map((g) => {
            let fs = ref_entries | filter((e) => e.group == g)
            [{ type: "h", level: 3, text: g, id: slug(g) },
             { type: "md", raw: true, text: "| Function | What it does |\n|---|---|\n" + join(fs | map((e) => `| [${e.name}](/docs/reference/${e.name}/) \`${replace(slice(e.sig, len(e.name)), "|", "\\|")}\` | ${replace(e.summary, "|", "\\|")} |`), "\n") }]
        })),
}

let sources = (cut_pages(read_file("content/USERGUIDE.md")) | map((p) => {
        let s = slug(p.title)
        { slug: s, title: p.title, blocks: blocks(p.lines) + extra(s) }
    }))
    + (GUIDES | map(guide))
    + [ref_index]
    + [merge(overview, { slug: "examples" })]
    + (EXAMPLES | map((e) => merge(example_page(e), { slug: `examples/${e.name}` })))

let pages = sources | map((p) => {
    let s = p.slug
    let bs = p.blocks
    {
        slug: s,
        title: RENAMED[s] ?? p.title,
        url: page_url(s),
        group: find(GROUPS, (g) => contains(g.pages, s)).name,
        blocks: bs,
        toc: bs | filter((b) => b.type == "h") | map((b) => { id: b.id, text: replace(b.text, "`", ""), level: b.level }),
        guide: p.guide ?? false,
    }
}) | filter((p) => p.group != null)

// Pages in reading order: the groups', one after another.
let ordered = flatten(GROUPS | map((g) => g.pages)) | map((s) => find(pages, (p) => p.slug == s))

// The function pages, in the index's order, without their blocks; `ref` holds the entry.
let ref_pages = flatten(ref_groups | map((g) => ref_entries | filter((e) => e.group == g))) | map((e) => {
    slug: `reference/${e.name}`,
    title: e.name,
    url: page_url(`reference/${e.name}`),
    group: "Reference",
    guide: true,
    ref: e,
})

// A function's page with its blocks and contents, made when it is asked for.
fn ref_page(p: map) {
    let bs = [{ type: "code", lang: "quillo", lines: [p.ref.sig], file: "signature" }] + ref_blocks(p.ref.body)
    merge(p, { blocks: bs, toc: bs | filter((b) => b.type == "h") | map((b) => { id: b.id, text: replace(b.text, "`", ""), level: b.level }) })
}

fn ref_page_for(slug: str) {
    let p = find(ref_pages, (q) => q.slug == slug)
    p == null ? null : ref_page(p)
}

// Where each anchor lives, for the README's `](#...)` links: a page's name,
// and the README's headings. A guide's headings are left out: its "Live data"
// is not the README's.
let anchors = reduce(pages, {}, (acc, p) =>
    reduce(p.guide ? [] : p.toc, set(acc, p.slug, p.url), (a, h) => set(a, h.id, `${p.url}#${h.id}`)))

fn fix_anchors(text: str) {
    let parts = split(text, "](#")
    first(parts) + join(drop(parts, 1) | map((part) => {
        let end = index_of(part, ")") ?? len(part)
        let id = slice(part, 0, end)
        `](${anchors[id] ?? `#${id}`}` + slice(part, end)
    }), "")
}

// Links to examples go to their pages here; to other files, to the repository.
// (A block marked raw keeps its links: an example's own link to GitHub.)
fn fix_links(text: str) =
    fix_anchors(text)
        | replace(`](${EXAMPLES_REPO}/tree/main/services)`, "](/docs/examples/services/)")
        | replace(`](${EXAMPLES_REPO}/blob/main/rust.qwer)`, "](/docs/examples/rust/#rustqwer)")
        | replace(`](${EXAMPLES_REPO}/blob/main/`, "](/docs/examples/")
        | replace("](examples/services)", "](/docs/examples/services/)")
        | replace("](examples/rust.qwer)", "](/docs/examples/rust/#rustqwer)")
        | replace("](README.md)", "](/)")
        | replace("](examples/", "](/docs/examples/")
        | replace(".qwe)", "/)")

// A demo's code, read from demos/reactivity/<name>.qwe, beside the component
// itself running: what the page shows is what runs.
view Demo(name: str) =
    <div.demo-pair>
        <div.snippet><div.file>{name}.qwe</div><Code lines={highlight(read_file(`demos/reactivity/${name}.qwe`))}/></div>
        <div.demo-stage>{match name {
            "counter" => <CounterDemo/>
            "timer" => <ReactivityTimerDemo/>
            "rows" => <RowsDemo/>
            "branch" => <BranchDemo/>
            "props" => <PropsDemo/>
            _ => <p>No demo {name}</p>
        }}</div>
    </div>

view Block(b: map) =
    match b.type {
        "md" => markdown(b.raw ? b.text : fix_links(b.refs ? link_refs(b.text) : b.text))
        "h" => b.level == 3
            ? <h2 id={b.id}><a.anchor href={`#${b.id}`}>{markdown(b.text, { inline: true })}</a></h2>
            : <h3 id={b.id}><a.anchor href={`#${b.id}`}>{markdown(b.text, { inline: true })}</a></h3>
        "shell" => <div.snippet.terminal><Code lines={b.lines}/></div>
        "demo" => <Demo name={b.name}/>
        "cards" => <div.cards>{for e in EXAMPLES =>
            <a.card href={page_url(`examples/${e.name}`)}><b>{e.title}</b><span>{e.blurb}</span><code>{e.name}{e.files ? "/" : ".qwe"}</code></a>}</div>
        _ => <div.snippet class={b.terminal && "terminal"}>{b.file && <div.file>{b.file}</div>}<Code lines={quillo_like(b)
            ? highlight(join(b.lines, "\n"))
            : b.lang == "rust" ? highlight(join(b.lines, "\n"), "rust")
            : b.lines | map((l) => [{ k: "plain", text: l }])}/></div>
    }

// The right-hand column: this page's headings, the one being read marked as it scrolls.
component OnThisPage(items: list) {
    state active = items[0].id
    <nav.toc aria-label="On this page" @mount={(el) => {
        let seen = js_new("IntersectionObserver", (entries, _observer) => {
            let shown = entries | filter((e) => e.isIntersecting)
            if len(shown) > 0 { active = first(shown).target.id }
        }, { rootMargin: "0px 0px -75% 0px" })
        for h in items => seen.observe(js("document.getElementById", h.id))
        () => seen.disconnect()
    }}>
        <p>On this page</p>
        <ul>{for h in items =>
            <li key={h.id} class={`${h.level == 4 ? "toc-sub" : ""} ${h.id == active ? "active" : ""}`}>
                <a href={`#${h.id}`} @click={() => { active = h.id }}>{h.text}</a>
            </li>}</ul>
    </nav>
}

// On a function's page: its group's functions, the page's own marked.
view RefGroupNav(e: map) =
    <nav.ref-group aria-label={`${e.group} functions`}>
        <a href={`/docs/reference/#${slug(e.group)}`}>{e.group}</a>
        {for f in ref_entries | filter((x) => x.group == e.group) =>
            <a href={`/docs/reference/${f.name}/`} class={f.name == e.name && "active"} aria-current={f.name == e.name ? "page" : null}>{f.name}</a>}
    </nav>

view DocsPage(page: map) {
    let seq = page.ref != null ? ref_pages : ordered
    let i = index_of(seq | map((p) => p.slug), page.slug)
    let prev = i > 0 ? seq[i - 1] : null
    let next = seq[i + 1]
    let on_ref = page.ref != null
    <div.docs>
        <input type="checkbox" id="docs-menu" hidden/>
        <label.menu-button for="docs-menu">{page.group} · {page.title}</label>
        <aside.sidebar aria-label="Docs">
            {for g in GROUPS =>
                <div.side-group class={g.name == page.group && "current"}>
                    <p>{g.name}</p>
                    <ul>{for s in g.pages => {
                        let p = find(pages, (q) => q.slug == s)
                        let here = p.slug == page.slug || (on_ref && p.slug == "reference")
                        <li><a href={p.url} class={here && "active"}
                            aria-current={here ? "page" : null}>{p.title}</a></li>
                    }}</ul>
                </div>}
        </aside>
        <main.prose>
            <p.kicker>{on_ref ? `Reference · ${page.ref.group}` : page.group}</p>
            <h1>{page.title}</h1>
            {on_ref && <RefGroupNav e={page.ref}/>}
            {for b in page.blocks => <Block b={on_ref || b.type != "md" ? b : merge(b, { refs: true })}/>}
            <nav.pager>
                {prev ? <a.prev href={prev.url}><small>Previous</small>{prev.title}</a> : <span></span>}
                {next ? <a.next href={next.url}><small>Next</small>{next.title}</a> : <span></span>}
            </nav>
            <SiteCommunity page={page.url} name={on_ref ? `${page.title}()` : ""} samples={on_ref}/>
            {on_ref &&
                <p.edit><a href={`${SITE_REPO}/blob/main/reference/${page.title}.md`}>Edit this page on GitHub</a> · every example's output was made by running it (<a href={`${SITE_REPO}/blob/main/tools/refcheck.mjs`}>tools/refcheck.mjs</a>) · questions on <a href={DISCORD}>Discord</a> or <a href={REDDIT}>r/quillo</a></p>}
            {!page.guide && !starts_with(page.slug, "examples") &&
                <p.edit><a href={`${REPO}/blob/main/USERGUIDE.md`}>Edit this page on GitHub</a> · made from the user guide · questions on <a href={DISCORD}>Discord</a> or <a href={REDDIT}>r/quillo</a></p>}
        </main>
        {len(page.toc) > 0 ? <OnThisPage items={page.toc + [{ id: "cm-thread", text: "Thread", level: 3 }]}/> : <div></div>}
    </div>
}
