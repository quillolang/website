// /showcase/: what people built with Quillo. Signed-in people share a project (a name,
// its address, its source, a line and a few paragraphs about it, tags, a screenshot's
// address); each gets a page with its likes and comments. Moderated as comments are
// (community.qwe): shown at once, held for review when it looks like spam or is reported.

db.exec("create table if not exists projects (id integer primary key, user_id integer, name text, url text, repo text, summary text, body text, tags text, image text, status text, reports integer default 0, created integer)")

let SC_TAGS = ["app", "site", "api", "game", "tool", "library", "dashboard", "shop", "realtime", "open-source"]

fn sc_slug(name: str) = re.replace(re.replace(lower(name), "[^a-z0-9]+", "-"), "^-+|-+$", "")
fn sc_url_ok(u: str) = len(u) <= 300 && re.test(u, "^https?://[A-Za-z0-9.-]+\\.[A-Za-z]{2,}(:[0-9]+)?(/[^\\s<>\"]*)?$")
fn sc_image_ok(u: str) = u == "" || (starts_with(u, "https://") && sc_url_ok(u))

// The projects shown, with their likes: by `sort` ("liked" or "new"), with `tag` or all.
fn sc_projects(sort: str, tag: str) {
    let likes = db.query("select target, count(*) as n from votes where target like 'project:%' group by target")
    let liked = reduce(likes, {}, (m, r) => set(m, r.target, r.n))
    let rows = db.query("select p.*, u.login, u.name as author, u.avatar from projects p join users u on u.id = p.user_id where p.status = 'shown' and u.banned = 0 order by p.id desc")
        | map((p) => { ...p, likes: liked[`project:${p.id}`] ?? 0, tag_list: split(p.tags ?? "", ",") | filter((t) => t != "") })
        | filter((p) => tag == "" || contains(p.tag_list, tag))
    sort == "new" ? rows : sort_by(rows, (p) => -p.likes)
}

fn sc_project(id: int) = db.one("select p.*, u.login, u.name as author, u.avatar from projects p join users u on u.id = p.user_id where p.id = ?", id)

// A page of the site's own outside the docs: the showcase, the newsletter, the admin pages.
view SitePage(title: str, path: str, description: str, label: str, href: str, wide: bool = false, ld: list = [], children) =
    <html lang="en">
        <Head title={title} path={path} css={style + docs_style + blog_style + kit_style} description={description} ld={ld}
            fonts={["instrument-serif", "inter", "jetbrains-mono"]}/>
        <body.docs-body>
            <header.nav>
                <div.nav-left>
                    <a.brand href="/" aria-label="Quillo"><Logo/><span>Quillo<span.brand-ext>.qwe</span></span></a>
                    <a.docs-label href={href}>{label}</a>
                </div>
                <nav><a.nav-extra href="/docs/">Docs</a><a.nav-extra href="/components/">Components</a><a.nav-extra href="/plugins/">Plugins</a><a.nav-extra href="/blog/">Blog</a><Stars/></nav>
            </header>
            <main class={wide ? "site-main site-wide" : "site-main"}>{children}</main>
        </body>
    </html>

view ScCard(p) =
    <article.sc-card>
        <a.sc-shot href={`/showcase/${p.id}/`} tabindex="-1" aria-hidden="true">
            {p.image != null && p.image != ""
                ? <img src={p.image} alt="" loading="lazy" referrerpolicy="no-referrer"/>
                : <span>{upper(slice(p.name, 0, 1))}</span>}
        </a>
        <div.sc-text>
            <h2><a href={`/showcase/${p.id}/`}>{p.name}</a></h2>
            <p>{p.summary}</p>
            <p.sc-by><SiteAvatar login={p.login} avatar={p.avatar}/>{p.author ?? p.login}
                {for t in p.tag_list => <a.sc-tag href={`/showcase/?tag=${t}`}>#{t}</a>}</p>
        </div>
        <SiteLike target={`project:${p.id}`}/>
    </article>

route GET /showcase ? { sort: str = "liked", tag: str = "" } {
    let items = sc_projects(sort, tag)
    <SitePage title="Showcase · Quillo" path="/showcase/" label="Showcase" href="/showcase/"
              description="Apps, sites, APIs and games built with Quillo, shared by the people who made them.">
        <div.prose>
            <p.kicker>Showcase</p>
            <h1>Built with Quillo</h1>
            <p.lede>Apps, sites, APIs and games, shared by the people who made them. Made something? Show it here.</p>
        </div>
        <div.sc-tools>
            <a.kit-btn href="/showcase/new/">Share your project</a>
            <nav.sc-sort aria-label="Order">
                <a href={`/showcase/?sort=liked${tag != "" ? `&tag=${tag}` : ""}`} aria-current={sort != "new" ? "page" : null}>Most liked</a>
                <a href={`/showcase/?sort=new${tag != "" ? `&tag=${tag}` : ""}`} aria-current={sort == "new" ? "page" : null}>Newest</a>
            </nav>
        </div>
        <p.kit-chips>{for t in SC_TAGS => <a.kit-chip href={tag == t ? "/showcase/" : `/showcase/?tag=${t}`} aria-current={tag == t ? "page" : null}>{t}</a>}</p>
        {len(items) == 0
            ? <p.cm-empty>{tag == "" ? "Nothing here yet: be the first to share what you built." : `No projects tagged ${tag} yet.`}</p>
            : <div.sc-grid>{for p in items => <ScCard p={p}/>}</div>}
    </SitePage>
}

fn sc_form(problem: str?, f: map, me) =
    <SitePage title="Share your project · Quillo showcase" path="/showcase/new/" label="Showcase" href="/showcase/"
              description="Share an app, site, API or game you built with Quillo.">
        <div.prose>
            <p.kicker><a href="/showcase/">Showcase</a></p>
            <h1>Share your project</h1>
            <p.lede>It shows on the showcase at once, with your GitHub name. Projects that look like spam wait for a look first.</p>
        </div>
        {me == null
            ? <p.cm-signin-row><SiteSignIn next="/showcase/new/" text="Sign in with GitHub to share a project" ready={cm_ready()}/></p>
            : <form.cm-form.sc-form method="post" action="/showcase/new/">
                {problem != null && <p.cm-problem role="alert">{problem}</p>}
                <label>Name <input name="name" value={f.name ?? ""} maxlength="60" required/></label>
                <label>Address <input name="url" type="url" value={f.url ?? ""} placeholder="https://" maxlength="300" required/></label>
                <label>Source code <small>(optional)</small> <input name="repo" type="url" value={f.repo ?? ""} placeholder="https://github.com/..." maxlength="300"/></label>
                <label>In a line <input name="summary" value={f.summary ?? ""} maxlength="200" required placeholder="A booking site for a surf school, with live availability"/></label>
                <label>More <small>(optional, Markdown)</small> <textarea name="body" rows="6" maxlength="3000">{f.body ?? ""}</textarea></label>
                <label>Tags <small>(with commas: {join(SC_TAGS, ", ")})</small> <input name="tags" value={f.tags ?? ""} maxlength="100"/></label>
                <label>Screenshot address <small>(optional, an https image)</small> <input name="image" type="url" value={f.image ?? ""} maxlength="300"/></label>
                <input.cm-trap name="website" tabindex="-1" autocomplete="off" aria-hidden="true"/>
                <button.cm-btn>Share it</button>
              </form>}
    </SitePage>

route GET /showcase/new = sc_form(null, {}, cm_me_row())

route POST /showcase/new { form: { name: str = "", url: str = "", repo: str = "", summary: str = "", body: str = "", tags: str = "", image: str = "", website: str = "" } } {
    let me = cm_me_row()
    if me == null { return redirect("/auth/github?next=/showcase/new/") }
    let f = request.form
    let fail = (why: str) => respond(422, sc_form(why, f, me))
    if me.banned == 1 { return fail("This account cannot post here") }
    if website != "" { return fail("Something went wrong: try again") }
    let n = trim(name)
    let tag_list = split(lower(tags), ",") | map((t) => trim(t)) | filter((t) => re.test(t, "^[a-z0-9-]{2,20}$")) | unique | take(5)
    if len(n) < 2 || len(n) > 60 { return fail("A name of 2 to 60 characters") }
    if !sc_url_ok(trim(url)) { return fail("The address starts with https:// (or http://)") }
    if trim(repo) != "" && !sc_url_ok(trim(repo)) { return fail("The source code's address starts with https://") }
    if len(trim(summary)) < 10 || len(summary) > 200 { return fail("A line of 10 to 200 characters about it") }
    if len(body) > 3000 { return fail("At most 3,000 characters about it") }
    if !sc_image_ok(trim(image)) { return fail("The screenshot's address starts with https://") }
    if db.one("select count(*) as n from projects where user_id = ? and created > ?", me.id, now() - CM_DAY).n >= 3 { return fail("At most 3 projects a day") }
    let why = cm_hold_reason(me, body)
    db.exec("insert into projects (user_id, name, url, repo, summary, body, tags, image, status, created) values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
        me.id, n, trim(url), trim(repo), trim(summary), trim(body), join(tag_list, ","), trim(image), why == null ? "shown" : "held", now())
    let id = db.one("select max(id) as id from projects where user_id = ?", me.id).id
    redirect(`/showcase/${id}/`)
}

route GET /showcase/:id(int) {
    let p = sc_project(id) ?? reply 404 "No such project"
    let me = cm_me_row()
    let mine = me != null && me.id == p.user_id
    if p.status == "hidden" || (p.status == "held" && !mine && !cm_is_admin(me)) { reply 404 "No such project" }
    let tag_list = split(p.tags ?? "", ",") | filter((t) => t != "")
    let path = `/showcase/${id}/`
    <SitePage title={`${p.name} · Built with Quillo`} path={path} label="Showcase" href="/showcase/" description={`${p.name}: ${p.summary}`}
              ld={[seo_crumbs([["Quillo", "/"], ["Showcase", "/showcase/"], [p.name, path]])]}>
        <article.prose.sc-page>
            <p.kicker><a href="/showcase/">Showcase</a></p>
            <h1>{p.name}</h1>
            <p.lede>{p.summary}</p>
            {p.status == "held" && <p.cm-note>It waits for a look before others see it.</p>}
            <p.sc-by><SiteAvatar login={p.login} avatar={p.avatar}/>By <a href={`https://github.com/${p.login}`} rel="nofollow ugc">{p.author ?? p.login}</a> · {cm_ago(p.created)}
                {for t in tag_list => <a.sc-tag href={`/showcase/?tag=${t}`}>#{t}</a>}</p>
            <p.kit-actions>
                <a.kit-btn href={p.url} rel="nofollow ugc noopener" target="_blank">Visit</a>
                {p.repo != "" && <a.kit-btn.kit-btn-quiet href={p.repo} rel="nofollow ugc noopener" target="_blank">Source</a>}
                <SiteLike target={`project:${id}`}/>
            </p>
            {p.image != "" && <img.sc-hero src={p.image} alt={`${p.name}, a screenshot`} loading="lazy" referrerpolicy="no-referrer"/>}
            {p.body != "" && markdown(p.body)}
            {mine && <form method="post" action={`/showcase/${id}/delete/`}><button.cm-link>Take it down</button></form>}
        </article>
        <SiteThread page={path} title={p.name}/>
    </SitePage>
}

route POST /showcase/:id(int)/delete {
    let me = cm_me_row()
    let p = sc_project(id) ?? reply 404 "No such project"
    if me == null || (me.id != p.user_id && !cm_is_admin(me)) { reply 403 "Only its author can take it down" }
    db.exec("update projects set status = 'hidden' where id = ?", id)
    redirect("/showcase/")
}
