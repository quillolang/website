// The site's 404: one page for every path no route answers (the last route in main.qwe) and
// for every "no such ..." a route finds (a docs page, a plugin, a post). It is written as
// `quillo check` would report the missing page, with the nearest page there is as its
// "did you mean", and it answers with status 404 and noindex, so search engines leave it out.

// The headline, picked by the path so one address always gets the same one.
let NF_LINES = [
    ["This page took a `?` and passed its error up.", "And up. And all the way out to you."],
    ["We matched every route. Twice.", "Even the typed ones. Even `/*rest`, which is how you got here."],
    ["This page is `null`.", "Not an error value. Not `false`. Just `null`."],
    ["`quillo check` would have caught this.", "Links, sadly, are not checked against the internet."],
    ["The page you asked for passes `check`.", "It fails reality, which has no `--watch`."],
    ["Nothing here but an empty `match` arm.", "It is our only catch-all, and it caught you."],
    ["This route was `private` to another file.", "Or it never existed. The two look the same from here."],
    ["This page went out for a `server fn` call.", "It never came back. We are keeping its seat warm."],
]

// A line with `code` in backticks, the code as code.
fn nf_text(s: str) = enumerate(split(s, "`")) | map((p) => p[0] % 2 == 1 ? <code>{p[1]}</code> : p[1])

// Where each part of the site keeps its pages, so a miss is matched against its own kind.
fn nf_pages() =
    [{ path: "/" }, { path: "/docs/" }, { path: "/components/" }, { path: "/plugins/" }, { path: "/blog/" },
     { path: "/community/" }, { path: "/showcase/" }, { path: "/tools/" }, { path: "/coverage/" },
     { path: "/sponsors/" }, { path: "/newsletter/" }, { path: "/acknowledgements/" }, { path: "/search/" }]
    + (ordered | map((p) => { path: p.url })) + (ref_pages | map((p) => { path: p.url }))
    + (kit_items | map((c) => { path: `/components/${c.slug}/` }))
    + (plug_items | map((p) => { path: `/plugins/${p.slug}/` }))
    + (blog_posts | map((p) => { path: p.url }))

// A path's parts: `/docs/reference/len/` is ["docs", "reference", "len"].
fn nf_parts(path: str) = split(lower(path), "/") | filter((s) => s != "")

// Edits from `a` to `b`: letters put in, taken out or changed, each one.
fn nf_edits(a: str, b: str) -> int {
    let xs = split(a, "")
    let ys = split(b, "")
    let prev = range(len(ys) + 1)
    for i in range(len(xs)) {
        let cur = [i + 1]
        for j in range(len(ys)) {
            let cost = xs[i] == ys[j] ? 0 : 1
            cur = push(cur, min([prev[j + 1] + 1, cur[j] + 1, prev[j] + cost]))
        }
        prev = cur
    }
    last(prev)
}

// Edits from one path's parts to another's, part by part; null when a part is too far apart
// in length to be a slip, which spares the count for most pages.
fn nf_path_edits(want: list, parts: list) {
    let total = 0
    for i in range(len(want)) {
        if want[i] != parts[i] {
            if abs(len(want[i]) - len(parts[i])) > 3 { return null }
            total += nf_edits(want[i], parts[i])
        }
    }
    total
}

// The page nearest the missed one, among pages with as many parts, by the spelling of every
// part: `/docs/rotes/` is `/docs/routes/`, and `/pludgins/mime/` is `/plugins/mime/` (a slip
// in the section too, found by a visitor). Null when none is near enough to be what was meant.
fn nf_nearest(path: str) {
    let want = nf_parts(path)
    if len(want) == 0 { return null }
    let letters = len(join(want, ""))
    let near = nf_pages()
        | map((p) => nf_parts(p.path))
        | filter((parts) => len(parts) == len(want))
        | map((parts) => { path: `/${join(parts, "/")}/`, d: nf_path_edits(want, parts) })
        | filter((p) => p.d != null)
        | sort_by((p) => p.d)
    let best = first(near)
    best != null && best.d <= max([2, letters / 4]) ? best.path : null
}

// What to search for: the path's last part, its dashes as spaces.
fn nf_query(path: str) {
    let parts = nf_parts(path)
    len(parts) == 0 ? "" : replace(replace(last(parts), "-", " "), "_", " ")
}

view NotFound(path: str, what: str = "page") {
    let line = NF_LINES[len(path) % len(NF_LINES)]
    let near = nf_nearest(path)
    <SitePage title="Page not found · Quillo" path={path} label="404" href="/" noindex={true}
              description="There is no page at this address on quillolang.org.">
        <div.prose.nf>
            <p.kicker>404</p>
            <h1>{nf_text(line[0])}</h1>
            <p.lede>{nf_text(line[1])}</p>
            <div.nf-check role="img" aria-label={`quillo check says: unknown ${what} ${path}`}>
                <div><span.nf-prompt>$</span> quillo check {path}</div>
                <div><span.nf-err>error:</span> unknown {what} <b>{path}</b>{near != null ? ` (did you mean ${near}?)` : ""}</div>
                <div.nf-note>quillo: 1 error, 0 warnings, and no page</div>
            </div>
            {near != null && <p.nf-near>Did you mean <a href={near}>{near}</a>?</p>}
            <form.nf-search role="search" action="/search/" method="get">
                <input type="search" name="q" value={nf_query(path)} placeholder="Search the docs, components and plugins" aria-label="Search"/>
                <button type="submit">Search</button>
            </form>
            <p>Or start again from somewhere that exists:</p>
            <ul.nf-ways>
                <li><a href="/docs/">The docs</a>: the guide, from installing to deploying</li>
                <li><a href="/docs/reference/">The reference</a>: every builtin, with examples that run</li>
                <li><a href="/components/">Components</a> and <a href="/plugins/">plugins</a></li>
                <li><a href="/">The home page</a>, where it all compiles</li>
            </ul>
            <p.nf-small>A link here that should work? Tell us on <a href={DISCORD}>Discord</a> or open an issue on <a href={`${REPO}/issues`}>GitHub</a>.</p>
        </div>
    </SitePage>
}

fn not_found(path: str, what: str = "page") = respond(404, <NotFound path={path} what={what}/>)
