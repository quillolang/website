// Search across the site: docs, the function reference, the blog, plugins and
// components. The docsearch plugin reads the site's own sitemap as it starts, fetches
// each page from where the site listens, and indexes each section of its <main>, so
// what it finds is what the pages show, down to the heading (/docs/routes/#route-groups).
// Visitors' posts (/community/, /showcase/) and the tag lists are left out.
//
// SiteSearch is the box in every page's header: it finds as you type, and without
// JavaScript it is a form to /search/, the page of all results.

use "plugins/docsearch.qwer"

// Where the site reads its own pages: where it listens. SEARCH_FROM names it when the
// port is given with --port rather than $PORT.
let SEARCH_FROM = env("SEARCH_FROM") ?? `http://127.0.0.1:${env("PORT") ?? "8080"}`

let SEARCH_KINDS = ["Docs", "Reference", "Blog", "Plugins", "Components"]

// The crawl runs in the background: the sitemap is asked for until the server answers,
// and searches find nothing until the first crawl is done (the page says so).
let search_crawl = docsearch_crawl("site", `${SEARCH_FROM}/sitemap.txt`, {
    exclude: ["/community/", "/showcase/", "/plugins/tags/", "/components/tags/"],
    kinds: { "/docs/reference/": "Reference", "/docs/": "Docs", "/blog/": "Blog", "/plugins/": "Plugins", "/components/": "Components", "/": "Pages" },
    boost: { "Docs": 1.3, "Reference": 1.2 },
    // A page's likes, its thread, its pager, its live demos and its list of related
    // items say nothing of what it is about.
    skip: [".cm-bar", ".cm-thread", ".cm-fab", ".cm-trap", ".pager", ".edit", ".kit-copy", ".kit-actions", ".kit-stage", "#related", ".kit-cards"],
    // highlight() puts each line of code in a span the stylesheet shows as a line.
    lines: [".ln"],
    // The server makes one page at a time: two asked at once keep the crawl as fast,
    // and a visitor waits behind at most two.
    concurrency: 2,
})

// What was typed, as the index is asked: at most 200 characters.
fn search_text(q: str) = slice(trim(q), 0, 200)

// How the crawl went: pages read, left out, errors. For whoever deploys the site.
route GET /search/status = docsearch_status("site")

// For the header's box: one result a page.
server fn site_search(q: str) {
    let text = search_text(q)
    len(text) < 2 ? { total: 0, hits: [] } : docsearch_query("site", text, { limit: 8, per_page: 1 })
}

view SearchSnippet(pieces: list) =
    <span.ss-snippet>{for s in pieces => s.hit ? <mark>{s.text}</mark> : s.text}</span>

view SearchHitTitle(h: map) =
    <span.ss-title>{h.title}{h.heading != "" && <span.ss-heading> › {h.heading}</span>}</span>

// The box in the header. It is a form to /search/ first; once the page runs, it shows
// the best results under it as you type, a moment after you stop.
component SiteSearch() {
    state q = ""
    state asked = ""
    state hits = []
    state open = false
    state active = -1
    let text = trim(q)
    if text != asked && len(text) >= 2 {
        every(150, () => {
            let mine = text
            asked = mine
            let r = site_search(mine)
            if mine == trim(q) {
                hits = is_err(r) ? [] : r.hits
                active = -1
                open = true
            }
        })
    }
    if len(text) < 2 && (len(hits) > 0 || asked != "") {
        hits = []
        asked = ""
    }
    <form.site-search role="search" action="/search/" method="get">
        <input type="search" name="q" bind:value={q} placeholder="Search" aria-label="Search the site" autocomplete="off"
            role="combobox" aria-expanded={open && len(hits) > 0 ? "true" : "false"} aria-controls="ss-list"
            aria-activedescendant={active >= 0 ? `ss-${active}` : null}
            @focus={() => { open = true }}
            @blur={() => { open = false }}
            @keydown={(e) => {
                if e.key == "ArrowDown" && len(hits) > 0 {
                    e.preventDefault()
                    open = true
                    active = active + 1 >= len(hits) ? 0 : active + 1
                } else if e.key == "ArrowUp" && len(hits) > 0 {
                    e.preventDefault()
                    active = active <= 0 ? len(hits) - 1 : active - 1
                } else if e.key == "Enter" && open && active >= 0 && active < len(hits) {
                    e.preventDefault()
                    navigate(hits[active].url)
                } else if e.key == "Escape" {
                    open = false
                    active = -1
                }
            }}/>
        // A press on a result keeps the focus in the box, so the click that follows lands.
        {open && len(hits) > 0 &&
            <ul.ss-list id="ss-list" role="listbox" aria-label="Results" @mousedown={(e) => { e.preventDefault() }}>
                {for [i, h] in enumerate(hits) =>
                    <li key={h.url} id={`ss-${i}`} role="option" aria-selected={i == active ? "true" : "false"} class={i == active && "ss-active"}>
                        <a href={h.url}>
                            <span.ss-kind>{h.kind}</span>
                            <SearchHitTitle {h}/>
                            <SearchSnippet pieces={h.snippet}/>
                        </a>
                    </li>}
                <li.ss-all role="option" aria-selected="false"><a href={`/search/?q=${url_encode(text)}`}>All results for “{text}”</a></li>
                // What finds them: a plugin from the catalog, as any Quillo site could use it.
                <li.ss-by role="option" aria-selected="false"><a href="/plugins/docsearch/">Search by <code>docsearch.qwer</code>, a Quillo plugin <span aria-hidden="true">→</span></a></li>
            </ul>}
    </form>
}

// The page of all results, with a tab for each kind. Search engines are asked not to
// index it: a page of results is not a page of the site.
route GET /search ? { q: str = "", kind: str = "" } {
    let text = search_text(q)
    let k = contains(SEARCH_KINDS, kind) ? kind : ""
    let status = docsearch_status("site")
    let found = text == "" ? { total: 0, hits: [] } : docsearch_query("site", text, { limit: 50, per_page: 2, kind: k == "" ? null : k })
    let counts = text == "" || is_err(found) ? {} : reduce(SEARCH_KINDS, {}, (m, x) => set(m, x, (docsearch_query("site", text, { limit: 1, kind: x }) ?? { total: 0 }).total))
    let link = (x: str) => `/search/?q=${url_encode(text)}${x == "" ? "" : `&kind=${url_encode(x)}`}`
    <SitePage title={text == "" ? "Search · Quillo" : `${text} · Search · Quillo`} path="/search/" label="Search" href="/search/"
              description="Search the Quillo docs, the function reference, the blog, plugins and components." noindex={true}>
        <div.prose.search-page>
            <h1>Search</h1>
            <form.search-form role="search" action="/search/" method="get">
                <input type="search" name="q" value={text} placeholder="Routes, set_cookie, live data…" aria-label="Search the site" autofocus/>
                {k != "" && <input type="hidden" name="kind" value={k}/>}
                <button>Search</button>
            </form>
            <p.ss-by-line>Found by <a href="/plugins/docsearch/"><code>docsearch.qwer</code></a>, a Rust plugin from the catalog: as the site starts,
                it reads the sitemap, fetches each page and indexes every section, so a result opens at its heading.</p>
            {status.state == "crawling" && <p.ss-note>The search is still reading the site: {status.done} of {status.total} pages so far. Ask again in a moment.</p>}
            {status.state == "failed" && <p.ss-note>The search could not read the site: {status.message}</p>}
            {text != "" && !is_err(found) &&
                <nav.ss-tabs aria-label="Kinds">
                    <a href={link("")} class={k == "" && "active"}>All</a>
                    {for x in SEARCH_KINDS => <a href={link(x)} class={k == x && "active"}>{x} <span.ss-count>{counts[x] ?? 0}</span></a>}
                </nav>}
            {is_err(found) ? <p.ss-note>{found.error}</p>
                : text == "" ? <p.muted>Type a word, a function's name or part of one: set_cookie, live, every, money.</p>
                : found.total == 0 ? <p.muted>Nothing found for “{text}”.</p>
                : <ol.ss-results>{for h in found.hits =>
                    <li>
                        <a href={h.url}><span.ss-kind>{h.kind}</span><SearchHitTitle {h}/></a>
                        <span.ss-path>{h.url}</span>
                        <p><SearchSnippet pieces={h.snippet}/></p>
                    </li>}</ol>}
        </div>
    </SitePage>
}
