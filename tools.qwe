// /tools/: the editor plugins and the browser's developer tools for Quillo. Each editor's
// support lives in quillolang/editors, one folder each; Quillo DevTools in
// quillolang/devtools. The logos come from tool-icons.json, written by
// tools/tool-icons.mjs from Simple Icons (CC0); the products it has none for get a line
// icon of the page's own (TOOL_LINE_ICONS).

let TOOL_ICONS = json.parse(read_file("tool-icons.json")).icons
let EDITORS_REPO = "https://github.com/quillolang/editors"
let DEVTOOLS_REPO = "https://github.com/quillolang/devtools"
let VSCODE_MARKETPLACE = "https://marketplace.visualstudio.com/items?itemName=quillolang.quillo-lang"

// Line icons, 24 by 24, drawn with a stroke: an editor's window, a browser, a tree, a
// highlighter, a terminal.
let TOOL_LINE_ICONS = {
    editor: "M3.5 4.5h17v15h-17z M3.5 8h17 M10 11.5l-2.5 2.5 2.5 2.5 M14 11.5l2.5 2.5-2.5 2.5",
    browser: "M12 3a9 9 0 1 0 0 18 9 9 0 1 0 0-18z M3 12h18 M12 3c-3.2 3.2-3.2 14.8 0 18 M12 3c3.2 3.2 3.2 14.8 0 18",
    tree: "M12 4.5v4 M12 8.5l-5.5 5 M12 8.5l5.5 5 M6.5 13.5v4 M17.5 13.5v4 M10 2.5h4v3h-4z M4.5 17.5h4v3h-4z M15.5 17.5h4v3h-4z",
    highlight: "M4.5 20.5h8 M14 4l6 6-8.5 8.5H5.5v-6z M11.5 6.5l6 6",
    terminal: "M3.5 4.5h17v15h-17z M7 10l3 2.5-3 2.5 M12.5 15.5h4.5",
}

// What an editor gets: shown as chips.
let TOOL_FEATURES = {
    hl: "Highlighting",
    lsp: "Language server",
    dap: "Debugger",
    snippets: "Snippets",
    run: "Run and check",
}

// The editors, in the order people look for them. `icon` is a Simple Icons slug, or `line`
// one of TOOL_LINE_ICONS; `also` the editors that take the same plugin.
let TOOL_EDITORS = [
    { name: "VS Code", line: "editor", folder: "vscode",
      what: "Highlighting, diagnostics as you type, quick fixes, hover, go to definition, completion, parameter hints, the outline, end tags as you type, snippets, a debugger for the server and the browser side, and Quillo: New program.",
      features: ["hl", "lsp", "dap", "snippets", "run"],
      install: { label: "Visual Studio Marketplace", href: VSCODE_MARKETPLACE },
      also: ["vscodium", "cursor", "windsurf", "gitpod"],
      also_note: "VSCodium, Cursor, Windsurf and Gitpod take the same extension, as its .vsix until it is on Open VSX." },
    { name: "JetBrains IDEs", icon: "jetbrains", folder: "jetbrains",
      what: "IntelliJ IDEA, WebStorm, PyCharm and the others from 2025.3, and Android Studio from Rabbit 2: VS Code's grammars, the language server through LSP4IJ, live templates, run configurations and a debugger.",
      features: ["hl", "lsp", "dap", "snippets", "run"],
      also: ["intellijidea", "webstorm", "pycharm", "androidstudio"] },
    { name: "Zed", icon: "zedindustries", folder: "zed",
      what: "tree-sitter-quillo for highlighting, the outline and brackets; quillo lsp; and a Quillo debugger through quillo dap.",
      features: ["hl", "lsp", "dap"] },
    { name: "Neovim", icon: "neovim", folder: "neovim",
      what: "Filetypes, tree-sitter-quillo through nvim-treesitter, quillo lsp through vim.lsp.config, and nvim-dap.",
      features: ["hl", "lsp", "dap"] },
    { name: "Helix", icon: "helix", folder: "helix",
      what: "A languages.toml entry with tree-sitter-quillo, its queries and textobjects, quillo lsp and quillo dap.",
      features: ["hl", "lsp", "dap"] },
    { name: "Emacs", icon: "gnuemacs", folder: "emacs",
      what: "quillo-ts-mode on tree-sitter-quillo (Emacs 29 and later) or quillo-mode without it, eglot for quillo lsp and dape for quillo dap.",
      features: ["hl", "lsp", "dap"] },
    { name: "Sublime Text", icon: "sublimetext", folder: "sublime",
      what: "VS Code's grammars, quillo lsp through the LSP package, and a build system that runs and checks the file.",
      features: ["hl", "lsp", "run"] },
    { name: "Vim", icon: "vim", folder: "vim",
      what: "A syntax file, indentation and :make with quillo check, with no language server needed; and the setup for Vim's LSP clients.",
      features: ["hl", "run"] },
    { name: "Eclipse", icon: "eclipseide", folder: "",
      what: "VS Code's grammar through TM4E, and quillo lsp and quillo dap through LSP4E, set up by hand.",
      features: ["hl", "lsp", "dap"], setup: "#eclipse" },
    { name: "Visual Studio", line: "editor", folder: "",
      what: "VS Code's grammar in Visual Studio's own TextMate folder, for highlighting. The language server needs an extension that is not there yet.",
      features: ["hl"], setup: "#visual-studio" },
]

// For pages that show Quillo code rather than edit it.
let TOOL_HIGHLIGHTERS = [
    { name: "tree-sitter-quillo", line: "tree", folder: "tree-sitter",
      what: "The grammar Zed, Neovim, Helix and Emacs use, with its queries: every .qwe file of Quillo's repositories parses with it." },
    { name: "Shiki", line: "highlight", folder: "highlighters",
      what: "The TextMate grammar for Shiki: VitePress, Astro, Nuxt Content." },
    { name: "highlight.js", line: "highlight", folder: "highlighters",
      what: "A language definition for highlight.js 11." },
    { name: "Prism", line: "highlight", folder: "highlighters",
      what: "A language definition for Prism: Docusaurus, Gatsby." },
    { name: "pandoc and Kate", icon: "pandoc", folder: "highlighters/kde",
      what: "A KDE syntax file, for Kate and for pandoc's printed books." },
]

fn tool_folder(folder: str) = folder == "" ? `${EDITORS_REPO}#readme` : `${EDITORS_REPO}/tree/main/${folder}`

// A tool's icon: its logo on a tile of its colour, or a line icon on the page's own.
view ToolIcon(slug: str? = null, line: str? = null, size: str = "") = {
    let i = slug != null ? TOOL_ICONS[slug] : null
    i != null
        ? <span class={`tool-icon ${size}`} style={`background:#${i.hex}`} title={i.title}>
              <svg viewBox="0 0 24 24" role="img" aria-label={i.title}><path d={i.path} fill={i.on}/></svg>
          </span>
        : <span class={`tool-icon tool-icon-line ${size}`} aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d={TOOL_LINE_ICONS[line ?? "editor"]}/></svg>
          </span>
}

view ToolCard(t: map) =
    <article.tool-card>
        <div.tool-head>
            <ToolIcon slug={t.icon} line={t.line}/>
            <h3>{t.name}</h3>
        </div>
        <p>{t.what}</p>
        {t.features != null && <ul.tool-features>{for f in t.features => <li>{TOOL_FEATURES[f]}</li>}</ul>}
        {t.also != null && <div.tool-also>
            {for a in t.also => <ToolIcon slug={a} size="tool-icon-small"/>}
            {t.also_note != null && <span.tool-note>{t.also_note}</span>}
        </div>}
        <p.tool-links>
            {t.install != null && <a href={t.install.href}>{t.install.label}</a>}
            {t.setup != null
                ? <a href={`${EDITORS_REPO}${t.setup}`}>Set it up</a>
                : <a href={tool_folder(t.folder)}>{t.install != null ? "Source" : "Install"}</a>}
        </p>
    </article>

route GET /tools =
    <SitePage title="Editors and browser tools" path="/tools/" label="Tools" href="/tools/"
              description="Quillo in VS Code, the JetBrains IDEs, Zed, Neovim, Helix, Emacs, Sublime Text, Vim and more, and Quillo DevTools in Chrome and Edge: what each gives and how to install it.">
        <div.prose.tools>
            <p.kicker>Tools</p>
            <h1>Editors and browser tools</h1>
            <p.lede>Every editor here talks to the same two programs, built into the <code>quillo</code> binary:
                <code>quillo lsp</code>, the language server, and <code>quillo dap</code>, the debugger.
                Install <a href="/docs/install">quillo</a>, then the plugin for your editor.</p>

            <h2 id="editors">Editors and IDEs</h2>
            <div.tool-grid>{for t in TOOL_EDITORS => <ToolCard t={t}/>}</div>

            <h2 id="browser">In the browser</h2>
            <div.tool-grid>
                <article.tool-card.tool-wide>
                    <div.tool-head>
                        <ToolIcon slug="googlechrome"/>
                        <ToolIcon line="browser"/>
                        <h3>Quillo DevTools</h3>
                    </div>
                    <p>A Quillo panel in the developer tools of Chrome and Edge (111 and later), for pages Quillo makes:
                        the components on the page with their props and state, and where each prop comes from; the server fn
                        calls it makes; live updates; the errors Quillo catches; and the server's health and query times.</p>
                    <ul.tool-features><li>Components</li><li>Calls</li><li>Live</li><li>Errors</li><li>Server</li></ul>
                    <p>Until it is in the browsers' stores: <code>chrome://extensions</code> (or <code>edge://extensions</code>),
                        Developer mode, <strong>Load unpacked</strong>, and the repository's <code>extension/</code> folder.
                        Firefox is not supported yet.</p>
                    <p.tool-links><a href={`${DEVTOOLS_REPO}#install`}>Install</a><a href={DEVTOOLS_REPO}>Source</a></p>
                </article>
            </div>

            <h2 id="highlighters">For documentation and books</h2>
            <div.tool-grid>{for t in TOOL_HIGHLIGHTERS => <ToolCard t={t}/>}</div>

            <h2 id="other">Any other editor</h2>
            <p>An editor that speaks the Language Server Protocol can run <code>quillo lsp</code> on stdin and stdout,
                for diagnostics, completion, hover, go to definition, references, rename and signature help; one that speaks
                the Debug Adapter Protocol can run <code>quillo dap</code>, with the launch fields <code>program</code>,
                <code>args</code>, <code>cwd</code> and <code>stopOnEntry</code>. See <a href="/docs/install">Install</a>
                and the <a href={EDITORS_REPO}>editors repository</a>.</p>

            <p.tool-credit>Logos from <a href="https://simpleicons.org">Simple Icons</a> (CC0); each is the trademark of its
                owner, shown to say that Quillo works with it. VS Code, Visual Studio and Edge, which Simple Icons does not
                carry, and the highlighters are shown with a plain icon.</p>
        </div>
    </SitePage>
