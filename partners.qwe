// /plugins/partners/: an invitation to the people behind a technology (a database, an
// API, an SDK, a protocol, a device) to build its Quillo plugin with us. A short form
// keeps each request in the site's database; admins read them at /admin/partners/.

db.exec("create table if not exists partner_requests (id integer primary key, company text, name text, email text, technology text, website text, message text, ip text, status text, created integer)")

fn pt_page(problem: str?, f: map, sent: bool) =
    <SitePage title="Build your plugin with us · Quillo" path="/plugins/partners/" label="Plugins" href="/plugins/"
              description="Own a database, an API, an SDK or a device? Build its official Quillo plugin with us: reviewed, tested before every release, installed with quillo install.">
        <div.prose>
            <p.kicker><a href="/plugins/">Plugins</a></p>
            <h1>Build your technology's Quillo plugin <em>with us</em></h1>
            <p.lede>Own a database, an API, an SDK, a protocol or a device? Give Quillo developers a plugin that is yours:
                one <code>.qwer</code> file, installed with <code>quillo install</code>, beside {len(plug_items)} others.</p>
            <h2 id="what">What you get</h2>
            <ul>
                <li><b>An official plugin,</b> listed with your name and a link to you, on its own page with its functions, an
                    example program, code samples from its users, comments and likes.</li>
                <li><b>Help writing it.</b> We write the first version with you, or review yours: Quillo's types, the example,
                    the edge cases. You keep ownership and the versions.</li>
                <li><b>Tested before every release.</b> Each plugin is built and its example run whenever the catalog changes,
                    so a Quillo update never breaks yours unnoticed.</li>
                <li><b>Announced together,</b> on the blog and in the newsletter, when it goes live.</li>
            </ul>
            <h2 id="how">How it works</h2>
            <ol.plug-steps>
                <li><b>Tell us</b> what your technology is and what developers do with it, below.</li>
                <li><b>We agree on the functions:</b> what a Quillo program calls, and what comes back.</li>
                <li><b>The plugin is written,</b> by you, by us, or together, from <a href="/docs/rust/">the Rust page</a>{" "}and the {len(plug_items)} plugins already here.</li>
                <li><b>It goes live:</b> in the catalog, at <code>quillo install your-plugin</code>, with its version.</li>
            </ol>
            <h2 id="talk">Let's talk</h2>
        </div>
        {sent
            ? <p.cm-note role="status">Thank you: we have it, and will write back within a few days.</p>
            : <form.cm-form.sc-form method="post" action="/plugins/partners/">
                {problem != null && <p.cm-problem role="alert">{problem}</p>}
                <label>Company or project <input name="company" value={f.company ?? ""} maxlength="100" required/></label>
                <label>Your name <input name="name" value={f.name ?? ""} maxlength="100" required/></label>
                <label>Email <input name="email" type="email" value={f.email ?? ""} maxlength="254" required/></label>
                <label>The technology <input name="technology" value={f.technology ?? ""} maxlength="150" required placeholder="A database, an API, an SDK, a device..."/></label>
                <label>Its website <small>(optional)</small> <input name="website" type="url" value={f.website ?? ""} maxlength="300" placeholder="https://"/></label>
                <label>What should the plugin do? <small>(optional)</small> <textarea name="message" rows="5" maxlength="3000">{f.message ?? ""}</textarea></label>
                <input.cm-trap name="url" tabindex="-1" autocomplete="off" aria-hidden="true"/>
                <button.cm-btn>Send</button>
              </form>}
        <div.prose><p>Or find us on <a href={DISCORD}>Discord</a>, or open an issue in <a href="https://github.com/quillolang/website/issues">quillolang/website</a>.</p></div>
    </SitePage>

route GET /plugins/partners = pt_page(null, {}, false)

route POST /plugins/partners { form: { company: str = "", name: str = "", email: str = "", technology: str = "", website: str = "", message: str = "", url: str = "" } } {
    let f = request.form
    let fail = (why: str) => respond(422, pt_page(why, f, false))
    if url != "" { return fail("Something went wrong: try again") }
    if len(trim(company)) < 2 || len(trim(name)) < 2 || len(trim(technology)) < 2 { return fail("Fill in the company, your name and the technology") }
    if !nl_email_ok(lower(trim(email))) { return fail("That email address does not look right") }
    if trim(website) != "" && !sc_url_ok(trim(website)) { return fail("The website's address starts with https://") }
    if len(message) > 3000 { return fail("At most 3,000 characters") }
    let ip = crypto.sha256(`${env("QUILLO_SECRET") ?? "dev"}:${request.ip}`)
    if db.one("select count(*) as n from partner_requests where ip = ? and created > ?", ip, now() - CM_DAY).n >= 3 { return fail("We have your requests already: we will write back") }
    db.exec("insert into partner_requests (company, name, email, technology, website, message, ip, status, created) values (?, ?, ?, ?, ?, ?, ?, 'new', ?)",
        trim(company), trim(name), lower(trim(email)), trim(technology), trim(website), trim(message), ip, now())
    pt_page(null, {}, true)
}

route GET /admin/partners {
    let g = adm_gate("/admin/partners/")
    if g.stop != null { return g.stop }
    let rows = db.query("select * from partner_requests order by id desc limit 200")
    adm_page("Plugin partners", "pt", [
        <p.cm-empty>{len(rows) == 0 ? "No requests yet." : `${len(rows)} request${len(rows) == 1 ? "" : "s"}, newest first.`}</p>,
        <div>{for r in rows =>
            <article.adm-item>
                <header><b>{r.company}</b> · {r.technology} · {cm_ago(r.created)}
                    {r.website != "" && <span> · <a href={r.website} rel="nofollow noopener">{r.website}</a></span>}</header>
                <p>{r.name}, <a href={`mailto:${r.email}`}>{r.email}</a></p>
                {r.message != "" && <pre.adm-text>{r.message}</pre>}
            </article>}</div>,
    ])
}
