// /plugins/: Rust plugins for Quillo, one .qwer file each, from plugins/ in this
// repository. Each gets a page with its functions (read from the Rust, with Quillo's
// types), the crates it uses, an example program and its source; export.sh copies the
// files themselves (plugins/*.qwer, their examples and a zip of them all) into dist/.
//
// The index finds plugins as one types, by group and by tags, with the components'
// search (components.qwe); each tag has a page of its own (/plugins/tags/<tag>/).
// plugins/test.mjs runs every example and asks it what catalog.json says to try.

let PLUG_GROUPS = ["Data formats", "Files", "Security", "Text", "Validation", "Time and IDs", "Media", "Services", "Places"]
let PLUG_REPO = "https://github.com/quillolang/website/blob/main/plugins"

let plug_catalog = json.parse(read_file("plugins/catalog.json"))
let plug_items = PLUG_GROUPS | map((g) => plug_catalog | filter((p) => p.group == g) | sort_by((p) => lower(p.name))) | flatten

fn plug_group(g: str) = plug_items | filter((p) => p.group == g)
fn plug_groups_used() = PLUG_GROUPS | filter((g) => len(plug_group(g)) > 0)

fn plug_tags() {
    let all_tags = plug_items | map((p) => p.tags) | flatten
    all_tags | unique | sort | map((t) => { tag: t, n: len(all_tags | filter((x) => x == t)) }) | sort_by((t) => -t.n)
}

fn plug_tagged(tag: str) = plug_items | filter((p) => contains(p.tags, tag))

fn plug_related(p) {
    let score = (x) => len(x.tags | filter((t) => contains(p.tags, t))) + (x.group == p.group ? 1 : 0)
    plug_items | filter((x) => x.slug != p.slug && score(x) > 1) | sort_by((x) => -score(x)) | take(6)
}

// ---- reading a .qwer file ------------------------------------------------------------

// The pieces of `s` at its commas, but not those inside `<...>`: a signature's parameters.
fn split_top(s: str) {
    let st = reduce(split(s, ""), { parts: [], cur: "", depth: 0 }, (st, c) =>
        c == "<" ? merge(st, { cur: st.cur + c, depth: st.depth + 1 })
        : c == ">" ? merge(st, { cur: st.cur + c, depth: st.depth - 1 })
        : c == "," && st.depth == 0 ? merge(st, { parts: push(st.parts, trim(st.cur)), cur: "" })
        : merge(st, { cur: st.cur + c }))
    trim(st.cur) == "" ? st.parts : push(st.parts, trim(st.cur))
}

let PLUG_TYPES = { "str": "str", "String": "str", "char": "str", "i64": "int", "i32": "int", "u32": "int", "u64": "int",
                   "usize": "int", "f64": "float", "f32": "float", "bool": "bool", "Value": "any", "serde_json::Value": "any", "()": "null" }

// A Rust type as the Quillo value that crosses (see the Rust page of the docs).
fn qtype(t0: str) {
    let t = trim(replace(t0, "&", ""))
    if starts_with(t, "Result<") { return qtype(first(split_top(slice(t, 7, len(t) - 1)))) }
    if starts_with(t, "Option<") { return qtype(slice(t, 7, len(t) - 1)) + "?" }
    if starts_with(t, "Vec<") { return "list" }
    if contains(t, "HashMap<") || contains(t, "BTreeMap<") { return "map" }
    PLUG_TYPES[t] ?? t
}

// `name(params) -> ret {`, after `pub fn `, with its doc comment.
fn plug_sig(rest: str, doc: str) {
    let open = index_of(rest, "(")
    let close = index_of(rest, ")")
    let arrow = index_of(rest, ") -> ")
    let ret = arrow != null ? trim(slice(rest, arrow + 5, len(rest) - 2)) : "()"
    let params = split_top(slice(rest, open + 1, close)) | map((p) => {
        let colon = index_of(p, ":")
        { name: trim(slice(p, 0, colon)), type: qtype(slice(p, colon + 1)) }
    })
    { name: slice(rest, 0, open), params, ret: qtype(ret), fails: starts_with(ret, "Result<"), doc }
}

// Its top-level `pub fn`s, each with the `///` lines above it.
fn plug_exports(src: str) =
    reduce(split(src, "\n"), { out: [], doc: [] }, (st, l) =>
        starts_with(l, "///") ? merge(st, { doc: push(st.doc, trim(slice(l, 3))) })
        : starts_with(l, "pub fn ") ? { out: push(st.out, plug_sig(slice(l, 7), join(st.doc, " "))), doc: [] }
        : merge(st, { doc: [] })).out

// The `//!` header: the first line says what it is; the lines after `[dependencies]` are its crates.
fn plug_header(src: str) {
    let lines = reduce(split(src, "\n"), { out: [], done: false }, (st, l) =>
        !st.done && starts_with(l, "//!") ? merge(st, { out: push(st.out, trim(slice(l, 3))) }) : merge(st, { done: true })).out
    let at = index_of(lines, "[dependencies]")
    { about: first(lines) ?? "", crates: at == null ? [] : drop(lines, at + 1) | filter((l) => l != "") }
}

fn plug_source(slug: str) = read_file(`plugins/${slug}.qwer`)
fn plug_example(slug: str) = trim(read_file(`plugins/${slug}.qwe`))

// The crates' names, for a card: `csv`, `rust_xlsxwriter`.
fn crate_names(crates: list) = crates | map((l) => trim(slice(l, 0, index_of(l, "=") ?? len(l))))

// ---- the pages ------------------------------------------------------------------------

view PlugSide(current: str) {
    let cur = find(plug_items, (p) => p.slug == current)
    <aside.sidebar aria-label="Plugins">
        <div.kit-side-head>
            <input.kit-side-q type="search" id="kit-side-q" placeholder="Filter plugins" aria-label="Filter the plugins"
                   autocomplete="off" hidden/>
        </div>
        <div.side-group.current>
            <ul><li><a href="/plugins/" class={current == "" && "active"}
                       aria-current={current == "" ? "page" : null}>All {len(plug_items)} plugins</a></li>
                <li><a href="/plugins/tags/" class={current == "#tags" && "active"}
                       aria-current={current == "#tags" ? "page" : null}>Browse by tag</a></li>
                <li><a href="/docs/rust/">Writing one</a></li></ul>
        </div>
        <p.kit-side-none id="kit-side-none" hidden>Nothing matches.</p>
        {for g in plug_groups_used() =>
            <details.side-group.kit-side-group open={cur != null && cur.group == g}>
                <summary><span>{g}</span><small>{len(plug_group(g))}</small></summary>
                <ul>{for p in plug_group(g) =>
                    <li data-find={lower(join([p.name, p.slug] + p.tags, " "))}>
                        <a href={`/plugins/${p.slug}/`} class={p.slug == current && "active"}
                           aria-current={p.slug == current ? "page" : null}>{p.name}</a></li>}</ul>
            </details>}
    </aside>
}

view PlugPage(title: str, path: str, description: str, current: str, ld: list = [], children) =
    <html lang="en">
        <Head title={title} path={path} css={style + docs_style + kit_style + plug_style}
            description={description} fonts={["instrument-serif", "inter", "jetbrains-mono"]} ld={ld}/>
        <body.docs-body>
            <header.nav>
                <div.nav-left>
                    <a.brand href="/"><Logo/>Quillo</a>
                    <a.docs-label href="/plugins/">Plugins</a>
                </div>
                <nav><a.nav-extra href="/docs/">Docs</a><a.nav-extra href="/components/">Components</a><a.nav-extra href="/blog/">Blog</a><Stars/></nav>
            </header>
            <div.docs.kit>
                <input type="checkbox" id="docs-menu" hidden/>
                <label.menu-button for="docs-menu">Plugins</label>
                <PlugSide current={current}/>
                <script>{raw(replace(kit_side_script, "quillo-kit-side", "quillo-plug-side"))}</script>
                <main.kit-main>{children}</main>
            </div>
            <script>{raw(kit_stage_script)}</script>
        </body>
    </html>

view PlugCard(p) =
    <a.card.kit-card href={`/plugins/${p.slug}/`} data-kit-item data-slug={p.slug} data-name={p.name}
       data-group={p.group} data-summary={p.summary + " " + join(crate_names(plug_header(plug_source(p.slug)).crates), " ")}
       data-tags={join(p.tags, " ")}>
        <b>{p.name} <code.plug-file>{p.slug}.qwer</code></b>
        <span>{p.summary}</span>
        <span.kit-card-tags>{for t in p.tags => <i>{t}</i>}</span>
    </a>

view PlugTagLinks(on: str = "") =
    <p.kit-chips>{for t in plug_tags() =>
        <a.kit-chip href={`/plugins/tags/${t.tag}/`} aria-current={t.tag == on ? "page" : null}>{t.tag}<small>{t.n}</small></a>}</p>

// A function as Quillo sees it: its name, parameters and value, and what it says it does.
view PlugFn(f) =
    <div.plug-fn id={`fn-${f.name}`}>
        <code.plug-sig><b>{f.name}</b>({for [i, p] in enumerate(f.params) =>
            <span>{i > 0 ? ", " : ""}{p.name}: <i>{p.type}</i></span>}) <span.plug-arrow>→</span> <i>{f.ret}</i></code>
        {f.fails && <span.plug-fails title="It gives an error value when it fails: ? passes it on, ?? replaces it">or an error</span>}
        <div.plug-doc>{raw(markdown(f.doc))}</div>
    </div>

let plug_style = `
.plug-file { margin-left: 6px; color: var(--faint); font: 11px var(--mono); }
.plug-fns { display: grid; gap: 2px; margin: 8px 0 18px; }
.plug-fn { padding: 12px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 80px; }
.plug-doc p { margin: 6px 0 0; color: var(--muted); font-size: 15px; }
.plug-doc code { font-size: 13px; }
.plug-sig { font: 14px/1.6 var(--mono); color: var(--text); background: none; padding: 0; overflow-wrap: anywhere; }
.plug-sig b { color: var(--gold); font-weight: 500; }
.plug-sig i { color: #9fd3ff; font-style: normal; }
.plug-arrow { color: var(--faint); }
.plug-fails { margin-left: 8px; padding: 1px 8px; border: 1px solid var(--line); border-radius: 999px; color: var(--faint); font: 11px var(--mono); }
.plug-steps { counter-reset: step; list-style: none; padding: 0; }
.plug-steps li { position: relative; padding-left: 34px; margin: 0 0 10px; }
.plug-steps li::before { counter-increment: step; content: counter(step); position: absolute; left: 0; top: 1px; width: 22px; height: 22px;
  border-radius: 50%; background: rgba(243, 181, 74, .14); color: var(--gold); font: 12px/22px var(--mono); text-align: center; }
`

let PLUG_LD_LANG = { "@type": "ComputerLanguage", name: "Rust", url: "https://www.rust-lang.org/" }

fn plug_ld_index() = [
    { "@type": "CollectionPage", name: "Quillo plugins", url: SITE + "/plugins/",
      description: `${len(plug_items)} Rust plugins for the Quillo programming language, one .qwer file each.`,
      isPartOf: { "@id": SEO_WEBSITE }, about: { "@id": SEO_LANGUAGE },
      mainEntity: { "@type": "ItemList", numberOfItems: len(plug_items),
          itemListElement: for [i, p] in enumerate(plug_items) =>
              { "@type": "ListItem", position: i + 1, name: p.name, url: `${SITE}/plugins/${p.slug}/` } } },
    seo_crumbs([["Quillo", "/"], ["Plugins", "/plugins/"]]),
]

fn plug_index() =
    <PlugPage title={`Quillo plugins · ${len(plug_items)} Rust plugins to download`} path="/plugins/" current="" ld={plug_ld_index()}
             description={`${len(plug_items)} Rust plugins for Quillo, each one .qwer file to download: CSV, Excel, YAML, XML, JWT, two-factor codes, QR codes, PDFs, Redis, S3, email and more.`}>
        <div.prose>
        <p.kicker>Quillo plugins</p>
        <h1>{len(plug_items)} plugins, one Rust file each</h1>
        <p.lede>What the standard library leaves out, in Rust: CSV, Excel, YAML and XML, tokens and two-factor codes,
            QR codes and PDFs, Redis, S3 and email. Each one is a <code>.qwer</code> file beside your program:
            <code>use</code> it, and its functions are yours, checked by <code>quillo check</code> and fast as Rust.
            Every plugin here is built and its example run before the site is published.</p>
        </div>
        <div.kit-get>
            <a.kit-dl href="/plugins/files/quillo-plugins.zip" download>
                <b>quillo-plugins.zip</b><span>Every plugin, with its example</span></a>
            <a.kit-dl href="#use">
                <b>How to use one</b><span>Download, use, run: three steps</span></a>
            <a.kit-dl href="/docs/rust/">
                <b>Write your own</b><span>A .qwer file is Rust with a header</span></a>
        </div>
        <div.kit-browse data-kit-browse>
            <form.kit-search role="search" method="get" action="/plugins/">
                <label.visually-hidden for="kit-q">Search the plugins</label>
                <input.kit-q type="search" id="kit-q" name="q" autocomplete="off"
                       placeholder={`Search ${len(plug_items)} plugins by name, use, crate or tag`}/>
                <kbd.kit-kbd aria-hidden="true">/</kbd>
            </form>
            <div.kit-filter>
                <span.kit-filter-label>Group</span>
                <p.kit-chips>{for g in plug_groups_used() =>
                    <a.kit-chip href={`#${slug(g)}`} data-kit-group={g}>{g}<small>{len(plug_group(g))}</small></a>}</p>
            </div>
            <div.kit-filter>
                <span.kit-filter-label>Tags</span>
                <p.kit-chips>{for [i, t] in enumerate(plug_tags()) =>
                    <a.kit-chip href={`/plugins/tags/${t.tag}/`} data-kit-tag={t.tag}
                       data-more={i >= 24 ? "" : null}>{t.tag}<small>{t.n}</small></a>}</p>
            </div>
            <div.kit-status>
                <span id="kit-count" role="status" aria-live="polite">All {len(plug_items)} plugins</span>
                {len(plug_tags()) > 24 && <button type="button" id="kit-more-tags" aria-expanded="false">All tags</button>}
                <button type="button" id="kit-clear" hidden>Clear filters</button>
            </div>
        </div>
        <p.kit-none id="kit-none" hidden>No plugin matches. Try fewer words, or take a tag off.</p>
        {for g in plug_groups_used() =>
            <section.kit-block data-kit-block>
                <h2.kit-block-title id={slug(g)}>{g} <small>{len(plug_group(g))}</small></h2>
                <div.cards.kit-cards>{for p in plug_group(g) => <PlugCard p={p}/>}</div>
            </section>}
        <div.prose>
        <h2 id="use">Use one</h2>
        <ol.plug-steps>
            <li><b>Download it</b> into your program's folder: the <code>.qwer</code> file is the whole plugin.</li>
            <li><b><code>use</code> it,</b> as you use a <code>.qwe</code> file. Its functions are then the program's,
                and <code>quillo check</code> knows their types.</li>
            <li><b>Run the program.</b> The first run builds the plugin with <code>cargo</code>, which takes a while
                the first time; later runs load what was built.</li>
        </ol>
        <KitSnippet lang="shell" text="curl -O https://quillolang.org/plugins/files/csv.qwer"/>
        <KitSnippet file="main.qwe" text={`use "csv.qwer"

route GET /orders.csv = csv_write(orders(), ["id", "customer", "total"])?`}/>
        <p>The machine that builds a plugin needs <a href="https://rustup.rs">Rust</a>. The server it runs on does not:
            <code>quillo build main.qwe</code> builds every plugin the program uses into <code>.quillo/native/</code>,
            which you deploy with the program, built on the same system as the server. Plugins run on the server, off
            the event loop; components call them through a <code>server fn</code>.</p>
        <h2 id="all">All of them at once</h2>
        <KitSnippet lang="shell" text={`curl -O https://quillolang.org/plugins/files/quillo-plugins.zip
unzip quillo-plugins.zip          # quillo-plugins/<name>.qwer and <name>.qwe, its example
cd quillo-plugins && quillo run qr.qwe`}/>
        <h2 id="write">Write your own</h2>
        <p>A <code>.qwer</code> file is ordinary Rust: its <code>pub fn</code>s are Quillo functions, and its
            <code>//! [dependencies]</code> lines are its crates, from crates.io or git. Values cross as Quillo has them
            (text, numbers, lists, maps), and a <code>Result</code> is a value or an error value.
            <a href="/docs/rust/">The Rust page</a> has the rules; any plugin here is a starting point.</p>
        </div>
        <script>{raw(replace(kit_browse_script, "\" components\"", "\" plugins\""))}</script>
    </PlugPage>

fn plug_tags_page() =
    <PlugPage title="Tags · Quillo plugins" path="/plugins/tags/" current="#tags" ld={[seo_crumbs([["Quillo", "/"], ["Plugins", "/plugins/"], ["Tags", "/plugins/tags/"]])]}
             description={`The ${len(plug_tags())} tags of Quillo's ${len(plug_items)} Rust plugins: auth, forms, files, email, images and more.`}>
        <div.prose>
            <p.kicker>Quillo plugins</p>
            <h1>Browse by tag</h1>
            <p.lede>A tag cuts across the groups: <a href="/plugins/tags/auth/">auth</a> has every plugin for
                signing in, <a href="/plugins/tags/forms/">forms</a> those that check what people type.</p>
        </div>
        <PlugTagLinks/>
    </PlugPage>

fn plug_tag_page(tag: str) {
    let items = plug_tagged(tag)
    if len(items) == 0 { reply 404 "No such tag" }
    <PlugPage title={`${tag} · Quillo plugins`} path={`/plugins/tags/${tag}/`} current="#tags"
             ld={[seo_crumbs([["Quillo", "/"], ["Plugins", "/plugins/"], ["Tags", "/plugins/tags/"], [tag, `/plugins/tags/${tag}/`]])]}
             description={`${len(items)} Quillo plugins tagged ${tag}: ${join(items | map((p) => p.name), ", ")}.`}>
        <div.prose>
            <p.kicker><a href="/plugins/tags/">Tags</a></p>
            <h1>#{tag}</h1>
            <p.lede>{len(items)} plugin{len(items) == 1 ? "" : "s"} tagged <b>{tag}</b>.</p>
        </div>
        <div.cards.kit-cards>{for p in items => <PlugCard p={p}/>}</div>
        <h2.kit-block-title>Other tags</h2>
        <PlugTagLinks on={tag}/>
    </PlugPage>
}

fn plug_page(slug: str) {
    let p = find(plug_items, (x) => x.slug == slug) ?? reply 404 "No such plugin"
    let i = index_of(plug_items | map((x) => x.slug), slug)
    let prev = i > 0 ? plug_items[i - 1] : null
    let next = plug_items[i + 1]
    let source = plug_source(slug)
    let head = plug_header(source)
    let fns = plug_exports(source)
    let related = plug_related(p)
    let extra = p.files ?? []
    let ld = [
        { "@type": "SoftwareSourceCode", name: `${p.name}, a Quillo plugin`, description: p.summary,
          url: `${SITE}/plugins/${slug}/`, programmingLanguage: PLUG_LD_LANG, codeRepository: PLUG_REPO,
          license: "https://opensource.org/licenses/MIT", keywords: join(p.tags, ", "), isPartOf: { "@id": SEO_WEBSITE } },
        seo_crumbs([["Quillo", "/"], ["Plugins", "/plugins/"], [p.name, `/plugins/${slug}/`]]),
    ]
    <PlugPage title={`${p.name} · Quillo plugins`} path={`/plugins/${slug}/`} current={slug} ld={ld}
             description={`${p.name}, a Rust plugin for Quillo: ${p.summary}`}>
        <div.prose>
            <p.kicker><a href={`/plugins/?group=${url_encode(p.group)}`}>{p.group}</a></p>
            <h1>{p.name}</h1>
            <p.lede>{p.summary}</p>
        </div>
        <p.kit-chips.kit-page-tags aria-label="Tags">{for t in p.tags => <a.kit-chip href={`/plugins/tags/${t}/`}>#{t}</a>}</p>
        <div.kit-actions>
            <a.kit-btn href={`/plugins/files/${slug}.qwer`} download>Download {slug}.qwer</a>
            <a.kit-btn.kit-btn-quiet href={`/plugins/files/${slug}.qwe`} download>Example: {slug}.qwe</a>
            {for f in extra => <a.kit-btn.kit-btn-quiet href={`/plugins/files/${f}`} download>{f}</a>}
            <a.kit-btn.kit-btn-quiet href={`${PLUG_REPO}/${slug}.qwer`}>On GitHub</a>
        </div>
        <div.prose>
        <h2 id="functions">Functions</h2>
        <p>What <code>use "{slug}.qwer"</code> gives a program, with the types Quillo sees.</p>
        </div>
        <div.plug-fns>{for f in fns => <PlugFn f={f}/>}</div>
        <div.prose>
        <h2 id="get">Get it</h2>
        <KitSnippet lang="shell" text={join(([`${slug}.qwer`, `${slug}.qwe`] + extra) | map((f) => `curl -O https://quillolang.org/plugins/files/${f}`), "\n")}/>
        <p>It uses {len(head.crates) == 1 ? "this crate" : "these crates"}, which <code>cargo</code> fetches the first
            time the plugin is built:</p>
        <KitSnippet file="[dependencies]" text={join(head.crates, "\n")}/>
        <h2 id="example">Example</h2>
        <KitSnippet file={`${slug}.qwe`} text={plug_example(slug)}/>
        <KitSnippet lang="shell" text={join([`quillo run ${slug}.qwe`] + (p.try | map((t) => `curl 'localhost:8080${t.path}'`)) | unique, "\n")}/>
        {p.needs != null && <p>{p.needs == "smtp" ? "It sends through the SMTP server SMTP_URL names, from SMTP_FROM."
            : "It talks to the Redis that REDIS_URL names, else Redis on this machine."} The site's test runs it against a stand-in.</p>}
        <h2 id="source">Source</h2>
        <div.snippet.kit-snippet>
            <div.file>{slug}.qwer</div>
            <button.kit-copy type="button" data-kit-copy aria-label={`Copy ${slug}.qwer`}>Copy</button>
            <Code lines={highlight(source, "rust")}/>
        </div>
        {len(related) > 0 && <h2 id="related">Related</h2>}
        </div>
        {len(related) > 0 && <div.cards.kit-cards>{for r in related => <PlugCard p={r}/>}</div>}
        <div.prose>
        <nav.pager>
            {prev ? <a.prev href={`/plugins/${prev.slug}/`}><small>Previous</small>{prev.name}</a> : <span></span>}
            {next ? <a.next href={`/plugins/${next.slug}/`}><small>Next</small>{next.name}</a> : <span></span>}
        </nav>
        </div>
    </PlugPage>
}

// The files, for `quillo run`; export.sh copies them into dist/plugins/files/ as they are.
route GET /plugins/files/:name {
    if !re.test(name, "^([a-z0-9_]+\\.(qwer|qwe|jpg)|quillo-plugins\\.zip)$") { reply 404 "No such file" }
    file(`plugins/${name}`)
}
route GET /plugins = plug_index()
route GET /plugins/tags = plug_tags_page()
route GET /plugins/tags/:tag = plug_tag_page(tag)
route GET /plugins/:slug = plug_page(slug)
