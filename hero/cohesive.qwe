// One program, every layer in view: each function says what it touches.
type Order = { id: int, total: dec, paid: bool = false }

server fn unpaid() with db =
    db.query("select * from orders where not paid")

server fn pay(id: int) ! str with db, http {
    http.post("https://pay.example/charge", { json: { id } })?
    db.exec("update orders set paid = 1 where id = ?", id)
}

schedule("1d", () => db.exec("delete from orders where paid = 1"))

component Orders() {
    state orders = live(unpaid)
    <ul>{for o in orders =>
        <li key={o.id}>#{o.id} {o.total}
            <button @click={() => pay(o.id)}>Pay</button></li>}</ul>
}

route POST /orders { json: Order } =
    db.exec("insert into orders (total) values (?)", json.total)
route GET /orders = <Orders/>
