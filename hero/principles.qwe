// A request comes in, an answer goes out. This is the whole app.
db.open("notes.db")
db.exec(sql`create table if not exists notes
            (id integer primary key, text text)`)

route GET / with db {
    let notes = db.query("select text from notes order by id")
    <html><body>
        <ul>{for n in notes => <li>{n.text}</li>}</ul>
        <form method="post" action="/notes">
            <input name="text"/> <button>Add</button>
        </form>
    </body></html>
}

route POST /notes { form: { text: str } } with db {
    db.exec("insert into notes (text) values (?)", text)
    redirect("/")
}
