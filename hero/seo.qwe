route GET /posts/:slug {
    let post = load_post(slug) ?? reply 404 "No such post"
    <html lang="en">
        <head>
            <title>{post.title}</title>
            <meta name="description" content={post.summary}/>
            <link rel="canonical" href={`${SITE}/posts/${slug}/`}/>
        </head>
        <body><article><h1>{post.title}</h1>{markdown(post.body)}</article></body>
    </html>
}

route GET /sitemap.txt =
    posts() | map((p) => `${SITE}/posts/${p.slug}/`) | join("\n")
