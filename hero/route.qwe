// Written once. Served the same way by a server, by a desktop
// app (`quillo app`), and inside an iOS or Android app, offline.
route GET /notes with db = <NoteList notes={load_notes()}/>

route GET /notes/:id(int) with db = match load_note(id) {
    null => respond(404, "No such note")
    n => <NoteView n={n}/>
}

route POST /notes { json: { title: str, body: str } } with db =
    create_note(title, body)

route GET /notes.csv with db =
    respond(200, notes_csv(), { "content-type": "text/csv" })

route GET /device = platform()   // { os: "android", ... }
