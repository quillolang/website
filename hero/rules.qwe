fn problem(field: str, text: str) -> list = [{ field, text }]

fn check_signup(s: map) -> list =
    (contains(s.email, "@") ? [] : problem("email", "Not an email"))
    + (trim(s.name) != "" ? [] : problem("name", "Name, please"))

component Signup() {
    state email = ""
    state name = ""
    let problems = check_signup({ email, name })    // as you type
    <form onsubmit={() => { sign_up({ email, name }) }}>
        <input value={email}/> <input value={name}/>
        <ul>{for p in problems => <li>{p.text}</li>}</ul>
    </form>
}

server fn sign_up(s: map) -> map ! list {
    let problems = check_signup(s)                  // and it decides
    len(problems) > 0 ? err(problems) : s
}
