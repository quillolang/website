// quillolang.org, written in Quillo.
//
//   quillo run site/main.qwe --watch      then open http://localhost:8080
//   site/export.sh                        renders it to static files in site/dist
//
// The code on the page is read from tour/ and demos/ and highlighted while the
// page renders. The demos are `use`d too, so what the page shows is what runs.

use "highlight.qwe"
use "hero.qwe"
use "demos/todo.qwe"
use "demos/life.qwe"

let REPO = "https://github.com/quillolang/quillo"
let SITE_REPO = "https://github.com/quillolang/website"
let EXAMPLES_REPO = "https://github.com/quillolang/examples"
let DISCORD = "https://discord.gg/XRpTQ4uTq"
let REDDIT = "https://www.reddit.com/r/quillo/"

let tour = [
    { name: "Routes", file: "routes.qwe",
      title: "An app reads like a list of what it answers",
      points: ["Path parameters are variables; `:id(int)` matches only digits.",
               "Query strings and JSON bodies are matched by patterns, with types and defaults.",
               "`|` pipes a request through middleware, and `reply` answers from anywhere."] },
    { name: "Components", file: "components.qwe",
      title: "Rendered on the server, resumed in the browser",
      points: ["A component runs once; assigning `state` updates just the places that show it.",
               "The server sends HTML; the browser takes over its elements instead of redrawing them.",
               "Each page loads only its own components, about 12 KB gzipped for a small one, when they are reached."] },
    { name: "Server functions", file: "server.qwe",
      title: "Call the server like a function",
      points: ["`server fn` is callable from components; there is no `async` or `await` to write.",
               "Arguments are checked against the parameter types; other sites get a 403.",
               "Failures are error values, so `??` carries on."] },
    { name: "Live data", file: "live.qwe",
      title: "State that follows the database",
      points: ["`live(load)` re-runs the loader whenever a table it read changes, for anyone.",
               "One WebSocket per page, with plain requests where it cannot open.",
               "Works the same with SQLite, PostgreSQL, MySQL and data kept in variables."] },
    { name: "Patterns", file: "patterns.qwe",
      title: "One pattern language, everywhere",
      points: ["The same patterns work in `match`, `let`, `for` and routes.",
               "Errors are values: `?` returns them, `??` replaces them.",
               "`! str` declares what a function's errors hold, and it is checked."] },
    { name: "Effects", file: "effects.qwe",
      title: "Say what a function may touch",
      points: ["`with db, http` limits a function, and everything it calls, to those effects.",
               "`quillo check` reports a stray effect before the program runs.",
               "`parallel` overlaps waits: coroutines on the server, `Promise.all` in the browser."] },
] | map((t) => merge(t, { lines: highlight(read_file(`tour/${t.file}`)) }))

// Python 3.9 against Quillo, on a million floats (from the README).
let bench = [
    { op: "stats.stdev", quillo: 0.65, python: 674 },
    { op: "stats.mean", quillo: 0.35, python: 214 },
    { op: "stats.describe", quillo: 1.7, python: 764, note: "by hand" },
    { op: "stats.histogram", quillo: 0.6, python: 126, note: "a loop" },
    { op: "stats.correlation", quillo: 1.4, python: 246 },
    { op: "stats.linear_regression", quillo: 1.3, python: 182 },
    { op: "stats.median", quillo: 1.3, python: 44 },
    { op: "sort", quillo: 4.6, python: 46 },
]

// The UI benchmark (bench/ui in the repository), as bench/ui/run.js prints it:
// a line of names, then a line per measure, its label and a value per name.
// Replace bench/ui.txt with a new run's output to update the page.
let ui = {
    let lines = split(trim(read_file("bench/ui.txt")), "\n") | map((l) => split(l, " ") | filter((w) => w != ""))
    let names = first(lines)
    let n = len(names)
    let rows = drop(lines, 1)
        | filter((ws) => len(ws) > n && all(drop(ws, len(ws) - n), (v) => !is_err(float(v))))
        | map((ws) => {
            let values = drop(ws, len(ws) - n)
            { label: join(take(ws, len(ws) - n), " "), raw: values, nums: values | map((v) => float(v)) }
        })
    { names, rows }
}

fn ui_row(label: str) = find(ui.rows, (r) => r.label == label)

// The server benchmark (bench/server): requests a second, one process each, as
// a table with tabs: the runtimes, then a row per answer, "262k" and the like.
fn per_second(s: str) = ends_with(s, "k") ? float(slice(s, 0, len(s) - 1)) * 1000 : float(s)

let served = {
    let lines = split(trim(read_file("bench/server.txt")), "\n") | map((l) => split(l, "\t"))
    let names = drop(first(lines), 1)
    let rows = drop(lines, 1) | map((r) => {
        let test = first(r)
        let open = index_of(test, " (")
        {
            title: open != null ? slice(test, 0, open) : test,
            note: open != null ? slice(test, open + 2, len(test) - 1) : null,
            raw: drop(r, 1),
            nums: drop(r, 1) | map(per_second),
        }
    })
    { names, rows }
}

// The hero's statements (hero.qwe shows them, one at a time). Their code is read
// from hero/ and tour/; the speed one's numbers from bench/server.txt.
fn pad(s: str, n: int) = len(s) >= n ? s : s + repeat(" ", n - len(s))
fn pad_left(s: str, n: int) = len(s) >= n ? s : repeat(" ", n - len(s)) + s

let bench_lines =
    [[{ k: "comment", text: pad("", 12) + join(served.names | map((n) => pad_left(n, 9)), "") }], []]
    + (served.rows | map((r) => [{ k: "plain", text: pad(r.title, 12) }, { k: "comp", text: pad_left(r.raw[0], 9) }]
        + (drop(r.raw, 1) | map((v) => { k: "plain", text: pad_left(v, 9) }))))
    + [[], [{ k: "comment", text: "// requests a second, one process each" }],
        [{ k: "comment", text: "// fortunes: sorted, escaped HTML" }]]

let speed_lede = {
    let r = first(served.rows)
    let ahead = all(served.rows, (row) => row.nums[0] >= max(drop(row.nums, 1)))
    `${r.raw[0]} requests a second of ${r.title} in one process: ${round(r.nums[0] / r.nums[1], 1)}× ${served.names[1]} and ${round(r.nums[0] / r.nums[2], 1)}× ${served.names[2]}`
        + (ahead ? `, and ahead in all ${len(served.rows)} tests, rendered HTML included.` : ".")
}

// A terminal: commands after `$ `, a `#` comment, the rest output.
fn term_lines(text: str) = split(trim(text), "\n") | map((l) => {
    let hash = index_of(l, "  # ")
    starts_with(l, "$ ")
        ? [{ k: "prompt", text: "$ " }, { k: "plain", text: slice(l, 2, hash ?? len(l)) }]
            + (hash != null ? [{ k: "comment", text: slice(l, hash) }] : [])
        : starts_with(l, "#") ? [{ k: "comment", text: l }]
        : contains(l, ": error: ") ? {
            let at = index_of(l, ": error: ")
            [{ k: "comment", text: slice(l, 0, at + 2) }, { k: "err", text: "error:" }, { k: "plain", text: slice(l, at + 8) }]
        }
        : [{ k: "comment", text: l }]
})

let check_lines = {
    let parts = split(read_file("hero/check.txt"), "\n---\n")
    highlight(parts[0]) + [[]] + term_lines(parts[1])
}

let numbers_lede = {
    let b = first(bench)
    `\`${b.op}\` of a million floats in ${b.quillo} ms, where Python takes ${b.python}: the answers of Python's \`math\` and \`statistics\` and of numpy, on the server and in the browser.`
}

let slides = [
    { id: "language", kicker: "v0.6 · MIT · one binary, written in Rust", head: "The web,", em: "as a language.",
      lede: "Routes, request patterns, pipelines and HTML are part of Quillo's syntax, so a web app reads like a list of what it answers. Components render on the server and resume in the browser, with no build step.",
      more: "Take the tour", href: "#tour", file: "app.qwe", lines: tour[0].lines },
    { id: "web", kicker: "HTML · SQL · HTTP · the browser", head: "Solving the web problem", em: "using web language.",
      lede: "A web app is written in many languages glued by frameworks: HTML, a script language, SQL, HTTP. In Quillo they are one: the page, its query, the call that changes it and the update everyone sees, written, checked and run together.",
      more: "Take the tour", href: "#tour", file: "todos.qwe", lines: highlight(read_file("hero/web.qwe")) },
    { id: "fatigue", kicker: "One binary", head: "The end of", em: "JavaScript fatigue.",
      lede: "No bundler, no framework to choose, no `node_modules` to keep alive. One binary is the server, the checker, the component compiler, SQLite and a language server.",
      more: "Start in a minute", href: "#start", file: "terminal", lines: term_lines(read_file("hero/fatigue.txt")) },
    { id: "async", kicker: "Server functions", head: "No fetch,", em: "no await.",
      lede: "A component calls the server like a function. The compiler awaits it, the arguments are checked against their types, and a failure comes back as a value: no route, no JSON, no `try`.",
      more: "See how", href: "/docs/async/", file: "notes.qwe", lines: highlight(read_file("hero/async.qwe")) },
    { id: "rules", kicker: "Validation", head: "One rule,", em: "both sides.",
      lede: "A rule is a plain function. The form runs it in the browser as you type, the `server fn` runs it again and has the last word, and the two can never disagree.",
      more: "The guide", href: "/docs/validation/", file: "signup.qwe", lines: highlight(read_file("hero/rules.qwe")) },
    { id: "speed", kicker: "Benchmarks", head: "Performance,", em: "from day one.",
      lede: speed_lede, more: "The numbers", href: "#speed", file: "bench/server.txt", lines: bench_lines },
    { id: "live", kicker: "Live data", head: "Live,", em: "by default.",
      lede: "`live(load)` runs the loader again whenever a table it read changes, for everyone who has the page open. One WebSocket a page, no broker, the same with SQLite, PostgreSQL and MySQL.",
      more: "Live data", href: "/docs/components/#live-data", file: "notes.qwe", lines: tour[3].lines },
    { id: "realtime", kicker: "UDP · WebTransport · RTP", head: "Real time,", em: "over UDP.",
      lede: "Packets on a port, messages to pages as WebTransport datagrams that wait for nothing, and live video both ways: a camera's stream in any page, or the pages' own cameras sent to each other for a call, a fraction of a second behind. No broker, no socket server, no media server.",
      more: "The guide", href: "/docs/realtime/", file: "telemetry.qwe", lines: highlight(read_file("hero/realtime.qwe")) },
    { id: "numbers", kicker: "math · stats · vec", head: "Data science,", em: "no Python.",
      lede: numbers_lede, more: "Numbers and data", href: "/docs/standard-library/#numbers-and-data", file: "stats.qwe", lines: highlight(read_file("hero/numbers.qwe")) },
    { id: "services", kicker: "Microservices", head: "Split it out,", em: "same code.",
      lede: "A part of an app becomes a server of its own without its code changing. Calls between them are signed, retried when they fail, and run once.",
      more: "Microservices", href: "/docs/microservices/", file: "shop.qwe", lines: highlight(read_file("hero/services.qwe")) },
    { id: "prefetch", kicker: "Prefetching", head: "Here before", em: "the click.",
      lede: "Every page asks for the pages it links to as they are pointed at, so a click shows the next one at once. Nothing to set up, and a prefetch never writes or signs anyone out.",
      more: "Prefetching", href: "/docs/prefetching/", file: "docs.qwe", lines: highlight(read_file("hero/prefetch.qwe")) },
    { id: "seo", kicker: "Search engines", head: "SEOptimized", em: "by default.",
      lede: "Every page is HTML from the server, whole before any script runs, so crawlers read what people see. A page with no components loads no JavaScript, titles and descriptions are plain markup, and a sitemap is one route. This site scores 100 for SEO in Lighthouse.",
      more: "Routes", href: "/docs/routes/", file: "posts.qwe", lines: highlight(read_file("hero/seo.qwe")) },
    { id: "rust", kicker: "Rust in a program", head: "Rust,", em: "when you want it.",
      lede: "A `.qwer` file is Rust. `use` it, and its `pub fn`s are your functions: checked against their Rust types, run off the event loop on every core, built again when they change.",
      more: "Rust in Quillo", href: "/docs/rust/", file: "imaging.qwer", lines: highlight(read_file("hero/imaging.qwer"), "rust") },
    { id: "portable", kicker: "quillo app", head: "Portable", em: "web apps.",
      lede: "`quillo app` runs the same program in a native window, with the platform's own web view. Only that window can reach it, and closing the window ends it.",
      more: "Desktop apps", href: "/docs/#desktop-apps", file: "terminal", lines: term_lines(read_file("hero/portable.txt")) },
    { id: "check", kicker: "quillo check", head: "Checked", em: "before it runs.",
      lede: "`quillo check` knows the types, records, effects, routes and components, and finds mistakes without running anything. Your editor shows them as you type.",
      more: "What it checks", href: "/docs/checking/", file: "terminal", lines: check_lines },
]

// A runtime's color follows it, whatever the order: Quillo, then Node, then Bun.
fn runtime_class(name: str) = `rt-${lower(first(split(name, " ")))}`

let UI_NAMES = { vanilla: "Plain JS", quillo: "Quillo", solid: "Solid", svelte: "Svelte", vue: "Vue", preact: "Preact", react: "React" }
let UI_OPS = [
    { label: "create1k (ms)", text: "Create 1,000 rows" },
    { label: "replace1k (ms)", text: "Replace 1,000 rows" },
    { label: "update10th (ms)", text: "Update every 10th row" },
    { label: "select (ms)", text: "Select a row" },
    { label: "swap (ms)", text: "Swap two rows" },
    { label: "remove (ms)", text: "Remove a row" },
    { label: "create10k (ms)", text: "Create 10,000 rows" },
    { label: "append1k (ms)", text: "Append 1,000 rows" },
    { label: "clear1k (ms)", text: "Clear 1,000 rows" },
    { label: "rowsMB (MB)", text: "Memory, 1,000 rows (MB)" },
    { label: "scriptKB (KB)", text: "Script, compressed (KB)" },
]

let features = [
    { title: "Checked before it runs", text: "`quillo check` holds the program to its types, records, list and map shapes, effects and error types, and warns about SQL built from values." },
    { title: "Safe by default", text: "Text is escaped, cross-site posts are refused, sessions are signed cookies and `javascript:` URLs are blocked." },
    { title: "SQLite built in", text: "Or PostgreSQL or MySQL, with the same functions, and several at once. Transactions nest, and migrations run in order, once: [the guide](/docs/database/)." },
    { title: "Real time, over UDP", text: "Packets on a UDP port, messages to pages as WebTransport datagrams, a camera's RTP stream in any page, video calls from the pages' own cameras, answers streamed as they are made: [the guide](/docs/realtime/)." },
    { title: "Translations", text: "`t(\"cart.items\", { count })` picks plural forms by the language's rules, on the server and in components." },
    { title: "Microservices", text: "Split a part of an app into its own server without changing its code. Calls are signed, retried, and run once: [the guide](/docs/microservices/)." },
    { title: "Numbers, data and Rust", text: "`math`, `stats` and `vec` give Python's answers on every core. For the rest, a `.qwer` file is Rust, called like any function: [the page](/docs/rust/), and [plugins](/plugins/) to download." },
    { title: "Desktop apps", text: "`quillo app` runs the same program in a native window, with the platform's own web view." },
    { title: "Exact decimals", text: "`0.1m + 0.2m` is `0.3m`. Decimals stay exact from the database to the page and back, and mixing one with a float is an error `quillo check` finds: [the guide](/docs/money/)." },
    { title: "Money in any currency", text: "`money` keeps amounts in their currency's minor units, never adds two currencies, splits a sum without losing a cent and writes it as each locale does: [the guide](/docs/money/#amounts-of-a-currency-money)." },
    { title: "Payments run once", text: "`idempotent` gives a request sent again with the same key its first answer, with the work and the answer in one transaction: [the guide](/docs/money/#a-transfer-once)." },
    { title: "Transactions that retry", text: "`db.transaction({ isolation: \"serializable\", retries: 5 }, f)` runs `f` again when it collides with another transaction, on PostgreSQL, MySQL and SQLite: [the guide](/docs/money/#transactions-that-collide)." },
]

fn inline(text: str) = markdown(text, { inline: true })

view Logo() = raw(`<svg class="logo" viewBox="0 0 32 32" aria-hidden="true">
  <defs><linearGradient id="lg" x1="0" y1="1" x2="1" y2="0">
    <stop offset="0" stop-color="#f3b54a"/><stop offset="1" stop-color="#b9a8ff"/></linearGradient></defs>
  <path d="M28 3C16 4 8.5 11.5 6.6 22.4L5 29l1.8.5 1.7-5.2C19 23.6 26.5 15 28 3z" fill="url(#lg)"/>
  <path d="M8.5 24.3C12 18 17 12.5 23.5 8" fill="none" stroke="#0b0a12" stroke-width="1.4" stroke-linecap="round"/>
</svg>`)

// A Star button beside GitHub. The site is static, so the count comes from
// GitHub's API in the browser (kept 10 minutes in sessionStorage, as the API
// allows 60 calls an hour), and shows only once there is at least one star.
let STARS_API = replace(REPO, "https://github.com/", "https://api.github.com/repos/")

let stars_script = `(function(){var k="quillo-stars";function show(n){if(!(n>0))return;var t=n>=1000?(n/1000).toFixed(1).replace(/\\.0$/,"")+"k":String(n);document.querySelectorAll(".stars .count").forEach(function(e){e.textContent=t;e.hidden=false})}try{var c=JSON.parse(sessionStorage.getItem(k));if(c&&Date.now()-c.t<6e5)return show(c.n)}catch(e){}fetch("${STARS_API}").then(function(r){return r.ok?r.json():null}).then(function(d){if(!d)return;show(d.stargazers_count);try{sessionStorage.setItem(k,JSON.stringify({n:d.stargazers_count,t:Date.now()}))}catch(e){}}).catch(function(){})})()`

view Stars() =
    <a.gh.stars href={REPO}>
        {raw(`<svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 .8l2.2 4.6 5 .7-3.6 3.5.9 5L8 12.2l-4.5 2.4.9-5L.8 6.1l5-.7z"/></svg>`)}
        Star<span.count hidden></span><span.visually-hidden> Quillo on GitHub</span>
        <script>{raw(stars_script)}</script>
    </a>

view Window(title: str, children) =
    <div.window>
        <div.bar><i></i><i></i><i></i><span>{title}</span></div>
        {children}
    </div>

component Tour(items: list) {
    state active = 0
    let item = items[active]
    <div.tour>
        <div.tabs role="tablist">
            {for [i, t] in enumerate(items) =>
                <button key={t.name} role="tab" aria-selected={i == active ? "true" : "false"}
                    class={i == active && "active"} @click={() => { active = i }}>{t.name}</button>}
        </div>
        <div.panel>
            <div.copy>
                <h3>{item.title}</h3>
                <ul>{for p in item.points =>
                    <li>{for [i, s] in enumerate(split(p, "`")) => i % 2 == 1 ? <code>{s}</code> : s}</li>}</ul>
            </div>
            <Window title={item.file}><Code lines={item.lines}/></Window>
        </div>
    </div>
}

// The totals as bars, from 0, fastest first; then each operation, the best in bold.
view UiBench() {
    let total = ui_row("total")
    let script = ui_row("script only")
    let entries = (for [i, n] in enumerate(ui.names) => { name: n, raw: total.raw[i], num: total.nums[i], script: script.raw[i] })
        | sort_by((e) => e.num)
    let top = max(total.nums)
    <div.uibench>
        <ol.bench.bars>
            {for e in entries =>
                <li tabindex="0" class={e.name == "quillo" && "quillo"}>
                    <span.who>{UI_NAMES[e.name] ?? e.name}</span>
                    <span.track><span.fill style={`width: ${round(e.num / top * 100, 1)}%`}></span></span>
                    <b>{e.raw}×</b>
                    <span.tip role="tooltip">{UI_NAMES[e.name] ?? e.name}: {e.raw}× the fastest in all, {e.script}× in script alone</span>
                </li>}
        </ol>
        <div.table-wrap>
            <table.ops>
                <thead><tr><th>Operation</th>{for n in ui.names => <th class={n == "quillo" && "quillo"}>{UI_NAMES[n] ?? n}</th>}</tr></thead>
                <tbody>{for op in UI_OPS => {
                    let r = ui_row(op.label)
                    // 0 is a script written into the page itself, not a smaller one.
                    let best = min(r.nums | filter((v) => v > 0))
                    <tr><td>{op.text}</td>{for [i, n] in enumerate(ui.names) =>
                        <td class={`${n == "quillo" ? "quillo" : ""} ${r.nums[i] == best ? "best" : ""}`}>{r.nums[i] == 0 ? "inline" : r.raw[i]}</td>}</tr>
                }}</tbody>
            </table>
        </div>
    </div>
}

// One panel per answer, each to its own scale from 0 (compute is a tenth of the rest).
view ServerBench() =
    <div.served>
        <ul.legend>{for n in served.names => <li class={runtime_class(n)}><i></i>{n}</li>}</ul>
        <div.panels>
            {for r in served.rows => {
                let top = max(r.nums)
                let q = r.nums[0]
                let others = drop(r.nums, 1)
                <figure.srv-panel>
                    <figcaption><b>{upper(r.title[0]) + slice(r.title, 1)}</b>{r.note && <span>{r.note}</span>}</figcaption>
                    <ol>{for [i, n] in enumerate(served.names) =>
                        <li class={runtime_class(n)}>
                            <span.who>{n}</span>
                            <span.track><span.fill style={`width: ${round(r.nums[i] / top * 100, 1)}%`}></span></span>
                            <b>{r.raw[i]}</b>
                        </li>}</ol>
                    <p.lead>{q >= max(others)
                        ? `Quillo: ${round(q / max(others), 2)}× the next, ${round(q / min(others), 2)}× the slowest`
                        : `Quillo: ${round(q / max(others), 2)}× the fastest`}</p>
                </figure>
            }}
        </div>
    </div>

view Bench(rows: list) {
    let top = math.log10(max(rows | map((r) => r.python / r.quillo)))
    <ol.bench>
        {for r in rows => {
            let x = r.python / r.quillo
            <li tabindex="0">
                <code>{r.op}</code>
                <span.track><span.fill style={`width: ${round(math.log10(x) / top * 100, 1)}%`}></span></span>
                <b>{round(x)}×</b>
                <span.tip role="tooltip">Quillo {r.quillo} ms · Python {r.python} ms{r.note ? ` (${r.note})` : ""}</span>
            </li>
        }}
    </ol>
}

let SITE = "https://quillolang.org"
let style = read_file("style.css") + read_file("community.css")
let docs_style = read_file("docs.css")

use "community.qwe"
use "docs.qwe"
use "components.qwe"
use "partners.qwe"
use "plugins.qwe"
use "blog.qwe"
use "showcase.qwe"
use "newsletter.qwe"
use "admin.qwe"
use "sponsors.qwe"

// Structured data (schema.org), for search engines: who Quillo is, on every page,
// and each page's own nodes (an article, a blog post, source code, breadcrumbs).
let SEO_LANGUAGE = SITE + "/#quillo"
let SEO_WEBSITE = SITE + "/#website"

fn seo_site() = [
    { "@type": "WebSite", "@id": SEO_WEBSITE, url: SITE + "/", name: "Quillo",
      alternateName: ["Quillo programming language", "quillolang"], inLanguage: "en",
      publisher: { "@id": SEO_LANGUAGE } },
    { "@type": ["SoftwareApplication", "ComputerLanguage"], "@id": SEO_LANGUAGE, name: "Quillo",
      alternateName: ["Quillo programming language", "Quillo language", "quillolang"],
      description: "Quillo is a small web programming language: routes, request patterns, pipelines, HTML and browser components are part of its syntax, and one binary is the server, the checker, the component compiler and a language server.",
      url: SITE + "/", applicationCategory: "DeveloperApplication", operatingSystem: "macOS, Linux",
      license: "https://opensource.org/licenses/MIT", softwareVersion: "0.6.0",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      sameAs: [REPO, "https://github.com/quillolang", DISCORD, REDDIT] },
]

// Breadcrumbs: [name, path] pairs from the home page down.
fn seo_crumbs(items: list) = { "@type": "BreadcrumbList", itemListElement: for [i, it] in enumerate(items) =>
    { "@type": "ListItem", position: i + 1, name: it[0], item: SITE + it[1] } }

// A short description from a page's first words: markdown taken out, cut at a
// sentence near 155 characters.
fn seo_summary(text: str) {
    let plain = trim(text
        | re.replace("\\[([^\\]]*)\\]\\([^)]*\\)", "$1")
        | re.replace("[`*_>#|]", "")
        | re.replace("\\s+", " "))
    if len(plain) <= 160 { return plain }
    // The first sentence, when it is long enough to say something.
    let first = index_of(plain, ". ")
    if first != null && first >= 60 && first <= 158 { return slice(plain, 0, first + 1) }
    // Else as many whole words as fit.
    let cut = slice(plain, 0, 157)
    slice(cut, 0, len(cut) - len(last(split(cut, " ")))) + "…"
}

// A page's head: its title and description, the link preview (og:, twitter:), the
// canonical address, the blog's feed, and structured data for search engines: `ld`,
// the page's schema.org nodes, put in one JSON-LD graph with the site's own.
view Head(title: str, description: str, path: str, css: str, fonts: list, kind: str = "website",
          published: str? = null, ld: list = []) =
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>{title}</title>
        <meta name="description" content={description}/>
        <meta property="og:type" content={kind}/>
        <meta property="og:site_name" content="Quillo"/>
        <meta property="og:url" content={SITE + path}/>
        <meta property="og:title" content={title}/>
        <meta property="og:description" content={description}/>
        {published != null && <meta property="article:published_time" content={published}/>}
        <meta name="twitter:title" content={title}/>
        <meta name="twitter:description" content={description}/>
        <meta property="og:image" content={SITE + "/banner.png"}/>
        <meta property="og:image:width" content="2400"/>
        <meta property="og:image:height" content="1260"/>
        <meta property="og:image:alt" content="Quillo: the web, as a language."/>
        <meta name="twitter:card" content="summary_large_image"/>
        <link rel="canonical" href={SITE + path}/>
        <meta name="theme-color" content="#0b0a12"/>
        <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
        <link rel="alternate" type="application/atom+xml" title="The Quillo blog" href="/blog/feed.xml"/>
        <script type="application/ld+json">{raw(json.stringify({ "@context": "https://schema.org", "@graph": seo_site() + ld }))}</script>
        {for f in fonts => <link rel="preload" href={`/fonts/${f}.woff2`} as="font" type="font/woff2" crossorigin/>}
        // MapView draws with Leaflet, which its page loads.
        {path == "/components/map_view/" && [
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"/>,
            <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
        ]}
        <style>{css}</style>
    </head>

// The home page's counts: the components and plugins ready to use, counted from their
// catalogs, so the numbers follow them.
view Counts() {
    let charts = len(kit_items | filter((c) => c.group == "Charts"))
    <section#ready.section.counts>
        <p.kicker>Ready to use</p>
        <h2>Bring what you need, <em>it's already written.</em></h2>
        <div.count-cards>
            <a.count-card href="/components/">
                <span.count-n>{len(kit_items)}</span>
                <b>components</b>
                <span.count-what>Forms, sign-in, tables, dialogs, dashboards and {charts} charts, trading charts too. One <code>.qwe</code> file each, light and dark, keyboard and screen reader ready.</span>
                <span.count-list>{join(kit_items | filter((c) => contains(["DatePicker", "DataTable", "CommandPalette", "CandlestickChart", "KanbanBoard"], c.name)) | map((c) => c.name), " · ")}</span>
                <span.count-go>Browse the components →</span>
            </a>
            <a.count-card href="/plugins/">
                <span.count-n>{len(plug_items)}</span>
                <b>plugins</b>
                <span.count-what>What the standard library leaves out, in Rust: one <code>.qwer</code> file each, with its version, its example, and a test that runs before every release.</span>
                <span.count-list>{join(plug_items | filter((p) => contains(["spreadsheet", "pdf", "jwt", "qr", "smtp", "redis"], p.slug)) | map((p) => p.name), " · ")}</span>
                <span.count-go>Browse the plugins →</span>
            </a>
        </div>
        <div.count-small>
            <a href="/components/?group=Charts"><b>{charts}</b><span>charts</span></a>
            <a href="/components/tags/"><b>{len(kit_tags())}</b><span>component tags</span></a>
            <a href="/plugins/"><b>{len(plug_groups_used())}</b><span>plugin groups</span></a>
            <a href="/docs/examples/"><b>{len(EXAMPLES)}</b><span>example programs</span></a>
            <a href="/blog/"><b>{len(blog_posts)}</b><span>blog posts</span></a>
            <a href="/showcase/"><b>{len(sc_projects("new", ""))}</b><span>in the showcase</span></a>
        </div>
    </section>
}

route GET /favicon.svg = file("public/favicon.svg", { cache: "30d" })
// The link preview (brand/quillo-banner.png, linked into public/).
route GET /banner.png = file("public/banner.png", { cache: "30d" })
route GET /fonts/*path = file("public/fonts/" + path, { cache: "1y" })

// For crawlers: everything may be read, and where the list of pages is.
route GET /robots.txt = `User-agent: *
Allow: /

Sitemap: ${SITE}/sitemap.xml
Sitemap: ${SITE}/sitemap.txt
`

// Every page, for search engines and for export.sh, which renders each one: its
// path, and its date where it has one (a blog post's).
fn site_pages() =
    [{ path: "/" }] + (ordered | map((p) => { path: p.url })) + (ref_pages | map((p) => { path: p.url })) + [{ path: "/components/" }]
    + (kit_items | map((c) => { path: `/components/${c.slug}/` })) + [{ path: "/components/tags/" }]
    + (kit_tags() | map((t) => { path: `/components/tags/${t.tag}/` }))
    + [{ path: "/plugins/" }] + (plug_items | map((p) => { path: `/plugins/${p.slug}/` })) + [{ path: "/plugins/tags/" }]
    + (plug_tags() | map((t) => { path: `/plugins/tags/${t.tag}/` }))
    + [{ path: "/plugins/partners/" }] + [{ path: "/sponsors/" }] + [{ path: "/showcase/" }] + (sc_projects("new", "") | map((p) => { path: `/showcase/${p.id}/` })) + [{ path: "/newsletter/" }]
    + [{ path: "/blog/", date: first(blog_posts).date }]
    + (blog_posts | map((p) => { path: p.url, date: p.date }))

route GET /sitemap.txt = join(site_pages() | map((p) => SITE + p.path), "\n") + "\n"

// The same as XML, as search engines prefer it, with the dates.
route GET /sitemap.xml {
    let urls = site_pages() | map((p) =>
        `  <url><loc>${escape(SITE + p.path)}</loc>${p.date != null ? `<lastmod>${p.date}</lastmod>` : ""}</url>`)
    respond(200, `<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
${join(urls, "\n")}
</urlset>
`, { "content-type": "application/xml; charset=utf-8" })
}

// A docs page's description: written out for a few pages, else its first paragraph
// that is prose (not a list, a table, a quote, a command or a line leading into code),
// else what the page is.
let DOCS_DESCRIPTIONS = {
    "language-tour": "A tour of the Quillo programming language: values, variables, functions and views, records, pipelines, control flow, patterns, errors, effects and HTML literals.",
    "components": "Components in Quillo: views with state, rendered on the server and resumed in the browser, composed with props, calling server functions, and following live data.",
    "standard-library": "Quillo's standard library: strings, lists and maps, numbers and statistics, dates, decimals and money, the database, the HTTP client, files, and running programs.",
    "layout": "How the Quillo repository is laid out: the interpreter, checker and compiler sources, the tests and what they need, and the tools beside them.",
    "routes": "Routes in Quillo: methods and paths with typed parameters, request patterns for queries, forms and JSON, what a route returns, cookies and sessions, uploads and idempotent requests.",
    "not-built-yet": "What the Quillo programming language does not do yet, and what is planned.",
    "examples/hello": "Hello: the smallest Quillo program, a few routes answering with text, JSON and HTML.",
    "examples/life": "Conway's Game of Life as a Quillo component, running in the browser.",
    "examples/media": "Live video in Quillo: a camera's stream in any page, and pages sending their own cameras.",
    "examples/rust": "Calling Rust from Quillo: a .qwer file's functions used by a Quillo program.",
}

fn docs_description(page: map) {
    let given = DOCS_DESCRIPTIONS[page.slug]
    if given != null { return given }
    let paras = page.blocks | filter((b) => b.type == "md") | map((b) => split(b.text, "\n\n")) | flatten
        | map((t) => trim(t))
    let prose = find(paras, (t) => len(t) >= 40 && !re.test(t, "^([-*|>#]|[0-9]+\\.|quillo |`quillo )") && !ends_with(t, ":"))
    prose != null ? seo_summary(prose) : `${page.title}: the Quillo programming language documentation.`
}

fn docs(slug: str) {
    let page = find(all_pages, (p) => p.slug == slug) ?? reply 404 "No such page"
    let description = docs_description(page)
    let ld = [
        { "@type": "TechArticle", headline: page.title, description, url: SITE + page.url, inLanguage: "en",
          about: { "@id": SEO_LANGUAGE }, isPartOf: { "@id": SEO_WEBSITE }, publisher: { "@id": SEO_LANGUAGE } },
        seo_crumbs([["Quillo", "/"], ["Docs", "/docs/"]] + (page.url == "/docs/" ? [] : [[page.title, page.url]])),
    ]
    <html lang="en">
        <Head title={`${page.title} · Quillo docs`} path={page.url} css={style + docs_style}
            description={description} kind="article" ld={ld}
            fonts={["instrument-serif", "inter", "jetbrains-mono"]}/>
        <body.docs-body>
            <header.nav>
                <div.nav-left>
                    <a.brand href="/" aria-label="Quillo"><Logo/><span>Quillo<span.brand-ext>.qwe</span></span></a>
                    <a.docs-label href="/docs/">Docs</a>
                </div>
                <nav.group-tabs aria-label="Sections">
                    {for g in GROUPS => {
                        let p = find(pages, (q) => q.slug == first(g.pages))
                        <a href={p.url} class={g.name == page.group && "active"}>{g.name}</a>
                    }}
                </nav>
                <nav><a.nav-extra href="/components/">Components</a><a.nav-extra href="/plugins/">Plugins</a><a.nav-extra href="/blog/">Blog</a><Stars/></nav>
            </header>
            <DocsPage page={page}/>
        </body>
    </html>
}

route GET /docs = docs("introduction")
route GET /docs/:slug = docs(slug)
route GET /docs/examples/:name = docs(`examples/${name}`)
route GET /docs/reference/:name = docs(`reference/${name}`)

route GET / =
    <html lang="en">
        <Head title="Quillo — the web, as a language" path="/" css={style}
            description="Quillo is a small web programming language: routes, request patterns, pipelines, HTML and browser components are part of the syntax."
            fonts={["instrument-serif", "instrument-serif-italic", "inter", "jetbrains-mono"]}/>
        <body>
            <header.nav>
                <a.brand href="/" aria-label="Quillo"><Logo/><span>Quillo<span.brand-ext>.qwe</span></span></a>
                <nav>
                    <a.nav-jump href="#tour">Tour</a>
                    <a.nav-jump href="#demo">Demo</a>
                    <a href="/docs/">Docs</a>
                    <a href="/components/">Components</a>
                    <a.nav-wide href="/plugins/">Plugins</a>
                    <a.nav-wide href="/showcase/">Showcase</a>
                    <a.nav-wide href="/sponsors/">Sponsor</a>
                    <a href="/blog/">Blog</a>
                    <a.nav-jump href="#start">Start</a>
                    <Stars/>
                </nav>
            </header>

            <main>
                <section.hero>
                    <a.partner-bar href="/plugins/partners/">
                        <span.partner-new>Partners</span>
                        <span>Own a database, an API or an SDK? <b>Build its Quillo plugin with us</b></span>
                        <span.partner-go aria-hidden="true">→</span>
                    </a>
                    <Life board={seeded()}/>
                    <style>{raw(pick_css(len(slides)))}</style>
                    <HomeHero slides={slides}/>
                    <script>{raw(pick_script(len(slides)))}</script>
                    <p.hint>The cells behind this page are Conway's Life: a Quillo component running in your browser. Move your pointer across them.</p>
                </section>

                <p.hero-after>One HERO is not <em>Awesome</em></p>

                <section.pillars>
                    <div><b>One binary</b><span>HTTP server, static checker, component compiler, SQLite and a language server.</span></div>
                    <div><b>~12 KB per page</b><span>Gzipped, for a small component, and loaded only when someone reaches for it.</span></div>
                    <div><b>Expressions like JavaScript</b><span>Arrows, <code>? :</code>, template strings and JSX-style HTML, without the surprises.</span></div>
                    <div><b>Live by default</b><span>Pages follow the database over one WebSocket. No broker needed.</span></div>
                </section>

                <Counts/>

                <section#tour.section>
                    <p.kicker>Tour</p>
                    <h2>Everything a web app needs, <em>in the syntax.</em></h2>
                    <Tour items={tour}/>
                </section>

                <section#demo.section>
                    <p.kicker>Demo</p>
                    <h2>The code on the left <em>is</em> the list on the right.</h2>
                    <p.sub>This page is a Quillo program. The component below was rendered on the server, and your browser took it over. Add an item, or click one to tick it off.</p>
                    <div.demo>
                        <Window title="todo.qwe"><Code lines={highlight(read_file("demos/todo.qwe"))}/></Window>
                        <div.stage><Todo/></div>
                    </div>
                </section>

                <section#speed.section>
                    <p.kicker>Speed</p>
                    <h2>Numbers at <em>native speed.</em></h2>
                    <p.sub>
                        {inline("`math`, `stats` and `vec` give Python's exact answers, worked on by every core. How many times faster than Python 3.9, on a million floats (log scale; hover for timings):")}
                    </p>
                    <Bench rows={bench}/>

                    <h3.subhead>And close to hand-written JavaScript <em>in the browser.</em></h3>
                    <p.sub>
                        {inline("Components compile to JavaScript with fine-grained signals: assigning `state` updates the places that show it, with no virtual DOM. In the keyed [js-framework-benchmark](https://github.com/krausest/js-framework-benchmark) app, driven in headless Chrome, each operation is timed from the click until the page is laid out. The total is the geometric mean of each time over the fastest one's, so 1.00 is the fastest and lower is better (hover for script time alone):")}
                    </p>
                    <UiBench/>
                    <p.note>
                        {inline("Medians of several runs, on an Apple M-series laptop (10 cores) in headless Chrome. Run it yourself with `node ui/run.js`; the apps are in [quillolang/benchmarks](https://github.com/quillolang/benchmarks/tree/main/ui).")}
                    </p>

                    <h3.subhead>And serving faster than <em>Node and Bun.</em></h3>
                    <p.sub>
                        {inline("Requests a second from one process, kept busy by 64 connections from the same machine: plain text, JSON, TechEmpower's Fortunes without a database (sorted, escaped HTML, computed on every request) and a 10,000-step arithmetic loop, which Quillo compiles to machine code.")}
                    </p>
                    <ServerBench/>
                    <p.note>
                        {inline("Each server keeps about one core busy. Run it yourself with `node server/run.cjs 8`; the servers and the load generator are in [quillolang/benchmarks](https://github.com/quillolang/benchmarks/tree/main/server).")}
                    </p>
                </section>

                <section.section>
                    <p.kicker>And more</p>
                    <h2>Small language, <em>whole toolbox.</em></h2>
                    <div.grid>
                        {for f in features => <article><h3>{f.title}</h3><p>{inline(f.text)}</p></article>}
                    </div>
                </section>

                <SponsorsBand/>

                <section#start.section.start>
                    <p.kicker>Get started</p>
                    <h2>From clone to running app <em>in a minute.</em></h2>
                    <Window title="terminal">
                        <pre.code.shell><code>{for line in split(trim(read_file("tour/start.sh")), "\n") =>
                            <span.ln><span.prompt>$ </span>{line}</span>}</code></pre>
                    </Window>
                    <p.sub>
                        {inline("Needs Rust 1.94+ and a C compiler: [what to install](/docs/install/) on macOS, Linux and Windows. Then open http://127.0.0.1:8080. `quillo check app.qwe` finds mistakes without running, `quillo repl` tries things out, and the VS Code extension (or `quillo lsp` in any editor) adds diagnostics, hover and completion.")}
                    </p>
                    <aside.why-qwe>
                        <div.keys aria-hidden="true">{for k in split("QWERTY", "") =>
                            <kbd class={contains("QWE", k) && "hit"}>{k}</kbd>}</div>
                        <p>{inline("**Why `.qwe`?** For ergonomics. Q, W and E sit side by side at the start of the keyboard's top row: one roll of the left hand, in every command and file name, with no reaching and no looking down. And it reads as what the language is for: **Quit Worrying about Everything**. The checker, the escaping, the signed sessions and the calls that run once do the worrying.")}</p>
                    </aside>
                    <div.ctas>
                        <a.btn.primary href={REPO}>Quillo on GitHub</a>
                        <a.btn href="/docs/language-tour/">Read the language tour →</a>
                    </div>
                    <p.community-note>Questions, ideas, something you made? Come say hi on <a href={DISCORD}>Discord</a> or <a href={REDDIT}>r/quillo</a>.</p>
                </section>

                <section.section.story>
                    <p.kicker>Story</p>
                    <ol.timeline>
                        <li><b>2024</b><span>Conceived: what if routes, patterns and HTML were the language itself?</span></li>
                        <li><b>Late 2025</b><span>The first prototype: a tree-walking interpreter in Rust, serving its own routes.</span></li>
                        <li><b>October 2026</b><span>v0.5: components that resume in the browser, a static checker, live data and a language server.</span></li>
                        <li><b>Today</b><span>v0.6: private names, plugins taken by name, <code>quillo install</code> and {len(plug_items)} plugins.</span></li>
                    </ol>
                </section>
            </main>

            <footer>
                <a.brand href="/" aria-label="Quillo"><Logo/><span>Quillo<span.brand-ext>.qwe</span></span></a>
                <nav.community aria-label="Community">
                    <a href={REPO}>GitHub</a>
                    <a href={DISCORD}>Discord</a>
                    <a href={REDDIT}>r/quillo</a>
                    <a href="/sponsors/">Sponsor</a>
                    <a href="/newsletter/">Newsletter</a>
                </nav>
                <span>MIT licensed. This site is written in Quillo and served by <code>quillo run</code>.</span>
            </footer>
        </body>
    </html>
