// /coverage/: how much of Quillo its tests run. coverage.json is written by
// tools/coverage.mjs from a run of Quillo's scripts/coverage.sh (Rust by cargo
// llvm-cov, the browser runtime by Chrome's and Node's own coverage), and
// keeps every run before it in its history.

let COV = json.parse(read_file("coverage.json"))

// What each part must keep: Rust 97.90% of lines (the aim is 99%), the browser runtime 99.50%.
// Rust's regions are shown beside its lines with no target of their own (FEEDBACK49.md, Q-607).
let COV_TARGET = { rust: 97.9, runtime: 99.5 }

fn cov_pct(p: num) = format_number(p, "en-US", 2) + "%"
fn cov_n(n: int) = format_number(n, "en-US")

fn cov_mark(p: num, target: num?) = target != null && p < target ? "n cov-below" : "n"

view CovRow(name: str, part: map, target: num?) =
    <tr>
        <td>{name}</td>
        <td.n>{cov_n(part.lines ?? part.count)}</td>
        <td.n>{cov_n(part.run)}</td>
        <td.n>{cov_n((part.lines ?? part.count) - part.run)}</td>
        <td class={cov_mark(part.percent, target)}><strong>{cov_pct(part.percent)}</strong></td>
        <td.n>{target == null ? "—" : cov_pct(target)}</td>
    </tr>

route GET /coverage {
    let run = COV.latest
    let files = run.rust.files
    let low = files | filter((f) => f.percent < COV_TARGET.rust)
    <SitePage title="Test coverage" path="/coverage/" label="Coverage" href="/coverage/"
              description="How much of Quillo its tests run: the Rust source file by file, and the browser runtime, measured on every change and kept as a history.">
        <div.prose>
            <p.kicker>Tests</p>
            <h1>Test coverage</h1>
            <p.lede>The share of Quillo's lines its tests run, measured in one run of the whole suite: {cov_n(run.tests.passed)} tests,
                with Chrome, PostgreSQL and MariaDB, on {run.system}. The Rust source is measured by <code>cargo llvm-cov</code> (the
                Lines column of its total, with its Regions beside it: a line counts as run when any part of it ran, so
                <code>let x = f()?;</code> is run though <code>f</code> never failed, and a region is each such part), and the browser runtime, <code>src/client/runtime.js</code>, by the coverage
                Chrome and Node keep themselves, mapped back to the file's lines. Last measured on {run.date},
                at commit <a href={`${REPO}/commit/${run.commit}`}><code>{run.commit}</code></a> of Quillo {run.version}{run.changed ? ", with changes not yet committed" : ""}.</p>

            <h2 id="summary">Now</h2>
            <table.ack.cov>
                <thead><tr><th>Part</th><th.n>Lines</th><th.n>Run</th><th.n>Not run</th><th.n>Coverage</th><th.n>Target</th></tr></thead>
                <tbody>
                    <CovRow name="Rust, lines" part={run.rust} target={COV_TARGET.rust}/>
                    {run.rust.regions != null && <CovRow name="Rust, regions" part={run.rust.regions} target={null}/>}
                    <CovRow name="Browser runtime" part={run.runtime} target={COV_TARGET.runtime}/>
                </tbody>
            </table>
            {run.tests.failed > 0 && <p>{cov_n(run.tests.failed)} tests failed in this run, so these numbers are lower than they would be.</p>}
            {(run.tests.rerun ?? 0) > 0 && <p>{cov_n(run.tests.rerun)} tests failed under the run's load and passed when run again by themselves, their coverage kept; a run with a test that fails alone too writes no number.</p>}

            <h2 id="history">History</h2>
            <p>Every run, newest first.</p>
            <table.ack.cov>
                <thead><tr><th>Date</th><th>Commit</th><th>Version</th><th.n>Tests</th><th.n>Rust</th><th.n>Rust regions</th><th.n>Browser runtime</th></tr></thead>
                <tbody>{for h in COV.history =>
                    <tr>
                        <td>{h.date}</td>
                        <td><a href={`${REPO}/commit/${h.commit}`}><code>{h.commit}</code></a>{h.changed ? " +" : ""}</td>
                        <td>{h.version}</td>
                        <td.n>{cov_n(h.tests.passed)}{h.tests.failed > 0 ? ` (${h.tests.failed} failed)` : ""}</td>
                        <td class={cov_mark(h.rust.percent, COV_TARGET.rust)}>{cov_pct(h.rust.percent)}</td>
                        <td.n>{h.rust.regions == null ? "—" : cov_pct(h.rust.regions.percent)}</td>
                        <td class={cov_mark(h.runtime.percent, COV_TARGET.runtime)}>{cov_pct(h.runtime.percent)}</td>
                    </tr>}</tbody>
            </table>

            <h2 id="files">Rust, file by file</h2>
            <p>{len(files)} files of <code>src/</code>; {len(low)} below {cov_pct(COV_TARGET.rust)}, marked in gold. What is not run is
                mostly <code>unreachable!</code> arms, failures of the operating system and other systems' branches.</p>
            <table.ack.cov>
                <thead><tr><th>File</th><th.n>Lines</th><th.n>Run</th><th.n>Not run</th><th.n>Coverage</th></tr></thead>
                <tbody>{for f in files =>
                    <tr>
                        <td><a href={`${REPO}/blob/${run.commit}/${f.file}`}><code>{f.file}</code></a></td>
                        <td.n>{cov_n(f.lines)}</td>
                        <td.n>{cov_n(f.run)}</td>
                        <td.n>{cov_n(f.lines - f.run)}</td>
                        <td class={cov_mark(f.percent, COV_TARGET.rust)}>{cov_pct(f.percent)}</td>
                    </tr>}</tbody>
            </table>

            <h2 id="runtime">The browser runtime</h2>
            <p>A line counts unless it is blank, a comment, or only brackets; it ran when the innermost block V8 reports
                around its first character ran. {len(run.runtime.missed)} stretches of <code>runtime.js</code> did not run in this
                measurement. A change to the runtime must keep it at {cov_pct(COV_TARGET.runtime)} or more, and every line it
                changes must run in a test.</p>
        </div>
    </SitePage>
}
